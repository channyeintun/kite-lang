// The site's deployment: Cloudflare Workers, serving `site/` as static assets.
//
// `site/` is a directory of files that any static server can serve, and this
// deploys it as exactly that — the same bytes `site/build.sh` produces, from
// Cloudflare's edge.
//
// There is a Worker script now, for one missing capability rather than for any
// dynamic behaviour: the asset server answers a `Range` request with `200` and
// the whole body, which leaves a media element unable to seek at all. See
// `site-worker.js`. Everything that is not a media file is passed straight
// through, so a page, a stylesheet and a wasm module are served exactly as
// they were before.
{
  "name": "kite-lang",
  "compatibility_date": "2026-08-01",

  "main": "./site-worker.js",

  "assets": {
    "directory": "./site",
    // Named, so the Worker can reach the files and answer for them itself.
    "binding": "ASSETS",
    // Assets are served *before* the Worker by default, which is right for
    // every file here but one: the Worker exists to add byte ranges, and it
    // cannot add them to a response it never sees. Only the media file is
    // routed through it, so nothing else pays for the indirection.
    "run_worker_first": ["/player/khin-maung-toe.m4a"]
  },

  // An exact hostname match each, so both spellings of the domain answer.
  "routes": [
    { "pattern": "kite-lang.dev", "custom_domain": true },
    { "pattern": "www.kite-lang.dev", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
