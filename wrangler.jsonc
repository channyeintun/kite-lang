// The site's deployment: Cloudflare Workers, serving `site/` as static assets.
//
// `site/` is a directory of files that any static server can serve, and this
// deploys it as exactly that — the same bytes `site/build.sh` produces, from
// Cloudflare's edge. There is no Worker script: nothing here is dynamic, and
// the asset server answers every request the site makes.
//
// There was one, briefly, and only for a missing capability rather than for
// any behaviour of ours: the asset server answers a `Range` request with `200`
// and the whole body, which left the music demo's audio element unable to seek
// at all. That demo is gone and nothing else on the site is seekable, so the
// Worker went with it.
{
  "name": "kite-lang",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./site"
  },

  // An exact hostname match each, so both spellings of the domain answer.
  "routes": [
    { "pattern": "kite-lang.dev", "custom_domain": true },
    { "pattern": "www.kite-lang.dev", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
