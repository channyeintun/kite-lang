use std/task
use std/sync

async fn leaf(id: int, n: int) -> int {
    for i in 0..n {
        io.print("leaf \(id) \(i) \(time.now())")
        task.yield()
    }
    return id
}

async fn sleeper(id: int, ms: int) -> int {
    io.print("s\(id) start \(time.now())")
    await task.sleep(ms)
    io.print("s\(id) done \(time.now())")
    return id
}

async fn waiter(id: int, t: Task<int>) -> int {
    io.print("w\(id) wait")
    let v = await t
    io.print("w\(id) got \(v) at \(time.now())")
    return v + 1
}

async fn chain(id: int, d: int) -> int {
    if d == 0 {
        io.print("c\(id) bottom")
        return 0
    }
    io.print("c\(id) down \(d)")
    let v = await chain(id, d - 1)
    io.print("c\(id) up \(d)")
    return v + 1
}

async fn sleepy_chain(id: int, d: int) -> int {
    if d == 0 {
        await task.sleep(3)
        io.print("z\(id) bottom \(time.now())")
        return 0
    }
    let v = await sleepy_chain(id, d - 1)
    io.print("z\(id) up \(d)")
    task.yield()
    return v + 1
}

async fn spawner(id: int, n: int) -> int {
    var kids: [Task<int>] = []
    for i in 0..n {
        kids.push(leaf(id * 10 + i, i))
        io.print("p\(id) spawned \(i)")
        task.yield()
    }
    var s = 0
    for k in kids {
        s += await k
        io.print("p\(id) collected \(s)")
    }
    return s
}

async fn allsum(id: int, xs: [Task<int>]) -> int {
    let vs = await task.all(xs)
    var s = 0
    for v in vs {
        s += v
    }
    io.print("a\(id) all \(s) at \(time.now())")
    return s
}

async fn locker(id: int, var m: sync.Mutex<int>, n: int) -> int {
    let v = await sync.lock(m)
    io.print("l\(id) locked \(v)")
    for i in 0..n {
        task.yield()
    }
    io.print("l\(id) unlocking")
    sync.release(m, v + 1)
    return id
}

pub async fn main() {
    var ts: [Task<int>] = []
    var m = sync.mutex(0)
    var q: sync.Queue<int> = sync.queue()
    ts.push(leaf(0, 5))
    ts.push(spawner(1, 2))
    ts.push(allsum(2, [ts[1]]))
    ts.push(spawner(3, 3))
    ts.push(sleepy_chain(4, 0))
    ts.push(waiter(5, ts[4]))
    ts.push(sleeper(6, 20))
    ts.push(locker(7, m, 2))
    ts.push(sleeper(8, 10))
    ts.push(sleepy_chain(9, 2))
    ts.push(allsum(10, [ts[5], ts[9]]))
    ts.push(chain(11, 6))
    ts.push(leaf(12, 4))
    var total = 0
    for t in ts {
        total += await t
    }
    io.print("total \(total) at \(time.now())")
}
