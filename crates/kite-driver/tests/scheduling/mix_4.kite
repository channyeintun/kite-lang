use std/task
use std/sync

async fn leaf(id: int, n: int) -> int {
    for i in 0..n {
        io.print("leaf \(id) \(i) \(time.now())")
        task.yield()
    }
    return id
}

async fn sleeper(id: int, ms: int) -> int {
    io.print("s\(id) start \(time.now())")
    await task.sleep(ms)
    io.print("s\(id) done \(time.now())")
    return id
}

async fn waiter(id: int, t: Task<int>) -> int {
    io.print("w\(id) wait")
    let v = await t
    io.print("w\(id) got \(v) at \(time.now())")
    return v + 1
}

async fn chain(id: int, d: int) -> int {
    if d == 0 {
        io.print("c\(id) bottom")
        return 0
    }
    io.print("c\(id) down \(d)")
    let v = await chain(id, d - 1)
    io.print("c\(id) up \(d)")
    return v + 1
}

async fn sleepy_chain(id: int, d: int) -> int {
    if d == 0 {
        await task.sleep(3)
        io.print("z\(id) bottom \(time.now())")
        return 0
    }
    let v = await sleepy_chain(id, d - 1)
    io.print("z\(id) up \(d)")
    task.yield()
    return v + 1
}

async fn allsum(id: int, xs: [Task<int>]) -> int {
    let vs = await task.all(xs)
    var s = 0
    for v in vs {
        s += v
    }
    io.print("a\(id) all \(s) at \(time.now())")
    return s
}

async fn timer(id: int, t: Task<int>, ms: int) -> int {
    let v = await task.timeout(t, ms)
    if v == nil {
        io.print("t\(id) timed out at \(time.now())")
        return -1
    }
    io.print("t\(id) in time \(v) at \(time.now())")
    return v
}

async fn locker(id: int, var m: sync.Mutex<int>, n: int) -> int {
    let v = await sync.lock(m)
    io.print("l\(id) locked \(v)")
    for i in 0..n {
        task.yield()
    }
    io.print("l\(id) unlocking")
    sync.release(m, v + 1)
    return id
}

async fn twice(id: int, t: Task<int>) -> int {
    let a = await t
    task.yield()
    let b = await t
    io.print("d\(id) twice \(a) \(b)")
    return a + b
}

fn main() {
    var ts: [Task<int>] = []
    var m = sync.mutex(0)
    var q: sync.Queue<int> = sync.queue()
    ts.push(leaf(0, 3))
    ts.push(leaf(1, 3))
    ts.push(sleepy_chain(2, 2))
    ts.push(waiter(3, ts[2]))
    ts.push(locker(4, m, 3))
    ts.push(sleeper(5, 20))
    ts.push(sleeper(6, 20))
    ts.push(leaf(7, 0))
    ts.push(twice(8, ts[7]))
    ts.push(timer(9, ts[4], 8))
    ts.push(allsum(10, [ts[6], ts[8]]))
    ts.push(chain(11, 2))
    ts.push(sleeper(12, 10))
    ts.push(chain(13, 4))
    io.print("main done \(ts.len())")
}
