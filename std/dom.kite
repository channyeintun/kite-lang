//! The document. **Web only.**
//!
//! Ordinary Kite over [`std/js`](js.html) — there is not one `extern`
//! declaration in this file, and that is the point. Everything here could have
//! been written by a user, which is what makes the primitives underneath a real
//! answer to "what if the standard library never wrapped the thing I need"
//! rather than a promise.
//!
//! A Kite program **lives inside a page and owns parts of it**. The page is
//! served by whatever serves it, styled by whatever stylesheet it already has,
//! and Kite takes the parts that need real logic. Attaching to `<body>` is
//! available and is not the point.
//!
//! ```kite
//! use std/dom
//!
//! fn main() {
//!     let button = dom.find("#save")
//!     if button == nil {
//!         return
//!     }
//!     let (sub, err) = dom.on(button, "click", |e: dom.Event| { save() })
//!     if err != nil {
//!         io.print("could not attach: \(err.message())")
//!     }
//! }
//! ```
//!
//! **What is not here is as deliberate as what is.** There is no layout, no
//! widget, no theme and no component. The browser lays out, CSS styles, and a
//! design system is a stylesheet. What this module does is find elements, make
//! them, change them, and listen to them.

use std/js

// ---- what a program holds --------------------------------------------------

/// One element.
///
/// Opaque: outside this module an `Element` can be held and passed but not read
/// or built, because its field is unmarked ([spec §4.2]). That is the whole of
/// how the untyped layer underneath is stopped from spreading into application
/// code — and it is ordinary visibility, not a special rule.
pub struct Element {
    raw: JsValue
}

/// Something that happened.
pub struct Event {
    raw: JsValue
}

/// A listener that has been attached, and can be taken off again.
///
/// Returned rather than discarded because **nothing else can cancel it**. The
/// closure is alive as long as the listener is, the listener is alive as long
/// as the element is, and an element a program keeps a handle on is alive as
/// long as the program. Explicit teardown is squarely inside this language's
/// tolerance for verbosity.
pub struct Subscription {
    target: JsValue
    event: str
    handler: JsValue
}

// ---- the door out ----------------------------------------------------------

/// The host object inside an element.
///
/// **The escape hatch, and it is meant to be used as one.** Sealing `Element`
/// completely sounds safer and is not: the first person who needs a method this
/// module never wrapped would be unable to reach their own element, and what
/// they would do instead is rebuild a parallel untyped world beside this one.
/// One marked door is a boundary that holds; a wall is a boundary that gets
/// climbed.
///
/// It is greppable on purpose. `dom.raw(` in a diff is a thing to look at.
pub fn raw(e: Element) -> JsValue {
    return e.raw
}

/// The other direction, for a host object a program obtained itself.
pub fn wrap(v: JsValue) -> Element {
    return Element{ raw: v }
}

/// The host object inside an event, for the same reason.
pub fn raw_event(e: Event) -> JsValue {
    return e.raw
}

fn document() -> JsValue {
    return js.global("document")
}

// ---- finding ---------------------------------------------------------------

/// The first element matching a CSS selector, or nothing.
///
/// **`?Element`, never a usable-looking stand-in.** The previous version of this
/// module returned a handle of 0 for "not found" and documented that every call
/// tolerated it, so a chain of lookups on a missing element did nothing at all.
/// That is a null object, and it is worse than a null dereference because it
/// does not even fail where the mistake is — in a language whose specification
/// calls the tolerated zero value Go's commonest production bug.
pub fn find(selector: str) -> Option<Element> {
    let (found, err) = js.call1(document(), "querySelector", js.of_str(selector))
    if err != nil {
        return nil
    }
    if js.is_nothing(found) {
        return nil
    }
    return Element{ raw: found }
}

/// The first element inside `parent` matching a selector.
pub fn find_in(parent: Element, selector: str) -> Option<Element> {
    let (found, err) = js.call1(parent.raw, "querySelector", js.of_str(selector))
    if err != nil {
        return nil
    }
    if js.is_nothing(found) {
        return nil
    }
    return Element{ raw: found }
}

/// Every element matching a selector, in document order.
///
/// The empty slice when nothing matches or the selector is malformed. A
/// malformed selector throws in the browser; here it is the same answer as no
/// matches, because a caller looping over the result cannot act on the
/// difference. Use [`find`] when the distinction matters.
pub fn find_all(selector: str) -> [Element] {
    var out: [Element] = []
    let (list, err) = js.call1(document(), "querySelectorAll", js.of_str(selector))
    if err != nil {
        return out
    }
    let (count, cerr) = js.length(list)
    if cerr != nil {
        return out
    }
    for i in 0..count {
        let (item, ierr) = js.at(list, i)
        if ierr == nil {
            out.push(Element{ raw: item })
        }
    }
    return out
}

/// A new element, not yet in the document.
pub fn create(tag: str) -> (Element, error) {
    let (made, err) = js.call1(document(), "createElement", js.of_str(tag))
    check err
    return Element{ raw: made }, nil
}

// ---- reading and changing --------------------------------------------------

/// The element's text content.
pub fn text(e: Element) -> str {
    return js.str_or(e.raw, "textContent", "")
}

/// Replace the element's text content.
///
/// Text, never markup. There is no `set_html` here — building markup from
/// strings is the commonest way to grow an injection bug, and a standard
/// library should not ship the loaded gun beside the safe call.
///
/// **What that claim no longer covers.** It used to be absolute, because there
/// was no other way through. There is now: [`raw`] hands over the host object,
/// and anyone holding one can set `innerHTML`. The guarantee is narrower and
/// stated narrowly — the typed layer does not hand you the gun, and the escape
/// hatch is not the typed layer.
pub fn set_text(e: Element, body: str) -> error {
    return js.set(e.raw, "textContent", js.of_str(body))
}

/// One attribute, or nothing when it is absent.
pub fn attribute(e: Element, name: str) -> Option<str> {
    let (value, err) = js.call1(e.raw, "getAttribute", js.of_str(name))
    if err != nil {
        return nil
    }
    if js.is_nothing(value) {
        return nil
    }
    let (body, berr) = js.as_str(value)
    if berr != nil {
        return nil
    }
    return body
}

pub fn set_attribute(e: Element, name: str, value: str) -> error {
    let (_, err) = js.call2(e.raw, "setAttribute", js.of_str(name), js.of_str(value))
    return err
}

pub fn remove_attribute(e: Element, name: str) -> error {
    let (_, err) = js.call1(e.raw, "removeAttribute", js.of_str(name))
    return err
}

/// The value of an input, a textarea or a select.
///
/// **A property, not an attribute, and the difference is not pedantry.**
/// `getAttribute("value")` answers with the *default* the markup gave, which
/// stops being the truth the moment somebody types. Reading the attribute is
/// how a form ends up submitting what it was born with. The same holds for
/// `checked`, `selected` and `indeterminate`, which is why each of those has a
/// call here rather than being left to [`attribute`].
pub fn value(e: Element) -> str {
    return js.str_or(e.raw, "value", "")
}

pub fn set_value(e: Element, body: str) -> error {
    return js.set(e.raw, "value", js.of_str(body))
}

pub fn checked(e: Element) -> bool {
    return js.bool_or(e.raw, "checked", false)
}

pub fn set_checked(e: Element, on: bool) -> error {
    return js.set(e.raw, "checked", js.of_bool(on))
}

/// One CSS property, by its CSS name — `background-color`, not
/// `backgroundColor`.
///
/// For values a stylesheet cannot know: a computed position, a progress width,
/// a custom property the CSS then reads. Everything static belongs in the
/// stylesheet, where the cascade can reach it.
pub fn set_style(e: Element, property: str, value: str) -> error {
    let (style, err) = js.get(e.raw, "style")
    if err != nil {
        return err
    }
    let (_, serr) = js.call2(style, "setProperty", js.of_str(property), js.of_str(value))
    return serr
}

// ---- classes ---------------------------------------------------------------
//
// A class name is how a Kite program reaches a stylesheet somebody else wrote,
// which makes these the most load-bearing four functions in the module. The
// names pass through exactly as written: no hashing, no scoping, no rewriting.

pub fn add_class(e: Element, name: str) -> error {
    let (list, err) = js.get(e.raw, "classList")
    if err != nil {
        return err
    }
    let (_, aerr) = js.call1(list, "add", js.of_str(name))
    return aerr
}

pub fn remove_class(e: Element, name: str) -> error {
    let (list, err) = js.get(e.raw, "classList")
    if err != nil {
        return err
    }
    let (_, rerr) = js.call1(list, "remove", js.of_str(name))
    return rerr
}

pub fn has_class(e: Element, name: str) -> bool {
    let (list, err) = js.get(e.raw, "classList")
    if err != nil {
        return false
    }
    let (answer, aerr) = js.call1(list, "contains", js.of_str(name))
    if aerr != nil {
        return false
    }
    let (on, oerr) = js.as_bool(answer)
    if oerr != nil {
        return false
    }
    return on
}

/// Add the class when `on`, remove it otherwise.
///
/// The shape state usually wants. A program that keeps its state in the model
/// and its appearance in CSS spends most of its time here — and `:hover`,
/// `:focus-visible` and `:checked` it does not touch at all, because those
/// never reach Kite.
pub fn set_class(e: Element, name: str, on: bool) -> error {
    if on {
        return add_class(e, name)
    }
    return remove_class(e, name)
}

// ---- the tree --------------------------------------------------------------

pub fn append(parent: Element, child: Element) -> error {
    let (_, err) = js.call1(parent.raw, "appendChild", child.raw)
    return err
}

pub fn insert_before(parent: Element, child: Element, before: Element) -> error {
    let (_, err) = js.call2(parent.raw, "insertBefore", child.raw, before.raw)
    return err
}

/// Take an element out of the document.
pub fn remove(e: Element) -> error {
    let (_, err) = js.call0(e.raw, "remove")
    return err
}

/// Whether two handles are the same element.
///
/// The question every listener asks about `event.target`, and the reason a host
/// object is a reference rather than a number: the old handle table pushed a
/// new entry on every lookup, so finding one element twice gave two handles
/// that compared unequal. `==` on an `Element` is a compile error that points
/// here.
pub fn same(a: Element, b: Element) -> bool {
    return js.same(a.raw, b.raw)
}

// ---- events ----------------------------------------------------------------

/// Listen, and get back something that can stop listening.
///
/// The handler is given an [`Event`], never a raw host value — which is what
/// keeps `std/js` out of an application's vocabulary even though everything
/// here is built on it.
pub fn on(target: Element, name: str, handler: fn(Event)) -> (Subscription, error) {
    // The user's handler takes an `Event`; the host calls with whatever it
    // calls with. This closure is the join, and it captures `handler` — a `let`
    // parameter, immutable, so capturing it by value is exactly right.
    let wrapped = js.func(|raw: JsValue| { handler(Event{ raw: raw }) })
    let (_, err) = js.call2(
        target.raw,
        "addEventListener",
        js.of_str(name),
        wrapped,
    )
    check err
    return Subscription{ target: target.raw, event: name, handler: wrapped }, nil
}

impl Subscription {
    /// Stop listening.
    ///
    /// After this the wrapper is unreachable from the page, the closure is
    /// unreachable from the wrapper, and the collector takes both. There is no
    /// bookkeeping to do because there was never a registry to remove from.
    pub fn cancel(self) -> error {
        let (_, err) = js.call2(
            self.target,
            "removeEventListener",
            js.of_str(self.event),
            self.handler,
        )
        return err
    }
}

/// What the event happened to.
///
/// Optional because a target is not always an element: it may be the document,
/// the window, or a text node. A call that assumed otherwise would be wrong on
/// exactly the events that are hardest to debug.
pub fn target(e: Event) -> Option<Element> {
    let (found, err) = js.get(e.raw, "target")
    if err != nil {
        return nil
    }
    if js.is_nothing(found) {
        return nil
    }
    let (is_element, ierr) = js.instance_of(found, "Element")
    if ierr != nil {
        return nil
    }
    if !is_element {
        return nil
    }
    return Element{ raw: found }
}

/// The value of whatever the event happened to, for an input event.
pub fn event_value(e: Event) -> str {
    let (found, err) = js.get(e.raw, "target")
    if err != nil {
        return ""
    }
    return js.str_or(found, "value", "")
}

/// Which key, for a keyboard event: `"Enter"`, `"a"`, `"ArrowUp"`.
pub fn key(e: Event) -> str {
    return js.str_or(e.raw, "key", "")
}

/// Do not do the default thing — submit the form, follow the link.
pub fn prevent_default(e: Event) -> error {
    let (_, err) = js.call0(e.raw, "preventDefault")
    return err
}

/// Do not let the event carry on up the tree.
pub fn stop_propagation(e: Event) -> error {
    let (_, err) = js.call0(e.raw, "stopPropagation")
    return err
}

// ---- the page --------------------------------------------------------------

pub fn title() -> str {
    return js.str_or(document(), "title", "")
}

pub fn set_title(body: str) -> error {
    return js.set(document(), "title", js.of_str(body))
}

/// The `<body>`, for a program that owns the whole page after all.
pub fn body() -> Option<Element> {
    let (found, err) = js.get(document(), "body")
    if err != nil {
        return nil
    }
    if js.is_nothing(found) {
        return nil
    }
    return Element{ raw: found }
}
