// std/dom — low-level DOM access. **Web only.**
//
// **This module is between designs, and what is below is the old one.** It was
// written as an escape hatch beneath `std/ui`, for the few things a layout
// engine had no opinion about — a `<video>`, an embed, the page title. `std/ui`
// is gone, the document is the product now, and this becomes the main way a
// Kite program reaches a page rather than the exception. It is being rewritten
// over `std/js`, in ordinary Kite, with no `extern` declarations in it at all.
// See `docs/04-the-web.md`.
//
// Three things below are wrong and are named here rather than left to be
// discovered, because until the rewrite lands they are what this module does:
//
// - **A node is a number, not a reference.** The host keeps a table and Kite
//   holds an index into it. The table never shrinks, because nothing can tell
//   the host that Kite dropped a number. Worse, the same element found twice
//   gets two different numbers, so two handles cannot be compared for identity.
// - **A handle of 0 means "not found", and every call tolerates it.** That is a
//   null object. A chain of lookups on a missing element does nothing at all,
//   which hides the mistake instead of reporting it — and `Option<T>` exists to
//   make exactly this unspellable.
// - **There are no events.** Nothing here can listen for a click.

/// The host's side. Anything not on the web leaves this group unimplemented,
/// and a call fails saying which function had no host — which is the honest
/// answer to asking a terminal for a DOM.
@host("dom")
extern fn query(selector: str) -> int

@host("dom")
extern fn query_all(selector: str) -> str

@host("dom")
extern fn create(tag: str) -> int

@host("dom")
extern fn append(parent: int, child: int)

@host("dom")
extern fn detach(node: int)

@host("dom")
extern fn get_text(node: int) -> str

@host("dom")
extern fn set_text(node: int, body: str)

@host("dom")
extern fn get_attr(node: int, name: str) -> str

@host("dom")
extern fn set_attr(node: int, name: str, value: str)

@host("dom")
extern fn drop_attr(node: int, name: str)

@host("dom")
extern fn set_style(node: int, property: str, value: str)

@host("dom")
extern fn set_class(node: int, name: str, on: bool)

@host("dom")
extern fn has_class(node: int, name: str) -> bool

@host("dom")
extern fn get_title() -> str

@host("dom")
extern fn set_title(body: str)

/// A handle on an element.
///
/// A struct rather than a bare `int` so that a node cannot be added to a
/// number by accident, and so the nothing-found case has a name.
pub struct Node {
    pub handle: int
}

/// The handle that means nothing was found.
pub fn none() -> Node {
    return Node{ handle: 0 }
}

/// Whether a handle refers to anything.
pub fn found(node: Node) -> bool {
    return node.handle != 0
}

/// The first element matching a CSS selector, or [`none`].
pub fn find(selector: str) -> Node {
    return Node{ handle: query(selector) }
}

/// Every element matching a CSS selector, in document order.
pub fn find_all(selector: str) -> [Node] {
    let handles = query_all(selector)
    var out: [Node] = []
    var current = ""
    for i in 0..handles.len() {
        let c = handles.slice(i, i + 1)
        if c == "," {
            out.push(Node{ handle: int_of(current) })
            current = ""
        } else {
            current = current + c
        }
    }
    if current.len() > 0 {
        out.push(Node{ handle: int_of(current) })
    }
    return out
}

/// A new element, not yet in the document.
pub fn element(tag: str) -> Node {
    return Node{ handle: create(tag) }
}

/// Put `child` at the end of `parent`.
pub fn add(parent: Node, child: Node) {
    append(parent.handle, child.handle)
}

/// Take an element out of the document. Its handle stops referring to
/// anything the page can see.
pub fn remove(node: Node) {
    detach(node.handle)
}

/// The element's text content.
pub fn text(node: Node) -> str {
    return get_text(node.handle)
}

/// Replace the element's text content.
///
/// Text, never markup. There is no `set_html` here and there is not going to
/// be one: it is the single most common way a program built out of strings
/// grows a script-injection bug, and a standard library should not ship the
/// loaded gun beside the safe call.
pub fn set(node: Node, body: str) {
    set_text(node.handle, body)
}

pub fn attribute(node: Node, name: str) -> str {
    return get_attr(node.handle, name)
}

pub fn set_attribute(node: Node, name: str, value: str) {
    set_attr(node.handle, name, value)
}

pub fn remove_attribute(node: Node, name: str) {
    drop_attr(node.handle, name)
}

/// One CSS property, by its CSS name — `background-color`, not
/// `backgroundColor`. The host translates; a caller writes what it would write
/// in a stylesheet.
pub fn style(node: Node, property: str, value: str) {
    set_style(node.handle, property, value)
}

pub fn add_class(node: Node, name: str) {
    set_class(node.handle, name, true)
}

pub fn remove_class(node: Node, name: str) {
    set_class(node.handle, name, false)
}

pub fn in_class(node: Node, name: str) -> bool {
    return has_class(node.handle, name)
}

/// The document's title.
pub fn title() -> str {
    return get_title()
}

pub fn retitle(body: str) {
    set_title(body)
}

fn int_of(body: str) -> int {
    var value = 0
    for i in 0..body.len() {
        let digit = body.code_at(i) - 0x30
        if digit < 0 || digit > 9 {
            return 0
        }
        value = value * 10 + digit
    }
    return value
}
