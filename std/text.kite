// Text.
//
// The algorithms that decide what order text is drawn in and which glyph a
// letter becomes — the parts of text that are decisions rather than pixels.
//
// They exist for `std/canvas`, and only for it. A browser laying out a document
// does all of this itself, so a Kite program writing into the DOM never reaches
// here; a program painting into a `<canvas>` places every glyph itself and has
// nobody to ask. Computing it in Kite rather than at the boundary is what makes
// the answer the same wherever the program runs.
//
// Everything in this module is a **named subset** of a Unicode algorithm: what
// is implemented is stated, what is not is stated, and nothing is implied.
//
// - `bidi_runs` is UAX #9, the bidirectional algorithm: rules P2–P3, X1–X10,
//   W1–W7, N0–N2 (bracket pairs included), I1–I2 and L1–L2. What it does not
//   do: L3 (combining marks at a direction boundary keep their place) and L4
//   (mirroring) are left to the renderer, which mirrors inside a
//   single-direction run on its own; explicit overrides survive resolution
//   but a renderer that re-derives a run's direction from its first strong
//   character — which is what both of ours do — will not honour an override
//   that contradicts the letters. Higher-level protocols (HL1–HL6) are not
//   implemented at all.
// - `break_opportunities` is UAX #14, the line breaking algorithm, as of
//   Unicode 15.0: rules LB1–LB31 over a Line_Break class table that covers
//   the scripts named in its section rather than every code point. Two
//   departures, both of which the annex itself names: SA (Thai, Lao, Khmer,
//   and Burmese syllable breaking) is treated as AL, which §5.1 prescribes in
//   the absence of a dictionary, and CB is not implemented because nothing
//   can be embedded in a run of Kite text to break around. The rules later
//   revisions added — LB15a–LB15d, LB20a, LB28a — are not here, and East
//   Asian Width is read only where LB30 needs it; the section says which.
// - `join_arabic` is the joining half of Arabic shaping: Joining_Type over
//   the Arabic block's own letters, mapped to Arabic Presentation Forms-B,
//   with the mandatory lam-alef ligature. It is **not HarfBuzz-quality
//   shaping**, which is OpenType GSUB/GPOS — a font's own substitution and
//   positioning programs — and cannot be written against a boundary that
//   only measures. A real shaping engine would additionally reorder Indic
//   clusters for Devanagari, position Thai marks above and below their base,
//   and reorder Burmese medial consonants; none of that happens here, and a
//   program drawing those scripts is relying on the host's font stack to do
//   it — which a browser drawing into a `<canvas>` largely does, and a
//   glyph-at-a-time renderer does not.

// ---- the Bidi_Class table --------------------------------------------------

/// A code point's part in the bidirectional algorithm, from UAX #9 table 4.
pub enum BidiClass {
    L
    R
    AL
    EN
    ES
    ET
    AN
    CS
    NSM
    BN
    B
    S
    WS
    ON
    LRE
    RLE
    LRO
    RLO
    PDF
    LRI
    RLI
    FSI
    PDI
}

fn within(code: int, low: int, high: int) -> bool {
    return code >= low && code <= high
}

/// The Bidi_Class of a code point, from a compact range table.
///
/// The table is a subset of the Unicode character database, and the subset is
/// listed rather than implied. It covers: the C0 and C1 controls; ASCII and
/// Latin-1; Latin Extended-A and -B (0100–024F); the combining diacritics
/// (0300–036F); Greek (0370–03FF); Cyrillic with its combining marks
/// (0400–04FF); Hebrew (0590–05FF) and its presentation forms (FB1D–FB4F);
/// the Arabic block (0600–06FF) with its digits, points and signs, the Arabic
/// Supplement (0750–077F), Arabic Extended-B (0870–089F), Arabic Extended-A
/// (08A0–08FF), and both Arabic presentation-forms blocks (FB50–FDFF,
/// FE70–FEFF); the combining marks of Devanagari, Thai and Myanmar (whose
/// letters are already L); general punctuation (2000–206F) including every
/// explicit bidi formatting character; currency signs (20A0–20CF); the
/// arrow, mathematical and symbol blocks (2190–2BFF) and supplemental
/// punctuation (2E00–2E7F) as ON; CJK punctuation and brackets (3000–303F);
/// the variation selectors and combining half marks (FE00–FE2F); the small
/// form variants (FE50–FE6F) as ON; and the fullwidth forms (FF01–FF65).
///
/// **Anything outside these ranges is treated as L.** For CJK, Hangul, kana,
/// and the letters of Devanagari, Thai and Myanmar that is the correct
/// answer; for Syriac, Thaana and N'Ko it is wrong and unclaimed; for emoji —
/// which are ON, and which sit outside the Basic Multilingual Plane — it
/// makes a symbol behave like a letter, which matters only when one sits
/// between two runs of opposite direction. Within the covered Arabic and
/// Greek blocks a handful of signs are coarser than the character database:
/// they are named below where they are folded.
pub fn bidi_class(code: int) -> BidiClass {
    // Past the end of a string, `code_at` answers -1.
    if code < 0 {
        return BidiClass.L
    }
    // C0 controls: tab and the separators mean something to layout, the rest
    // are boundary-neutral.
    if code == 0x0009 || code == 0x000B || code == 0x001F {
        return BidiClass.S
    }
    if code == 0x000A || code == 0x000D || within(code, 0x001C, 0x001E) {
        return BidiClass.B
    }
    if code == 0x000C {
        return BidiClass.WS
    }
    if code < 0x0020 {
        return BidiClass.BN
    }
    if code == 0x0020 {
        return BidiClass.WS
    }
    if within(code, 0x0023, 0x0025) {
        return BidiClass.ET
    }
    if code == 0x002B || code == 0x002D {
        return BidiClass.ES
    }
    if code == 0x002C || code == 0x002E || code == 0x002F || code == 0x003A {
        return BidiClass.CS
    }
    if within(code, 0x0030, 0x0039) {
        return BidiClass.EN
    }
    if within(code, 0x0041, 0x005A) || within(code, 0x0061, 0x007A) {
        return BidiClass.L
    }
    if code == 0x007F {
        return BidiClass.BN
    }
    // The rest of ASCII is punctuation.
    if code < 0x0080 {
        return BidiClass.ON
    }
    if code == 0x0085 {
        return BidiClass.B
    }
    // C1 controls.
    if code < 0x00A0 {
        return BidiClass.BN
    }
    // A no-break space separates numbers without separating them.
    if code == 0x00A0 {
        return BidiClass.CS
    }
    if within(code, 0x00A2, 0x00A5) || code == 0x00B0 || code == 0x00B1 {
        return BidiClass.ET
    }
    if code == 0x00D7 || code == 0x00F7 {
        return BidiClass.ON
    }
    if code == 0x00AA || code == 0x00B5 || code == 0x00BA || within(code, 0x00C0, 0x00FF) {
        return BidiClass.L
    }
    // The rest of Latin-1 is signs and punctuation.
    if code < 0x00C0 {
        return BidiClass.ON
    }
    // Latin Extended-A and -B.
    if within(code, 0x0100, 0x024F) {
        return BidiClass.L
    }
    // Combining diacritical marks.
    if within(code, 0x0300, 0x036F) {
        return BidiClass.NSM
    }
    // Greek — a few of its signs are properly ON, folded to L here.
    if within(code, 0x0370, 0x03FF) {
        return BidiClass.L
    }
    // Cyrillic, with its combining marks.
    if within(code, 0x0483, 0x0489) {
        return BidiClass.NSM
    }
    if within(code, 0x0400, 0x04FF) {
        return BidiClass.L
    }
    // Hebrew: the accents and points are marks, everything else in the block
    // is R — including the unassigned gaps, which Unicode also defaults to R.
    if within(code, 0x0591, 0x05BD) || code == 0x05BF || code == 0x05C1 || code == 0x05C2 ||
    code == 0x05C4 || code == 0x05C5 || code == 0x05C7 {
        return BidiClass.NSM
    }
    if within(code, 0x0590, 0x05FF) {
        return BidiClass.R
    }
    // The Arabic block. The number signs wrap around digits, so they count as
    // numbers; the points and Koranic marks are marks; the two poetic signs
    // and the sajdah sign are ON; everything else — letters, the letter mark
    // at 061C, the punctuation that behaves like a letter — is AL.
    if within(code, 0x0600, 0x0605) || code == 0x06DD {
        return BidiClass.AN
    }
    if code == 0x0609 || code == 0x060A || code == 0x066A {
        return BidiClass.ET
    }
    if code == 0x060C {
        return BidiClass.CS
    }
    if code == 0x0606 || code == 0x0607 || code == 0x060E || code == 0x060F ||
    code == 0x06DE || code == 0x06E9 {
        return BidiClass.ON
    }
    if within(code, 0x0610, 0x061A) || within(code, 0x064B, 0x065F) || code == 0x0670 ||
    within(code, 0x06D6, 0x06DC) || within(code, 0x06DF, 0x06E4) || code == 0x06E7 ||
    code == 0x06E8 || within(code, 0x06EA, 0x06ED) {
        return BidiClass.NSM
    }
    if within(code, 0x0660, 0x0669) || code == 0x066B || code == 0x066C {
        return BidiClass.AN
    }
    if within(code, 0x06F0, 0x06F9) {
        return BidiClass.EN
    }
    if within(code, 0x0600, 0x06FF) {
        return BidiClass.AL
    }
    // Arabic Supplement, Extended-B and Extended-A.
    if within(code, 0x0750, 0x077F) || within(code, 0x0870, 0x089F) {
        return BidiClass.AL
    }
    if within(code, 0x08CA, 0x08E1) || within(code, 0x08E3, 0x08FF) {
        return BidiClass.NSM
    }
    if code == 0x08E2 {
        return BidiClass.AN
    }
    if within(code, 0x08A0, 0x08FF) {
        return BidiClass.AL
    }
    // Devanagari combining marks; the letters fall through to L.
    if within(code, 0x0900, 0x0902) || code == 0x093A || code == 0x093C ||
    within(code, 0x0941, 0x0948) || code == 0x094D || within(code, 0x0951, 0x0957) ||
    code == 0x0962 || code == 0x0963 {
        return BidiClass.NSM
    }
    // Thai combining marks and the baht sign; the letters fall through to L.
    if code == 0x0E31 || within(code, 0x0E34, 0x0E3A) || within(code, 0x0E47, 0x0E4E) {
        return BidiClass.NSM
    }
    if code == 0x0E3F {
        return BidiClass.ET
    }
    // Myanmar combining marks; the letters fall through to L.
    if within(code, 0x102D, 0x1030) || within(code, 0x1032, 0x1037) || code == 0x1039 ||
    code == 0x103A || code == 0x103D || code == 0x103E || code == 0x1058 ||
    code == 0x1059 || within(code, 0x105E, 0x1060) || within(code, 0x1071, 0x1074) ||
    code == 0x1082 || code == 0x1085 || code == 0x1086 || code == 0x108D ||
    code == 0x109D {
        return BidiClass.NSM
    }
    // General punctuation, including every explicit formatting character.
    if within(code, 0x2000, 0x200A) {
        return BidiClass.WS
    }
    if within(code, 0x200B, 0x200D) {
        return BidiClass.BN
    }
    if code == 0x200E {
        return BidiClass.L
    }
    if code == 0x200F {
        return BidiClass.R
    }
    if code == 0x2028 {
        return BidiClass.WS
    }
    if code == 0x2029 {
        return BidiClass.B
    }
    if code == 0x202A {
        return BidiClass.LRE
    }
    if code == 0x202B {
        return BidiClass.RLE
    }
    if code == 0x202C {
        return BidiClass.PDF
    }
    if code == 0x202D {
        return BidiClass.LRO
    }
    if code == 0x202E {
        return BidiClass.RLO
    }
    if code == 0x202F {
        return BidiClass.CS
    }
    if within(code, 0x2030, 0x2034) {
        return BidiClass.ET
    }
    if code == 0x2044 {
        return BidiClass.CS
    }
    if code == 0x205F {
        return BidiClass.WS
    }
    if within(code, 0x2060, 0x2064) {
        return BidiClass.BN
    }
    if code == 0x2066 {
        return BidiClass.LRI
    }
    if code == 0x2067 {
        return BidiClass.RLI
    }
    if code == 0x2068 {
        return BidiClass.FSI
    }
    if code == 0x2069 {
        return BidiClass.PDI
    }
    if within(code, 0x206A, 0x206F) {
        return BidiClass.BN
    }
    if within(code, 0x2010, 0x205E) {
        return BidiClass.ON
    }
    // Currency signs.
    if within(code, 0x20A0, 0x20CF) {
        return BidiClass.ET
    }
    // Arrows, mathematics, technical symbols, and supplemental punctuation.
    if within(code, 0x2190, 0x2BFF) || within(code, 0x2E00, 0x2E7F) {
        return BidiClass.ON
    }
    // CJK punctuation, including its brackets. The ideographic space is
    // whitespace; the ideographs after the block are L by the default below.
    if code == 0x3000 {
        return BidiClass.WS
    }
    if within(code, 0x3001, 0x303F) {
        return BidiClass.ON
    }
    // Hebrew presentation forms.
    if code == 0xFB1E {
        return BidiClass.NSM
    }
    if within(code, 0xFB1D, 0xFB4F) {
        return BidiClass.R
    }
    // Arabic presentation forms. The two ornate parentheses are brackets, not
    // letters.
    if code == 0xFD3E || code == 0xFD3F {
        return BidiClass.ON
    }
    if within(code, 0xFB50, 0xFDFF) {
        return BidiClass.AL
    }
    // Variation selectors and combining half marks.
    if within(code, 0xFE00, 0xFE0F) || within(code, 0xFE20, 0xFE2F) {
        return BidiClass.NSM
    }
    // Small form variants — a few are properly CS, folded to ON here.
    if within(code, 0xFE50, 0xFE6F) {
        return BidiClass.ON
    }
    // The zero-width no-break space, which is the byte-order mark.
    if code == 0xFEFF {
        return BidiClass.BN
    }
    if within(code, 0xFE70, 0xFEFF) {
        return BidiClass.AL
    }
    // Fullwidth forms: digits are numbers, letters are letters, the rest is
    // punctuation — the same answers as their ASCII counterparts.
    if within(code, 0xFF10, 0xFF19) {
        return BidiClass.EN
    }
    if within(code, 0xFF21, 0xFF3A) || within(code, 0xFF41, 0xFF5A) {
        return BidiClass.L
    }
    if within(code, 0xFF01, 0xFF65) {
        return BidiClass.ON
    }
    // Everything else — CJK ideographs and kana, Hangul, the letters of
    // Devanagari, Thai and Myanmar, and every script this table does not
    // cover — is L.
    return BidiClass.L
}

/// Whether a code point is a nonspacing mark — `Mn`, the class the bidi table
/// calls NSM. A mark advances nothing: it draws over the letter before it, so
/// it is transparent to joining and takes its direction from its base.
pub fn is_combining(code: int) -> bool {
    return bidi_class(code) == BidiClass.NSM
}

// ---- paragraph direction ---------------------------------------------------

/// The paragraph embedding level — rules P2 and P3.
///
/// The first strong character decides: L means 0, R or AL means 1, and a
/// paragraph with no strong character at all reads left to right. Characters
/// inside an isolate are skipped, because an isolate is exactly a promise
/// that its content does not influence its surroundings.
///
/// This is asked once per paragraph and applied to every line wrapped out of
/// it — a line does not re-decide its direction, or the second line of a
/// Hebrew paragraph beginning with a number would come out backwards.
pub fn paragraph_level(body: str) -> int {
    var depth = 0
    for i in 0..body.len() {
        let c = bidi_class(body.code_at(i))
        if c == BidiClass.LRI || c == BidiClass.RLI || c == BidiClass.FSI {
            depth += 1
        } else if c == BidiClass.PDI {
            if depth > 0 {
                depth -= 1
            }
        } else if depth == 0 {
            if c == BidiClass.L {
                return 0
            }
            if c == BidiClass.R || c == BidiClass.AL {
                return 1
            }
        }
    }
    return 0
}

// ---- the resolved order ----------------------------------------------------

/// One single-direction stretch of a reordered line, in the order it is
/// painted, left to right.
///
/// `body` is in **logical order** — the order the text was written in — and a
/// renderer displays a single-direction run correctly on its own: a browser
/// re-derives the run's direction from its first strong character, which is
/// rule P2 again, and mirrors brackets inside it, which is rule L4. A run of
/// neutrals alone at an odd level has no strong character to re-derive from,
/// so it arrives already reversed and mirrored, with `rtl` false.
pub struct Run {
    pub body: str
    pub rtl: bool
}

/// A line reordered for display — the whole of UAX #9 this module implements,
/// applied: P2–P3 for the base direction, X1–X10 for the explicit formatting
/// characters, W1–W7 for the weak types, N0–N2 for the neutrals and bracket
/// pairs, I1–I2 for the levels, and L1–L2 for the final order.
///
/// The runs come out in visual order and are drawn left to right; explicit
/// formatting characters are dropped from the bodies, because they were
/// instructions and have been obeyed. An RTL paragraph is **not**
/// right-aligned by this — alignment belongs to the box, and the box speaks
/// `Justify`, so a right-aligned Hebrew paragraph is a `Justify.End` box.
pub fn bidi_runs(line: str) -> [Run] {
    return bidi_runs_with(line, paragraph_level(line))
}

/// `bidi_runs` with the paragraph level supplied, for a line wrapped out of a
/// longer paragraph — the paragraph decides once, the lines inherit.
pub fn bidi_runs_with(line: str, base: int) -> [Run] {
    // Most lines are plain left-to-right text, and a plain line is one run:
    // the full resolution would say the same thing at greater cost.
    if base == 0 && plain_left_to_right(line) {
        return [Run{ body: line, rtl: false }]
    }
    let codes = codes_of(line)
    let a = analyse(codes, base)
    return runs_from(line, codes, a)
}

/// The resolved embedding level of every character, after L1. Exposed for
/// tests: a level is the algorithm's whole intermediate state in one number.
pub fn bidi_levels(line: str) -> [int] {
    let codes = codes_of(line)
    let a = analyse(codes, paragraph_level(line))
    return a.levels
}

/// The character indices of a line in visual order, leftmost first — rule L2
/// applied at character granularity. Characters that are not drawn — the
/// explicit formatting characters — are absent.
pub fn bidi_visual(line: str) -> [int] {
    let codes = codes_of(line)
    let a = analyse(codes, paragraph_level(line))
    return visual_positions(a.levels, shown_flags(codes, a.removed))
}

/// Whether a line needs no reordering: no strong right-to-left characters,
/// no Arabic numbers, no explicit formatting characters, and no separators.
fn plain_left_to_right(line: str) -> bool {
    for i in 0..line.len() {
        let code = line.code_at(i)
        if invisible(code) {
            return false
        }
        if class_needs_bidi(bidi_class(code)) {
            return false
        }
    }
    return true
}

fn class_needs_bidi(c: BidiClass) -> bool {
    return match c {
        R | AL | AN | B | S => true
        LRE | RLE | LRO | RLO | PDF | LRI | RLI | FSI | PDI => true
        L | EN | ES | ET | CS | NSM | BN | WS | ON => false
    }
}

/// Formatting characters that resolve direction but draw nothing: the two
/// implicit marks, the Arabic letter mark, and the four isolate characters.
/// The embeddings and overrides are removed by X9 before this is asked.
fn invisible(code: int) -> bool {
    return code == 0x200E || code == 0x200F || code == 0x061C ||
    within(code, 0x2066, 0x2069)
}

fn codes_of(body: str) -> [int] {
    var out: [int] = []
    for i in 0..body.len() {
        out.push(body.code_at(i))
    }
    return out
}

fn classes_of(codes: [int]) -> [BidiClass] {
    var out: [BidiClass] = []
    for code in codes {
        out.push(bidi_class(code))
    }
    return out
}

// ---- the algorithm ---------------------------------------------------------

/// What resolution leaves behind: a level per character, which characters
/// X9 removed, and the classes the text started with — L1 and the bracket
/// rule both need the original class, not the resolved one.
struct Analysis {
    levels: [int]
    removed: [bool]
    original: [BidiClass]
}

/// Which isolate initiator matches which PDI — BD9. The matching is purely
/// lexical: a counter, not the directional stack.
struct Isolates {
    pdi_for: [int]
    initiator_for: [int]
}

fn is_isolate_initiator(c: BidiClass) -> bool {
    return match c {
        LRI | RLI | FSI => true
        _ => false
    }
}

fn match_isolates(original: [BidiClass]) -> Isolates {
    var pdi_for: [int] = []
    var initiator_for: [int] = []
    for i in 0..original.len() {
        pdi_for.push(-1)
        initiator_for.push(-1)
    }
    var stack: [int] = []
    var top = 0
    for i in 0..original.len() {
        if is_isolate_initiator(original[i]) {
            if top < stack.len() {
                stack[top] = i
            } else {
                stack.push(i)
            }
            top += 1
        } else if original[i] == BidiClass.PDI {
            if top > 0 {
                top -= 1
                pdi_for[stack[top]] = i
                initiator_for[i] = stack[top]
            }
        }
    }
    return Isolates{ pdi_for: pdi_for, initiator_for: initiator_for }
}

/// What the explicit rules leave behind: a level and a possibly overridden
/// class per character, and which characters X9 removes from the rest of the
/// resolution.
struct Explicit {
    levels: [int]
    cls: [BidiClass]
    removed: [bool]
}

fn next_odd(level: int) -> int {
    return if level % 2 == 1 { level + 2 } else { level + 1 }
}

fn next_even(level: int) -> int {
    return if level % 2 == 0 { level + 2 } else { level + 1 }
}

/// The direction an FSI takes — P2 again, over the isolate's own content.
fn fsi_rtl(original: [BidiClass], from: int) -> bool {
    var depth = 0
    let start = from + 1
    for i in start..original.len() {
        let c = original[i]
        if is_isolate_initiator(c) {
            depth += 1
        } else if c == BidiClass.PDI {
            if depth == 0 {
                return false
            }
            depth -= 1
        } else if depth == 0 {
            if c == BidiClass.L {
                return false
            }
            if c == BidiClass.R || c == BidiClass.AL {
                return true
            }
        }
    }
    return false
}

/// Rules X1–X9: the directional status stack.
///
/// Embeddings and overrides push and pop levels; isolates do the same but
/// keep their place in the text; an override rewrites the class of everything
/// under it. The depth limit is the specification's own 125, and material
/// past it overflows harmlessly rather than trapping. X9 removes the
/// embedding and override characters and the boundary-neutrals; the isolate
/// characters stay, because the rules after this one treat them as neutrals.
fn explicit_pass(original: [BidiClass], base: int) -> Explicit {
    let n = original.len()
    var levels: [int] = []
    var cls: [BidiClass] = []
    var removed: [bool] = []
    for i in 0..n {
        levels.push(base)
        cls.push(original[i])
        removed.push(false)
    }

    // The stack, as three parallel arrays with a logical top: an entry is a
    // level, an override (0 none, 1 left, 2 right) and whether an isolate
    // made it.
    var stack_level: [int] = [base]
    var stack_override: [int] = [0]
    var stack_isolate: [bool] = [false]
    var top = 1
    var overflow_isolates = 0
    var overflow_embeds = 0
    var valid_isolates = 0

    for i in 0..n {
        let c = original[i]
        if c == BidiClass.RLE || c == BidiClass.LRE || c == BidiClass.RLO || c == BidiClass.LRO {
            removed[i] = true
            levels[i] = stack_level[top - 1]
            let rtl = c == BidiClass.RLE || c == BidiClass.RLO
            let level = if rtl { next_odd(stack_level[top - 1]) } else { next_even(stack_level[top - 1]) }
            var override = 0
            if c == BidiClass.LRO {
                override = 1
            }
            if c == BidiClass.RLO {
                override = 2
            }
            if level <= 125 && overflow_isolates == 0 && overflow_embeds == 0 {
                if top < stack_level.len() {
                    stack_level[top] = level
                    stack_override[top] = override
                    stack_isolate[top] = false
                } else {
                    stack_level.push(level)
                    stack_override.push(override)
                    stack_isolate.push(false)
                }
                top += 1
            } else if overflow_isolates == 0 {
                overflow_embeds += 1
            }
        } else if c == BidiClass.PDF {
            removed[i] = true
            levels[i] = stack_level[top - 1]
            if overflow_isolates > 0 {
                // Inside an overflowed isolate nothing pops.
            } else if overflow_embeds > 0 {
                overflow_embeds -= 1
            } else if top >= 2 && !stack_isolate[top - 1] {
                top -= 1
            }
        } else if is_isolate_initiator(c) {
            // The initiator itself sits outside the isolate: current level,
            // current override.
            levels[i] = stack_level[top - 1]
            if stack_override[top - 1] == 1 {
                cls[i] = BidiClass.L
            }
            if stack_override[top - 1] == 2 {
                cls[i] = BidiClass.R
            }
            let rtl = c == BidiClass.RLI || (c == BidiClass.FSI && fsi_rtl(original, i))
            let level = if rtl { next_odd(stack_level[top - 1]) } else { next_even(stack_level[top - 1]) }
            if level <= 125 && overflow_isolates == 0 && overflow_embeds == 0 {
                valid_isolates += 1
                if top < stack_level.len() {
                    stack_level[top] = level
                    stack_override[top] = 0
                    stack_isolate[top] = true
                } else {
                    stack_level.push(level)
                    stack_override.push(0)
                    stack_isolate.push(true)
                }
                top += 1
            } else {
                overflow_isolates += 1
            }
        } else if c == BidiClass.PDI {
            if overflow_isolates > 0 {
                overflow_isolates -= 1
            } else if valid_isolates > 0 {
                overflow_embeds = 0
                for !stack_isolate[top - 1] {
                    top -= 1
                }
                top -= 1
                valid_isolates -= 1
            }
            levels[i] = stack_level[top - 1]
            if stack_override[top - 1] == 1 {
                cls[i] = BidiClass.L
            }
            if stack_override[top - 1] == 2 {
                cls[i] = BidiClass.R
            }
        } else if c == BidiClass.B {
            // A paragraph separator inside a line is unusual; it takes the
            // paragraph level, which is rule X8.
            levels[i] = base
        } else if c == BidiClass.BN {
            removed[i] = true
            levels[i] = stack_level[top - 1]
        } else {
            levels[i] = stack_level[top - 1]
            if stack_override[top - 1] == 1 {
                cls[i] = BidiClass.L
            }
            if stack_override[top - 1] == 2 {
                cls[i] = BidiClass.R
            }
        }
    }
    return Explicit{ levels: levels, cls: cls, removed: removed }
}

/// Rule X10: the isolating run sequences.
///
/// A level run that ends with an isolate initiator continues at its matching
/// PDI, so the text inside the isolate cannot affect the text around it. Each
/// sequence is the unit the W, N and I rules run over.
fn sequences_of(
    levels: [int],
    removed: [bool],
    original: [BidiClass],
    iso: Isolates,
) -> [[int]] {
    // The surviving characters, in logical order.
    var order: [int] = []
    for i in 0..levels.len() {
        if !removed[i] {
            order.push(i)
        }
    }

    // Maximal level runs over the surviving characters.
    var run_first: [int] = []
    var run_last: [int] = []
    var k = 0
    for k < order.len() {
        let start = k
        k += 1
        for k < order.len() && levels[order[k]] == levels[order[start]] {
            k += 1
        }
        run_first.push(order[start])
        run_last.push(order[k - 1])
    }

    var sequences: [[int]] = []
    for r in 0..run_first.len() {
        // A run whose first character is a matched PDI continues an earlier
        // sequence rather than starting one.
        let first = run_first[r]
        if original[first] == BidiClass.PDI && iso.initiator_for[first] != -1 {
            continue
        }
        var seq: [int] = []
        var current = r
        for {
            // Append the run's surviving characters.
            var j = run_first[current]
            for j <= run_last[current] {
                if !removed[j] {
                    seq.push(j)
                }
                j += 1
            }
            let last = run_last[current]
            if !is_isolate_initiator(original[last]) || iso.pdi_for[last] == -1 {
                break
            }
            // Continue at the run that starts with the matching PDI.
            let target = iso.pdi_for[last]
            var found = -1
            for r2 in 0..run_first.len() {
                if run_first[r2] == target {
                    found = r2
                }
            }
            if found == -1 {
                break
            }
            current = found
        }
        sequences.push(seq)
    }
    return sequences
}

/// Whether the boundary before a sequence reads right-to-left: the higher of
/// the sequence's level and its neighbour's, odd meaning R — the sos and eos
/// of X10.
fn boundary_before(seq: [int], levels: [int], removed: [bool], base: int) -> bool {
    var before = base
    var j = seq[0] - 1
    for j >= 0 {
        if !removed[j] {
            before = levels[j]
            break
        }
        j -= 1
    }
    return max(levels[seq[0]], before) % 2 == 1
}

fn boundary_after(
    seq: [int],
    levels: [int],
    removed: [bool],
    original: [BidiClass],
    base: int,
    iso: Isolates,
) -> bool {
    let last = seq[seq.len() - 1]
    var after = base
    if is_isolate_initiator(original[last]) && iso.pdi_for[last] == -1 {
        // An isolate that never closes runs to the end of the paragraph.
        after = base
    } else {
        var j = last + 1
        for j < levels.len() {
            if !removed[j] {
                after = levels[j]
                break
            }
            j += 1
        }
    }
    return max(levels[seq[seq.len() - 1]], after) % 2 == 1
}

/// Rules W1–W7: the weak types.
///
/// Marks take their base's class; European numbers become Arabic after
/// Arabic letters; Arabic letters then count as R; separators between
/// digits join the digits; terminators beside them do the same; whatever
/// separator is left is a neutral; and a European number in left-to-right
/// company is just text.
fn resolve_weak(classes: [BidiClass], original: [BidiClass], seq: [int], sos_r: bool) -> [BidiClass] {
    var cls = classes
    let n = seq.len()
    // From here on an isolate initiator or PDI takes part as a neutral.
    for k in 0..n {
        // Unless an override already made it L or R (X5a–X5c, X6a).
        if cls[seq[k]] == original[seq[k]] && (is_isolate_initiator(original[seq[k]]) || original[seq[k]] == BidiClass.PDI) {
            cls[seq[k]] = BidiClass.ON
        }
    }
    // W1: a mark becomes its base — or a neutral, when what precedes it is an
    // isolate boundary, which no mark can attach across.
    for k in 0..n {
        if cls[seq[k]] == BidiClass.NSM {
            if k == 0 {
                cls[seq[k]] = if sos_r { BidiClass.R } else { BidiClass.L }
            } else if is_isolate_initiator(original[seq[k - 1]]) ||
            original[seq[k - 1]] == BidiClass.PDI {
                cls[seq[k]] = BidiClass.ON
            } else {
                cls[seq[k]] = cls[seq[k - 1]]
            }
        }
    }
    // W2: a European number after an Arabic letter is an Arabic number.
    var strong = if sos_r { BidiClass.R } else { BidiClass.L }
    for k in 0..n {
        let c = cls[seq[k]]
        if c == BidiClass.L || c == BidiClass.R || c == BidiClass.AL {
            strong = c
        }
        if c == BidiClass.EN && strong == BidiClass.AL {
            cls[seq[k]] = BidiClass.AN
        }
    }
    // W3: Arabic letters count as R from here on.
    for k in 0..n {
        if cls[seq[k]] == BidiClass.AL {
            cls[seq[k]] = BidiClass.R
        }
    }
    // W4: a single separator between two numbers of the right kind joins them.
    for k in 0..n {
        if k > 0 && k < n - 1 {
            let prev = cls[seq[k - 1]]
            let next = cls[seq[k + 1]]
            if cls[seq[k]] == BidiClass.ES && prev == BidiClass.EN && next == BidiClass.EN {
                cls[seq[k]] = BidiClass.EN
            }
            if cls[seq[k]] == BidiClass.CS && prev == BidiClass.EN && next == BidiClass.EN {
                cls[seq[k]] = BidiClass.EN
            }
            if cls[seq[k]] == BidiClass.CS && prev == BidiClass.AN && next == BidiClass.AN {
                cls[seq[k]] = BidiClass.AN
            }
        }
    }
    // W5: terminators adjacent to a European number join it, on either side.
    for k in 0..n {
        if cls[seq[k]] == BidiClass.ET && k > 0 && cls[seq[k - 1]] == BidiClass.EN {
            cls[seq[k]] = BidiClass.EN
        }
    }
    var k = n - 1
    for k >= 0 {
        if cls[seq[k]] == BidiClass.ET && k < n - 1 && cls[seq[k + 1]] == BidiClass.EN {
            cls[seq[k]] = BidiClass.EN
        }
        k -= 1
    }
    // W6: whatever separator or terminator is left is a neutral.
    for k2 in 0..n {
        let c = cls[seq[k2]]
        if c == BidiClass.ES || c == BidiClass.ET || c == BidiClass.CS {
            cls[seq[k2]] = BidiClass.ON
        }
    }
    // W7: a European number in left-to-right company is just text.
    var left = !sos_r
    for k3 in 0..n {
        let c = cls[seq[k3]]
        if c == BidiClass.L {
            left = true
        }
        if c == BidiClass.R {
            left = false
        }
        if c == BidiClass.EN && left {
            cls[seq[k3]] = BidiClass.L
        }
    }
    return cls
}

// ---- bracket pairs ---------------------------------------------------------
//
// The pair table is a subset of BidiBrackets.txt, and the subset is listed:
// the three ASCII pairs, the floor and ceiling corners, the deprecated angle
// brackets (canonically equal to the CJK ones, which BD16 requires honouring),
// the mathematical white and angle brackets at 27E6–27EF, the CJK pairs at
// 3008–301B, and the fullwidth pairs. Everything else — the Tibetan marks,
// the ornate Arabic parentheses, the superscripted pairs — is not a bracket
// here, and falls to N1 and N2 like any other neutral.

/// The closing bracket an opening one pairs with, or 0 for everything else.
fn bracket_close(code: int) -> int {
    if code == 0x0028 {
        return 0x0029
    }
    if code == 0x005B {
        return 0x005D
    }
    if code == 0x007B {
        return 0x007D
    }
    if code == 0x2308 {
        return 0x2309
    }
    if code == 0x230A {
        return 0x230B
    }
    if code == 0x2329 {
        return 0x232A
    }
    if within(code, 0x27E6, 0x27EE) && code % 2 == 0 {
        return code + 1
    }
    if within(code, 0x3008, 0x3010) && code % 2 == 0 {
        return code + 1
    }
    if within(code, 0x3014, 0x301A) && code % 2 == 0 {
        return code + 1
    }
    if code == 0xFF08 {
        return 0xFF09
    }
    if code == 0xFF3B {
        return 0xFF3D
    }
    if code == 0xFF5B {
        return 0xFF5D
    }
    if code == 0xFF5F {
        return 0xFF60
    }
    if code == 0xFF62 {
        return 0xFF63
    }
    return 0
}

/// The deprecated angle brackets are canonically the CJK ones, and BD16 says
/// canonical equivalence decides a match.
fn bracket_canon(code: int) -> int {
    if code == 0x2329 {
        return 0x3008
    }
    if code == 0x232A {
        return 0x3009
    }
    return code
}

/// Whether a code point closes any bracket in the table.
fn is_bracket_close(code: int) -> bool {
    let canon = bracket_canon(code)
    if canon == 0x0029 || canon == 0x005D || canon == 0x007D {
        return true
    }
    if canon == 0x2309 || canon == 0x230B {
        return true
    }
    if within(canon, 0x27E7, 0x27EF) && canon % 2 == 1 {
        return true
    }
    if within(canon, 0x3009, 0x3011) && canon % 2 == 1 {
        return true
    }
    if within(canon, 0x3015, 0x301B) && canon % 2 == 1 {
        return true
    }
    if canon == 0xFF09 || canon == 0xFF3D || canon == 0xFF5D || canon == 0xFF60 ||
    canon == 0xFF63 {
        return true
    }
    return false
}

/// L for a strong left-to-right, R for a strong right-to-left — with numbers
/// counting as R, which is what N0 and N1 both say — or neither.
fn n_strong(c: BidiClass) -> int {
    return match c {
        L => 0
        R | EN | AN => 1
        _ => -1
    }
}

/// Rule N0: paired brackets take the direction of what they contain.
///
/// Pairs are found with BD16's stack — nesting respected, a stray bracket
/// ignored, and at the sixty-fourth open bracket the search stops with what
/// it has, which is the specification's own limit. A pair containing a strong
/// character in the embedding direction takes that direction; one containing
/// only the opposite direction takes its context; one containing no strong
/// character at all is left for N1 and N2.
fn resolve_brackets(
    codes: [int],
    classes: [BidiClass],
    original: [BidiClass],
    seq: [int],
    level: int,
    sos_r: bool,
) -> [BidiClass] {
    var cls = classes
    let n = seq.len()
    let e_dir = level % 2
    // Find the pairs.
    var stack_code: [int] = []
    var stack_at: [int] = []
    var top = 0
    var open_at: [int] = []
    var close_at: [int] = []
    for k in 0..n {
        if cls[seq[k]] != BidiClass.ON {
            continue
        }
        let code = codes[seq[k]]
        if bracket_close(code) != 0 {
            if top == 63 {
                break
            }
            if top < stack_code.len() {
                stack_code[top] = code
                stack_at[top] = k
            } else {
                stack_code.push(code)
                stack_at.push(k)
            }
            top += 1
        } else if is_bracket_close(code) {
            var j = top - 1
            for j >= 0 {
                if bracket_canon(bracket_close(stack_code[j])) == bracket_canon(code) {
                    open_at.push(stack_at[j])
                    close_at.push(k)
                    top = j
                    break
                }
                j -= 1
            }
        }
    }
    // Process pairs in the order their openings appear.
    let opens = open_at
    var order: [int] = []
    for p in 0..open_at.len() {
        order.push(p)
    }
    order = sorted(order, |a: int, b: int| opens[a] < opens[b])
    for p in order {
        let o = open_at[p]
        let c = close_at[p]
        var found_e = false
        var found_o = false
        var k = o + 1
        for k < c {
            let s = n_strong(cls[seq[k]])
            if s == e_dir {
                found_e = true
            }
            if s == 1 - e_dir {
                found_o = true
            }
            k += 1
        }
        if !found_e && !found_o {
            continue
        }
        var direction = e_dir
        if !found_e {
            // Only the opposite direction inside: the context before the
            // opening bracket decides, sos standing in at the start.
            var ctx = if sos_r { 1 } else { 0 }
            var j = o - 1
            for j >= 0 {
                let s = n_strong(cls[seq[j]])
                if s != -1 {
                    ctx = s
                    break
                }
                j -= 1
            }
            if ctx == 1 - e_dir {
                direction = 1 - e_dir
            }
        }
        let assigned = if direction == 1 { BidiClass.R } else { BidiClass.L }
        cls[seq[o]] = assigned
        cls[seq[c]] = assigned
        // A mark that followed a bracket follows it into its new class.
        var m = o + 1
        for m < n && original[seq[m]] == BidiClass.NSM {
            cls[seq[m]] = assigned
            m += 1
        }
        m = c + 1
        for m < n && original[seq[m]] == BidiClass.NSM {
            cls[seq[m]] = assigned
            m += 1
        }
    }
    return cls
}

fn is_neutral(c: BidiClass) -> bool {
    return match c {
        ON | WS | B | S => true
        _ => false
    }
}

/// Rules N1 and N2: a stretch of neutrals between two strongs of the same
/// direction takes it; anything still unresolved takes the embedding
/// direction. Numbers push like R on their neighbours, and the sequence
/// boundaries stand in for text beyond them.
fn resolve_neutrals(
    classes: [BidiClass],
    seq: [int],
    level: int,
    sos_r: bool,
    eos_r: bool,
) -> [BidiClass] {
    var cls = classes
    let n = seq.len()
    let e = if level % 2 == 1 { BidiClass.R } else { BidiClass.L }
    var k = 0
    for k < n {
        if !is_neutral(cls[seq[k]]) {
            k += 1
            continue
        }
        let start = k
        for k < n && is_neutral(cls[seq[k]]) {
            k += 1
        }
        var before = 0
        if start == 0 {
            before = if sos_r { 1 } else { 0 }
        } else {
            before = n_strong(cls[seq[start - 1]])
        }
        var after = 0
        if k == n {
            after = if eos_r { 1 } else { 0 }
        } else {
            after = n_strong(cls[seq[k]])
        }
        var assigned = e
        if before == after && before != -1 {
            assigned = if before == 1 { BidiClass.R } else { BidiClass.L }
        }
        var j = start
        for j < k {
            cls[seq[j]] = assigned
            j += 1
        }
    }
    return cls
}

/// Rules I1 and I2: numbers and opposite-direction text rise above their
/// embedding level, which is what makes digits read left to right inside
/// Hebrew and Hebrew read right to left inside English.
fn raise_levels(given: [int], cls: [BidiClass], seq: [int]) -> [int] {
    var levels = given
    for k in 0..seq.len() {
        let p = seq[k]
        let c = cls[p]
        if levels[p] % 2 == 0 {
            if c == BidiClass.R {
                levels[p] = levels[p] + 1
            }
            if c == BidiClass.AN || c == BidiClass.EN {
                levels[p] = levels[p] + 2
            }
        } else {
            if c == BidiClass.L || c == BidiClass.EN || c == BidiClass.AN {
                levels[p] = levels[p] + 1
            }
        }
    }
    return levels
}

/// Rule L1: separators, and the whitespace trailing a line or leading up to a
/// separator, return to the paragraph level — which is why the space at the
/// end of a right-to-left line sits at its left edge rather than inside the
/// text.
fn reset_separators(
    given: [int],
    original: [BidiClass],
    removed: [bool],
    base: int,
) -> [int] {
    var levels = given
    let n = original.len()
    for i in 0..n {
        if original[i] == BidiClass.B || original[i] == BidiClass.S {
            levels[i] = base
            var j = i - 1
            for j >= 0 && resettable(original[j], removed[j]) {
                levels[j] = base
                j -= 1
            }
        }
    }
    var j = n - 1
    for j >= 0 && resettable(original[j], removed[j]) {
        levels[j] = base
        j -= 1
    }
    return levels
}

/// What L1 walks back over: whitespace, the isolate characters, and the
/// characters X9 removed — which draw nothing and should not hold a level
/// hostage.
fn resettable(c: BidiClass, was_removed: bool) -> bool {
    if was_removed {
        return true
    }
    return match c {
        WS | LRI | RLI | FSI | PDI => true
        _ => false
    }
}

/// The whole resolution, P2 aside: explicit levels, isolating run sequences,
/// weak types, brackets, neutrals, implicit levels, and the separator reset.
fn analyse(codes: [int], base: int) -> Analysis {
    let original = classes_of(codes)
    let iso = match_isolates(original)
    let x = explicit_pass(original, base)
    var cls = x.cls
    var levels = x.levels
    let seqs = sequences_of(levels, x.removed, original, iso)
    for seq in seqs {
        if seq.len() == 0 {
            continue
        }
        let level = levels[seq[0]]
        // X10 compares *embedding* levels; `levels` has already been raised
        // by I1–I2 for the sequences resolved before this one.
        let sos_r = boundary_before(seq, x.levels, x.removed, base)
        let eos_r = boundary_after(seq, x.levels, x.removed, original, base, iso)
        cls = resolve_weak(cls, original, seq, sos_r)
        cls = resolve_brackets(codes, cls, original, seq, level, sos_r)
        cls = resolve_neutrals(cls, seq, level, sos_r, eos_r)
        levels = raise_levels(levels, cls, seq)
    }
    levels = reset_separators(levels, original, x.removed, base)
    return Analysis{ levels: levels, removed: x.removed, original: original }
}

/// Which characters are drawn at all: not removed by X9, and not one of the
/// invisible direction marks.
fn shown_flags(codes: [int], removed: [bool]) -> [bool] {
    var out: [bool] = []
    for i in 0..codes.len() {
        out.push(!removed[i] && !invisible(codes[i]))
    }
    return out
}

/// Rule L2 at character granularity: from the highest level present down to
/// level one, reverse every maximal stretch at or above it. A left-to-right
/// number inside right-to-left text is reversed twice, which is why it comes
/// out forwards.
fn visual_positions(levels: [int], keep: [bool]) -> [int] {
    var pos: [int] = []
    for i in 0..levels.len() {
        if keep[i] {
            pos.push(i)
        }
    }
    if pos.len() == 0 {
        return pos
    }
    var highest = 0
    for p in pos {
        highest = max(highest, levels[p])
    }
    var l = highest
    for l >= 1 {
        var k = 0
        for k < pos.len() {
            if levels[pos[k]] < l {
                k += 1
                continue
            }
            let start = k
            for k < pos.len() && levels[pos[k]] >= l {
                k += 1
            }
            var lo = start
            var hi = k - 1
            for lo < hi {
                let tmp = pos[lo]
                pos[lo] = pos[hi]
                pos[hi] = tmp
                lo += 1
                hi -= 1
            }
        }
        l -= 1
    }
    return pos
}

/// The mirrored counterpart of a bracket, or the character itself. This is
/// rule L4 for the pair table above and nothing more — the full mirroring
/// table also swaps guillemets, comparison signs and a few hundred
/// mathematical symbols, and a renderer that draws whole runs gets those from
/// the host. Only a reversed neutral run needs this copy.
fn mirror_char(c: str) -> str {
    let opens = "([{\u{2308}\u{230a}\u{2329}\u{27e6}\u{27e8}\u{27ea}\u{27ec}\u{27ee}\u{3008}\u{300a}\u{300c}\u{300e}\u{3010}\u{3014}\u{3016}\u{3018}\u{301a}\u{ff08}\u{ff3b}\u{ff5b}\u{ff5f}\u{ff62}"
    let closes = ")]}\u{2309}\u{230b}\u{232a}\u{27e7}\u{27e9}\u{27eb}\u{27ed}\u{27ef}\u{3009}\u{300b}\u{300d}\u{300f}\u{3011}\u{3015}\u{3017}\u{3019}\u{301b}\u{ff09}\u{ff3d}\u{ff5d}\u{ff60}\u{ff63}"
    let o = opens.index_of(c)
    if o >= 0 {
        return closes.slice(o, o + 1)
    }
    let cl = closes.index_of(c)
    if cl >= 0 {
        return opens.slice(cl, cl + 1)
    }
    return c
}

/// Group the visual order into runs a renderer can draw whole.
///
/// A stretch of the visual order whose logical positions step forwards is a
/// left-to-right run; one that steps backwards is right-to-left, and its body
/// is kept in logical order for the renderer to reverse — a renderer shapes
/// and mirrors inside a run it knows the direction of, and it re-derives that
/// direction from the run's first strong character. A right-to-left run with
/// no strong character gives it nothing to re-derive from, so that one case
/// arrives pre-reversed, brackets mirrored, and says `rtl: false`.
fn runs_from(line: str, codes: [int], a: Analysis) -> [Run] {
    let keep = shown_flags(codes, a.removed)
    let pos = visual_positions(a.levels, keep)
    if pos.len() == 0 {
        return [Run{ body: "", rtl: false }]
    }

    // The next and previous drawn character, for stepping over dropped ones.
    let n = codes.len()
    var next_shown: [int] = []
    var prev_shown: [int] = []
    for i in 0..n {
        next_shown.push(-1)
        prev_shown.push(-1)
    }
    var last = -1
    for i in 0..n {
        if keep[i] {
            prev_shown[i] = last
            if last >= 0 {
                next_shown[last] = i
            }
            last = i
        }
    }

    var out: [Run] = []
    var k = 0
    for k < pos.len() {
        let start = k
        let parity = a.levels[pos[start]] % 2
        k += 1
        // 0 while undecided, then +1 stepping forwards or -1 backwards.
        var direction = 0
        for k < pos.len() {
            if a.levels[pos[k]] % 2 != parity {
                break
            }
            let forwards = next_shown[pos[k - 1]] == pos[k]
            let backwards = prev_shown[pos[k - 1]] == pos[k]
            if direction >= 0 && forwards {
                direction = 1
            } else if direction <= 0 && backwards {
                direction = -1
            } else {
                break
            }
            k += 1
        }
        out.push(run_of(line, a, keep, pos, start, k, parity))
    }
    return out
}

/// One grouped run, from a slice of the visual order.
fn run_of(
    line: str,
    a: Analysis,
    keep: [bool],
    pos: [int],
    from: int,
    to: int,
    parity: int,
) -> Run {
    // The run's logical extent, and whether anything in it is strong enough
    // for a renderer to re-derive its direction from.
    var lo = pos[from]
    var hi = pos[from]
    var strong = false
    for k in from..to {
        let p = pos[k]
        lo = min(lo, p)
        hi = max(hi, p)
        if a.original[p] == BidiClass.R || a.original[p] == BidiClass.AL {
            strong = true
        }
    }
    if parity == 1 && !strong {
        // A reversed neutral run: already in visual order, brackets mirrored,
        // nothing left for the renderer to decide.
        var body = ""
        for k in from..to {
            body = body + mirror_char(line.slice(pos[k], pos[k] + 1))
        }
        return Run{ body: body, rtl: false }
    }
    var body = ""
    var i = lo
    for i <= hi {
        if keep[i] {
            body = body + line.slice(i, i + 1)
        }
        i += 1
    }
    return Run{ body: body, rtl: parity == 1 }
}

// ---- Arabic joining --------------------------------------------------------

/// A letter's presentation forms, as a string in the fixed Forms-B order:
/// isolated, final, initial, medial. A right-joining letter has only the
/// first two; hamza stands alone and has one. The empty string means the
/// letter is not in the table.
///
/// The table is the Arabic block's own alphabet — the twenty-eight letters,
/// the hamza carriers, teh marbuta and alef maksura — which is exactly what
/// Arabic Presentation Forms-B covers. Persian, Urdu, Pashto and the other
/// extensions have no forms in that block and pass through unshaped.
fn arabic_forms(code: int) -> str {
    if code == 0x0621 {
        return "\u{fe80}"
    }
    if code == 0x0622 {
        return "\u{fe81}\u{fe82}"
    }
    if code == 0x0623 {
        return "\u{fe83}\u{fe84}"
    }
    if code == 0x0624 {
        return "\u{fe85}\u{fe86}"
    }
    if code == 0x0625 {
        return "\u{fe87}\u{fe88}"
    }
    if code == 0x0626 {
        return "\u{fe89}\u{fe8a}\u{fe8b}\u{fe8c}"
    }
    if code == 0x0627 {
        return "\u{fe8d}\u{fe8e}"
    }
    if code == 0x0628 {
        return "\u{fe8f}\u{fe90}\u{fe91}\u{fe92}"
    }
    if code == 0x0629 {
        return "\u{fe93}\u{fe94}"
    }
    if code == 0x062A {
        return "\u{fe95}\u{fe96}\u{fe97}\u{fe98}"
    }
    if code == 0x062B {
        return "\u{fe99}\u{fe9a}\u{fe9b}\u{fe9c}"
    }
    if code == 0x062C {
        return "\u{fe9d}\u{fe9e}\u{fe9f}\u{fea0}"
    }
    if code == 0x062D {
        return "\u{fea1}\u{fea2}\u{fea3}\u{fea4}"
    }
    if code == 0x062E {
        return "\u{fea5}\u{fea6}\u{fea7}\u{fea8}"
    }
    if code == 0x062F {
        return "\u{fea9}\u{feaa}"
    }
    if code == 0x0630 {
        return "\u{feab}\u{feac}"
    }
    if code == 0x0631 {
        return "\u{fead}\u{feae}"
    }
    if code == 0x0632 {
        return "\u{feaf}\u{feb0}"
    }
    if code == 0x0633 {
        return "\u{feb1}\u{feb2}\u{feb3}\u{feb4}"
    }
    if code == 0x0634 {
        return "\u{feb5}\u{feb6}\u{feb7}\u{feb8}"
    }
    if code == 0x0635 {
        return "\u{feb9}\u{feba}\u{febb}\u{febc}"
    }
    if code == 0x0636 {
        return "\u{febd}\u{febe}\u{febf}\u{fec0}"
    }
    if code == 0x0637 {
        return "\u{fec1}\u{fec2}\u{fec3}\u{fec4}"
    }
    if code == 0x0638 {
        return "\u{fec5}\u{fec6}\u{fec7}\u{fec8}"
    }
    if code == 0x0639 {
        return "\u{fec9}\u{feca}\u{fecb}\u{fecc}"
    }
    if code == 0x063A {
        return "\u{fecd}\u{fece}\u{fecf}\u{fed0}"
    }
    if code == 0x0641 {
        return "\u{fed1}\u{fed2}\u{fed3}\u{fed4}"
    }
    if code == 0x0642 {
        return "\u{fed5}\u{fed6}\u{fed7}\u{fed8}"
    }
    if code == 0x0643 {
        return "\u{fed9}\u{feda}\u{fedb}\u{fedc}"
    }
    if code == 0x0644 {
        return "\u{fedd}\u{fede}\u{fedf}\u{fee0}"
    }
    if code == 0x0645 {
        return "\u{fee1}\u{fee2}\u{fee3}\u{fee4}"
    }
    if code == 0x0646 {
        return "\u{fee5}\u{fee6}\u{fee7}\u{fee8}"
    }
    if code == 0x0647 {
        return "\u{fee9}\u{feea}\u{feeb}\u{feec}"
    }
    if code == 0x0648 {
        return "\u{feed}\u{feee}"
    }
    if code == 0x0649 {
        return "\u{feef}\u{fef0}"
    }
    if code == 0x064A {
        return "\u{fef1}\u{fef2}\u{fef3}\u{fef4}"
    }
    return ""
}

/// Whether a letter connects forwards, to the letter written after it: the
/// dual-joining letters do, the tatweel exists to, and everything else does
/// not.
fn connects_forwards(code: int) -> bool {
    if code == 0x0640 {
        return true
    }
    return arabic_forms(code).len() == 4
}

/// Whether a letter connects backwards, to the letter written before it:
/// anything with a final form, and the tatweel.
fn connects_backwards(code: int) -> bool {
    if code == 0x0640 {
        return true
    }
    return arabic_forms(code).len() >= 2
}

/// The nearest non-transparent character before `at`, or -1. Marks are
/// transparent to joining — a shadda between two letters does not break the
/// stroke that connects them.
fn prev_base(codes: [int], at: int) -> int {
    var j = at - 1
    for j >= 0 {
        if !is_combining(codes[j]) {
            return j
        }
        j -= 1
    }
    return -1
}

fn next_base(codes: [int], at: int) -> int {
    var j = at + 1
    for j < codes.len() {
        if !is_combining(codes[j]) {
            return j
        }
        j += 1
    }
    return -1
}

/// The lam-alef ligature — the one ligature Arabic requires rather than
/// prefers. `joined` selects the final form, for a lam that connects to the
/// letter before it.
fn lam_alef(alef: int, joined: bool) -> str {
    let forms = if alef == 0x0622 {
        "\u{fef5}\u{fef6}"
    } else if alef == 0x0623 {
        "\u{fef7}\u{fef8}"
    } else if alef == 0x0625 {
        "\u{fef9}\u{fefa}"
    } else {
        "\u{fefb}\u{fefc}"
    }
    return if joined { forms.slice(1, 2) } else { forms.slice(0, 1) }
}

fn is_lam_alef(code: int) -> bool {
    return code == 0x0622 || code == 0x0623 || code == 0x0625 || code == 0x0627
}

/// Arabic contextual joining: each letter of the Arabic block becomes the
/// presentation form its neighbours demand — isolated, final, initial or
/// medial — and lam followed by alef becomes the mandatory ligature.
///
/// This is the Joining_Type algorithm over the table above, and it is **not
/// shaping**: a font's own GSUB rules choose better glyphs than the
/// presentation-forms block offers, kern them, and position their marks. The
/// a canvas asked to draw a whole run through `fillText` gets all of that from
/// the host and never needs this function. What needs it is anything drawing
/// one glyph at a time —
/// a glyph atlas cannot cache a letter whose shape depends on its
/// neighbours, and can cache a presentation form, whose shape is the point
/// of it.
///
/// Marks are transparent: a fatha or shadda between two letters neither
/// breaks their joining nor is itself changed. Letters outside the table —
/// Persian, Urdu, anything beyond the block's own alphabet — pass through
/// unshaped and do not join, which is stated rather than guessed at.
pub fn join_arabic(run: str) -> str {
    let codes = codes_of(run)
    let n = codes.len()
    var out = ""
    var i = 0
    for i < n {
        let code = codes[i]
        let forms = arabic_forms(code)
        if forms.len() == 0 {
            out = out + run.slice(i, i + 1)
            i += 1
            continue
        }
        let before = prev_base(codes, i)
        let joined_before = before >= 0 && connects_forwards(codes[before])
        let after = next_base(codes, i)
        // The ligature holds across marks too: a lam with a fatha on it is
        // still a lam before an alef, and the ligature is still mandatory.
        // Looking only at the very next character missed it, and drew the
        // two letters apart. The marks follow the ligature, which carries
        // them as the lam did.
        if code == 0x0644 && after >= 0 && is_lam_alef(codes[after]) {
            out = out + lam_alef(codes[after], joined_before) + run.slice(i + 1, after)
            i = after + 1
            continue
        }
        let joined_after = forms.len() == 4 && after >= 0 && connects_backwards(codes[after])
        var index = 0
        if joined_before && joined_after {
            index = 3
        } else if joined_before {
            index = 1
        } else if joined_after {
            index = 2
        }
        out = out + forms.slice(index, index + 1)
        i += 1
    }
    return out
}

// ---- UAX #14: line breaking -------------------------------------------------
//
// Where a line *may* break, as opposed to where it *must* fit. The two are
// different questions and only the second needs a font: this decides the
// opportunities, and `wrap`, at the end of this section, takes them: the
// greedy half, with the measurement handed in by the caller — `canvas.width_of`
// on a canvas, one per character in a terminal.
//
// **The subset, named.** The Line_Break property is a table of every assigned
// code point, and what is here covers the classes that occur in the scripts the
// golden suite draws — Latin, Cyrillic, Greek, Arabic, Hebrew, Devanagari,
// Thai, CJK, Hangul, Burmese — plus the punctuation and symbols that appear
// beside them. A code point this table does not know is `AL`, alphabetic, which
// is what UAX #14 itself prescribes for unassigned code points (rule LB1, XX →
// AL) and gives the safe answer: no break inside an unknown word.
//
// Two deliberate departures, both of which UAX #14 permits and names:
//
//   * **SA is treated as AL.** Thai, Lao, Khmer and Burmese break between
//     syllables, and finding those requires a dictionary — UAX #14 §5.1 says
//     so, and says "in the absence of such a analysis, treat as AL". So Thai
//     wraps at spaces here. A dictionary is a different kind of artefact from
//     a property table and would be the larger half of this module.
//   * **CB is not implemented**, because there is nothing embedded to break
//     around: `Content` holds text or a picture, never text with a picture
//     inside it.
//
// **The revision is Unicode 15.0** (UAX #14 revision 49): rules LB2 to LB31
// as that revision numbers them, with the tailorable ones at their defaults —
// `CJ` resolves to `NS`, and LB25 is the regular-expression form. What this
// buys over breaking at spaces: a URL breaks after its slashes, a
// non-breaking space does not break, `(a)` keeps its brackets, a number is not
// split from its sign or its percent, a closing quote does not start a line,
// a flag stays one flag and an emoji keeps its skin tone.
//
// What is **not** implemented, besides SA and CB above:
//
//   * **LB15a–LB15d, LB20a and LB28a**, which arrived in Unicode 15.1 and
//     later: quotation marks told apart by their general category (`Pi`,
//     `Pf`), a hyphen at the start of a word, and the Aksara classes (`AK`,
//     `AP`, `AS`, `VI`, `VF`) of the Brahmic scripts that use them. This
//     module's LB15 is 15.0's single `QU SP* × OP`, and Aksara letters are AL.
//   * **East Asian Width is read only in LB30**, and only for the opening
//     brackets this table knows: a fullwidth `（` may break after a letter,
//     as the rule says. `AI` resolves to AL, as LB1 prescribes by default.
//   * **Extended_Pictographic is not tracked**, so LB30b's second half — an
//     unassigned pictographic code point before an emoji modifier — is not
//     applied. `EB × EM` is.
//
// Measured against the Unicode 18.0 `LineBreakTest.txt`, which is newer than
// the rules here, about one line in sixteen disagrees, and each of them falls
// in one of those families or is a code point this table has no range for —
// a spacing mark (`Mc`), a pictographic code point not yet assigned, one of a
// few rare scripts' letters — and so reads as AL.

/// The Line_Break classes this module distinguishes.
pub enum LineBreak {
    /// Mandatory break: newline and friends.
    BK
    /// Carriage return, line feed — sequenced by LB5.
    CR
    LF
    /// Next line, U+0085.
    NL
    /// Space.
    SP
    /// Zero-width space: a break opportunity that shows nothing.
    ZW
    /// Word joiner and friends: never break either side.
    WJ
    /// Non-breaking glue: a no-break space, a narrow no-break space.
    GL
    /// Combining mark: takes the class of what it attaches to.
    CM
    /// Opening punctuation — no break after.
    OP
    /// Closing punctuation — no break before.
    CL
    /// Closing parenthesis, which LB30 treats slightly differently from CL.
    CP
    /// Quotation mark — no break either side.
    QU
    /// Exclamation and interrogation — no break before.
    EX
    /// Infix separator: a comma or a full stop inside a number.
    IS
    /// Symbol allowing a break after: the solidus.
    SY
    /// Numeric prefix: a currency sign.
    PR
    /// Numeric postfix: a percent sign, a degree sign.
    PO
    /// Hyphen-minus.
    HY
    /// Break after: an en dash, a slash-like separator.
    BA
    /// Break before.
    BB
    /// Em dash: breaks either side.
    B2
    /// Non-starter: a small kana, a middle dot.
    NS
    /// Ideographic: CJK, which breaks between almost any two.
    ID
    /// Numeric.
    NU
    /// Alphabetic — the default, and what an unknown code point becomes.
    AL
    /// Hangul syllable and jamo classes, which LB26/LB27 keep together.
    H2
    H3
    JL
    JV
    JT
    /// Inseparable: an ellipsis, which does not start a line (LB22).
    IN
    /// A Hebrew letter: alphabetic, and LB21a keeps a hyphen after one
    /// attached to what follows.
    HL
    /// Regional indicator: two of them are a flag, and LB30a keeps the pair.
    RI
    /// Emoji base and emoji modifier: a skin tone stays with its emoji (LB30b).
    EB
    EM
    /// Zero-width joiner: never a break after it (LB8a), and like a combining
    /// mark before it (LB9).
    ZWJ
}

/// The Line_Break class of a code point.
///
/// Range checks rather than a lookup table, for the reason `bidi_class` uses
/// them: a table of every assigned code point is a megabyte, and the ranges
/// that matter are few enough to read.
pub fn line_break_class(code: int) -> LineBreak {
    // ---- mandatory breaks and spaces ----
    if code == 0x000A {
        return LineBreak.LF
    }
    if code == 0x000D {
        return LineBreak.CR
    }
    if code == 0x000B || code == 0x000C || code == 0x2028 || code == 0x2029 {
        return LineBreak.BK
    }
    if code == 0x0085 {
        return LineBreak.NL
    }
    if code == 0x0020 {
        return LineBreak.SP
    }
    if code == 0x200B {
        return LineBreak.ZW
    }
    if code == 0x200D {
        return LineBreak.ZWJ
    }
    // A tab, a soft hyphen and a vertical line all permit a break after.
    if code == 0x0009 || code == 0x00AD || code == 0x007C {
        return LineBreak.BA
    }
    // Every other control character is CM — it attaches to what precedes it,
    // as the Line_Break property has it — so a stray one does not open a
    // break of its own.
    if code < 0x0020 || within(code, 0x007F, 0x009F) {
        return LineBreak.CM
    }
    if code == 0x2060 || code == 0xFEFF {
        return LineBreak.WJ
    }
    // A no-break space, a narrow one, a figure space, a word-joining tie.
    if code == 0x00A0 || code == 0x202F || code == 0x2007 || code == 0x2011 {
        return LineBreak.GL
    }

    // ---- punctuation ----
    if code == 0x0028 || code == 0x005B || code == 0x007B {
        return LineBreak.OP
    }
    if code == 0x0029 || code == 0x005D {
        return LineBreak.CP
    }
    if code == 0x007D {
        return LineBreak.CL
    }
    // The low quotation marks open, like a bracket; the rest are QU.
    if code == 0x201A || code == 0x201E {
        return LineBreak.OP
    }
    if code == 0x0022 || code == 0x0027 || code == 0x00AB || code == 0x00BB {
        return LineBreak.QU
    }
    if (code >= 0x2018 && code <= 0x201F) || code == 0x2039 || code == 0x203A {
        return LineBreak.QU
    }
    if code == 0x0021 || code == 0x003F || code == 0x061F || code == 0x061B || code == 0x06D4 {
        return LineBreak.EX
    }
    if code == 0xFE15 || code == 0xFE16 || code == 0xFE56 || code == 0xFE57 {
        return LineBreak.EX
    }
    // An ellipsis and its one- and two-dot relatives.
    if (code >= 0x2024 && code <= 0x2026) || code == 0x22EF || code == 0xFE19 {
        return LineBreak.IN
    }
    // A double exclamation, a question-exclamation: no break before either.
    if code == 0x203C || code == 0x203D || (code >= 0x2047 && code <= 0x2049) {
        return LineBreak.NS
    }
    if code == 0x002C || code == 0x002E || code == 0x003A || code == 0x003B {
        return LineBreak.IS
    }
    if code == 0x002F {
        return LineBreak.SY
    }
    if code == 0x002D {
        return LineBreak.HY
    }
    if code == 0x2014 {
        return LineBreak.B2
    }
    // En dash, and the spaces that permit a break after themselves — every
    // one of U+2000 to U+200A but the figure space, which is glue, and the
    // ideographic space.
    if code == 0x2013 || code == 0x2010 || code == 0x2012 || code == 0x058A || code == 0x2027 {
        return LineBreak.BA
    }
    if (code >= 0x2000 && code <= 0x200A) || code == 0x3000 {
        return LineBreak.BA
    }
    if code == 0x00B4 || code == 0x1FFD {
        return LineBreak.BB
    }
    // Signs that go after a number: percent, per mille, degrees, primes, the
    // cent sign, and a handful of currencies written after the amount.
    if code == 0x0025 || code == 0x00A2 || code == 0x00B0 || (code >= 0x2030 && code <= 0x2037) {
        return LineBreak.PO
    }
    if code == 0x2103 || code == 0x2109 || code == 0x066A || code == 0xFF05 || code == 0xFFE0 || code == 0xFE6A {
        return LineBreak.PO
    }
    if code == 0x20A7 || code == 0x20B6 || code == 0x20BB || code == 0x20BE || code == 0x20C0 {
        return LineBreak.PO
    }
    // Signs that go before one: currencies, plus and minus, the numero sign.
    if code == 0x0024 || code == 0x002B || code == 0x005C || code == 0x00B1 {
        return LineBreak.PR
    }
    if (code >= 0x00A3 && code <= 0x00A5) || (code >= 0x20A0 && code <= 0x20CF) {
        return LineBreak.PR
    }
    if code == 0x2116 || code == 0x2212 || code == 0x2213 || code == 0xFE69 || code == 0xFF04 {
        return LineBreak.PR
    }
    if code == 0xFFE1 || code == 0xFFE5 || code == 0xFFE6 {
        return LineBreak.PR
    }

    // ---- numbers and letters ----
    if code >= 0x0030 && code <= 0x0039 {
        return LineBreak.NU
    }
    // The decimal digits of the scripts this table covers: Arabic-Indic and
    // its eastern form, N'Ko, the ten Indic scripts from Devanagari to
    // Sinhala — which all put theirs at 0x66 in a 0x80 block — Thai, Lao,
    // Tibetan, Myanmar, Khmer and Mongolian.
    if within(code, 0x0660, 0x0669) || within(code, 0x066B, 0x066C) || within(code, 0x06F0, 0x06F9) {
        return LineBreak.NU
    }
    if within(code, 0x07C0, 0x07C9) || (within(code, 0x0900, 0x0DFF) && within(code % 128, 0x66, 0x6F)) {
        return LineBreak.NU
    }
    if within(code, 0x0E50, 0x0E59) || within(code, 0x0ED0, 0x0ED9) || within(code, 0x0F20, 0x0F29) {
        return LineBreak.NU
    }
    if within(code, 0x1040, 0x1049) || within(code, 0x1090, 0x1099) || within(code, 0x17E0, 0x17E9) || within(code, 0x1810, 0x1819) {
        return LineBreak.NU
    }
    // Hebrew letters, and the presentation forms that are letters.
    if within(code, 0x05D0, 0x05EA) || within(code, 0x05EF, 0x05F2) || code == 0xFB1D {
        return LineBreak.HL
    }
    if within(code, 0xFB1F, 0xFB4F) && code != 0xFB29 && code != 0xFB37 && code != 0xFB3D {
        if code != 0xFB3F && code != 0xFB42 && code != 0xFB45 {
            return LineBreak.HL
        }
    }

    // ---- combining marks ----
    //
    // Reusing the bidi module's own test, so a mark is a mark to exactly one
    // piece of code. Devanagari, Thai, Arabic and Burmese all depend on this:
    // a mark that started a line would be drawn over nothing.
    if is_combining(code) {
        return LineBreak.CM
    }

    // ---- ideographs ----
    //
    // CJK breaks between almost any two characters, which is what makes a
    // Japanese paragraph lay out instead of becoming one enormous word.
    if code >= 0x1100 && code <= 0x115F {
        return LineBreak.JL
    }
    if code >= 0x1160 && code <= 0x11A7 {
        return LineBreak.JV
    }
    if code >= 0x11A8 && code <= 0x11FF {
        return LineBreak.JT
    }
    if code >= 0xAC00 && code <= 0xD7A3 {
        // A Hangul syllable is LV (H2) when it has no trailing consonant and
        // LVT (H3) when it has one; the block is laid out in runs of 28.
        if (code - 0xAC00) % 28 == 0 {
            return LineBreak.H2
        }
        return LineBreak.H3
    }
    // Small kana and the middle dots, which may not start a line — and the
    // prolonged sound mark and the halfwidth small katakana, which are CJ
    // and resolve to NS as LB1 prescribes by default.
    if code == 0x3005 || code == 0x303B || code == 0x309D || code == 0x309E {
        return LineBreak.NS
    }
    if code == 0x30FB || code == 0xFF65 || code == 0x30FD || code == 0x30FE {
        return LineBreak.NS
    }
    if code == 0x30FC || code == 0x301C || code == 0x309B || code == 0x309C || code == 0x30A0 {
        return LineBreak.NS
    }
    if within(code, 0x31F0, 0x31FF) || within(code, 0xFF67, 0xFF70) || code == 0xFF9E || code == 0xFF9F {
        return LineBreak.NS
    }
    if code == 0xFF1A || code == 0xFF1B || code == 0xFE54 || code == 0xFE55 {
        return LineBreak.NS
    }
    if code >= 0x3041 && code <= 0x3096 {
        // The small kana are non-starters; the rest are ideographic.
        if small_kana(code) {
            return LineBreak.NS
        }
        return LineBreak.ID
    }
    if code >= 0x30A1 && code <= 0x30FA {
        if small_kana(code - 0x60) {
            return LineBreak.NS
        }
        return LineBreak.ID
    }
    // CJK ideographs, and the fullwidth forms.
    if code >= 0x3400 && code <= 0x4DBF {
        return LineBreak.ID
    }
    if code >= 0x4E00 && code <= 0x9FFF {
        return LineBreak.ID
    }
    if code >= 0xF900 && code <= 0xFAFF {
        return LineBreak.ID
    }
    if code >= 0x20000 && code <= 0x2FA1F {
        return LineBreak.ID
    }
    // CJK punctuation: the brackets are OP and CL, the stops are CL.
    if code == 0x3008 || code == 0x300A || code == 0x300C || code == 0x300E {
        return LineBreak.OP
    }
    if code == 0x3010 || code == 0x3014 || code == 0x3016 || code == 0xFF08 {
        return LineBreak.OP
    }
    if code == 0x3018 || code == 0x301A || code == 0x301D || code == 0xFF3B || code == 0xFF5B || code == 0xFF5F || code == 0xFF62 {
        return LineBreak.OP
    }
    if code == 0x2329 || code == 0x2308 || code == 0x230A || code == 0xFE59 || code == 0xFE5B || code == 0xFE5D {
        return LineBreak.OP
    }
    if code == 0x3009 || code == 0x300B || code == 0x300D || code == 0x300F {
        return LineBreak.CL
    }
    if code == 0x3011 || code == 0x3015 || code == 0x3017 || code == 0xFF09 {
        return LineBreak.CL
    }
    if code == 0x3001 || code == 0x3002 || code == 0xFF0C || code == 0xFF0E {
        return LineBreak.CL
    }
    if code == 0x3019 || code == 0x301B || code == 0x301E || code == 0x301F || code == 0xFF3D || code == 0xFF5D {
        return LineBreak.CL
    }
    if within(code, 0xFF60, 0xFF61) || within(code, 0xFF63, 0xFF64) || code == 0x232A || code == 0x2309 || code == 0x230B {
        return LineBreak.CL
    }
    if within(code, 0xFE10, 0xFE12) || code == 0xFE50 || code == 0xFE52 || code == 0xFE5A || code == 0xFE5C || code == 0xFE5E {
        return LineBreak.CL
    }
    if code == 0xFF01 || code == 0xFF1F {
        return LineBreak.EX
    }
    // A flag is two regional indicators.
    if within(code, 0x1F1E6, 0x1F1FF) {
        return LineBreak.RI
    }
    // An emoji, which breaks like an ideograph rather than like a letter —
    // unless it is a skin tone, or an emoji a skin tone may follow.
    if within(code, 0x1F3FB, 0x1F3FF) {
        return LineBreak.EM
    }
    if emoji_base(code) {
        return LineBreak.EB
    }
    if within(code, 0x1F300, 0x1FAFF) || within(code, 0x1F000, 0x1F0FF) || within(code, 0x1F200, 0x1F2FF) {
        return LineBreak.ID
    }
    if within(code, 0x2300, 0x27FF) && symbol_ideograph(code) {
        return LineBreak.ID
    }

    // Everything else — every letter of every alphabet, and every code point
    // this table has never heard of. UAX #14 rule LB1: XX becomes AL.
    return LineBreak.AL
}

/// Emoji_Modifier_Base: the emoji a skin tone may follow.
fn emoji_base(code: int) -> bool {
    if code < 0x1F385 {
        return code == 0x261D || code == 0x26F9 || within(code, 0x270A, 0x270D)
    }
    if code == 0x1F385 || within(code, 0x1F3C2, 0x1F3C4) || code == 0x1F3C7 || within(code, 0x1F3CA, 0x1F3CC) {
        return true
    }
    if within(code, 0x1F442, 0x1F443) || within(code, 0x1F446, 0x1F450) || within(code, 0x1F466, 0x1F478) {
        return true
    }
    if code == 0x1F47C || within(code, 0x1F481, 0x1F483) || within(code, 0x1F485, 0x1F487) || code == 0x1F48F {
        return true
    }
    if code == 0x1F491 || code == 0x1F4AA || within(code, 0x1F574, 0x1F575) || code == 0x1F57A || code == 0x1F590 {
        return true
    }
    if within(code, 0x1F595, 0x1F596) || within(code, 0x1F645, 0x1F647) || within(code, 0x1F64B, 0x1F64F) {
        return true
    }
    if code == 0x1F6A3 || within(code, 0x1F6B4, 0x1F6B6) || code == 0x1F6C0 || code == 0x1F6CC || code == 0x1F90C {
        return true
    }
    if code == 0x1F90F || within(code, 0x1F918, 0x1F91F) || code == 0x1F926 || within(code, 0x1F930, 0x1F939) {
        return true
    }
    if within(code, 0x1F93C, 0x1F93E) || code == 0x1F977 || within(code, 0x1F9B5, 0x1F9B6) || within(code, 0x1F9B8, 0x1F9B9) {
        return true
    }
    if code == 0x1F9BB || within(code, 0x1F9CD, 0x1F9CF) || within(code, 0x1F9D1, 0x1F9DD) {
        return true
    }
    return within(code, 0x1FAC3, 0x1FAC5) || within(code, 0x1FAF0, 0x1FAFA)
}

/// The symbols below U+2800 that break like ideographs: the ones drawn as
/// emoji — a watch, a sun, a football, a heart.
fn symbol_ideograph(code: int) -> bool {
    if within(code, 0x231A, 0x231B) || within(code, 0x23F0, 0x23F3) || within(code, 0x2600, 0x2603) {
        return true
    }
    if within(code, 0x2614, 0x2615) || code == 0x2618 || within(code, 0x261A, 0x261C) || within(code, 0x261E, 0x261F) {
        return true
    }
    if within(code, 0x2639, 0x263B) || code == 0x2668 || code == 0x267F || within(code, 0x26BD, 0x26C8) || code == 0x26CD {
        return true
    }
    if within(code, 0x26CF, 0x26D1) || within(code, 0x26D3, 0x26D4) || within(code, 0x26D8, 0x26D9) || code == 0x26DC {
        return true
    }
    if within(code, 0x26DF, 0x26E1) || code == 0x26EA || within(code, 0x26F1, 0x26F5) || within(code, 0x26F7, 0x26F8) {
        return true
    }
    return code == 0x26FA || within(code, 0x26FD, 0x2704) || within(code, 0x2708, 0x2709) || code == 0x2764
}

/// The small kana, which are non-starters: they may not begin a line.
fn small_kana(code: int) -> bool {
    if code == 0x3041 || code == 0x3043 || code == 0x3045 || code == 0x3047 {
        return true
    }
    if code == 0x3049 || code == 0x3063 || code == 0x3083 || code == 0x3085 {
        return true
    }
    if code == 0x3087 || code == 0x308E || code == 0x3095 || code == 0x3096 {
        return true
    }
    return false
}

/// Whether a class is one of the mandatory-break ones.
fn is_mandatory(c: LineBreak) -> bool {
    return match c {
        BK => true
        CR => true
        LF => true
        NL => true
        SP => false
        ZW => false
        WJ => false
        GL => false
        CM => false
        OP => false
        CL => false
        CP => false
        QU => false
        EX => false
        IS => false
        SY => false
        PR => false
        PO => false
        HY => false
        BA => false
        BB => false
        B2 => false
        NS => false
        ID => false
        NU => false
        AL => false
        H2 => false
        H3 => false
        JL => false
        JV => false
        JT => false
        IN => false
        HL => false
        RI => false
        EB => false
        EM => false
        ZWJ => false
    }
}

/// Where a line may break.
///
/// Answers one flag per character: whether a break is allowed **before** it.
/// Position 0 is always false — UAX #14 rule LB2, never break at the start —
/// and a mandatory break is reported as an allowed one, because a caller
/// already knows a `\n` ends a line and needs to be told the rest.
///
/// The classes are resolved first, then the pairs. Doing it in two passes is
/// what makes LB9 — a combining mark takes the class of what it attaches to —
/// a single loop rather than a special case at every rule.
pub fn break_opportunities(body: str) -> [bool] {
    var codes: [int] = []
    for i in 0..body.len() {
        codes.push(body.code_at(i))
    }
    if codes.len() == 0 {
        return []
    }

    // ---- LB1 and LB9: resolve the classes ----
    var classes: [LineBreak] = []
    for code in codes {
        classes.push(line_break_class(code))
    }
    var absorbed: [bool] = []
    for code in codes {
        absorbed.push(false)
    }
    // LB9: `X (CM | ZWJ)* → X`. A mark takes the class of the character it
    // attaches to, so a run of marks after a letter is part of that letter —
    // and no break is allowed before one. A mark with nothing before it is AL
    // (LB10), which is the case a line beginning with one falls into.
    let original = classes
    for i in 0..classes.len() {
        if classes[i] == LineBreak.CM || classes[i] == LineBreak.ZWJ {
            if i == 0 {
                classes[i] = LineBreak.AL
            } else {
                let before = classes[i - 1]
                // A mark does not attach to a space or a mandatory break.
                if before == LineBreak.SP || is_mandatory(before) {
                    classes[i] = LineBreak.AL
                } else if before == LineBreak.ZW {
                    classes[i] = LineBreak.AL
                } else {
                    classes[i] = before
                    absorbed[i] = true
                }
            }
        }
    }

    var out: [bool] = []
    // LB2: never break at the start.
    out.push(false)
    for i in 1..classes.len() {
        out.push(!absorbed[i] && may_break(Classes{ now: classes, was: original, absorbed: absorbed, codes: codes }, i))
    }
    return out
}

/// What the pair rules read: the classes after LB9 and LB10, the classes as
/// the table gave them, which positions LB9 folded into the character before,
/// and the code points themselves.
///
/// Most rules need only `now`. LB8a needs to know a joiner was there after LB9
/// has made it part of its base; LB21a, LB25 and LB30a look further back than
/// one character, past any marks; and LB30 reads a bracket's width.
struct Classes {
    now: [LineBreak]
    was: [LineBreak]
    absorbed: [bool]
    codes: [int]
}

/// The position of the character at or before `k` that a mark attached to —
/// `k` itself unless LB9 folded it into what came before.
fn base_at(c: Classes, k: int) -> int {
    var at = k
    for at > 0 && c.absorbed[at] {
        at -= 1
    }
    return at
}

/// Whether a break is allowed before position `i`.
///
/// The rules are tried in their numbered order and the first that applies
/// decides, which is how UAX #14 is specified: a later rule never overrides an
/// earlier one.
fn may_break(c: Classes, i: int) -> bool {
    let classes = c.now
    let before = classes[i - 1]
    let here = classes[i]

    // LB5: `CR × LF`. A carriage return and the line feed after it are one
    // break, not two, or every CRLF file would grow an empty line per line.
    if before == LineBreak.CR && here == LineBreak.LF {
        return false
    }
    // LB4, LB5: always break after a mandatory break. LB6: never before one.
    if is_mandatory(before) {
        return true
    }
    if is_mandatory(here) {
        return false
    }
    // LB7: never before a space or a zero-width space.
    if here == LineBreak.SP || here == LineBreak.ZW {
        return false
    }
    // LB8: always after a zero-width space, even across spaces.
    if looking_back(classes, i) == LineBreak.ZW {
        return true
    }
    // LB8a: never after a zero-width joiner, which is joining whatever
    // follows it — an emoji sequence, most often — to what came before.
    if c.was[i - 1] == LineBreak.ZWJ {
        return false
    }
    // LB11: never either side of a word joiner.
    if here == LineBreak.WJ || before == LineBreak.WJ {
        return false
    }
    // LB12: never after non-breaking glue. LB12a: nor before it, unless what
    // precedes is a space, a break-after or a hyphen.
    if before == LineBreak.GL {
        return false
    }
    if here == LineBreak.GL && before != LineBreak.SP && before != LineBreak.BA && before != LineBreak.HY {
        return false
    }

    // The space before this one, if any: several rules below look through
    // spaces rather than at them.
    let anchor = looking_back(classes, i)

    // LB13: never before a closer, an exclamation, a separator or a solidus.
    if here == LineBreak.CL || here == LineBreak.CP {
        return false
    }
    if here == LineBreak.EX || here == LineBreak.IS {
        return false
    }
    if here == LineBreak.SY {
        return false
    }
    // LB14: never after an opener, across any spaces.
    if anchor == LineBreak.OP {
        return false
    }
    // LB15: never between a quote and an opener.
    if anchor == LineBreak.QU && here == LineBreak.OP {
        return false
    }
    // LB16: never between a closer and a non-starter.
    if anchor == LineBreak.CL || anchor == LineBreak.CP {
        if here == LineBreak.NS {
            return false
        }
    }
    // LB17: never inside an em dash pair.
    if anchor == LineBreak.B2 && here == LineBreak.B2 {
        return false
    }
    // LB18: always after a space. Everything that must look through spaces has
    // already had its turn.
    if before == LineBreak.SP {
        return true
    }
    // LB19: never either side of a quotation mark.
    if here == LineBreak.QU || before == LineBreak.QU {
        return false
    }
    // LB21: never before a break-after, a hyphen or a non-starter; never after
    // a break-before.
    if here == LineBreak.BA || here == LineBreak.HY {
        return false
    }
    // LB21a: a hyphen after a Hebrew letter stays with what follows it.
    if before == LineBreak.HY || before == LineBreak.BA {
        let hyphen = base_at(c, i - 1)
        if hyphen > 0 && classes[base_at(c, hyphen - 1)] == LineBreak.HL {
            return false
        }
    }
    if here == LineBreak.NS {
        return false
    }
    if before == LineBreak.BB {
        return false
    }
    // LB21b: never between a solidus and a Hebrew letter.
    if before == LineBreak.SY && here == LineBreak.HL {
        return false
    }
    // LB22: never before an ellipsis.
    if here == LineBreak.IN {
        return false
    }

    // LB23: never between a letter and a number, either way round.
    if letter(before) && here == LineBreak.NU {
        return false
    }
    if before == LineBreak.NU && letter(here) {
        return false
    }
    // LB23a: a currency sign stays with an ideograph or an emoji after it,
    // and a percent with one before it — `¥中` and `中%` are one unit.
    if before == LineBreak.PR && pictorial(here) {
        return false
    }
    if pictorial(before) && here == LineBreak.PO {
        return false
    }
    // LB24, LB25: numbers keep their prefixes, postfixes, separators and
    // internal punctuation. `$1,000.00%` is one unbreakable run.
    if before == LineBreak.PR && here == LineBreak.NU {
        return false
    }
    if before == LineBreak.NU && here == LineBreak.PO {
        return false
    }
    if before == LineBreak.IS && here == LineBreak.NU {
        return false
    }
    if before == LineBreak.SY && here == LineBreak.NU && number_before(c, i - 1) {
        return false
    }
    // LB24: prefixes and postfixes hold to letters on either side.
    if (before == LineBreak.PR || before == LineBreak.PO) && letter(here) {
        return false
    }
    if letter(before) && (here == LineBreak.PR || here == LineBreak.PO) {
        return false
    }
    // LB25: `NU (SY | IS)* (CL | CP)? × (PO | PR)`, and `PO × NU`. The closer
    // is what keeps `(10)%` whole.
    if here == LineBreak.PR || here == LineBreak.PO {
        if before == LineBreak.NU || number_before(c, i) {
            return false
        }
        if (before == LineBreak.CL || before == LineBreak.CP) && number_before(c, base_at(c, i - 1)) {
            return false
        }
    }
    if before == LineBreak.PO && here == LineBreak.NU {
        return false
    }
    // LB27: a Hangul syllable takes a postfix after it and a prefix before it.
    if is_hangul(before) && here == LineBreak.PO {
        return false
    }
    if before == LineBreak.PR && is_hangul(here) {
        return false
    }
    if before == LineBreak.HY && here == LineBreak.NU {
        return false
    }
    if before == LineBreak.NU && here == LineBreak.NU {
        return false
    }
    // LB26, LB27: a Hangul syllable holds together, and takes its affixes.
    if hangul_joins(before, here) {
        return false
    }
    // LB28: never between two letters — this is what keeps a word whole.
    if letter(before) && letter(here) {
        return false
    }
    // LB29: never between a separator and a letter.
    if before == LineBreak.IS && letter(here) {
        return false
    }
    // LB30: never between a letter or number and an opener, nor between a
    // closing parenthesis and a letter or number. A fullwidth or wide opener
    // is the exception the rule names, so `abc（` may break before the
    // bracket, as CJK text around Latin expects.
    if letter(before) || before == LineBreak.NU {
        if here == LineBreak.OP && !wide(c.codes[i]) {
            return false
        }
    }
    if before == LineBreak.CP {
        if letter(here) || here == LineBreak.NU {
            return false
        }
    }
    // LB30a: regional indicators pair off, so a flag is never split — but two
    // flags side by side may be.
    if before == LineBreak.RI && here == LineBreak.RI {
        var count = 0
        var k = base_at(c, i - 1)
        for k >= 0 && classes[k] == LineBreak.RI {
            count += 1
            k = if k == 0 { -1 } else { base_at(c, k - 1) }
        }
        if count % 2 == 1 {
            return false
        }
    }
    // LB30b: a skin tone stays with its emoji.
    if before == LineBreak.EB && here == LineBreak.EM {
        return false
    }
    // LB31: everything else may break — which is what makes CJK break between
    // any two ideographs, and a solidus break after itself.
    return true
}

/// Whether the characters before position `i` end in `NU (SY | IS)*`,
/// looking past the marks LB9 attached to them.
fn number_before(c: Classes, i: int) -> bool {
    if i <= 0 {
        return false
    }
    var k = base_at(c, i - 1)
    for c.now[k] == LineBreak.SY || c.now[k] == LineBreak.IS {
        if k == 0 {
            return false
        }
        k = base_at(c, k - 1)
    }
    return c.now[k] == LineBreak.NU
}

/// ID, EB or EM: what LB23a keeps with a prefix before it or a postfix after.
fn pictorial(c: LineBreak) -> bool {
    return c == LineBreak.ID || c == LineBreak.EB || c == LineBreak.EM
}

/// AL or HL: a letter, as the rules from LB23 on read one.
fn letter(c: LineBreak) -> bool {
    return c == LineBreak.AL || c == LineBreak.HL
}

/// Whether an opening bracket is East Asian Wide or Fullwidth, which LB30
/// exempts: every opener from U+2E80 on in this table, and the angle bracket
/// U+2329.
fn wide(code: int) -> bool {
    return code >= 0x2E80 || code == 0x2329
}

fn is_hangul(c: LineBreak) -> bool {
    return c == LineBreak.JL || c == LineBreak.JV || c == LineBreak.JT || c == LineBreak.H2 || c == LineBreak.H3
}

/// The class before position `i`, looking through spaces.
///
/// Several rules are written `X SP* ÷ Y`, meaning the spaces between are not
/// what decides. This is that lookback.
fn looking_back(classes: [LineBreak], i: int) -> LineBreak {
    var k = i - 1
    for {
        if k < 0 {
            return LineBreak.AL
        }
        if classes[k] != LineBreak.SP {
            return classes[k]
        }
        k = k - 1
    }
}

/// LB26 and LB27: the Hangul rules, which keep a syllable and its jamo whole.
fn hangul_joins(before: LineBreak, here: LineBreak) -> bool {
    // JL × (JL | JV | H2 | H3)
    if before == LineBreak.JL {
        if here == LineBreak.JL || here == LineBreak.JV {
            return true
        }
        if here == LineBreak.H2 || here == LineBreak.H3 {
            return true
        }
    }
    // (JV | H2) × (JV | JT)
    if before == LineBreak.JV || before == LineBreak.H2 {
        if here == LineBreak.JV || here == LineBreak.JT {
            return true
        }
    }
    // (JT | H3) × JT
    if before == LineBreak.JT || before == LineBreak.H3 {
        if here == LineBreak.JT {
            return true
        }
    }
    return false
}

// ---- wrapping ---------------------------------------------------------------

/// A paragraph set into lines no wider than `width`, as `measure` counts width.
///
/// The half of line breaking that needs a measurement: `break_opportunities`
/// says where a line *may* end, and this ends each line at the last of them
/// that still fits — greedy first fit, which is what a browser does. The
/// measurement is the caller's, so the same function wraps for a canvas
/// (`canvas.width_of`), for a terminal (one per character), or for anything
/// else with a notion of width, and gives the same lines on every backend for
/// the same measurements.
///
/// Three things a caller should know:
///
/// - **A mandatory break always ends a line.** `\n`, `\r\n`, `\r` and the
///   Unicode line and paragraph separators each end the line they are on, and
///   are not part of it. Two in a row make an empty line between them; one at
///   the very end of the text does not start an empty line after it.
/// - **Spaces at the end of a line hang.** They neither count toward the width
///   nor appear in the answer, which is UAX #14's treatment of a line end.
///   Spaces at the start of a paragraph are kept: they are indentation.
/// - **A run too wide for any line is broken between characters** rather than
///   left to overflow — what CSS calls `overflow-wrap: break-word`. The break
///   never falls before a combining mark, so an accent stays with its letter,
///   and every line holds at least one character, so a width too narrow for
///   anything still makes progress rather than looping.
///
/// ```kite
/// let chars = |s: str| -> float { return s.len() as float }
/// let lines = wrap("the quick brown fox", 10.0, chars)
/// assert(lines.len() == 2, "two lines")
/// assert(lines[0] == "the quick", "as much as fits on the first")
/// assert(lines[1] == "brown fox", "and the rest on the second")
/// ```
pub fn wrap(body: str, width: float, measure: fn(str) -> float) -> [str] {
    var lines: [str] = []
    let n = body.len()
    let allowed = break_opportunities(body)
    // The line being set is `body[start..pos]`, and all of it is known to fit.
    // `pos` only ever stops at an opportunity, or mid-run after a forced break.
    var start = 0
    var pos = 0
    for pos < n {
        var next = pos + 1
        for next < n && !allowed[next] {
            next += 1
        }
        let seen = visible_end(body, start, next)
        if seen == start || measure(body.slice(start, seen)) <= width {
            pos = next
            if is_mandatory(line_break_class(body.code_at(next - 1))) {
                lines.push(body.slice(start, seen))
                start = next
            }
            continue
        }
        // It does not fit. End the line before this run if the line holds
        // anything, and look at the run again on a line of its own.
        let held = visible_end(body, start, pos)
        if held > start {
            lines.push(body.slice(start, held))
            start = pos
            continue
        }
        // The run is wider than a whole line: break inside it.
        let cut = split_point(body, start, seen, width, measure)
        lines.push(body.slice(start, cut))
        if cut >= seen {
            // All of it went, and what is left of the run is the spaces that
            // hang after it — or the break that ends its paragraph.
            start = next
            pos = next
        } else {
            start = cut
            pos = cut
        }
    }
    if start < n {
        lines.push(body.slice(start, visible_end(body, start, n)))
    }
    return lines
}

/// Where `body[from..to]` ends once the spaces and the mandatory break that
/// hang off its end are set aside.
fn visible_end(body: str, from: int, to: int) -> int {
    var end = to
    for end > from && hangs(body.code_at(end - 1)) {
        end -= 1
    }
    return end
}

/// Whether a character at the end of a line takes no room on it.
fn hangs(code: int) -> bool {
    let c = line_break_class(code)
    return c == LineBreak.SP || is_mandatory(c)
}

/// The longest prefix of `body[start..end]` that fits, cut between characters
/// and never before a combining mark — and never shorter than one character,
/// so that a line too narrow for anything still takes something.
fn split_point(body: str, start: int, end: int, width: float, measure: fn(str) -> float) -> int {
    var best = next_cluster(body, start, end)
    var m = next_cluster(body, best, end)
    for m < end {
        if measure(body.slice(start, m)) > width {
            return best
        }
        best = m
        m = next_cluster(body, m, end)
    }
    return best
}

/// The position after the character at `i` and any marks attached to it.
fn next_cluster(body: str, i: int, end: int) -> int {
    var k = i + 1
    for k < end && is_combining(body.code_at(k)) {
        k += 1
    }
    return k
}
