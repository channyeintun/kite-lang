}

/// `body` cut into clusters — UAX #29's extended grapheme clusters, as of
/// **Unicode 17.0**: each entry is what a reader takes for one character.
/// Joined, the entries are `body` again.
///
/// Every rule of the annex is applied, in its order: CR LF is one cluster,
/// and any other control stands alone (GB3–GB5); Hangul jamo join into a
/// syllable (GB6–GB8); a mark, a joiner, a variation selector, a skin-tone
/// modifier or a tag character stays with what is before it (GB9), and so
/// does a spacing mark — the vowel signs of Devanagari, Tamil, Myanmar or Thai
/// SARA AM (GB9a); a Prepend character stays with what is after it (GB9b); a
/// consonant, a virama and the next consonant are one conjunct (GB9c); a
/// joiner between two emoji joins them (GB11); and regional indicators pair
/// off into flags (GB12, GB13). GraphemeBreakTest 17.0 passes in full.
/// Tailorings the annex mentions but does not make the default — legacy
/// clusters, or Indic syllables beyond GB9c — are not applied.
///
/// ```kite
/// let parts = clusters("ae\u{301}b")
/// assert(parts.len() == 3, "the accent stays with its letter")
/// assert(parts[1] == "e\u{301}", "as one entry")
/// let family = "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}"
/// assert(clusters(family).len() == 1, "joined emoji are one entry")
/// assert(clusters("a\u{200D}b").len() == 2, "a joiner after a letter joins nothing")
/// assert(clusters("\u{915}\u{94D}\u{937}").len() == 1, "a conjunct is one entry")
/// assert(clusters("\u{915}\u{93F}").len() == 1, "and so is a consonant with its vowel sign")
/// assert(clusters("\u{1100}\u{1161}\u{11A8}").len() == 1, "jamo join into a syllable")
/// assert(clusters("\r\n").len() == 1, "CR LF is one")
/// ```
pub fn clusters(body: str) -> [str] {
    var out: [str] = []
    let n = body.len()
    var i = 0
    for i < n {
        let next = next_cluster(body, i, n)
        out.push(body.slice(i, next))
        i = next
    }
    return out
}

/// How many terminal columns `body` takes: 2 for each wide character (CJK
/// ideographs, kana, Hangul syllables, fullwidth forms, emoji), 0 for what
/// takes no room (marks, joiners, control and format characters) and 1 for
/// the rest, summed over the characters — less those a cluster draws into
/// another. An emoji joined on by a zero-width joiner is drawn into the one
/// before it, so a family is one wide glyph, not six; a Hangul jamo joined to
/// an initial or a syllable is drawn into it, so a syllable written as jamo is
/// the 2 of its initial; and a Prepend character is drawn on the character it
/// is prepended to, which is as wide as the cluster is. Everything else in a
/// cluster keeps the column a terminal gives it: each consonant of an Indic
/// conjunct, so क्ष is 2, and a spacing vowel sign, so कि is 2 as well. A flag
/// is 2.
///
/// The wide blocks are listed rather than read from the Unicode database,
/// as `bidi_class`'s are: the ranges below are the East Asian Wide and
/// Fullwidth blocks and the emoji blocks, which is what a terminal draws two
/// columns wide. Not listed, and so counted as 1: the emoji scattered through
/// the older symbol blocks (U+2300–27BF, such as ☕), which a terminal
/// usually draws two wide, and a Hangul jamo vowel or final with no initial
/// before it.
///
/// ```kite
/// assert(cell_width("abc") == 3, "one each")
/// assert(cell_width("中文") == 4, "two each")
/// assert(cell_width("e\u{301}") == 1, "a mark takes no room")
/// assert(cell_width("\u{915}\u{94D}\u{937}") == 2, "a conjunct, a column for each consonant")
/// assert(cell_width("\u{1100}\u{1161}\u{11A8}") == 2, "a syllable in jamo, the width of its initial")
/// ```
pub fn cell_width(body: str) -> int {
    var total = 0
    let n = body.len()
    var i = 0
    for i < n {
        let next = next_cluster(body, i, n)
        // The base is the first character that is not prepended to another.
        // A Prepend character followed only by marks has nothing to be drawn
        // on, so it is the base itself, and counts as it did on its own.
        var base = i
        for base + 1 < next && grapheme_break(body.code_at(base)) == GCB_PREPEND && starts(body.code_at(base + 1)) {
            base += 1
        }
        total += code_width(body.code_at(base))
        for j in base + 1..next {
            let d = body.code_at(j)
            let g = grapheme_break(d)
            // What is drawn into the base takes no column of its own: an emoji
            // GB11 joined, a jamo GB6–GB8 joined, and a tag character, which
            // spells an emoji's subdivision flag.
            let drawn_in = g == GCB_PICTO || (g >= GCB_L && g <= GCB_LVT) || within(d, 0xE0020, 0xE007F)
            if !drawn_in {
                total += code_width(d)
            }
        }
        i = next
    }
    return total
}

/// Whether a character can be what a Prepend character is drawn on: anything
/// but what GB9 and GB9a attach to the character before it.
fn starts(code: int) -> bool {
    let g = grapheme_break(code)
    return g != GCB_EXTEND && g != GCB_ZWJ && g != GCB_SPACING
}

/// The columns one character takes by itself.
fn code_width(c: int) -> int {
    if c < 0x20 || within(c, 0x7F, 0x9F) {
        return 0
    }
    if c < 0x300 {
        return 1
    }
    // Marks, skin-tone modifiers and the invisible format characters: the
    // zero-width space and joiners, the direction marks and bidi controls,
    // the word joiner and its kin, and the byte-order mark.
    if is_combining(c) || within(c, 0x200B, 0x200F) || within(c, 0x202A, 0x202E) ||
    within(c, 0x2060, 0x2069) || c == 0xFEFF || within(c, 0x1F3FB, 0x1F3FF) {
        return 0
    }
    if within(c, 0x1100, 0x115F) || within(c, 0x2E80, 0x303E) || within(c, 0x3041, 0x33FF) ||
    within(c, 0x3400, 0x4DBF) || within(c, 0x4E00, 0x9FFF) || within(c, 0xA000, 0xA4CF) ||
    within(c, 0xAC00, 0xD7A3) || within(c, 0xF900, 0xFAFF) || within(c, 0xFE30, 0xFE6F) ||
    within(c, 0xFF00, 0xFF60) || within(c, 0xFFE0, 0xFFE6) || within(c, 0x1F300, 0x1F64F) ||
    within(c, 0x1F680, 0x1F6FF) || within(c, 0x1F900, 0x1F9FF) || within(c, 0x1FA70, 0x1FAFF) ||
    within(c, 0x20000, 0x3FFFD) {
        return 2
    }
    return 1
}
