// std/time — the clock, and what to say about it.
//
// `time.now()` is a compiler builtin: it reads the runtime's clock in
// milliseconds. The clock is **virtual** on the bytecode VM and in the
// generated glue — when every task is waiting on a deadline it jumps to the
// earliest — so a program that sleeps costs no real time under test and both
// backends agree on the order things happened in.

/// Milliseconds in one second.
pub fn seconds(n: int) -> int {
    return n * 1000
}

/// `n` minutes, in milliseconds. Traps on overflow, as every `int` multiplication does.
///
/// ```kite
/// assert(minutes(2) == 120000, "two minutes")
/// ```
pub fn minutes(n: int) -> int {
    return n * 60000
}

/// `n` hours, in milliseconds. Traps on overflow.
///
/// ```kite
/// assert(hours(1) == 3600000, "an hour")
/// ```
pub fn hours(n: int) -> int {
    return n * 3600000
}

/// `n` milliseconds, which is `n`. It is here so that a duration reads the same in every unit: `millis(250)` beside `seconds(2)`.
pub fn millis(n: int) -> int {
    return n
}

/// How long since a reading taken earlier.
pub fn since(start: int) -> int {
    return time.now() - start
}

/// A duration in the largest unit that keeps it readable. A negative one —
/// a deadline already past — is the same with a minus in front.
pub fn show(ms: int) -> str {
    if ms < 0 {
        // `0 - ms` has no answer for the smallest `int`; one millisecond
        // less changes nothing anybody reads.
        return "-" + show(0 - max(ms, -9223372036854775807))
    }
    if ms < 1000 {
        return "\(ms)ms"
    }
    if ms < 60000 {
        return "\(ms / 1000).\((ms % 1000) / 100)s"
    }
    if ms < 3600000 {
        return "\(ms / 60000)m \((ms % 60000) / 1000)s"
    }
    return "\(ms / 3600000)h \((ms % 3600000) / 60000)m"
}

/// `hh:mm:ss` from a duration, for a stopwatch or a progress line.
///
/// A negative duration — a countdown that has run over — is signed once, in
/// front. `%` keeps the sign of what it divides, so without that each field
/// came out negative on its own: `-61000` was `00:0-1:0-1`.
pub fn clock(ms: int) -> str {
    var total = ms / 1000
    var sign = ""
    if total < 0 {
        sign = "-"
        total = 0 - total
    }
    let h = total / 3600
    let m = (total % 3600) / 60
    let s = total % 60
    return "\(sign)\(pad2(h)):\(pad2(m)):\(pad2(s))"
}

fn pad2(n: int) -> str {
    if n < 10 {
        return "0\(n)"
    }
    return "\(n)"
}

// ---- the calendar -----------------------------------------------------------
//
// Everything above is a *duration* — a count of milliseconds, and what to call
// it. Everything below names a *moment*, and the two are not the same
// arithmetic: a duration has no idea how long February is.
//
// This is integer arithmetic rather than a call to the host's `Date`, and that
// is the decision worth writing down. Asking the host means three crossings per
// field and an answer that exists only in a browser; this gives the same answer
// under the bytecode VM, under Cranelift, and in a page. The algorithm is
// Howard Hinnant's `civil_from_days`, which is exact for every year a 64-bit
// day count can hold and needs no lookup table — and Kite's `/` truncates
// toward zero, which is the division it was written against.
//
// **A timezone is a parameter here, never an ambient fact.** Every function
// below takes the minutes east of UTC to render in. A standard library that
// read the device's own zone would make one program print two different days
// depending on where it ran, and the day a receipt is filed under is the day
// the shop was open. `window.timezone_offset()` is where a web program gets
// the number; passing `0` renders UTC.

/// A moment, split the way a person reads one.
pub struct Civil {
    pub year: int
    /// 1 to 12.
    pub month: int
    /// 1 to 31.
    pub day: int
    /// 0 to 23.
    pub hour: int
    pub minute: int
    pub second: int
}

/// Split an epoch reading into fields.
///
/// `ms` is milliseconds since 1970-01-01T00:00:00Z — what `window.epoch_ms()`
/// answers, and *not* what `time.now()` answers, which is a monotonic reading
/// with no zero point a calendar could use.
///
/// ```kite
/// let at = civil_of(1_754_697_600_000, 0)
/// assert(at.year == 2025 && at.month == 8 && at.day == 9, "2025-08-09")
/// ```
pub fn civil_of(ms: int, east_minutes: int) -> Civil {
    let local = ms + east_minutes * 60000
    // Floored, not truncated: an instant before 1970 still belongs to the day
    // it fell in, and truncation would round it forward into the next one.
    let days = floor_div(local, 86400000)
    // Non-negative by construction, because `days` was floored — so the
    // remainder arithmetic below needs no sign handling of its own.
    let rest = local - days * 86400000
    let date = date_of_days(days)
    return Civil{
        year: date.year,
        month: date.month,
        day: date.day,
        hour: rest / 3600000,
        minute: (rest % 3600000) / 60000,
        second: (rest % 60000) / 1000,
    }
}

/// Put one back together.
///
/// The inverse of [`civil_of`] under the same offset. Fields outside their
/// range are carried rather than refused — month 13 is January of the next
/// year, and day 0 is the last day of the month before — which is what makes
/// `Civil{ year: y, month: m + 1, day: 1, … }` a correct way to ask for the
/// start of the next month without knowing how long this one is.
pub fn epoch_of(c: Civil, east_minutes: int) -> int {
    let days = days_of_date(c.year, c.month, c.day)
    let local = days * 86400000 +
    c.hour * 3600000 +
    c.minute * 60000 +
    c.second * 1000
    return local - east_minutes * 60000
}

/// `YYYY-MM-DD`, which is what a filename wants.
///
/// A folder of reports named "10 Jul 2026" sorts April before January. This
/// one sorts in the only order that is unambiguous in every locale.
///
/// ```kite
/// assert(iso_day(1_754_697_600_000, 0) == "2025-08-09", "a day, written out")
/// ```
pub fn iso_day(ms: int, east_minutes: int) -> str {
    let c = civil_of(ms, east_minutes)
    return "\(pad4(c.year))-\(pad2(c.month))-\(pad2(c.day))"
}

/// `hh:mm` from a moment, for a status bar with no room for a date.
///
/// Distinct from [`clock`] one section up, which reads a *duration* — the two
/// print the same shape from different numbers, and giving them one name would
/// make the difference invisible at the call site.
pub fn hhmm(ms: int, east_minutes: int) -> str {
    let c = civil_of(ms, east_minutes)
    return "\(pad2(c.hour)):\(pad2(c.minute))"
}

/// `YYYY-MM-DDThh:mm:ss`, without an offset suffix.
///
/// The suffix is left off because this renders in whatever zone was asked for
/// and appending `Z` to a local reading is a lie a log keeps forever. A caller
/// who wants a true RFC 3339 timestamp passes `0` and adds the `Z` itself.
pub fn stamp(ms: int, east_minutes: int) -> str {
    let c = civil_of(ms, east_minutes)
    return "\(iso_day(ms, east_minutes))T\(pad2(c.hour)):\(pad2(c.minute)):\(pad2(c.second))"
}

/// The day of the week: 0 is Sunday, 6 is Saturday.
pub fn weekday(ms: int, east_minutes: int) -> int {
    let days = floor_div(ms + east_minutes * 60000, 86400000)
    // 1970-01-01 was a Thursday, which is 4.
    return floor_mod(days + 4, 7)
}

/// Whether a year has a 29th of February.
pub fn is_leap(year: int) -> bool {
    if year % 4 != 0 {
        return false
    }
    if year % 100 != 0 {
        return true
    }
    return year % 400 == 0
}

/// How many days are in a month, `1` to `12`.
///
/// Counted as the distance between two firsts rather than read out of a table
/// with a leap-year branch beside it. The table and the branch can disagree;
/// two calls to the same function cannot.
pub fn days_in_month(year: int, month: int) -> int {
    return days_of_date(year, month + 1, 1) - days_of_date(year, month, 1)
}

/// The first millisecond of a month.
///
/// `month` outside 1 to 12 is carried, so `month_start(y, 13, e)` is January
/// of the following year — which is how [`month_end`] finds the boundary
/// without asking how long the month it is ending happens to be.
pub fn month_start(year: int, month: int, east_minutes: int) -> int {
    return epoch_of(
        Civil{ year: year, month: month, day: 1, hour: 0, minute: 0, second: 0 },
        east_minutes,
    )
}

/// The last millisecond that still belongs to a month.
///
/// Inclusive, so a query written `>= month_start(…)` and `<= month_end(…)`
/// cannot let the midnight between two months fall into both or into neither.
pub fn month_end(year: int, month: int, east_minutes: int) -> int {
    return month_start(year, month + 1, east_minutes) - 1
}

// ---- reading and writing RFC 3339, and calendar arithmetic -------------------

/// An instant as RFC 3339 in UTC: `2025-08-09T00:00:00Z`.
///
/// Milliseconds are written, as `.fff`, only when there are some, so a whole
/// second reads the way every other tool writes one.
///
/// ```kite
/// assert(rfc3339(1_754_697_600_000) == "2025-08-09T00:00:00Z", "a whole second")
/// assert(rfc3339(1_754_697_600_042) == "2025-08-09T00:00:00.042Z", "with milliseconds")
/// ```
pub fn rfc3339(ms: int) -> str {
    return rfc3339_at(ms, 0)
}

/// An instant as RFC 3339 in the zone `east_minutes` east of UTC:
/// `2025-08-09T07:00:00+07:00`, or `…Z` when the offset is zero.
///
/// Unlike [`stamp`], this names the offset, so what it writes is the instant
/// and not only a reading of the clock on the wall.
///
/// It is RFC 3339 for the years 0000 to 9999 (as read in the zone given) and
/// for an offset strictly inside a day, `east_minutes` from -1439 to 1439.
/// Outside that range it writes what the arithmetic gives — `10000-01-01…`,
/// `-0001-…`, `+24:00` — which is not RFC 3339 and which [`parse_iso`] refuses,
/// so check an instant that did not come from a clock before writing it out.
///
/// ```kite
/// assert(rfc3339_at(1_754_697_600_000, 420) == "2025-08-09T07:00:00+07:00", "east")
/// assert(rfc3339_at(1_754_697_600_000, -90) == "2025-08-08T22:30:00-01:30", "west")
/// let last = 253_402_300_799_000
/// assert(rfc3339(last) == "9999-12-31T23:59:59Z", "the last second RFC 3339 can write")
/// assert(parse_iso(rfc3339(last)) == last, "and it reads back")
/// assert(parse_iso(rfc3339(last + 1000)) == nil, "the next is year 10000, which does not")
/// ```
pub fn rfc3339_at(ms: int, east_minutes: int) -> str {
    var out = stamp(ms, east_minutes)
    let fraction = floor_mod(ms, 1000)
    if fraction != 0 {
        out = out + "." + pad_start("\(fraction)", 3, "0")
    }
    if east_minutes == 0 {
        return out + "Z"
    }
    let magnitude = if east_minutes < 0 { 0 - east_minutes } else { east_minutes }
    let sign = if east_minutes < 0 { "-" } else { "+" }
    return "\(out)\(sign)\(pad2(magnitude / 60)):\(pad2(magnitude % 60))"
}

/// An ISO 8601 / RFC 3339 reading as an instant, or nil if it is not one.
///
/// The forms are `YYYY-MM-DD`, `YYYY-MM-DDThh:mm:ss` with any number of
/// fractional digits after the seconds, and either of those followed by `Z` or
/// `+hh:mm` / `-hh:mm`. A date alone is midnight, and a reading with no zone
/// is UTC. Everything is checked down to the calendar — `2025-02-29` and
/// `24:00:00` are nil, not a day later — and nothing is trimmed or guessed at:
/// the letters are the capitals `T` and `Z`. Digits past the milliseconds are
/// dropped.
///
/// ```kite
/// assert(or_else(parse_iso("2025-08-09"), -1) == 1_754_697_600_000, "a day")
/// assert(or_else(parse_iso("2025-08-09T07:00:00.5+07:00"), -1) == 1_754_697_600_500, "an offset")
/// assert(parse_iso("2025-02-29") == nil, "no such day")
/// ```
pub fn parse_iso(s: str) -> Option<int> {
    let n = s.len()
    if n < 10 || s.slice(4, 5) != "-" || s.slice(7, 8) != "-" {
        return nil
    }
    let year = number_at(s, 0, 4)
    let month = number_at(s, 5, 2)
    let day = number_at(s, 8, 2)
    if year < 0 || month < 1 || month > 12 || day < 1 || day > days_in_month(year, month) {
        return nil
    }
    var hour = 0
    var minute = 0
    var second = 0
    var fraction = 0
    var east = 0
    var i = 10
    if i < n {
        if s.slice(i, i + 1) != "T" {
            return nil
        }
        if n < i + 9 || s.slice(i + 3, i + 4) != ":" || s.slice(i + 6, i + 7) != ":" {
            return nil
        }
        hour = number_at(s, i + 1, 2)
        minute = number_at(s, i + 4, 2)
        second = number_at(s, i + 7, 2)
        if hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59 {
            return nil
        }
        i = i + 9
        if i < n && s.slice(i, i + 1) == "." {
            i = i + 1
            let from = i
            var scale = 100
            for i < n && number_at(s, i, 1) >= 0 {
                fraction = fraction + number_at(s, i, 1) * scale
                scale = scale / 10
                i = i + 1
            }
            if i == from {
                return nil
            }
        }
        if i < n {
            if s.slice(i, n) != "Z" {
                if n - i != 6 || s.slice(i + 3, i + 4) != ":" {
                    return nil
                }
                let sign = s.slice(i, i + 1)
                let hours = number_at(s, i + 1, 2)
                let minutes = number_at(s, i + 4, 2)
                if (sign != "+" && sign != "-") || hours < 0 || hours > 23 || minutes < 0 || minutes > 59 {
                    return nil
                }
                east = hours * 60 + minutes
                if sign == "-" {
                    east = 0 - east
                }
            }
        }
    }
    let c = Civil{ year: year, month: month, day: day, hour: hour, minute: minute, second: second }
    return epoch_of(c, east) + fraction
}

/// The `count` decimal digits at `at` as a number, or -1 if any is not one.
fn number_at(s: str, at: int, count: int) -> int {
    if at + count > s.len() {
        return -1
    }
    var value = 0
    for i in at..at + count {
        let d = s.code_at(i) - 48
        if d < 0 || d > 9 {
            return -1
        }
        value = value * 10 + d
    }
    return value
}

/// The same time of day, `n` calendar months later (earlier if negative).
///
/// The day of the month is kept where the new month has it and otherwise
/// clamped to the new month's last day — January 31st plus one month is
/// February 28th or 29th, not March 2nd or 3rd. The hour, minute, second and
/// millisecond are kept as the zone `east_minutes` reads them.
///
/// ```kite
/// let jan31 = or_else(parse_iso("2025-01-31T10:00:00Z"), 0)
/// assert(rfc3339(add_months(jan31, 1, 0)) == "2025-02-28T10:00:00Z", "clamped")
/// assert(rfc3339(add_months(jan31, -2, 0)) == "2024-11-30T10:00:00Z", "backwards")
/// ```
pub fn add_months(ms: int, n: int, east_minutes: int) -> int {
    let c = civil_of(ms, east_minutes)
    let total = c.year * 12 + (c.month - 1) + n
    let year = floor_div(total, 12)
    let month = total - year * 12 + 1
    let day = min(c.day, days_in_month(year, month))
    let moved = Civil{ year: year, month: month, day: day, hour: c.hour, minute: c.minute, second: c.second }
    return epoch_of(moved, east_minutes) + floor_mod(ms, 1000)
}

/// The first millisecond of the day that `ms` falls in, as the zone
/// `east_minutes` reads it.
///
/// ```kite
/// assert(start_of_day(1_754_697_600_000 + 3_600_000, 0) == 1_754_697_600_000, "midnight")
/// ```
pub fn start_of_day(ms: int, east_minutes: int) -> int {
    let c = civil_of(ms, east_minutes)
    return epoch_of(Civil{ year: c.year, month: c.month, day: c.day, hour: 0, minute: 0, second: 0 }, east_minutes)
}

/// How many calendar days `b`'s date is after `a`'s, in the zone
/// `east_minutes` — negative if it is before. Dates are compared, not elapsed
/// time: 23:00 and 01:00 the next day are one day apart.
///
/// ```kite
/// assert(days_between(1_754_697_600_000 + 82_800_000, 1_754_697_600_000 + 90_000_000, 0) == 1, "across midnight")
/// ```
pub fn days_between(a: int, b: int, east_minutes: int) -> int {
    return floor_div(b + east_minutes * 60000, 86400000) - floor_div(a + east_minutes * 60000, 86400000)
}

/// The English name of a day of the week, 0 (Sunday) to 6, as [`weekday`]
/// counts them — or "" for any other number.
///
/// ```kite
/// assert(weekday_name(weekday(1_754_697_600_000, 0)) == "Saturday", "2025-08-09")
/// ```
pub fn weekday_name(day: int) -> str {
    let names = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
    if day < 0 || day > 6 {
        return ""
    }
    return names[day]
}

/// The English name of a month, 1 (January) to 12, or "" for any other number.
///
/// ```kite
/// assert(month_name(8) == "August", "a month")
/// ```
pub fn month_name(month: int) -> str {
    let names = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
    if month < 1 || month > 12 {
        return ""
    }
    return names[month - 1]
}

// ---- the arithmetic underneath ----------------------------------------------

/// Days since 1970-01-01 from a civil date.
///
/// Hinnant's `days_from_civil`, with its era arithmetic intact. March is
/// treated as the first month of the year, which is what makes the leap day
/// the *last* day of it and removes every special case from the rest.
fn days_of_date(year: int, month: int, day: int) -> int {
    // A month outside 1..12 is carried into the year rather than refused, so
    // `month + 1` on December is January of the next year — see `epoch_of`.
    let carry = floor_div(month - 1, 12)
    let y_in = year + carry
    let m = month - carry * 12
    let y = if m <= 2 { y_in - 1 } else { y_in }
    let era = if y >= 0 { y / 400 } else { (y - 399) / 400 }
    let yoe = y - era * 400
    let mp = if m > 2 { m - 3 } else { m + 9 }
    let doy = (153 * mp + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

/// The other direction: `civil_from_days`. Hour, minute and second are left at
/// zero — the caller has the remainder and fills them in.
fn date_of_days(count: int) -> Civil {
    let z = count + 719468
    let era = if z >= 0 { z / 146097 } else { (z - 146096) / 146097 }
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = if mp < 10 { mp + 3 } else { mp - 9 }
    let y = yoe + era * 400
    let year = if m <= 2 { y + 1 } else { y }
    return Civil{ year: year, month: m, day: d, hour: 0, minute: 0, second: 0 }
}

/// Division that rounds toward negative infinity.
///
/// Kite's `/` truncates toward zero, which for a day count means every instant
/// before 1970 lands on the day after the one it happened in.
fn floor_div(a: int, b: int) -> int {
    let q = a / b
    if a % b != 0 && (a < 0) != (b < 0) {
        return q - 1
    }
    return q
}

fn floor_mod(a: int, b: int) -> int {
    return a - floor_div(a, b) * b
}

/// A year in four digits, and a year before 1 BC with its sign in front —
/// ISO 8601's expanded form, where year 0 is 1 BC and -1 is 2 BC. Padding the
/// text of a negative number put the zeros before its minus: `00-1`.
fn pad4(n: int) -> str {
    if n < 0 {
        return "-" + pad_start("\(0 - n)", 4, "0")
    }
    return pad_start("\(n)", 4, "0")
}
