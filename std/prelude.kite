// The Kite prelude.
//
// Compiled into every program before the user's own file. It is written in
// Kite, not in the compiler: everything here is expressible in the language,
// which is the point — a standard library that needed compiler support would
// be evidence the language was missing something.
//
// It is deliberately small. Each addition is a name every program must live
// with, and a name taken is hard to give back.

// ---- display --------------------------------------------------------------

/// How a type presents itself to a human.
///
/// `io.print` and `\(x)` interpolation both look for this, so implementing it
/// once makes a type printable everywhere. It is deliberately **not** derived:
/// how something reads is a design decision, and a mechanical one would be
/// wrong more often than it was right — a `Password` that printed its field is
/// the obvious case.
pub trait Display {
    fn show(self) -> str
}

/// How a type presents itself to a programmer.
///
/// The counterpart to `Display`, and the reason both exist: `Display` is a
/// design decision and `Debug` is a mechanical one. `@derive(Debug)` writes
/// the body from the fields, which is right here for exactly the reason it
/// would be wrong for `Display` — nobody reads a debug rendering expecting it
/// to have been designed.
pub trait Debug {
    fn debug(self) -> str
}

/// What a failure says about itself.
///
/// Declared here rather than in the compiler, for the same reason `Display` is:
/// the language has no opinion about how a failure reads, and a program is free
/// to declare its own trait if this one does not suit.
///
/// A type implementing this may be returned wherever an `error` is expected.
/// The conversion happens at that point and is visible in the IR — nothing is
/// implicit about it beyond not having to write the call.
///
/// ```kite ignore
/// pub enum LoadError {
///     Missing(path: str)
/// }
///
/// impl Error for LoadError {
///     fn message(self) -> str {
///         return match self {
///             Missing(path) => "no task file at \(path)",
///         }
///     }
/// }
///
/// fn load(path: str) -> ([Task], error) {
///     return _, LoadError.Missing(path: path)
/// }
/// ```
pub trait Error {
    fn message(self) -> str
}

/// One integer standing for a value, for indexing and for deduplication.
///
/// Two values that are `==` must hash alike; two that are not may. The derived
/// body honours that by walking exactly the fields `==` compares, in the same
/// order.
///
/// It is **not** a security primitive. `crypto` is where a hash that has to
/// resist an adversary comes from, and this one folds bytes with FNV-1a, which
/// does not.
pub trait Hash {
    fn hash(self) -> int
}

/// A value of this type may be moved to another task or isolate.
///
/// The one trait nobody implements: the compiler decides, structurally, and a
/// type qualifies when it is deeply immutable. Because struct fields are
/// immutable unless marked `var`, most types satisfy it without their author
/// doing anything or knowing the trait exists — it only becomes visible when
/// it is violated, as E0520.
///
/// It is declared here rather than in the compiler so that `Share` is an
/// ordinary name a bound can mention, and so the rule it stands for is
/// readable in the language it constrains.
pub trait Share {
}

// ---- slices ---------------------------------------------------------------

/// A new slice with `f` applied to every item. The result need not have the
/// same element type: `map(people, |p: Person| p.name)` is `[str]`.
pub fn map<T, U>(items: [T], f: fn(T) -> U) -> [U] {
    var out: [U] = []
    for item in items {
        out.push(f(item))
    }
    return out
}

/// Combine every item into one value, left to right.
pub fn fold<T, A>(items: [T], initial: A, f: fn(A, T) -> A) -> A {
    var total = initial
    for item in items {
        total = f(total, item)
    }
    return total
}

/// The items `test` accepts, in order.
pub fn filter<T>(items: [T], test: fn(T) -> bool) -> [T] {
    var out: [T] = []
    for item in items {
        if test(item) {
            out.push(item)
        }
    }
    return out
}

/// Whether any item satisfies `test`. Stops at the first that does.
pub fn any<T>(items: [T], test: fn(T) -> bool) -> bool {
    for item in items {
        if test(item) {
            return true
        }
    }
    return false
}

/// Whether every item satisfies `test`. Vacuously true for an empty slice,
/// which is the convention every language settles on because the alternative
/// breaks the identity `all(a + b) == all(a) and all(b)`.
pub fn all<T>(items: [T], test: fn(T) -> bool) -> bool {
    for item in items {
        if !test(item) {
            return false
        }
    }
    return true
}

/// How many items satisfy `test`.
pub fn count<T>(items: [T], test: fn(T) -> bool) -> int {
    var n = 0
    for item in items {
        if test(item) {
            n += 1
        }
    }
    return n
}

/// The first item satisfying `test`, or nil.
pub fn find<T>(items: [T], test: fn(T) -> bool) -> Option<T> {
    for item in items {
        if test(item) {
            return item
        }
    }
    return nil
}

/// The first item, or nil for an empty slice.
pub fn first<T>(items: [T]) -> Option<T> {
    if items.len() == 0 {
        return nil
    }
    return items[0]
}

/// The last item, or nil for an empty slice.
pub fn last<T>(items: [T]) -> Option<T> {
    if items.len() == 0 {
        return nil
    }
    return items[items.len() - 1]
}

/// The items in the opposite order.
pub fn reversed<T>(items: [T]) -> [T] {
    var out: [T] = []
    var i = items.len() - 1
    for i >= 0 {
        out.push(items[i])
        i -= 1
    }
    return out
}

/// `items`, then `other`. Neither is modified: slices are values.
pub fn concat<T>(items: [T], other: [T]) -> [T] {
    var out: [T] = []
    for item in items {
        out.push(item)
    }
    for item in other {
        out.push(item)
    }
    return out
}

/// At most `n` items from the front. A negative `n` yields nothing rather than
/// trapping, because `take` describes an amount and a negative amount is none.
pub fn take<T>(items: [T], n: int) -> [T] {
    var out: [T] = []
    for i in 0..items.len() {
        if i >= n {
            return out
        }
        out.push(items[i])
    }
    return out
}

/// Everything after the first `n` items.
pub fn drop<T>(items: [T], n: int) -> [T] {
    var out: [T] = []
    for i in 0..items.len() {
        if i >= n {
            out.push(items[i])
        }
    }
    return out
}

// ---- numbers --------------------------------------------------------------

/// The distance from zero.
pub fn abs(x: int) -> int {
    if x < 0 {
        return 0 - x
    }
    return x
}

pub fn absf(x: float) -> float {
    if x < 0.0 {
        return 0.0 - x
    }
    return x
}

pub fn min(a: int, b: int) -> int {
    if a < b {
        return a
    }
    return b
}

pub fn max(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

pub fn minf(a: float, b: float) -> float {
    if a < b {
        return a
    }
    return b
}

pub fn maxf(a: float, b: float) -> float {
    if a > b {
        return a
    }
    return b
}

/// `x` held within `[low, high]`.
pub fn clamp(x: int, low: int, high: int) -> int {
    return min(max(x, low), high)
}

pub fn clampf(x: float, low: float, high: float) -> float {
    return minf(maxf(x, low), high)
}

/// Floating-point equality within a tolerance. Comparing floats with `==` is
/// almost never what is meant, which is why the compiler warns and points here.
pub fn approx_eq(a: float, b: float, tolerance: float) -> bool {
    return absf(a - b) <= tolerance
}

/// Whether `x` divides evenly by `by`.
pub fn divides(x: int, by: int) -> bool {
    return x % by == 0
}

/// The sum of a slice of numbers.
pub fn sum(items: [int]) -> int {
    var total = 0
    for item in items {
        total = total + item
    }
    return total
}

pub fn sumf(items: [float]) -> float {
    var total = 0.0
    for item in items {
        total = total + item
    }
    return total
}

// ---- strings --------------------------------------------------------------
//
// `str` has five methods, all of them host calls: `len`, `slice`, `index_of`,
// `trim` and `code_at`. Everything below is written on top of them, which is
// where it belongs — a host call is a boundary two runtimes have to agree
// about, and every one added is a thing that can drift.

/// Whether `needle` appears anywhere in `s`.
pub fn contains(s: str, needle: str) -> bool {
    return s.index_of(needle) >= 0
}

pub fn starts_with(s: str, prefix: str) -> bool {
    if prefix.len() > s.len() {
        return false
    }
    return s.slice(0, prefix.len()) == prefix
}

pub fn ends_with(s: str, suffix: str) -> bool {
    if suffix.len() > s.len() {
        return false
    }
    return s.slice(s.len() - suffix.len(), s.len()) == suffix
}

/// `s` cut at every occurrence of `sep`.
///
/// An empty separator would have no answer — every position is an occurrence —
/// so it yields the whole string rather than looping.
pub fn split(s: str, sep: str) -> [str] {
    var out: [str] = []
    if sep.len() == 0 {
        out.push(s)
        return out
    }
    var rest = s
    for rest.len() > 0 {
        let at = rest.index_of(sep)
        if at < 0 {
            out.push(rest)
            return out
        }
        out.push(rest.slice(0, at))
        rest = rest.slice(at + sep.len(), rest.len())
    }
    out.push("")
    return out
}

/// The pieces joined with `sep` between them.
pub fn join(pieces: [str], sep: str) -> str {
    var out = ""
    for i in 0..pieces.len() {
        if i > 0 {
            out = out + sep
        }
        out = out + pieces[i]
    }
    return out
}

/// `s` with every occurrence of `from` replaced by `to`.
pub fn replace(s: str, from: str, to: str) -> str {
    return join(split(s, from), to)
}

/// The words of `s`, with runs of spaces collapsed.
pub fn words(s: str) -> [str] {
    return filter(split(s.trim(), " "), |w: str| w.len() > 0)
}

// ---- optionals ------------------------------------------------------------

/// The value, or `fallback` when there is none.
pub fn or_else<T>(value: Option<T>, fallback: T) -> T {
    // Testing for presence is what narrows: on this branch the compiler knows
    // the value is there, so it reads as a `T` with no unwrapping written.
    if value != nil {
        return value
    }
    return fallback
}

/// Whether an optional holds a value.
pub fn is_some<T>(value: Option<T>) -> bool {
    return value != nil
}

// ---- reading numbers --------------------------------------------------------
//
// Parsing yields an optional rather than trapping or returning a zero: text
// that is not a number is an ordinary runtime condition — it came from a file
// or a person — and a zero would be indistinguishable from the text "0".

/// A whole number, or nil. Accepts a leading `-` and digits, and nothing else:
/// no spaces, no separators, no trailing units. A caller who wants those
/// trims first, which is a decision this cannot make for them.
///
/// A number too large for an `int` is nil as well. The text is untrusted by
/// assumption, and twenty nines used to overflow the multiplication — a trap,
/// which is not catchable — so the function that exists to say "not a number"
/// ended the process instead. The digits are accumulated as a *negative*
/// number, the wider half of an `int`, which is also what lets the one value
/// with no positive counterpart, `-9223372036854775808`, through.
pub fn parse_int(text: str) -> Option<int> {
    if text.len() == 0 {
        return nil
    }
    var start = 0
    if text.code_at(0) == 45 {
        start = 1
    }
    if start >= text.len() {
        return nil
    }
    let lowest = -9223372036854775807 - 1
    var value = 0
    for i in start..text.len() {
        let d = text.code_at(i) - 48
        if d < 0 || d > 9 {
            return nil
        }
        // `value * 10 - d >= lowest`, rearranged so that asking cannot
        // overflow. Integer division truncates toward zero, which for a
        // negative numerator is the ceiling — the bound this needs.
        if value < (lowest + d) / 10 {
            return nil
        }
        value = value * 10 - d
    }
    if start == 1 {
        return value
    }
    if value == lowest {
        return nil
    }
    return 0 - value
}

/// A decimal number, or nil: an optional `-`, digits with an optional
/// fractional part, and an optional exponent — `2.5`, `-0.25`, `.5`, `6.02e23`.
/// Nothing else: no `+` in front, no spaces, no separators, no `inf` or `nan`,
/// and a point needs a digit after it. A number too large for a `float` is nil
/// rather than an infinity; one too small to be told from zero is zero, and
/// `-0` keeps its sign, both as IEEE 754 has it.
///
/// **Correctly rounded.** The answer is the float nearest the decimal the text
/// denotes, ties to even — the float every other language's parser gives, and
/// the one `\(x)` printed if that is where the text came from. Adding up digit
/// values as floats is not that: `0.3` came out as 0.30000000000000004, and a
/// fraction too long for an `int` overflowed it and trapped. `std/json` and
/// `std/toml` read their numbers through this, so the three agree.
pub fn parse_float(text: str) -> Option<float> {
    let n = text.len()
    var i = 0
    var negative = false
    if n > 0 && text.code_at(0) == 45 {
        negative = true
        i = 1
    }
    // The significant digits, from the first that is not zero, and the power
    // of ten they are scaled by: `0.0250` is [2, 5, 0] × 10⁻⁴.
    var digits: [int] = []
    var exponent = 0
    var seen = 0
    // Whether a digit past the ones kept was not zero.
    var dropped = false
    for i < n {
        let d = text.code_at(i) - 48
        if d < 0 || d > 9 {
            break
        }
        seen += 1
        if digits.len() < kept_digits() {
            if digits.len() > 0 || d > 0 {
                digits.push(d)
            }
        } else {
            exponent += 1
            dropped = dropped || d > 0
        }
        i += 1
    }
    if i < n && text.code_at(i) == 46 {
        i += 1
        let from = i
        for i < n {
            let d = text.code_at(i) - 48
            if d < 0 || d > 9 {
                break
            }
            seen += 1
            if digits.len() < kept_digits() {
                if digits.len() > 0 || d > 0 {
                    digits.push(d)
                }
                exponent -= 1
            } else {
                dropped = dropped || d > 0
            }
            i += 1
        }
        if i == from {
            return nil
        }
    }
    if seen == 0 {
        return nil
    }
    if i < n && (text.code_at(i) == 101 || text.code_at(i) == 69) {
        i += 1
        var minus = false
        if i < n && (text.code_at(i) == 45 || text.code_at(i) == 43) {
            minus = text.code_at(i) == 45
            i += 1
        }
        let from = i
        var power = 0
        for i < n {
            let d = text.code_at(i) - 48
            if d < 0 || d > 9 {
                break
            }
            // Past any exponent a float can use, more digits change nothing
            // but would overflow the `int` holding them.
            if power < 100000 {
                power = power * 10 + d
            }
            i += 1
        }
        if i == from {
            return nil
        }
        exponent = if minus { exponent - power } else { exponent + power }
    }
    if i < n {
        return nil
    }
    if dropped {
        // One more digit, standing for everything dropped: it puts the value
        // strictly between the digits kept and the next number up, which is
        // on the same side of every rounding boundary as the whole text.
        digits.push(1)
        exponent -= 1
    }
    let magnitude = nearest_float(digits, exponent)
    if magnitude == nil {
        return nil
    }
    if negative {
        // Multiplied rather than subtracted from zero: `0.0 - 0.0` is +0.
        return magnitude * -1.0
    }
    return magnitude
}

/// How many significant digits a decimal is read to. Past 767 no digit can
/// move the answer — no float, and no point halfway between two, needs more to
/// write out exactly — so the rest count only as "something more".
fn kept_digits() -> int {
    return 800
}

/// The float nearest `digits × 10^exponent`, or nil past the largest float.
///
/// **Clinger's fast path first**, which is most numbers anyone writes: when the
/// digits make an integer of at most 2⁵³ and the power of ten is at most 10²²,
/// both are floats *exactly*, and one IEEE multiplication or division rounds
/// their product or quotient correctly by definition.
///
/// Everything else — seventeen significant digits, as JavaScript prints
/// `0.30000000000000004`, or a large exponent — goes to [`nearest_slowly`],
/// which is exact too, at the price of arithmetic on big integers.
fn nearest_float(digits: [int], exponent: int) -> Option<float> {
    var count = digits.len()
    var e = exponent
    for count > 0 && digits[count - 1] == 0 {
        count -= 1
        e += 1
    }
    if count == 0 {
        return 0.0
    }
    // At least 10³⁰⁹, past the largest float; below 10⁻³²⁵, under half the
    // smallest, which rounds to zero.
    if count + e > 310 {
        return nil
    }
    if count + e < -324 {
        return 0.0
    }
    if count <= 18 {
        var whole = 0
        for k in 0..count {
            whole = whole * 10 + digits[k]
        }
        let limit = 9007199254740992
        if whole <= limit {
            if e >= 0 && e <= 22 {
                return (whole as float) * exact_ten(e)
            }
            if e < 0 && e >= -22 {
                return (whole as float) / exact_ten(0 - e)
            }
            // `12e30` is `12000000000e22`, and that integer is still exact.
            if e > 22 && e <= 37 {
                var shift = 1
                let extra = e - 22
                for k in 0..extra {
                    shift = shift * 10
                }
                if whole <= limit / shift {
                    return ((whole * shift) as float) * exact_ten(22)
                }
            }
        }
    }
    return nearest_slowly(digits, count, e)
}

/// 10ᵏ for `k` up to 22, every one of which is a float exactly — so is each
/// step of the product, which is why multiplying is safe here and nowhere else.
fn exact_ten(k: int) -> float {
    var out = 1.0
    for i in 0..k {
        out = out * 10.0
    }
    return out
}

/// The float nearest `digits[..count] × 10^e`, decided in exact arithmetic.
///
/// Clinger's AlgorithmR. An estimate from floating point is within a few units
/// of the answer; for a candidate `m · 2ᵖ`, the points halfway to its
/// neighbours are `(2m ± 1) · 2ᵖ⁻¹`, and the decimal is compared with them as
/// big integers — powers of five and two moved to whichever side keeps both
/// whole. Above the upper point the candidate moves up, below the lower one it
/// moves down, and on a point it goes to the even neighbour. Nothing is
/// approximated, so the answer is the correctly rounded one for every input
/// and not only for the ones tried.
fn nearest_slowly(digits: [int], count: int, e: int) -> Option<float> {
    // The estimate, from the first eighteen digits.
    let taken = if count < 18 { count } else { 18 }
    var whole = 0
    for k in 0..taken {
        whole = whole * 10 + digits[k]
    }
    var scale = e + (count - taken)
    var estimate = whole as float
    for scale > 22 {
        estimate = estimate * exact_ten(22)
        scale -= 22
    }
    for scale < -22 {
        estimate = estimate / exact_ten(22)
        scale += 22
    }
    if scale >= 0 {
        estimate = estimate * exact_ten(scale)
    } else {
        estimate = estimate / exact_ten(0 - scale)
    }

    // The estimate as `mantissa · 2^power`: a mantissa in [2⁵², 2⁵³), or
    // below it at the smallest power, which is what a subnormal is.
    let low = 4503599627370496
    let high = 9007199254740992
    var mantissa = 0
    var power = -1074
    if !(estimate < estimate * 2.0) && estimate > 0.0 {
        // Past the largest float: start from the largest and let the
        // comparison say whether the decimal rounds down to it.
        mantissa = high - 1
        power = 971
    } else if estimate > 0.0 {
        var s = estimate
        power = 0
        for s >= 18446744073709551616.0 {
            s = s / 18446744073709551616.0
            power += 64
        }
        for s >= 9007199254740992.0 {
            s = s / 2.0
            power += 1
        }
        for s < 4503599627370496.0 && power > -1074 {
            if s < 0.000244140625 && power - 64 >= -1074 {
                s = s * 18446744073709551616.0
                power -= 64
            } else {
                s = s * 2.0
                power -= 1
            }
        }
        mantissa = s as int
    }

    // The decimal as `number × 5^e × 2^e`. A negative power of five moves to
    // the other side of every comparison, so it is kept there.
    var number = big_of_digits(digits, count)
    var fives: [int] = [1]
    if e >= 0 {
        number = big_times_five_to(number, e)
    } else {
        fives = big_times_five_to(fives, 0 - e)
    }

    for step in 0..100 {
        let above = compare_halfway(number, fives, e, 2 * mantissa + 1, power - 1)
        if above > 0 || (above == 0 && mantissa % 2 == 1) {
            mantissa += 1
            if mantissa == high {
                mantissa = low
                power += 1
            }
            if power > 971 {
                return nil
            }
            if above == 0 {
                break
            }
            continue
        }
        if mantissa == 0 {
            break
        }
        // At the bottom of a binade the neighbour below is half as far away.
        var below = 0
        if mantissa == low && power > -1074 {
            below = compare_halfway(number, fives, e, 4 * mantissa - 1, power - 2)
        } else {
            below = compare_halfway(number, fives, e, 2 * mantissa - 1, power - 1)
        }
        if below < 0 || (below == 0 && mantissa % 2 == 1) {
            mantissa -= 1
            if mantissa < low && power > -1074 {
                mantissa = high - 1
                power -= 1
            }
            if below == 0 {
                break
            }
            continue
        }
        break
    }
    return times_two_to(mantissa as float, power)
}

/// The sign of `number × 5^e × 2^e − odd × 2^power`, where `fives` holds
/// `5^-e` when `e` is negative and 1 otherwise.
fn compare_halfway(number: [int], fives: [int], e: int, odd: int, power: int) -> int {
    var left = number
    var right = big_times(fives, big_of(odd))
    let twos = e - power
    if twos >= 0 {
        left = big_shifted(left, twos)
    } else {
        right = big_shifted(right, 0 - twos)
    }
    return big_compare(left, right)
}

/// `x · 2ᵏ`, applying the power in pieces that are each a float, so that only
/// the last multiplication can round.
fn times_two_to(x: float, k: int) -> float {
    var out = x
    var left = k
    for left > 1000 {
        out = out * two_to(1000)
        left -= 1000
    }
    for left < -1000 {
        out = out / two_to(1000)
        left += 1000
    }
    if left >= 0 {
        return out * two_to(left)
    }
    return out / two_to(0 - left)
}

/// 2ᵏ for `k` from 0 to 1023, by squaring; every step is exact.
fn two_to(k: int) -> float {
    var out = 1.0
    var base = 2.0
    var n = k
    for n > 0 {
        if n % 2 == 1 {
            out = out * base
        }
        n = n / 2
        if n > 0 {
            base = base * base
        }
    }
    return out
}

// Natural numbers of any size, for `nearest_slowly`: least significant limb
// first, 28 bits a limb, and no zero limbs at the top. A limb times anything
// below 2³¹, plus a carry, stays well inside an `int`, and so does a limb
// times a limb plus two more.

fn big_of(n: int) -> [int] {
    var out: [int] = []
    var rest = n
    for rest > 0 {
        out.push(rest & 268435455)
        rest = rest >> 28
    }
    return out
}

fn big_of_digits(digits: [int], count: int) -> [int] {
    var out: [int] = []
    var k = 0
    // Seven digits at a time: 10⁷ is below 2³¹.
    for k < count {
        var chunk = 0
        var size = 1
        var taken = 0
        for taken < 7 && k < count {
            chunk = chunk * 10 + digits[k]
            size = size * 10
            taken += 1
            k += 1
        }
        out = big_times_small(out, size, chunk)
    }
    return out
}

/// `a × m + add`, for `m` and `add` below 2³¹.
fn big_times_small(a: [int], m: int, add: int) -> [int] {
    var out: [int] = []
    var carry = add
    for limb in a {
        let t = limb * m + carry
        out.push(t & 268435455)
        carry = t >> 28
    }
    for carry > 0 {
        out.push(carry & 268435455)
        carry = carry >> 28
    }
    return out
}

fn big_times_five_to(a: [int], k: int) -> [int] {
    var out = a
    var left = k
    // 5¹³ is the largest power of five below 2³¹.
    for left >= 13 {
        out = big_times_small(out, 1220703125, 0)
        left -= 13
    }
    var last = 1
    for i in 0..left {
        last = last * 5
    }
    return big_times_small(out, last, 0)
}

fn big_times(a: [int], b: [int]) -> [int] {
    var out: [int] = []
    let size = a.len() + b.len()
    for i in 0..size {
        out.push(0)
    }
    for i in 0..a.len() {
        var carry = 0
        for j in 0..b.len() {
            let t = out[i + j] + a[i] * b[j] + carry
            out[i + j] = t & 268435455
            carry = t >> 28
        }
        var k = i + b.len()
        for carry > 0 {
            let t = out[k] + carry
            out[k] = t & 268435455
            carry = t >> 28
            k += 1
        }
    }
    var top = out.len()
    for top > 0 && out[top - 1] == 0 {
        top -= 1
    }
    var trimmed: [int] = []
    for i in 0..top {
        trimmed.push(out[i])
    }
    return trimmed
}

/// `a × 2ᵏ`: whole limbs of zeros underneath, then the remaining bits.
fn big_shifted(a: [int], k: int) -> [int] {
    if a.len() == 0 {
        return a
    }
    var out: [int] = []
    for i in 0..k / 28 {
        out.push(0)
    }
    for limb in a {
        out.push(limb)
    }
    return big_times_small(out, 1 << (k % 28), 0)
}

fn big_compare(a: [int], b: [int]) -> int {
    if a.len() != b.len() {
        return if a.len() < b.len() { -1 } else { 1 }
    }
    var i = a.len() - 1
    for i >= 0 {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 }
        }
        i -= 1
    }
    return 0
}

// ---- letters ----------------------------------------------------------------
//
// ASCII only, and it says so. Case is a property of a language rather than of a
// character — Turkish dotless i and German ß both make "lowercase then compare"
// wrong — and a library that pretended otherwise would be wrong quietly. What
// this is for is protocol text: header names, flags, identifiers.

pub fn lower(text: str) -> str {
    return mapped(text, "ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz")
}

pub fn upper(text: str) -> str {
    return mapped(text, "abcdefghijklmnopqrstuvwxyz", "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
}

/// Whether two runs of text are the same ignoring ASCII case, which is what a
/// header name or a flag is compared with.
pub fn equal_ignoring_case(left: str, right: str) -> bool {
    return lower(left) == lower(right)
}

fn mapped(text: str, from: str, to: str) -> str {
    var out = ""
    for i in 0..text.len() {
        let c = text.slice(i, i + 1)
        let at = from.index_of(c)
        if at >= 0 {
            out = out + to.slice(at, at + 1)
        } else {
            out = out + c
        }
    }
    return out
}

/// `text` at least `width` long, padded on the left with `with`. Numbers in a
/// column need this often enough to belong here rather than in `std/fmt`,
/// which is about laying out a whole line.
pub fn pad_start(text: str, width: int, with: str) -> str {
    if with.len() == 0 {
        return text
    }
    var out = text
    for out.len() < width {
        out = with + out
    }
    return out
}

// ---- ordering ---------------------------------------------------------------
//
// Sorting takes a comparison rather than requiring an `Ord` implementation.
// Kite has no associated types and no operator overloading, so a comparison
// written at the call site is both the simplest thing that works and the one
// that reads: `sorted(people, |a, b| a.age < b.age)` says what order it is in.

/// `items` in the order `less` puts them, which is stable: two items `less`
/// does not separate keep the order they were given in.
///
/// Merge sort rather than quicksort, because stability is worth more than the
/// constant factor for the sizes application code sorts, and because a
/// quicksort's worst case is a sorted input, which application code has a lot
/// of.
pub fn sorted<T>(items: [T], less: fn(T, T) -> bool) -> [T] {
    if items.len() <= 1 {
        return items
    }
    let middle = items.len() / 2
    let left = sorted(take(items, middle), less)
    let right = sorted(drop(items, middle), less)
    return merge(left, right, less)
}

fn merge<T>(left: [T], right: [T], less: fn(T, T) -> bool) -> [T] {
    var out: [T] = []
    var i = 0
    var j = 0
    for i < left.len() {
        if j >= right.len() {
            out.push(left[i])
            i += 1
        } else {
            // `less(right, left)` rather than `!less(left, right)`: an item
            // the comparison does not separate goes left, which is what makes
            // this stable.
            if less(right[j], left[i]) {
                out.push(right[j])
                j += 1
            } else {
                out.push(left[i])
                i += 1
            }
        }
    }
    for j < right.len() {
        out.push(right[j])
        j += 1
    }
    return out
}

/// The item `less` puts first, or nil for an empty slice.
pub fn min_by<T>(items: [T], less: fn(T, T) -> bool) -> Option<T> {
    if items.len() == 0 {
        return nil
    }
    var best = items[0]
    for item in items {
        if less(item, best) {
            best = item
        }
    }
    return best
}

pub fn max_by<T>(items: [T], less: fn(T, T) -> bool) -> Option<T> {
    if items.len() == 0 {
        return nil
    }
    var best = items[0]
    for item in items {
        if less(best, item) {
            best = item
        }
    }
    return best
}

// ---- more slices ------------------------------------------------------------

/// Pairs, up to the length of the shorter side.
pub fn zip<A, B>(left: [A], right: [B]) -> [(A, B)] {
    var out: [(A, B)] = []
    for i in 0..min(left.len(), right.len()) {
        out.push((left[i], right[i]))
    }
    return out
}

/// Each item with the position it was at.
///
/// ```kite
/// let names = ["ada", "grace"]
/// for (i, name) in enumerate(names) {
///     io.print("\(i). \(name)")
/// }
/// ```
///
/// A function rather than a method on `[T]`, which is what §6.2 used to write.
/// A slice can only take methods from the compiler — §8.2 has no extension
/// methods, so that a receiver's methods are always found where its type is
/// declared — and the three the compiler gives it are the three nothing else
/// can be built from. This one can, so it is here, where it can be read.
pub fn enumerate<T>(items: [T]) -> [(int, T)] {
    var out: [(int, T)] = []
    for i in 0..items.len() {
        out.push((i, items[i]))
    }
    return out
}

/// One slice out of many.
pub fn flatten<T>(groups: [[T]]) -> [T] {
    var out: [T] = []
    for group in groups {
        for item in group {
            out.push(item)
        }
    }
    return out
}

/// The first position `test` accepts, or -1. A position rather than an
/// optional, because -1 is what a caller compares against and an optional
/// would need unwrapping before it could be used as an index anyway.
pub fn position<T>(items: [T], test: fn(T) -> bool) -> int {
    for i in 0..items.len() {
        if test(items[i]) {
            return i
        }
    }
    return -1
}

/// Whether `items` holds something equal to `wanted`.
pub fn includes<T>(items: [T], wanted: T) -> bool {
    for item in items {
        if item == wanted {
            return true
        }
    }
    return false
}

/// `items` with later duplicates removed, keeping the first of each.
pub fn unique<T>(items: [T]) -> [T] {
    var out: [T] = []
    for item in items {
        if !includes(out, item) {
            out.push(item)
        }
    }
    return out
}

/// `items` in groups of at most `size`. The last group is whatever is left.
pub fn chunked<T>(items: [T], size: int) -> [[T]] {
    var out: [[T]] = []
    if size <= 0 {
        return out
    }
    var group: [T] = []
    for item in items {
        group.push(item)
        if group.len() == size {
            out.push(group)
            group = []
        }
    }
    if group.len() > 0 {
        out.push(group)
    }
    return out
}

// ---- hashing and debugging ------------------------------------------------
//
// The helpers `@derive(Hash)` and `@derive(Debug)` are written in terms of.
// They are ordinary functions rather than compiler knowledge, so a
// hand-written implementation can use the same ones and get the same answers
// — which is what makes a derived body and a written one comparable.

/// The FNV-1a offset basis.
///
/// FNV is chosen because it is four lines, needs no tables, and asks the two
/// backends to agree about nothing but integer arithmetic.
///
/// The **32-bit** parameters, in a 64-bit `int`, and that is not an oversight:
/// Kite traps on integer overflow, so the 64-bit prime would kill the program
/// on the first character. Staying inside 32 bits keeps every product well
/// under the range, which is what lets the arithmetic be ordinary Kite instead
/// of a wrapping operation the language deliberately does not have.
pub fn hash_seed() -> int {
    return 2166136261
}

/// Fold one more value into a hash.
pub fn hash_combine(accumulated: int, next: int) -> int {
    var h = accumulated
    // Eight bytes, low to high. Mixing byte by byte rather than whole words is
    // what gives FNV the avalanche it is chosen for.
    var i = 0
    for i < 8 {
        h = ((h ^ ((next >> (i * 8)) & 255)) * 16777619) % 4294967296
        i = i + 1
    }
    return h
}

pub fn hash_int(value: int) -> int {
    return hash_combine(hash_seed(), value)
}

pub fn hash_bool(value: bool) -> int {
    return hash_combine(hash_seed(), if value { 1 } else { 0 })
}

/// A float's hash goes through its rendered text.
///
/// That is not a shortcut. Rendering is the one thing about a float both
/// backends already agree on exactly — it is shared with `io.print` and with
/// interpolation — whereas reinterpreting the bits would need an operation
/// Kite does not have and the two runtimes would have to be made to match.
///
/// Zero is the one place that needs a word. `-0.0 == 0.0`, so the two must
/// hash alike, and they render differently — so both hash as `0.0` does.
pub fn hash_float(value: float) -> int {
    if value == 0.0 {
        return hash_str("0.0")
    }
    return hash_str("\(value)")
}

/// FNV-1a over the string's code points.
pub fn hash_str(text: str) -> int {
    var h = hash_seed()
    for i in 0..text.len() {
        h = hash_combine(h, text.code_at(i))
    }
    return h
}

/// A string as it would be written in source: quoted, with the escapes put
/// back. What `@derive(Debug)` uses for a `str` field, so a value containing a
/// comma or a brace cannot be mistaken for structure.
pub fn debug_str(text: str) -> str {
    var out = "\""
    for i in 0..text.len() {
        let c = text.slice(i, i + 1)
        if c == "\"" {
            out = out + "\\\""
        } else {
            if c == "\\" {
                out = out + "\\\\"
            } else {
                if c == "\n" {
                    out = out + "\\n"
                } else {
                    if c == "\t" {
                        out = out + "\\t"
                    } else {
                        out = out + c
                    }
                }
            }
        }
    }
    return out + "\""
}
