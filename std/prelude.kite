// The Kite prelude.
//
// Compiled into every program before the user's own file. It is written in
// Kite, not in the compiler: everything here is expressible in the language,
// which is the point — a standard library that needed compiler support would
// be evidence the language was missing something.
//
// It is deliberately small. Each addition is a name every program must live
// with, and a name taken is hard to give back.

// ---- display --------------------------------------------------------------

/// How a type presents itself to a human.
///
/// `io.print` and `\(x)` interpolation both look for this, so implementing it
/// once makes a type printable everywhere. It is deliberately **not** derived:
/// how something reads is a design decision, and a mechanical one would be
/// wrong more often than it was right — a `Password` that printed its field is
/// the obvious case.
pub trait Display {
    fn show(self) -> str
}

/// A value of this type may be moved to another task or isolate.
///
/// The one trait nobody implements: the compiler decides, structurally, and a
/// type qualifies when it is deeply immutable. Because struct fields are
/// immutable unless marked `var`, most types satisfy it without their author
/// doing anything or knowing the trait exists — it only becomes visible when
/// it is violated, as E0520.
///
/// It is declared here rather than in the compiler so that `Share` is an
/// ordinary name a bound can mention, and so the rule it stands for is
/// readable in the language it constrains.
pub trait Share {
}

// ---- slices ---------------------------------------------------------------

/// A new slice with `f` applied to every item. The result need not have the
/// same element type: `map(people, |p: Person| p.name)` is `[str]`.
pub fn map<T, U>(items: [T], f: fn(T) -> U) -> [U] {
    var out: [U] = []
    for item in items {
        out.push(f(item))
    }
    return out
}

/// Combine every item into one value, left to right.
pub fn fold<T, A>(items: [T], initial: A, f: fn(A, T) -> A) -> A {
    var total = initial
    for item in items {
        total = f(total, item)
    }
    return total
}

/// The items `test` accepts, in order.
pub fn filter<T>(items: [T], test: fn(T) -> bool) -> [T] {
    var out: [T] = []
    for item in items {
        if test(item) {
            out.push(item)
        }
    }
    return out
}

/// Whether any item satisfies `test`. Stops at the first that does.
pub fn any<T>(items: [T], test: fn(T) -> bool) -> bool {
    for item in items {
        if test(item) {
            return true
        }
    }
    return false
}

/// Whether every item satisfies `test`. Vacuously true for an empty slice,
/// which is the convention every language settles on because the alternative
/// breaks the identity `all(a + b) == all(a) and all(b)`.
pub fn all<T>(items: [T], test: fn(T) -> bool) -> bool {
    for item in items {
        if !test(item) {
            return false
        }
    }
    return true
}

/// How many items satisfy `test`.
pub fn count<T>(items: [T], test: fn(T) -> bool) -> int {
    var n = 0
    for item in items {
        if test(item) {
            n += 1
        }
    }
    return n
}

/// The first item satisfying `test`, or nil.
pub fn find<T>(items: [T], test: fn(T) -> bool) -> Option<T> {
    for item in items {
        if test(item) {
            return item
        }
    }
    return nil
}

/// The first item, or nil for an empty slice.
pub fn first<T>(items: [T]) -> Option<T> {
    if items.len() == 0 {
        return nil
    }
    return items[0]
}

/// The last item, or nil for an empty slice.
pub fn last<T>(items: [T]) -> Option<T> {
    if items.len() == 0 {
        return nil
    }
    return items[items.len() - 1]
}

/// The items in the opposite order.
pub fn reversed<T>(items: [T]) -> [T] {
    var out: [T] = []
    var i = items.len() - 1
    for i >= 0 {
        out.push(items[i])
        i -= 1
    }
    return out
}

/// `items`, then `other`. Neither is modified: slices are values.
pub fn concat<T>(items: [T], other: [T]) -> [T] {
    var out: [T] = []
    for item in items {
        out.push(item)
    }
    for item in other {
        out.push(item)
    }
    return out
}

/// At most `n` items from the front. A negative `n` yields nothing rather than
/// trapping, because `take` describes an amount and a negative amount is none.
pub fn take<T>(items: [T], n: int) -> [T] {
    var out: [T] = []
    for i in 0..items.len() {
        if i >= n {
            return out
        }
        out.push(items[i])
    }
    return out
}

/// Everything after the first `n` items.
pub fn drop<T>(items: [T], n: int) -> [T] {
    var out: [T] = []
    for i in 0..items.len() {
        if i >= n {
            out.push(items[i])
        }
    }
    return out
}

// ---- numbers --------------------------------------------------------------

/// The distance from zero.
pub fn abs(x: int) -> int {
    if x < 0 {
        return 0 - x
    }
    return x
}

pub fn absf(x: float) -> float {
    if x < 0.0 {
        return 0.0 - x
    }
    return x
}

pub fn min(a: int, b: int) -> int {
    if a < b {
        return a
    }
    return b
}

pub fn max(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

pub fn minf(a: float, b: float) -> float {
    if a < b {
        return a
    }
    return b
}

pub fn maxf(a: float, b: float) -> float {
    if a > b {
        return a
    }
    return b
}

/// `x` held within `[low, high]`.
pub fn clamp(x: int, low: int, high: int) -> int {
    return min(max(x, low), high)
}

pub fn clampf(x: float, low: float, high: float) -> float {
    return minf(maxf(x, low), high)
}

/// Floating-point equality within a tolerance. Comparing floats with `==` is
/// almost never what is meant, which is why the compiler warns and points here.
pub fn approx_eq(a: float, b: float, tolerance: float) -> bool {
    return absf(a - b) <= tolerance
}

/// Whether `x` divides evenly by `by`.
pub fn divides(x: int, by: int) -> bool {
    return x % by == 0
}

/// The sum of a slice of numbers.
pub fn sum(items: [int]) -> int {
    var total = 0
    for item in items {
        total = total + item
    }
    return total
}

pub fn sumf(items: [float]) -> float {
    var total = 0.0
    for item in items {
        total = total + item
    }
    return total
}

// ---- strings --------------------------------------------------------------
//
// `str` has four methods, all of them host calls: `len`, `slice`, `index_of`
// and `trim`. Everything below is written on top of them, which is where it
// belongs — a host call is a boundary two runtimes have to agree about, and
// every one added is a thing that can drift.

/// Whether `needle` appears anywhere in `s`.
pub fn contains(s: str, needle: str) -> bool {
    return s.index_of(needle) >= 0
}

pub fn starts_with(s: str, prefix: str) -> bool {
    if prefix.len() > s.len() {
        return false
    }
    return s.slice(0, prefix.len()) == prefix
}

pub fn ends_with(s: str, suffix: str) -> bool {
    if suffix.len() > s.len() {
        return false
    }
    return s.slice(s.len() - suffix.len(), s.len()) == suffix
}

/// `s` cut at every occurrence of `sep`.
///
/// An empty separator would have no answer — every position is an occurrence —
/// so it yields the whole string rather than looping.
pub fn split(s: str, sep: str) -> [str] {
    var out: [str] = []
    if sep.len() == 0 {
        out.push(s)
        return out
    }
    var rest = s
    for rest.len() > 0 {
        let at = rest.index_of(sep)
        if at < 0 {
            out.push(rest)
            return out
        }
        out.push(rest.slice(0, at))
        rest = rest.slice(at + sep.len(), rest.len())
    }
    out.push("")
    return out
}

/// The pieces joined with `sep` between them.
pub fn join(pieces: [str], sep: str) -> str {
    var out = ""
    for i in 0..pieces.len() {
        if i > 0 {
            out = out + sep
        }
        out = out + pieces[i]
    }
    return out
}

/// `s` with every occurrence of `from` replaced by `to`.
pub fn replace(s: str, from: str, to: str) -> str {
    return join(split(s, from), to)
}

/// The words of `s`, with runs of spaces collapsed.
pub fn words(s: str) -> [str] {
    return filter(split(s.trim(), " "), |w: str| w.len() > 0)
}

// ---- optionals ------------------------------------------------------------

/// The value, or `fallback` when there is none.
pub fn or_else<T>(value: Option<T>, fallback: T) -> T {
    // Testing for presence is what narrows: on this branch the compiler knows
    // the value is there, so it reads as a `T` with no unwrapping written.
    if value != nil {
        return value
    }
    return fallback
}

/// Whether an optional holds a value.
pub fn is_some<T>(value: Option<T>) -> bool {
    return value != nil
}

// ---- reading numbers --------------------------------------------------------
//
// Parsing yields an optional rather than trapping or returning a zero: text
// that is not a number is an ordinary runtime condition — it came from a file
// or a person — and a zero would be indistinguishable from the text "0".

/// A whole number, or nil. Accepts a leading `-` and digits, and nothing else:
/// no spaces, no separators, no trailing units. A caller who wants those
/// trims first, which is a decision this cannot make for them.
pub fn parse_int(text: str) -> Option<int> {
    if text.len() == 0 {
        return nil
    }
    var negative = false
    var start = 0
    if text.slice(0, 1) == "-" {
        negative = true
        start = 1
    }
    if start >= text.len() {
        return nil
    }
    var value = 0
    for i in start..text.len() {
        let d = "0123456789".index_of(text.slice(i, i + 1))
        if d < 0 {
            return nil
        }
        value = value * 10 + d
    }
    if negative {
        return 0 - value
    }
    return value
}

/// A number with an optional fractional part, or nil. No exponent: a program
/// that needs one is reading a format that has other rules too, and `std/json`
/// is where those live.
pub fn parse_float(text: str) -> Option<float> {
    let point = text.index_of(".")
    if point < 0 {
        let whole = parse_int(text)
        if whole == nil {
            return nil
        }
        return whole as float
    }
    let left = text.slice(0, point)
    let right = text.slice(point + 1, text.len())
    if right.len() == 0 {
        return nil
    }
    let whole = parse_int(if left.len() == 0 { "0" } else { left })
    let fraction = parse_int(right)
    if whole == nil {
        return nil
    }
    if fraction == nil {
        return nil
    }
    var scale = 1.0
    for i in 0..right.len() {
        scale = scale * 10.0
    }
    let magnitude = absf(whole as float) + (fraction as float) / scale
    if starts_with(text, "-") {
        return 0.0 - magnitude
    }
    return magnitude
}

// ---- letters ----------------------------------------------------------------
//
// ASCII only, and it says so. Case is a property of a language rather than of a
// character — Turkish dotless i and German ß both make "lowercase then compare"
// wrong — and a library that pretended otherwise would be wrong quietly. What
// this is for is protocol text: header names, flags, identifiers.

pub fn lower(text: str) -> str {
    return mapped(text, "ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz")
}

pub fn upper(text: str) -> str {
    return mapped(text, "abcdefghijklmnopqrstuvwxyz", "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
}

/// Whether two runs of text are the same ignoring ASCII case, which is what a
/// header name or a flag is compared with.
pub fn equal_ignoring_case(left: str, right: str) -> bool {
    return lower(left) == lower(right)
}

fn mapped(text: str, from: str, to: str) -> str {
    var out = ""
    for i in 0..text.len() {
        let c = text.slice(i, i + 1)
        let at = from.index_of(c)
        if at >= 0 {
            out = out + to.slice(at, at + 1)
        } else {
            out = out + c
        }
    }
    return out
}

/// `text` at least `width` long, padded on the left with `with`. Numbers in a
/// column need this often enough to belong here rather than in `std/fmt`,
/// which is about laying out a whole line.
pub fn pad_start(text: str, width: int, with: str) -> str {
    if with.len() == 0 {
        return text
    }
    var out = text
    for out.len() < width {
        out = with + out
    }
    return out
}

// ---- ordering ---------------------------------------------------------------
//
// Sorting takes a comparison rather than requiring an `Ord` implementation.
// Kite has no associated types and no operator overloading, so a comparison
// written at the call site is both the simplest thing that works and the one
// that reads: `sorted(people, |a, b| a.age < b.age)` says what order it is in.

/// `items` in the order `less` puts them, which is stable: two items `less`
/// does not separate keep the order they were given in.
///
/// Merge sort rather than quicksort, because stability is worth more than the
/// constant factor for the sizes application code sorts, and because a
/// quicksort's worst case is a sorted input, which application code has a lot
/// of.
pub fn sorted<T>(items: [T], less: fn(T, T) -> bool) -> [T] {
    if items.len() <= 1 {
        return items
    }
    let middle = items.len() / 2
    let left = sorted(take(items, middle), less)
    let right = sorted(drop(items, middle), less)
    return merge(left, right, less)
}

fn merge<T>(left: [T], right: [T], less: fn(T, T) -> bool) -> [T] {
    var out: [T] = []
    var i = 0
    var j = 0
    for i < left.len() {
        if j >= right.len() {
            out.push(left[i])
            i += 1
        } else {
            // `less(right, left)` rather than `!less(left, right)`: an item
            // the comparison does not separate goes left, which is what makes
            // this stable.
            if less(right[j], left[i]) {
                out.push(right[j])
                j += 1
            } else {
                out.push(left[i])
                i += 1
            }
        }
    }
    for j < right.len() {
        out.push(right[j])
        j += 1
    }
    return out
}

/// The item `less` puts first, or nil for an empty slice.
pub fn min_by<T>(items: [T], less: fn(T, T) -> bool) -> Option<T> {
    if items.len() == 0 {
        return nil
    }
    var best = items[0]
    for item in items {
        if less(item, best) {
            best = item
        }
    }
    return best
}

pub fn max_by<T>(items: [T], less: fn(T, T) -> bool) -> Option<T> {
    if items.len() == 0 {
        return nil
    }
    var best = items[0]
    for item in items {
        if less(best, item) {
            best = item
        }
    }
    return best
}

// ---- more slices ------------------------------------------------------------

/// Pairs, up to the length of the shorter side.
pub fn zip<A, B>(left: [A], right: [B]) -> [(A, B)] {
    var out: [(A, B)] = []
    for i in 0..min(left.len(), right.len()) {
        out.push((left[i], right[i]))
    }
    return out
}

/// One slice out of many.
pub fn flatten<T>(groups: [[T]]) -> [T] {
    var out: [T] = []
    for group in groups {
        for item in group {
            out.push(item)
        }
    }
    return out
}

/// The first position `test` accepts, or -1. A position rather than an
/// optional, because -1 is what a caller compares against and an optional
/// would need unwrapping before it could be used as an index anyway.
pub fn position<T>(items: [T], test: fn(T) -> bool) -> int {
    for i in 0..items.len() {
        if test(items[i]) {
            return i
        }
    }
    return -1
}

/// Whether `items` holds something equal to `wanted`.
pub fn includes<T>(items: [T], wanted: T) -> bool {
    for item in items {
        if item == wanted {
            return true
        }
    }
    return false
}

/// `items` with later duplicates removed, keeping the first of each.
pub fn unique<T>(items: [T]) -> [T] {
    var out: [T] = []
    for item in items {
        if !includes(out, item) {
            out.push(item)
        }
    }
    return out
}

/// `items` in groups of at most `size`. The last group is whatever is left.
pub fn chunked<T>(items: [T], size: int) -> [[T]] {
    var out: [[T]] = []
    if size <= 0 {
        return out
    }
    var group: [T] = []
    for item in items {
        group.push(item)
        if group.len() == size {
            out.push(group)
            group = []
        }
    }
    if group.len() > 0 {
        out.push(group)
    }
    return out
}
