// std/toml — reading and writing TOML.
//
// Written in Kite, on the same shape as `std/json`: a parse returns
// `(Toml, error)`, and a malformed document is a value to handle rather than
// something thrown. Positions are threaded through as `(value, next)` pairs
// instead of a cursor with a `var` field, so a parse cannot be left
// half-advanced by an early return.
//
// **The subset is named rather than implied.** What is here is what a
// configuration file uses and what `kite.toml` needs:
//
//   * comments, to end of line
//   * bare and quoted keys, and dotted keys — `a.b.c = 1`
//   * `[table]` and `[a.b]` headers, and `[[array.of.tables]]`, which emit
//     back out in the same form they were read
//   * basic strings with the standard escapes including `\uXXXX` and
//     `\UXXXXXXXX`, and literal `'…'` strings
//   * multi-line `"""…"""` and `'''…'''` strings
//   * integers, including `+`/`-` signs, `_` separators, and hexadecimal,
//     octal and binary — `0xDEAD_BEEF`, `0o755`, `0b1101`
//   * floats, including exponents, each the float nearest what was written.
//     `inf` and `nan` are refused: Kite has no literal for either, and
//     dividing to reach one is a trap
//   * booleans
//   * arrays, which may span lines and may hold anything
//   * inline tables — `{ a = 1, b = 2 }`
//
// The rules about how a table comes to exist are TOML 1.0's too: a header
// defines a table once, dotted keys cannot reopen a table a header defined,
// and an inline table or an array written as a value is closed to anything
// added later. `[a.b]` after `[[a]]` is a table in the last element of `a`.
// A document breaking one of these is refused rather than merged.
//
// What is **not** here, and would be wrong to guess at: dates and times.
// TOML's offset date-time, local date-time, date and time are four distinct
// types, and `std/time` has none of them — it counts milliseconds since the
// epoch and breaks them into a `time.Civil` — so how the four map onto it is
// a decision about `std/time`'s surface rather than about parsing, and it is
// left undone rather than half-done. A date in a document parses as the
// string it was written as, which is lossless and honest, and is stated here
// so nobody discovers it from a wrong answer.

use std/errors
use std/math

/// A TOML value.
///
/// Recursive with no boxing annotation, because every Kite aggregate is
/// already a GC reference.
pub enum Toml {
    Bool(bool)
    Int(int)
    Float(float)
    Text(str)
    Array([Toml])
    Table({ str: Toml })
}

/// A value and where it ended.
struct Step {
    value: Toml
    next: int
}

/// A string and where it ended.
struct Text {
    text: str
    next: int
}

/// A key path — `a.b.c` is three segments — and where it ended.
struct Key {
    path: [str]
    next: int
}

/// A table header: where it points, whether it was `[[doubled]]`, and where
/// the line ended.
struct Header {
    path: [str]
    repeated: bool
    next: int
}

// ---- reading ---------------------------------------------------------------

/// The table a document holds, or an error saying where it went wrong.
///
/// The top level of a TOML document is always a table, which is the one way it
/// differs from JSON at the root.
pub fn parse(input: str) -> (Toml, error) {
    var root: { str: Toml } = { }
    // The table that bare `key = value` lines currently belong to. `[a.b]`
    // moves it; the top of the document starts at the root. When the path
    // passes through an array of tables it means that array's last element,
    // which is what [`change`] and [`spots`] both read it as.
    var section: [str] = []
    // What the parser knows about how each table came to exist, by the id
    // [`spots`] gives it — `defined()` and `closed()` — and the tables dotted
    // keys created or passed through in the current section, which become
    // defined when it ends.
    var flags: { str: int } = { }
    var pending: [str] = []
    var at = 0
    for {
        at = skip_blank(input, at)
        if at >= input.len() {
            break
        }
        let c = input.slice(at, at + 1)
        if c == "[" {
            let (header, err) = parse_header(input, at)
            check err
            at = header.next
            // A table dotted keys made is defined by them, and a header may
            // not define it again — not even one naming it from elsewhere.
            for id in pending {
                flags[id] = flag_of(flags, id) | defined()
            }
            pending = []
            let where = spots(root, header.path, flags)
            let allowed = header_allowed(where, header, flags)
            check allowed
            let op = if header.repeated { push_op() } else { open_op() }
            let (changed, change_err) = change(root, header.path, 0, op, Toml.Bool(false))
            check change_err
            root = changed
            if !header.repeated {
                let target = where[where.len() - 1]
                flags[target.inner] = flag_of(flags, target.inner) | defined()
            }
            section = header.path
            continue
        }
        let (key, key_err) = parse_key(input, at)
        check key_err
        let eq = skip_inline(input, key.next)
        if eq >= input.len() || input.slice(eq, eq + 1) != "=" {
            return _, errors.new("toml: expected `=` at \(eq)")
        }
        let (step, value_err) = parse_value(input, skip_inline(input, eq + 1))
        check value_err
        let full = concat(section, key.path)
        let where = spots(root, full, flags)
        let allowed = assignment_allowed(where, section.len(), flags)
        check allowed
        let (placed, place_err) = change(root, full, 0, set_op(), step.value)
        check place_err
        root = placed
        let last = full.len() - 1
        let first = section.len()
        for k in first..last {
            pending.push(where[k].inner)
        }
        if is_closed_value(step.value) {
            flags[where[last].id] = closed()
        }
        at = step.next
        let (after, line_err) = end_of_line(input, at)
        check line_err
        at = after
    }
    return Toml.Table(root), nil
}

/// A `[table]` or `[[array of tables]]` header, and which of the two it was.
fn parse_header(input: str, at: int) -> (Header, error) {
    let doubled = at + 1 < input.len() && input.slice(at + 1, at + 2) == "["
    let opens = if doubled { 2 } else { 1 }
    let (key, err) = parse_key(input, skip_inline(input, at + opens))
    check err
    var close = skip_inline(input, key.next)
    for k in 0..opens {
        if close >= input.len() || input.slice(close, close + 1) != "]" {
            return _, errors.new("toml: expected `]` at \(close)")
        }
        close = close + 1
    }
    let (after, line_err) = end_of_line(input, close)
    check line_err
    return Header{ path: key.path, repeated: doubled, next: after }, nil
}

/// A key: bare, quoted, or dotted segments of either.
fn parse_key(input: str, at: int) -> (Key, error) {
    var path: [str] = []
    var i = at
    for {
        i = skip_inline(input, i)
        if i >= input.len() {
            return _, errors.new("toml: expected a key at \(i)")
        }
        let c = input.slice(i, i + 1)
        if c == "\"" || c == "'" {
            if i + 3 <= input.len() && input.slice(i, i + 3) == c + c + c {
                return _, errors.new("toml: a multi-line string cannot be a key, at \(i)")
            }
            let (text, err) = parse_string(input, i)
            check err
            path.push(text.text)
            i = text.next
        } else {
            var name = ""
            for {
                if i >= input.len() {
                    break
                }
                let ch = input.slice(i, i + 1)
                if is_bare(ch) {
                    name = name + ch
                    i = i + 1
                } else {
                    break
                }
            }
            if name.len() == 0 {
                return _, errors.new("toml: expected a key at \(i)")
            }
            path.push(name)
        }
        let next = skip_inline(input, i)
        if next < input.len() && input.slice(next, next + 1) == "." {
            i = next + 1
            continue
        }
        return Key{ path: path, next: i }, nil
    }
}

fn parse_value(input: str, at: int) -> (Step, error) {
    if at >= input.len() {
        return _, errors.new("toml: expected a value at \(at)")
    }
    let c = input.slice(at, at + 1)
    if c == "\"" || c == "'" {
        let (text, err) = parse_string(input, at)
        check err
        return Step{ value: Toml.Text(text.text), next: text.next }, nil
    }
    if c == "[" {
        return parse_array(input, at)
    }
    if c == "{" {
        return parse_inline_table(input, at)
    }
    return parse_scalar(input, at)
}

/// A basic `"…"`, literal `'…'`, or either of their multi-line forms.
fn parse_string(input: str, at: int) -> (Text, error) {
    let quote = input.slice(at, at + 1)
    let triple = quote + quote + quote
    if at + 3 <= input.len() && input.slice(at, at + 3) == triple {
        return parse_multiline(input, at + 3, triple, quote == "\"")
    }
    var out = ""
    var i = at + 1
    for {
        if i >= input.len() {
            return _, errors.new("toml: unterminated string at \(at)")
        }
        let c = input.slice(i, i + 1)
        if c == quote {
            return Text{ text: out, next: i + 1 }, nil
        }
        // A literal string has no escapes at all — that is its whole purpose,
        // and it is why Windows paths go in one.
        if c == "\\" && quote == "\"" {
            let (piece, err) = parse_escape(input, i)
            check err
            out = out + piece.text
            i = piece.next
            continue
        }
        if c == "\n" {
            return _, errors.new("toml: newline in a single-line string at \(i)")
        }
        if is_control(input.code_at(i)) {
            return _, errors.new("toml: a control character in a string must be escaped, at \(i)")
        }
        out = out + c
        i = i + 1
    }
}

/// A control character TOML forbids raw inside a string: everything below a
/// space but the tab, and DEL. A multi-line string's line breaks are allowed
/// by its own reader before this is asked.
fn is_control(code: int) -> bool {
    return (code < 32 && code != 9) || code == 127
}

fn parse_multiline(input: str, at: int, closing: str, escapes: bool) -> (Text, error) {
    var out = ""
    var i = at
    // A newline immediately after the opening delimiter is trimmed, which is
    // what lets the content start on its own line — `\r\n` as much as `\n`,
    // or a file saved on Windows keeps a carriage return at the front.
    if i < input.len() && input.slice(i, i + 1) == "\n" {
        i = i + 1
    } else if i + 2 <= input.len() && input.slice(i, i + 2) == "\r\n" {
        i = i + 2
    }
    let quote = closing.slice(0, 1)
    for {
        if i >= input.len() {
            return _, errors.new("toml: unterminated multi-line string at \(at)")
        }
        if i + 3 <= input.len() && input.slice(i, i + 3) == closing {
            // One or two quotes may end the content right against the
            // delimiter: `"""x""""` is `x"`. Taking the first three as the
            // close refused a valid document over the fourth.
            var extra = 0
            for extra < 2 && i + 3 + extra < input.len() && input.slice(i + 3 + extra, i + 4 + extra) == quote {
                extra += 1
            }
            for k in 0..extra {
                out = out + quote
            }
            return Text{ text: out, next: i + 3 + extra }, nil
        }
        let c = input.slice(i, i + 1)
        if c == "\\" && escapes {
            // A backslash at the end of a line swallows the line break and the
            // whitespace after it, which is how a long string is wrapped in the
            // source without wrapping in the value.
            let peek = i + 1
            if peek < input.len() && is_line_fold(input, peek) {
                i = skip_blank(input, peek)
                continue
            }
            let (piece, err) = parse_escape(input, i)
            check err
            out = out + piece.text
            i = piece.next
            continue
        }
        let code = input.code_at(i)
        if code == 13 && !is_crlf(input, i) {
            return _, errors.new("toml: a carriage return not ending a line, at \(i)")
        }
        if code != 10 && code != 13 && is_control(code) {
            return _, errors.new("toml: a control character in a string must be escaped, at \(i)")
        }
        out = out + c
        i = i + 1
    }
}

/// Whether what follows a backslash is only whitespace up to a line break,
/// which is `\n` or `\r\n`: a lone carriage return is not whitespace.
fn is_line_fold(input: str, at: int) -> bool {
    var i = at
    for {
        if i >= input.len() {
            return false
        }
        let c = input.slice(i, i + 1)
        if c == "\n" || is_crlf(input, i) {
            return true
        }
        if c != " " && c != "\t" {
            return false
        }
        i = i + 1
    }
}

fn parse_escape(input: str, at: int) -> (Text, error) {
    if at + 1 >= input.len() {
        return _, errors.new("toml: trailing escape at \(at)")
    }
    let c = input.slice(at + 1, at + 2)
    if c == "n" {
        return Text{ text: "\n", next: at + 2 }, nil
    }
    if c == "t" {
        return Text{ text: "\t", next: at + 2 }, nil
    }
    if c == "r" {
        return Text{ text: "\r", next: at + 2 }, nil
    }
    if c == "\"" {
        return Text{ text: "\"", next: at + 2 }, nil
    }
    if c == "\\" {
        return Text{ text: "\\", next: at + 2 }, nil
    }
    if c == "b" {
        return Text{ text: "\u{8}", next: at + 2 }, nil
    }
    if c == "f" {
        return Text{ text: "\u{c}", next: at + 2 }, nil
    }
    if c == "u" || c == "U" {
        // `\uXXXX` is four hex digits, `\UXXXXXXXX` is eight.
        let width = if c == "u" { 4 } else { 8 }
        let from = at + 2
        if from + width > input.len() {
            return _, errors.new("toml: short unicode escape at \(at)")
        }
        var code = 0
        for k in 0..width {
            let digit = hex_of(input.slice(from + k, from + k + 1))
            if digit < 0 {
                return _, errors.new("toml: bad unicode escape at \(at)")
            }
            code = code * 16 + digit
        }
        let ch = text.from_code(code)
        // A surrogate or a value past the end of Unicode is not a character,
        // and `from_code` says so by answering with nothing. Passing that
        // through would silently drop the escape.
        if ch.len() == 0 {
            return _, errors.new("toml: `\(code)` is not a character, at \(at)")
        }
        return Text{ text: ch, next: from + width }, nil
    }
    return _, errors.new("toml: unknown escape `\\\(c)` at \(at)")
}

fn parse_array(input: str, at: int) -> (Step, error) {
    var items: [Toml] = []
    var i = skip_blank(input, at + 1)
    for {
        if i >= input.len() {
            return _, errors.new("toml: unterminated array at \(at)")
        }
        if input.slice(i, i + 1) == "]" {
            return Step{ value: Toml.Array(items), next: i + 1 }, nil
        }
        let (step, err) = parse_value(input, i)
        check err
        items.push(step.value)
        i = skip_blank(input, step.next)
        if i < input.len() && input.slice(i, i + 1) == "," {
            i = skip_blank(input, i + 1)
            continue
        }
        if i < input.len() && input.slice(i, i + 1) == "]" {
            return Step{ value: Toml.Array(items), next: i + 1 }, nil
        }
        return _, errors.new("toml: expected `,` or `]` at \(i)")
    }
}

fn parse_inline_table(input: str, at: int) -> (Step, error) {
    var table: { str: Toml } = { }
    // An inline table is its own little document: `{ a = { b = 1 }, a.c = 2 }`
    // extends a closed table just as a later line would.
    var flags: { str: int } = { }
    var i = skip_inline(input, at + 1)
    if i < input.len() && input.slice(i, i + 1) == "}" {
        return Step{ value: Toml.Table(table), next: i + 1 }, nil
    }
    for {
        let (key, key_err) = parse_key(input, i)
        check key_err
        let eq = skip_inline(input, key.next)
        if eq >= input.len() || input.slice(eq, eq + 1) != "=" {
            return _, errors.new("toml: expected `=` at \(eq)")
        }
        let (step, err) = parse_value(input, skip_inline(input, eq + 1))
        check err
        let where = spots(table, key.path, flags)
        let allowed = assignment_allowed(where, 0, flags)
        check allowed
        let (placed, place_err) = change(table, key.path, 0, set_op(), step.value)
        check place_err
        table = placed
        if is_closed_value(step.value) {
            flags[where[where.len() - 1].id] = closed()
        }
        i = skip_inline(input, step.next)
        if i < input.len() && input.slice(i, i + 1) == "," {
            i = skip_inline(input, i + 1)
            continue
        }
        if i < input.len() && input.slice(i, i + 1) == "}" {
            return Step{ value: Toml.Table(table), next: i + 1 }, nil
        }
        return _, errors.new("toml: expected `,` or `}` at \(i)")
    }
}

/// A bare word: a boolean, a number, or something this subset does not read.
///
/// The word runs to whatever may follow a value, and a space inside it is
/// kept, since `1979-05-27 07:32:00` is one date-time. Only spaces and tabs are
/// trimmed from its ends. `trim()` takes every kind of whitespace, and taking
/// a carriage return let `a = \r1` and `[1\r]` read as numbers.
fn parse_scalar(input: str, at: int) -> (Step, error) {
    var word = ""
    var i = at
    for {
        if i >= input.len() {
            break
        }
        let c = input.slice(i, i + 1)
        if c == "\n" || is_crlf(input, i) || c == "," || c == "]" || c == "}" || c == "#" {
            break
        }
        // Said here rather than as "`\r1` is not a number", which prints the
        // carriage return and so hides it.
        if is_control(input.code_at(i)) {
            return _, errors.new("toml: unexpected control character at \(i)")
        }
        word = word + c
        i = i + 1
    }
    let body = trim_blank(word)
    if body.len() == 0 {
        return _, errors.new("toml: expected a value at \(at)")
    }
    if body == "true" {
        return Step{ value: Toml.Bool(true), next: i }, nil
    }
    if body == "false" {
        return Step{ value: Toml.Bool(false), next: i }, nil
    }
    // A date or a time is recognised well enough to be kept as text rather
    // than misread as a number: `1979-05-27` is not the integer 1979.
    if looks_like_date(body) {
        if !is_date_time(body) {
            return _, errors.new("toml: `\(body)` is not a date or a time TOML can write")
        }
        return Step{ value: Toml.Text(body), next: i }, nil
    }
    let (number, err) = parse_number(body)
    check err
    return Step{ value: number, next: i }, nil
}

// ---- placing values in tables -----------------------------------------------

/// The table a value holds, or an empty one.
///
/// A `match` in expression position cannot answer this: the arms that are not
/// tables would each need an empty map literal, and `{ }` in an arm is a block.
/// So it is a statement, once, here — which is better anyway, because the five
/// dead arms were repeated at every site that asked.
fn as_table(value: Toml) -> { str: Toml } {
    var out: { str: Toml } = { }
    match value {
        Table(t) => { out = t }
        Bool(b) => { }
        Int(n) => { }
        Float(f) => { }
        Text(s) => { }
        Array(a) => { }
    }
    return out
}

/// The array a value holds, or nil for anything else.
fn as_array(value: Toml) -> Option<[Toml]> {
    var out: Option<[Toml]> = nil
    match value {
        Array(a) => { out = a }
        Table(t) => { }
        Bool(b) => { }
        Int(n) => { }
        Float(f) => { }
        Text(s) => { }
    }
    return out
}

/// Whether a value is a non-empty array of tables, which is the one shape that
/// has a header syntax of its own.
///
/// An *empty* array is deliberately not one: there would be no header to
/// write, and `k = []` is the only way to say it at all.
fn all_tables(value: Toml) -> bool {
    let items = as_array(value)
    if items == nil {
        return false
    }
    if items.len() == 0 {
        return false
    }
    for item in items {
        if !is_table(item) {
            return false
        }
    }
    return true
}

fn is_table(value: Toml) -> bool {
    var out = false
    match value {
        Table(t) => { out = true }
        Bool(b) => { }
        Int(n) => { }
        Float(f) => { }
        Text(s) => { }
        Array(a) => { }
    }
    return out
}

/// What a table's id may carry in `flags`.
///
/// **Defined**: a header named it, or dotted keys made or passed through it in
/// a section that has ended. A header may not name it again, and dotted keys
/// may not add to it.
fn defined() -> int {
    return 1
}

/// **Closed**: an inline table or an array written as a value. Nothing is
/// added to it afterwards, by a header or by a dotted key.
fn closed() -> int {
    return 2
}

fn flag_of(flags: { str: int }, id: str) -> int {
    let found = flags[id]
    if found == nil {
        return 0
    }
    return found
}

fn has(flags: { str: int }, id: str, flag: int) -> bool {
    return (flag_of(flags, id) & flag) != 0
}

fn is_closed_value(value: Toml) -> bool {
    return is_table(value) || as_array(value) != nil
}

/// One step of a path through the document as it stands.
///
/// `id` names the key — the path so far, each segment prefixed by its length,
/// so no two paths share one — and `inner` the table a walk continues into:
/// the key's own table, or for an array of tables its last element, whose id
/// carries its index. So `[fruit.physical]` under the second `[[fruit]]` is a
/// different table from the one under the first, as it should be.
struct Spot {
    name: str
    id: str
    inner: str
    kind: int
}

/// Nothing there yet.
fn absent() -> int {
    return 0
}

fn a_table() -> int {
    return 1
}

fn tables() -> int {
    return 2
}

/// A value, or a closed inline table or array.
fn a_value() -> int {
    return 3
}

/// Where each segment of `path` leads, read without changing anything.
fn spots(root: { str: Toml }, path: [str], flags: { str: int }) -> [Spot] {
    var out: [Spot] = []
    var here = root
    var id = ""
    var walking = true
    for segment in path {
        let key = id + "/\(segment.len()):" + segment
        id = key
        if !walking {
            out.push(Spot{ name: segment, id: key, inner: key, kind: absent() })
            continue
        }
        let held = here[segment]
        if held == nil {
            walking = false
            out.push(Spot{ name: segment, id: key, inner: key, kind: absent() })
            continue
        }
        if has(flags, key, closed()) {
            walking = false
            out.push(Spot{ name: segment, id: key, inner: key, kind: a_value() })
            continue
        }
        if is_table(held) {
            here = as_table(held)
            out.push(Spot{ name: segment, id: key, inner: key, kind: a_table() })
            continue
        }
        let items = as_array(held)
        if items != nil {
            if items.len() > 0 {
                // An array that is not closed is one `[[…]]` made.
                let inner = key + "#\(items.len() - 1)"
                here = as_table(items[items.len() - 1])
                id = inner
                out.push(Spot{ name: segment, id: key, inner: inner, kind: tables() })
                continue
            }
        }
        walking = false
        out.push(Spot{ name: segment, id: key, inner: key, kind: a_value() })
    }
    return out
}

/// Whether a header may name the path `where` describes.
///
/// Every table along the way may be walked through, whoever made it — the
/// specification's own example adds `[fruit.apple.texture]` under a table
/// dotted keys defined. Only the last segment is being defined, so only it is
/// held to "once".
fn header_allowed(where: [Spot], header: Header, flags: { str: int }) -> error {
    let name = join_dots(header.path)
    let last = where.len() - 1
    for k in 0..last {
        if where[k].kind == a_value() {
            return errors.new("toml: `\(join_dots(take(header.path, k + 1)))` is already a value, not a table")
        }
    }
    let target = where[last]
    if header.repeated {
        if target.kind == a_table() {
            return errors.new("toml: `\(name)` is a table, not an array of tables")
        }
        if target.kind == a_value() {
            return errors.new("toml: `\(name)` is already a value; an array written with `[…]` cannot be appended to")
        }
        return nil
    }
    if target.kind == tables() {
        return errors.new("toml: `\(name)` is an array of tables, not a table")
    }
    if target.kind == a_value() {
        return errors.new("toml: `\(name)` is already a value, not a table")
    }
    if target.kind == a_table() && has(flags, target.inner, defined()) {
        return errors.new("toml: `[\(name)]` defines a table that is already defined")
    }
    return nil
}

/// Whether `key = value` may be placed where `where` describes, the first
/// `section` segments being the current header's.
///
/// The tables a dotted key passes through are being added to, so each must be
/// one dotted keys may add to: not a value, not an array of tables, and not a
/// table a header — or dotted keys in an earlier section — already defined.
fn assignment_allowed(where: [Spot], section: int, flags: { str: int }) -> error {
    let last = where.len() - 1
    for k in section..last {
        let spot = where[k]
        if spot.kind == a_table() && has(flags, spot.inner, defined()) {
            return errors.new("toml: `\(spot.name)` is a table defined already; a dotted key cannot add to it")
        }
        if spot.kind == a_value() {
            return errors.new("toml: `\(spot.name)` is already a value, not a table")
        }
        if spot.kind == tables() {
            return errors.new("toml: `\(spot.name)` is an array of tables; a dotted key cannot add to it")
        }
    }
    if where[last].kind != absent() {
        return errors.new("toml: `\(where[last].name)` is set twice")
    }
    return nil
}

fn open_op() -> int {
    return 0
}

fn push_op() -> int {
    return 1
}

fn set_op() -> int {
    return 2
}

/// `here` with the path from `path[at]` on changed: a table made to exist
/// (`open_op`), a fresh element appended to an array of tables (`push_op`),
/// or `value` set (`set_op`). Tables that are not there yet are created on
/// the way, and a walk through an array of tables goes into its last element.
///
/// A map is a value, so each table on the way is rebuilt and put back into
/// the one above it. What is allowed was decided by [`spots`] beforehand; the
/// errors here are for a shape that should have been refused already.
fn change(here: { str: Toml }, path: [str], at: int, op: int, value: Toml) -> ({ str: Toml }, error) {
    var table = here
    let key = path[at]
    let held = table[key]
    if at == path.len() - 1 {
        if op == open_op() {
            if held == nil {
                table[key] = Toml.Table({ })
            }
            return table, nil
        }
        if op == push_op() {
            var items: [Toml] = []
            if held != nil {
                let existing = as_array(held)
                if existing == nil {
                    return _, errors.new("toml: `\(key)` is already a value, not an array of tables")
                }
                items = existing
            }
            items.push(Toml.Table({ }))
            table[key] = Toml.Array(items)
            return table, nil
        }
        if held != nil {
            return _, errors.new("toml: `\(key)` is set twice")
        }
        table[key] = value
        return table, nil
    }
    var inner: { str: Toml } = { }
    if held != nil {
        let into = walk_into(held)
        if into == nil {
            return _, errors.new("toml: `\(key)` is already a value, not a table")
        }
        inner = into
    }
    let (filled, err) = change(inner, path, at + 1, op, value)
    check err
    if held == nil {
        table[key] = Toml.Table(filled)
    } else {
        table[key] = put_back(held, filled)
    }
    return table, nil
}

/// The table a walk continues into from `held`: a table itself, or the last
/// element of an array of tables. Nil for anything else.
fn walk_into(held: Toml) -> Option<{ str: Toml }> {
    if is_table(held) {
        return as_table(held)
    }
    let items = as_array(held)
    if items != nil {
        if items.len() > 0 && is_table(items[items.len() - 1]) {
            return as_table(items[items.len() - 1])
        }
    }
    return nil
}

/// `held` with `inner` put back where [`walk_into`] found it.
fn put_back(held: Toml, inner: { str: Toml }) -> Toml {
    let items = as_array(held)
    if items != nil {
        if items.len() > 0 {
            var elements = items
            elements[elements.len() - 1] = Toml.Table(inner)
            return Toml.Array(elements)
        }
    }
    return Toml.Table(inner)
}

// ---- reading a document ------------------------------------------------------

/// The value at a dotted path, or nil.
///
/// `toml.at(doc, "package.name")` rather than three lookups and two matches,
/// because reading a configuration file is the thing this module is for.
pub fn at(doc: Toml, path: str) -> Option<Toml> {
    var here = doc
    for segment in split_dots(path) {
        let table = as_table(here)
        let next = table[segment]
        if next == nil {
            return nil
        }
        here = next
    }
    return here
}

/// The string at a path, or `fallback` if it is absent or is not a string.
pub fn text_at(doc: Toml, path: str, fallback: str) -> str {
    let found = at(doc, path)
    if found == nil {
        return fallback
    }
    return match found {
        Text(s) => s
        Bool(b) => fallback
        Int(n) => fallback
        Float(f) => fallback
        Array(a) => fallback
        Table(t) => fallback
    }
}

/// The integer at a path, or `fallback`.
pub fn int_at(doc: Toml, path: str, fallback: int) -> int {
    let found = at(doc, path)
    if found == nil {
        return fallback
    }
    return match found {
        Int(n) => n
        Text(s) => fallback
        Bool(b) => fallback
        Float(f) => fallback
        Array(a) => fallback
        Table(t) => fallback
    }
}

/// The float at a path, or `fallback`.
///
/// An integer answers too. TOML distinguishes `1` from `1.0` and a caller
/// asking for a float has already said which it wants, so refusing to widen
/// would fail on a configuration that simply wrote a round number.
pub fn float_at(doc: Toml, path: str, fallback: float) -> float {
    let found = at(doc, path)
    if found == nil {
        return fallback
    }
    return match found {
        Float(f) => f
        Int(n) => n as float
        Text(s) => fallback
        Bool(b) => fallback
        Array(a) => fallback
        Table(t) => fallback
    }
}

/// The boolean at a path, or `fallback`.
pub fn bool_at(doc: Toml, path: str, fallback: bool) -> bool {
    let found = at(doc, path)
    if found == nil {
        return fallback
    }
    return match found {
        Bool(b) => b
        Text(s) => fallback
        Int(n) => fallback
        Float(f) => fallback
        Array(a) => fallback
        Table(t) => fallback
    }
}

fn split_dots(path: str) -> [str] {
    var out: [str] = []
    var current = ""
    for i in 0..path.len() {
        let c = path.slice(i, i + 1)
        if c == "." {
            out.push(current)
            current = ""
        } else {
            current = current + c
        }
    }
    out.push(current)
    return out
}

// ---- writing ----------------------------------------------------------------

/// A document, written back out.
///
/// Scalars first and tables afterwards, which is not a style preference: a
/// key written after a `[table]` header belongs to that table, so a top-level
/// key emitted after one would be read back into the wrong place. Emitting in
/// this order is what makes `parse(emit(doc))` give back `doc`.
pub fn emit(doc: Toml) -> str {
    return emit_section(as_table(doc), [], "")
}

/// A table under its header: its own keys, then each sub-table under a
/// `[header]` of its own, and each array of tables as one `[[header]]` per
/// element — every element in full, sub-tables and nested arrays included.
///
/// An element's tables used to be skipped, so `[[a]]` with `b = { c = 1 }`
/// or `b.c = 1` in it emitted as a bare `[[a]]` and the data was gone. Under
/// `[[a]]`, `[a.b]` means the last `a`'s `b`, so an element's sub-tables are
/// written after it with the full path and read back into it.
fn emit_section(table: { str: Toml }, path: [str], header: str) -> str {
    var out = header
    // Scalars.
    for key in keys_of(table) {
        let held = table[key]
        if held != nil {
            if !is_table(held) && !all_tables(held) {
                out = out + "\(emit_key(key)) = \(emit_value(held))\n"
            }
        }
    }
    // Then the sub-tables, each with its own header, and the arrays of tables,
    // each element with a `[[doubled]]` one.
    for key in keys_of(table) {
        let held = table[key]
        if held != nil {
            let inner = concat(path, [key])
            if is_table(held) {
                out = out + "\n" + emit_section(as_table(held), inner, "[\(join_dots(inner))]\n")
            } else if all_tables(held) {
                let items = as_array(held)
                if items != nil {
                    for element in items {
                        out = out + "\n" + emit_section(as_table(element), inner, "[[\(join_dots(inner))]]\n")
                    }
                }
            }
        }
    }
    return out
}

/// The keys of a table, in insertion order — which the specification
/// guarantees for a map, so a document read and written again keeps its order.
fn keys_of(table: { str: Toml }) -> [str] {
    var out: [str] = []
    for (key, value) in table {
        out.push(key)
    }
    return out
}

fn join_dots(path: [str]) -> str {
    var out = ""
    for i in 0..path.len() {
        if i > 0 {
            out = out + "."
        }
        out = out + emit_key(path[i])
    }
    return out
}

/// A key, quoted only when it has to be.
fn emit_key(key: str) -> str {
    var bare = key.len() > 0
    for i in 0..key.len() {
        if !is_bare(key.slice(i, i + 1)) {
            bare = false
        }
    }
    if bare {
        return key
    }
    return emit_string(key)
}

fn emit_value(value: Toml) -> str {
    return match value {
        Bool(b) => if b { "true" } else { "false" }
        Int(n) => "\(n)"
        Float(f) => "\(f)"
        Text(s) => emit_string(s)
        Array(items) => emit_array(items)
        Table(t) => emit_inline(t)
    }
}

fn emit_array(items: [Toml]) -> str {
    var out = "["
    for i in 0..items.len() {
        if i > 0 {
            out = out + ", "
        }
        out = out + emit_value(items[i])
    }
    return out + "]"
}

/// A table nested inside a value position has to be inline — a header would
/// change what the keys after it belong to.
fn emit_inline(table: { str: Toml }) -> str {
    var out = "{ "
    var first = true
    for (key, held) in table {
        if !first {
            out = out + ", "
        }
        out = out + "\(emit_key(key)) = \(emit_value(held))"
        first = false
    }
    return out + " }"
}

fn emit_string(body: str) -> str {
    var out = "\""
    for i in 0..body.len() {
        let c = body.slice(i, i + 1)
        if c == "\"" {
            out = out + "\\\""
        } else if c == "\\" {
            out = out + "\\\\"
        } else if c == "\n" {
            out = out + "\\n"
        } else if c == "\t" {
            out = out + "\\t"
        } else if c == "\r" {
            out = out + "\\r"
        } else if is_control(c.code_at(0)) {
            // Any other control character is written as an escape: raw, it
            // is not TOML, and this module's own reader refuses it.
            out = out + "\\u" + hex4(c.code_at(0))
        } else {
            out = out + c
        }
    }
    return out + "\""
}

/// Four uppercase hex digits.
fn hex4(code: int) -> str {
    let digits = "0123456789ABCDEF"
    var out = ""
    var shift = 12
    for shift >= 0 {
        let d = (code >> shift) & 15
        out = out + digits.slice(d, d + 1)
        shift -= 4
    }
    return out
}

// ---- lexical helpers ---------------------------------------------------------

/// Whitespace on this line only, and comments. Stops at a line break.
///
/// Whitespace is a space or a tab and nothing else. A carriage return is
/// passed over only as the first half of a CRLF, which leaves the caller at
/// the `\n` it looks for either way. Skipping a lone one as whitespace let
/// `a = \r1` and `[a\r]` through, which TOML refuses.
fn skip_inline(input: str, at: int) -> int {
    var i = at
    for {
        if i >= input.len() {
            return i
        }
        let c = input.slice(i, i + 1)
        if c == " " || c == "\t" || is_crlf(input, i) {
            i = i + 1
            continue
        }
        if c == "#" {
            // A comment runs to the end of the line, and the line break itself
            // is left for the caller — it is a separator, not whitespace.
            //
            // A control character other than a tab may not appear in one. The
            // comment ends before it instead, which leaves it where the caller
            // expected a line break, and the caller reports it as unexpected.
            for {
                if i >= input.len() || input.slice(i, i + 1) == "\n" {
                    return i
                }
                if is_control(input.code_at(i)) && !is_crlf(input, i) {
                    return i
                }
                i = i + 1
            }
        }
        return i
    }
}

/// `s` without the spaces and tabs at either end, which are all TOML counts
/// as whitespace.
fn trim_blank(s: str) -> str {
    var from = 0
    var to = s.len()
    for from < to && is_blank(s.code_at(from)) {
        from += 1
    }
    for to > from && is_blank(s.code_at(to - 1)) {
        to -= 1
    }
    return s.slice(from, to)
}

fn is_blank(code: int) -> bool {
    return code == 32 || code == 9
}

/// Whether a CRLF line break starts at `i`.
fn is_crlf(input: str, i: int) -> bool {
    return i + 1 < input.len() && input.code_at(i) == 13 && input.code_at(i + 1) == 10
}

/// Whitespace, comments and line breaks alike.
fn skip_blank(input: str, at: int) -> int {
    var i = at
    for {
        let next = skip_inline(input, i)
        if next < input.len() && input.slice(next, next + 1) == "\n" {
            i = next + 1
            continue
        }
        return next
    }
}

/// Nothing but whitespace and a comment may follow a value on its line.
fn end_of_line(input: str, at: int) -> (int, error) {
    let i = skip_inline(input, at)
    if i >= input.len() {
        return i, nil
    }
    if input.slice(i, i + 1) == "\n" {
        return i + 1, nil
    }
    return _, errors.new("toml: unexpected text at \(i)")
}

fn is_bare(c: str) -> bool {
    if c.len() == 0 {
        return false
    }
    let code = c.code_at(0)
    if code >= 0x41 && code <= 0x5A {
        return true
    }
    if code >= 0x61 && code <= 0x7A {
        return true
    }
    if code >= 0x30 && code <= 0x39 {
        return true
    }
    return c == "_" || c == "-"
}

fn hex_of(c: str) -> int {
    let code = c.code_at(0)
    if code >= 0x30 && code <= 0x39 {
        return code - 0x30
    }
    if code >= 0x61 && code <= 0x66 {
        return code - 0x61 + 10
    }
    if code >= 0x41 && code <= 0x46 {
        return code - 0x41 + 10
    }
    return -1
}

fn without(body: str, drop: str) -> str {
    var out = ""
    for i in 0..body.len() {
        let c = body.slice(i, i + 1)
        if c != drop {
            out = out + c
        }
    }
    return out
}

/// Whether a bare word is a date or a time rather than a number.
///
/// A `:` anywhere is enough: no integer or float in TOML contains one. A `-`
/// after the first character usually means a date too — but not when what
/// precedes it is `e` or `E`, because that is a float's exponent sign.
///
/// Without that exception this claimed every negative exponent: `1e-5` was
/// returned as the *text* `1e-5`, so `float_at` handed back its fallback and
/// a configuration file's number silently stopped being one. It went unseen
/// because it fails quietly and because nothing tested it — every exponent in
/// the suite was positive. It also hid a second bug behind it, since an
/// exponent that never reached the number reader could not overflow it.
///
/// The exception cannot let a date through: a date is digits, `-`, `.`, `:`,
/// `+`, and `T`/`Z` in either case, so no `-` in one is ever preceded by an
/// `e`. `1979-05-27` is still a date; `1e-5` is a float.
/// Whether a word is one of TOML's four date and time forms: a date
/// `1979-05-27`, a time `07:32:00` with an optional fraction of a second, the
/// two joined by `T` or a space, and that with `Z` or an offset `-07:00`.
///
/// Checked in full, down to the calendar, because what passes is kept as text
/// and never looked at again: `2006-01-50`, `1987-7-05` and a time with no
/// seconds were all being kept as dates.
fn is_date_time(body: str) -> bool {
    let n = body.len()
    if !is_date_at(body, 0) {
        return time_end(body, 0) == n
    }
    if n == 10 {
        return true
    }
    let sep = body.slice(10, 11)
    if sep != "T" && sep != "t" && sep != " " {
        return false
    }
    let end = time_end(body, 11)
    if end < 0 {
        return false
    }
    if end == n {
        return true
    }
    let zone = body.slice(end, n)
    if zone == "Z" || zone == "z" {
        return true
    }
    if n - end != 6 || (zone.slice(0, 1) != "+" && zone.slice(0, 1) != "-") || zone.slice(3, 4) != ":" {
        return false
    }
    let hours = two_digits(zone, 1)
    let minutes = two_digits(zone, 4)
    return hours >= 0 && hours <= 23 && minutes >= 0 && minutes <= 59
}

/// Whether `yyyy-mm-dd`, a real day of a real month, starts at `at`.
fn is_date_at(body: str, at: int) -> bool {
    if body.len() < at + 10 || body.slice(at + 4, at + 5) != "-" || body.slice(at + 7, at + 8) != "-" {
        return false
    }
    let high = two_digits(body, at)
    let low = two_digits(body, at + 2)
    let month = two_digits(body, at + 5)
    let day = two_digits(body, at + 8)
    if high < 0 || low < 0 || month < 1 || month > 12 || day < 1 {
        return false
    }
    let year = high * 100 + low
    var days = 31
    if month == 4 || month == 6 || month == 9 || month == 11 {
        days = 30
    }
    if month == 2 {
        let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
        days = if leap { 29 } else { 28 }
    }
    return day <= days
}

/// Where `hh:mm:ss`, with an optional fraction, starting at `at` ends — or -1.
fn time_end(body: str, at: int) -> int {
    if body.len() < at + 8 || body.slice(at + 2, at + 3) != ":" || body.slice(at + 5, at + 6) != ":" {
        return -1
    }
    let hour = two_digits(body, at)
    let minute = two_digits(body, at + 3)
    // 60 is a leap second, which TOML's RFC 3339 allows.
    let second = two_digits(body, at + 6)
    if hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 60 {
        return -1
    }
    var i = at + 8
    if i < body.len() && body.slice(i, i + 1) == "." {
        i = i + 1
        let from = i
        for i < body.len() && digit_in(body.slice(i, i + 1), 10) >= 0 {
            i = i + 1
        }
        if i == from {
            return -1
        }
    }
    return i
}

/// Two decimal digits at `at` as a number, or -1.
fn two_digits(body: str, at: int) -> int {
    if at + 2 > body.len() {
        return -1
    }
    let tens = digit_in(body.slice(at, at + 1), 10)
    let ones = digit_in(body.slice(at + 1, at + 2), 10)
    if tens < 0 || ones < 0 {
        return -1
    }
    return tens * 10 + ones
}

fn looks_like_date(body: str) -> bool {
    for i in 0..body.len() {
        let c = body.slice(i, i + 1)
        if c == ":" {
            return true
        }
        if c == "-" && i > 0 {
            let before = body.slice(i - 1, i)
            if before != "e" && before != "E" {
                return true
            }
        }
    }
    return false
}

/// A bare word that is a number as TOML 1.0 writes one, or an error saying
/// why it is not.
///
/// The spelling is checked before anything is converted, because the rules
/// are about the spelling rather than the value: an underscore sits between
/// two digits (`1__2`, `_1` and `1_` are not numbers), a decimal integer does
/// not start with a zero (`007` is not seven), a point has digits on both
/// sides (`1.` and `.5` are not floats), and only a decimal carries a sign.
/// Each of those used to be read as the number it looked closest to.
///
/// `0x`, `0o` and `0b` are integers in base 16, 8 and 2. `0xDEADBEEF` was
/// read as a float, for the `E` in it, and refused.
fn parse_number(body: str) -> (Toml, error) {
    if body == "inf" || body == "+inf" || body == "-inf" || body == "nan" || body == "+nan" || body == "-nan" {
        // Kite has no literal for either and dividing to reach one is a trap,
        // so these are refused rather than approximated. A configuration file
        // containing them is rare; one silently holding a very large number
        // where it said `inf` would be a bug nobody could find.
        return _, errors.new("toml: `\(body)` has no value in Kite")
    }
    let n = body.len()
    if n > 2 && body.slice(0, 1) == "0" {
        let marker = body.slice(1, 2)
        if marker == "x" {
            return radix_int(body, 16)
        }
        if marker == "o" {
            return radix_int(body, 8)
        }
        if marker == "b" {
            return radix_int(body, 2)
        }
    }
    var i = 0
    if body.slice(0, 1) == "+" || body.slice(0, 1) == "-" {
        i = 1
    }
    let whole = digit_run(body, i, 10)
    if whole < 0 {
        return _, errors.new("toml: `\(body)` is not a number")
    }
    if body.slice(i, i + 1) == "0" && whole > i + 1 {
        return _, errors.new("toml: `\(body)` starts with a zero, which only `0` itself may")
    }
    var at = whole
    var is_float = false
    if at < n && body.slice(at, at + 1) == "." {
        let fraction = digit_run(body, at + 1, 10)
        if fraction < 0 {
            return _, errors.new("toml: `\(body)` needs a digit after its point")
        }
        at = fraction
        is_float = true
    }
    if at < n && (body.slice(at, at + 1) == "e" || body.slice(at, at + 1) == "E") {
        var from = at + 1
        if from < n && (body.slice(from, from + 1) == "+" || body.slice(from, from + 1) == "-") {
            from += 1
        }
        let power = digit_run(body, from, 10)
        if power < 0 {
            return _, errors.new("toml: `\(body)` needs digits in its exponent")
        }
        at = power
        is_float = true
    }
    if at != n {
        return _, errors.new("toml: `\(body)` is not a number")
    }
    var cleaned = without(body, "_")
    if cleaned.slice(0, 1) == "+" {
        cleaned = cleaned.slice(1, cleaned.len())
    }
    if is_float {
        // The prelude's reader, which `std/json` shares: the float nearest
        // the decimal written, where adding up digit values was a unit or
        // two out — `1e-7`, `0.035` and `5e-324` among them.
        let f = parse_float(cleaned)
        if f == nil {
            return _, errors.new("toml: `\(body)` is out of range for a float")
        }
        return Toml.Float(f), nil
    }
    let (value, err) = int_of(cleaned)
    check err
    return Toml.Int(value), nil
}

/// Where a run of digits in `radix` from `at` ends, single underscores allowed
/// between two digits — or -1 when there is no digit at `at` or an underscore
/// is not between two.
fn digit_run(body: str, at: int, radix: int) -> int {
    if at >= body.len() || digit_in(body.slice(at, at + 1), radix) < 0 {
        return -1
    }
    var i = at + 1
    for i < body.len() {
        let c = body.slice(i, i + 1)
        if c == "_" {
            if i + 1 >= body.len() || digit_in(body.slice(i + 1, i + 2), radix) < 0 {
                return -1
            }
            i += 2
            continue
        }
        if digit_in(c, radix) < 0 {
            return i
        }
        i += 1
    }
    return i
}

fn digit_in(c: str, radix: int) -> int {
    let d = hex_of(c)
    if d < 0 || d >= radix {
        return -1
    }
    return d
}

/// `0x…`, `0o…` or `0b…`: no sign, which TOML does not allow on these, and no
/// more than an `int` holds.
fn radix_int(body: str, radix: int) -> (Toml, error) {
    if digit_run(body, 2, radix) != body.len() {
        return _, errors.new("toml: `\(body)` is not a number")
    }
    var value = 0
    for i in 2..body.len() {
        let c = body.slice(i, i + 1)
        if c != "_" {
            let d = digit_in(c, radix)
            // `value * radix + d <= max_int()`, rearranged so asking cannot
            // overflow.
            let room = (math.max_int() - d) / radix
            if value > room {
                return _, errors.new("toml: `\(body)` does not fit in an int")
            }
            value = value * radix + d
        }
    }
    return Toml.Int(value), nil
}

fn int_of(body: str) -> (int, error) {
    if body.len() == 0 {
        return _, errors.new("toml: expected a number")
    }
    var negative = false
    var i = 0
    let first = body.slice(0, 1)
    if first == "-" {
        negative = true
        i = 1
    } else if first == "+" {
        i = 1
    }
    if i >= body.len() {
        return _, errors.new("toml: `\(body)` is not a number")
    }
    // Accumulated as a *negative* number, which is the wider half.
    //
    // Two's complement reaches one further down than up, so `min_int()` has no
    // positive counterpart: building the magnitude and negating it at the end
    // cannot represent `-9223372036854775808`, and rejected the one value that
    // only exists on this side. Counting downwards makes the range the `int`'s
    // rather than the `int`'s minus one.
    //
    // The digits are the document's, and so is how many there are. An `int`
    // multiply that overflows is a trap, and a trap is not catchable — so
    // without the guard the function that exists to *return* a parse error
    // would instead end the process. It is rearranged to stay in range:
    // computing the product to find out would be the trap. Integer division
    // truncates toward zero, so for a negative numerator this is the ceiling,
    // which is exactly the bound `value * 10 - digit >= min_int()` needs.
    var value = 0
    for {
        if i >= body.len() {
            break
        }
        let digit = body.code_at(i) - 0x30
        if digit < 0 || digit > 9 {
            return _, errors.new("toml: `\(body)` is not a number")
        }
        if value < (math.min_int() + digit) / 10 {
            return _, errors.new("toml: `\(body)` does not fit in an int")
        }
        value = value * 10 - digit
        i = i + 1
    }
    if negative {
        return value, nil
    }
    // The only magnitude that fits going down and not coming back up.
    if value == math.min_int() {
        return _, errors.new("toml: `\(body)` does not fit in an int")
    }
    return 0 - value, nil
}
