// std/fs — files and directories.
//
// Native and, in time, WASI. **Unavailable on the web**, which is not an
// oversight and not a limitation to be worked around: a page has no filesystem,
// and a shim that pretended otherwise — local storage dressed up as a disk —
// would be a different thing wearing the same name. A program that reads a file
// is a program that does not run in a browser, and it should find that out when
// it runs rather than when it silently reads nothing.
//
// Every call that can fail returns `(T, error)`. There is no exception to catch
// and no errno to inspect: what went wrong arrives as a message, in the same
// shape as everything else in this library.
//
// The host implements one object called `fs`. A runtime that does not — the
// browser — leaves it unimplemented, and a call traps with a message naming
// the function, which is the honest failure for asking a page for a file.

use std/errors

/// The host's side. Each returns a string because a `str` crosses the boundary
/// and a `(T, error)` does not: an empty first field with the reason in the
/// second is the shape, and the functions below turn it back into a pair.
@host("fs")
extern fn read_text(path: str) -> str

@host("fs")
extern fn write_text(path: str, body: str) -> str

@host("fs")
extern fn list_dir(path: str) -> str

@host("fs")
extern fn remove_path(path: str) -> str

@host("fs")
extern fn path_kind(path: str) -> int

@host("fs")
extern fn temp_path() -> str

/// How the host reports a failure: a leading `\u{1}`, then the reason.
///
/// A path, a file's contents and a directory listing are all ordinary strings,
/// and one `str` is all an `extern` carries back, so the answer is marked
/// rather than paired.
fn FAILURE_MARK() -> str {
    return "\u{1}"
}

/// How the host reports that a call which can fail did not: a leading
/// `\u{2}`, then the answer.
///
/// Marking only failures was not sound. A file may begin with any character,
/// and one beginning with U+0001 read back as an error whose message was the
/// rest of the file. With both marks, the first character of an answer is
/// always a mark and never the answer's own, so nothing a file contains can be
/// mistaken for one.
fn SUCCESS_MARK() -> str {
    return "\u{2}"
}

fn unwrap(answer: str, what: str) -> (str, error) {
    let mark = answer.slice(0, 1)
    if mark == FAILURE_MARK() {
        return _, errors.new("fs: \(what): \(answer.slice(1, answer.len()))")
    }
    if mark == SUCCESS_MARK() {
        return answer.slice(1, answer.len()), nil
    }
    // Every host this library runs on marks its answers. One that does not is
    // a host from before the success mark, and guessing which kind of answer
    // it meant is the bug the mark exists to prevent.
    return _, errors.new("fs: \(what): the host's answer carries no mark")
}

/// The whole of a file, as text.
///
/// Text, not bytes: `str` is what crosses the boundary, and a file that is not
/// valid UTF-8 is an error rather than a string of replacement characters —
/// silently substituting them is how a binary file becomes corrupt data that
/// looks fine.
pub fn read(path: str) -> (str, error) {
    return unwrap(read_text(path), "read \(path)")
}

/// Write `body` to `path`, replacing whatever was there.
///
/// The directory above it must exist. Creating parents silently is the kind of
/// convenience that writes a file where nobody meant to put one.
pub fn write(path: str, body: str) -> error {
    let (_, err) = unwrap(write_text(path, body), "write \(path)")
    return err
}

/// The names in a directory, without `.` and `..`, in the order the host gives
/// them — which is not sorted, on any platform worth relying on.
///
/// The host puts one name on each line, so a name with a line break in it
/// would have come back as two. It writes that break as a NUL instead — no
/// file name has one — and it is turned back into a line break here.
pub fn list(path: str) -> ([str], error) {
    let (answer, err) = unwrap(list_dir(path), "list \(path)")
    check err
    if answer.len() == 0 {
        return [], nil
    }
    var names: [str] = []
    for name in split_lines(answer) {
        names.push(replace(name, "\u{0}", "\n"))
    }
    return names, nil
}

/// Delete a file, or an empty directory.
///
/// It will not delete a directory that has anything in it. Recursive deletion
/// is one typo away from catastrophe and is not something a standard library
/// should make a one-liner.
pub fn remove(path: str) -> error {
    let (_, err) = unwrap(remove_path(path), "remove \(path)")
    return err
}

/// What is at a path.
pub enum Kind {
    Missing
    File
    Directory
}

/// What is at `path`: [`Kind`]`.File`, `Kind.Directory`, or `Kind.Missing` when
/// nothing is there, and when the host cannot tell. It never fails.
pub fn kind(path: str) -> Kind {
    let code = path_kind(path)
    if code == 1 {
        return Kind.File
    }
    if code == 2 {
        return Kind.Directory
    }
    return Kind.Missing
}

/// Whether anything is at a path.
///
/// A convenience over [`kind`], and one to use sparingly: between asking and
/// acting, the answer may have changed. Prefer doing the thing and handling
/// the error.
pub fn exists(path: str) -> bool {
    return match kind(path) {
        Missing => false
        File => true
        Directory => true
    }
}

/// Whether `path` is a file. False for a directory and for nothing; see
/// [`exists`] for why asking first is a weak habit.
pub fn is_file(path: str) -> bool {
    return match kind(path) {
        File => true
        Missing => false
        Directory => false
    }
}

/// Whether `path` is a directory. False for a file and for nothing.
pub fn is_dir(path: str) -> bool {
    return match kind(path) {
        Directory => true
        Missing => false
        File => false
    }
}

/// The directory this host puts temporary files in, without a trailing
/// separator.
///
/// Asked of the host rather than assumed, because `/tmp` is a POSIX
/// convention and not a fact: Windows has no such directory, and a test that
/// hard-codes one passes on two platforms and fails on the third. Paths below
/// it may be joined with `/`, which every platform this runs on accepts —
/// including Windows, whose API takes either separator.
pub fn temp_dir() -> str {
    return temp_path()
}

/// The lines of a text file, without their line endings.
///
/// Exactly the prelude's [`lines`] of the file's text: a line ends at `\n`,
/// `\r\n` or a lone `\r`, so a file written on Windows or on an old Mac reads
/// the same, and a `\r` in the middle of a line is an ending, not text. A last line with no ending is a line; the empty
/// string after a final `\n` is not, so `"a\nb\n"` and `"a\nb"` are both `a`
/// and `b`, and an empty file has none. Empty lines in the middle are kept.
///
/// ```kite ignore
/// let path = temp_dir() + "/kite-doc-read-lines.txt"
/// assert(write(path, "a\r\n\nb\n") == nil, "written")
/// let (lines, err) = read_lines(path)
/// if err != nil {
///     return
/// }
/// assert(lines == ["a", "", "b"], "the empty line stays")
/// assert(remove(path) == nil, "tidied")
/// ```
pub fn read_lines(path: str) -> ([str], error) {
    let (body, err) = read(path)
    check err
    return lines(body), nil
}

/// Write `lines` to `path`, each followed by `\n`, replacing what was there.
///
/// The inverse of [`read_lines`] for lines with no line break inside them.
pub fn write_lines(path: str, lines: [str]) -> error {
    var parts: [str] = []
    for line in lines {
        parts.push(line)
        parts.push("\n")
    }
    return write(path, join(parts, ""))
}

/// Add `body` to the end of a file, creating it if it is not there.
///
/// This reads the file and writes it back whole, so it is not atomic: two
/// programs appending at once can lose one of the appends. It is for a log or
/// a list one program keeps.
pub fn append(path: str, body: str) -> error {
    var before = ""
    if exists(path) {
        let (held, err) = read(path)
        if err != nil {
            return err
        }
        before = held
    }
    return write(path, before + body)
}

/// A file's text, or `fallback` if it cannot be read — missing, a directory,
/// or not text. For a file that is allowed not to be there; use [`read`] to
/// find out why it was not.
pub fn read_or(path: str, fallback: str) -> str {
    let (body, err) = read(path)
    if err != nil {
        return fallback
    }
    return body
}

/// Copy a text file: the whole of `from` is read and written to `to`, which
/// is replaced if it is there.
///
/// Text only, like [`read`]: a file that is not UTF-8 is an error rather than
/// a damaged copy.
pub fn copy(from: str, to: str) -> error {
    let (body, err) = read(from)
    if err != nil {
        return err
    }
    return write(to, body)
}

/// The paths of every file below a directory, at any depth, sorted. Each is
/// `path` joined to where the file is: walking `a` finds `a/b/c.txt`.
///
/// Directories are not listed, only what is in them; an empty one leaves no
/// trace. A link to a directory is followed, and a walk that goes more than 64
/// directories deep — which a link back up the tree would do forever — is an
/// error.
///
/// ```kite ignore
/// let (_, err) = walk(temp_dir() + "/kite-doc-no-such-directory")
/// assert(err != nil, "a directory that is not there is an error")
/// ```
pub fn walk(path: str) -> ([str], error) {
    let (found, err) = walk_into(path, 0)
    check err
    return sorted(found, |a: str, b: str| a < b), nil
}

fn walk_into(path: str, depth: int) -> ([str], error) {
    if depth > 64 {
        return _, errors.new("fs: walk \(path): more than 64 directories deep")
    }
    let (names, err) = list(path)
    check err
    var found: [str] = []
    for name in names {
        let child = join_path([path, name])
        if is_dir(child) {
            let (inner, inner_err) = walk_into(child, depth + 1)
            check inner_err
            for item in inner {
                found.push(item)
            }
        } else {
            found.push(child)
        }
    }
    return found, nil
}

// ---- paths, as text ---------------------------------------------------------
//
// None of these asks the host anything. They read and write paths the way the
// platforms this runs on all accept them, with `/`, and know nothing about
// whether the path exists or what a drive letter is.

/// Paths joined with exactly one `/` between them.
///
/// An empty part is skipped, and a `/` ending one part or starting the next is
/// not doubled, so `join_path(["a/", "/b"])` is `a/b`. A first part that begins with
/// `/` keeps it, so a path stays absolute. `.` and `..` are not resolved.
///
/// ```kite
/// assert(join_path(["a", "b", "c.txt"]) == "a/b/c.txt", "plain")
/// assert(join_path(["a/", "/b"]) == "a/b", "not doubled")
/// assert(join_path(["/", "etc"]) == "/etc", "absolute")
/// assert(join_path(["", "a"]) == "a", "an empty part")
/// ```
pub fn join_path(parts: [str]) -> str {
    var out = ""
    for part in parts {
        if part.len() > 0 {
            if out.len() == 0 {
                out = part
            } else {
                out = trim_slashes_end(out) + "/" + trim_slashes_start(part)
            }
        }
    }
    return out
}

fn trim_slashes_end(s: str) -> str {
    var end = s.len()
    for end > 1 && s.code_at(end - 1) == 47 {
        end = end - 1
    }
    // "/" alone stays "/", which the join then follows with the next part
    // as "//": ask for it to be left out.
    if end == 1 && s.code_at(0) == 47 {
        return ""
    }
    return s.slice(0, end)
}

fn trim_slashes_start(s: str) -> str {
    var start = 0
    for start < s.len() && s.code_at(start) == 47 {
        start = start + 1
    }
    return s.slice(start, s.len())
}

/// The last part of a path: `a/b/c.txt` is `c.txt`. Slashes at the end are
/// ignored, so `a/b/` is `b`; `/` is `/`, and an empty path is empty.
///
/// ```kite
/// assert(base_name("a/b/c.txt") == "c.txt", "a file")
/// assert(base_name("a/b/") == "b", "a trailing slash")
/// assert(base_name("/") == "/", "the root")
/// ```
pub fn base_name(path: str) -> str {
    var end = path.len()
    for end > 1 && path.code_at(end - 1) == 47 {
        end = end - 1
    }
    if end == 1 && path.code_at(0) == 47 {
        return "/"
    }
    let trimmed = path.slice(0, end)
    let at = last_index_of(trimmed, "/")
    return trimmed.slice(at + 1, trimmed.len())
}

/// Everything but the last part of a path: `a/b/c.txt` is `a/b`. A path with
/// no `/` is `.`, the directory it is in; the parent of `/a` and of `/` is
/// `/`; and slashes at the end are ignored, so `a/b/` is `a`.
///
/// ```kite
/// assert(dir_name("a/b/c.txt") == "a/b", "a file")
/// assert(dir_name("c.txt") == ".", "no directory")
/// assert(dir_name("/c.txt") == "/", "the root")
/// ```
pub fn dir_name(path: str) -> str {
    var end = path.len()
    for end > 1 && path.code_at(end - 1) == 47 {
        end = end - 1
    }
    let trimmed = path.slice(0, end)
    let at = last_index_of(trimmed, "/")
    if at < 0 {
        return "."
    }
    var cut = at
    for cut > 1 && trimmed.code_at(cut - 1) == 47 {
        cut = cut - 1
    }
    if cut == 0 {
        return "/"
    }
    return trimmed.slice(0, cut)
}

/// The extension of a path's last part, without the dot: `a/b.tar.gz` is
/// `gz`. A name with no dot, one that only begins with a dot (`.bashrc`) and
/// one that ends in a dot have none: it is "".
///
/// ```kite
/// assert(extension("notes.txt") == "txt", "an extension")
/// assert(extension("a.tar.gz") == "gz", "the last")
/// assert(extension(".bashrc") == "", "a dotfile has none")
/// ```
pub fn extension(path: str) -> str {
    let name = base_name(path)
    let at = last_index_of(name, ".")
    if at <= 0 || at == name.len() - 1 {
        return ""
    }
    return name.slice(at + 1, name.len())
}

fn split_lines(body: str) -> [str] {
    // Each line is cut out whole where it ends: adding it up a character at
    // a time copied the line so far for every character of it.
    var out: [str] = []
    var start = 0
    for i in 0..body.len() {
        if body.code_at(i) == 10 {
            if i > start {
                out.push(body.slice(start, i))
            }
            start = i + 1
        }
    }
    if body.len() > start {
        out.push(body.slice(start, body.len()))
    }
    return out
}
