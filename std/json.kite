// std/json — reading and writing JSON.
//
// Written in Kite, on top of the five string primitives the language has and
// `text.from_code`. It is the first substantial body of Kite code in the
// standard library, and a parse returns `(Json, error)` like anything else
// that can fail: a malformed document is a value to handle, not something
// thrown.
//
// **Escapes are RFC 8259 §7, both ways.** `\uXXXX` is decoded, including a
// surrogate pair as the one character it denotes, and every control character
// is escaped on the way out. Neither used to be true: `caf\u00e9` decoded to
// `cafu00e9` — silently, so a name simply came out wrong — and a carriage
// return went out raw, which is not JSON and which `JSON.parse` refuses with
// `Bad control character in string literal`. The decoding is `text.from_code`,
// which `std/toml` uses for the same purpose.
//
// **What is read is RFC 8259, and nothing looser.** A leading zero (`01`), a
// point or an exponent with no digits after it (`1.`, `1e`), an escape the
// RFC does not list (`\x`) and a raw control character inside a string are
// each refused with an error saying where, rather than read as whatever they
// looked closest to. A document this accepts is one every other parser
// accepts too. Numbers are read by the prelude's `parse_float`, so each is the
// float nearest what the document wrote — `0.3` is 0.3 — and one too large
// for a float is an error.

use std/math

/// A JSON value.
///
/// Recursive with no boxing annotation, because every Kite aggregate is
/// already a GC reference.
pub enum Json {
    Null
    Bool(bool)
    Number(float)
    Text(str)
    Array([Json])
    Object({ str: Json })
}

/// How far a parse got, and what it produced.
///
/// Parsing is written as functions from a position to a value and a new
/// position, rather than around a cursor with a `var` field: the two read
/// about the same, and this one cannot be left half-advanced by an early
/// return.
struct Step {
    value: Json
    next: int
}

/// A decoded `\u` escape, and how many characters of input it consumed.
///
/// A struct rather than a pair: `(str, int)` is refused, because a two-value
/// return in Kite is `(T, error)` and means fallibility rather than a tuple.
struct Escape {
    text: str
    width: int
}

/// A parsed string, and where it ended.
struct Text {
    text: str
    next: int
}

// ---- parsing ---------------------------------------------------------------

/// How deeply one document may nest.
///
/// A JSON document says how deep it is, and the parser recurses once per
/// level, so without a ceiling the document chooses how much native stack to
/// consume — and running out of it is a trap, which takes the whole module
/// down rather than failing the one parse. RFC 8259 leaves the limit to the
/// implementation; this is deeper than real documents go and shallower than
/// anything that threatens the stack.
fn max_depth() -> int {
    return 128
}

/// The value a document holds, or an error saying where it went wrong.
pub fn parse(input: str) -> (Json, error) {
    let (step, err) = parse_value(input, skip_space(input, 0), 0)
    check err
    let end = skip_space(input, step.next)
    if end < input.len() {
        return _, errors.new("json: unexpected text at \(end)")
    }
    return step.value, nil
}

fn parse_value(input: str, at: int, depth: int) -> (Step, error) {
    if at >= input.len() {
        return _, errors.new("json: unexpected end of input")
    }
    let c = input.slice(at, at + 1)
    if c == "{" {
        if depth >= max_depth() {
            return _, errors.new("json: nested deeper than \(max_depth()) at \(at)")
        }
        return parse_object(input, at, depth + 1)
    }
    if c == "[" {
        if depth >= max_depth() {
            return _, errors.new("json: nested deeper than \(max_depth()) at \(at)")
        }
        return parse_array(input, at, depth + 1)
    }
    if c == "\"" {
        let (text, err) = parse_string(input, at)
        check err
        return Step{ value: Json.Text(text.text), next: text.next }, nil
    }
    if c == "t" {
        return keyword(input, at, "true", Json.Bool(true))
    }
    if c == "f" {
        return keyword(input, at, "false", Json.Bool(false))
    }
    if c == "n" {
        return keyword(input, at, "null", Json.Null)
    }
    // Anything else that cannot begin a number is not a value at all —
    // `{"a":}`, `[1,]` and `[}` used to say "expected a number", which names
    // one of six things that could have stood there.
    if c != "-" && digit(c) < 0 {
        return _, errors.new("json: expected a value at \(at)")
    }
    return parse_number(input, at)
}

fn keyword(input: str, at: int, word: str, value: Json) -> (Step, error) {
    let end = at + word.len()
    if end > input.len() {
        return _, errors.new("json: unexpected end of input")
    }
    if input.slice(at, end) != word {
        return _, errors.new("json: expected `\(word)` at \(at)")
    }
    return Step{ value: value, next: end }, nil
}

fn parse_object(input: str, at: int, depth: int) -> (Step, error) {
    var entries: { str: Json } = { }
    var i = skip_space(input, at + 1)
    if peek(input, i) == "}" {
        return Step{ value: Json.Object(entries), next: i + 1 }, nil
    }
    for {
        let (key, err) = parse_string(input, i)
        check err
        i = skip_space(input, key.next)
        if peek(input, i) != ":" {
            return _, errors.new("json: expected `:` at \(i)")
        }
        let (value, verr) = parse_value(input, skip_space(input, i + 1), depth)
        check verr
        entries[key.text] = value.value
        i = skip_space(input, value.next)
        let c = peek(input, i)
        if c == "," {
            i = skip_space(input, i + 1)
        } else {
            if c == "}" {
                return Step{ value: Json.Object(entries), next: i + 1 }, nil
            }
            return _, errors.new("json: expected `,` or `}` at \(i)")
        }
    }
}

fn parse_array(input: str, at: int, depth: int) -> (Step, error) {
    var items: [Json] = []
    var i = skip_space(input, at + 1)
    if peek(input, i) == "]" {
        return Step{ value: Json.Array(items), next: i + 1 }, nil
    }
    for {
        let (step, err) = parse_value(input, i, depth)
        check err
        items.push(step.value)
        i = skip_space(input, step.next)
        let c = peek(input, i)
        if c == "," {
            i = skip_space(input, i + 1)
        } else {
            if c == "]" {
                return Step{ value: Json.Array(items), next: i + 1 }, nil
            }
            return _, errors.new("json: expected `,` or `]` at \(i)")
        }
    }
}

fn parse_string(input: str, at: int) -> (Text, error) {
    if peek(input, at) != "\"" {
        return _, errors.new("json: expected a string at \(at)")
    }
    var out: [str] = []
    var i = at + 1
    // Where the current run of ordinary characters began.
    //
    // A run is copied with one `slice` rather than a character at a time.
    // Appending each character in turn built every prefix of the answer as a
    // separate string — and on the wasm target every string a program derives
    // is interned into a table that is never reclaimed, so decoding an
    // n-character value retained n strings totalling n²/2 characters, for the
    // life of the process. A few hundred KB of JSON was enough to exhaust the
    // heap of a server that was otherwise idle.
    var run = i
    for i < input.len() {
        let c = input.code_at(i)
        // `"` ends the string.
        if c == 34 {
            if out.len() == 0 {
                return Text{ text: input.slice(run, i), next: i + 1 }, nil
            }
            out.push(input.slice(run, i))
            return Text{ text: join(out, ""), next: i + 1 }, nil
        }
        // RFC 8259 §7: a control character inside a string must be escaped.
        // Reading a raw one would accept a document no other parser does.
        if c < 32 {
            return _, errors.new("json: a control character must be escaped, at \(i)")
        }
        // `\` ends the run: what follows is not itself.
        if c == 92 {
            out.push(input.slice(run, i))
            let e = peek(input, i + 1)
            var width = 2
            if e == "n" {
                out.push("\n")
            } else {
                if e == "t" {
                    out.push("\t")
                } else {
                    if e == "r" {
                        out.push("\r")
                    } else {
                        if e == "b" {
                            out.push("\u{8}")
                        } else {
                            if e == "f" {
                                out.push("\u{c}")
                            } else {
                                if e == "u" {
                                    let (decoded, uerr) = unicode_at(input, i)
                                    check uerr
                                    out.push(decoded.text)
                                    width = decoded.width
                                } else if e == "\"" || e == "\\" || e == "/" {
                                    // Each of these is itself.
                                    out.push(e)
                                } else {
                                    // `\x` used to read as `x`. The RFC lists
                                    // eight escapes and `\u`; anything else
                                    // is not JSON.
                                    return _, errors.new("json: unknown escape `\\\(e)` at \(i)")
                                }
                            }
                        }
                    }
                }
            }
            i = i + width
            run = i
        } else {
            i = i + 1
        }
    }
    return _, errors.new("json: unterminated string from \(at)")
}

/// A `\uXXXX` escape, and how many characters of the input it took.
///
/// `at` is the index of the backslash, so the digits start at `at + 2`.
///
/// **The pair matters.** JSON has no way to write a character outside the BMP
/// except as two escapes, `😀`, and reading them separately produces
/// two lone surrogates — which are not characters, so `text.from_code` answers
/// with "" for each and the character vanishes. They are combined here.
///
/// **A malformed escape is refused; a surrogate that stands alone is not.**
/// The two are different failures. `\uzzzz` is not JSON at all — RFC 8259 §7
/// requires four hex digits — and every other malformed thing in this file is
/// an error, so this one is too. A well-formed escape that happens to name
/// half of a pair is valid JSON denoting no character, and U+FFFD is what a
/// decoder is expected to put there rather than nothing.
fn unicode_at(input: str, at: int) -> (Escape, error) {
    let first = hex4(input, at + 2)
    if first < 0 {
        return _, errors.new("json: `\\u` needs four hex digits, at \(at)")
    }
    // A high surrogate, and a low one behind it: one character between them.
    if first >= 55296 && first <= 56319 {
        if peek(input, at + 6) == "\\" && peek(input, at + 7) == "u" {
            let second = hex4(input, at + 8)
            if second >= 56320 && second <= 57343 {
                let combined = 65536 + (first - 55296) * 1024 + (second - 56320)
                return Escape{ text: text.from_code(combined), width: 12 }, nil
            }
        }
        return Escape{ text: text.from_code(65533), width: 6 }, nil
    }
    // A low surrogate on its own is not a character either.
    if first >= 56320 && first <= 57343 {
        return Escape{ text: text.from_code(65533), width: 6 }, nil
    }
    return Escape{ text: text.from_code(first), width: 6 }, nil
}

/// Four hex digits as a number, or -1 when they are not four hex digits.
fn hex4(input: str, at: int) -> int {
    var value = 0
    for k in 0..4 {
        let d = hex_digit(peek(input, at + k))
        if d < 0 {
            return -1
        }
        value = value * 16 + d
    }
    return value
}

fn hex_digit(c: str) -> int {
    let d = digit(c)
    if d >= 0 {
        return d
    }
    if c >= "a" && c <= "f" {
        return c.code_at(0) - 87
    }
    if c >= "A" && c <= "F" {
        return c.code_at(0) - 55
    }
    return -1
}

/// A number, as RFC 8259 §6 writes one: `-? (0 | [1-9][0-9]*) (. [0-9]+)?
/// ([eE] [+-]? [0-9]+)?`, and nothing looser — `01`, `1.`, `.5`, `1e` and `+1`
/// are each an error, as they are to every other JSON parser.
///
/// The grammar is checked here and the value is the prelude's `parse_float`,
/// which gives the float nearest the decimal written. Summing digit values as
/// floats, as this once did, made `0.3` read as 0.30000000000000004 and
/// `9223372036854775808` as 9223372036854777856.
fn parse_number(input: str, at: int) -> (Step, error) {
    var i = at
    if peek(input, i) == "-" {
        i = i + 1
    }
    let first = digit_at(input, i)
    if first < 0 {
        return _, errors.new("json: expected a number at \(at)")
    }
    i = i + 1
    if first == 0 {
        if digit_at(input, i) >= 0 {
            return _, errors.new("json: a number may not start with a zero, at \(at)")
        }
    } else {
        i = past_digits(input, i)
    }
    if peek(input, i) == "." {
        i = i + 1
        if digit_at(input, i) < 0 {
            return _, errors.new("json: expected a digit after the point at \(i)")
        }
        i = past_digits(input, i)
    }
    let marker = peek(input, i)
    if marker == "e" || marker == "E" {
        i = i + 1
        let sign = peek(input, i)
        if sign == "+" || sign == "-" {
            i = i + 1
        }
        if digit_at(input, i) < 0 {
            return _, errors.new("json: expected a digit in the exponent at \(i)")
        }
        i = past_digits(input, i)
    }
    // A number JSON cannot express is a parse error, not a value.
    //
    // `1e999999999999` would be an infinity, and `stringify` would write it
    // back as the bare token `inf`, which no JSON parser reads. A document
    // that cannot survive a round trip through this module has not been
    // parsed, so it says so here. `std/toml` takes the same position for a
    // literal `inf` ("has no value in Kite"). Underflow is untouched:
    // `1e-999999999999` is zero, which is what IEEE says and a number JSON
    // can hold.
    let value = parse_float(input.slice(at, i))
    if value == nil {
        return _, errors.new("json: the number at \(at) is out of range for a float")
    }
    return Step{ value: Json.Number(value), next: i }, nil
}

/// Where a run of decimal digits starting at `at` ends.
fn past_digits(input: str, at: int) -> int {
    var i = at
    for digit_at(input, i) >= 0 {
        i = i + 1
    }
    return i
}

/// The decimal digit at `at`, or -1 for anything else or past the end.
fn digit_at(input: str, at: int) -> int {
    if at < 0 || at >= input.len() {
        return -1
    }
    let d = input.code_at(at) - 48
    if d < 0 || d > 9 {
        return -1
    }
    return d
}

fn skip_space(input: str, at: int) -> int {
    var i = at
    for i < input.len() {
        let c = input.slice(i, i + 1)
        if c != " " {
            if c != "\n" {
                if c != "\t" {
                    if c != "\r" {
                        return i
                    }
                }
            }
        }
        i = i + 1
    }
    return i
}

fn peek(input: str, at: int) -> str {
    if at < 0 {
        return ""
    }
    if at >= input.len() {
        return ""
    }
    return input.slice(at, at + 1)
}

/// The value of a decimal digit, or -1.
fn digit(c: str) -> int {
    if c.len() != 1 {
        return -1
    }
    return "0123456789".index_of(c)
}

// ---- writing ---------------------------------------------------------------

/// A value as compact JSON.
///
/// An infinity or a NaN is written `null`, as `JSON.stringify` writes it:
/// JSON has no spelling for either, so the choice is between that and a
/// document nothing can read back.
///
/// **A value nested deeper than 128 levels traps**, which is exactly as deep
/// as `parse` reads — so everything `parse` returns can be written, and a
/// value built to be deeper is a bug in the program that built it. Writing
/// recurses once per level just as reading does, and without the ceiling the
/// value chose how much stack to use: a program that held 2,000 nested arrays
/// printed on the VM and the native backend and ran out of stack on Wasm.
/// `check_nesting` is the test that returns an error instead, for a value
/// that came from somewhere that does not cap it.
pub fn stringify(value: Json) -> str {
    require(!too_deep(value, 1), "json: the value is nested deeper than \(max_depth()) levels")
    return write(value)
}

/// Whether `value` holds a container more than `max_depth()` levels down,
/// `level` being how many containers deep `value` itself is. It stops at the
/// ceiling, so it cannot run out of stack on the very thing it guards against.
fn too_deep(value: Json, level: int) -> bool {
    var children: [Json] = []
    match value {
        Array(list) => {
            children = list
        },
        Object(entries) => {
            for (key, item) in entries {
                children.push(item)
            }
        },
        other => {
            return false
        },
    }
    if level > max_depth() {
        return true
    }
    for child in children {
        if too_deep(child, level + 1) {
            return true
        }
    }
    return false
}

/// nil if `stringify` and `pretty` can write `value`, and an error if it is
/// nested deeper than 128 levels, the depth `parse` stops at.
///
/// ```kite
/// assert(check_nesting(Json.Array([Json.Null])) == nil, "one level is fine")
/// ```
pub fn check_nesting(value: Json) -> error {
    if too_deep(value, 1) {
        return errors.new("json: the value is nested deeper than \(max_depth()) levels")
    }
    return nil
}

fn write(value: Json) -> str {
    return match value {
        Null => "null",
        Bool(b) => if b { "true" } else { "false" },
        Number(n) => number(n),
        Text(s) => quote(s),
        Array(list) => "[" + join(map(list, |item: Json| write(item)), ",") + "]",
        Object(entries) => "{" + join(pairs(entries), ",") + "}",
    }
}

fn pairs(entries: { str: Json }) -> [str] {
    var out: [str] = []
    // Insertion order, which the specification guarantees for a map — so a
    // document read and written again keeps its field order.
    for (key, value) in entries {
        out.push(quote(key) + ":" + write(value))
    }
    return out
}

/// A number without a trailing `.0`: JSON has one numeric type, and `1.0` and
/// `1` mean the same thing to everything that reads it.
///
/// Only a number that fits an `int` is written as one. The cast saturates, so
/// asking it about 2⁶³ answered 9223372036854775807 — which converts back to
/// the same float, and so passed a test of `as float`, but is a different
/// number to a reader that keeps integers exact. Anything past the range is
/// written as the float it is.
///
/// Except an infinity or a NaN, which is `null`. Interpolation spells them
/// `inf`, `-inf` and `NaN`, none of which is JSON, so `json.parse` refused
/// what `stringify` wrote, and so did every other reader.
fn number(n: float) -> str {
    // `n - n` is zero for every finite float and a NaN for the rest.
    if !(n - n == 0.0) {
        return "null"
    }
    let whole = whole_number(n)
    if whole != nil {
        return "\(whole)"
    }
    return "\(n)"
}

fn quote(s: str) -> str {
    var out = ["\""]
    for i in 0..s.len() {
        let c = s.slice(i, i + 1)
        if c == "\"" {
            out.push("\\\"")
        } else {
            if c == "\\" {
                out.push("\\\\")
            } else {
                if c == "\n" {
                    out.push("\\n")
                } else {
                    if c == "\t" {
                        out.push("\\t")
                    } else {
                        // **Every other control character has to be escaped
                        // too.** RFC 8259 forbids a raw one inside a string,
                        // and a strict parser refuses the whole document over
                        // it — `JSON.parse` answers `Bad control character in
                        // string literal`. A carriage return in a pasted note
                        // was enough to produce JSON this library could read
                        // back and nothing else could.
                        let code = c.code_at(0)
                        if code < 32 {
                            if code == 13 {
                                out.push("\\r")
                            } else {
                                if code == 8 {
                                    out.push("\\b")
                                } else {
                                    if code == 12 {
                                        out.push("\\f")
                                    } else {
                                        out.push("\\u00" + hex2(code))
                                    }
                                }
                            }
                        } else {
                            out.push(c)
                        }
                    }
                }
            }
        }
    }
    out.push("\"")
    return join(out, "")
}

/// Two lowercase hex digits, for a `\u00XX` escape.
fn hex2(code: int) -> str {
    let digits = "0123456789abcdef"
    let hi = (code / 16) % 16
    let lo = code % 16
    return digits.slice(hi, hi + 1) + digits.slice(lo, lo + 1)
}

/// A value as indented JSON, for something a person will read.
///
/// Nested deeper than 128 levels it traps, as `stringify` does.
pub fn pretty(value: Json) -> str {
    require(!too_deep(value, 1), "json: the value is nested deeper than \(max_depth()) levels")
    return indent_value(value, 0)
}

fn indent_value(value: Json, depth: int) -> str {
    let pad = spaces(depth + 1)
    let close = spaces(depth)
    return match value {
        Array(list) => if list.len() == 0 {
            "[]"
        } else {
            "[\n" + join(map(list, |item: Json| pad + indent_value(item, depth + 1)), ",\n") + "\n" + close + "]"
        },
        Object(entries) => if entries.len() == 0 {
            "{}"
        } else {
            "{\n" + join(indented_pairs(entries, depth + 1), ",\n") + "\n" + close + "}"
        },
        other => write(other),
    }
}

fn indented_pairs(entries: { str: Json }, depth: int) -> [str] {
    let pad = spaces(depth)
    var out: [str] = []
    for (key, value) in entries {
        out.push(pad + quote(key) + ": " + indent_value(value, depth))
    }
    return out
}

fn spaces(depth: int) -> str {
    var out = ""
    for i in 0..depth {
        out = out + "  "
    }
    return out
}

// ---- taking a value apart ---------------------------------------------------
//
// A document straight into a program's own struct is `@derive(Decode)`, which
// writes `User.decode(doc)` from the fields — in terms of these. A program
// can also take a document apart with them by hand, which is more typing and
// no less safe: each yields an optional, so a missing or mistyped field is a
// value to handle rather than a surprise.

/// A field of an object.
///
/// Every accessor takes an **optional** value and yields one, which is what
/// makes them chain: `json.field(json.field(doc, "a"), "b")` reads left to
/// right and yields nil the moment anything is missing. A plain `Json` is
/// accepted wherever an `Option<Json>` is wanted, so the first call in a chain
/// needs nothing special.
///
/// Kite has no `?.`, and this is why it does not need one: an operation that
/// might find nothing says so in its result type, and the branch is taken once
/// at the end rather than hidden at every step.
pub fn field(value: Option<Json>, key: str) -> Option<Json> {
    if value == nil {
        return nil
    }
    return match value {
        Object(entries) => entries[key],
        other => nil,
    }
}

/// Element `index` of an array, or nil when `value` is nil, is not an array, or has no element there. It never fails, so a chain of [`field`] and `at` ends in one test.
pub fn at(value: Option<Json>, index: int) -> Option<Json> {
    if value == nil {
        return nil
    }
    return match value {
        Array(list) => list.get(index),
        other => nil,
    }
}

/// The text of a string value, or nil when `value` is nil or is anything else. A number is not turned into text here.
pub fn text(value: Option<Json>) -> Option<str> {
    if value == nil {
        return nil
    }
    return match value {
        Text(s) => s,
        other => nil,
    }
}

/// The number in a number value, or nil when `value` is nil or is anything else. Every JSON number is a `float` here; [`int_of`] asks for a whole one.
pub fn number_of(value: Option<Json>) -> Option<float> {
    if value == nil {
        return nil
    }
    return match value {
        Number(n) => n,
        other => nil,
    }
}

/// A whole number, or nil — for anything that is not a number, and for a
/// number that is not whole or that an `int` cannot be trusted to hold.
///
/// The cast this used to be truncated `3.7` to 3 and saturated `1e30` to the
/// largest `int`, and `@derive(Decode)` reads an `int` field through this, so
/// a decoder that promises "expected a whole number" accepted both. JSON's one
/// number type is a float, so `3.0` is the whole number 3.
///
/// **Only a number a float holds exactly is read as an `int`**: magnitude
/// below 2⁵³. Past that two neighbouring integers share a float —
/// `9007199254740993` reads as 9007199254740992 — so the value in the program
/// would be a different number from the one in the document, and nothing would
/// say so. It is nil instead. An integer that large is carried as text, which
/// is how `of_int` writes it, and a text of digits that fits an `int` and
/// is outside that range is read back here.
pub fn int_of(value: Option<Json>) -> Option<int> {
    if value == nil {
        return nil
    }
    return match value {
        Number(n) => exact_int(n),
        Text(s) => big_int_text(s),
        other => nil,
    }
}

/// The largest integer below which a float holds every integer: 2⁵³.
fn exact_limit() -> int {
    return 9007199254740992
}

fn exact_int(n: float) -> Option<int> {
    let whole = whole_number(n)
    if whole == nil {
        return nil
    }
    if whole <= -exact_limit() || whole >= exact_limit() {
        return nil
    }
    return whole
}

/// A decimal integer written as text, when it is one `of_int` would have
/// written that way: outside the exact range, and spelled the way an `int`
/// is, so `"5"` and `"+9007199254740993"` are not numbers.
fn big_int_text(s: str) -> Option<int> {
    let n = parse_int(s)
    if n == nil {
        return nil
    }
    if n > -exact_limit() && n < exact_limit() {
        return nil
    }
    if "\(n)" != s {
        return nil
    }
    return n
}

/// An `int` as JSON — what `@derive(Encode)` writes for an `int` field.
///
/// JSON has one number type, read as a float by almost everything, and a float
/// holds every integer only below 2⁵³. An `int` inside that range is a number;
/// one outside it is written as a string of its digits, because the
/// alternative is a number that silently reads back as a different one
/// (`1234567890123456789` became `1234567890123456768`). `int_of` reads both
/// forms, so a document written here round-trips, and another program sees a
/// string where it would otherwise see a wrong number.
///
/// ```kite
/// assert(stringify(of_int(42)) == "42", "a small int is a number")
/// assert(stringify(of_int(1234567890123456789)) == "\"1234567890123456789\"", "a big one is text")
/// assert(int_of(of_int(1234567890123456789)) == 1234567890123456789, "and reads back")
/// ```
pub fn of_int(n: int) -> Json {
    if n > -exact_limit() && n < exact_limit() {
        return Json.Number(n as float)
    }
    return Json.Text("\(n)")
}

fn whole_number(n: float) -> Option<int> {
    // [-2⁶³, 2⁶³): both ends are floats exactly, and every float between them
    // converts to an `int` without saturating. A NaN fails both comparisons.
    if !(n >= -9223372036854775808.0 && n < 9223372036854775808.0) {
        return nil
    }
    // `trunc_to` and a subtraction, which say the truncation and the exact
    // comparison are meant: a bare `as int` or `!=` on floats warns, and the
    // warning showed whenever this file was itself the test entry.
    let whole = math.trunc_to(n)
    let rest = n - (whole as float)
    if rest > 0.0 || rest < 0.0 {
        return nil
    }
    return whole
}

/// The `bool` in a boolean value, or nil when `value` is nil or is anything else. `"true"` the string is not `true`.
pub fn bool_of(value: Option<Json>) -> Option<bool> {
    if value == nil {
        return nil
    }
    return match value {
        Bool(b) => b,
        other => nil,
    }
}

/// The elements of an array, or nothing at all — a caller iterating them
/// wants a slice rather than a branch.
pub fn items(value: Option<Json>) -> [Json] {
    if value == nil {
        return []
    }
    return match value {
        Array(list) => list,
        other => [],
    }
}

/// An object's entries, in the order the document wrote them.
///
/// The counterpart to `items` for the other container. Anything that is not an
/// object yields nothing rather than an error, which is what makes the
/// accessors chain: a caller that needs to tell "not an object" from "an empty
/// object" matches on the `Json` itself, which is still there.
pub fn entries(value: Option<Json>) -> { str: Json } {
    let none: { str: Json } = { }
    if value == nil {
        return none
    }
    return match value {
        Object(fields) => fields,
        other => none,
    }
}

/// Whether a document says nothing here.
///
/// A field that is absent and a field written `null` both answer true, and
/// that is the point: the two mean the same thing to every producer of JSON,
/// and a reader that told them apart would be reading a distinction the format
/// does not reliably carry. `@derive(Decode)` uses this for an `Option<T>`
/// field.
pub fn is_null(value: Option<Json>) -> bool {
    if value == nil {
        return true
    }
    return match value {
        Null => true,
        other => false,
    }
}

/// A value that can become JSON.
///
/// Declared here rather than in the prelude because it mentions `Json`, and a
/// trait cannot be declared somewhere that has never heard of the type it
/// returns. `@derive(Encode)` writes the body; the decoding direction is an
/// associated function on the type — `User.decode(doc)` — because a trait
/// method cannot say it returns the implementing type.
pub trait Encode {
    fn encode(self) -> Json
}

/// A field's text, or a fallback — the shape most configuration reading takes.
pub fn text_or(value: Option<Json>, key: str, fallback: str) -> str {
    let s = text(field(value, key))
    if s == nil {
        return fallback
    }
    return s
}

/// A field's whole number, or `fallback` when the field is absent, is not a number, or is not a whole one that an `int` holds (see [`int_of`]).
pub fn int_or(value: Option<Json>, key: str, fallback: int) -> int {
    let n = int_of(field(value, key))
    if n == nil {
        return fallback
    }
    return n
}

/// A field's boolean, or `fallback` when the field is absent or is not a boolean.
pub fn bool_or(value: Option<Json>, key: str, fallback: bool) -> bool {
    let b = bool_of(field(value, key))
    if b == nil {
        return fallback
    }
    return b
}

/// A field's number, or a fallback. An integer answers too: JSON has one
/// number type.
pub fn float_or(value: Option<Json>, key: str, fallback: float) -> float {
    let n = number_of(field(value, key))
    if n == nil {
        return fallback
    }
    return n
}

/// The keys of an object, in the order the document wrote them — and none for
/// anything that is not an object.
///
/// ```kite
/// let (doc, err) = parse("{\"b\": 1, \"a\": 2}")
/// if err != nil {
///     return
/// }
/// assert(keys(doc) == ["b", "a"], "in document order")
/// assert(keys(field(doc, "b")) == [], "a number has none")
/// ```
pub fn keys(value: Option<Json>) -> [str] {
    var out: [str] = []
    for (key, item) in entries(value) {
        out.push(key)
    }
    return out
}

/// The value at a dotted path, or nil: `path(doc, "users.0.name")`.
///
/// Each segment is a key of an object, or, when the value so far is an array
/// and the segment is a whole number, an index into it. On an object a segment
/// is always a key, so `"1"` names the key `"1"`; on an array a segment is read
/// as a whole number, so `"01"` is the index 1. A key that itself contains a
/// dot cannot be named this way; chain [`field`] and [`at`] for it. An empty
/// path is the value itself, and a trailing dot names the key `""`.
///
/// ```kite
/// let (doc, err) = parse("{\"users\": [{\"name\": \"ada\"}], \"1\": \"one\"}")
/// if err != nil {
///     return
/// }
/// assert(text(path(doc, "users.0.name")) == "ada", "through an object, an array, an object")
/// assert(path(doc, "users.1.name") == nil, "past the end")
/// assert(text(path(doc, "1")) == "one", "a number on an object is a key")
/// assert(text(path(doc, "users.00.name")) == "ada", "and on an array, an index with zeros")
/// ```
pub fn path(value: Option<Json>, dotted: str) -> Option<Json> {
    var here = value
    if dotted.len() == 0 {
        return here
    }
    for segment in split(dotted, ".") {
        if here == nil {
            return nil
        }
        let index = parse_int(segment)
        let in_array = match here {
            Array(list) => true,
            other => false,
        }
        if in_array {
            if index == nil {
                return nil
            }
            here = at(here, index)
        } else {
            here = field(here, segment)
        }
    }
    return here
}

/// The document `input` holds, or `fallback` if it is not one.
///
/// For a configuration that is allowed to be missing or damaged. A caller that
/// needs to say *why* it failed uses [`parse`].
pub fn parse_or(input: str, fallback: Json) -> Json {
    let (value, err) = parse(input)
    if err != nil {
        return fallback
    }
    return value
}

/// A value as compact JSON with the keys of every object in sorted order,
/// where [`stringify`] keeps the order they were inserted in.
///
/// For output that has to be the same bytes whenever it means the same thing:
/// a hash, a cache key, a signature, a file under version control. Sorted by
/// the keys' characters (code points), which is the order `<` gives strings.
/// Traps past 128 levels, as `stringify` does.
///
/// ```kite
/// let (doc, err) = parse("{\"b\": 1, \"a\": {\"d\": 2, \"c\": 3}}")
/// if err != nil {
///     return
/// }
/// assert(stringify_sorted(doc) == "{\"a\":{\"c\":3,\"d\":2},\"b\":1}", "sorted at every level")
/// ```
pub fn stringify_sorted(value: Json) -> str {
    require(!too_deep(value, 1), "json: the value is nested deeper than \(max_depth()) levels")
    return write(sort_keys(value))
}

fn sort_keys(value: Json) -> Json {
    return match value {
        Array(list) => Json.Array(map(list, |item: Json| sort_keys(item))),
        Object(entries) => sort_object(entries),
        other => other,
    }
}

fn sort_object(entries: { str: Json }) -> Json {
    var out: { str: Json } = { }
    for key in sorted(keys_of(entries), |a: str, b: str| a < b) {
        let held = entries[key]
        if held != nil {
            out[key] = sort_keys(held)
        }
    }
    return Json.Object(out)
}

fn keys_of(entries: { str: Json }) -> [str] {
    var out: [str] = []
    for (key, item) in entries {
        out.push(key)
    }
    return out
}
