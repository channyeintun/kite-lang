// std/errors — building and adding to error values.
//
// An error in Kite is an ordinary value: nil, or something describing a
// failure. `errors.new` is a compiler builtin because constructing one is the
// only thing that needs to be; everything else is written here.

/// `err` with context in front of it, or nil when `err` is nil.
///
/// Returning nil for nil is what lets this compose with `check` directly:
///
/// ```kite ignore
/// let (bytes, err) = fs.read(path)
/// check errors.wrap(err, "loading config from \(path)")
/// ```
pub fn wrap(err: error, context: str) -> error {
    if err == nil {
        return nil
    }
    // `because` rather than `new`: the wrapped error is kept, so a caller can
    // still ask what the original failure was. Flattening it into text is what
    // makes "was this a missing file?" unanswerable four layers up.
    return errors.because("\(context): \(err.message())", err)
}

/// An error whose message is built from parts, for a caller that would
/// otherwise interpolate into `errors.new` at every site.
pub fn of(subject: str, problem: str) -> error {
    return errors.new("\(subject): \(problem)")
}

/// Every message in the chain, outermost first.
///
/// `wrap` keeps what it wrapped, so a failure that crossed four layers reads
/// as the four sentences that produced it rather than one run-on line.
///
/// ```kite
/// // Unqualified because this example is compiled inside this module, where
/// // its siblings are in scope by name. A caller writes `errors.chain(…)`.
/// // For the same reason `join` here would be this module's own, so the
/// // links are printed one to a line.
/// let outer = wrap(errors.new("no such file"), "loading config")
/// let links = chain(outer)
/// for link in links {
///     io.print(link)
/// }
/// ```
pub fn chain(err: error) -> [str] {
    var out: [str] = []
    if err == nil {
        return out
    }
    out.push(err.message())
    var next = err.cause()
    // Bounded rather than unconditional: a cause chain is built by wrapping
    // and cannot be cyclic, but a bound costs nothing and a runaway costs
    // everything.
    for i in 0..64 {
        if next == nil {
            return out
        }
        out.push(next.message())
        next = next.cause()
    }
    // A chain deeper than the bound is cut here, and what lies below the cut
    // is left unread on purpose.
    _ = next
    return out
}

/// The innermost failure — what actually went wrong, under the context.
pub fn root(err: error) -> error {
    if err == nil {
        return nil
    }
    // `here` is only ever assigned and returned, never read for a message:
    // narrowing proves a `let` non-nil, not a `var` it was copied into, and
    // the walk is over `next`, which is tested on every turn.
    var here = err
    var next = err.cause()
    for i in 0..64 {
        if next == nil {
            return here
        }
        here = next
        next = next.cause()
    }
    // As in `chain`: past the bound, the rest of the chain is not followed.
    _ = next
    return here
}

/// Whether an error's message mentions `needle`.
///
/// Weaker than naming a type — `NotFound.is(err)` asks the question this
/// approximates — and still here for the errors that carry no type of their
/// own, which is every one built by `errors.new`.
pub fn mentions(err: error, needle: str) -> bool {
    if err == nil {
        return false
    }
    return contains(err.message(), needle)
}

/// Whether any message in the cause chain mentions `needle` — [`mentions`]
/// for an error that was joined with `errors.because`, whose outer message
/// does not repeat the inner one.
///
/// ```kite
/// let err = errors.because("could not start", errors.new("port 80 in use"))
/// assert(!mentions(err, "in use"), "the outer message does not say it")
/// assert(caused_by(err, "in use"), "the cause does")
/// ```
///
/// Bounded at 64 links, as [`chain`] is.
pub fn caused_by(err: error, needle: str) -> bool {
    if err == nil {
        return false
    }
    if contains(err.message(), needle) {
        return true
    }
    var next = err.cause()
    for i in 0..64 {
        if next == nil {
            return false
        }
        if contains(next.message(), needle) {
            return true
        }
        next = next.cause()
    }
    _ = next
    return false
}

/// Several errors as one, for a loop that should report every failure rather
/// than stop at the first: nil when every one is nil, the error itself when
/// exactly one is not, and otherwise an error whose message is the non-nil
/// messages in order, joined by `"; "`, and whose cause is the first of them.
///
/// ```kite
/// let none: [error] = [nil, nil]
/// assert(join(none) == nil, "nothing failed")
/// let err = join([errors.new("a is missing"), nil, errors.new("b is missing")])
/// assert(message_or(err, "") == "a is missing; b is missing", "both are reported")
/// ```
///
/// The cause is the first failure so that [`root`] and [`chain`] still lead
/// somewhere; the others are in the message only.
pub fn join(errs: [error]) -> error {
    var first: error = nil
    var messages: [str] = []
    for err in errs {
        if err != nil {
            if messages.len() == 0 {
                first = err
            }
            messages.push(err.message())
        }
    }
    if messages.len() == 0 {
        return nil
    }
    if messages.len() == 1 {
        return first
    }
    return errors.because(joined(messages, "; "), first)
}

/// The prelude's `join`, which this module's own `join` hides here: the
/// pieces joined in pairs, and then the pairs in pairs. Adding each message to
/// one growing string copied everything before it every time, so joining a
/// hundred thousand errors took seconds.
fn joined(pieces: [str], sep: str) -> str {
    var level = pieces
    for level.len() > 1 {
        var next: [str] = []
        var i = 0
        for i + 1 < level.len() {
            next.push(level[i] + sep + level[i + 1])
            i += 2
        }
        if i < level.len() {
            next.push(level[i])
        }
        level = next
    }
    return level[0]
}

/// The message, or a stand-in for nil, so a caller can print without testing.
pub fn message_or(err: error, absent: str) -> str {
    if err == nil {
        return absent
    }
    return err.message()
}
