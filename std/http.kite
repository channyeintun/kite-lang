// std/http — talking to a server, and answering one.
//
// The two halves are not symmetric. A client runs in a sandbox that already
// has `fetch` and `EventSource`, so the client half is a declared boundary
// over those and everything else is Kite. A server runs somewhere with
// sockets, which no Kite target has yet — so the server half here is the part
// that needs no sockets: the types, the router, and handlers that can be
// called directly and tested without a network.
//
// A 404 is a `Response`, not an error: the request succeeded and the answer
// was "no". Only a transport failure is an `error`.
//
// Any method the host will send, this will send — `fetch` forbids only
// CONNECT, TRACE and TRACK — so QUERY works here the day a server answers it,
// with no change to this module.

use std/task

// ---- the declared boundary --------------------------------------------------
//
// Requesting and answering is these six functions. The glue is generated from
// them, so what the host must supply and what the program may ask cannot drift
// apart.

/// `credentials` and `redirect` cross as the words `fetch` itself uses, built
/// by [`credentials_word`] and [`redirect_word`] from enums, so a caller
/// cannot misspell one and a value added to either enum is a compile error at
/// every place that has to know.
@host("net")
extern fn fetch_start(
    method: str,
    url: str,
    body: str,
    headers: str,
    credentials: str,
    redirect: str,
) -> int

/// 0 while in flight, 1 when it arrived, 2 when the transport failed.
@host("net")
extern fn fetch_state(id: int) -> int

@host("net")
extern fn fetch_status(id: int) -> int

@host("net")
extern fn fetch_body(id: int) -> str

/// Every header of a response that arrived, as `name: value` lines — read
/// once, beside the status, and carried by the `Response` from then on. A
/// header read back from the host by handle, whenever the program asked,
/// meant the host could never let a request go.
@host("net")
extern fn fetch_headers(id: int) -> str

@host("net")
extern fn fetch_error(id: int) -> str

// ---- the event stream boundary ----------------------------------------------
//
// Server-sent events are `EventSource`, which every browser has. It is not the
// general streaming reader `fetch` would give: `EventSource` issues a GET and
// carries no headers of its own, so a stream behind an `Authorization` header
// is out of reach and a cookie or a token in the URL is what is left. What it
// supplies in exchange is reconnection — a dropped stream comes back on its
// own, with `Last-Event-ID`, and nothing here has to know it happened.
//
// An event is taken off a queue rather than pushed at a callback, because a
// callback would be a second way for control to enter a program.

/// `names` is the event names to deliver besides the default `message`, one
/// per line — the same shape headers cross in, since only text crosses.
///
/// They are given at open rather than added afterwards because a listener
/// registered after the stream is running misses whatever already arrived, and
/// a race in a standard library is a bug every program inherits.
@host("net")
extern fn sse_open(url: str, names: str) -> int

/// 0 while connecting, 1 once open, 2 once the stream failed for good, 3 once
/// the program closed it.
///
/// A stream that drops and reconnects stays 1: reconnection is the host's job
/// and not an event in the program. Closing is distinct from failing because a
/// program that closed a stream and then asked it for an event has a bug of a
/// different kind than one whose network went away.
@host("net")
extern fn sse_state(id: int) -> int

/// How many events have arrived and not yet been taken.
@host("net")
extern fn sse_pending(id: int) -> int

/// Take the oldest event and answer its `data`.
///
/// The name and the id of that same event are read back with the two
/// functions below, the way a response's status is read back from its
/// handle. Data crosses on its own because data is the part that can contain
/// anything, newlines included, and a `name: value` encoding would mangle it.
@host("net")
extern fn sse_next(id: int) -> str

@host("net")
extern fn sse_event_name(id: int) -> str

@host("net")
extern fn sse_event_id(id: int) -> str

/// Also deliver events whose `event:` field is `name`.
///
/// `EventSource` has no wildcard — a named event arrives only for a listener
/// registered under that name — so a program that wants one says so.
@host("net")
extern fn sse_listen(id: int, name: str) -> int

@host("net")
extern fn sse_close(id: int) -> int

// ---- requests and responses -------------------------------------------------

/// What a server's handler is asked: the `method`, the `path` (query string included), the `body`, and the `headers` as `name: value` lines.
pub struct Request {
    pub method: str
    pub path: str
    pub body: str
    /// `name: value` pairs, one per line — the shape that crosses the host
    /// boundary, since only text does.
    pub headers: str
}

/// An answer: a `status`, a `body` and headers. Build one with [`ok`], [`not_found`], [`status`] or [`redirect`]; a client receives one from [`get`] and the others, and the headers it arrived with are read with [`header`].
pub struct Response {
    pub status: int
    pub body: str
    /// The headers it arrived with, as `name: value` lines, and "" for a
    /// response built in Kite. Taken when the response arrived rather than
    /// asked of the host by handle later: a handle the program might still
    /// ask with was a request the host could never let go.
    headers: str
    /// The headers to send when this is a server's answer: kept as pairs, not
    /// text, for the reason [`respond`] takes them as pairs.
    outgoing: [Header]
}

/// A 200 response with this body and no headers.
///
/// ```kite
/// assert(ok("hi").status == 200, "ok is 200")
/// assert(ok("hi").body == "hi", "and carries the body")
/// ```
pub fn ok(body: str) -> Response {
    return Response{ status: 200, body: body, headers: "", outgoing: [] }
}

/// A 404 response whose body is `not found`.
///
/// ```kite
/// assert(not_found().status == 404, "not found is 404")
/// ```
pub fn not_found() -> Response {
    return Response{ status: 404, body: "not found", headers: "", outgoing: [] }
}

/// A response with any status code. Nothing is checked here, so that a
/// handler can be tested whatever it builds; [`respond`] refuses a code outside
/// 200 to 599 (a 1xx is never the last word) and a body on a 204, 205 or a 304,
/// and [`run`] answers 500 in its place.
pub fn status(code: int, body: str) -> Response {
    return Response{ status: code, body: body, headers: "", outgoing: [] }
}

/// The response with one more header line to send, after the ones it has.
///
/// [`respond`] sends it, after the headers it is given, and [`run`] sends it
/// through [`respond`], so the same rules hold: a name that is not a token, or
/// a line break, a control character or a character past U+00FF in a value, is
/// not sent — `respond` says why, and [`run`] answers 500 instead of putting it
/// on the wire. A name that frames the message — `Content-Length`,
/// `Transfer-Encoding`, `Connection`, `Keep-Alive`, `Upgrade`, `TE`, `Trailer`,
/// `Proxy-Connection` — is refused the same way: the host knows the body's
/// length in bytes and a handler does not, and a wrong one lets the body be
/// read as the next response on the connection. A name added twice goes out
/// twice, which is what `Set-Cookie` needs, and a `Content-Type` here replaces
/// the default `text/plain`. This is not what
/// [`header`] reads: that is what arrived, and a response built in Kite
/// arrived from nowhere.
///
/// ```kite
/// let r = with_header(ok("{}"), "content-type", "application/json")
/// assert(r.status == 200, "the status is untouched")
/// assert(header(r, "content-type") == "", "and a header to send is not one that arrived")
/// ```
pub fn with_header(r: Response, name: str, value: str) -> Response {
    var more = r.outgoing
    more.push(Header{ name: name, value: value })
    return Response{ status: r.status, body: r.body, headers: r.headers, outgoing: more }
}

/// A response whose body is JSON, with the status given and a `Content-Type` of
/// `application/json; charset=utf-8`. The body is sent as it is: it is up to
/// the caller to have made it JSON, with `std/json`.
///
/// ```kite
/// let r = json(201, "{\"id\":7}")
/// assert(r.status == 201 && r.body == "{\"id\":7}", "the status and the body as given")
/// ```
pub fn json(code: int, body: str) -> Response {
    return with_header(status(code, body), "content-type", "application/json; charset=utf-8")
}

/// A `303 See Other` to `location`: the client goes on to a GET of that
/// address, whatever the request's method was, which is what an answer to a
/// form post wants. The location is a header value, so a line break or a
/// character past U+00FF in it makes [`run`] answer 500 rather than send it:
/// give it a path made with [`encode_component`].
///
/// ```kite
/// let r = redirect("/done")
/// assert(r.status == 303 && r.body == "", "see other, with nothing to read")
/// ```
pub fn redirect(location: str) -> Response {
    return with_header(status(303, ""), "location", location)
}

/// Whether the status is in the 2xx range.
pub fn succeeded(r: Response) -> bool {
    return r.status >= 200 && r.status < 300
}

/// A header of a response that came from the host, answered as `fetch`'s own
/// `headers.get` answers it: the name is compared ignoring ASCII case, and a
/// header that arrived more than once answers with every value, in order,
/// joined by `, `. A header the response did not carry answers with an empty
/// string, and so does every header of a response built in Kite, which
/// carries none.
pub fn header(r: Response, name: str) -> str {
    var values: [str] = []
    for line in split(r.headers, "\n") {
        let at = line.index_of(":")
        if at > 0 && equal_ignoring_case(line.slice(0, at), name) {
            // The one space the host writes after the colon, and not `trim`:
            // the host has already stripped what HTTP counts as whitespace,
            // and `trim` would also take a no-break space that is part of the
            // value.
            var from = at + 1
            if from < line.len() && line.code_at(from) == 32 {
                from += 1
            }
            values.push(line.slice(from, line.len()))
        }
    }
    return join(values, ", ")
}

// ---- what a request carries besides its body --------------------------------

/// Whether cookies, TLS client certificates and HTTP auth go out with a
/// request, and whether a `Set-Cookie` coming back is kept.
///
/// This is the one `fetch` option a program cannot work around: an app that
/// signs in with a cookie sends one on every request, and there is no header a
/// caller can set instead — the browser will not let a page write `Cookie`.
pub enum Credentials {
    /// Never. A request that is purely public data.
    Omit
    /// To the origin the page was served from, and nowhere else. What `fetch`
    /// does when nobody says.
    SameOrigin
    /// Cross-origin too. The server has to answer with
    /// `Access-Control-Allow-Credentials: true` and name a single origin —
    /// `*` is refused by the browser precisely here.
    Include
}

/// What to do when the answer is a redirect.
pub enum Redirect {
    /// Follow it, up to the browser's own limit. The default.
    Follow
    /// Treat it as a transport failure, which arrives here as an `error`.
    Error
    /// Hand back the redirect itself, unfollowed and opaque.
    Manual
}

/// Everything about a request except its method, its URL and its body.
///
/// A struct rather than six more parameters, which is what the specification
/// says to do with many optional inputs — and it means the next option added
/// here does not change any call site that did not want it.
///
/// `mode` is deliberately absent. Its only interesting value is `no-cors`,
/// which yields a response whose status is 0 and whose body cannot be read:
/// the request goes out and the program is told nothing. A boundary that can
/// only be used to lose information is not worth the word.
pub struct Options {
    /// `name: value` pairs, one per line.
    pub headers: str
    pub credentials: Credentials
    pub redirect: Redirect
}

/// The defaults, to be changed where a caller cares:
///
/// ```kite ignore
/// let opts = http.Options{ ..http.sending(), credentials: http.Credentials.Include }
/// let (res, err) = await http.send_with("POST", url, body, opts)
/// ```
pub fn sending() -> Options {
    return Options{
        headers: "",
        credentials: Credentials.SameOrigin,
        redirect: Redirect.Follow,
    }
}

/// The same, carrying the caller's headers as `name: value` lines.
///
/// **Not for a value that came from outside the program.** The lines are
/// split on the newline on the way to `fetch`, so a newline inside a value
/// stops being data and starts a header of its own: `"x-user: \(name)"`, with
/// a name someone else chose, is one newline away from sending whatever
/// `Authorization` they wrote. That cannot be told from two headers the
/// program meant — the joined text is all there is — so it is not refused
/// here, and [`sending_pairs`] is the form to use instead. What *can* be told
/// is refused when the request is sent: a line that is not `name: value`, or
/// a carriage return inside one.
pub fn sending_with(headers: str) -> Options {
    return Options{ ..sending(), headers: headers }
}

/// The same, with headers given as pairs — the form to use whenever a value
/// came from somewhere else.
///
/// Joined here from parts that arrive separately, which is what makes "the
/// program meant two headers" and "a value added one" decidable, as it is for
/// [`respond`]. A name that is not an HTTP token, or a value carrying a line
/// break, a NUL or another control character, or a character past U+00FF, is
/// refused rather than stripped — as `respond` refuses it:
/// there is no escaping that keeps the meaning, and the host would otherwise
/// fail with its own wording.
///
/// ```kite ignore
/// let (opts, err) = http.sending_pairs([http.Header{ name: "x-user", value: name }])
/// check err
/// let (res, rerr) = await http.send_with("GET", url, "", opts)
/// ```
pub fn sending_pairs(headers: [Header]) -> (Options, error) {
    var lines: [str] = []
    for h in headers {
        if !is_token(h.name) {
            return _, errors.new("http: `\(h.name)` is not a header name")
        }
        if breaks_a_line(h.value) {
            return _, errors.new("http: the value of `\(h.name)` contains a line break")
        }
        if has_nul(h.value) {
            return _, errors.new("http: the value of `\(h.name)` contains a NUL byte")
        }
        if !carriable(h.value) {
            return _, errors.new(
                "http: the value of `\(h.name)` contains a control character or one past U+00FF, which a header cannot carry; encode it first, with encode_component",
            )
        }
        lines.push("\(h.name): \(h.value)")
    }
    return sending_with(join(lines, "\n")), nil
}

/// Whether `name` is an HTTP token (RFC 9110 §5.6.2): what a header name is
/// made of, and nothing — no space, no colon, no line break — that could end
/// it early.
fn is_token(name: str) -> bool {
    if name.len() == 0 {
        return false
    }
    for i in 0..name.len() {
        let c = name.code_at(i)
        let letter = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
        let digit = c >= 48 && c <= 57
        if !letter && !digit && "!#$%&'*+-.^_`|~".index_of(name.slice(i, i + 1)) < 0 {
            return false
        }
    }
    return true
}

/// Why a block of `name: value` lines cannot go out, or nil.
///
/// The host drops a line with no colon without a word, so a value carrying a
/// newline and then something that is not a header vanished rather than
/// failing. A line break at the very end of a line is allowed, since `\r\n`
/// between lines is a habit worth tolerating; one anywhere else is not. A value
/// the host cannot put on the wire is refused here, in Kite's words, rather than
/// failing in the host's.
///
/// ```kite
/// assert(header_lines_error("x-a: b\r\nx-c: d\r\n") == nil, "ordinary lines")
/// assert(header_lines_error("x-price: 5\u{20AC}") != nil, "a character past U+00FF")
/// assert(header_lines_error("x-name: caf\u{E9}\tok") == nil, "Latin-1 and a tab")
/// ```
fn header_lines_error(text: str) -> error {
    var n = 0
    for raw in split(text, "\n") {
        n += 1
        var line = raw
        if ends_with(line, "\r") {
            line = line.slice(0, line.len() - 1)
        }
        if line.trim().len() == 0 {
            continue
        }
        let at = line.index_of(":")
        if line.index_of("\r") >= 0 || at <= 0 || !is_token(line.slice(0, at).trim()) {
            return errors.new("http: header line \(n) is not `name: value`")
        }
        if !carriable(line.slice(at + 1, line.len())) {
            return errors.new(
                "http: header line \(n) has a control character or one past U+00FF in its value, which a header cannot carry; encode it first, with encode_component",
            )
        }
    }
    return nil
}

/// The word `fetch` knows this by.
fn credentials_word(c: Credentials) -> str {
    return match c {
        Omit => "omit",
        SameOrigin => "same-origin",
        Include => "include",
    }
}

fn redirect_word(r: Redirect) -> str {
    return match r {
        Follow => "follow",
        Error => "error",
        Manual => "manual",
    }
}

// ---- the client -------------------------------------------------------------

/// A GET request to `url` and no body, waiting for the answer.
///
/// Any status the server answers with, a 404 or a 500 as much as a 200, comes back as the [`Response`]; the error is for a request that got no answer at all, and says `http GET <url>:` and the host's reason.
pub async fn get(url: str) -> (Response, error) {
    return await send("GET", url, "", "")
}

/// A POST request to `url`, with `body` and a `content-type: application/json` header, waiting for the answer.
///
/// Any status the server answers with, a 404 or a 500 as much as a 200, comes back as the [`Response`]; the error is for a request that got no answer at all, and says `http POST <url>:` and the host's reason.
pub async fn post(url: str, body: str) -> (Response, error) {
    return await send("POST", url, body, "content-type: application/json")
}

/// A PUT request to `url`, with `body` and a `content-type: application/json` header, waiting for the answer.
///
/// Any status the server answers with, a 404 or a 500 as much as a 200, comes back as the [`Response`]; the error is for a request that got no answer at all, and says `http PUT <url>:` and the host's reason.
pub async fn put(url: str, body: str) -> (Response, error) {
    return await send("PUT", url, body, "content-type: application/json")
}

/// A DELETE request to `url` and no body, waiting for the answer.
///
/// Any status the server answers with, a 404 or a 500 as much as a 200, comes back as the [`Response`]; the error is for a request that got no answer at all, and says `http DELETE <url>:` and the host's reason.
pub async fn delete(url: str) -> (Response, error) {
    return await send("DELETE", url, "", "")
}

/// A PATCH request to `url`, with `body` and a `content-type: application/json` header, waiting for the answer.
///
/// Any status the server answers with, a 404 or a 500 as much as a 200, comes back as the [`Response`]; the error is for a request that got no answer at all, and says `http PATCH <url>:` and the host's reason.
pub async fn patch(url: str, body: str) -> (Response, error) {
    return await send("PATCH", url, body, "content-type: application/json")
}

/// A HEAD request. The status and the headers arrive; the body is empty by
/// definition, not by accident.
pub async fn head(url: str) -> (Response, error) {
    return await send("HEAD", url, "", "")
}

/// A OPTIONS request to `url` and no body, waiting for the answer.
///
/// Any status the server answers with, a 404 or a 500 as much as a 200, comes back as the [`Response`]; the error is for a request that got no answer at all, and says `http OPTIONS <url>:` and the host's reason.
pub async fn options(url: str) -> (Response, error) {
    return await send("OPTIONS", url, "", "")
}

/// A QUERY request: a read that carries a body.
///
/// QUERY is what GET would be if a request could ask a long question — safe,
/// idempotent and cacheable, with the question in the body instead of squeezed
/// into a URL and its length limits. It is still a draft
/// (`draft-ietf-httpbis-safe-method-w-body`) rather than a finished RFC.
///
/// It works today because `fetch` forbids exactly three methods — CONNECT,
/// TRACE and TRACK — and passes every other token through untouched. Two
/// things follow, and both are the server's business rather than this
/// module's: QUERY is not CORS-safelisted, so a cross-origin call is preceded
/// by a preflight `OPTIONS`; and a server that does not know the method
/// answers 405 rather than failing, which is a `Response` here and not an
/// `error`.
///
/// The body is sent as JSON. A different query language — SQL, GraphQL,
/// anything — goes through `send` with the content type it wants.
pub async fn query(url: str, body: str) -> (Response, error) {
    return await send("QUERY", url, body, "content-type: application/json")
}

/// A request with headers and nothing else to say about it — which is most of
/// them, and is what `get`, `post` and the rest are written in terms of.
pub async fn send(method: str, url: str, body: str, headers: str) -> (Response, error) {
    return await send_with(method, url, body, sending_with(headers))
}

/// The same, saying what the request carries besides its body.
///
/// The one every other function here goes through. Waiting is
/// `task.wait_host()`: what is being waited for is not another task but the
/// host itself, and saying so is what lets the runtime hand the event loop
/// back rather than spin.
pub async fn send_with(
    method: str,
    url: str,
    body: str,
    options: Options,
) -> (Response, error) {
    let bad = header_lines_error(options.headers)
    if bad != nil {
        return _, errors.new("http \(method) \(url): \(bad.message())")
    }
    let id = fetch_start(
        method,
        url,
        body,
        options.headers,
        credentials_word(options.credentials),
        redirect_word(options.redirect),
    )
    for fetch_state(id) == 0 {
        task.wait_host()
        task.yield()
    }
    if fetch_state(id) == 2 {
        return _, errors.new("http \(method) \(url): \(fetch_error(id))")
    }
    // The body last: reading it is what lets the host forget the request, so
    // the status and the headers are taken before it, and travel with the
    // `Response` from here on.
    let code = fetch_status(id)
    let headers = fetch_headers(id)
    return Response{ status: code, body: fetch_body(id), headers: headers, outgoing: [] }, nil
}

// ---- server-sent events -----------------------------------------------------
//
// A stream is a handle and events are taken off it. Nothing is pushed at the
// program: an event arrives when a task asks for one, which is the same shape
// as awaiting a request and needs no second notion of control flow.

/// An open stream of server-sent events, from [`events`] or [`events_named`]. Take events off it with [`receive`] and end it with [`close`].
pub struct Events {
    id: int
}

/// One server-sent event: its `name`, its `id` and its `data`.
pub struct Event {
    /// The `event:` field, or "message" when the event had none.
    pub name: str
    /// The `id:` field, or "" when the event had none. The host replays it as
    /// `Last-Event-ID` after a reconnection, so a program rarely needs it.
    pub id: str
    pub data: str
}

/// Open a stream of server-sent events, waiting until it is open.
///
/// GET only, and no headers: that is `EventSource`, not a choice made here.
/// A stream that needs an `Authorization` header cannot be opened this way —
/// a cookie the browser already sends, or a token in the URL, is what is left.
pub async fn events(url: str) -> (Events, error) {
    return await events_named(url, "")
}

/// The same, also delivering events whose `event:` field is one of `names`,
/// given one per line.
///
/// `EventSource` hands a named event to a listener registered for that name
/// and offers no way to ask for all of them, so a program that wants
/// `event: tick` says `tick` here. Naming them at open is what keeps the first
/// one from arriving before anything is listening.
pub async fn events_named(url: str, names: str) -> (Events, error) {
    let id = sse_open(url, names)
    for sse_state(id) == 0 {
        task.wait_host()
        task.yield()
    }
    if sse_state(id) == 2 {
        return _, errors.new("sse \(url): the stream would not open")
    }
    return Events{ id: id }, nil
}

/// Deliver events named `name` from now on.
///
/// For a name discovered while the stream is running. Anything known before it
/// opened belongs in `events_named`, which cannot miss an event this may.
pub fn listen(stream: Events, name: str) {
    sse_listen(stream.id, name)
}

/// The next event, waiting for one to arrive.
///
/// Waiting is `task.wait_host()` for the reason a request waits that way: what
/// the task waits for is the host's event loop, and a scheduler told so hands
/// the loop back rather than spinning. A stream that is merely quiet is not a
/// stalled program, and this is what tells the two apart.
pub async fn receive(stream: Events) -> (Event, error) {
    for sse_pending(stream.id) == 0 {
        if sse_state(stream.id) == 2 {
            return _, errors.new("sse: the stream failed")
        }
        if sse_state(stream.id) == 3 {
            return _, errors.new("sse: the stream is closed")
        }
        task.wait_host()
        task.yield()
    }
    // `sse_next` takes the event; the name and id are that event's, so they
    // have to be read after it and before anything takes another.
    let data = sse_next(stream.id)
    return Event{
        name: sse_event_name(stream.id),
        id: sse_event_id(stream.id),
        data: data,
    }, nil
}

/// How many events are waiting. A program with something else to do asks this
/// rather than `receive`.
pub fn pending(stream: Events) -> int {
    return sse_pending(stream.id)
}

/// Stop the stream, and stop it reconnecting.
///
/// Events that already arrived stay readable: `receive` drains what is
/// waiting and only then reports the stream closed. Discarding them would
/// throw away data the host had already delivered, which is a loss a program
/// has no way to notice.
pub fn close(stream: Events) {
    sse_close(stream.id)
}

// ---- the server -------------------------------------------------------------
//
// A handler is a function from a request to a response. Anything that wants to
// wrap one is a function that takes a handler and returns a handler, which
// needs no framework — so there is no middleware stack, no dependency
// injection and no ORM here, deliberately.

/// A method, a path pattern and the function that answers requests that fit them; [`route`] builds one, and [`serve`] and [`run`] take a slice of them.
pub struct Route {
    pub method: str
    /// A path, with `:name` standing for one segment.
    pub pattern: str
    pub handle: fn(Request) -> Response
}

/// A [`Route`]: `handle` answers a `method` request whose path fits `pattern`, where `:name` in the pattern stands for one segment. Routes are tried in the order they are given, and the first that fits answers.
pub fn route(method: str, pattern: str, handle: fn(Request) -> Response) -> Route {
    return Route{ method: method, pattern: pattern, handle: handle }
}

/// The first route that matches, or a 404.
///
/// Matched on the path alone: a query string or a fragment after it takes no
/// part, so `/?utm=1` is `/` and `/users/7?tab=posts` is `/users/:id`. Read
/// the query with [`query_parameter`].
pub fn serve(routes: [Route], request: Request) -> Response {
    for r in routes {
        if r.method == request.method {
            if matches(r.pattern, request.path) {
                return r.handle(request)
            }
        }
    }
    return not_found()
}

/// Whether a path matches a pattern, where `:name` stands for one segment of at
/// least one character.
///
/// `path` may be a whole request target: whatever follows a `?` or a `#` is
/// not part of the path, and is not compared. The server hands a handler the
/// target as the client sent it, query and all, and routing on that made a
/// link with `?utm=1` on it a 404.
///
/// ```kite
/// assert(matches("/users/:id", "/users/7?tab=posts"), "a capture, and the query is not compared")
/// assert(!matches("/users/:id", "/users/"), "a parameter is not an empty segment")
/// ```
pub fn matches(pattern: str, path: str) -> bool {
    let want = split(pattern, "/")
    let found = split(path_part(path), "/")
    if want.len() != found.len() {
        return false
    }
    for i in 0..want.len() {
        let w = want[i]
        if !starts_with(w, ":") {
            if w != found[i] {
                return false
            }
        } else if found[i].len() == 0 {
            // A parameter captures something: `/users/` is not `/users/:id`.
            return false
        }
    }
    return true
}

/// The value a `:name` segment captured, or nil — and nil for an empty segment.
///
/// As it appears in the path — still percent-encoded, so `/users/a%20b`
/// captures `a%20b` — and without the query: `/users/7?tab=posts` captures
/// `7`, where it used to capture `7?tab=posts`.
pub fn parameter(pattern: str, path: str, name: str) -> Option<str> {
    let want = split(pattern, "/")
    let found = split(path_part(path), "/")
    if want.len() != found.len() {
        return nil
    }
    for i in 0..want.len() {
        if want[i] == ":\(name)" {
            if found[i].len() == 0 {
                return nil
            }
            return found[i]
        }
    }
    return nil
}

/// A request target without its query or fragment: the part a route matches.
fn path_part(target: str) -> str {
    var end = target.len()
    let question = target.index_of("?")
    if question >= 0 {
        end = question
    }
    let hash = target.index_of("#")
    if hash >= 0 && hash < end {
        end = hash
    }
    return target.slice(0, end)
}

/// The value of a query-string parameter, or nil when the request has none by
/// that name.
///
/// Decoded as the URL Standard decodes `application/x-www-form-urlencoded`,
/// which is what a form and `URLSearchParams` send: `+` is a space, `%XX` is a
/// byte, and the bytes are read as UTF-8, with U+FFFD for a sequence that is
/// not. The name is decoded the same way before it is compared. A parameter
/// written with no `=` has the value "", and when a name repeats the first one
/// answers.
///
/// ```kite
/// let r = Request{ method: "GET", path: "/search?q=kite+lang&page=2", body: "", headers: "" }
/// assert(or_else(query_parameter(r, "q"), "") == "kite lang", "a plus is a space")
/// assert(or_else(query_parameter(r, "page"), "") == "2", "the second parameter")
/// assert(query_parameter(r, "sort") == nil, "one that is not there")
/// ```
pub fn query_parameter(r: Request, name: str) -> Option<str> {
    for pair in form_pairs(query_text(r.path)) {
        if pair.name == name {
            return pair.value
        }
    }
    return nil
}

/// Every value of a query-string parameter that repeats, decoded as
/// [`query_parameter`] decodes, in the order they were written. Empty when the
/// request has none by that name.
///
/// ```kite
/// let r = Request{ method: "GET", path: "/f?tag=a&tag=b%20c&x=1", body: "", headers: "" }
/// let tags = query_parameters(r, "tag")
/// assert(tags.len() == 2 && tags[0] == "a" && tags[1] == "b c", "both, in order")
/// assert(query_parameters(r, "none").len() == 0, "none at all")
/// ```
pub fn query_parameters(r: Request, name: str) -> [str] {
    var out: [str] = []
    for pair in form_pairs(query_text(r.path)) {
        if pair.name == name {
            out.push(pair.value)
        }
    }
    return out
}

/// A parameter of a form posted as `application/x-www-form-urlencoded`, read
/// from the request's body the way [`query_parameter`] reads the query: names
/// and values decoded, the first one answering when a name repeats.
///
/// The content type is not looked at; a body that is not a urlencoded form
/// simply has no such parameter.
///
/// ```kite
/// let r = Request{ method: "POST", path: "/", body: "user=ada+l&pw=a%26b", headers: "" }
/// assert(or_else(form_parameter(r, "user"), "") == "ada l", "a plus is a space")
/// assert(or_else(form_parameter(r, "pw"), "") == "a&b", "an escaped ampersand")
/// assert(form_parameter(r, "x") == nil, "one that is not there")
/// ```
pub fn form_parameter(r: Request, name: str) -> Option<str> {
    for pair in form_pairs(r.body) {
        if pair.name == name {
            return pair.value
        }
    }
    return nil
}

/// The query of a request target, without its `?` or any fragment, or "".
fn query_text(target: str) -> str {
    let question = target.index_of("?")
    if question < 0 {
        return ""
    }
    let hash = target.index_of("#")
    if hash >= 0 && hash < question {
        // The `?` is inside the fragment, which is not a query.
        return ""
    }
    var query = target.slice(question + 1, target.len())
    let end = query.index_of("#")
    if end >= 0 {
        query = query.slice(0, end)
    }
    return query
}

/// `a=1&b=2` as decoded name and value pairs, in order. A piece with no `=`
/// has the value "", and an empty piece (`a=1&&b=2`) is nothing.
fn form_pairs(body: str) -> [Header] {
    var out: [Header] = []
    for piece in split(body, "&") {
        if piece.len() > 0 {
            let eq = piece.index_of("=")
            var key = piece
            var value = ""
            if eq >= 0 {
                key = piece.slice(0, eq)
                value = piece.slice(eq + 1, piece.len())
            }
            out.push(Header{ name: form_decoded(key), value: form_decoded(value) })
        }
    }
    return out
}

/// Text as one URL component: every byte of its UTF-8 that is not a letter, a
/// digit, `-`, `.`, `_` or `~` written as `%XX`, in upper case. The same set
/// `encodeURIComponent` keeps, less `!*'()`, which RFC 3986 reserves.
///
/// ```kite
/// assert(encode_component("a b&c=d/é") == "a%20b%26c%3Dd%2F%C3%A9", "reserved characters and UTF-8")
/// assert(encode_component("Az09-._~") == "Az09-._~", "the unreserved set stays")
/// ```
pub fn encode_component(s: str) -> str {
    let digits = "0123456789ABCDEF"
    var out: [str] = []
    for i in 0..s.len() {
        let c = s.code_at(i)
        let letter = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
        let digit = c >= 48 && c <= 57
        if letter || digit || c == 45 || c == 46 || c == 95 || c == 126 {
            out.push(s.slice(i, i + 1))
        } else {
            for b in utf8_encoded(c) {
                out.push("%")
                out.push(digits.slice(b / 16, b / 16 + 1))
                out.push(digits.slice(b % 16, b % 16 + 1))
            }
        }
    }
    return join(out, "")
}

/// The UTF-8 bytes of one code point.
fn utf8_encoded(code: int) -> [int] {
    if code < 128 {
        return [code]
    }
    if code < 2048 {
        return [192 + code / 64, 128 + code % 64]
    }
    if code < 65536 {
        return [224 + code / 4096, 128 + (code / 64) % 64, 128 + code % 64]
    }
    return [240 + code / 262144, 128 + (code / 4096) % 64, 128 + (code / 64) % 64, 128 + code % 64]
}

/// A URL component with its `%XX` escapes decoded, read as UTF-8 (U+FFFD for a
/// sequence that is not). A `+` stays a `+`: it is a space only in a form, so
/// use this on a path segment and [`form_decoded`] on a query or a body. A `%`
/// that does not begin an escape stands for itself.
///
/// ```kite
/// assert(decode_component("a%20b+c%C3%A9") == "a b+cé", "an escape is decoded, a plus is not")
/// ```
pub fn decode_component(s: str) -> str {
    return percent_decoded(s, false)
}

/// Pairs as a query string, without the `?`: `a=1&b=x%20y`. Names and values
/// are encoded with [`encode_component`], so what [`query_parameter`] reads
/// back is what went in.
///
/// ```kite
/// let q = query_string([Header{ name: "q", value: "kite lang" }, Header{ name: "page", value: "2" }])
/// assert(q == "q=kite%20lang&page=2", "joined with ampersands")
/// ```
pub fn query_string(pairs: [Header]) -> str {
    var parts: [str] = []
    for p in pairs {
        parts.push("\(encode_component(p.name))=\(encode_component(p.value))")
    }
    return join(parts, "&")
}

/// `application/x-www-form-urlencoded` text decoded: `+` is a space, `%XX` a
/// byte, and a `%` not followed by two hex digits is itself. The bytes are read
/// as UTF-8, U+FFFD for a sequence that is not.
///
/// What [`query_parameter`] decodes with, public so that a page reading its own
/// address (`window.parameter`) decodes exactly as the server does.
///
/// ```kite
/// assert(form_decoded("a+b%20c%41%zz") == "a b cA%zz", "a bad escape stays, the rest is decoded")
/// ```
pub fn form_decoded(text: str) -> str {
    return percent_decoded(text, true)
}

/// Escapes decoded, and `+` as a space only when asked: a form says it is one,
/// a path segment does not.
fn percent_decoded(text: str, plus_is_space: bool) -> str {
    var out: [str] = []
    var bytes: [int] = []
    var i = 0
    for i < text.len() {
        let c = text.code_at(i)
        if c == 37 {
            let high = hex_value(text, i + 1)
            let low = hex_value(text, i + 2)
            if high >= 0 && low >= 0 {
                bytes.push(high * 16 + low)
                i += 3
                continue
            }
        }
        if bytes.len() > 0 {
            out.push(utf8_decoded(bytes))
            bytes = []
        }
        if c == 43 && plus_is_space {
            out.push(" ")
        } else {
            out.push(text.slice(i, i + 1))
        }
        i += 1
    }
    if bytes.len() > 0 {
        out.push(utf8_decoded(bytes))
    }
    return join(out, "")
}

fn hex_value(text: str, at: int) -> int {
    if at >= text.len() {
        return -1
    }
    let c = text.code_at(at)
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    return -1
}

/// Bytes as UTF-8, the way the Encoding Standard decodes them: each maximal
/// run that cannot begin or continue a character becomes one U+FFFD, and the
/// byte that broke a sequence is read again as the start of the next.
fn utf8_decoded(bytes: [int]) -> str {
    var out: [str] = []
    var i = 0
    for i < bytes.len() {
        let b = bytes[i]
        if b < 128 {
            out.push(text.from_code(b))
            i += 1
            continue
        }
        var need = 0
        var code = 0
        var lower = 128
        var upper = 191
        if b >= 194 && b <= 223 {
            need = 1
            code = b & 31
        } else if b >= 224 && b <= 239 {
            need = 2
            code = b & 15
            if b == 224 {
                lower = 160
            }
            if b == 237 {
                upper = 159
            }
        } else if b >= 240 && b <= 244 {
            need = 3
            code = b & 7
            if b == 240 {
                lower = 144
            }
            if b == 244 {
                upper = 143
            }
        } else {
            out.push(text.from_code(65533))
            i += 1
            continue
        }
        var j = i + 1
        var whole = true
        for k in 0..need {
            if whole {
                if j >= bytes.len() || bytes[j] < lower || bytes[j] > upper {
                    whole = false
                } else {
                    code = (code << 6) | (bytes[j] & 63)
                    lower = 128
                    upper = 191
                    j += 1
                }
            }
        }
        if whole {
            out.push(text.from_code(code))
        } else {
            out.push(text.from_code(65533))
        }
        i = j
    }
    return join(out, "")
}

/// A header's value out of the `name: value` lines a request carries.
pub fn request_header(request: Request, name: str) -> Option<str> {
    for line in split(request.headers, "\n") {
        let at = line.index_of(":")
        if at > 0 {
            if equal_ignoring_case(line.slice(0, at), name) {
                return line.slice(at + 1, line.len()).trim()
            }
        }
    }
    return nil
}

/// The value of every line of a request that names this header, in order,
/// where [`request_header`] answers with the first. Names are compared ignoring
/// case. Empty when the request carried none.
///
/// What counts as a line is the host's: the Node server joins a header sent
/// twice into one line with a comma (`1, 2`, which RFC 9110 §5.3 says is the
/// same header), so there it is one entry to split at the commas, and a host
/// that keeps each line gives one entry for each. Node also joins `Cookie`
/// with `; `, and keeps only the first of a header that may appear once
/// (`Host`, `Content-Type`, `User-Agent`, `Authorization` and their kin). Do not
/// split a header whose single value may hold a comma (`Date`, `User-Agent`).
///
/// ```kite
/// let r = Request{ method: "GET", path: "/", body: "", headers: "X-Tag: a\nx-tag: b\nOther: c" }
/// let tags = request_headers(r, "x-tag")
/// assert(tags.len() == 2 && tags[0] == "a" && tags[1] == "b", "both, in order")
/// ```
pub fn request_headers(request: Request, name: str) -> [str] {
    var out: [str] = []
    for line in split(request.headers, "\n") {
        let at = line.index_of(":")
        if at > 0 && equal_ignoring_case(line.slice(0, at), name) {
            out.push(line.slice(at + 1, line.len()).trim())
        }
    }
    return out
}

/// One cookie of the request's `cookie` header, or nil.
///
/// The header is `name=value; name=value`; the value is returned as sent, minus
/// one pair of surrounding double quotes if it has them, and is not
/// percent-decoded, because what a cookie holds is its sender's business. The
/// name is compared exactly. When a name repeats the first answers, and when a
/// request has sent several `cookie` headers they are read in order.
///
/// ```kite
/// let r = Request{ method: "GET", path: "/", body: "", headers: "Cookie: sid=abc; theme=\"dark\"" }
/// assert(or_else(cookie(r, "sid"), "") == "abc", "a plain cookie")
/// assert(or_else(cookie(r, "theme"), "") == "dark", "a quoted one")
/// assert(cookie(r, "other") == nil, "one that was not sent")
/// ```
pub fn cookie(r: Request, name: str) -> Option<str> {
    for header in request_headers(r, "cookie") {
        for piece in split(header, ";") {
            let item = piece.trim()
            let eq = item.index_of("=")
            if eq > 0 && item.slice(0, eq) == name {
                var value = item.slice(eq + 1, item.len())
                if value.len() >= 2 && starts_with(value, "\"") && ends_with(value, "\"") {
                    value = value.slice(1, value.len() - 1)
                }
                return value
            }
        }
    }
    return nil
}

// ---- listening ---------------------------------------------------------------
//
// The half that needs sockets, and the half a Kite target does not have of its
// own. The boundary below is the same shape as every other one in this module:
// numbers and text cross it, a handle stands for what the host holds, and
// nothing is pushed at the program — a request is *taken*, when a task asks
// for one.
//
// That last part is what makes a server here look like the rest of the
// language. A callback-driven server is a second way for control to enter a
// program, and Kite has one.
//
// **What supplies these.** `kitec build --emit wasm` writes a `serve.mjs`
// beside the module when a program declares them: a Node, Deno or Bun adapter
// that listens, queues what arrives, and hands each answer back. WASI's
// `wasi:http/incoming-handler` is the other implementation this boundary was
// shaped for, and it is *not* written — it is a component-model export, and
// `kitec` emits a core module. That is a real gap and it is recorded rather
// than implied.

/// Listen on a port. A handle, or -1 when the host cannot listen — which is
/// the ordinary case in a browser, and is why this answers rather than traps.
@host("net")
extern fn serve_open(port: int) -> int

/// The port actually bound. Asking for 0 gets one the host chose, and a test
/// that must not collide with another test needs to know which.
@host("net")
extern fn serve_port(id: int) -> int

/// How many requests have arrived and not yet been taken.
@host("net")
extern fn serve_pending(id: int) -> int

/// Take the oldest request, yielding its own handle, or -1 when none waits.
@host("net")
extern fn serve_next(id: int) -> int

@host("net")
extern fn serve_method(request: int) -> str

@host("net")
extern fn serve_path(request: int) -> str

@host("net")
extern fn serve_body(request: int) -> str

@host("net")
extern fn serve_headers(request: int) -> str

/// Answer one request. 1 when the host took it, 0 when that request was
/// already answered or never existed, and -1 when the host refused the response
/// and answered 500 itself.
@host("net")
extern fn serve_respond(request: int, status: int, body: str, headers: str) -> int

@host("net")
extern fn serve_error(id: int) -> str

@host("net")
extern fn serve_close(id: int) -> int

/// Something listening on a port.
pub struct Server {
    id: int
}

/// A request that arrived, and the handle to answer it with.
///
/// The handle is kept beside the `Request` rather than inside it, so a
/// `Request` stays a value a test can write out by hand. A handler is a
/// function from a request to a response, and that is only true if a request
/// is something anyone can make.
pub struct Incoming {
    pub request: Request
    id: int
}

/// Start listening. Port 0 asks the host to choose one; `port_of` says which.
///
/// It is `async` because binding a socket is not instant, and a server that
/// answered "which port?" before the host had one would answer wrongly rather
/// than late. Waiting is `task.wait_host()` for the reason everything in this
/// module waits that way: what is being waited for is the host.
pub async fn open(port: int) -> (Server, error) {
    let id = serve_open(port)
    if id < 0 {
        return _, errors.new("http.open: cannot listen on \(port)")
    }
    for serve_port(id) < 0 {
        let failure = serve_error(id)
        if failure != "" {
            return _, errors.new("http.open: \(failure)")
        }
        task.wait_host()
        task.yield()
    }
    return Server{ id: id }, nil
}

/// The port a server is actually listening on.
pub fn port_of(server: Server) -> int {
    return serve_port(server.id)
}

/// Wait for the next request.
///
/// Waiting is `task.wait_host()` for the reason a fetch waits that way: what
/// is being waited for is the host rather than another task, and saying so is
/// what lets the runtime hand the event loop back instead of spinning through
/// a queue that cannot fill while it holds the thread.
///
/// A server that has been [`shut`] with nothing waiting answers with an error
/// rather than waiting: nothing will ever arrive, and a loop around this used
/// to hang there for good. Requests that arrived before the shut are still
/// handed out first.
pub async fn accept(server: Server) -> (Incoming, error) {
    for serve_pending(server.id) == 0 {
        let failure = serve_error(server.id)
        if failure != "" {
            return _, errors.new("http.accept: \(failure)")
        }
        if serve_closed(server) {
            return _, errors.new("http.accept: the server is shut")
        }
        task.wait_host()
        task.yield()
    }
    let id = serve_next(server.id)
    if id < 0 {
        return _, errors.new("http.accept: the request went away before it was taken")
    }
    let request = Request{
        method: serve_method(id),
        path: serve_path(id),
        body: serve_body(id),
        headers: serve_headers(id),
    }
    return Incoming{ request: request, id: id }, nil
}

/// One response header, as a name and a value that are still two things.
///
/// Written as a literal — `http.Header{ name: "location", value: "/x" }` —
/// rather than through a constructor, because `header` already means "read a
/// header off a response" in this module and one name cannot mean two things.
pub struct Header {
    pub name: str
    pub value: str
}

/// Answer a request.
///
/// Headers are given as **pairs, not as text**, and that is the whole of the
/// design. Everything else crossing this boundary is `name: value` lines, and
/// for a *response* that encoding is unsafe: the host splits on the newline, so
/// a newline inside a value stops being data and becomes a separator. A
/// handler that put anything a request said into a header — a path, an
/// identifier, a filename — would be one newline away from letting the caller
/// add a `Set-Cookie` of their own.
///
/// Joining the lines here, from parts the library was given separately, is what
/// makes the difference between "the program meant two headers" and "somebody
/// else added one" decidable. It cannot be decided from the joined string, and
/// the host is handed nothing else.
///
/// A name that frames the message (`Content-Length`, `Transfer-Encoding`,
/// `Connection` and their kin, see [`with_header`]) is refused too: the host
/// writes the length, from the bytes it sends.
///
/// A name that is not a token, a name or value carrying a carriage return or a
/// newline, and a value carrying a NUL byte, another control character or a
/// character past U+00FF are refused rather than stripped:
/// there is no escaping that keeps the meaning, and a header nobody can read is
/// better than one somebody else wrote. The name is held to what
/// [`sending_pairs`] holds a request's to — a colon in a name would otherwise
/// end it early and make the rest of it a header of its own.
pub fn respond(incoming: Incoming, response: Response, headers: [Header]) -> error {
    let unsent = status_refused(response)
    if unsent != nil {
        return unsent
    }
    var all = headers
    for h in response.outgoing {
        all.push(h)
    }
    let (lines, refused) = header_lines(all)
    if refused != nil {
        return refused
    }
    let sent = serve_respond(incoming.id, response.status, response.body, lines)
    if sent == 1 {
        return nil
    }
    if sent < 0 {
        return errors.new("http.respond: the host would not send that response, and answered 500 in its place")
    }
    return errors.new("http.respond: that request was already answered")
}

/// Whether a status is one a response can end with: 200 to 599. A 1xx is an
/// interim answer, after which the real one is still to come, so a connection
/// that was given one as the last word has its next answer taken for this
/// request's; and anything outside three digits made the host refuse the whole
/// response, and `respond` then blamed a header or an answer already given for
/// what was a bad number.
fn sendable_status(code: int) -> bool {
    return code >= 200 && code <= 599
}

/// Why a response cannot be sent for its status and body, or nil: a status that
/// is not a final one, or a body on a 204, 205 or a 304, which by definition have
/// none (the host would drop it, and the program should hear that it was not
/// sent).
///
/// ```kite
/// assert(status_refused(ok("x")) == nil, "an ordinary answer")
/// assert(status_refused(status(100, "")) != nil, "an interim one is not final")
/// assert(status_refused(status(204, "")) == nil, "no content, and none given")
/// assert(status_refused(status(304, "stale")) != nil, "a body where there is none")
/// assert(status_refused(status(205, "reset")) != nil, "a reset carries none either")
/// ```
fn status_refused(response: Response) -> error {
    if !sendable_status(response.status) {
        return errors.new("http.respond: `\(response.status)` is not a status HTTP sends (200 to 599)")
    }
    if (response.status == 204 || response.status == 205 || response.status == 304) && response.body.len() > 0 {
        return errors.new("http.respond: a \(response.status) has no body, and this one has \(response.body.len()) characters")
    }
    return nil
}

/// The headers as the `name: value` lines the host takes, or why they cannot go.
fn header_lines(headers: [Header]) -> (str, error) {
    var lines: [str] = []
    for h in headers {
        if breaks_a_line(h.name) {
            return _, errors.new("http.respond: header name `\(h.name)` contains a line break")
        }
        if !is_token(h.name) {
            return _, errors.new("http.respond: `\(h.name)` is not a header name")
        }
        if frames_the_message(h.name) {
            return _, errors.new(
                "http.respond: `\(h.name)` frames the message, which only the host can do, from the body's length in bytes; leave it out",
            )
        }
        if breaks_a_line(h.value) {
            return _, errors.new("http.respond: the value of `\(h.name)` contains a line break")
        }
        if has_nul(h.value) {
            return _, errors.new("http.respond: the value of `\(h.name)` contains a NUL byte")
        }
        if !carriable(h.value) {
            return _, errors.new(
                "http.respond: the value of `\(h.name)` contains a control character or one past U+00FF, which a header cannot carry; encode it first, with encode_component",
            )
        }
        lines.push("\(h.name): \(h.value)")
    }
    return join(lines, "\n"), nil
}

/// Whether a header name is one that says where a message ends or how the
/// connection is used. A handler that wrote one could make the end of its own
/// body the start of the next response (a `Content-Length` shorter than the
/// body, or counted in characters), so the host alone writes them.
///
/// ```kite
/// assert(frames_the_message("Content-Length"), "in any case")
/// assert(!frames_the_message("content-type"), "a type is the handler's")
/// let (_, why) = header_lines([Header{ name: "transfer-encoding", value: "gzip" }])
/// assert(why != nil, "and a response that names one is refused")
/// ```
fn frames_the_message(name: str) -> bool {
    let n = lower(name)
    return n == "content-length" || n == "transfer-encoding" || n == "connection" || n == "keep-alive" || n == "upgrade" || n == "te" || n == "trailer" || n == "proxy-connection"
}

/// Whether every character of a value is one a header can carry: a tab, a
/// printable ASCII character, or one of U+0080 to U+00FF, each one byte on the
/// wire. The host refuses anything else, and refused the whole response with
/// it, which `run` could not tell from a request already answered and so ended
/// the server over a handler's `€`.
fn carriable(text: str) -> bool {
    for i in 0..text.len() {
        let c = text.code_at(i)
        if (c < 32 && c != 9) || c == 127 || c > 255 {
            return false
        }
    }
    return true
}

/// Whether text carries a line break, in any of the three spellings a header
/// parser might act on.
fn breaks_a_line(text: str) -> bool {
    return text.index_of("\n") >= 0 || text.index_of("\r") >= 0
}

/// Whether text carries a NUL byte, which no header value may.
fn has_nul(text: str) -> bool {
    for i in 0..text.len() {
        if text.code_at(i) == 0 {
            return true
        }
    }
    return false
}

/// Accept requests and answer them from a routing table, until the server is
/// closed or the host fails.
///
/// This is the whole of a server: `serve` already turns a table and a request
/// into a response, and it did so before anything could listen — which is why
/// a handler was testable by calling it long before this existed, and stays
/// that way.
///
/// A handler's headers — those it added with [`with_header`] — are sent. One
/// the host would refuse, or a status outside 200 to 599 or a body on a 204,
/// 205 or 304 (see [`respond`]),
/// makes the answer a 500 and the server carries on.
///
/// Shutting the server is how this ends well: once it is shut and every
/// request that arrived before has been answered, the count of answered
/// requests comes back with no error.
pub async fn run(server: Server, routes: [Route]) -> (int, error) {
    var answered = 0
    for {
        if serve_closed(server) && serve_pending(server.id) == 0 {
            return answered, nil
        }
        let (incoming, err) = await accept(server)
        if err != nil {
            // Shut while this was waiting, which is the ordinary way to stop.
            if serve_closed(server) && serve_pending(server.id) == 0 {
                return answered, nil
            }
            return _, err
        }
        var answer = serve(routes, incoming.request)
        // A header the host would refuse is the handler's mistake, not the
        // server's: say 500 to this one caller and go on serving, rather than
        // let one bad route end the loop for everybody.
        let (_, unsendable) = header_lines(answer.outgoing)
        if unsendable != nil || status_refused(answer) != nil {
            answer = status(500, "the handler produced a response this server will not send")
        }
        let none: [Header] = []
        let failed = respond(incoming, answer, none)
        if failed != nil {
            return _, failed
        }
        answered = answered + 1
    }
}

/// Whether a server has stopped listening.
pub fn serve_closed(server: Server) -> bool {
    return serve_port(server.id) < 0
}

/// Stop listening. Requests already taken can still be answered; nothing new
/// arrives.
///
/// Named `shut` rather than `close` because `close` already means "stop
/// listening to this event stream" in this module, and Kite has no
/// overloading: one name, one signature. Two things that are not the same
/// thing do not get the same name.
pub fn shut(server: Server) {
    let ignored = serve_close(server.id)
}
