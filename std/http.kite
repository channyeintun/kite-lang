// std/http — talking to a server, and answering one.
//
// The two halves are not symmetric. A client runs in a sandbox that already
// has `fetch` and `EventSource`, so the client half is a declared boundary
// over those and everything else is Kite. A server runs somewhere with
// sockets, which no Kite target has yet — so the server half here is the part
// that needs no sockets: the types, the router, and handlers that can be
// called directly and tested without a network.
//
// A 404 is a `Response`, not an error: the request succeeded and the answer
// was "no". Only a transport failure is an `error`.
//
// Any method the host will send, this will send — `fetch` forbids only
// CONNECT, TRACE and TRACK — so QUERY works here the day a server answers it,
// with no change to this module.

use std/task

// ---- the declared boundary --------------------------------------------------
//
// Requesting and answering is these six functions. The glue is generated from
// them, so what the host must supply and what the program may ask cannot drift
// apart.

@host("net")
extern fn fetch_start(method: str, url: str, body: str, headers: str) -> int

/// 0 while in flight, 1 when it arrived, 2 when the transport failed.
@host("net")
extern fn fetch_state(id: int) -> int

@host("net")
extern fn fetch_status(id: int) -> int

@host("net")
extern fn fetch_body(id: int) -> str

@host("net")
extern fn fetch_header(id: int, name: str) -> str

@host("net")
extern fn fetch_error(id: int) -> str

// ---- the event stream boundary ----------------------------------------------
//
// Server-sent events are `EventSource`, which every browser has. It is not the
// general streaming reader `fetch` would give: `EventSource` issues a GET and
// carries no headers of its own, so a stream behind an `Authorization` header
// is out of reach and a cookie or a token in the URL is what is left. What it
// supplies in exchange is reconnection — a dropped stream comes back on its
// own, with `Last-Event-ID`, and nothing here has to know it happened.
//
// An event is taken off a queue rather than pushed at a callback, because a
// callback would be a second way for control to enter a program.

/// `names` is the event names to deliver besides the default `message`, one
/// per line — the same shape headers cross in, since only text crosses.
///
/// They are given at open rather than added afterwards because a listener
/// registered after the stream is running misses whatever already arrived, and
/// a race in a standard library is a bug every program inherits.
@host("net")
extern fn sse_open(url: str, names: str) -> int

/// 0 while connecting, 1 once open, 2 once the stream failed for good, 3 once
/// the program closed it.
///
/// A stream that drops and reconnects stays 1: reconnection is the host's job
/// and not an event in the program. Closing is distinct from failing because a
/// program that closed a stream and then asked it for an event has a bug of a
/// different kind than one whose network went away.
@host("net")
extern fn sse_state(id: int) -> int

/// How many events have arrived and not yet been taken.
@host("net")
extern fn sse_pending(id: int) -> int

/// Take the oldest event and answer its `data`.
///
/// The name and the id of that same event are read back with the two
/// functions below, the way a response's headers are read back from its
/// handle. Data crosses on its own because data is the part that can contain
/// anything, newlines included, and a `name: value` encoding would mangle it.
@host("net")
extern fn sse_next(id: int) -> str

@host("net")
extern fn sse_event_name(id: int) -> str

@host("net")
extern fn sse_event_id(id: int) -> str

/// Also deliver events whose `event:` field is `name`.
///
/// `EventSource` has no wildcard — a named event arrives only for a listener
/// registered under that name — so a program that wants one says so.
@host("net")
extern fn sse_listen(id: int, name: str) -> int

@host("net")
extern fn sse_close(id: int) -> int

// ---- requests and responses -------------------------------------------------

pub struct Request {
    pub method: str
    pub path: str
    pub body: str
    /// `name: value` pairs, one per line — the shape that crosses the host
    /// boundary, since only text does.
    pub headers: str
}

pub struct Response {
    pub status: int
    pub body: str
    /// The handle the response came from, for reading a header back.
    id: int
}

pub fn ok(body: str) -> Response {
    return Response{ status: 200, body: body, id: -1 }
}

pub fn not_found() -> Response {
    return Response{ status: 404, body: "not found", id: -1 }
}

pub fn status(code: int, body: str) -> Response {
    return Response{ status: code, body: body, id: -1 }
}

/// Whether the status is in the 2xx range.
pub fn succeeded(r: Response) -> bool {
    return r.status >= 200 && r.status < 300
}

/// A header of a response that came from the host. A response built in Kite
/// carries no headers, and answers with an empty string.
pub fn header(r: Response, name: str) -> str {
    if r.id < 0 {
        return ""
    }
    return fetch_header(r.id, name)
}

// ---- the client -------------------------------------------------------------

pub async fn get(url: str) -> (Response, error) {
    return await send("GET", url, "", "")
}

pub async fn post(url: str, body: str) -> (Response, error) {
    return await send("POST", url, body, "content-type: application/json")
}

pub async fn put(url: str, body: str) -> (Response, error) {
    return await send("PUT", url, body, "content-type: application/json")
}

pub async fn delete(url: str) -> (Response, error) {
    return await send("DELETE", url, "", "")
}

pub async fn patch(url: str, body: str) -> (Response, error) {
    return await send("PATCH", url, body, "content-type: application/json")
}

/// A HEAD request. The status and the headers arrive; the body is empty by
/// definition, not by accident.
pub async fn head(url: str) -> (Response, error) {
    return await send("HEAD", url, "", "")
}

pub async fn options(url: str) -> (Response, error) {
    return await send("OPTIONS", url, "", "")
}

/// A QUERY request: a read that carries a body.
///
/// QUERY is what GET would be if a request could ask a long question — safe,
/// idempotent and cacheable, with the question in the body instead of squeezed
/// into a URL and its length limits. It is still a draft
/// (`draft-ietf-httpbis-safe-method-w-body`) rather than a finished RFC.
///
/// It works today because `fetch` forbids exactly three methods — CONNECT,
/// TRACE and TRACK — and passes every other token through untouched. Two
/// things follow, and both are the server's business rather than this
/// module's: QUERY is not CORS-safelisted, so a cross-origin call is preceded
/// by a preflight `OPTIONS`; and a server that does not know the method
/// answers 405 rather than failing, which is a `Response` here and not an
/// `error`.
///
/// The body is sent as JSON. A different query language — SQL, GraphQL,
/// anything — goes through `send` with the content type it wants.
pub async fn query(url: str, body: str) -> (Response, error) {
    return await send("QUERY", url, body, "content-type: application/json")
}

/// Every request goes through here. Waiting is `task.wait_host()`: what is
/// being waited for is not another task but the host itself, and saying so is
/// what lets the runtime hand the event loop back rather than spin.
pub async fn send(method: str, url: str, body: str, headers: str) -> (Response, error) {
    let id = fetch_start(method, url, body, headers)
    for fetch_state(id) == 0 {
        task.wait_host()
        task.yield()
    }
    if fetch_state(id) == 2 {
        return _, errors.new("http \(method) \(url): \(fetch_error(id))")
    }
    return Response{ status: fetch_status(id), body: fetch_body(id), id: id }, nil
}

// ---- server-sent events -----------------------------------------------------
//
// A stream is a handle and events are taken off it. Nothing is pushed at the
// program: an event arrives when a task asks for one, which is the same shape
// as awaiting a request and needs no second notion of control flow.

pub struct Events {
    id: int
}

pub struct Event {
    /// The `event:` field, or "message" when the event had none.
    pub name: str
    /// The `id:` field, or "" when the event had none. The host replays it as
    /// `Last-Event-ID` after a reconnection, so a program rarely needs it.
    pub id: str
    pub data: str
}

/// Open a stream of server-sent events, waiting until it is open.
///
/// GET only, and no headers: that is `EventSource`, not a choice made here.
/// A stream that needs an `Authorization` header cannot be opened this way —
/// a cookie the browser already sends, or a token in the URL, is what is left.
pub async fn events(url: str) -> (Events, error) {
    return await events_named(url, "")
}

/// The same, also delivering events whose `event:` field is one of `names`,
/// given one per line.
///
/// `EventSource` hands a named event to a listener registered for that name
/// and offers no way to ask for all of them, so a program that wants
/// `event: tick` says `tick` here. Naming them at open is what keeps the first
/// one from arriving before anything is listening.
pub async fn events_named(url: str, names: str) -> (Events, error) {
    let id = sse_open(url, names)
    for sse_state(id) == 0 {
        task.wait_host()
        task.yield()
    }
    if sse_state(id) == 2 {
        return _, errors.new("sse \(url): the stream would not open")
    }
    return Events{ id: id }, nil
}

/// Deliver events named `name` from now on.
///
/// For a name discovered while the stream is running. Anything known before it
/// opened belongs in `events_named`, which cannot miss an event this may.
pub fn listen(stream: Events, name: str) {
    sse_listen(stream.id, name)
}

/// The next event, waiting for one to arrive.
///
/// Waiting is `task.wait_host()` for the reason a request waits that way: what
/// the task waits for is the host's event loop, and a scheduler told so hands
/// the loop back rather than spinning. A stream that is merely quiet is not a
/// stalled program, and this is what tells the two apart.
pub async fn receive(stream: Events) -> (Event, error) {
    for sse_pending(stream.id) == 0 {
        if sse_state(stream.id) == 2 {
            return _, errors.new("sse: the stream failed")
        }
        if sse_state(stream.id) == 3 {
            return _, errors.new("sse: the stream is closed")
        }
        task.wait_host()
        task.yield()
    }
    // `sse_next` takes the event; the name and id are that event's, so they
    // have to be read after it and before anything takes another.
    let data = sse_next(stream.id)
    return Event{
        name: sse_event_name(stream.id),
        id: sse_event_id(stream.id),
        data: data,
    }, nil
}

/// How many events are waiting. A program with something else to do asks this
/// rather than `receive`.
pub fn pending(stream: Events) -> int {
    return sse_pending(stream.id)
}

/// Stop the stream, and stop it reconnecting.
///
/// Events that already arrived stay readable: `receive` drains what is
/// waiting and only then reports the stream closed. Discarding them would
/// throw away data the host had already delivered, which is a loss a program
/// has no way to notice.
pub fn close(stream: Events) {
    sse_close(stream.id)
}

// ---- the server -------------------------------------------------------------
//
// A handler is a function from a request to a response. Anything that wants to
// wrap one is a function that takes a handler and returns a handler, which
// needs no framework — so there is no middleware stack, no dependency
// injection and no ORM here, deliberately.

pub struct Route {
    pub method: str
    /// A path, with `:name` standing for one segment.
    pub pattern: str
    pub handle: fn(Request) -> Response
}

pub fn route(method: str, pattern: str, handle: fn(Request) -> Response) -> Route {
    return Route{ method: method, pattern: pattern, handle: handle }
}

/// The first route that matches, or a 404.
pub fn serve(routes: [Route], request: Request) -> Response {
    for r in routes {
        if r.method == request.method {
            if matches(r.pattern, request.path) {
                return r.handle(request)
            }
        }
    }
    return not_found()
}

/// Whether a path matches a pattern, where `:name` stands for one segment.
pub fn matches(pattern: str, path: str) -> bool {
    let want = split(pattern, "/")
    let found = split(path, "/")
    if want.len() != found.len() {
        return false
    }
    for i in 0..want.len() {
        let w = want[i]
        if !starts_with(w, ":") {
            if w != found[i] {
                return false
            }
        }
    }
    return true
}

/// The value a `:name` segment captured, or nil.
pub fn parameter(pattern: str, path: str, name: str) -> Option<str> {
    let want = split(pattern, "/")
    let found = split(path, "/")
    if want.len() != found.len() {
        return nil
    }
    for i in 0..want.len() {
        if want[i] == ":\(name)" {
            return found[i]
        }
    }
    return nil
}

/// A header's value out of the `name: value` lines a request carries.
pub fn request_header(request: Request, name: str) -> Option<str> {
    for line in split(request.headers, "\n") {
        let at = line.index_of(":")
        if at > 0 {
            if equal_ignoring_case(line.slice(0, at), name) {
                return line.slice(at + 1, line.len()).trim()
            }
        }
    }
    return nil
}

// ---- listening ---------------------------------------------------------------
//
// The half that needs sockets, and the half a Kite target does not have of its
// own. The boundary below is the same shape as every other one in this module:
// numbers and text cross it, a handle stands for what the host holds, and
// nothing is pushed at the program — a request is *taken*, when a task asks
// for one.
//
// That last part is what makes a server here look like the rest of the
// language. A callback-driven server is a second way for control to enter a
// program, and Kite has one.
//
// **What supplies these.** `kitec build --emit wasm` writes a `serve.mjs`
// beside the module when a program declares them: a Node, Deno or Bun adapter
// that listens, queues what arrives, and hands each answer back. WASI's
// `wasi:http/incoming-handler` is the other implementation this boundary was
// shaped for, and it is *not* written — it is a component-model export, and
// `kitec` emits a core module. That is a real gap and it is recorded rather
// than implied.

/// Listen on a port. A handle, or -1 when the host cannot listen — which is
/// the ordinary case in a browser, and is why this answers rather than traps.
@host("net")
extern fn serve_open(port: int) -> int

/// The port actually bound. Asking for 0 gets one the host chose, and a test
/// that must not collide with another test needs to know which.
@host("net")
extern fn serve_port(id: int) -> int

/// How many requests have arrived and not yet been taken.
@host("net")
extern fn serve_pending(id: int) -> int

/// Take the oldest request, yielding its own handle, or -1 when none waits.
@host("net")
extern fn serve_next(id: int) -> int

@host("net")
extern fn serve_method(request: int) -> str

@host("net")
extern fn serve_path(request: int) -> str

@host("net")
extern fn serve_body(request: int) -> str

@host("net")
extern fn serve_headers(request: int) -> str

/// Answer one request. 1 when the host took it, 0 when that request was
/// already answered or never existed.
@host("net")
extern fn serve_respond(request: int, status: int, body: str, headers: str) -> int

@host("net")
extern fn serve_error(id: int) -> str

@host("net")
extern fn serve_close(id: int) -> int

/// Something listening on a port.
pub struct Server {
    id: int
}

/// A request that arrived, and the handle to answer it with.
///
/// The handle is kept beside the `Request` rather than inside it, so a
/// `Request` stays a value a test can write out by hand. A handler is a
/// function from a request to a response, and that is only true if a request
/// is something anyone can make.
pub struct Incoming {
    pub request: Request
    id: int
}

/// Start listening. Port 0 asks the host to choose one; `port_of` says which.
///
/// It is `async` because binding a socket is not instant, and a server that
/// answered "which port?" before the host had one would answer wrongly rather
/// than late. Waiting is `task.wait_host()` for the reason everything in this
/// module waits that way: what is being waited for is the host.
pub async fn open(port: int) -> (Server, error) {
    let id = serve_open(port)
    if id < 0 {
        return _, errors.new("http.open: cannot listen on \(port)")
    }
    for serve_port(id) < 0 {
        let failure = serve_error(id)
        if failure != "" {
            return _, errors.new("http.open: \(failure)")
        }
        task.wait_host()
        task.yield()
    }
    return Server{ id: id }, nil
}

/// The port a server is actually listening on.
pub fn port_of(server: Server) -> int {
    return serve_port(server.id)
}

/// Wait for the next request.
///
/// Waiting is `task.wait_host()` for the reason a fetch waits that way: what
/// is being waited for is the host rather than another task, and saying so is
/// what lets the runtime hand the event loop back instead of spinning through
/// a queue that cannot fill while it holds the thread.
pub async fn accept(server: Server) -> (Incoming, error) {
    for serve_pending(server.id) == 0 {
        let failure = serve_error(server.id)
        if failure != "" {
            return _, errors.new("http.accept: \(failure)")
        }
        task.wait_host()
        task.yield()
    }
    let id = serve_next(server.id)
    if id < 0 {
        return _, errors.new("http.accept: the request went away before it was taken")
    }
    let request = Request{
        method: serve_method(id),
        path: serve_path(id),
        body: serve_body(id),
        headers: serve_headers(id),
    }
    return Incoming{ request: request, id: id }, nil
}

/// One response header, as a name and a value that are still two things.
///
/// Written as a literal — `http.Header{ name: "location", value: "/x" }` —
/// rather than through a constructor, because `header` already means "read a
/// header off a response" in this module and one name cannot mean two things.
pub struct Header {
    pub name: str
    pub value: str
}

/// Answer a request.
///
/// Headers are given as **pairs, not as text**, and that is the whole of the
/// design. Everything else crossing this boundary is `name: value` lines, and
/// for a *response* that encoding is unsafe: the host splits on the newline, so
/// a newline inside a value stops being data and becomes a separator. A
/// handler that put anything a request said into a header — a path, an
/// identifier, a filename — would be one newline away from letting the caller
/// add a `Set-Cookie` of their own.
///
/// Joining the lines here, from parts the library was given separately, is what
/// makes the difference between "the program meant two headers" and "somebody
/// else added one" decidable. It cannot be decided from the joined string, and
/// the host is handed nothing else.
///
/// A name or value carrying a carriage return or a newline is refused rather
/// than stripped: there is no escaping that keeps the meaning, and a header
/// nobody can read is better than one somebody else wrote.
pub fn respond(incoming: Incoming, response: Response, headers: [Header]) -> error {
    var lines: [str] = []
    for h in headers {
        if breaks_a_line(h.name) {
            return errors.new("http.respond: header name `\(h.name)` contains a line break")
        }
        if breaks_a_line(h.value) {
            return errors.new("http.respond: the value of `\(h.name)` contains a line break")
        }
        lines.push("\(h.name): \(h.value)")
    }
    if serve_respond(incoming.id, response.status, response.body, join(lines, "\n")) == 1 {
        return nil
    }
    return errors.new("http.respond: that request was already answered")
}

/// Whether text carries a line break, in any of the three spellings a header
/// parser might act on.
fn breaks_a_line(text: str) -> bool {
    return text.index_of("\n") >= 0 || text.index_of("\r") >= 0
}

/// Accept requests and answer them from a routing table, until the server is
/// closed or the host fails.
///
/// This is the whole of a server: `serve` already turns a table and a request
/// into a response, and it did so before anything could listen — which is why
/// a handler was testable by calling it long before this existed, and stays
/// that way.
pub async fn run(server: Server, routes: [Route]) -> (int, error) {
    var answered = 0
    for {
        let (incoming, err) = await accept(server)
        check err
        let none: [Header] = []
        let failed = respond(incoming, serve(routes, incoming.request), none)
        if failed != nil {
            return _, failed
        }
        answered = answered + 1
        if serve_pending(server.id) == 0 {
            if serve_closed(server) {
                return answered, nil
            }
        }
    }
}

/// Whether a server has stopped listening.
pub fn serve_closed(server: Server) -> bool {
    return serve_port(server.id) < 0
}

/// Stop listening. Requests already taken can still be answered; nothing new
/// arrives.
///
/// Named `shut` rather than `close` because `close` already means "stop
/// listening to this event stream" in this module, and Kite has no
/// overloading: one name, one signature. Two things that are not the same
/// thing do not get the same name.
pub fn shut(server: Server) {
    let ignored = serve_close(server.id)
}
