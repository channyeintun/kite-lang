// std/math — numbers.
//
// Written in Kite, like the rest of the standard library. Nothing here needs
// compiler support, which is the test a standard library should have to pass.

pub fn abs(x: float) -> float {
    if x < 0.0 {
        return 0.0 - x
    }
    return x
}

pub fn min(a: float, b: float) -> float {
    if a < b {
        return a
    }
    return b
}

pub fn max(a: float, b: float) -> float {
    if a > b {
        return a
    }
    return b
}

pub fn clamp(x: float, low: float, high: float) -> float {
    return min(max(x, low), high)
}

/// Truncation towards zero, which is what an `as int` cast does. Casts are
/// saturating on every backend, so a value out of range gives a number rather
/// than killing the program.
pub fn trunc(x: float) -> float {
    return (x as int) as float
}

/// Comparisons rather than `t != x`, which would be exact float equality and
/// warn — rightly, since it is rarely what someone means.
pub fn floor(x: float) -> float {
    let t = trunc(x)
    if t > x {
        return t - 1.0
    }
    return t
}

pub fn ceil(x: float) -> float {
    let t = trunc(x)
    if t < x {
        return t + 1.0
    }
    return t
}

/// Half away from zero, which is what most people mean by rounding.
pub fn round(x: float) -> float {
    if x < 0.0 {
        return 0.0 - floor(0.0 - x + 0.5)
    }
    return floor(x + 0.5)
}

/// A float as an `int`, rounded to nearest.
///
/// A bare `x as int` warns, and rightly: it truncates towards zero, which is
/// almost never what code that measured something meant. Saying `round_to` is
/// saying *which* rounding was intended, and is the escape hatch that makes
/// keeping the warning worthwhile — without one, every program that has to
/// produce an integer from a measurement has to ignore a warning to do it.
pub fn round_to(x: float) -> int {
    return round(x) as int
}

/// A float as an `int`, truncated towards zero — the cast, named.
///
/// Same purpose as [`round_to`]: the bare cast warns because it is usually a
/// mistake, and a caller who means it says which rounding they meant.
pub fn trunc_to(x: float) -> int {
    return x as int
}

/// The square root, by Newton's method.
///
/// Written in Kite rather than reached for from the host: a host call is a
/// boundary two runtimes have to agree about, and this one converges to the
/// same answer everywhere. Twenty iterations is far more than a `float`
/// needs — the loop stops as soon as it stops moving.
pub fn sqrt(x: float) -> float {
    if x <= 0.0 {
        return 0.0
    }
    var guess = x
    for i in 0..20 {
        let next = (guess + x / guess) / 2.0
        if abs(next - guess) < 0.0000000001 {
            return next
        }
        guess = next
    }
    return guess
}

/// `base` raised to a whole power. Negative powers give the reciprocal.
pub fn pow(base: float, exponent: int) -> float {
    if exponent < 0 {
        let positive = pow(base, 0 - exponent)
        if positive == 0.0 {
            return 0.0
        }
        return 1.0 / positive
    }
    var out = 1.0
    for i in 0..exponent {
        out = out * base
    }
    return out
}

/// The length of the hypotenuse — the distance from the origin to (x, y).
pub fn hypot(x: float, y: float) -> float {
    return sqrt(x * x + y * y)
}

/// A point `t` of the way from `a` to `b`.
pub fn lerp(a: float, b: float, t: float) -> float {
    return a + (b - a) * t
}

/// -1, 0 or 1.
pub fn sign(x: float) -> int {
    if x > 0.0 {
        return 1
    }
    if x < 0.0 {
        return -1
    }
    return 0
}

/// The ratio of a circle's circumference to its diameter, to the precision a
/// `float` holds.
pub fn pi() -> float {
    return 3.141592653589793
}

pub fn e() -> float {
    return 2.718281828459045
}
