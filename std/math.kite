// std/math — numbers.
//
// Written in Kite, like the rest of the standard library. Nothing here needs
// compiler support, which is the test a standard library should have to pass.

pub fn abs(x: float) -> float {
    if x < 0.0 {
        return 0.0 - x
    }
    return x
}

pub fn min(a: float, b: float) -> float {
    if a < b {
        return a
    }
    return b
}

pub fn max(a: float, b: float) -> float {
    if a > b {
        return a
    }
    return b
}

pub fn clamp(x: float, low: float, high: float) -> float {
    return min(max(x, low), high)
}

/// Truncation towards zero, which is what an `as int` cast does.
///
/// Not *only* the cast, though. Every float of magnitude 2⁵² or more is
/// already a whole number, and most of them are past what an `int` holds, where
/// the cast saturates: `trunc(1e20)` used to answer 9223372036854775808. Such a
/// value is its own truncation, and so is an infinity or a NaN, so they are
/// handed back untouched and only what fits goes through the cast.
pub fn trunc(x: float) -> float {
    if !(abs(x) < two_52()) {
        return x
    }
    return (x as int) as float
}

/// 2⁵², the magnitude from which every float is a whole number: the spacing
/// between neighbouring floats there is 1.
fn two_52() -> float {
    return 4503599627370496.0
}

/// Comparisons rather than `t != x`, which would be exact float equality and
/// warn — rightly, since it is rarely what someone means.
pub fn floor(x: float) -> float {
    let t = trunc(x)
    if t > x {
        return t - 1.0
    }
    return t
}

pub fn ceil(x: float) -> float {
    let t = trunc(x)
    if t < x {
        return t + 1.0
    }
    return t
}

/// Half away from zero, which is what most people mean by rounding.
///
/// Decided on the fraction itself, `x - trunc(x)`, which is exact below 2⁵².
/// The obvious `floor(x + 0.5)` is not: the addition rounds, so
/// `0.49999999999999994 + 0.5` is 1.0 and the largest float below a half
/// rounded up, and above 2⁵² the addition moved `x` to a neighbouring whole
/// number.
pub fn round(x: float) -> float {
    if !(abs(x) < two_52()) {
        return x
    }
    let t = trunc(x)
    let fraction = x - t
    if fraction >= 0.5 {
        return t + 1.0
    }
    if fraction <= -0.5 {
        return t - 1.0
    }
    return t
}

/// A float as an `int`, rounded to nearest.
///
/// A bare `x as int` warns, and rightly: it truncates towards zero, which is
/// almost never what code that measured something meant. Saying `round_to` is
/// saying *which* rounding was intended, and is the escape hatch that makes
/// keeping the warning worthwhile — without one, every program that has to
/// produce an integer from a measurement has to ignore a warning to do it.
pub fn round_to(x: float) -> int {
    return round(x) as int
}

/// A float as an `int`, truncated towards zero — the cast, named.
///
/// Same purpose as [`round_to`]: the bare cast warns because it is usually a
/// mistake, and a caller who means it says which rounding they meant.
pub fn trunc_to(x: float) -> int {
    return x as int
}

/// The square root, correctly rounded. Zero and negatives answer zero; an
/// infinity is its own root.
///
/// Written in Kite rather than reached for from the host: a host call is a
/// boundary two runtimes have to agree about, and this one gives the same bits
/// everywhere — the same bits IEEE 754 requires of a hardware square root.
///
/// **The range is reduced first**, and that is most of the function. `x` is
/// written as `m · 4ᵏ` with `m` in `[1, 4)` — multiplying by 4 and by 2 is
/// exact, so this costs nothing — and Newton runs on `m`, from a start within
/// 25% of the answer, where six steps are more than the quadratic convergence
/// needs. Starting from `x` itself and stopping on an absolute tolerance, as
/// this once did, was right only between about 1e-8 and 1e10: `sqrt(1e12)`
/// answered 1279996.5 and `sqrt(1e-12)` 1.28e-6.
///
/// Newton in floating point lands within one unit in the last place, and a
/// quarter of the time on the wrong side of the halfway point. The last step
/// settles it in integers, where nothing rounds — see [`nearest_root`].
pub fn sqrt(x: float) -> float {
    if x <= 0.0 {
        return 0.0
    }
    // An infinity (or a NaN) answers itself: halving one never ends.
    if !(x < x * 2.0) {
        return x
    }
    var m = x
    var scale = 1.0
    for m >= 4.0 {
        m = m / 4.0
        scale = scale * 2.0
    }
    for m < 1.0 {
        m = m * 4.0
        scale = scale / 2.0
    }
    var guess = (m + 1.0) / 2.0
    for i in 0..6 {
        guess = (guess + m / guess) / 2.0
    }
    return nearest_root(m, guess) * scale
}

/// Of `guess` and its neighbours, the one nearest `√m`, for `m` in `[1, 4)`.
///
/// Both are whole numbers of units in the last place once scaled by 2⁵²: `M`
/// for `m` and `G` for the root, which is in `[1, 2)`. `G` is the nearest
/// exactly when `(G − ½)² < M · 2⁵² < (G + ½)²`, and since both sides are
/// whole numbers that is `−G < M · 2⁵² − G² ≤ G`. The difference is small but
/// its two terms are near 2¹⁰⁶, so it is taken in 26-bit pieces, where every
/// product fits in an `int` and nothing is ever rounded.
fn nearest_root(m: float, guess: float) -> float {
    let unit = 4503599627370496.0
    let piece = 67108864
    let big = trunc_to(m * unit)
    var root = trunc_to(guess * unit)
    for step in 0..3 {
        let high = root / piece
        let low = root % piece
        let cross = 2 * high * low
        let top = (big - high * high) - cross / piece
        let difference = top * 4503599627370496 - (cross % piece) * piece - low * low
        if difference > root {
            root += 1
        } else if difference <= 0 - root {
            root -= 1
        } else {
            break
        }
    }
    return (root as float) / unit
}

/// `base` raised to a whole power. Negative powers give the reciprocal.
pub fn pow(base: float, exponent: int) -> float {
    if exponent < 0 {
        let positive = pow(base, 0 - exponent)
        if positive == 0.0 {
            return 0.0
        }
        return 1.0 / positive
    }
    var out = 1.0
    for i in 0..exponent {
        out = out * base
    }
    return out
}

// ---- integer overflow ------------------------------------------------------
//
// Kite traps on integer overflow in debug builds and wraps in release. That is
// the default most people want, and it means the *same* addition has two
// meanings depending on how the program was built. These two say which one
// they mean, in both builds — which is the only reason they exist.
//
// Both are ordinary Kite, and neither may overflow while deciding whether an
// overflow would happen: computing `a + b` to find out is exactly the trap
// being avoided. So each rearranges the arithmetic to stay in range.

/// The largest `int`.
pub fn max_int() -> int {
    return 9223372036854775807
}

/// The smallest `int`. Written as a subtraction because `9223372036854775808`
/// is not an `int` and so cannot be negated in source.
pub fn min_int() -> int {
    return -9223372036854775807 - 1
}

/// `a + b`, or nil when that does not fit.
///
/// The test is done by subtraction rather than by adding and looking at the
/// result, because adding is what traps. `max_int() - b` is in range whenever
/// `b` is positive, and `min_int() - b` is in range whenever `b` is negative,
/// so neither side of the question can overflow while it is being asked.
pub fn checked_add(a: int, b: int) -> Option<int> {
    if b > 0 && a > max_int() - b {
        return nil
    }
    if b < 0 && a < min_int() - b {
        return nil
    }
    return a + b
}

/// `a + b`, wrapped into the range of an `int` — in every build.
///
/// On overflow the answer is `a + b ∓ 2⁶⁴`, and that is computed rather than
/// discovered: with two positives too large, `(a + min_int()) + (b +
/// min_int())` is the same number and every step of it is in range, because
/// `min_int()` is exactly `-2⁶³` and shifting both operands down by it lands
/// the sum in `[min_int(), -2]`. The negative case is the mirror image.
pub fn wrapping_add(a: int, b: int) -> int {
    let fits = checked_add(a, b)
    if fits != nil {
        return fits
    }
    if a > 0 {
        return (a + min_int()) + (b + min_int())
    }
    return (a - min_int()) + (b - min_int())
}

/// The length of the hypotenuse — the distance from the origin to (x, y).
///
/// `sqrt(x * x + y * y)` overflows to infinity once either side passes about
/// 1e154, though the answer is nowhere near that large, and loses its
/// precision to underflow below about 1e-154. So outside a comfortable range
/// both sides are first scaled by a power of two — exact, so it costs no
/// precision — and the answer is scaled back.
pub fn hypot(x: float, y: float) -> float {
    let a = abs(x)
    let b = abs(y)
    let big = max(a, b)
    if !(big < big * 2.0) {
        // Zero, an infinity, or a NaN: nothing to scale.
        if big == 0.0 {
            return 0.0
        }
        return big
    }
    // 2⁵⁰⁰, 2⁻⁵⁰⁰ and 2⁶⁰⁰, each a power of two and so held exactly.
    if big > 3.273390607896142e150 {
        let down = 2.409919865102884e-181
        return hypot_near(a * down, b * down) / down
    }
    if big < 3.054936363499605e-151 {
        let up = 4.149515568880993e180
        return hypot_near(a * up, b * up) / up
    }
    return hypot_near(a, b)
}

fn hypot_near(a: float, b: float) -> float {
    return sqrt(a * a + b * b)
}

/// A point `t` of the way from `a` to `b`.
pub fn lerp(a: float, b: float, t: float) -> float {
    return a + (b - a) * t
}

/// -1, 0 or 1.
pub fn sign(x: float) -> int {
    if x > 0.0 {
        return 1
    }
    if x < 0.0 {
        return -1
    }
    return 0
}

/// The ratio of a circle's circumference to its diameter, to the precision a
/// `float` holds.
pub fn pi() -> float {
    return 3.141592653589793
}

pub fn e() -> float {
    return 2.718281828459045
}

pub fn tau() -> float {
    return 6.283185307179586
}

pub fn ln2() -> float {
    return 0.6931471805599453
}

// ---- transcendentals -------------------------------------------------------
//
// Written out here for the same reason `sqrt` is: a host call is a boundary two
// runtimes have to agree about, and `Math.sin` in a browser is not required to
// give the same bits as libm on a laptop. Everything below converges to one
// answer everywhere, so a number a program computes is the same number on the
// web, under the VM and under the JIT — which is what the differential corpus
// compares, and what a `<canvas>` drawn from these coordinates depends on.
//
// Each is the textbook arrangement: reduce the argument to a range where a
// series converges quickly, sum the series, then undo the reduction. The
// reduction is what matters; a Taylor series alone is accurate near zero and
// useless anywhere else.

/// `e` raised to `x`.
///
/// Reduced by `x = k·ln2 + r`, so the series only ever sees `|r| ≤ ln2/2` and
/// the rest is a power of two. Without that a series for `exp(20)` would need
/// hundreds of terms and lose most of its precision to cancellation.
pub fn exp(x: float) -> float {
    // `ln` of the largest float. Past it the answer is past the largest
    // float; saturating rather than trapping, which is what the casts do too.
    if x > 709.782712893384 {
        return 1.7976931348623157e308
    }
    // `ln` of half the smallest float, below which the answer rounds to zero.
    if x < -745.1332191019412 {
        return 0.0
    }
    let k = round(x / ln2())
    // `ln2` in two pieces, high part first. Subtracting `k · ln2` as one
    // rounded double throws away the low bits of the product before the series
    // ever sees them, and at `k = 29` that is already four units in the last
    // place of the answer. Splitting the constant so the high part multiplies
    // exactly keeps them. It is fdlibm's arrangement, and the reason every
    // libm carries a two-word ln2.
    let r = (x - k * 0.6931471803691238) - k * 1.9082149292705877e-10
    // e^r by its Taylor series. At |r| ≤ 0.347 the terms fall off by better
    // than a factor of three each, so eighteen of them is well past the point
    // where adding another changes nothing.
    var term = 1.0
    var sum = 1.0
    for n in 1..18 {
        term = term * r / (n as float)
        sum = sum + term
    }
    return scaled(sum, round_to(k))
}

/// `x · 2ᵏ`, without the power itself overflowing or underflowing first.
///
/// `exp` near either end of its range needs a `k` whose power of two is not a
/// float — 2¹⁰²⁴ is past the largest and 2⁻¹⁰⁷⁵ below the smallest — though
/// the product is. So the power is applied in pieces, each of them exact, and
/// only the last multiplication rounds. `exp(709.7)` used to saturate and
/// `exp(-740)` to answer zero.
fn scaled(x: float, k: int) -> float {
    var out = x
    var left = k
    for left > 1000 {
        out = out * pow(2.0, 1000)
        left -= 1000
    }
    for left < -1000 {
        out = out * pow(0.5, 1000)
        left += 1000
    }
    if left >= 0 {
        return out * pow(2.0, left)
    }
    return out * pow(0.5, 0 - left)
}

/// The natural logarithm. Zero and negatives have none; both answer zero,
/// which is the same choice `sqrt` makes above.
///
/// Reduced to a mantissa in `[√½, √2)` so the series argument stays under
/// 0.172 in magnitude. The series is the one for `atanh`, which converges
/// twice as fast here as the direct series for `ln(1 + s)`.
pub fn ln(x: float) -> float {
    if x <= 0.0 {
        return 0.0
    }
    var m = x
    var k = 0
    // 1.4142… is √2: the mantissa is halved or doubled until it straddles one
    // rather than merely being in `[1, 2)`, which halves the series argument.
    for i in 0..2100 {
        if m >= 1.4142135623730951 {
            m = m / 2.0
            k += 1
        } else if m < 0.7071067811865476 {
            m = m * 2.0
            k -= 1
        } else {
            break
        }
    }
    let s = (m - 1.0) / (m + 1.0)
    let squared = s * s
    var power = s
    var sum = s
    for n in 1..12 {
        power = power * squared
        sum = sum + power / ((2 * n + 1) as float)
    }
    return 2.0 * sum + (k as float) * ln2()
}

/// `base` raised to a `float` power, by `exp(exponent · ln base)`.
///
/// Only defined for a non-negative base: a negative one raised to a fractional
/// power is not a real number, and raised to a whole one is [`pow`], which is
/// exact where this would be approximate. Naming the two separately is what
/// keeps a caller from getting an approximation of something exact.
pub fn powf(base: float, exponent: float) -> float {
    if base == 0.0 {
        return 0.0
    }
    if base < 0.0 {
        return 0.0
    }
    return exp(exponent * ln(base))
}

/// The cube root, keeping the sign — unlike `powf`, which cannot.
pub fn cbrt(x: float) -> float {
    if x == 0.0 {
        return 0.0
    }
    if x < 0.0 {
        return -cbrt(-x)
    }
    // Newton on `t³ = x`, from a seed good to a few digits already.
    var guess = exp(ln(x) / 3.0)
    for i in 0..12 {
        let next = (2.0 * guess + x / (guess * guess)) / 3.0
        if abs(next - guess) < 0.0000000001 * guess {
            return next
        }
        guess = next
    }
    return guess
}

/// `x` less a whole number of quarter turns, and how many quarter turns that
/// was.
///
/// The remainder is within `π/4` of zero, where the sine and cosine series are
/// asked to work, and the count says which of `±sin` and `±cos` of it the
/// answer is. Both functions share this, which is what makes `cos(0)` exactly
/// 1: it used to be `sin(0 + π/2)`, and the sine's series summed at `π/2`
/// gives 1.0000000000000002.
///
/// `π/2` in two pieces, for the reason `exp` splits `ln2`: at `x = 100` the
/// fold subtracts about 100.5, and a single rounded `π/2` has already lost the
/// low bits of that product before the series sees the remainder. The high
/// part here has its bottom thirty mantissa bits clear, so `k · hi` is *exact*
/// for any `k` below 2³⁰ — a few hundred million turns — and the correction
/// carries the rest. Past that the answer loses accuracy steadily.
struct Quarter {
    r: float
    turns: int
}

fn quarter(x: float) -> Quarter {
    let k = round(x / (pi() / 2.0))
    let r = (x - k * 1.5707962512969970703125) - k * 7.549789954891882e-8
    // Which quarter, 0 to 3. `%` keeps the sign of `k`, hence the second one.
    let turns = ((round_to(k) % 4) + 4) % 4
    return Quarter{ r: r, turns: turns }
}

/// The sine series, for `|r| ≤ π/4`.
fn sin_near(r: float) -> float {
    let squared = r * r
    var term = r
    var sum = r
    for n in 1..12 {
        let k = 2 * n
        term = -term * squared / ((k * (k + 1)) as float)
        sum = sum + term
    }
    return sum
}

/// The cosine series, for `|r| ≤ π/4`.
fn cos_near(r: float) -> float {
    let squared = r * r
    var term = 1.0
    var sum = 1.0
    for n in 1..12 {
        let k = 2 * n
        term = -term * squared / (((k - 1) * k) as float)
        sum = sum + term
    }
    return sum
}

pub fn sin(x: float) -> float {
    let q = quarter(x)
    if q.turns == 0 {
        return sin_near(q.r)
    }
    if q.turns == 1 {
        return cos_near(q.r)
    }
    if q.turns == 2 {
        return -sin_near(q.r)
    }
    return -cos_near(q.r)
}

pub fn cos(x: float) -> float {
    let q = quarter(x)
    if q.turns == 0 {
        return cos_near(q.r)
    }
    if q.turns == 1 {
        return -sin_near(q.r)
    }
    if q.turns == 2 {
        return -cos_near(q.r)
    }
    return sin_near(q.r)
}

pub fn tan(x: float) -> float {
    let c = cos(x)
    if c == 0.0 {
        return 0.0
    }
    return sin(x) / c
}

/// The arctangent, in radians, in `(-π/2, π/2)`.
///
/// Twice reduced. `atan(x) = π/2 − atan(1/x)` brings anything past 1 inside;
/// the addition formula then brings anything past `tan(π/12)` down to
/// `0.2679`, where the series loses a decimal digit per two terms. Applying the
/// series directly at `x = 1` — where it is Leibniz's series for π/4 — would
/// need thousands of terms.
pub fn atan(x: float) -> float {
    if x < 0.0 {
        return -atan(-x)
    }
    if x > 1.0 {
        return pi() / 2.0 - atan(1.0 / x)
    }
    let root3 = 1.7320508075688772
    if x > 0.2679491924311227 {
        return pi() / 6.0 + atan((x * root3 - 1.0) / (root3 + x))
    }
    let squared = x * x
    var power = x
    var sum = x
    for n in 1..24 {
        power = -power * squared
        sum = sum + power / ((2 * n + 1) as float)
    }
    return sum
}

/// The angle of the point `(x, y)` from the positive x axis, in `(-π, π]`.
///
/// The quadrant comes from the signs, which is the whole reason this exists
/// separately from `atan(y / x)`: that division throws away which quadrant the
/// point was in, and `(-1, -1)` and `(1, 1)` are not the same direction.
pub fn atan2(y: float, x: float) -> float {
    if x > 0.0 {
        return atan(y / x)
    }
    if x < 0.0 {
        if y >= 0.0 {
            return atan(y / x) + pi()
        }
        return atan(y / x) - pi()
    }
    if y > 0.0 {
        return pi() / 2.0
    }
    if y < 0.0 {
        return -pi() / 2.0
    }
    // The origin has no direction. Zero is the conventional answer and the one
    // every libm gives.
    return 0.0
}

pub fn asin(x: float) -> float {
    let c = clamp(x, -1.0, 1.0)
    if c >= 1.0 {
        return pi() / 2.0
    }
    if c <= -1.0 {
        return -pi() / 2.0
    }
    return atan(c / sqrt(1.0 - c * c))
}

pub fn acos(x: float) -> float {
    return pi() / 2.0 - asin(x)
}

pub fn degrees(radians: float) -> float {
    return radians * 180.0 / pi()
}

pub fn radians(degrees: float) -> float {
    return degrees * pi() / 180.0
}
