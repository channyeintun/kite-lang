// std/math — numbers.
//
// Written in Kite, like the rest of the standard library. Nothing here needs
// compiler support, which is the test a standard library should have to pass.

/// The distance from zero, which is never negative: `abs(-0.0)` is 0.0.
///
/// ```kite
/// assert(1.0 / abs(-0.0) > 0.0, "abs(-0.0) is +0.0")
/// ```
///
/// `x <= 0.0` rather than `x < 0.0`, because -0.0 is not below zero and so
/// came back as itself; `0.0 - -0.0` is +0.0.
pub fn abs(x: float) -> float {
    if x <= 0.0 {
        return 0.0 - x
    }
    return x
}

/// The smaller of two floats. A NaN in either is the answer, whichever side
/// it is on, and -0.0 is smaller than 0.0: IEEE 754's `minimum`.
///
/// ```kite
/// assert(!(min(0.0 / 0.0, 1.0) >= 0.0), "a NaN is carried through")
/// assert(!(min(1.0, 0.0 / 0.0) >= 0.0), "from either side")
/// assert(1.0 / min(0.0, -0.0) < 0.0, "-0.0 is the smaller zero")
/// ```
///
/// Returning `b` whenever `a < b` is false, as this did, made the answer
/// depend on which argument the NaN was: `min(nan, 1.0)` was 1.0 and
/// `min(1.0, nan)` a NaN. Carrying it is the choice that cannot hide one.
pub fn min(a: float, b: float) -> float {
    if a < b {
        return a
    }
    if b < a {
        return b
    }
    // Equal, or unordered because one is a NaN. Of two equal zeros the
    // negative one is the smaller; only dividing by it tells -0.0 apart.
    if a >= b {
        if 1.0 / a < 0.0 {
            return a
        }
        return b
    }
    return a + b
}

/// The larger of two floats. A NaN in either is the answer, and 0.0 is
/// larger than -0.0: IEEE 754's `maximum`, the mirror of [`min`].
pub fn max(a: float, b: float) -> float {
    if a > b {
        return a
    }
    if b > a {
        return b
    }
    if a >= b {
        if 1.0 / a > 0.0 {
            return a
        }
        return b
    }
    return a + b
}

/// `x` held within `[low, high]`. A NaN stays a NaN rather than becoming
/// `low`, since [`min`] and [`max`] carry it.
pub fn clamp(x: float, low: float, high: float) -> float {
    return min(max(x, low), high)
}

/// Truncation towards zero, which is what an `as int` cast does.
///
/// Not *only* the cast, though. Every float of magnitude 2⁵² or more is
/// already a whole number, and most of them are past what an `int` holds, where
/// the cast saturates: `trunc(1e20)` used to answer 9223372036854775808. Such a
/// value is its own truncation, and so is an infinity or a NaN, so they are
/// handed back untouched and only what fits goes through the cast.
///
/// An `int` has no -0, so a negative number that truncates to zero came back
/// +0.0 from the cast. It keeps its sign, as in C and IEEE 754, and so do
/// `floor`, `ceil` and `round`, which start here: `ceil(-0.5)` is -0.0.
///
/// ```kite
/// assert(1.0 / trunc(-0.5) < 0.0, "trunc(-0.5) is -0.0")
/// assert(1.0 / round(-0.4) < 0.0, "round(-0.4) is -0.0")
/// ```
pub fn trunc(x: float) -> float {
    if !(abs(x) < two_52()) {
        return x
    }
    let t = (x as int) as float
    if t == 0.0 {
        // Zero with `x`'s sign: -0.4 · 0 is -0.0.
        return x * 0.0
    }
    return t
}

/// 2⁵², the magnitude from which every float is a whole number: the spacing
/// between neighbouring floats there is 1.
fn two_52() -> float {
    return 4503599627370496.0
}

/// Comparisons rather than `t != x`, which would be exact float equality and
/// warn — rightly, since it is rarely what someone means.
pub fn floor(x: float) -> float {
    let t = trunc(x)
    if t > x {
        return t - 1.0
    }
    return t
}

pub fn ceil(x: float) -> float {
    let t = trunc(x)
    if t < x {
        return t + 1.0
    }
    return t
}

/// Half away from zero, which is what most people mean by rounding.
///
/// Decided on the fraction itself, `x - trunc(x)`, which is exact below 2⁵².
/// The obvious `floor(x + 0.5)` is not: the addition rounds, so
/// `0.49999999999999994 + 0.5` is 1.0 and the largest float below a half
/// rounded up, and above 2⁵² the addition moved `x` to a neighbouring whole
/// number.
pub fn round(x: float) -> float {
    if !(abs(x) < two_52()) {
        return x
    }
    let t = trunc(x)
    let fraction = x - t
    if fraction >= 0.5 {
        return t + 1.0
    }
    if fraction <= -0.5 {
        return t - 1.0
    }
    return t
}

/// A float as an `int`, rounded to nearest.
///
/// A bare `x as int` warns, and rightly: it truncates towards zero, which is
/// almost never what code that measured something meant. Saying `round_to` is
/// saying *which* rounding was intended, and is the escape hatch that makes
/// keeping the warning worthwhile — without one, every program that has to
/// produce an integer from a measurement has to ignore a warning to do it.
pub fn round_to(x: float) -> int {
    return round(x) as int
}

/// A float as an `int`, truncated towards zero — the cast, named.
///
/// Same purpose as [`round_to`]: the bare cast warns because it is usually a
/// mistake, and a caller who means it says which rounding they meant.
pub fn trunc_to(x: float) -> int {
    return x as int
}

/// The square root, correctly rounded. Zero and negatives answer zero; an
/// infinity is its own root.
///
/// Written in Kite rather than reached for from the host: a host call is a
/// boundary two runtimes have to agree about, and this one gives the same bits
/// everywhere — the same bits IEEE 754 requires of a hardware square root.
///
/// **The range is reduced first**, and that is most of the function. `x` is
/// written as `m · 4ᵏ` with `m` in `[1, 4)` — multiplying by 4 and by 2 is
/// exact, so this costs nothing — and Newton runs on `m`, from a start within
/// 25% of the answer, where six steps are more than the quadratic convergence
/// needs. Starting from `x` itself and stopping on an absolute tolerance, as
/// this once did, was right only between about 1e-8 and 1e10: `sqrt(1e12)`
/// answered 1279996.5 and `sqrt(1e-12)` 1.28e-6.
///
/// Newton in floating point lands within one unit in the last place, and a
/// quarter of the time on the wrong side of the halfway point. The last step
/// settles it in integers, where nothing rounds — see [`nearest_root`].
pub fn sqrt(x: float) -> float {
    if x <= 0.0 {
        return 0.0
    }
    // An infinity (or a NaN) answers itself: halving one never ends.
    if !(x < x * 2.0) {
        return x
    }
    var m = x
    var scale = 1.0
    for m >= 4.0 {
        m = m / 4.0
        scale = scale * 2.0
    }
    for m < 1.0 {
        m = m * 4.0
        scale = scale / 2.0
    }
    var guess = (m + 1.0) / 2.0
    for i in 0..6 {
        guess = (guess + m / guess) / 2.0
    }
    return nearest_root(m, guess) * scale
}

/// Of `guess` and its neighbours, the one nearest `√m`, for `m` in `[1, 4)`.
///
/// Both are whole numbers of units in the last place once scaled by 2⁵²: `M`
/// for `m` and `G` for the root, which is in `[1, 2)`. `G` is the nearest
/// exactly when `(G − ½)² < M · 2⁵² < (G + ½)²`, and since both sides are
/// whole numbers that is `−G < M · 2⁵² − G² ≤ G`. The difference is small but
/// its two terms are near 2¹⁰⁶, so it is taken in 26-bit pieces, where every
/// product fits in an `int` and nothing is ever rounded.
fn nearest_root(m: float, guess: float) -> float {
    let unit = 4503599627370496.0
    let piece = 67108864
    let big = trunc_to(m * unit)
    var root = trunc_to(guess * unit)
    for step in 0..3 {
        let high = root / piece
        let low = root % piece
        let cross = 2 * high * low
        let top = (big - high * high) - cross / piece
        let difference = top * 4503599627370496 - (cross % piece) * piece - low * low
        if difference > root {
            root += 1
        } else if difference <= 0 - root {
            root -= 1
        } else {
            break
        }
    }
    return (root as float) / unit
}

/// `base` raised to a whole power. Negative powers give the reciprocal.
///
/// ```kite
/// assert(pow(10.0, 15) == 1000000000000000.0, "an exact power is exact")
/// assert(pow(2.0, -1074) == 5e-324, "down to the smallest float")
/// assert(pow(0.0, -1) > max_float(), "zero to a negative power is infinite")
/// ```
///
/// By squaring, so `pow(x, 1000000000)` is thirty multiplications rather than
/// a billion, and each one is carried in two floats — Dekker's product, as in
/// [`product_error`] — with the power of two kept aside as an `int`. Squaring
/// in one float does not help accuracy, whatever its reputation: the
/// relative error doubles with every squaring, so it grows with the exponent
/// just as repeated multiplication's does, and `pow(1.0000000001, 1000000000)`
/// was wrong in the eighth digit. In two floats the same growth starts from
/// 2⁻¹⁰⁴, and keeping the power of two aside means nothing overflows or
/// underflows on the way, so a power of two below the smallest normal float
/// survives to be the answer.
///
/// The answer is within one unit in the last place, and is the correctly
/// rounded one unless the exact value lies within about `|exponent| · 2⁻⁵²`
/// units of a halfway point — for every exponent below 2³⁰, that is never in
/// practice. An answer in the subnormal range, below 2⁻¹⁰²², is rounded twice.
///
/// Special values are IEEE 754's `pown`: anything to the power zero is 1,
/// NaN included; a zero to a negative power is an infinity, signed when the
/// power is odd; and an odd power keeps the base's sign, zeros and
/// infinities included.
pub fn pow(base: float, exponent: int) -> float {
    if exponent == 0 {
        return 1.0
    }
    let odd = exponent % 2 != 0
    let size = abs(base)
    // A zero, an infinity or a NaN: no arithmetic, only the sign to settle.
    if base == 0.0 || !(size < size * 2.0) {
        if !(size >= 0.0) {
            return base
        }
        let magnitude = if (base == 0.0) == (exponent > 0) { 0.0 } else { 1.0 / 0.0 }
        if odd && (base < 0.0 || 1.0 / base < 0.0) {
            return -magnitude
        }
        return magnitude
    }
    // `size` is `m · 2ᵉ` with `m` in [1, 2), found by halving and doubling,
    // both of which are exact.
    var m = size
    var e = 0
    for m >= 4294967296.0 {
        m = m / 4294967296.0
        e += 32
    }
    for m < 0.00000000023283064365386963 {
        m = m * 4294967296.0
        e -= 32
    }
    for m >= 2.0 {
        m = m / 2.0
        e += 1
    }
    for m < 1.0 {
        m = m * 2.0
        e -= 1
    }
    var acc = Wide{ high: 1.0, low: 0.0, twos: 0 }
    var square = Wide{ high: m, low: 0.0, twos: e }
    // The bits of the exponent's magnitude, read by `%` and `/`, which both
    // truncate, so a negative exponent yields them without being negated —
    // negating `min_int()` is an overflow.
    var n = exponent
    for n != 0 {
        if n % 2 != 0 {
            acc = wide_times(acc, square)
        }
        n = n / 2
        if n != 0 {
            // Every power of the base has its exponent on the same side of
            // zero, so once the square's is past any float's, so is the
            // answer's, and squaring on would overflow `twos`.
            if square.twos > 2200 || square.twos < -2200 {
                acc = Wide{ high: 1.0, low: 0.0, twos: if square.twos > 0 { 5000 } else { -5000 } }
                break
            }
            square = wide_times(square, square)
        }
    }
    var out = 0.0
    if exponent > 0 {
        out = scaled(acc.high, acc.twos)
    } else {
        // The reciprocal of `high + low`, corrected by one Newton step: the
        // residual `1 − r · high` is found exactly, by Dekker's product, and
        // `low` is folded into it.
        let r = 1.0 / acc.high
        let p = r * acc.high
        let residual = ((1.0 - p) - product_error(r, acc.high, p)) - r * acc.low
        out = scaled(r + r * residual, 0 - acc.twos)
    }
    if odd && base < 0.0 {
        return -out
    }
    return out
}

/// A positive number as `(high + low) · 2^twos`, with `high` near [1, 2) and
/// `low` below half a unit in its last place: about 106 bits, and an exponent
/// no float could hold.
struct Wide {
    high: float
    low: float
    twos: int
}

/// The product of two wide numbers, renormalised so `high` is in [1, 2).
fn wide_times(a: Wide, b: Wide) -> Wide {
    let p = a.high * b.high
    let lost = product_error(a.high, b.high, p) + (a.high * b.low + a.low * b.high)
    var high = p + lost
    var low = lost - (high - p)
    var twos = a.twos + b.twos
    if high >= 2.0 {
        high = high / 2.0
        low = low / 2.0
        twos += 1
    } else if high < 1.0 {
        high = high * 2.0
        low = low * 2.0
        twos -= 1
    }
    return Wide{ high: high, low: low, twos: twos }
}

/// The largest finite float.
fn max_float() -> float {
    return 1.7976931348623157e308
}

// ---- integer overflow ------------------------------------------------------
//
// Kite traps on integer overflow in debug builds and wraps in release. That is
// the default most people want, and it means the *same* addition has two
// meanings depending on how the program was built. These two say which one
// they mean, in both builds — which is the only reason they exist.
//
// Both are ordinary Kite, and neither may overflow while deciding whether an
// overflow would happen: computing `a + b` to find out is exactly the trap
// being avoided. So each rearranges the arithmetic to stay in range.

/// The largest `int`.
pub fn max_int() -> int {
    return 9223372036854775807
}

/// The smallest `int`. Written as a subtraction because `9223372036854775808`
/// is not an `int` and so cannot be negated in source.
pub fn min_int() -> int {
    return -9223372036854775807 - 1
}

/// `a + b`, or nil when that does not fit.
///
/// The test is done by subtraction rather than by adding and looking at the
/// result, because adding is what traps. `max_int() - b` is in range whenever
/// `b` is positive, and `min_int() - b` is in range whenever `b` is negative,
/// so neither side of the question can overflow while it is being asked.
pub fn checked_add(a: int, b: int) -> Option<int> {
    if b > 0 && a > max_int() - b {
        return nil
    }
    if b < 0 && a < min_int() - b {
        return nil
    }
    return a + b
}

/// `a + b`, wrapped into the range of an `int` — in every build.
///
/// On overflow the answer is `a + b ∓ 2⁶⁴`, and that is computed rather than
/// discovered: with two positives too large, `(a + min_int()) + (b +
/// min_int())` is the same number and every step of it is in range, because
/// `min_int()` is exactly `-2⁶³` and shifting both operands down by it lands
/// the sum in `[min_int(), -2]`. The negative case is the mirror image.
pub fn wrapping_add(a: int, b: int) -> int {
    let fits = checked_add(a, b)
    if fits != nil {
        return fits
    }
    if a > 0 {
        return (a + min_int()) + (b + min_int())
    }
    return (a - min_int()) + (b - min_int())
}

/// `a - b`, or nil when that does not fit.
///
/// ```kite
/// assert(checked_sub(5, 7) == -2, "in range")
/// assert(checked_sub(min_int(), 1) == nil, "below the smallest int")
/// ```
///
/// The mirror of [`checked_add`]: `max_int() + b` is in range when `b` is
/// negative, and `min_int() + b` when it is positive.
pub fn checked_sub(a: int, b: int) -> Option<int> {
    if b < 0 && a > max_int() + b {
        return nil
    }
    if b > 0 && a < min_int() + b {
        return nil
    }
    return a - b
}

/// `a · b`, or nil when that does not fit.
///
/// ```kite
/// assert(checked_mul(-3, 4) == -12, "in range")
/// assert(checked_mul(min_int(), -1) == nil, "2⁶³ is not an int")
/// assert(checked_mul(4611686018427387904, 2) == nil, "nor is 2⁶³ this way")
/// ```
///
/// Decided by dividing the bound by one factor, which cannot overflow: the
/// only overflowing division is `min_int() / -1`, and the divisor here is
/// always the other factor with the bound's sign worked out first.
pub fn checked_mul(a: int, b: int) -> Option<int> {
    if a == 0 || b == 0 {
        return 0
    }
    if a > 0 {
        if b > 0 && a > max_int() / b {
            return nil
        }
        if b < 0 && b < min_int() / a {
            return nil
        }
    } else {
        if b > 0 && a < min_int() / b {
            return nil
        }
        if b < 0 && b < max_int() / a {
            return nil
        }
    }
    return a * b
}

/// `a - b`, wrapped into the range of an `int` — in every build.
///
/// ```kite
/// assert(wrapping_sub(min_int(), 1) == max_int(), "wraps around")
/// assert(wrapping_sub(0, min_int()) == min_int(), "0 − (−2⁶³) is 2⁶³, which wraps to −2⁶³")
/// ```
///
/// `a + (−b)`, except that `−min_int()` is itself an overflow: subtracting
/// −2⁶³ is adding 2⁶³, which is the same as adding −2⁶³ once wrapped.
pub fn wrapping_sub(a: int, b: int) -> int {
    if b == min_int() {
        return wrapping_add(a, min_int())
    }
    return wrapping_add(a, 0 - b)
}

/// `a · b`, wrapped into the range of an `int` — in every build: the low 64
/// bits of the product, as two's complement.
///
/// ```kite
/// assert(wrapping_mul(max_int(), 2) == -2, "the low 64 bits")
/// assert(wrapping_mul(min_int(), -1) == min_int(), "2⁶³ wraps to −2⁶³")
/// assert(wrapping_mul(-3, 4) == -12, "in range, the product")
/// ```
///
/// Long multiplication in 16-bit pieces, which is what keeps it in range:
/// each piece of each factor is below 2¹⁶, so every product of two pieces is
/// below 2³², and the sums below 2³⁵. Only the four lowest pieces of the
/// product are kept, which is the wrapping.
pub fn wrapping_mul(a: int, b: int) -> int {
    let fits = checked_mul(a, b)
    if fits != nil {
        return fits
    }
    var x: [int] = []
    var y: [int] = []
    for i in 0..4 {
        x.push((a >> (16 * i)) & 65535)
        y.push((b >> (16 * i)) & 65535)
    }
    var pieces: [int] = [0, 0, 0, 0]
    for i in 0..4 {
        for j in 0..4 - i {
            pieces[i + j] = pieces[i + j] + x[i] * y[j]
        }
    }
    var carry = 0
    for i in 0..4 {
        let t = pieces[i] + carry
        pieces[i] = t & 65535
        carry = t >> 16
    }
    // The top piece holds the sign bit; from 2¹⁵ up it is a negative number.
    var top = pieces[3]
    if top >= 32768 {
        top = top - 65536
    }
    return top * 281474976710656 + pieces[2] * 4294967296 + pieces[1] * 65536 + pieces[0]
}

/// `base` raised to a power, or nil when the answer does not fit an `int` or
/// the power is negative — an `int` has no reciprocals.
///
/// ```kite
/// assert(ipow(3, 4) == 81, "ipow")
/// assert(ipow(-2, 63) == min_int(), "exactly the smallest int")
/// assert(ipow(2, 63) == nil, "one past the largest")
/// assert(ipow(0, 0) == 1, "anything to the zero is one")
/// ```
///
/// By squaring, with every product checked. The square is not taken after
/// the last bit of the power is used, so an answer that fits is never
/// refused because a square it did not need would have overflowed.
pub fn ipow(base: int, exponent: int) -> Option<int> {
    if exponent < 0 {
        return nil
    }
    var out = 1
    var square = base
    var n = exponent
    for n > 0 {
        if n % 2 == 1 {
            let next = checked_mul(out, square)
            if next == nil {
                return nil
            }
            out = next
        }
        n = n / 2
        if n > 0 {
            let squared = checked_mul(square, square)
            if squared == nil {
                return nil
            }
            square = squared
        }
    }
    return out
}

/// The remainder of `a / b` with the sign of `b`: the floored modulo, where
/// `%` truncates. `mod_floor(-1, 5)` is 4 where `-1 % 5` is -1, which is
/// what wrapping an index around a ring wants. A zero `b` traps, as `%` does.
///
/// ```kite
/// assert(mod_floor(-1, 5) == 4, "wraps an index")
/// assert(mod_floor(7, -3) == -2, "the sign of b")
/// assert(mod_floor(min_int(), -1) == 0, "no overflow")
/// ```
pub fn mod_floor(a: int, b: int) -> int {
    let r = a % b
    if r != 0 && (r < 0) != (b < 0) {
        return r + b
    }
    return r
}

/// The greatest common divisor, never negative, by Euclid. `gcd(0, 0)` is 0.
///
/// ```kite
/// assert(gcd(12, -18) == 6, "gcd")
/// assert(gcd(0, 5) == 5, "gcd with zero")
/// ```
///
/// Worked on the remainders as they come, which `%` keeps within the
/// divisor's size whatever the signs, so nothing is negated until the end.
/// That end traps for the one answer an `int` cannot hold: 2⁶³, the gcd of
/// `min_int()` with zero or with itself.
pub fn gcd(a: int, b: int) -> int {
    var x = a
    var y = b
    for y != 0 {
        let r = x % y
        x = y
        y = r
    }
    require(x != min_int(), "math.gcd: the answer is 2⁶³, which is not an int")
    if x < 0 {
        return 0 - x
    }
    return x
}

/// The length of the hypotenuse — the distance from the origin to (x, y).
///
/// `sqrt(x * x + y * y)` overflows to infinity once either side passes about
/// 1e154, though the answer is nowhere near that large, and loses its
/// precision to underflow below about 1e-154. So outside a comfortable range
/// both sides are first scaled by a power of two — exact, so it costs no
/// precision — and the answer is scaled back.
pub fn hypot(x: float, y: float) -> float {
    let a = abs(x)
    let b = abs(y)
    // An infinite side makes the hypotenuse infinite even beside a NaN, as
    // C99 has it; `max` would carry the NaN.
    if a > max_float() || b > max_float() {
        return 1.0 / 0.0
    }
    let big = max(a, b)
    if !(big < big * 2.0) {
        // Zero, an infinity, or a NaN: nothing to scale.
        if big == 0.0 {
            return 0.0
        }
        return big
    }
    // 2⁵⁰⁰, 2⁻⁵⁰⁰ and 2⁶⁰⁰, each a power of two and so held exactly.
    if big > 3.273390607896142e150 {
        let down = 2.409919865102884e-181
        return hypot_near(a * down, b * down) / down
    }
    if big < 3.054936363499605e-151 {
        let up = 4.149515568880993e180
        return hypot_near(a * up, b * up) / up
    }
    return hypot_near(a, b)
}

fn hypot_near(a: float, b: float) -> float {
    return sqrt(a * a + b * b)
}

/// A point `t` of the way from `a` to `b`.
pub fn lerp(a: float, b: float, t: float) -> float {
    return a + (b - a) * t
}

/// -1, 0 or 1.
pub fn sign(x: float) -> int {
    if x > 0.0 {
        return 1
    }
    if x < 0.0 {
        return -1
    }
    return 0
}

/// The ratio of a circle's circumference to its diameter, to the precision a
/// `float` holds.
pub fn pi() -> float {
    return 3.141592653589793
}

pub fn e() -> float {
    return 2.718281828459045
}

pub fn tau() -> float {
    return 6.283185307179586
}

pub fn ln2() -> float {
    return 0.6931471805599453
}

/// Positive infinity, which a literal cannot write.
///
/// ```kite
/// assert(inf() > max_float(), "past every finite float")
/// ```
pub fn inf() -> float {
    return 1.0 / 0.0
}

/// A NaN, which a literal cannot write either. It is not equal to anything,
/// itself included: test for one with [`is_nan`].
///
/// ```kite
/// assert(is_nan(nan()), "nan")
/// ```
pub fn nan() -> float {
    return 0.0 / 0.0
}

/// Whether `x` is a NaN.
///
/// A NaN is the one float not ordered against itself, so `x >= x` is false
/// for it alone. Written out here so that a program does not have to: the
/// obvious `x != x` is float equality, which the compiler rightly warns about.
///
/// ```kite
/// assert(is_nan(0.0 / 0.0), "0/0")
/// assert(!is_nan(inf()), "an infinity is a number")
/// ```
pub fn is_nan(x: float) -> bool {
    return !(x >= x)
}

/// Whether `x` is an infinity, of either sign.
///
/// ```kite
/// assert(is_inf(-inf()), "-inf")
/// assert(!is_inf(max_float()) && !is_inf(nan()), "neither the largest float nor a NaN")
/// ```
pub fn is_inf(x: float) -> bool {
    return x > max_float() || x < -max_float()
}

/// Whether `x` is neither an infinity nor a NaN.
///
/// ```kite
/// assert(is_finite(max_float()), "the largest float")
/// assert(!is_finite(inf()) && !is_finite(nan()), "inf and NaN")
/// ```
pub fn is_finite(x: float) -> bool {
    return abs(x) <= max_float()
}

/// The size of `x` with the sign of `y`, a zero's sign included: what it takes
/// to make a -0.0 on purpose. A NaN `y` counts as positive, since a NaN's
/// sign cannot be read in Kite.
///
/// ```kite
/// assert(copysign(3.0, -0.0) == -3.0, "the sign of -0.0")
/// assert(1.0 / copysign(0.0, -1.0) < 0.0, "a negative zero")
/// ```
pub fn copysign(x: float, y: float) -> float {
    let size = abs(x)
    if y < 0.0 || (y == 0.0 && 1.0 / y < 0.0) {
        return -size
    }
    return size
}

/// What is left of `x` after its whole part: `x − trunc(x)`, with `x`'s sign,
/// exact for every float. An infinity has no fraction and answers a zero of
/// its sign; a NaN answers a NaN.
///
/// ```kite
/// assert(fract(2.75) == 0.75, "fract")
/// assert(fract(-1.5) == -0.5, "with the sign of x")
/// assert(1.0 / fract(-3.0) < 0.0, "a whole negative leaves -0.0")
/// ```
pub fn fract(x: float) -> float {
    if is_inf(x) {
        return copysign(0.0, x)
    }
    let f = x - trunc(x)
    if f == 0.0 {
        return x * 0.0
    }
    return f
}

// ---- transcendentals -------------------------------------------------------
//
// Written out here for the same reason `sqrt` is: a host call is a boundary two
// runtimes have to agree about, and `Math.sin` in a browser is not required to
// give the same bits as libm on a laptop. Everything below converges to one
// answer everywhere, so a number a program computes is the same number on the
// web, under the VM and under the JIT — which is what the differential corpus
// compares, and what a `<canvas>` drawn from these coordinates depends on.
//
// Each is the textbook arrangement: reduce the argument to a range where a
// series converges quickly, sum the series, then undo the reduction. The
// reduction is what matters; a Taylor series alone is accurate near zero and
// useless anywhere else.

/// `e` raised to `x`.
///
/// ```kite
/// assert(exp(1.0) == e(), "exp(1) is the float nearest e")
/// assert(exp(710.0) > max_float(), "past the largest float is infinite")
/// ```
///
/// Reduced by `x = k·ln2 + r`, so the series only ever sees `|r| ≤ ln2/2` and
/// the rest is a power of two. Without that a series for `exp(20)` would need
/// hundreds of terms and lose most of its precision to cancellation.
///
/// Within one unit in the last place, and correctly rounded in all but a few
/// cases in a thousand; an answer below 2⁻¹⁰²² is rounded twice. Past `ln`
/// of the largest float the answer is an infinity, as IEEE 754 has it — this
/// used to answer the largest float instead, which no other `exp` does and
/// which made `exp(710)` look like an ordinary number. A NaN answers a NaN.
pub fn exp(x: float) -> float {
    if !(x >= x) {
        return x
    }
    // Past ln of the largest float, and below ln of half the smallest, there
    // is nothing to compute. Between these and the exact thresholds the
    // scaling at the end overflows or rounds to zero by itself.
    if x > 709.8 {
        return 1.0 / 0.0
    }
    if x < -745.2 {
        return 0.0
    }
    return exp_split(x, 0.0)
}

/// `e` raised to `x + tail`, for a `tail` far below a unit in the last place
/// of `x` — which is how [`powf`] hands over an exponent it knows to more bits
/// than a float holds — and `x` within [-745.2, 709.8].
fn exp_split(x: float, tail: float) -> float {
    let k = round(x / ln2())
    // `ln2` in two pieces, high part first. Subtracting `k · ln2` as one
    // rounded double throws away the low bits of the product before the series
    // ever sees them, and at `k = 29` that is already four units in the last
    // place of the answer. The high piece has its last 21 bits zero, so `k`
    // times it is exact for every `k` here and the subtraction is too. It is
    // fdlibm's arrangement, and the reason every libm carries a two-word ln2.
    let high = x - k * 0.6931471803691238
    let (r, r_low) = two_sum(high, tail - k * 1.9082149292705877e-10)
    // e^r = 1 + r + r²/2 · (1 + u), with u = r/3 · (1 + r/4 · (1 + …)) by
    // Horner's rule. At |r| ≤ 0.347 the terms fall off by better than a factor
    // of three each, so twenty of them is well past the point where another
    // changes nothing.
    var u = 0.0
    var n = 20
    for n >= 3 {
        u = r / (n as float) * (1.0 + u)
        n -= 1
    }
    // 1, r and r²/2 are big enough that rounding any of them would show, so
    // r² is Dekker's exact product and the three are summed in two floats;
    // the answer rounds once, at the very end, with everything smaller
    // already in. `r_low` is a nudge to the argument, worth `r_low · e^r`.
    let square = r * r
    let half = square / 2.0
    let (one, one_low) = two_sum(1.0, r)
    let (big, big_low) = two_sum(one, half)
    let small = (big_low + one_low) + (product_error(r, r, square) / 2.0 + half * u + r_low * big)
    return scaled(big + small, round_to(k))
}

/// `(high + low) / d` in two floats, for a small whole `d`: what the division
/// rounded away is `high − d · q`, found exactly by Dekker's product.
fn divided(high: float, low: float, d: float) -> (float, float) {
    let q = high / d
    let t = d * q
    return (q, (((high - t) - product_error(d, q, t)) + low) / d)
}

/// `a + b` and what rounding it lost, exactly: Knuth's sum, which needs no
/// assumption about which of the two is larger.
fn two_sum(a: float, b: float) -> (float, float) {
    let s = a + b
    let v = s - a
    return (s, (a - (s - v)) + (b - v))
}

/// `x · 2ᵏ`, without the power itself overflowing or underflowing first.
///
/// `exp` near either end of its range needs a `k` whose power of two is not a
/// float — 2¹⁰²⁴ is past the largest and 2⁻¹⁰⁷⁵ below the smallest — though
/// the product is. So the power is applied in pieces, each of them exact, and
/// only the last multiplication rounds. `exp(709.7)` used to saturate and
/// `exp(-740)` to answer zero.
///
/// [`pow`] ends here too, so the powers of two are built by [`two_to`]
/// rather than by `pow`.
fn scaled(x: float, k: int) -> float {
    var out = x
    var left = k
    for left > 1000 {
        out = out * two_to(1000)
        left -= 1000
    }
    for left < -1000 {
        out = out * two_to(-1000)
        left += 1000
    }
    return out * two_to(left)
}

/// 2ᵏ for `k` in [-1000, 1000], where every one is a normal float and every
/// step below is exact.
fn two_to(k: int) -> float {
    var out = 1.0
    var left = k
    for left >= 32 {
        out = out * 4294967296.0
        left -= 32
    }
    for left <= -32 {
        out = out / 4294967296.0
        left += 32
    }
    for left > 0 {
        out = out * 2.0
        left -= 1
    }
    for left < 0 {
        out = out / 2.0
        left += 1
    }
    return out
}

/// The natural logarithm. Zero and negatives have none; both answer zero,
/// which is the same choice `sqrt` makes above. An infinity is its own
/// logarithm, and a NaN answers a NaN.
///
/// ```kite
/// assert(ln(e()) == 1.0, "ln(e)")
/// assert(ln(1.0 / 0.0) > max_float(), "ln(inf) is inf")
/// ```
///
/// Correctly rounded in all but a few cases in a thousand, and never a unit
/// in the last place out: the work is done in two floats by [`ln_split`].
pub fn ln(x: float) -> float {
    if x <= 0.0 {
        return 0.0
    }
    if !(x < x * 2.0) {
        return x
    }
    let (high, _) = ln_split(x)
    return high
}

/// `ln x` as `high + low`, to about 2⁻⁶⁶ of a unit — what [`powf`] needs, since
/// `exp` turns an error in its argument into the same relative error in its
/// answer, and the argument is the logarithm times the exponent.
///
/// `x` is reduced to `m · 2ᵏ` with `m` in `[√½, √2)`, by halving and doubling,
/// which are exact. Then `ln m = 2 atanh(s)` with `s = (m − 1)/(m + 1)`, under
/// 0.172 in magnitude: `2s + 2s³/3 + 2s⁵/5 + 2s⁷ (1/7 + s²/9 + …)`. The first
/// three terms are big enough that their rounding would show, so each is
/// carried in two floats, `s` itself included; the rest is under 2⁻¹⁹ and a
/// float is plenty.
/// `k · ln2` is the two-piece constant `exp` uses, whose high piece times `k`
/// is exact.
fn ln_split(x: float) -> (float, float) {
    var m = x
    var k = 0
    for m >= 4294967296.0 {
        m = m / 4294967296.0
        k += 32
    }
    for m < 0.00000000023283064365386963 {
        m = m * 4294967296.0
        k -= 32
    }
    // 1.4142… is √2: the mantissa is halved or doubled until it straddles one
    // rather than merely being in `[1, 2)`, which halves the series argument.
    for m >= 1.4142135623730951 {
        m = m / 2.0
        k += 1
    }
    for m < 0.7071067811865476 {
        m = m * 2.0
        k -= 1
    }
    // `m − 1` is exact, being within a factor of two of `m`; `m + 1` is not,
    // so it is held as a sum and its remainder folds into the low half of `s`.
    let num = m - 1.0
    let (den, den_low) = two_sum(m, 1.0)
    let s = num / den
    let p = s * den
    let s_low = (((num - p) - product_error(s, den, p)) - s * den_low) / den
    let s2 = s * s
    let s2_low = product_error(s, s, s2) + 2.0 * s * s_low
    let s3 = s * s2
    let s3_low = product_error(s, s2, s3) + (s * s2_low + s_low * s2)
    let s5 = s3 * s2
    let s5_low = product_error(s3, s2, s5) + (s3 * s2_low + s3_low * s2)
    let (third, third_low) = divided(s3, s3_low, 3.0)
    let (fifth, fifth_low) = divided(s5, s5_low, 5.0)
    var series = 0.0
    var j = 11
    for j >= 0 {
        series = series * s2 + 1.0 / ((2 * j + 7) as float)
        j -= 1
    }
    let rest = 2.0 * s5 * s2 * series
    let (lead, lead_low) = two_sum(2.0 * s, 2.0 * third)
    let (next, next_low) = two_sum(lead, 2.0 * fifth)
    let low = (lead_low + next_low) + (2.0 * s_low + 2.0 * third_low + 2.0 * fifth_low + rest)
    let turns = k as float
    let (high, high_low) = two_sum(turns * 0.6931471803691238, next)
    let small = high_low + (low + turns * 1.9082149292705877e-10)
    let out = high + small
    return (out, small - (out - high))
}

/// `base` raised to a `float` power, by `exp(exponent · ln base)`.
///
/// ```kite
/// assert(powf(10.0, 2.0) == 100.0, "a whole exponent is pow's answer, exactly")
/// assert(powf(2.0, 0.5) == 1.4142135623730951, "powf(2, 0.5) is the square root")
/// assert(powf(0.0, 0.0) == 1.0, "anything to the zero is one")
/// ```
///
/// A whole exponent is handed to [`pow`], which is exact where this would be
/// approximate, so `powf(10.0, 2.0)` is 100 and `powf(-2.0, 3.0)` is -8. A
/// fractional one is within one unit in the last place — correctly rounded in
/// all but a few cases in a thousand — because the logarithm and the product
/// are carried in two floats: one float's error in `ln base` is multiplied by
/// the exponent before `exp` sees it, and `powf(10.0, 15.0)` came out
/// fourteen units short of 1e15.
///
/// A negative base raised to a fractional power is not a real number and
/// answers zero, the choice `ln` and `sqrt` make for what they cannot answer.
/// The rest is C99's `pow`: anything to the zero, and one to anything, is one,
/// NaNs included; otherwise a NaN answers a NaN; a zero to a negative power is
/// an infinity; and an infinite exponent gives an infinity or a zero by
/// whether the base is above or below one in size, and one when it is one.
pub fn powf(base: float, exponent: float) -> float {
    if exponent == 0.0 || base == 1.0 {
        return 1.0
    }
    if !(base >= base) || !(exponent >= exponent) {
        return base + exponent
    }
    var b = base
    if exponent - trunc(exponent) == 0.0 {
        if abs(exponent) < 9223372036854775807.0 {
            return pow(base, trunc_to(exponent))
        }
        // Past 2⁶³ every float is even, so the base's sign is lost.
        b = abs(base)
    }
    let size = abs(b)
    if !(abs(exponent) < 1.0 / 0.0) {
        if size == 1.0 {
            return 1.0
        }
        return if (size > 1.0) == (exponent > 0.0) { 1.0 / 0.0 } else { 0.0 }
    }
    if b == 0.0 || !(size < size * 2.0) {
        return if (b == 0.0) == (exponent > 0.0) { 0.0 } else { 1.0 / 0.0 }
    }
    if b < 0.0 {
        return 0.0
    }
    let (high, low) = ln_split(b)
    let p = exponent * high
    if p > 709.8 {
        return 1.0 / 0.0
    }
    if p < -745.2 {
        return 0.0
    }
    let lost = product_error(exponent, high, p) + exponent * low
    let (z, z_low) = two_sum(p, lost)
    return exp_split(z, z_low)
}

/// The base-2 logarithm, with `ln`'s edges: zero and negatives answer zero,
/// an infinity is its own, a NaN answers a NaN.
///
/// ```kite
/// assert(log2(8.0) == 3.0, "an exact power is exact")
/// assert(log2(0.5) == -1.0, "below one")
/// ```
///
/// Not `ln(x) / ln2()`, which rounds twice and makes `log2(8)`
/// 2.9999999999999996 or 3.0000000000000004 by luck: the logarithm is
/// divided while still in two floats, by `ln 2` in two floats, so a power of
/// two comes out exactly and the rest is correctly rounded in practice.
pub fn log2(x: float) -> float {
    return log_by(x, 0.6931471805599453, 2.3190468138462996e-17)
}

/// The base-10 logarithm, the same way as [`log2`]: `log10(1000.0)` is
/// exactly 3.
///
/// ```kite
/// assert(log10(1000.0) == 3.0, "log10(1000)")
/// assert(log10(0.001) == -3.0, "log10(0.001)")
/// ```
pub fn log10(x: float) -> float {
    return log_by(x, 2.302585092994046, -2.1707562233822494e-16)
}

/// The logarithm of `x` to any base, `ln x / ln base`, both carried in two
/// floats as [`log2`]'s are. A base that has no logarithms — zero or less, or
/// one — answers zero, as `ln` does for what it cannot answer; so does an `x`
/// of zero or less. A NaN in either answers a NaN.
///
/// ```kite
/// assert(log(3.0, 81.0) == 4.0, "log(3, 81)")
/// assert(log(1.0, 5.0) == 0.0, "base one has no logarithms")
/// ```
pub fn log(base: float, x: float) -> float {
    if is_nan(base) || is_nan(x) {
        return base + x
    }
    if base <= 0.0 || base == 1.0 || x <= 0.0 {
        return 0.0
    }
    if !is_finite(base) || !is_finite(x) {
        return ln(x) / ln(base)
    }
    let (high, low) = ln_split(base)
    return log_by(x, high, low)
}

/// `ln x / (high + low)`, divided in two floats so it rounds once.
fn log_by(x: float, high: float, low: float) -> float {
    if x <= 0.0 {
        return 0.0
    }
    if !(x < x * 2.0) {
        return x
    }
    let (h, l) = ln_split(x)
    let q = h / high
    // The remainder `h + l − q · (high + low)`, its leading part exact: `q ·
    // high` is within a factor of two of `h`, and Dekker's product gives what
    // its rounding lost.
    let p = q * high
    let remainder = (((h - p) - product_error(q, high, p)) + l) - q * low
    return q + remainder / high
}

/// 2 raised to `x`: [`powf`] with base 2, so a whole `x` is an exact power of
/// two and a fractional one is within a unit in the last place.
///
/// ```kite
/// assert(exp2(10.0) == 1024.0, "exp2(10)")
/// assert(exp2(-1074.0) == 5e-324, "down to the smallest float")
/// ```
pub fn exp2(x: float) -> float {
    return powf(2.0, x)
}

/// The hyperbolic sine. Within a few units in the last place; odd, so -0.0
/// and the sign of an infinity are kept; a NaN answers a NaN.
///
/// ```kite
/// assert(sinh(0.0) == 0.0, "sinh(0)")
/// assert(sinh(-710.0) > -inf() && sinh(-710.0) < -max_float() / 2.0, "finite though e^710 is not")
/// ```
///
/// Below one in size by its series, `x + x³/3! + …`, because `(eˣ − e⁻ˣ)/2`
/// is the difference of two numbers near one and has lost most of its
/// digits by `x = 1e-8`. Past 22, `e⁻ˣ` is below a unit in the last place of
/// `eˣ`, and `eˣ/2` is taken as `(e^(x/2)/2) · e^(x/2)`, which stays finite
/// up to where the answer itself is not — `sinh(710)` is about 1.1e308.
pub fn sinh(x: float) -> float {
    let size = abs(x)
    if size < 1.0 {
        let squared = x * x
        var s = 1.0
        var n = 10
        for n >= 1 {
            s = 1.0 + s * squared / ((2 * n * (2 * n + 1)) as float)
            n -= 1
        }
        return x * s
    }
    if size > 22.0 {
        let half = exp(size / 2.0)
        return copysign(half / 2.0 * half, x)
    }
    let e = exp(size)
    return copysign((e - 1.0 / e) / 2.0, x)
}

/// The hyperbolic cosine, `(eˣ + e⁻ˣ)/2`, within a few units in the last
/// place. Even, so `cosh(-x)` is `cosh(x)`; a NaN answers a NaN.
///
/// ```kite
/// assert(cosh(0.0) == 1.0, "cosh(0)")
/// assert(cosh(-710.0) < inf(), "finite though e^710 is not")
/// ```
pub fn cosh(x: float) -> float {
    let size = abs(x)
    if size > 22.0 {
        let half = exp(size / 2.0)
        return half / 2.0 * half
    }
    let e = exp(size)
    return (e + 1.0 / e) / 2.0
}

/// The hyperbolic tangent, in [-1, 1], within a few units in the last place.
/// Odd, so -0.0 is kept; a NaN answers a NaN.
///
/// ```kite
/// assert(tanh(30.0) == 1.0, "tanh(30) rounds to one")
/// assert(tanh(-inf()) == -1.0, "tanh(-inf)")
/// ```
///
/// `1 − 2/(e²ˣ + 1)` from a half up, which never overflows into `inf / inf`
/// as `sinh / cosh` would past 710; below a half, `sinh / cosh`, whose
/// series keeps the digits the subtraction would cancel.
pub fn tanh(x: float) -> float {
    let size = abs(x)
    if size > 22.0 {
        return copysign(1.0, x)
    }
    if size < 0.5 {
        return sinh(x) / cosh(x)
    }
    return copysign(1.0 - 2.0 / (exp(2.0 * size) + 1.0), x)
}

/// The cube root, keeping the sign — unlike `powf`, which cannot.
///
/// ```kite
/// assert(cbrt(-27.0) == -3.0, "the sign is kept")
/// assert(cbrt(-1.0 / 0.0) < -max_float(), "an infinity is its own root")
/// ```
///
/// A zero, an infinity and a NaN are their own roots, signs included. An
/// infinity used to reach Newton's step, where `inf / inf` is a NaN.
pub fn cbrt(x: float) -> float {
    if x == 0.0 || !(abs(x) < abs(x) * 2.0) {
        return x
    }
    if x < 0.0 {
        return -cbrt(-x)
    }
    // Newton on `t³ = x`, from a seed good to a few digits already.
    var guess = exp(ln(x) / 3.0)
    for i in 0..12 {
        let next = (2.0 * guess + x / (guess * guess)) / 3.0
        if abs(next - guess) < 0.0000000001 * guess {
            return next
        }
        guess = next
    }
    return guess
}

/// `x` less a whole number of quarter turns, and how many quarter turns that
/// was.
///
/// The remainder is within `π/4` of zero, where the sine and cosine series are
/// asked to work, and the count says which of `±sin` and `±cos` of it the
/// answer is. Both functions share this, which is what makes `cos(0)` exactly
/// 1: it used to be `sin(0 + π/2)`, and the sine's series summed at `π/2`
/// gives 1.0000000000000002.
///
/// The remainder is `r + tail`, two floats, because it is the difference of
/// two numbers that can agree in almost every bit: a float can be a multiple
/// of `π/2` to within 2⁻⁶¹ of its own size. Held in one float it would be
/// rounded after the cancellation, which is the rounding that matters.
///
/// This used to subtract `π/2` in two pieces whose product with the count was
/// exact below 2³⁰ quarter turns. It was wrong in the sixth digit by 1e10,
/// and from 1e17 the remainder was no longer within `π/4` at all, so the series
/// ran far outside its range: `sin(1e17)` answered 2.79 and `sin(1e20)` 7.8e62.
/// Near and far are now two different reductions, as in every libm — see
/// [`quarter_near`] and [`quarter_far`].
struct Quarter {
    r: float
    tail: float
    turns: int
}

fn quarter(x: float) -> Quarter {
    let size = abs(x)
    // 2¹⁹ · π/2, as far as a count of turns stays below 2²⁰.
    let q = if size < 823550.0 { quarter_near(size) } else { quarter_far(size) }
    if x < 0.0 {
        return Quarter{ r: -q.r, tail: -q.tail, turns: (4 - q.turns) % 4 }
    }
    return q
}

/// The reduction below 2¹⁹ · π/2, where the count `n` of quarter turns is
/// below 2²⁰: fdlibm's, with `π/2` in three 33-bit pieces.
///
/// Each piece times `n` fits in 53 bits and so is exact, and the first
/// subtraction is exact because it takes two numbers within a factor of two
/// of each other. A first remainder that has lost more than sixteen bits to
/// cancellation is taken again with the second piece, and one that has lost
/// more than forty-nine with the third, each time carrying what the
/// subtraction rounded away into `w`. Three pieces are 151 bits of `π/2`,
/// which covers the closest any float in this range comes to a multiple of
/// it.
fn quarter_near(size: float) -> Quarter {
    let n = round(size * 0.6366197723675814)
    var r = size - n * 1.5707963267341256
    var w = n * 6.077100506506192e-11
    var y = r - w
    if abs(y) * 65536.0 < size {
        let t = r
        w = n * 6.077100506303966e-11
        r = t - w
        w = n * 2.0222662487959506e-21 - ((t - r) - w)
        y = r - w
        if abs(y) * 562949953421312.0 < size {
            let u = r
            w = n * 2.0222662487111665e-21
            r = u - w
            w = n * 8.4784276603689e-32 - ((u - r) - w)
            y = r - w
        }
    }
    return Quarter{ r: y, tail: (r - y) - w, turns: round_to(n) % 4 }
}

/// The reduction from 2¹⁹ · π/2 up, by Payne and Hanek's method: in integers,
/// against as many bits of `2/π` as the size needs.
///
/// `size` is a whole number `m` below 2⁵³ times `2ᵉ`, and the number of
/// quarter turns in it is `m · 2ᵉ · (2/π)`. Only that product's last two
/// whole bits matter, since four quarter turns are a whole one, and its
/// fraction is the remainder. So the bits of `2/π` that would only make
/// multiples of four are skipped, and the next 240 are multiplied by `m`
/// exactly, in 24-bit pieces where every product fits an `int`. What is left
/// out below them is under 2⁻¹⁶⁰ of a quarter turn, and no float comes nearer
/// a multiple of `π/2` than about 2⁻⁶¹, so the fraction is right to far
/// more bits than a float holds. Only then is it multiplied by `π/2`.
fn quarter_far(size: float) -> Quarter {
    if !(size <= 1.7976931348623157e308) {
        // An infinity or a NaN, which has no remainder.
        return Quarter{ r: size - size, tail: 0.0, turns: 0 }
    }
    // Halving and doubling are exact, so `m` is the mantissa itself.
    var m = size
    var e = 0
    for m >= 38685626227668133590597632.0 {
        m = m / 4294967296.0
        e += 32
    }
    for m >= 9007199254740992.0 {
        m = m / 2.0
        e += 1
    }
    for m < 4503599627370496.0 {
        m = m * 2.0
        e -= 1
    }
    let mantissa = m as int
    let low = mantissa & 16777215
    let middle = (mantissa >> 24) & 16777215
    let high = mantissa >> 48
    // Piece `i` of `2/π` is worth 2^(e − 24(i + 1)) once multiplied by `m`, a
    // multiple of four for every piece before `first`.
    let first = if e >= 26 { (e - 2) / 24 } else { 0 }
    let window = 10
    let pieces = two_over_pi()
    // Three pieces of `m` times ten of `2/π` make thirteen of product.
    var product: [int] = []
    for i in 0..13 {
        product.push(0)
    }
    // Least significant first: `j` counts up from the window's last piece.
    for j in 0..window {
        let piece = pieces[first + window - 1 - j]
        product[j] = product[j] + low * piece
        product[j + 1] = product[j + 1] + middle * piece
        product[j + 2] = product[j + 2] + high * piece
    }
    var carry = 0
    for i in 0..product.len() {
        let t = product[i] + carry
        product[i] = t & 16777215
        carry = t >> 24
    }
    // The product is the count of quarter turns scaled by 2^point.
    let point = 24 * (first + window) - e
    var turns = bits_at(product, point, 2)
    var fraction: [int] = []
    var at = point - 24
    for at >= 0 {
        fraction.push(bits_at(product, at, 24))
        at -= 24
    }
    // Rounded to the nearest turn: from a half up, the remainder is the next
    // turn less what is left of this one, which is the fraction's complement.
    let past_half = fraction[0] >= 8388608
    if past_half {
        turns = (turns + 1) % 4
        for i in 0..fraction.len() {
            fraction[i] = 16777215 - fraction[i]
        }
    }
    var lead = 0
    for lead < fraction.len() - 5 && fraction[lead] == 0 {
        lead += 1
    }
    // The fraction as two floats: the first 48 bits from its leading piece,
    // exactly, and the next 72 rounded, which is far below the first.
    let top = ((fraction[lead] * 16777216 + fraction[lead + 1]) as float) * pow(0.5, 24 * (lead + 2))
    let next = (fraction[lead + 2] as float) + (fraction[lead + 3] as float) * 5.960464477539063e-8 + (fraction[lead + 4] as float) * 3.552713678800501e-15
    let rest = next * pow(0.5, 24 * (lead + 3))
    let part = top + rest
    let part_tail = rest - (part - top)
    // Times `π/2`, whose float is 6.1e-17 short of it, keeping what the
    // multiplication rounds away.
    let pio2 = 1.5707963267948966
    let turned = part * pio2
    let lost = product_error(part, pio2, turned) + (part * 6.123233995736766e-17 + part_tail * pio2)
    let r = turned + lost
    let tail = lost - (r - turned)
    if past_half {
        return Quarter{ r: -r, tail: -tail, turns: turns }
    }
    return Quarter{ r: r, tail: tail, turns: turns }
}

/// `count` bits of a number held in 24-bit pieces, least significant first,
/// from bit `from` up.
fn bits_at(pieces: [int], from: int, count: int) -> int {
    let at = from / 24
    let shift = from % 24
    var v = pieces[at] >> shift
    if shift + count > 24 && at + 1 < pieces.len() {
        v = v | (pieces[at + 1] << (24 - shift))
    }
    return v & ((1 << count) - 1)
}

/// What rounding `a · b` to `p` lost, exactly: Dekker's product, which needs
/// no fused multiply-add. Each factor is split into halves of 26 bits, whose
/// products are exact.
fn product_error(a: float, b: float, p: float) -> float {
    let a_high = high_half(a)
    let a_low = a - a_high
    let b_high = high_half(b)
    let b_low = b - b_high
    return (((a_high * b_high - p) + a_high * b_low) + a_low * b_high) + a_low * b_low
}

/// The top 26 bits of `x`, by Veltkamp's split.
fn high_half(x: float) -> float {
    let c = 134217729.0 * x
    return c - (c - x)
}

/// The first 1200 bits of `2/π` after the point, 24 to a piece: enough for the
/// window of ten pieces past the ones the largest float skips.
fn two_over_pi() -> [int] {
    return [
        0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62, 0x95993C, 0x439041, 0xFE5163, 0xABDEBB,
        0xC561B7, 0x246E3A, 0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129, 0xA73EE8, 0x8235F5,
        0x2EBB44, 0x84E99C, 0x7026B4, 0x5F7E41, 0x3991D6, 0x398353, 0x39F49C, 0x845F8B, 0xBDF928, 0x3B1FF8,
        0x97FFDE, 0x05980F, 0xEF2F11, 0x8B5A0A, 0x6D1F6D, 0x367ECF, 0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D,
        0x7527BA, 0xC7EBE5, 0xF17B3D, 0x0739F7, 0x8A5292, 0xEA6BFB, 0x5FB11F, 0x8D5D08, 0x560330, 0x46FC7B,
    ]
}

/// The sine series, for `|r| ≤ π/4`.
fn sin_near(r: float) -> float {
    let squared = r * r
    var term = r
    var sum = r
    for n in 1..12 {
        let k = 2 * n
        term = -term * squared / ((k * (k + 1)) as float)
        sum = sum + term
    }
    return sum
}

/// The cosine series, for `|r| ≤ π/4`.
fn cos_near(r: float) -> float {
    let squared = r * r
    var term = 1.0
    var sum = 1.0
    for n in 1..12 {
        let k = 2 * n
        term = -term * squared / (((k - 1) * k) as float)
        sum = sum + term
    }
    return sum
}

/// `sin(r + tail)` for a `tail` below half a unit in the last place of `r`:
/// the tail's share is `tail · cos(r)`, and a cosine good to a percent is
/// plenty for a correction that small.
fn sin_split(r: float, tail: float) -> float {
    return sin_near(r) + tail * (1.0 - r * r * 0.5)
}

/// `cos(r + tail)`, the same way: the tail's share is `−tail · sin(r)`.
fn cos_split(r: float, tail: float) -> float {
    return cos_near(r) - tail * r
}

pub fn sin(x: float) -> float {
    // A zero is its own sine, and the sign is part of the answer: IEEE 754,
    // C and JavaScript all give sin(-0) = -0, and `tan` divides it by one and
    // keeps it. The series cannot, since it adds each term's +0.0 to the -0.0.
    if x == 0.0 {
        return x
    }
    // Within π/4 there is nothing to take away, and `x` is its own remainder,
    // exactly.
    if abs(x) <= 0.7853981633974483 {
        return sin_near(x)
    }
    let q = quarter(x)
    if q.turns == 0 {
        return sin_split(q.r, q.tail)
    }
    if q.turns == 1 {
        return cos_split(q.r, q.tail)
    }
    if q.turns == 2 {
        return -sin_split(q.r, q.tail)
    }
    return -cos_split(q.r, q.tail)
}

pub fn cos(x: float) -> float {
    if abs(x) <= 0.7853981633974483 {
        return cos_near(x)
    }
    let q = quarter(x)
    if q.turns == 0 {
        return cos_split(q.r, q.tail)
    }
    if q.turns == 1 {
        return -sin_split(q.r, q.tail)
    }
    if q.turns == 2 {
        return -cos_split(q.r, q.tail)
    }
    return sin_split(q.r, q.tail)
}

pub fn tan(x: float) -> float {
    let c = cos(x)
    if c == 0.0 {
        return 0.0
    }
    return sin(x) / c
}

/// The arctangent, in radians, in `(-π/2, π/2)`.
///
/// Twice reduced. `atan(x) = π/2 − atan(1/x)` brings anything past 1 inside;
/// the addition formula then brings anything past `tan(π/12)` down to
/// `0.2679`, where the series loses a decimal digit per two terms. Applying the
/// series directly at `x = 1` — where it is Leibniz's series for π/4 — would
/// need thousands of terms.
pub fn atan(x: float) -> float {
    // A zero is its own arctangent, sign and all, as in libm — and `asin`,
    // which comes here, keeps it too. -0.0 is not below zero, so it reached
    // the series and came back +0.0.
    if x == 0.0 {
        return x
    }
    if x < 0.0 {
        return -atan(-x)
    }
    if x > 1.0 {
        return pi() / 2.0 - atan(1.0 / x)
    }
    let root3 = 1.7320508075688772
    if x > 0.2679491924311227 {
        return pi() / 6.0 + atan((x * root3 - 1.0) / (root3 + x))
    }
    let squared = x * x
    var power = x
    var sum = x
    for n in 1..24 {
        power = -power * squared
        sum = sum + power / ((2 * n + 1) as float)
    }
    return sum
}

/// The angle of the point `(x, y)` from the positive x axis, in `[-π, π]`.
///
/// ```kite
/// assert(atan2(-0.0, -1.0) == -pi(), "just below the negative x axis")
/// assert(atan2(1.0 / 0.0, 1.0 / 0.0) == pi() / 4.0, "both infinite")
/// ```
///
/// The quadrant comes from the signs, which is the whole reason this exists
/// separately from `atan(y / x)`: that division throws away which quadrant the
/// point was in, and `(-1, -1)` and `(1, 1)` are not the same direction.
///
/// The signs include a zero's, and the edges are C99's: on the x axis the
/// answer is ±0 or ±π, signed as `y` is — so `atan2(-0.0, -1.0)` is -π, the
/// limit from below the axis, where it used to be +π — and a zero `x` takes
/// `-0.0`'s side as `-x` does. Infinities give the limiting angle: ±π/2
/// against a finite `x`, ±π/4 or ±3π/4 against an infinite one, ±0 or ±π for
/// a finite `y` against one. These used to divide and get a NaN. A NaN in
/// either answers a NaN.
pub fn atan2(y: float, x: float) -> float {
    if !(y >= y) || !(x >= x) {
        return y + x
    }
    // -0.0 is not below zero; only dividing by it tells it from 0.0.
    let below = y < 0.0 || (y == 0.0 && 1.0 / y < 0.0)
    let left = x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)
    let sign = if below { -1.0 } else { 1.0 }
    if y == 0.0 {
        return if left { sign * pi() } else { y }
    }
    if x == 0.0 {
        return sign * pi() / 2.0
    }
    let y_infinite = !(abs(y) <= max_float())
    if !(abs(x) <= max_float()) {
        if y_infinite {
            return sign * (if left { 2.356194490192345 } else { 0.7853981633974483 })
        }
        return if left { sign * pi() } else { sign * 0.0 }
    }
    if y_infinite {
        return sign * pi() / 2.0
    }
    if x > 0.0 {
        return atan(y / x)
    }
    if below {
        return atan(y / x) - pi()
    }
    return atan(y / x) + pi()
}

/// The arcsine, in `[-π/2, π/2]`. Past ±1 there is none, and the answer is
/// that of ±1 — the nearest point that has one. A NaN answers a NaN; it used
/// to be clamped into range and come back as -π/2, a NaN made into an angle.
///
/// Through [`atan`]'s series, so not correctly rounded: within five units in
/// the last place across the range, as measured against libm, and the same
/// for `acos`.
///
/// ```kite
/// assert(asin(1.0) == pi() / 2.0, "asin(1)")
/// assert(!(asin(0.0 / 0.0) >= 0.0) && !(asin(0.0 / 0.0) < 0.0), "a NaN stays one")
/// ```
pub fn asin(x: float) -> float {
    if !(x >= x) {
        return x
    }
    if x >= 1.0 {
        return pi() / 2.0
    }
    if x <= -1.0 {
        return -pi() / 2.0
    }
    // 1 − x² as (1 − x)(1 + x): near ±1, `x * x` has already rounded away
    // most of what the subtraction leaves.
    return atan(x / sqrt((1.0 - x) * (1.0 + x)))
}

/// The arccosine, in `[0, π]`, with `asin`'s edges: past ±1 the answer is
/// that of ±1, and a NaN answers a NaN.
///
/// ```kite
/// assert(acos(1.0) == 0.0 && acos(-1.0) == pi(), "the ends")
/// let near = acos(0.9999999999999998)
/// assert(near > 2.10734242554e-8 && near < 2.10734242555e-8, "near 1")
/// ```
pub fn acos(x: float) -> float {
    if !(x >= x) {
        return x
    }
    if x >= 1.0 {
        return 0.0
    }
    if x <= -1.0 {
        return pi()
    }
    // π/2 − asin(x) is fine in the middle, but as x nears 1 both terms near
    // π/2 and the subtraction cancels: acos(1 − 2⁻⁵³) came out 25 million
    // units in the last place off. Past ±½ the half-angle form
    // 2·atan(√((1 − x)/(1 + x))) has no subtraction to lose, since 1 − x and
    // 1 + x are exact there.
    if x > 0.5 {
        return 2.0 * atan(sqrt((1.0 - x) / (1.0 + x)))
    }
    if x < -0.5 {
        return pi() - 2.0 * atan(sqrt((1.0 + x) / (1.0 - x)))
    }
    return pi() / 2.0 - asin(x)
}

pub fn degrees(radians: float) -> float {
    return radians * 180.0 / pi()
}

pub fn radians(degrees: float) -> float {
    return degrees * pi() / 180.0
}
