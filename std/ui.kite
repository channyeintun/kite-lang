// Layout.
//
// A subset of flexbox, written in Kite. It computes where things go; it draws
// nothing. That separation is the whole point of the design: the same layout
// feeds a DOM renderer and a canvas renderer, and neither can disagree with
// the other about where a box ended up, because neither decides.
//
// The model is deliberately one layout algorithm rather than several. CSS has
// block, inline, float, table, flex and grid, and most of the difficulty of
// writing CSS is knowing which one is in force. Kite has boxes in a row or a
// column, and that is all — which is enough for application UI, and is what
// every UI toolkit that started after the web converged on.

use std/text

pub struct Size {
    pub width: float
    pub height: float
}

pub struct Rect {
    pub x: float
    pub y: float
    pub width: float
    pub height: float
}

pub struct Insets {
    pub top: float
    pub right: float
    pub bottom: float
    pub left: float
}

/// Which way children are laid out.
pub enum Axis {
    Row
    Column
    /// Children share the box instead of dividing it: every one is given the
    /// whole of it, and later children are painted over earlier ones.
    ///
    /// This is the escape hatch §4 names when it excludes absolute
    /// positioning. Without it a modal is a box that *contains* the screen
    /// rather than one that covers it, which is what `material.modal` was —
    /// and every overlay in a design system is the same shape: a dialog, a
    /// menu, a tooltip, a snackbar, a scrim.
    ///
    /// It is a third axis rather than a flag because it is exactly what an
    /// axis decides — how the main-axis space is shared out. A row divides it,
    /// a column divides it the other way, and a stack does not divide it at
    /// all. Nothing else about a box changes.
    Stack
}

/// How spare space along the main axis is distributed.
pub enum Justify {
    Start
    Center
    End
    SpaceBetween
}

/// Where a child sits on the cross axis.
pub enum Align {
    Start
    Center
    End
    Stretch
}

pub struct Style {
    pub axis: Axis
    pub justify: Justify
    pub align: Align
    /// A fixed size, or nil to size from the content.
    pub width: Option<float>
    pub height: Option<float>
    /// Share of the leftover main-axis space. Zero means take none.
    pub grow: float
    pub padding: Insets
    /// Space between children, not before the first or after the last.
    pub gap: float
    /// The size and weight this node's text is measured *and* drawn in, or
    /// zero for the host's own.
    ///
    /// On the style rather than on the paint, because a size changes how much
    /// room a run of text needs and the paint runs long after the room has
    /// been allotted. Putting it on the paint — which is where this started —
    /// lays a title out at 16dp and then draws it at 22, and the title runs
    /// into whatever was measured to sit beside it.
    pub size: float
    pub weight: int
}

/// The same style in a given size and weight — a type scale's one entry.
pub fn in_font(base: Style, size: float, weight: int) -> Style {
    return Style{..base, size: size, weight: weight }
}

/// The host's default size, which is what a style that names none measures in.
pub fn DEFAULT_SIZE() -> float {
    return 16.0
}

/// Select a font, or leave the host's alone. Paired with [`unset_font`].
fn set_font(size: float, weight: int) {
    if size > 0.0 {
        draw.font(size, weight)
    }
}

fn unset_font(size: float) {
    if size > 0.0 {
        draw.font(DEFAULT_SIZE(), 400)
    }
}

/// What a leaf holds. A box with children holds `Empty`; the two are exclusive
/// because a node that was both would need a rule for which wins, and every
/// such rule is a rule someone has to remember.
pub enum Content {
    Empty
    Text(str)
    /// A picture, named by whatever the host can resolve — a URL, a path, a
    /// `data:` URI.
    ///
    /// It carries no size. An image's intrinsic size is only knowable once the
    /// bytes have arrived, and a layout that waited for that would be a layout
    /// that could not run until the network had — so a picture is given a box
    /// by its style and fitted into it. That is a real constraint and it is
    /// stated here rather than discovered: [`image_of`] takes the size.
    Image(str)
}

/// Everything a control states about itself, in one value.
///
/// One field rather than five loose ones on `Node`, because the combinations
/// are not independent. A meaning with no identity is unreachable — activation
/// and focus find controls by id — and text being edited by something that is
/// not a control is not a state anything can act on. Loose fields would make
/// those spellable and leave every reader to decide what they meant; a single
/// optional makes "is this a control" one question with one answer.
/// What a control *is*, to something that cannot see it.
///
/// The parallel tree §7 describes is built out of this. It is a closed set
/// rather than a free string because every value here has to mean something to
/// three different backends — an ARIA role on the DOM, a node in the canvas
/// renderer's parallel tree, a word in a transcript — and a role nobody
/// implements is worse than no role at all: it announces confidently and
/// wrongly.
pub enum Role {
    /// Something that groups other things and says nothing itself.
    Group
    Button
    Link
    Checkbox
    Radio
    Switch
    Slider
    TextField
    /// A picture that carries meaning — ARIA's `img`.
    ///
    /// Named `Picture` rather than `Image` because a pattern names a variant
    /// without its enum, so two enums cannot share a variant name; `Content`
    /// already has an `Image`, and it is the one that had the better claim to
    /// the word.
    Picture
    Heading
    Tab
    MenuItem
    Dialog
    Progress
}

/// The number a role crosses the boundary as.
///
/// Written out rather than derived from the declaration order, because the
/// order of an enum is a thing anyone may reasonably change and this is a wire
/// format three backends agree on.
pub fn role_code(r: Role) -> int {
    return match r {
        Group => 0
        Button => 1
        Link => 2
        Checkbox => 3
        Radio => 4
        Switch => 5
        Slider => 6
        TextField => 7
        Picture => 8
        Heading => 9
        Tab => 10
        MenuItem => 11
        Dialog => 12
        Progress => 13
    }
}

/// What a control is editing.
///
/// One value rather than a `str` and a loose flag beside it, for the reason
/// [`Control`] itself is one value: the two are not independent. Text that
/// nothing is editing has no line policy, and a line policy with no text is
/// not a state anything can be in.
///
/// The distinction it carries cannot be recovered from geometry. A box four
/// lines tall is not the same claim as a field that accepts a newline: the
/// first is a size, the second is what Enter means — and a renderer that makes
/// real elements has to choose between an `<input>` and a `<textarea>` before
/// it knows either.
pub struct Edit {
    pub text: str
    pub multiline: bool
}

pub struct Control<Msg> {
    /// Who this is: hit-testing, focus order, and the semantics tree.
    ///
    /// It replaces a naming convention. A control used to be found by
    /// splitting a node's name on `:` — `checkbox:read3:tick` was part of the
    /// control `checkbox:read3` — and the trouble with a convention is that
    /// nothing enforces it: a plain text node innocently named `row2:subject`
    /// answered as a control, so clicking a message moved the focus and
    /// selected nothing. A field cannot be collided with by accident.
    ///
    /// The id alone, with no *kind* in it. One string carrying two meanings
    /// and punctuation to part them is what went wrong the first time.
    pub id: str
    /// What activating this says: a value, built when the node was built. The
    /// row for task 3 carries `Msg.Toggle(3)`, constructed by the code that
    /// knew the index rather than parsed back out of a name. Nil for a control
    /// that is a place rather than an action.
    pub msg: Option<Msg>
    /// What this control is editing, or nil for not editable.
    pub edits: Option<Edit>
    /// Whether the model believes this control holds focus.
    ///
    /// Set by [`with_focus`] over the whole tree rather than by each component,
    /// which is what keeps "exactly one control is focused" true by
    /// construction. It is deliberately *not* derived from an animated focus
    /// ring: a ring fading out and a ring fading in overlap, and for those few
    /// frames two controls would claim focus.
    pub focused: bool
    /// Whether this control answers at all. A disabled control lays out and
    /// paints exactly as it did; it leaves focus order, and it means nothing
    /// when activated.
    pub enabled: bool
    /// What this control is called, for anything that cannot see it.
    ///
    /// **Required, and a parameter of every constructor.** That is §7's
    /// highest-leverage rule doing its work: a parameter is checked by the
    /// compiler on every build, for every developer, forever — whereas a lint
    /// is switched off and a runtime warning is scrolled past. A control with
    /// no label is the single most common accessibility defect there is, and
    /// here it is a program that does not compile.
    ///
    /// It is not the caption. A caption is what is drawn; a label is what is
    /// announced, and for an icon button there is no caption at all.
    pub label: str
    /// What kind of thing this is. Defaulted by inference — see
    /// [`role_of`] — and overridden with [`as_role`] where the tree knows
    /// better than the inference can.
    pub role: Role
    /// On, off, or neither.
    ///
    /// Nil is not "off": a button is not an unchecked checkbox, and a reader
    /// that announced every control as unchecked would be worse than one that
    /// said nothing. Only a control that *can* be on carries this.
    pub checked: Option<bool>
}

/// The role a control gets when nothing said otherwise.
///
/// Inferred from what the control already claims rather than defaulted to
/// `Group`, because the two commonest kinds are exactly the two the rest of
/// the structure already distinguishes: something that says something when
/// activated is a button, and something that edits text is a text field. What
/// is left — a place rather than an action — is a group, which is what it is.
pub fn role_of<Msg>(c: Control<Msg>) -> Role {
    return match c.role {
        // An explicit role wins. `Group` is also the value that means "not
        // set", which is sound because a control that really is a group is
        // what the inference would answer anyway.
        Group => if c.edits != nil {
            Role.TextField
        } else if c.msg != nil {
            Role.Button
        } else {
            Role.Group
        }
        Button => c.role
        Link => c.role
        Checkbox => c.role
        Radio => c.role
        Switch => c.role
        Slider => c.role
        TextField => c.role
        Picture => c.role
        Heading => c.role
        Tab => c.role
        MenuItem => c.role
        Dialog => c.role
        Progress => c.role
    }
}

/// The message type of a tree that says nothing.
///
/// A tree with no controls still has to name a message type, and in such a
/// program the parameter is doing no work — which is the honest description of
/// that program rather than a wart to hide. This is the name for it. An enum
/// with no variants has no values, so a `Node<Silent>` is one in which no
/// control *can* carry a meaning: the layout demos and the golden tests say so
/// in their types instead of picking an unrelated type and hoping a reader
/// understands why.
pub enum Silent { }

pub struct Node<Msg> {
    pub name: str
    pub style: Style
    pub content: Content
    pub children: [Node<Msg>]
    /// This subtree is one interactive thing, and this is what it says about
    /// itself. Nil for a plain box.
    pub control: Option<Control<Msg>>
    /// How the box looks. The layout never reads this.
    pub decor: Decor
    /// This subtree is painted last, outside whatever clip encloses it.
    ///
    /// It is still laid out exactly where it sits — that is the whole point,
    /// and the difference between a portal and simply declaring the thing at
    /// the root. A tooltip has to know where the control it belongs to ended
    /// up, and only its parent knows that; what it must *not* inherit is the
    /// parent's clip, because the row it is anchored to is inside a scrolling
    /// viewport and the tooltip has to hang outside one.
    pub portal: bool
}

/// One laid-out box, in absolute coordinates.
pub struct Frame {
    pub name: str
    /// The whole box, padding included. This is what a background fills and what
    /// hit-testing tests against.
    pub rect: Rect
    /// The box inside its padding, which is where content goes. A leaf has no
    /// children to inset, so without this its padding would size the box and
    /// then be ignored when its text was drawn.
    pub inner: Rect
    /// How deep in the tree, which is the order to paint in.
    pub depth: int
    /// The node's own text, or empty for a box. Carried here so a painter can
    /// draw what the node *says* without being told again — a widget's caption
    /// is written once, in the tree, and a paint list that restated it would
    /// be a second place for it to be wrong.
    pub content: str
    /// The font the box was measured in, carried through so the painter draws
    /// in the one the layout used. A painter that chose its own would be
    /// choosing a size the box was never sized for.
    pub size: float
    pub weight: int
    /// The nearest enclosing control's id — this node's own if it is one,
    /// otherwise the closest ancestor that is, or nil for neither.
    ///
    /// Stamped once, while the tree is still a tree. Afterwards the frames are
    /// a flat list and the parent of any one of them is no longer knowable
    /// without searching, so `control_at` would be a containment search rather
    /// than a lookup.
    pub control: Option<str>
    /// Whether this frame is the control itself rather than something inside
    /// one, which is what focus order needs to count each control once.
    pub is_control: bool
    /// Whether the control this frame belongs to answers. Carried separately
    /// from `is_control` rather than folded into it, because the two are asked
    /// by different callers: hit-testing wants to know what is under the
    /// pointer even when it is inert, and focus order wants only what can be
    /// reached. One flag standing for both is the mistake `role` made.
    pub enabled: bool
    /// What this frame's control is editing, or nil for anything else.
    ///
    /// A renderer never sees the tree, so a fact the renderer must act on has
    /// to travel on the frame. This is the only one that is not about where
    /// the box is or how it looks: it says *this region is a text input*, and
    /// a DOM renderer answers it with a real `<input>` or `<textarea>` — which
    /// is the only way to get a caret that can be dragged, a selection, an IME
    /// and a phone's keyboard, none of which can be drawn.
    pub edits: Option<Edit>
    /// The picture this frame holds, or nil for anything else.
    ///
    /// Beside `content` rather than replacing it, for the same reason `edits`
    /// is its own field: a renderer never sees the tree, so what it must act on
    /// travels on the frame, and the three are different claims. `content` is
    /// text to draw; this is a picture to fetch.
    pub image: Option<str>
    /// What this control is called, its kind, and whether it is on — the three
    /// things the parallel tree in §7 is built from.
    ///
    /// Carried on every frame and meaningful only where `is_control` is true,
    /// which is the same arrangement `control` and `enabled` already have: a
    /// frame is a flat record, and an optional group would cost a narrowing at
    /// every use to save nothing.
    pub label: str
    pub role: Role
    pub checked: Option<bool>
    /// Whether the model believes this control holds focus.
    ///
    /// The DOM gets focus right on its own — a real element either has it or
    /// does not. This is for the renderers that have no real elements, where
    /// the parallel tree is the only thing that can say so.
    pub focused: bool
    pub decor: Decor
    /// Whether this frame came out of a portal — see [`Node.portal`].
    ///
    /// Frames are handed back in paint order, and `layout` has already moved
    /// portals to the end, so anything reading the list in order gets them on
    /// top for free: `hit` finds them first, `paint` draws them last. The flag
    /// remains because one caller has to treat them differently — a painter
    /// that opened a clip has to close it before it reaches them.
    pub portal: bool
}

// ---- construction ---------------------------------------------------------

pub fn insets(all: float) -> Insets {
    return Insets{ top: all, right: all, bottom: all, left: all }
}

pub fn insets_none() -> Insets {
    return insets(0.0)
}

pub fn insets_xy(x: float, y: float) -> Insets {
    return Insets{ top: y, right: x, bottom: y, left: x }
}

/// A style with everything at its default. Kite has no zero values, so a
/// default is a function rather than an omission — which means there is one
/// place to read to know what a default is.
pub fn style() -> Style {
    return Style{
        axis: Axis.Row,
        justify: Justify.Start,
        align: Align.Start,
        width: nil,
        height: nil,
        grow: 0.0,
        padding: insets_none(),
        gap: 0.0,
        size: 0.0,
        weight: 400,
    }
}

pub fn row() -> Style {
    return style()
}

/// A box whose children share it rather than divide it — the overlay
/// primitive. Later children paint over earlier ones.
pub fn stack() -> Style {
    return Style{..style(), axis: Axis.Stack }
}

pub fn column() -> Style {
    return Style{..style(), axis: Axis.Column }
}

pub fn sized(base: Style, width: float, height: float) -> Style {
    return Style{..base, width: width, height: height }
}

pub fn grown(base: Style, amount: float) -> Style {
    return Style{..base, grow: amount }
}

pub fn padded(base: Style, amount: float) -> Style {
    return Style{..base, padding: insets(amount) }
}

pub fn spaced(base: Style, amount: float) -> Style {
    return Style{..base, gap: amount }
}

/// This node's control, or a fresh one under `id`.
///
/// Every setter below goes through here, so they compose: making a field
/// editable and then giving it a meaning leaves it editable, rather than the
/// second call quietly discarding what the first said. A setter that reset the
/// fields it does not mention would make the order of two independent
/// statements matter, which is the kind of rule nobody remembers.
fn controlled<Msg>(node: Node<Msg>, id: str, label: str) -> Control<Msg> {
    let existing = node.control
    if existing != nil {
        return Control{..existing, id: id, label: label }
    }
    return Control{
        id: id,
        msg: nil,
        edits: nil,
        focused: false,
        enabled: true,
        label: label,
        role: Role.Group,
        checked: nil,
    }
}

/// The same node, made a control that is a place rather than an action:
/// hit-testable and focusable, saying nothing when activated.
pub fn control<Msg>(node: Node<Msg>, id: str, label: str) -> Node<Msg> {
    return Node{..node, control: controlled(node, id, label) }
}

/// The same control, told what kind of thing it is.
///
/// Only needed where the inference cannot reach: a checkbox and a button both
/// say something when activated, and nothing in the tree distinguishes them.
pub fn as_role<Msg>(node: Node<Msg>, r: Role) -> Node<Msg> {
    let mine = node.control
    if mine == nil {
        return node
    }
    return Node{..node, control: Control{..mine, role: r } }
}

/// The same control, on or off.
///
/// This is what a reader announces beside the label — "Read receipts, switch,
/// on" — and it is the state the picture already shows to anyone who can see
/// it. A control that is neither on nor off does not call this.
pub fn checked<Msg>(node: Node<Msg>, on: bool) -> Node<Msg> {
    let mine = node.control
    if mine == nil {
        return node
    }
    return Node{..node, control: Control{..mine, checked: on } }
}

/// The same node, made a control that says something when activated.
///
/// `id` is who it is and `msg` is what it means — the two set together,
/// because a meaning without an identity would be unreachable.
pub fn means<Msg>(node: Node<Msg>, id: str, msg: Msg, label: str) -> Node<Msg> {
    return Node{..node, control: Control{..controlled(node, id, label), msg: msg } }
}

/// The same node, made an editable control currently showing `value`.
///
/// The tree carries the current text down and an edit carries the next text
/// up, so the model stays the only thing that remembers what a field holds.
///
/// One line. Enter is the application's — it submits, or it does whatever the
/// program says a key means. For a field that takes a newline instead, see
/// [`editable_lines`].
pub fn editable<Msg>(node: Node<Msg>, id: str, value: str, label: str) -> Node<Msg> {
    return Node{
        ..node,
        control: Control{
            ..controlled(node, id, label),
            edits: Edit{ text: value, multiline: false },
        },
    }
}

/// The same, for a field that takes more than one line.
///
/// Enter belongs to the field here rather than to the application: it puts a
/// newline in, and the program does not hear it. That is the whole difference
/// between the two, and it is why this is a separate constructor rather than a
/// height — a text area three lines tall and a text area ten lines tall differ
/// in size, while a text area and an input differ in what a key means.
pub fn editable_lines<Msg>(node: Node<Msg>, id: str, value: str, label: str) -> Node<Msg> {
    return Node{
        ..node,
        control: Control{
            ..controlled(node, id, label),
            edits: Edit{ text: value, multiline: true },
        },
    }
}

/// The same control, turned off: still laid out, still painted, no longer in
/// focus order and no longer meaning anything. A node that is not a control
/// is returned unchanged — there is nothing to disable.
pub fn disabled<Msg>(node: Node<Msg>) -> Node<Msg> {
    let mine = node.control
    if mine == nil {
        return node
    }
    return Node{..node, control: Control{..mine, enabled: false } }
}

/// The tree, with focus where the model says it is.
///
/// Applied once at the root rather than by each component, which is what makes
/// "exactly one control is focused" true by construction instead of true by
/// thirty call sites agreeing. Passing `nil` focuses nothing, which is the
/// honest state before anything has been touched.
pub fn with_focus<Msg>(root: Node<Msg>, id: Option<str>) -> Node<Msg> {
    var children: [Node<Msg>] = []
    for child in root.children {
        children.push(with_focus(child, id))
    }
    let mine = root.control
    if mine == nil {
        return Node{..root, children: children }
    }
    // Narrowing works on a local through an `if`, not through `&&` inside an
    // expression, so the optional is opened before it is compared.
    var holds = false
    if id != nil {
        holds = mine.id == id
    }
    return Node{..root, children: children, control: Control{..mine, focused: holds } }
}

/// The control with this id, anywhere in the tree, or nil.
///
/// Dispatch is *derived* rather than kept. An application could maintain a
/// `{id: Msg}` table beside its tree and look the answer up in one step, and
/// the reader demo is the standing evidence for what happens next: a second
/// tree-shaped thing maintained by hand falls out of step with the first, and
/// nothing tells you. A walk cannot disagree with the tree it walked.
pub fn control_of<Msg>(root: Node<Msg>, id: str) -> Option<Control<Msg>> {
    let mine = root.control
    if mine != nil {
        if mine.id == id {
            return mine
        }
    }
    for child in root.children {
        let found = control_of(child, id)
        if found != nil {
            return found
        }
    }
    return nil
}

/// What activating the control at a point would say, or nil.
///
/// Nil covers three different situations on purpose — nothing was hit, what
/// was hit is a place rather than an action, and what was hit is disabled —
/// because an application does the same thing in all three: nothing. A caller
/// that needs to tell them apart has [`control_at`] and [`control_of`].
pub fn msg_at<Msg>(root: Node<Msg>, frames: [Frame], x: float, y: float) -> Option<Msg> {
    let id = control_at(frames, x, y)
    if id == nil {
        return nil
    }
    let found = control_of(root, id)
    if found == nil {
        return nil
    }
    if !found.enabled {
        return nil
    }
    return found.msg
}

/// The same node, decorated. Layout is unaffected — that is the invariant.
pub fn decorated<Msg>(node: Node<Msg>, how: Decor) -> Node<Msg> {
    return Node{..node, decor: how }
}

pub fn box_of<Msg>(name: str, base: Style, children: [Node<Msg>]) -> Node<Msg> {
    return Node{
        name: name,
        style: base,
        content: Content.Empty,
        children: children,
        control: nil,
        decor: no_decor(),
        portal: false,
    }
}

pub fn text_of<Msg>(name: str, base: Style, body: str) -> Node<Msg> {
    return Node{
        name: name,
        style: base,
        content: Content.Text(body),
        children: [],
        control: nil,
        decor: no_decor(),
        portal: false,
    }
}

/// A picture, in a box you state.
///
/// The size is a parameter rather than a field on `Style` for the reason §3
/// gives for labels: what is required is a parameter. An image whose box was
/// omitted would lay out as nothing and disappear, and the first anyone would
/// know of it is an empty space in a running program — whereas a missing
/// argument is a compile error.
pub fn image_of<Msg>(name: str, base: Style, src: str, width: float, height: float) -> Node<Msg> {
    return Node{
        name: name,
        style: Style{..base, width: width, height: height },
        content: Content.Image(src),
        children: [],
        control: nil,
        decor: no_decor(),
        portal: false,
    }
}

/// The same subtree, painted last and outside any clip around it.
///
/// Where [`stack`] puts one child over another *within a box*, a portal takes a
/// subtree out of the box entirely at paint time while leaving it in place at
/// layout time. That is the combination nothing else can express: a menu that
/// belongs to a button three levels inside a scrolling list has to be positioned
/// by that button and must not be cut off by the list.
///
/// It also becomes topmost for hit-testing, because `layout` moves it to the end
/// of the frame list and everything that reads that list reads it in order.
pub fn portal<Msg>(node: Node<Msg>) -> Node<Msg> {
    return Node{..node, portal: true }
}

// ---- measurement ----------------------------------------------------------

/// The height of one line, from the host's font: ascent plus descent plus
/// leading, which is what a line of text actually occupies.
pub fn line_height() -> float {
    return text.height()
}

/// How much space a run of text needs.
///
/// The width comes from the host, because only the host has the font — and two
/// hosts may legitimately disagree, which is what different fonts are. Under a
/// runtime with no font at all the answer is a nominal advance per character,
/// which is wrong for proportional text and consistent, so a layout stays
/// comparable across backends.
///
pub fn text_size(body: str) -> Size {
    // A hard break ends a line whether or not anything is wrapping, so a run
    // that is never given a width is still as many lines tall as it has breaks
    // in it.
    //
    // Measuring it as a single run is what let a `\n` mean nothing to the
    // layout while the DOM renderer, which sets `white-space: pre`, drew it as
    // two lines and overflowed the box it was given. The two renderers
    // disagreed about a plain text node, which is the one thing the split is
    // not allowed to do.
    let lines = hard_lines(body)
    if lines.len() == 1 {
        return Size{ width: text.width(body), height: line_height() }
    }
    var widest = 0.0
    for line in lines {
        widest = maxf(widest, text.width(line))
    }
    return Size{ width: widest, height: intToFloat(lines.len()) * line_height() }
}

/// A run split at its mandatory breaks and nowhere else.
///
/// This is the part of line breaking that is not a measurement: where `wrap`
/// asks how much fits, a break in the text says the line ends here regardless.
/// UAX #14 calls these the mandatory break classes; the only one Kite reads is
/// `\n`, because that is the only one a Kite string literal can carry.
pub fn hard_lines(body: str) -> [str] {
    var out: [str] = []
    var current = ""
    for i in 0..body.len() {
        let c = body.slice(i, i + 1)
        if c == "\n" {
            out.push(current)
            current = ""
        } else {
            current = current + c
        }
    }
    out.push(current)
    return out
}

/// A run broken into lines that fit within `limit`.
///
/// Greedy and word-based: it breaks at spaces, taking as much as fits on each
/// line. That is not UAX #14 — it will not break a long URL, and it knows
/// nothing about the rules for CJK, where a line may break between almost any
/// two characters. Both need the line-breaking property table, which is the
/// canvas renderer's business.
///
/// A word longer than the limit gets a line of its own and overflows it, which
/// is what every wrapper does short of breaking words apart.
/// The same, in a named size and weight.
///
/// A widget that sizes itself to its caption has to measure in the font the
/// caption will be drawn in — a button laid out against 16dp and captioned at
/// 14dp is a button with the wrong amount of air in it.
pub fn text_size_in(body: str, size: float, weight: int) -> Size {
    set_font(size, weight)
    let out = text_size(body)
    unset_font(size)
    return out
}

/// The same, in a named size and weight.
///
/// Wrapping is measured, so it has to be measured in the font the text will be
/// drawn in: a caller that wrapped at the host's default and drew at 14dp would
/// break its lines in the wrong places.
pub fn wrap_in(body: str, limit: float, size: float, weight: int) -> [str] {
    set_font(size, weight)
    let out = wrap(body, limit)
    unset_font(size)
    return out
}

pub fn wrap(body: str, limit: float) -> [str] {
    let pieces = pieces_of(body)
    if pieces.len() == 0 {
        return [""]
    }

    var lines: [str] = []
    var current = ""
    // Whether anything has been accumulated yet. The first piece begins the
    // first line rather than being appended to it — unless a break stands in
    // front of it, in which case the first line is the empty one before it.
    var started = false
    for i in 0..pieces.len() {
        let piece = pieces[i]
        if piece.breaks > 0 {
            // A mandatory break is not a measurement: the line ends here
            // whether or not the next piece would have fitted. Every break
            // after the first leaves a line with nothing on it, which is what
            // a blank line in the text is.
            lines.push(current)
            for b in 1..piece.breaks {
                lines.push("")
            }
            current = piece.body
            started = true
        } else if !started {
            current = piece.body
            started = true
        } else {
            // Whether a space goes back between two pieces is *recorded* when
            // they are split, not guessed at afterwards. It used to be inferred
            // — a one-character piece wide enough to be CJK was assumed to have
            // had no space before it, anything else was assumed to have had one
            // — and the inference was wrong for every script that gets split
            // for some other reason. Burmese does: a mark measured on its own is
            // wide, so a cluster came apart, and the rejoin then pushed a space
            // into the middle of a word. `ဆယ်လ်` became `ဆယ် လ်` on screen.
            let candidate = if piece.spaced { current + " " + piece.body } else { current + piece.body }
            if text.width(candidate) <= limit {
                current = candidate
            } else {
                lines.push(current)
                current = piece.body
            }
        }
    }
    lines.push(current)
    return lines
}

/// The pieces a line may be broken between.
///
/// This is a **subset of UAX #14**, and the subset is named rather than
/// implied: a run of Latin text breaks between words, and CJK breaks between
/// characters — which is most of what the rules say for most text, and is the
/// difference between a Japanese paragraph laid out and one drawn as a single
/// enormous word.
///
/// What it does not do: it will not break a long URL, it does not know
/// non-breaking spaces, and it will happily leave a closing bracket at the
/// start of a line. Each of those needs the line-breaking property table,
/// which belongs with the canvas renderer.
/// A run of text that may be broken from the one before it, and whether a
/// space stood between them.
///
/// The flag is the whole point. Splitting is lossy — a break at a space and a
/// break between two CJK characters look identical afterwards — so what was
/// there is recorded rather than reconstructed from the shape of the piece.
struct Piece {
    body: str
    spaced: bool
    /// How many mandatory breaks stand between this piece and the one before
    /// it. Counted rather than flagged, because two breaks in a row are a
    /// blank line and a boolean cannot say how many lines to leave.
    breaks: int
}

fn pieces_of(body: str) -> [Piece] {
    var out: [Piece] = []
    var current = ""
    // Whether the piece being accumulated had a space before it.
    var after_space = false
    // Mandatory breaks standing in front of the piece being accumulated.
    var pending = 0
    for i in 0..body.len() {
        let c = body.slice(i, i + 1)
        if c == "\n" {
            if current.len() > 0 {
                out.push(Piece{ body: current, spaced: after_space, breaks: pending })
                current = ""
                pending = 0
            }
            pending = pending + 1
            // A break subsumes the space in front of it. The space was only
            // ever a separator, and the break separates more strongly — so a
            // rejoined line does not start with the space that ended the last
            // one.
            after_space = false
        } else if c == " " {
            if current.len() > 0 {
                out.push(Piece{ body: current, spaced: after_space, breaks: pending })
                current = ""
                pending = 0
            }
            after_space = true
        } else if wide(c) {
            // A wide character is its own piece, and so is whatever
            // preceded it. Neither had a space between them.
            if current.len() > 0 {
                out.push(Piece{ body: current, spaced: after_space, breaks: pending })
                current = ""
                pending = 0
                after_space = false
            }
            out.push(Piece{ body: c, spaced: after_space, breaks: pending })
            pending = 0
            after_space = false
        } else {
            current = current + c
        }
    }
    if current.len() > 0 {
        out.push(Piece{ body: current, spaced: after_space, breaks: pending })
    } else if pending > 0 {
        // A body ending in a break ends with an empty line, and something has
        // to carry it: `"a\n"` is two lines, the second of them blank.
        out.push(Piece{ body: "", spaced: false, breaks: pending })
    }
    return out
}

/// Whether a piece joins the line before it with no space.
///
/// A piece that came from a wide character had no space before it, so putting
/// one back would open a gap that was never in the text.

/// Whether a character is one a line may break either side of.
///
/// Measured rather than tabulated: a character wider than a Latin one under
/// the host's own font is a CJK or full-width character, and the host is the
/// only thing that knows its font. A runtime with no font answers with a
/// nominal advance per character, where every character is the same width and
/// nothing is wide — which is the right answer there, because nothing is being
/// drawn.
fn wide(c: str) -> bool {
    return text.width(c) > text.width("W") * 1.2
}

/// How much space a run needs once wrapped to `limit`.
pub fn wrapped_size(body: str, limit: float) -> Size {
    let lines = wrap(body, limit)
    var widest = 0.0
    for line in lines {
        widest = maxf(widest, text.width(line))
    }
    return Size{ width: widest, height: intToFloat(lines.len()) * line_height() }
}

/// Kite performs no implicit numeric conversion, so this is written out.
pub fn intToFloat(n: int) -> float {
    return n as float
}

fn horizontal(pad: Insets) -> float {
    return pad.left + pad.right
}

fn vertical(pad: Insets) -> float {
    return pad.top + pad.bottom
}

fn is_row(a: Axis) -> bool {
    return match a {
        Row => true
        Column => false
        Stack => false
    }
}

fn is_stack(a: Axis) -> bool {
    return match a {
        Stack => true
        Row => false
        Column => false
    }
}

/// The size a node wants, ignoring what it is given.
///
/// A fixed width or height wins outright. Otherwise a leaf measures its
/// content and a box measures its children: summed along the main axis with
/// the gaps, and the largest along the cross axis.
pub fn measure<Msg>(node: Node<Msg>) -> Size {
    let pad = node.style.padding
    let inner = measure_content(node)

    var w = inner.width + horizontal(pad)
    var h = inner.height + vertical(pad)
    // Narrowing works on a local, not on a path through fields — the compiler
    // cannot know a field has not changed between the test and the use — so the
    // optional is bound before it is tested.
    let fixed_w = node.style.width
    if fixed_w != nil {
        w = fixed_w
    }
    let fixed_h = node.style.height
    if fixed_h != nil {
        h = fixed_h
    }
    return Size{ width: w, height: h }
}

fn measure_content<Msg>(node: Node<Msg>) -> Size {
    let body = match node.content {
        Empty => ""
        Text(s) => s
        // A picture is whatever box it was given, and `measure` applies that
        // from the style. There is nothing to measure here: an intrinsic size
        // would have to be asked of the host, and the host does not have it
        // until the bytes arrive.
        Image(src) => ""
    }
    if body.len() > 0 {
        set_font(node.style.size, node.style.weight)
        // Text wraps when it has been given a width, and not otherwise. Which
        // width to wrap to is only knowable once a parent has decided, and
        // measurement runs before that — so a node that wants to wrap says how
        // wide it is, and a node that does not is measured as one run.
        //
        // Flexbox answers this with a second measurement pass after the first
        // layout. That is more capable and much harder to predict, and predicting
        // it is most of what makes CSS difficult.
        let fixed = node.style.width
        if fixed != nil {
            let wrapped = wrapped_size(body, fixed - horizontal(node.style.padding))
            unset_font(node.style.size)
            return wrapped
        }
        let one = text_size(body)
        unset_font(node.style.size)
        return one
    }
    if node.children.len() == 0 {
        return Size{ width: 0.0, height: 0.0 }
    }

    // A stack wants the room its largest child wants, on both axes at once:
    // nothing is placed after anything else, so nothing accumulates. The gap
    // means nothing here and is not applied — there is no space *between* two
    // children that occupy the same place.
    if is_stack(node.style.axis) {
        var widest = 0.0
        var tallest = 0.0
        for child in node.children {
            let size = measure(child)
            widest = maxf(widest, size.width)
            tallest = maxf(tallest, size.height)
        }
        return Size{ width: widest, height: tallest }
    }

    let gaps = node.style.gap * intToFloat(node.children.len() - 1)
    var main = 0.0
    var cross = 0.0
    for child in node.children {
        let size = measure(child)
        let along = if is_row(node.style.axis) { size.width } else { size.height }
        let across = if is_row(node.style.axis) { size.height } else { size.width }
        main = main + along
        cross = maxf(cross, across)
    }
    main = main + gaps

    if is_row(node.style.axis) {
        return Size{ width: main, height: cross }
    }
    return Size{ width: cross, height: main }
}

// ---- arrangement ----------------------------------------------------------

/// Lay a tree out inside a viewport, producing one frame per node in paint
/// order — parents before their children, which is the order a painter needs
/// and the reverse of the order hit-testing needs.
pub fn layout<Msg>(root: Node<Msg>, viewport: Size) -> [Frame] {
    let fixed_w = root.style.width
    let fixed_h = root.style.height
    let w = if fixed_w != nil { fixed_w } else { viewport.width }
    let h = if fixed_h != nil { fixed_h } else { viewport.height }
    return lifted(arrange(root, Rect{ x: 0.0, y: 0.0, width: w, height: h }, 0, nil, true))
}

/// Move every portal subtree to the end, keeping the order they were declared.
///
/// Done once, here, rather than by each consumer: paint order, hit order and
/// focus order are all *the order of this list*, so a portal that is last in it
/// is on top in all three at once. A painter that reordered for itself would
/// have left `hit` disagreeing with what a person can see, which is the worst
/// kind of bug to find.
///
/// A subtree is the portal's own frame plus every frame after it that is
/// deeper, which is exactly what `arrange` emits: parents before children,
/// depth-first.
fn lifted(frames: [Frame]) -> [Frame] {
    // Almost every tree has no portal in it, and that case should cost one
    // pass and no copying.
    var any = false
    for f in frames {
        if f.portal {
            any = true
            break
        }
    }
    if !any {
        return frames
    }

    var grounded: [Frame] = []
    var raised: [Frame] = []
    // How far the subtree currently being raised extends. Frames up to and
    // including it go up with it rather than being reconsidered.
    var raising_until = -1
    for k in 0..frames.len() {
        let f = frames[k]
        if k <= raising_until {
            raised.push(f)
        } else if f.portal {
            raised.push(f)
            var last = k
            for j in (k + 1)..frames.len() {
                if frames[j].depth > f.depth {
                    last = j
                } else {
                    break
                }
            }
            raising_until = last
        } else {
            grounded.push(f)
        }
    }
    return concat(grounded, raised)
}

/// How far in the first child sits.
fn leading_space(j: Justify, spare: float) -> float {
    return match j {
        Start => 0.0
        Center => spare / 2.0
        End => spare
        SpaceBetween => 0.0
    }
}

/// The distance between one child and the next. `SpaceBetween` spreads the
/// spare space into the gaps rather than pushing everything to one side; with
/// fewer than two children there are no gaps to spread it into.
fn between_space(j: Justify, gap: float, spare: float, count: int) -> float {
    return match j {
        SpaceBetween => if count > 1 { gap + spare / intToFloat(count - 1) } else { gap }
        Start | Center | End => gap
    }
}

/// A child's size across the axis: its own, unless it is being stretched.
fn cross_size(a: Align, available: float, natural: float) -> float {
    return match a {
        Stretch => available
        Start | Center | End => natural
    }
}

/// Where a stacked child sits along the box's width.
///
/// `justify` reads the same way it does in a row — start, centre, end — which
/// is what keeps a stack legible beside the other two axes. `SpaceBetween` has
/// nothing to spread when every child is in the same place, so it means start.
fn along_offset(j: Justify, available: float, natural: float) -> float {
    return match j {
        Start => 0.0
        Center => maxf(0.0, (available - natural) / 2.0)
        End => maxf(0.0, available - natural)
        SpaceBetween => 0.0
    }
}

fn cross_offset(a: Align, available: float, natural: float) -> float {
    return match a {
        Start => 0.0
        Stretch => 0.0
        Center => maxf(0.0, (available - natural) / 2.0)
        End => maxf(0.0, available - natural)
    }
}

fn arrange<Msg>(
    node: Node<Msg>,
    rect: Rect,
    depth: int,
    inherited: Option<str>,
    inherited_enabled: bool,
) -> [Frame] {
    // A control owns itself and everything under it.
    // Narrowing turns `mine` into a `Control` inside the guard, so the two are
    // assigned rather than chosen between: a value `if` needs both branches to
    // have the one type, and here they deliberately do not.
    let mine = node.control
    var owner = inherited
    var live = inherited_enabled
    var editing: Option<Edit> = nil
    // Only the control's own frame carries the semantics, for the same reason
    // it alone carries the field: a box inside a button is not a second button,
    // and a reader given both would announce the same thing twice.
    var says = ""
    var kind = Role.Group
    var on: Option<bool> = nil
    var has_focus = false
    if mine != nil {
        owner = mine.id
        live = mine.enabled
        // Only the control's own frame is the field. A box inside an editable
        // control is not a second input, and stamping it would make one.
        editing = mine.edits
        says = mine.label
        kind = role_of(mine)
        on = mine.checked
        has_focus = mine.focused
    }
    let pad = node.style.padding
    let inner = Rect{
        x: rect.x + pad.left,
        y: rect.y + pad.top,
        width: maxf(0.0, rect.width - horizontal(pad)),
        height: maxf(0.0, rect.height - vertical(pad)),
    }

    var frames = [
        Frame {
            name: node.name,
            rect: rect,
            inner: inner,
            depth: depth,
            content: match node.content {
                Text(body) => body,
                Empty => "",
                Image(src) => "",
            },
            image: match node.content {
                Image(src) => src,
                Text(body) => nil,
                Empty => nil,
            },
            size: node.style.size,
            weight: node.style.weight,
            control: owner,
            is_control: mine != nil,
            enabled: live,
            edits: editing,
            label: says,
            role: kind,
            checked: on,
            focused: has_focus,
            decor: node.decor,
            portal: node.portal,
        },
    ]
    if node.children.len() == 0 {
        return frames
    }

    // A stack shares the box out to nobody: every child is given all of it and
    // placed inside it on its own, so there is no cursor, no leftover and no
    // gap. Paint order is child order, which is what makes the last child the
    // one on top.
    if is_stack(node.style.axis) {
        for child in node.children {
            let size = measure(child)
            // In a stack, `grow` means **fill the box on whichever axis you
            // did not size yourself.**
            //
            // There is no spare space to share out here, so the field would
            // otherwise mean nothing — and filling is exactly what overlays
            // ask for. A scrim says `grow` and covers everything; a bar says
            // `grow` and a height, and covers the width at the height it
            // chose. `measure` has already applied a fixed size, so a child
            // that stated one keeps it and only the unstated axis is filled.
            let fills = child.style.grow > 0.0
            let w = if child.style.width != nil {
                size.width
            } else if fills {
                inner.width
            } else {
                size.width
            }
            let h = if child.style.height != nil {
                size.height
            } else if fills {
                inner.height
            } else {
                cross_size(node.style.align, inner.height, size.height)
            }
            let child_rect = Rect {
                x: inner.x + along_offset(node.style.justify, inner.width, w),
                y: inner.y + cross_offset(node.style.align, inner.height, h),
                width: w,
                height: h,
            }
            frames = concat(frames, arrange(child, child_rect, depth + 1, owner, live))
        }
        return frames
    }

    let row_axis = is_row(node.style.axis)
    let available = if row_axis { inner.width } else { inner.height }
    let gaps = node.style.gap * intToFloat(node.children.len() - 1)

    // Fixed sizes first, then the leftover is shared out by `grow`.
    var used = 0.0
    var total_grow = 0.0
    for child in node.children {
        let size = measure(child)
        used = used + (if row_axis { size.width } else { size.height })
        total_grow = total_grow + child.style.grow
    }
    let leftover = maxf(0.0, available - used - gaps)

    // Where the first child starts, and how much sits between children. Only
    // children that do not grow can be pushed around: if anything grows, there
    // is no spare space left to distribute.
    let spare = if total_grow > 0.0 { 0.0 } else { leftover }
    var cursor = leading_space(node.style.justify, spare)
    let between = between_space(node.style.justify, node.style.gap, spare, node.children.len())

    for child in node.children {
        let size = measure(child)
        var along = if row_axis { size.width } else { size.height }
        if total_grow > 0.0 {
            along = along + leftover * (child.style.grow / total_grow)
        }

        let across_available = if row_axis { inner.height } else { inner.width }
        let natural = if row_axis { size.height } else { size.width }
        let across = cross_size(node.style.align, across_available, natural)
        let offset = cross_offset(node.style.align, across_available, natural)

        let child_rect = if row_axis {
            Rect { x: inner.x + cursor, y: inner.y + offset, width: along, height: across }
        } else {
            Rect { x: inner.x + offset, y: inner.y + cursor, width: across, height: along }
        }
        frames = concat(frames, arrange(child, child_rect, depth + 1, owner, live))
        cursor = cursor + along + between
    }

    return frames
}

/// The topmost frame containing a point, or nil. Frames come out in paint
/// order, so the last match is the one drawn last and therefore on top.
pub fn hit(frames: [Frame], x: float, y: float) -> Option<Frame> {
    var found: Option<Frame> = nil
    for frame in frames {
        if rect_contains(frame.rect, x, y) {
            found = frame
        }
    }
    return found
}

/// Whether a point falls inside a rectangle. Named for what it takes, because
/// `contains` on its own belongs to strings.
/// The control a point is inside, or nil.
///
/// A field read rather than a string parse. A control used to be found by
/// splitting a node's name on `:` — `checkbox:read3:tick` was part of the
/// control `checkbox:read3` — and nothing enforced the convention: a plain
/// text node innocently named `row2:subject` answered as a control, so
/// clicking a message in the reader demo moved the focus and selected
/// nothing. `arrange` stamps the owning control on every frame instead.
pub fn control_at(frames: [Frame], x: float, y: float) -> Option<str> {
    let found = hit(frames, x, y)
    if found == nil {
        return nil
    }
    return found.control
}

/// The frame with a given name, or nil.
///
/// What a caller needs to turn a click into a value: a slider answers to
/// hit-testing by its id, but converting a pointer position into a fraction
/// needs the rectangle it was laid out into, and only the frames have that.
pub fn frame_of(frames: [Frame], name: str) -> Option<Frame> {
    for frame in frames {
        if frame.name == name {
            return frame
        }
    }
    return nil
}

/// Controls in the order they were laid out, which is focus order.
///
/// Derived, not declared. It used to be a `[str]` the application wrote out by
/// hand beside the tree, and a second tree-shaped thing is a second thing to
/// keep in step: add a control and forget the list, and it lays out perfectly
/// and cannot be tabbed to.
pub fn focus_order(frames: [Frame]) -> [str] {
    var out: [str] = []
    for frame in frames {
        // A disabled control is still laid out and still hit-tested — the
        // pointer is entitled to know what it is over — but Tab must not stop
        // on something that cannot answer.
        if frame.is_control && frame.enabled {
            let id = frame.control
            if id != nil {
                out.push(id)
            }
        }
    }
    return out
}

pub fn rect_contains(rect: Rect, x: float, y: float) -> bool {
    if x < rect.x || y < rect.y {
        return false
    }
    return x < rect.x + rect.width && y < rect.y + rect.height
}

// ---- painting -------------------------------------------------------------
//
// How a box looks rides on the box, in `Decor`. It used to be a parallel list
// of `Paint`s matched to frames by name, and the trouble with a parallel list
// is that nothing keeps it in step with the tree: the reader demo ended up
// pushing *forty* speculative paints for `detail-body0`..`detail-body39`,
// because the list could not see how many lines the tree had, and a body that
// wrapped to forty-one lines painted the last one as nothing.
//
// The layout does not read `decor`. That is the invariant worth stating
// plainly, because it is what stops a renderer from being able to move
// anything: **geometry is a function of style and content only**. A test
// asserts it — the same tree laid out with every decoration stripped produces
// identical frames.

pub struct Border {
    pub colour: int
    pub width: float
}

pub struct Decor {
    /// `0xRRGGBB`, or nil to draw no background at all.
    ///
    /// Nil means *nothing is drawn*, not "draw something invisible". For a
    /// translucent fill, give a colour and an `alpha` below one.
    pub fill: Option<int>
    /// How opaque this box is, from 0 to 1.
    ///
    /// A separate channel rather than an alpha byte inside `fill`, which is
    /// what Skia does — `SkColor` packs alpha, and `SkPaint::setAlphaf` sets it
    /// separately. Packing it here would have meant reinterpreting every
    /// `0xRRGGBB` a program already contains as `0xAARRGGBB`, giving all of
    /// them an alpha of zero, and a program that used to draw would compile,
    /// run, and show nothing.
    pub alpha: float
    pub radius: float
    /// An outline, or nil for none.
    ///
    /// Not a stroke primitive: the boundary has none, and adding one would
    /// mean joins and caps. An outline is the box in the edge colour with the
    /// box inset by the width drawn back over it in the fill — which is what a
    /// border *is* once it is filled in, and asks the boundary for nothing.
    pub border: Option<Border>
    /// The colour this node's own text is drawn in.
    pub ink: int
    /// Centre the text across the box, and down it.
    ///
    /// Two flags rather than one because the two are wanted separately: a
    /// button's caption is centred both ways, and a text field's value is
    /// centred down the box but starts at the left. Either way it is the
    /// painter that can do it — centring needs the measured width and the
    /// wrapped line count, and nothing before the painter has both.
    pub center_x: bool
    pub center_y: bool
}

pub fn no_decor() -> Decor {
    return Decor{
        fill: nil,
        alpha: 1.0,
        radius: 0.0,
        border: nil,
        ink: 0x000000,
        center_x: false,
        center_y: false,
    }
}

pub fn filled(colour: int) -> Decor {
    return Decor{..no_decor(), fill: colour }
}

/// A fill with rounded corners.
///
/// Shape is a property of the *surface*, not of the box in the tree: the same
/// node is a pill in one design system and a square in another, and the layout
/// should not have to know which.
pub fn rounded(colour: int, radius: float) -> Decor {
    return Decor{..no_decor(), fill: colour, radius: radius }
}

pub fn shaped(base: Decor, radius: float) -> Decor {
    return Decor{..base, radius: radius }
}

pub fn inked(base: Decor, colour: int) -> Decor {
    return Decor{..base, ink: colour }
}

pub fn bordered(base: Decor, colour: int, width: float) -> Decor {
    return Decor{..base, border: Border{ colour: colour, width: width } }
}

pub fn centered(base: Decor) -> Decor {
    return Decor{..base, center_x: true, center_y: true }
}

/// Centred down the box only, which is what a single line of text in a control
/// of a fixed height wants: in the middle, but still starting at the left.
pub fn vertically_centered(base: Decor) -> Decor {
    return Decor{..base, center_y: true }
}

/// Ink alone, on a box that draws no background — what a run of text wants.
pub fn ink(colour: int) -> Decor {
    return Decor{..no_decor(), ink: colour }
}

/// The same decoration, at a given opacity.
pub fn faded(base: Decor, a: float) -> Decor {
    return Decor{..base, alpha: a }
}

/// Draw a laid-out tree.
///
/// Frames come out in paint order, so this walks them forwards: a parent's
/// background is drawn before its children sit on top. A frame whose decor
/// says nothing is invisible but still laid out, which is how spacers work.
///
/// It used to take the window's colour as well, because a border was two
/// filled rectangles and the inner one had to be painted in whatever was
/// behind the box — so the painter carried a backdrop down the tree and every
/// caller had to name one. `draw.drrect` draws the ring alone, so there is
/// nothing to fill and nothing to name: the background of a window is the
/// fill of the node at the root of it, like any other box.
pub fn paint(frames: [Frame]) {
    for frame in frames {
        draw_one(frame)
    }
}

/// The bits `draw.semantics` packs its state into.
fn SEMANTIC_DISABLED() -> int {
    return 1
}

fn SEMANTIC_CHECKED() -> int {
    return 2
}

fn SEMANTIC_FOCUSED() -> int {
    return 4
}

/// Whether the control can be on at all, which is not the same as being off.
/// A reader that called every button "not checked" would be worse than one
/// that said nothing.
fn SEMANTIC_CHECKABLE() -> int {
    return 8
}

/// Say what this region is, for anything that cannot see it.
///
/// Emitted for the control's own frame and nothing else, and *after* the frame
/// has painted rather than before.
///
/// The order matters for exactly one case, and it is the case that matters
/// most: a text field. A renderer that makes a real element for the field can
/// put the label on that element instead of announcing the region twice — but
/// only if the element exists by the time the declaration arrives. Declaring
/// first would leave the first frame of every field with both a real input and
/// a stray description of it.
fn declare(frame: Frame) {
    if !frame.is_control {
        return
    }
    let who = frame.control
    let id = if who != nil { who } else { frame.name }
    var flags = 0
    if !frame.enabled {
        flags = flags + SEMANTIC_DISABLED()
    }
    if frame.focused {
        flags = flags + SEMANTIC_FOCUSED()
    }
    let on = frame.checked
    if on != nil {
        flags = flags + SEMANTIC_CHECKABLE()
        if on {
            flags = flags + SEMANTIC_CHECKED()
        }
    }
    let r = frame.rect
    draw.semantics(r.x, r.y, r.width, r.height, role_code(frame.role), frame.label, flags, id)
}

/// Paint one frame, then say what it is.
///
/// Two calls rather than one function because `paint_box` leaves by several
/// paths — a picture, a field and an empty box each return early — and the
/// declaration has to happen on all of them.
fn draw_one(frame: Frame) {
    paint_box(frame)
    declare(frame)
}

fn paint_box(frame: Frame) {
    let r = frame.rect
    let d = frame.decor
    let own = d.fill
    set_alpha(d.alpha)
    // A fill, then the border on top of it. They are two calls now rather than
    // one compound one: `draw.drrect` draws the *ring* between the box and the
    // box inset by the width, so the border no longer has to fill its own
    // middle with the colour behind it. That was the whole reason a border and
    // a fill could not be drawn independently.
    if own != nil {
        fill_rect(r.x, r.y, r.width, r.height, d.radius, own)
    }
    let edge = d.border
    if edge != nil {
        // Narrowed one condition at a time: `edge != nil && ...` is a
        // comparison inside a conjunction, and only the comparison alone
        // narrows the option.
        if edge.width > 0.0 {
            draw.drrect(r.x, r.y, r.width, r.height, d.radius, edge.width, edge.colour)
        }
    }
    // A picture goes inside the padding, like text, and over the fill, like
    // text — so a framed photograph is one node with a border and an inset
    // rather than two boxes arranged to look like one.
    let picture = frame.image
    if picture != nil {
        let box = frame.inner
        draw.image(box.x, box.y, box.width, box.height, picture)
        unset_alpha(d.alpha)
        return
    }
    // A text input is a region rather than a picture, so it is declared and
    // the renderer decides what to make of it. On the DOM that is a real
    // `<input>` with the browser's own caret, selection, IME and keyboard;
    // everywhere else it falls back to drawing the text, which is what this
    // did before the call existed.
    //
    // Declared *after* the fill and border and instead of the text: the
    // container is still Kite's to draw, and only the editable part is the
    // host's. A field that drew its own box would lose the design system.
    let editing = frame.edits
    let body = frame.content
    // **A field is declared where the value is drawn.** A control that shows
    // its own text — a search box, a text area — becomes the input. A control
    // that is a *container* for a value node, as Material's outlined field is,
    // draws its box and its label as before and leaves the input to whichever
    // frame carries the text; declaring it on the wrapper would put an input
    // over the label as well.
    // Narrowing takes one local and one `if`, so the conditions nest.
    if editing != nil {
        if body.len() > 0 {
            // Who this field is, which the renderer needs to hand the same
            // element back to the same field next frame. A frame that edits is
            // a control's own frame, so it has an id; the name stands in only
            // to keep the narrowing total, and nothing reaches it.
            let who = frame.control
            let key = if who != nil { who } else { frame.name }
            let box = frame.inner
            // The value, and what to show in place of it while it is empty. The
            // frame's own content is already that: the component put the
            // placeholder there when there was nothing to show.
            let hint = if editing.text.len() == 0 { body } else { "" }
            draw.field(
                box.x,
                box.y,
                box.width,
                box.height,
                editing.text,
                hint,
                d.ink,
                key,
                editing.multiline,
            )
            unset_alpha(d.alpha)
            return
        }
    }
    if body.len() == 0 {
        // Paired with the `set_alpha` above, and the pairing is the point: a
        // box with no text of its own left through here without restoring the
        // opacity, so everything drawn *after* a translucent box was drawn
        // translucent too. Nothing had noticed, because until a design system
        // wanted a state layer nothing set `alpha` on a box — the one place it
        // was used was on text, which leaves by the bottom of this function.
        // The symptom was a whole list fading out below a hovered row.
        unset_alpha(d.alpha)
        return
    }
    // Content goes inside the padding, and wraps to the width measurement used
    // — so what is painted is what was laid out, rather than an approximation
    // that happens to look close.
    let box = frame.inner
    // Lines are broken in logical order and reordered afterwards, which is
    // the order UAX #9 requires; the paragraph decides its direction once and
    // every line wrapped out of it inherits, so a Hebrew paragraph whose
    // second line begins with a number does not change direction mid-text.
    // Left-to-right text is one run per line and is drawn exactly as before.
    //
    // What this does not do: an RTL paragraph is still drawn from the box's
    // left edge — alignment belongs to the box — and the parallel tree for
    // screen readers hears a reordered line run by run, in visual order,
    // which for mixed-direction text is not reading order. Both are stated
    // rather than solved.
    //
    // The font is the one the box was measured in. Decoration may not choose
    // another: the room has already been allotted.
    set_font(frame.size, frame.weight)
    let base = text.paragraph_level(body)
    let lines = wrap(body, box.width)
    var y = box.y
    if d.center_y {
        // The whole block of lines is centred, not each line separately: two
        // lines centred individually would sit in the same place as one.
        let tall = line_height() * intToFloat(lines.len())
        let slack = box.height - tall
        if slack > 0.0 {
            y = box.y + slack / 2.0
        }
    }
    for line in lines {
        // A centred line starts wherever the leftover space puts it. The width
        // is measured in the font just selected, so this is the font the line
        // will actually be drawn in rather than the one before it.
        var x = box.x
        if d.center_x {
            let slack = box.width - text.width(line)
            if slack > 0.0 {
                x = box.x + slack / 2.0
            }
        }
        for run in text.bidi_runs_with(line, base) {
            draw.text(x, y, run.body, d.ink)
            x = x + text.width(run.body)
        }
        y = y + line_height()
    }
    unset_font(frame.size)
    unset_alpha(d.alpha)
}

/// Select an opacity, or leave the host's alone. Paired with [`unset_alpha`],
/// so one node's translucency cannot leak into the next.
fn set_alpha(a: float) {
    if a < 1.0 {
        draw.alpha(a)
    }
}

fn unset_alpha(a: float) {
    if a < 1.0 {
        draw.alpha(1.0)
    }
}

/// A filled rectangle, round or square. The square call is still the one made
/// for a zero radius, so a renderer that never sees a rounded corner draws
/// exactly what it drew before rounded corners existed.
fn fill_rect(x: float, y: float, w: float, h: float, radius: float, colour: int) {
    if radius > 0.0 {
        draw.rrect(x, y, w, h, radius, colour)
    } else {
        draw.rect(x, y, w, h, colour)
    }
}

// ---- scrolling ------------------------------------------------------------
//
// Scrolling is not a layout concern here. A tree is laid out at its natural
// size, and a viewport decides which part of it is visible — which means
// scrolling changes nothing about where anything is, only about what is drawn.
// That is why `hit` still works on the same frames: subtract the offset from
// the point instead of re-laying anything out.

/// How far a laid-out tree can scroll inside a viewport before its last frame
/// is flush with the bottom. Never negative: content shorter than the viewport
/// does not scroll.
pub fn scroll_extent(frames: [Frame], viewport: Size) -> float {
    var bottom = 0.0
    for frame in frames {
        bottom = maxf(bottom, frame.rect.y + frame.rect.height)
    }
    return maxf(0.0, bottom - viewport.height)
}

/// `offset` held within what there is to scroll.
pub fn clamp_scroll(offset: float, frames: [Frame], viewport: Size) -> float {
    return clampf(offset, 0.0, scroll_extent(frames, viewport))
}

fn shifted(r: Rect, dx: float, dy: float) -> Rect {
    return Rect{ x: r.x + dx, y: r.y + dy, width: r.width, height: r.height }
}

/// Draw a tree inside a viewport, scrolled down by `offset`.
///
/// Frames outside the viewport are skipped rather than drawn and clipped away.
/// The clip is still needed for the ones that straddle an edge — a half-visible
/// row has to be cut by the renderer, and painting over it would erase what it
/// is scrolling past.
pub fn paint_scrolled(frames: [Frame], viewport: Rect, offset: float) {
    draw.clip(viewport.x, viewport.y, viewport.width, viewport.height)
    let dx = viewport.x
    let dy = viewport.y - offset
    // Portals are last in the list, so the clip can be closed once, when the
    // first one is reached, rather than opened and shut around each of them.
    var clipped = true
    for frame in frames {
        if frame.portal && clipped {
            draw.unclip()
            clipped = false
        }
        let r = shifted(frame.rect, dx, dy)
        // A portal is not cut by the viewport and is not skipped for leaving
        // it: hanging outside is what it is for. It still scrolls with the
        // content, because it was laid out against the row it belongs to.
        if frame.portal {
            draw_one(Frame{..frame, rect: r, inner: shifted(frame.inner, dx, dy) })
        } else if r.y + r.height >= viewport.y && r.y <= viewport.y + viewport.height {
            draw_one(Frame{..frame, rect: r, inner: shifted(frame.inner, dx, dy) })
        }
    }
    if clipped {
        draw.unclip()
    }
}

/// The frame under a point in a scrolled viewport. The offset is subtracted
/// from the point rather than added to every frame, which is the same answer
/// and one subtraction instead of many.
pub fn hit_scrolled(
    frames: [Frame],
    viewport: Rect,
    offset: float,
    x: float,
    y: float,
) -> Option<Frame> {
    if !rect_contains(viewport, x, y) {
        return nil
    }
    return hit(frames, x - viewport.x, y - viewport.y + offset)
}

/// The next control in focus order, wrapping at the end.
///
/// Focus order is the order the controls were listed, which is the order they
/// were laid out — a separate tab order is a second thing to keep in step, and
/// the two disagreeing is how a form becomes unusable with a keyboard.
pub fn next_focus(names: [str], focused: str) -> str {
    if names.len() == 0 {
        return ""
    }
    let at = position(names, |n: str| n == focused)
    if at < 0 {
        return names[0]
    }
    return names[(at + 1) % names.len()]
}

pub fn previous_focus(names: [str], focused: str) -> str {
    if names.len() == 0 {
        return ""
    }
    let at = position(names, |n: str| n == focused)
    if at <= 0 {
        return names[names.len() - 1]
    }
    return names[at - 1]
}

/// Text with a key applied to it, for a focused field.
///
/// The keys a text field must understand are the ones a keyboard sends, and
/// `Backspace` is the only one that is not simply itself. Everything longer
/// than one character is a named key this does not act on, which is what keeps
/// `ArrowLeft` from being typed into the box.
pub fn typed(value: str, key: str) -> str {
    if key == "Backspace" {
        if value.len() == 0 {
            return value
        }
        return value.slice(0, value.len() - 1)
    }
    if key.len() != 1 {
        return value
    }
    return value + key
}
