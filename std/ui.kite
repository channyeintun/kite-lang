// Layout.
//
// A subset of flexbox, written in Kite. It computes where things go; it draws
// nothing. That separation is the whole point of the design: the same layout
// feeds a DOM renderer and a canvas renderer, and neither can disagree with
// the other about where a box ended up, because neither decides.
//
// The model is deliberately one layout algorithm rather than several. CSS has
// block, inline, float, table, flex and grid, and most of the difficulty of
// writing CSS is knowing which one is in force. Kite has boxes in a row or a
// column, and that is all — which is enough for application UI, and is what
// every UI toolkit that started after the web converged on.

use std/text

pub struct Size {
    pub width: float
    pub height: float
}

pub struct Rect {
    pub x: float
    pub y: float
    pub width: float
    pub height: float
}

pub struct Insets {
    pub top: float
    pub right: float
    pub bottom: float
    pub left: float
}

/// Which way children are laid out.
pub enum Axis {
    Row
    Column
}

/// How spare space along the main axis is distributed.
pub enum Justify {
    Start
    Center
    End
    SpaceBetween
}

/// Where a child sits on the cross axis.
pub enum Align {
    Start
    Center
    End
    Stretch
}

pub struct Style {
    pub axis: Axis
    pub justify: Justify
    pub align: Align
    /// A fixed size, or nil to size from the content.
    pub width: Option<float>
    pub height: Option<float>
    /// Share of the leftover main-axis space. Zero means take none.
    pub grow: float
    pub padding: Insets
    /// Space between children, not before the first or after the last.
    pub gap: float
    /// The size and weight this node's text is measured *and* drawn in, or
    /// zero for the host's own.
    ///
    /// On the style rather than on the paint, because a size changes how much
    /// room a run of text needs and the paint runs long after the room has
    /// been allotted. Putting it on the paint — which is where this started —
    /// lays a title out at 16dp and then draws it at 22, and the title runs
    /// into whatever was measured to sit beside it.
    pub size: float
    pub weight: int
}

/// The same style in a given size and weight — a type scale's one entry.
pub fn in_font(base: Style, size: float, weight: int) -> Style {
    return Style{..base, size: size, weight: weight }
}

/// The host's default size, which is what a style that names none measures in.
pub fn DEFAULT_SIZE() -> float {
    return 16.0
}

/// Select a font, or leave the host's alone. Paired with [`unset_font`].
fn set_font(size: float, weight: int) {
    if size > 0.0 {
        draw.font(size, weight)
    }
}

fn unset_font(size: float) {
    if size > 0.0 {
        draw.font(DEFAULT_SIZE(), 400)
    }
}

/// What a leaf holds. A box with children holds `Empty`; the two are exclusive
/// because a node that was both would need a rule for which wins, and every
/// such rule is a rule someone has to remember.
pub enum Content {
    Empty
    Text(str)
}

pub struct Node {
    pub name: str
    pub style: Style
    pub content: Content
    pub children: [Node]
    /// This subtree is one interactive thing, and this is its id — the string
    /// the application's `update` is handed back. Nil for a plain box.
    ///
    /// It replaces a naming convention. A control used to be found by
    /// splitting a node's name on `:` — `checkbox:read3:tick` was part of the
    /// control `checkbox:read3` — and the trouble with a convention is that
    /// nothing enforces it: a plain text node innocently named `row2:subject`
    /// answered as a control, so clicking a message moved the focus and
    /// selected nothing. A field cannot be collided with by accident.
    ///
    /// The id alone, with no *kind* in it. One string carrying two meanings
    /// and punctuation to part them is what went wrong the first time; a
    /// design system knows what it built, and the application knows what it
    /// asked for.
    pub role: Option<str>
    /// How the box looks. The layout never reads this.
    pub decor: Decor
}

/// One laid-out box, in absolute coordinates.
pub struct Frame {
    pub name: str
    /// The whole box, padding included. This is what a background fills and what
    /// hit-testing tests against.
    pub rect: Rect
    /// The box inside its padding, which is where content goes. A leaf has no
    /// children to inset, so without this its padding would size the box and
    /// then be ignored when its text was drawn.
    pub inner: Rect
    /// How deep in the tree, which is the order to paint in.
    pub depth: int
    /// The node's own text, or empty for a box. Carried here so a painter can
    /// draw what the node *says* without being told again — a widget's caption
    /// is written once, in the tree, and a paint list that restated it would
    /// be a second place for it to be wrong.
    pub content: str
    /// The font the box was measured in, carried through so the painter draws
    /// in the one the layout used. A painter that chose its own would be
    /// choosing a size the box was never sized for.
    pub size: float
    pub weight: int
    /// The nearest enclosing control's id — this node's own if it is one,
    /// otherwise the closest ancestor that is, or nil for neither.
    ///
    /// Stamped once, while the tree is still a tree. Afterwards the frames are
    /// a flat list and the parent of any one of them is no longer knowable
    /// without searching, so `control_at` would be a containment search rather
    /// than a lookup.
    pub control: Option<str>
    /// Whether this frame is the control itself rather than something inside
    /// one, which is what focus order needs to count each control once.
    pub is_control: bool
    pub decor: Decor
}

// ---- construction ---------------------------------------------------------

pub fn insets(all: float) -> Insets {
    return Insets{ top: all, right: all, bottom: all, left: all }
}

pub fn insets_none() -> Insets {
    return insets(0.0)
}

pub fn insets_xy(x: float, y: float) -> Insets {
    return Insets{ top: y, right: x, bottom: y, left: x }
}

/// A style with everything at its default. Kite has no zero values, so a
/// default is a function rather than an omission — which means there is one
/// place to read to know what a default is.
pub fn style() -> Style {
    return Style{
        axis: Axis.Row,
        justify: Justify.Start,
        align: Align.Start,
        width: nil,
        height: nil,
        grow: 0.0,
        padding: insets_none(),
        gap: 0.0,
        size: 0.0,
        weight: 400,
    }
}

pub fn row() -> Style {
    return style()
}

pub fn column() -> Style {
    return Style{..style(), axis: Axis.Column }
}

pub fn sized(base: Style, width: float, height: float) -> Style {
    return Style{..base, width: width, height: height }
}

pub fn grown(base: Style, amount: float) -> Style {
    return Style{..base, grow: amount }
}

pub fn padded(base: Style, amount: float) -> Style {
    return Style{..base, padding: insets(amount) }
}

pub fn spaced(base: Style, amount: float) -> Style {
    return Style{..base, gap: amount }
}

/// The same node, made a control: it answers to hit-testing and takes focus.
pub fn control(node: Node, id: str) -> Node {
    return Node{..node, role: id }
}

/// The same node, decorated. Layout is unaffected — that is the invariant.
pub fn decorated(node: Node, how: Decor) -> Node {
    return Node{..node, decor: how }
}

pub fn box_of(name: str, base: Style, children: [Node]) -> Node {
    return Node{
        name: name,
        style: base,
        content: Content.Empty,
        children: children,
        role: nil,
        decor: no_decor(),
    }
}

pub fn text_of(name: str, base: Style, body: str) -> Node {
    return Node{
        name: name,
        style: base,
        content: Content.Text(body),
        children: [],
        role: nil,
        decor: no_decor(),
    }
}

// ---- measurement ----------------------------------------------------------

/// The height of one line, from the host's font: ascent plus descent plus
/// leading, which is what a line of text actually occupies.
pub fn line_height() -> float {
    return text.height()
}

/// How much space a run of text needs.
///
/// The width comes from the host, because only the host has the font — and two
/// hosts may legitimately disagree, which is what different fonts are. Under a
/// runtime with no font at all the answer is a nominal advance per character,
/// which is wrong for proportional text and consistent, so a layout stays
/// comparable across backends.
///
pub fn text_size(body: str) -> Size {
    return Size{ width: text.width(body), height: line_height() }
}

/// A run broken into lines that fit within `limit`.
///
/// Greedy and word-based: it breaks at spaces, taking as much as fits on each
/// line. That is not UAX #14 — it will not break a long URL, and it knows
/// nothing about the rules for CJK, where a line may break between almost any
/// two characters. Both need the line-breaking property table, which is the
/// canvas renderer's business.
///
/// A word longer than the limit gets a line of its own and overflows it, which
/// is what every wrapper does short of breaking words apart.
/// The same, in a named size and weight.
///
/// A widget that sizes itself to its caption has to measure in the font the
/// caption will be drawn in — a button laid out against 16dp and captioned at
/// 14dp is a button with the wrong amount of air in it.
pub fn text_size_in(body: str, size: float, weight: int) -> Size {
    set_font(size, weight)
    let out = text_size(body)
    unset_font(size)
    return out
}

pub fn wrap(body: str, limit: float) -> [str] {
    let pieces = pieces_of(body)
    if pieces.len() == 0 {
        return [""]
    }

    var lines: [str] = []
    var current = pieces[0]
    for i in 1..pieces.len() {
        let piece = pieces[i]
        // A piece that begins a word carries the space that joined it to the
        // one before; a CJK piece does not, because there was none.
        let candidate = if joins(piece) { current + piece } else { current + " " + piece }
        if text.width(candidate) <= limit {
            current = candidate
        } else {
            lines.push(current)
            current = piece
        }
    }
    lines.push(current)
    return lines
}

/// The pieces a line may be broken between.
///
/// This is a **subset of UAX #14**, and the subset is named rather than
/// implied: a run of Latin text breaks between words, and CJK breaks between
/// characters — which is most of what the rules say for most text, and is the
/// difference between a Japanese paragraph laid out and one drawn as a single
/// enormous word.
///
/// What it does not do: it will not break a long URL, it does not know
/// non-breaking spaces, and it will happily leave a closing bracket at the
/// start of a line. Each of those needs the line-breaking property table,
/// which belongs with the canvas renderer.
fn pieces_of(body: str) -> [str] {
    var out: [str] = []
    var current = ""
    for i in 0..body.len() {
        let c = body.slice(i, i + 1)
        if c == " " {
            if current.len() > 0 {
                out.push(current)
                current = ""
            }
        } else {
            if wide(c) {
                // A wide character is its own piece, and so is whatever
                // preceded it.
                if current.len() > 0 {
                    out.push(current)
                    current = ""
                }
                out.push(c)
            } else {
                current = current + c
            }
        }
    }
    if current.len() > 0 {
        out.push(current)
    }
    return out
}

/// Whether a piece joins the line before it with no space.
///
/// A piece that came from a wide character had no space before it, so putting
/// one back would open a gap that was never in the text.
fn joins(piece: str) -> bool {
    if piece.len() != 1 {
        return false
    }
    return wide(piece)
}

/// Whether a character is one a line may break either side of.
///
/// Measured rather than tabulated: a character wider than a Latin one under
/// the host's own font is a CJK or full-width character, and the host is the
/// only thing that knows its font. A runtime with no font answers with a
/// nominal advance per character, where every character is the same width and
/// nothing is wide — which is the right answer there, because nothing is being
/// drawn.
fn wide(c: str) -> bool {
    return text.width(c) > text.width("W") * 1.2
}

/// How much space a run needs once wrapped to `limit`.
pub fn wrapped_size(body: str, limit: float) -> Size {
    let lines = wrap(body, limit)
    var widest = 0.0
    for line in lines {
        widest = maxf(widest, text.width(line))
    }
    return Size{ width: widest, height: intToFloat(lines.len()) * line_height() }
}

/// Kite performs no implicit numeric conversion, so this is written out.
pub fn intToFloat(n: int) -> float {
    return n as float
}

fn horizontal(pad: Insets) -> float {
    return pad.left + pad.right
}

fn vertical(pad: Insets) -> float {
    return pad.top + pad.bottom
}

fn is_row(a: Axis) -> bool {
    return match a {
        Row => true
        Column => false
    }
}

/// The size a node wants, ignoring what it is given.
///
/// A fixed width or height wins outright. Otherwise a leaf measures its
/// content and a box measures its children: summed along the main axis with
/// the gaps, and the largest along the cross axis.
pub fn measure(node: Node) -> Size {
    let pad = node.style.padding
    let inner = measure_content(node)

    var w = inner.width + horizontal(pad)
    var h = inner.height + vertical(pad)
    // Narrowing works on a local, not on a path through fields — the compiler
    // cannot know a field has not changed between the test and the use — so the
    // optional is bound before it is tested.
    let fixed_w = node.style.width
    if fixed_w != nil {
        w = fixed_w
    }
    let fixed_h = node.style.height
    if fixed_h != nil {
        h = fixed_h
    }
    return Size{ width: w, height: h }
}

fn measure_content(node: Node) -> Size {
    let body = match node.content {
        Empty => ""
        Text(s) => s
    }
    if body.len() > 0 {
        set_font(node.style.size, node.style.weight)
        // Text wraps when it has been given a width, and not otherwise. Which
        // width to wrap to is only knowable once a parent has decided, and
        // measurement runs before that — so a node that wants to wrap says how
        // wide it is, and a node that does not is measured as one run.
        //
        // Flexbox answers this with a second measurement pass after the first
        // layout. That is more capable and much harder to predict, and predicting
        // it is most of what makes CSS difficult.
        let fixed = node.style.width
        if fixed != nil {
            let wrapped = wrapped_size(body, fixed - horizontal(node.style.padding))
            unset_font(node.style.size)
            return wrapped
        }
        let one = text_size(body)
        unset_font(node.style.size)
        return one
    }
    if node.children.len() == 0 {
        return Size{ width: 0.0, height: 0.0 }
    }

    let gaps = node.style.gap * intToFloat(node.children.len() - 1)
    var main = 0.0
    var cross = 0.0
    for child in node.children {
        let size = measure(child)
        let along = if is_row(node.style.axis) { size.width } else { size.height }
        let across = if is_row(node.style.axis) { size.height } else { size.width }
        main = main + along
        cross = maxf(cross, across)
    }
    main = main + gaps

    if is_row(node.style.axis) {
        return Size{ width: main, height: cross }
    }
    return Size{ width: cross, height: main }
}

// ---- arrangement ----------------------------------------------------------

/// Lay a tree out inside a viewport, producing one frame per node in paint
/// order — parents before their children, which is the order a painter needs
/// and the reverse of the order hit-testing needs.
pub fn layout(root: Node, viewport: Size) -> [Frame] {
    let fixed_w = root.style.width
    let fixed_h = root.style.height
    let w = if fixed_w != nil { fixed_w } else { viewport.width }
    let h = if fixed_h != nil { fixed_h } else { viewport.height }
    return arrange(root, Rect{ x: 0.0, y: 0.0, width: w, height: h }, 0, nil)
}

/// How far in the first child sits.
fn leading_space(j: Justify, spare: float) -> float {
    return match j {
        Start => 0.0
        Center => spare / 2.0
        End => spare
        SpaceBetween => 0.0
    }
}

/// The distance between one child and the next. `SpaceBetween` spreads the
/// spare space into the gaps rather than pushing everything to one side; with
/// fewer than two children there are no gaps to spread it into.
fn between_space(j: Justify, gap: float, spare: float, count: int) -> float {
    return match j {
        SpaceBetween => if count > 1 { gap + spare / intToFloat(count - 1) } else { gap }
        Start | Center | End => gap
    }
}

/// A child's size across the axis: its own, unless it is being stretched.
fn cross_size(a: Align, available: float, natural: float) -> float {
    return match a {
        Stretch => available
        Start | Center | End => natural
    }
}

fn cross_offset(a: Align, available: float, natural: float) -> float {
    return match a {
        Start => 0.0
        Stretch => 0.0
        Center => maxf(0.0, (available - natural) / 2.0)
        End => maxf(0.0, available - natural)
    }
}

fn arrange(node: Node, rect: Rect, depth: int, inherited: Option<str>) -> [Frame] {
    // A node with a role owns itself and everything under it.
    // Narrowing turns `mine` into a `str` inside the guard, so the two are
    // assigned rather than chosen between: a value `if` needs both branches to
    // have the one type, and here they deliberately do not.
    let mine = node.role
    var owner = inherited
    if mine != nil {
        owner = mine
    }
    let pad = node.style.padding
    let inner = Rect{
        x: rect.x + pad.left,
        y: rect.y + pad.top,
        width: maxf(0.0, rect.width - horizontal(pad)),
        height: maxf(0.0, rect.height - vertical(pad)),
    }

    var frames = [
        Frame {
            name: node.name,
            rect: rect,
            inner: inner,
            depth: depth,
            content: match node.content {
                Text(body) => body,
                Empty => "",
            },
            size: node.style.size,
            weight: node.style.weight,
            control: owner,
            is_control: mine != nil,
            decor: node.decor,
        },
    ]
    if node.children.len() == 0 {
        return frames
    }

    let row_axis = is_row(node.style.axis)
    let available = if row_axis { inner.width } else { inner.height }
    let gaps = node.style.gap * intToFloat(node.children.len() - 1)

    // Fixed sizes first, then the leftover is shared out by `grow`.
    var used = 0.0
    var total_grow = 0.0
    for child in node.children {
        let size = measure(child)
        used = used + (if row_axis { size.width } else { size.height })
        total_grow = total_grow + child.style.grow
    }
    let leftover = maxf(0.0, available - used - gaps)

    // Where the first child starts, and how much sits between children. Only
    // children that do not grow can be pushed around: if anything grows, there
    // is no spare space left to distribute.
    let spare = if total_grow > 0.0 { 0.0 } else { leftover }
    var cursor = leading_space(node.style.justify, spare)
    let between = between_space(node.style.justify, node.style.gap, spare, node.children.len())

    for child in node.children {
        let size = measure(child)
        var along = if row_axis { size.width } else { size.height }
        if total_grow > 0.0 {
            along = along + leftover * (child.style.grow / total_grow)
        }

        let across_available = if row_axis { inner.height } else { inner.width }
        let natural = if row_axis { size.height } else { size.width }
        let across = cross_size(node.style.align, across_available, natural)
        let offset = cross_offset(node.style.align, across_available, natural)

        let child_rect = if row_axis {
            Rect { x: inner.x + cursor, y: inner.y + offset, width: along, height: across }
        } else {
            Rect { x: inner.x + offset, y: inner.y + cursor, width: across, height: along }
        }
        frames = concat(frames, arrange(child, child_rect, depth + 1, owner))
        cursor = cursor + along + between
    }

    return frames
}

/// The topmost frame containing a point, or nil. Frames come out in paint
/// order, so the last match is the one drawn last and therefore on top.
pub fn hit(frames: [Frame], x: float, y: float) -> Option<Frame> {
    var found: Option<Frame> = nil
    for frame in frames {
        if rect_contains(frame.rect, x, y) {
            found = frame
        }
    }
    return found
}

/// Whether a point falls inside a rectangle. Named for what it takes, because
/// `contains` on its own belongs to strings.
/// The control a point is inside, or nil.
///
/// A field read rather than a string parse. A control used to be found by
/// splitting a node's name on `:` — `checkbox:read3:tick` was part of the
/// control `checkbox:read3` — and nothing enforced the convention: a plain
/// text node innocently named `row2:subject` answered as a control, so
/// clicking a message in the reader demo moved the focus and selected
/// nothing. `arrange` stamps the owning control on every frame instead.
pub fn control_at(frames: [Frame], x: float, y: float) -> Option<str> {
    let found = hit(frames, x, y)
    if found == nil {
        return nil
    }
    return found.control
}

/// Controls in the order they were laid out, which is focus order.
///
/// Derived, not declared. It used to be a `[str]` the application wrote out by
/// hand beside the tree, and a second tree-shaped thing is a second thing to
/// keep in step: add a control and forget the list, and it lays out perfectly
/// and cannot be tabbed to.
pub fn focus_order(frames: [Frame]) -> [str] {
    var out: [str] = []
    for frame in frames {
        if frame.is_control {
            let id = frame.control
            if id != nil {
                out.push(id)
            }
        }
    }
    return out
}

pub fn rect_contains(rect: Rect, x: float, y: float) -> bool {
    if x < rect.x || y < rect.y {
        return false
    }
    return x < rect.x + rect.width && y < rect.y + rect.height
}

// ---- painting -------------------------------------------------------------
//
// How a box looks rides on the box, in `Decor`. It used to be a parallel list
// of `Paint`s matched to frames by name, and the trouble with a parallel list
// is that nothing keeps it in step with the tree: the reader demo ended up
// pushing *forty* speculative paints for `detail-body0`..`detail-body39`,
// because the list could not see how many lines the tree had, and a body that
// wrapped to forty-one lines painted the last one as nothing.
//
// The layout does not read `decor`. That is the invariant worth stating
// plainly, because it is what stops a renderer from being able to move
// anything: **geometry is a function of style and content only**. A test
// asserts it — the same tree laid out with every decoration stripped produces
// identical frames.

pub struct Border {
    pub colour: int
    pub width: float
}

pub struct Decor {
    /// `0xRRGGBB`, or nil for transparent.
    ///
    /// Transparent at a boundary with no alpha can only mean *the colour of
    /// whatever is behind*, and the painter works that out: it walks parents
    /// before children, so it knows the fill of the enclosing box. No caller
    /// supplies a backdrop. An earlier version made it an argument, and every
    /// caller had to thread the right colour to every control — a checkbox on
    /// a selected row sits on a different colour from one on an ordinary row —
    /// which is a thing to get wrong once per control.
    pub fill: Option<int>
    pub radius: float
    /// An outline, or nil for none.
    ///
    /// Not a stroke primitive: the boundary has none, and adding one would
    /// mean joins and caps. An outline is the box in the edge colour with the
    /// box inset by the width drawn back over it in the fill — which is what a
    /// border *is* once it is filled in, and asks the boundary for nothing.
    pub border: Option<Border>
    /// The colour this node's own text is drawn in.
    pub ink: int
    /// Centre the text across the box, and down it.
    ///
    /// Two flags rather than one because the two are wanted separately: a
    /// button's caption is centred both ways, and a text field's value is
    /// centred down the box but starts at the left. Either way it is the
    /// painter that can do it — centring needs the measured width and the
    /// wrapped line count, and nothing before the painter has both.
    pub center_x: bool
    pub center_y: bool
}

pub fn no_decor() -> Decor {
    return Decor{
        fill: nil,
        radius: 0.0,
        border: nil,
        ink: 0x000000,
        center_x: false,
        center_y: false,
    }
}

pub fn filled(colour: int) -> Decor {
    return Decor{..no_decor(), fill: colour }
}

/// A fill with rounded corners.
///
/// Shape is a property of the *surface*, not of the box in the tree: the same
/// node is a pill in one design system and a square in another, and the layout
/// should not have to know which.
pub fn rounded(colour: int, radius: float) -> Decor {
    return Decor{..no_decor(), fill: colour, radius: radius }
}

pub fn shaped(base: Decor, radius: float) -> Decor {
    return Decor{..base, radius: radius }
}

pub fn inked(base: Decor, colour: int) -> Decor {
    return Decor{..base, ink: colour }
}

pub fn bordered(base: Decor, colour: int, width: float) -> Decor {
    return Decor{..base, border: Border{ colour: colour, width: width } }
}

pub fn centered(base: Decor) -> Decor {
    return Decor{..base, center_x: true, center_y: true }
}

/// Centred down the box only, which is what a single line of text in a control
/// of a fixed height wants: in the middle, but still starting at the left.
pub fn vertically_centered(base: Decor) -> Decor {
    return Decor{..base, center_y: true }
}

/// Ink alone, on a box that draws no background — what a run of text wants.
pub fn ink(colour: int) -> Decor {
    return Decor{..no_decor(), ink: colour }
}

/// Draw a laid-out tree, over a window cleared to `behind`.
///
/// Frames come out in paint order, so this walks them forwards: a parent's
/// background is drawn before its children sit on top. A frame whose decor
/// says nothing is invisible but still laid out, which is how spacers work.
pub fn paint(frames: [Frame], behind: int) {
    var backdrop: [int] = []
    for frame in frames {
        draw_one(frame, backdrop_at(backdrop, frame.depth, behind))
        backdrop = record_fill(backdrop, frame, behind)
    }
}

/// What is behind a frame: the nearest enclosing box that painted a fill.
///
/// Correct exactly while boxes nest visually, which this layout makes true of
/// siblings — the cursor advances by a child's full size, so two siblings
/// cannot overlap. It is *not* true of a child that overflows its parent,
/// because `grow` takes spare space and never gives it back: such a child sits
/// on pixels this attributes to an ancestor. Overflow already breaks painting
/// in more visible ways; the assumption is written down rather than defended.
fn backdrop_at(stack: [int], depth: int, behind: int) -> int {
    if depth <= 0 {
        return behind
    }
    if depth - 1 < stack.len() {
        return stack[depth - 1]
    }
    return behind
}

/// The backdrop a frame's children sit on — its own fill if it painted one,
/// otherwise whatever it was itself sitting on.
///
/// A frame that is culled still passes through here. A half-visible child of a
/// scrolled-away parent needs its parent's colour, and skipping the parent
/// because it was not drawn would hand the child the window's instead.
fn record_fill(stack: [int], frame: Frame, behind: int) -> [int] {
    let own = frame.decor.fill
    let colour = if own != nil { own } else { backdrop_at(stack, frame.depth, behind) }
    var out: [int] = []
    for i in 0..frame.depth {
        if i < stack.len() {
            out.push(stack[i])
        } else {
            out.push(behind)
        }
    }
    out.push(colour)
    return out
}

fn draw_one(frame: Frame, behind: int) {
    let r = frame.rect
    let d = frame.decor
    // Transparent means the colour of what is behind, which is the one thing
    // a boundary with no alpha can honestly do with the word.
    let own = d.fill
    let surface = if own != nil { own } else { behind }
    let edge = d.border
    var drew = false
    if edge != nil {
        // Narrowed one condition at a time: `edge != nil && ...` is a
        // comparison inside a conjunction, and only the comparison alone
        // narrows the option.
        if edge.width > 0.0 {
            drew = true
            fill_rect(r.x, r.y, r.width, r.height, d.radius, edge.colour)
            let w = edge.width
            let inner = if d.radius - w > 0.0 { d.radius - w } else { 0.0 }
            // The hole. Filled with the backdrop when the box is transparent,
            // which is what makes an outlined control an outline rather than a
            // solid block — the bug this replaces drew the block and claimed
            // in a comment that the box beneath showed through.
            fill_rect(r.x + w, r.y + w, r.width - w * 2.0, r.height - w * 2.0, inner, surface)
        }
    }
    if !drew {
        if own != nil {
            fill_rect(r.x, r.y, r.width, r.height, d.radius, own)
        }
    }
    let body = frame.content
    if body.len() == 0 {
        return
    }
    // Content goes inside the padding, and wraps to the width measurement used
    // — so what is painted is what was laid out, rather than an approximation
    // that happens to look close.
    let box = frame.inner
    // Lines are broken in logical order and reordered afterwards, which is
    // the order UAX #9 requires; the paragraph decides its direction once and
    // every line wrapped out of it inherits, so a Hebrew paragraph whose
    // second line begins with a number does not change direction mid-text.
    // Left-to-right text is one run per line and is drawn exactly as before.
    //
    // What this does not do: an RTL paragraph is still drawn from the box's
    // left edge — alignment belongs to the box — and the parallel tree for
    // screen readers hears a reordered line run by run, in visual order,
    // which for mixed-direction text is not reading order. Both are stated
    // rather than solved.
    //
    // The font is the one the box was measured in. Decoration may not choose
    // another: the room has already been allotted.
    set_font(frame.size, frame.weight)
    let base = text.paragraph_level(body)
    let lines = wrap(body, box.width)
    var y = box.y
    if d.center_y {
        // The whole block of lines is centred, not each line separately: two
        // lines centred individually would sit in the same place as one.
        let tall = line_height() * intToFloat(lines.len())
        let slack = box.height - tall
        if slack > 0.0 {
            y = box.y + slack / 2.0
        }
    }
    for line in lines {
        // A centred line starts wherever the leftover space puts it. The width
        // is measured in the font just selected, so this is the font the line
        // will actually be drawn in rather than the one before it.
        var x = box.x
        if d.center_x {
            let slack = box.width - text.width(line)
            if slack > 0.0 {
                x = box.x + slack / 2.0
            }
        }
        for run in text.bidi_runs_with(line, base) {
            draw.text(x, y, run.body, d.ink)
            x = x + text.width(run.body)
        }
        y = y + line_height()
    }
    unset_font(frame.size)
}

/// A filled rectangle, round or square. The square call is still the one made
/// for a zero radius, so a renderer that never sees a rounded corner draws
/// exactly what it drew before rounded corners existed.
fn fill_rect(x: float, y: float, w: float, h: float, radius: float, colour: int) {
    if radius > 0.0 {
        draw.rrect(x, y, w, h, radius, colour)
    } else {
        draw.rect(x, y, w, h, colour)
    }
}

// ---- scrolling ------------------------------------------------------------
//
// Scrolling is not a layout concern here. A tree is laid out at its natural
// size, and a viewport decides which part of it is visible — which means
// scrolling changes nothing about where anything is, only about what is drawn.
// That is why `hit` still works on the same frames: subtract the offset from
// the point instead of re-laying anything out.

/// How far a laid-out tree can scroll inside a viewport before its last frame
/// is flush with the bottom. Never negative: content shorter than the viewport
/// does not scroll.
pub fn scroll_extent(frames: [Frame], viewport: Size) -> float {
    var bottom = 0.0
    for frame in frames {
        bottom = maxf(bottom, frame.rect.y + frame.rect.height)
    }
    return maxf(0.0, bottom - viewport.height)
}

/// `offset` held within what there is to scroll.
pub fn clamp_scroll(offset: float, frames: [Frame], viewport: Size) -> float {
    return clampf(offset, 0.0, scroll_extent(frames, viewport))
}

fn shifted(r: Rect, dx: float, dy: float) -> Rect {
    return Rect{ x: r.x + dx, y: r.y + dy, width: r.width, height: r.height }
}

/// Draw a tree inside a viewport, scrolled down by `offset`.
///
/// Frames outside the viewport are skipped rather than drawn and clipped away.
/// The clip is still needed for the ones that straddle an edge — a half-visible
/// row has to be cut by the renderer, and painting over it would erase what it
/// is scrolling past.
pub fn paint_scrolled(frames: [Frame], behind: int, viewport: Rect, offset: float) {
    draw.clip(viewport.x, viewport.y, viewport.width, viewport.height)
    let dx = viewport.x
    let dy = viewport.y - offset
    var backdrop: [int] = []
    for frame in frames {
        let r = shifted(frame.rect, dx, dy)
        // A culled frame still contributes its fill. A half-visible child of a
        // parent scrolled off the top needs its parent's colour behind it, and
        // skipping the parent because it was not drawn would hand the child the
        // window's instead.
        if r.y + r.height >= viewport.y && r.y <= viewport.y + viewport.height{
            draw_one(
                Frame {..frame, rect: r, inner: shifted(frame.inner, dx, dy) },
                backdrop_at(backdrop, frame.depth, behind),
            )
        }
        backdrop = record_fill(backdrop, frame, behind)
    }
    draw.unclip()
}

/// The frame under a point in a scrolled viewport. The offset is subtracted
/// from the point rather than added to every frame, which is the same answer
/// and one subtraction instead of many.
pub fn hit_scrolled(
    frames: [Frame],
    viewport: Rect,
    offset: float,
    x: float,
    y: float,
) -> Option<Frame> {
    if !rect_contains(viewport, x, y) {
        return nil
    }
    return hit(frames, x - viewport.x, y - viewport.y + offset)
}

/// The next control in focus order, wrapping at the end.
///
/// Focus order is the order the controls were listed, which is the order they
/// were laid out — a separate tab order is a second thing to keep in step, and
/// the two disagreeing is how a form becomes unusable with a keyboard.
pub fn next_focus(names: [str], focused: str) -> str {
    if names.len() == 0 {
        return ""
    }
    let at = position(names, |n: str| n == focused)
    if at < 0 {
        return names[0]
    }
    return names[(at + 1) % names.len()]
}

pub fn previous_focus(names: [str], focused: str) -> str {
    if names.len() == 0 {
        return ""
    }
    let at = position(names, |n: str| n == focused)
    if at <= 0 {
        return names[names.len() - 1]
    }
    return names[at - 1]
}

/// Text with a key applied to it, for a focused field.
///
/// The keys a text field must understand are the ones a keyboard sends, and
/// `Backspace` is the only one that is not simply itself. Everything longer
/// than one character is a named key this does not act on, which is what keeps
/// `ArrowLeft` from being typed into the box.
pub fn typed(value: str, key: str) -> str {
    if key == "Backspace" {
        if value.len() == 0 {
            return value
        }
        return value.slice(0, value.len() - 1)
    }
    if key.len() != 1 {
        return value
    }
    return value + key
}
