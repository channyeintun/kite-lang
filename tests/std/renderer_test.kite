// A third renderer, written as an ordinary Kite library.
//
// docs/04 §8 rests its whole containment argument on one sentence: *because
// `Renderer` is an ordinary trait, a third backend is a normal library.* This
// file is that sentence, executed. Nothing below touches the compiler, the
// generated glue, or any application — it is an `impl Renderer for Recorder`
// and a call to `ui.paint_with`.
//
// The backend it implements is the one §8 names as an example: "a test renderer
// that records draw calls". It is useful for exactly what it sounds like —
// asserting about a picture without a browser, a canvas or a golden image.

use std/test
use std/ui

/// One thing a renderer was asked to do.
struct Call {
    what: str
    x: float
    y: float
    w: float
    h: float
    detail: str
}

/// A renderer that draws nothing and remembers everything.
///
/// It is a struct with a `var` field, and that is all the state a backend
/// needs to be allowed to have: `paint_with` takes it by reference, so what it
/// accumulates is visible to the caller afterwards.
struct Recorder {
    var calls: [Call]
}

fn recorder() -> Recorder {
    return Recorder{ calls: [] }
}

fn record(var into: Recorder, what: str, r: ui.Rect, detail: str) {
    // Through a local, because a slice held in a field cannot be pushed to in
    // place yet — the compiler says so and says what to do instead.
    var so_far = into.calls
    so_far.push(Call{ what: what, x: r.x, y: r.y, w: r.width, h: r.height, detail: detail })
    into.calls = so_far
}

impl ui.Renderer for Recorder {
    fn fill(var self, r: ui.Rect, radius: float, colour: int) {
        record(self, "fill", r, "\(colour)")
    }

    fn ring(var self, r: ui.Rect, radius: float, width: float, colour: int) {
        record(self, "ring", r, "\(colour)")
    }

    fn glyphs(var self, x: float, y: float, body: str, colour: int) {
        record(self, "glyphs", ui.Rect{ x: x, y: y, width: 0.0, height: 0.0 }, body)
    }

    fn field(var self, r: ui.Rect, value: str, hint: str, colour: int, id: str, multiline: bool) {
        record(self, "field", r, "\(id):\(multiline)")
    }

    fn picture(var self, r: ui.Rect, src: str) {
        record(self, "picture", r, src)
    }

    fn describe(var self, r: ui.Rect, role: int, label: str, flags: int, id: str) {
        record(self, "describe", r, "\(id)=\(label)")
    }

    fn font(var self, size: float, weight: int) {
        record(self, "font", ui.Rect{ x: 0.0, y: 0.0, width: 0.0, height: 0.0 }, "\(size)")
    }

    fn alpha(var self, a: float) {
        record(self, "alpha", ui.Rect{ x: 0.0, y: 0.0, width: 0.0, height: 0.0 }, "\(a)")
    }

    fn clip(var self, r: ui.Rect) {
        record(self, "clip", r, "")
    }

    fn unclip(var self) {
        record(self, "unclip", ui.Rect{ x: 0.0, y: 0.0, width: 0.0, height: 0.0 }, "")
    }
}

enum Msg {
    Pressed
}

fn counted(calls: [Call], what: str) -> int {
    var n = 0
    for c in calls {
        if c.what == what {
            n += 1
        }
    }
    return n
}

fn detail_of(calls: [Call], what: str) -> str {
    for c in calls {
        if c.what == what {
            return c.detail
        }
    }
    return ""
}

fn tree() -> ui.Node<Msg> {
    let button: ui.Node<Msg> = ui.means(
        ui.decorated(
            ui.text_of("go", ui.sized(ui.style(), 80.0, 48.0), "Go"),
            ui.bordered(ui.rounded(0x3b82f6, 4.0), 0x1d4ed8, 2.0),
        ),
        "go",
        Msg.Pressed,
        "Go",
    )
    let photo: ui.Node<Msg> = ui.image_of("photo", ui.style(), "cat.png", 40.0, 40.0)
    return ui.box_of(
        "root",
        ui.Style {..ui.column(), align: ui.Align.Start },
        [button, photo],
    )
}

fn checks() -> [error] {
    var out: [error] = []

    let frames = ui.layout(tree(), ui.Size{ width: 200.0, height: 200.0 })
    let seen = recorder()
    ui.paint_with(frames, seen)

    // The backend received the picture. Nothing in `std/ui` knows what a
    // `Recorder` is, and nothing in this file was registered anywhere.
    out.push(test.is_true(seen.calls.len() > 0, "a third renderer receives the frame"))
    out.push(test.equal_int(counted(seen.calls, "fill"), 1, "one fill, for the button"))
    out.push(test.equal_int(counted(seen.calls, "ring"), 1, "one ring, for its border"))
    out.push(test.equal_int(counted(seen.calls, "glyphs"), 1, "one run of text"))
    out.push(test.equal_str(detail_of(seen.calls, "glyphs"), "Go", "which is the caption"))
    out.push(test.equal_int(counted(seen.calls, "picture"), 1, "one picture"))
    out.push(test.equal_str(detail_of(seen.calls, "picture"), "cat.png", "from its source"))

    // The semantics reach a backend that has never heard of ARIA. That is the
    // point of §7 being a drawing call: a renderer decides what to do with it.
    out.push(test.equal_int(counted(seen.calls, "describe"), 1, "the control is declared"))
    out.push(test.equal_str(detail_of(seen.calls, "describe"), "go=Go", "with its id and label"))

    // Geometry is the layout's, so the recorder sees exactly what was laid out.
    var button_fill = ui.Rect{ x: -1.0, y: -1.0, width: -1.0, height: -1.0 }
    for c in seen.calls {
        if c.what == "fill" {
            button_fill = ui.Rect{ x: c.x, y: c.y, width: c.w, height: c.h }
        }
    }
    out.push(test.equal_float(button_fill.width, 80.0, 0.001, "the button's width"))
    out.push(test.equal_float(button_fill.height, 48.0, 0.001, "and its height"))

    // ---- scrolling goes through the same door ----
    let scrolled = recorder()
    ui.paint_scrolled_with(
        frames,
        ui.Rect { x: 0.0, y: 0.0, width: 200.0, height: 60.0 },
        0.0,
        scrolled,
    )
    out.push(test.equal_int(counted(scrolled.calls, "clip"), 1, "a viewport opens one clip"))
    out.push(test.equal_int(counted(scrolled.calls, "unclip"), 1, "and closes it"))

    return out
}

fn main() {
    let results = checks()
    var failed = 0
    for e in results {
        if e != nil {
            io.print("FAILED \(e.message())")
            failed += 1
        }
    }
    io.print("renderer: \(results.len() - failed) passed, \(failed) failed")
}
