// std/text — the bidirectional algorithm and Arabic joining.
//
// The bidi cases are hand-derived from UAX #9's own rules, not copied from a
// reference implementation: each one names the rule it exercises, so a
// failure says which rule broke rather than which fixture drifted. Levels
// and visual order are asserted as plain integers because a level is the
// algorithm's whole intermediate state in one number.

use std/test
use std/text

fn levels(line: str) -> [int] {
    return text.bidi_levels(line)
}

fn visual(line: str) -> [int] {
    return text.bidi_visual(line)
}

/// The values at some positions only — the ones the algorithm draws, since a
/// removed character's level is not specified.
fn at(values: [int], positions: [int]) -> [int] {
    return map(positions, |p: int| values[p])
}

fn bodies(line: str) -> [str] {
    return map(text.bidi_runs(line), |r: text.Run| r.body)
}

fn checks() -> [error] {
    var out: [error] = []

    // ---- the class table ----
    out.push(test.is_true(text.bidi_class(0x0041) == text.BidiClass.L, "A is L"))
    out.push(test.is_true(text.bidi_class(0x05D0) == text.BidiClass.R, "alef is R"))
    out.push(test.is_true(text.bidi_class(0x0628) == text.BidiClass.AL, "beh is AL"))
    out.push(test.is_true(text.bidi_class(0x0035) == text.BidiClass.EN, "5 is EN"))
    out.push(test.is_true(text.bidi_class(0x0665) == text.BidiClass.AN, "arabic five is AN"))
    out.push(test.is_true(text.bidi_class(0x0020) == text.BidiClass.WS, "space is WS"))
    out.push(test.is_true(text.bidi_class(0x002B) == text.BidiClass.ES, "plus is ES"))
    out.push(test.is_true(text.bidi_class(0x0024) == text.BidiClass.ET, "dollar is ET"))
    out.push(test.is_true(text.bidi_class(0x002C) == text.BidiClass.CS, "comma is CS"))
    out.push(test.is_true(text.bidi_class(0x0301) == text.BidiClass.NSM, "acute is NSM"))
    out.push(test.is_true(text.bidi_class(0x05B0) == text.BidiClass.NSM, "sheva is NSM"))
    out.push(test.is_true(text.bidi_class(0x064E) == text.BidiClass.NSM, "fatha is NSM"))
    out.push(test.is_true(text.bidi_class(0x200D) == text.BidiClass.BN, "zwj is BN"))
    out.push(test.is_true(text.bidi_class(0x2066) == text.BidiClass.LRI, "lri is LRI"))
    out.push(test.is_true(text.bidi_class(0x2069) == text.BidiClass.PDI, "pdi is PDI"))
    out.push(test.is_true(text.bidi_class(0x4E2D) == text.BidiClass.L, "an ideograph is L"))
    out.push(test.is_true(text.bidi_class(0x0E01) == text.BidiClass.L, "thai ko kai is L"))
    out.push(test.is_true(text.bidi_class(0x0E31) == text.BidiClass.NSM, "thai mai han-akat is NSM"))
    out.push(test.is_true(text.bidi_class(0x102D) == text.BidiClass.NSM, "myanmar i is NSM"))
    out.push(test.is_true(text.bidi_class(0xFE91) == text.BidiClass.AL, "a presentation form is AL"))
    out.push(test.is_true(text.is_combining(0x0301), "a mark is combining"))
    out.push(test.is_false(text.is_combining(0x0628), "a letter is not"))

    // ---- P2 and P3 ----
    out.push(test.equal_int(text.paragraph_level("abc"), 0, "latin paragraph"))
    out.push(test.equal_int(text.paragraph_level("\u{5d0}\u{5d1}"), 1, "hebrew paragraph"))
    out.push(test.equal_int(text.paragraph_level("123 \u{5d0}"), 1, "digits are not strong"))
    out.push(test.equal_int(text.paragraph_level(""), 0, "an empty paragraph reads left to right"))
    out.push(test.equal_int(
            text.paragraph_level("\u{2066}\u{5d0}\u{2069}x"),
            0,
            "P2 skips over an isolate",
        ))

    // ---- levels: the W, N and I rules ----
    out.push(test.equal_ints(levels("abc"), [0, 0, 0], "plain latin stays at zero"))
    out.push(test.equal_ints(levels("\u{5d0}\u{5d1}\u{5d2}"), [1, 1, 1], "plain hebrew is level one"))
    out.push(test.equal_ints(
            levels("abc \u{5d0}\u{5d1}\u{5d2}"),
            [0, 0, 0, 0, 1, 1, 1],
            "N2: the space between directions takes the base",
        ))
    out.push(test.equal_ints(
            levels("\u{5d0}\u{5d1}\u{5d2} abc"),
            [1, 1, 1, 1, 2, 2, 2],
            "I2: latin inside hebrew rises to two",
        ))
    out.push(test.equal_ints(
            levels("\u{5d0}\u{5d1}\u{5d2} 123"),
            [1, 1, 1, 1, 2, 2, 2],
            "I2: european numbers inside hebrew rise to two",
        ))
    out.push(test.equal_ints(
            levels("abc \u{5d0}\u{5d1}\u{5d2} "),
            [0, 0, 0, 0, 1, 1, 1, 0],
            "L1: trailing whitespace returns to the base",
        ))
    out.push(test.equal_ints(
            levels("\u{628}\u{62c}\u{62f} 123"),
            [1, 1, 1, 1, 2, 2, 2],
            "W2 then I2: digits after arabic are arabic numbers",
        ))
    out.push(test.equal_ints(
            levels("\u{5d0}1.2\u{5d1}"),
            [1, 2, 2, 2, 1],
            "W4: a comma-class separator between digits joins them",
        ))
    out.push(test.equal_ints(
            levels("abc 123"),
            [0, 0, 0, 0, 0, 0, 0],
            "W7: a number in left-to-right company is just text",
        ))
    out.push(test.equal_ints(
            levels("\u{5d0}$123\u{5d1}"),
            [1, 2, 2, 2, 2, 1],
            "W5: a terminator beside a european number joins it",
        ))

    // ---- N0: bracket pairs ----
    out.push(test.equal_ints(
            levels("\u{5d0}(\u{5d1})\u{5d2}"),
            [1, 1, 1, 1, 1],
            "N0: brackets around hebrew inside hebrew stay hebrew",
        ))
    out.push(test.equal_ints(
            levels("\u{5d0}(b)\u{5d2}"),
            [1, 1, 2, 1, 1],
            "N0: brackets keep the embedding direction their context has",
        ))
    out.push(test.equal_ints(
            levels("a(\u{5d0}\u{5d1}\u{5d2})b"),
            [0, 0, 1, 1, 1, 0, 0],
            "N0: brackets containing only the opposite direction follow their context",
        ))

    // ---- X: isolates and overrides ----
    out.push(test.equal_ints(
            levels("\u{5d0} \u{2066}abc\u{2069} \u{5d1}"),
            [1, 1, 1, 2, 2, 2, 1, 1, 1],
            "X5–X6a: an isolate holds latin inside hebrew",
        ))
    out.push(test.equal_ints(
            visual("\u{5d0} \u{2066}abc\u{2069} \u{5d1}"),
            [8, 7, 3, 4, 5, 1, 0],
            "an isolate reorders as a unit, and draws no isolate characters",
        ))
    out.push(test.equal_ints(
            visual("\u{202e}abc\u{202c}"),
            [3, 2, 1],
            "X6: an override forces latin right to left",
        ))

    // ---- L2, seen as visual order ----
    out.push(test.equal_ints(visual("abc"), [0, 1, 2], "latin is drawn as written"))
    out.push(test.equal_ints(visual("\u{5d0}\u{5d1}\u{5d2}"), [2, 1, 0], "hebrew is reversed"))
    out.push(test.equal_ints(
            visual("\u{5d0}\u{5d1}\u{5d2} 123"),
            [4, 5, 6, 3, 2, 1, 0],
            "digits inside hebrew are reversed twice, so they read forwards",
        ))
    out.push(test.equal_ints(
            visual("\u{5d0}1.2\u{5d1}"),
            [4, 1, 2, 3, 0],
            "a number with its separator moves whole",
        ))

    // ---- runs, as a painter consumes them ----
    out.push(test.equal_strs(bodies("hello"), ["hello"], "one latin run"))
    out.push(test.equal_strs(
            bodies("abc \u{5d0}\u{5d1}\u{5d2}"),
            ["abc ", "\u{5d0}\u{5d1}\u{5d2}"],
            "latin then hebrew is two runs in the same order",
        ))
    out.push(test.equal_strs(
            bodies("\u{5d0}\u{5d1}\u{5d2} abc"),
            ["abc", "\u{5d0}\u{5d1}\u{5d2} "],
            "hebrew then latin swaps, and the space stays with the hebrew level",
        ))
    out.push(test.is_true(text.bidi_runs("\u{5d0}\u{5d1}")[0].rtl, "a hebrew run says so"))
    out.push(test.is_false(text.bidi_runs("abc")[0].rtl, "a latin run says so"))
    out.push(test.equal_strs(bodies(""), [""], "an empty line is one empty run"))
    out.push(test.equal_strs(
            bodies("\u{202e}abc\u{202c}"),
            ["cba"],
            "an overridden latin run arrives pre-reversed, with nothing strong to say so",
        ))
    out.push(test.equal_strs(
            bodies("\u{202e}(x\u{202c}"),
            ["x)"],
            "a pre-reversed run mirrors its brackets, which is L4 for the pair table",
        ))
    out.push(test.equal_strs(
            bodies("ab\u{200e}cd"),
            ["abcd"],
            "an implicit direction mark is obeyed and not drawn",
        ))

    // ---- arabic joining ----
    let bism = text.join_arabic("\u{628}\u{633}\u{645}")
    out.push(test.equal_int(bism.code_at(0), 0xFE91, "beh joins forwards: initial"))
    out.push(test.equal_int(bism.code_at(1), 0xFEB4, "seen joins both ways: medial"))
    out.push(test.equal_int(bism.code_at(2), 0xFEE2, "meem joins backwards: final"))
    let dar = text.join_arabic("\u{62f}\u{627}\u{631}")
    out.push(test.equal_int(dar.code_at(0), 0xFEA9, "dal only joins backwards: isolated here"))
    out.push(test.equal_int(dar.code_at(1), 0xFE8D, "alef after dal cannot join: isolated"))
    out.push(test.equal_int(dar.code_at(2), 0xFEAD, "reh after alef cannot join: isolated"))
    out.push(test.equal_int(
            text.join_arabic("\u{621}").code_at(0),
            0xFE80,
            "hamza never joins",
        ))
    out.push(test.equal_int(
            text.join_arabic("\u{644}\u{627}").code_at(0),
            0xFEFB,
            "lam alef is the mandatory ligature",
        ))
    let bila = text.join_arabic("\u{628}\u{644}\u{627}")
    out.push(test.equal_int(bila.code_at(1), 0xFEFC, "a joined lam alef takes its final form"))
    out.push(test.equal_int(bila.len(), 2, "the ligature swallows the alef"))
    let marked = text.join_arabic("\u{628}\u{64e}\u{633}")
    out.push(test.equal_int(marked.code_at(0), 0xFE91, "a mark is transparent to joining"))
    out.push(test.equal_int(marked.code_at(1), 0x064E, "and is itself unchanged"))
    out.push(test.equal_int(marked.code_at(2), 0xFEB2, "the letter after it still joins"))
    let stretched = text.join_arabic("\u{628}\u{640}\u{628}")
    out.push(test.equal_int(stretched.code_at(0), 0xFE91, "tatweel joins backwards"))
    out.push(test.equal_int(stretched.code_at(2), 0xFE90, "and forwards"))
    out.push(test.equal_str(text.join_arabic("abc"), "abc", "everything else passes through"))
    // A mark on the lam does not stop the ligature: it was drawn as a lam
    // and an alef apart, FEDF 064E FE8E.
    let voweled = text.join_arabic("\u{644}\u{64e}\u{627}")
    out.push(test.equal_int(voweled.code_at(0), 0xFEFB, "lam, fatha, alef is still the ligature"))
    out.push(test.equal_int(voweled.code_at(1), 0x064E, "with the mark after it"))
    out.push(test.equal_int(voweled.len(), 2, "and the alef swallowed"))
    let joined_voweled = text.join_arabic("\u{628}\u{644}\u{651}\u{627}")
    out.push(test.equal_int(joined_voweled.code_at(1), 0xFEFC, "joined, with a shadda, the final ligature"))

    // ---- X10 and the isolates, from the conformance lines they failed ----
    //
    // A sequence's boundary is decided by *embedding* levels, and the levels
    // array had already been raised by I1–I2 for the sequences resolved
    // before it, so a later sequence saw the wrong neighbour: here the
    // numbers after an LRE took the RTL paragraph's direction.
    out.push(test.equal_ints(
            at(levels("a\u{202a}\u{5d1}\u{202c} 1 2"), [0, 2, 4, 5, 6, 7]),
            [0, 3, 0, 0, 0, 0],
            "X10 compares embedding levels, not resolved ones",
        ))
    out.push(test.equal_ints(
            at(levels("a\u{202b}b\u{202c} 1 2"), [0, 2, 4, 5, 6, 7]),
            [0, 2, 1, 2, 1, 2],
            "and on the right-to-left side",
        ))
    // An isolate initiator or PDI under an override is L or R, not a neutral.
    out.push(test.equal_ints(
            at(levels("\u{202e}a\u{202a}b\u{202c}\u{2066}c\u{2069}\u{202a}d\u{202c}e\u{202c}"), [1, 3, 5, 6, 7, 9, 11]),
            [1, 2, 1, 2, 1, 2, 1],
            "an overridden isolate keeps the override's direction",
        ))

    // ---- clusters and cell_width ----
    let acute = text.from_code(0x301)
    let zwj = text.from_code(0x200D)
    let family = text.from_code(0x1F468) + zwj + text.from_code(0x1F469) + zwj + text.from_code(0x1F467)
    let thumb = text.from_code(0x1F44D) + text.from_code(0x1F3FB)
    let flag = text.from_code(0x1F1EF) + text.from_code(0x1F1F5)
    out.push(test.equal_strs(text.clusters("ae\(acute)b"), ["a", "e\(acute)", "b"], "a mark stays with its letter"))
    out.push(test.equal_strs(text.clusters("x\(family)y"), ["x", family, "y"], "a joined sequence is one"))
    out.push(test.equal_strs(text.clusters("\(thumb)\(thumb)"), [thumb, thumb], "a modifier stays with its base"))
    out.push(test.equal_strs(text.clusters("\(flag)\(flag)"), [flag, flag], "two regional indicators are a flag"))
    out.push(test.equal_strs(text.clusters("x\(zwj)"), ["x\(zwj)"], "a trailing joiner stays"))
    // GB9 and GB11: a joiner stays with what is before it, and joins across
    // only from one emoji to another. It took whatever followed it.
    out.push(test.equal_strs(text.clusters("a\(zwj)中文"), ["a\(zwj)", "中", "文"], "a joiner after a letter joins nothing"))
    out.push(test.equal_strs(text.clusters("x\(zwj) y"), ["x\(zwj)", " ", "y"], "nor does it swallow a space"))
    // But a joiner that joins nothing ends no cluster: a mark or a joiner
    // after it still attaches (GB9), and no emoji after those is joined on.
    out.push(test.equal_strs(text.clusters("a\(zwj)\u{301}b"), ["a\(zwj)\u{301}", "b"], "a mark after a stray joiner attaches"))
    let grin = text.from_code(0x1F600)
    out.push(test.equal_strs(text.clusters("\(grin)\(zwj)\(zwj)\(grin)"), ["\(grin)\(zwj)\(zwj)", grin], "two joiners join no emoji"))

    // GB9c (Unicode 15.1): a consonant, its viramas and marks, and the next
    // consonant are one cluster. The sequences are GraphemeBreakTest's.
    let ka = "\u{915}"
    let ta = "\u{924}"
    let virama = "\u{94D}"
    let nukta = "\u{93C}"
    out.push(test.equal_strs(text.clusters(ka + virama + ta), [ka + virama + ta], "GB9c: consonant, virama, consonant"))
    out.push(test.equal_strs(text.clusters(ka + virama + virama + ta), [ka + virama + virama + ta], "GB9c: two viramas"))
    out.push(test.equal_strs(text.clusters(ka + virama + zwj + ta), [ka + virama + zwj + ta], "GB9c: a joiner after the virama"))
    out.push(test.equal_strs(text.clusters(ka + nukta + zwj + virama + ta), [ka + nukta + zwj + virama + ta], "GB9c: nukta, joiner, virama"))
    out.push(test.equal_strs(text.clusters(ka + nukta + virama + zwj + ta), [ka + nukta + virama + zwj + ta], "GB9c: nukta, virama, joiner"))
    out.push(test.equal_strs(text.clusters(ka + virama + ta + virama + "\u{92F}"), [ka + virama + ta + virama + "\u{92F}"], "GB9c: a conjunct of three"))
    out.push(test.equal_strs(text.clusters(ka + virama + "a"), [ka + virama, "a"], "a virama before a letter that is no consonant breaks"))
    out.push(test.equal_strs(text.clusters(ka + virama + " " + ta), [ka + virama, " ", ta], "nor does a space join"))
    out.push(test.equal_strs(text.clusters(ka + ta), [ka, ta], "two consonants with no virama are two"))
    out.push(test.equal_strs(text.clusters(ka + zwj + ta), [ka + zwj, ta], "a joiner is not a virama"))
    out.push(test.equal_strs(text.clusters("a" + virama + ta), ["a" + virama, ta], "a virama after a letter that is no consonant links nothing"))
    out.push(test.equal_strs(text.clusters(ka + virama + "\u{995}"), [ka + virama + "\u{995}"], "GB9c names no script, so it joins across two"))
    out.push(test.equal_strs(text.clusters("\u{995}\u{9CD}\u{9B7}"), ["\u{995}\u{9CD}\u{9B7}"], "Bengali has conjuncts too"))
    out.push(test.equal_strs(text.clusters("\u{D15}\u{D4D}\u{D15}"), ["\u{D15}\u{D4D}\u{D15}"], "so does Malayalam"))
    out.push(test.equal_strs(text.clusters("\u{C15}\u{C4D}\u{C37}"), ["\u{C15}\u{C4D}\u{C37}"], "and Telugu"))
    out.push(test.equal_strs(text.clusters(ka + virama + "\u{D15}"), [ka + virama + "\u{D15}"], "Devanagari then Malayalam too"))
    out.push(test.equal_strs(text.clusters(ka + virama + "\u{1F3FB}" + ta), [ka + virama + "\u{1F3FB}" + ta], "a skin-tone modifier is Extend to GB9c"))
    out.push(test.equal_strs(text.clusters(ka + virama + "\u{E0041}" + ta), [ka + virama + "\u{E0041}" + ta], "and so is a tag character"))
    out.push(test.equal_strs(text.clusters(ka + "\u{1F3FB}" + virama + ta), [ka + "\u{1F3FB}" + virama + ta], "before the virama too"))
    out.push(test.equal_int(text.cell_width(ka + virama + "\u{937}"), 2, "a conjunct keeps a column for each consonant"))
    out.push(test.equal_int(text.cell_width(ka + virama + ta + virama + "\u{92F}"), 3, "three consonants, three columns"))
    out.push(test.equal_int(text.cell_width(ka + virama + zwj + ta + "a"), 3, "a joiner in the conjunct takes none"))
    out.push(test.equal_int(text.cell_width("\u{915}\u{941}"), 1, "a vowel sign on its consonant takes none"))
    out.push(test.equal_int(text.cell_width("a\(zwj)中文"), 5, "so the ideographs keep their columns"))
    let heart = text.from_code(0x2764) + text.from_code(0xFE0F)
    let couple = text.from_code(0x1F469) + zwj + heart + zwj + text.from_code(0x1F468)
    out.push(test.equal_strs(text.clusters("\(couple)!"), [couple, "!"], "an older symbol joins as an emoji"))
    let tone = text.from_code(0x1F44B) + text.from_code(0x1F3FD) + zwj + text.from_code(0x1F680)
    out.push(test.equal_strs(text.clusters(tone), [tone], "a skin tone before the joiner keeps the emoji"))
    out.push(test.equal_strs(text.clusters("\(family)\(zwj)a"), [family + zwj, "a"], "an emoji's joiner before a letter joins nothing"))
    out.push(test.equal_int(text.clusters("").len(), 0, "nothing is no clusters"))
    out.push(test.equal_str(join(text.clusters("é日\(family)"), ""), "é日\(family)", "joined, they are the text again"))
    out.push(test.equal_int(text.cell_width("abc"), 3, "one column each"))
    out.push(test.equal_int(text.cell_width("中文"), 4, "ideographs are two"))
    out.push(test.equal_int(text.cell_width("ひらカナ"), 8, "kana are two"))
    out.push(test.equal_int(text.cell_width("한글"), 4, "Hangul is two"))
    out.push(test.equal_int(text.cell_width("e\(acute)"), 1, "a mark takes none"))
    out.push(test.equal_int(text.cell_width("a\u{3099}"), 1, "nor the kana voicing mark"))
    out.push(test.equal_int(text.cell_width(family), 2, "a family is one wide glyph"))
    out.push(test.equal_int(text.cell_width(thumb), 2, "a modifier takes none"))
    out.push(test.equal_int(text.cell_width(flag), 2, "a flag is two"))
    out.push(test.equal_int(text.cell_width("ａｂ"), 4, "fullwidth forms are two"))
    out.push(test.equal_int(text.cell_width("a\tb\u{0}"), 2, "controls take none"))
    out.push(test.equal_int(text.cell_width("héllo"), 5, "Latin-1 is one"))
    out.push(test.equal_int(text.cell_width(""), 0, "nothing is none"))
    out.push(test.equal_int(text.cell_width("a\u{200c}\u{200e}\u{202e}\u{2060}\u{feff}b"), 2, "format characters take none"))
    out.push(test.equal_int(text.cell_width(text.from_code(0x1F1EF) + acute), 1, "a lone regional indicator is no flag"))
    out.push(test.equal_int(text.cell_width(text.from_code(0x1FAE0)), 2, "the newer emoji are two"))
    // is_combining is every Mn and Me of Unicode 15.1: it was the marks of
    // the scripts the bidi table named, and a Bengali nukta measured a column.
    out.push(test.equal_int(text.cell_width("x\u{9BC}y"), 2, "a nukta takes none"))
    out.push(test.equal_int(text.clusters("x\u{BCD}y").len(), 2, "a virama stays with its letter"))
    out.push(test.is_true(text.is_combining(0x0300) && text.is_combining(0x036F) && !text.is_combining(0x0370), "the first range, to its edges"))
    out.push(test.is_true(text.is_combining(0xE01EF) && !text.is_combining(0xE01F0) && !text.is_combining(0x10FFFF), "the last range, to its edges"))
    out.push(test.is_true(!text.is_combining(0x093E) && !text.is_combining(0x0915) && !text.is_combining(-1), "a spacing vowel sign, a letter, nothing"))
    // And bidi_class answers NSM from the same table, but for the five marks
    // Unicode makes L.
    out.push(test.is_true(text.bidi_class(0x0711) == text.BidiClass.NSM, "a Syriac mark is NSM"))
    out.push(test.is_true(text.is_combining(0x0CBF) && text.bidi_class(0x0CBF) == text.BidiClass.L, "a Kannada sign is a mark and L"))

    return out
}

fn main() {
    let results = checks()
    var failed = 0
    for e in results {
        if e != nil {
            io.print("FAILED \(e.message())")
            failed += 1
        }
    }
    io.print("text: \(results.len() - failed) passed, \(failed) failed")
}
