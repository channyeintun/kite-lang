// std/json's own tests.

use std/test
use std/json

fn parsed(doc: str) -> json.Json {
    let (value, err) = json.parse(doc)
    if err != nil {
        return json.Json.Text("parse failed: \(err.message())")
    }
    return value
}

fn roundtrip(doc: str) -> str {
    return json.stringify(parsed(doc))
}

fn checks() -> [error] {
    var out: [error] = []

    out.push(test.equal_str(roundtrip("null"), "null", "null"))
    out.push(test.equal_str(roundtrip("true"), "true", "true"))
    out.push(test.equal_str(roundtrip("  42 "), "42", "a number with space around it"))
    out.push(test.equal_str(roundtrip("-1.5"), "-1.5", "a negative float"))
    out.push(test.equal_str(roundtrip("1e3"), "1000", "an exponent"))
    out.push(test.equal_str(roundtrip("1.5e-2"), "0.015", "a negative exponent"))
    out.push(test.equal_str(roundtrip("\"hi\""), "\"hi\"", "a string"))
    out.push(test.equal_str(roundtrip("[]"), "[]", "an empty array"))
    out.push(test.equal_str(roundtrip("{}"), "{}", "an empty object"))
    out.push(test.equal_str(roundtrip("[1,[2,[3]]]"), "[1,[2,[3]]]", "nesting"))
    out.push(test.equal_str(
            roundtrip("{\"b\": 1, \"a\": 2}"),
            "{\"b\":1,\"a\":2}",
            "objects keep insertion order",
        ))
    out.push(test.equal_str(roundtrip("\"a\\nb\""), "\"a\\nb\"", "an escape survives a round trip"))

    let doc = parsed("{\"name\": \"kite\", \"n\": 3, \"tags\": [\"a\", \"b\"], \"deep\": {\"x\": true}}")
    out.push(test.equal_str(json.text_or(doc, "name", "?"), "kite", "text_or"))
    out.push(test.equal_int(json.int_or(doc, "n", 0), 3, "int_or"))
    out.push(test.equal_int(json.int_or(doc, "missing", -1), -1, "int_or falls back"))
    out.push(test.equal_int(json.items(json.field(doc, "tags")).len(), 2, "items"))

    let deep = json.field(doc, "deep")
    let flag = json.bool_of(json.field(deep, "x"))
    out.push(test.is_true(if flag == nil { false } else { flag }, "a nested field"))

    let first = json.at(json.field(doc, "tags"), 0)
    out.push(test.equal_str(json.text_or(doc, "name", "?"), "kite", "text_or again"))
    let text = json.text(first)
    out.push(test.equal_str(if text == nil { "?" } else { text }, "a", "at"))

    // Failures are values, with the position in the message.
    let (bad, err) = json.parse("{\"a\": }")
    out.push(test.failed(err, "a malformed document"))
    let (trailing, terr) = json.parse("1 2")
    out.push(test.failed(terr, "trailing text"))
    let (unterminated, uerr) = json.parse("\"abc")
    out.push(test.failed(uerr, "an unterminated string"))

    out.push(test.equal_str(json.pretty(parsed("{\"a\":[1]}")), "{\n  \"a\": [\n    1\n  ]\n}", "pretty"))

    // ---- escapes, RFC 8259 §7 ----
    //
    // `\uXXXX` used to arrive as its own digits: `caf\u00e9` decoded to
    // `cafu00e9`, silently. The primitive that decodes it — `text.from_code`
    // — was added for this and for `std/toml`, and only `std/toml` picked it
    // up. The corruption was silent, which is why every one of these is here.

    out.push(test.equal_str(
            roundtrip("\"caf\\u00e9\""), "\"café\"", "\\u is decoded"))
    out.push(test.equal_str(
            roundtrip("\"\\u003cp\\u003e\""), "\"<p>\"", "an escaped tag is decoded"))
    // Outside the BMP JSON has no other spelling: two escapes, one character.
    out.push(test.equal_str(
            roundtrip("\"\\ud83d\\ude00\""), "\"😀\"", "a surrogate pair is one character"))
    // A half of a pair is not a character. U+FFFD rather than a dropped one.
    out.push(test.equal_str(
            roundtrip("\"\\ud83d\""), "\"\u{fffd}\"", "a lone high surrogate is replaced"))
    out.push(test.equal_str(
            roundtrip("\"\\udc00\""), "\"\u{fffd}\"", "a lone low surrogate is replaced"))
    let (_, uerr) = json.parse("\"\\uzzzz\"")
    out.push(test.failed(uerr, "a malformed \\u is refused, not guessed at"))
    out.push(test.equal_str(
            roundtrip("\"a\\bb\""), "\"a\\bb\"", "\\b round-trips"))
    out.push(test.equal_str(
            roundtrip("\"a\\fb\""), "\"a\\fb\"", "\\f round-trips"))

    // Writing: a raw control character inside a string is invalid JSON, and a
    // strict parser refuses the whole document over one — `JSON.parse` says
    // `Bad control character in string literal`. A pasted note was enough.
    out.push(test.equal_str(
            json.stringify(json.Json.Text("a\rb")), "\"a\\rb\"", "a carriage return is escaped"))
    out.push(test.equal_str(
            json.stringify(json.Json.Text("a\u{1}b")), "\"a\\u0001b\"",
            "an unnamed control character becomes \\u00XX"))
    out.push(test.equal_str(
            json.stringify(json.Json.Text("a\u{1f}b")), "\"a\\u001fb\"",
            "and the last one below the space"))
    // What it is all for: what this library writes, this library reads.
    out.push(test.equal_str(
            roundtrip(json.stringify(json.Json.Text("a\rb\u{7}c"))),
            json.stringify(json.Json.Text("a\rb\u{7}c")),
            "control characters survive a round trip"))

    // A document does not get to choose how long the parser runs, how big an
    // int it accumulates, or how much stack it uses. Each of these three used
    // to be attacker-chosen: the first spun a loop the document sized, the
    // second overflowed an int and trapped, and the third recursed until the
    // stack ran out. That every one of them returns at all is the assertion.
    out.push(test.equal_str(roundtrip("1e-999999999999"), "0", "an exponent past the float range underflows to zero"))

    // Both of these return promptly rather than hanging or trapping, which is
    // what the bound was for — and both are *refused*, which is the second
    // half. An exponent past the float range used to parse to an infinity, and
    // `stringify` then emitted the bare token `inf`: a document that went in as
    // JSON and came out as something no JSON parser reads.
    let (huge, huge_err) = json.parse("1e999999999999")
    out.push(test.failed(huge_err, "an enormous exponent is refused, not turned into an infinity"))

    let (wide, wide_err) = json.parse("1e99999999999999999999")
    out.push(test.failed(wide_err, "more exponent digits than an int holds is refused, not overflowed"))

    // The edge is the float's, not a guessed threshold: the largest power of
    // ten a `float` holds still parses, and one more does not.
    let (big, big_err) = json.parse("1e308")
    out.push(test.ok(big_err, "the largest power of ten a float holds still parses"))

    let (over, over_err) = json.parse("1e309")
    out.push(test.failed(over_err, "one past it does not"))

    let (too_deep, too_deep_err) = json.parse(nested(max_nesting() + 20))
    out.push(test.failed(too_deep_err, "nesting past the ceiling is an error, not a crash"))

    let (shallow, shallow_err) = json.parse(nested(max_nesting() - 1))
    out.push(test.ok(shallow_err, "nesting just under the ceiling still parses"))

    // ---- numbers are the float nearest what was written ----
    //
    // Summing digit values as floats made seven of these seventeen common
    // literals come out a unit or two away, `0.3` as 0.30000000000000004.
    out.push(number("0.3", 0.3))
    out.push(number("0.7", 0.7))
    out.push(number("3.14159", 3.14159))
    out.push(number("9.95", 9.95))
    out.push(number("0.035", 0.035))
    out.push(number("1e-7", 0.0000001))
    out.push(number("123.456", 123.456))
    out.push(number("1234.5678", 1234.5678))
    out.push(number("0.1234567890123", 0.1234567890123))
    out.push(number("1e23", 1e23))
    out.push(number("5e-324", 5e-324))
    out.push(number("-2.5E+3", -2500.0))
    out.push(number("9223372036854775808", 9223372036854775808.0))
    out.push(number("0.30000000000000004", 0.1 + 0.2))
    // Written back as the same number. The writer cast to an `int` to drop
    // the `.0`, and the cast saturates: 2⁶³ came out as 9223372036854775807,
    // which is a different number to anything reading it as an integer.
    out.push(test.equal_str(roundtrip("9223372036854775808"), "9223372036854775808.0", "2^63 is written as itself"))
    out.push(number(roundtrip("9223372036854775808"), 9223372036854775808.0))
    out.push(test.equal_str(roundtrip("-9223372036854775808"), "-9223372036854775808", "-2^63 is a whole int"))
    out.push(test.equal_str(roundtrip("9223372036854774784"), "9223372036854774784", "the largest float below 2^63"))
    let zero = or_else(json.number_of(parsed("-0")), 1.0)
    out.push(test.is_true(zero == 0.0 && 1.0 / zero < 0.0, "-0 keeps its sign"))

    // ---- RFC 8259, and nothing looser ----
    for loose in ["01", "-01", "00", "1.", "-", "1e", "1e+", "1E-", ".5", "+1", "1.e5", "0x10", "\"\\x\"", "\"\\a\"", "\"a\tb\"", "\"a\nb\"", "\"\u{1}\""] {
        let (_, lerr) = json.parse(loose)
        out.push(test.failed(lerr, "`\(loose)` is not JSON"))
    }
    for strict in ["0", "-0", "0.5", "10", "1E+2", "1e-2", "\"\\/\"", "\"a\\tb\""] {
        let (_, serr) = json.parse(strict)
        out.push(test.ok(serr, "`\(strict)` is JSON"))
    }
    out.push(test.equal_str(roundtrip("\"\\/\""), "\"/\"", "an escaped solidus is itself"))

    // ---- a whole number is whole and fits ----
    //
    // `int_of` was a cast, which truncated 3.7 and saturated 1e30, and
    // `@derive(Decode)` reads an `int` field through it.
    out.push(test.is_true(json.int_of(parsed("3.7")) == nil, "3.7 is not a whole number"))
    out.push(test.is_true(json.int_of(parsed("1e30")) == nil, "1e30 does not fit in an int"))
    out.push(test.is_true(json.int_of(parsed("9223372036854775808")) == nil, "2^63 does not fit"))
    out.push(test.equal_int(or_else(json.int_of(parsed("3.0")), 0), 3, "3.0 is the whole number 3"))
    out.push(test.equal_int(or_else(json.int_of(parsed("-12")), 0), -12, "a negative whole number"))
    out.push(test.equal_int(
            or_else(json.int_of(parsed("-9223372036854775808")), 0),
            -9223372036854775807 - 1,
            "the smallest int",
        ))
    out.push(test.equal_int(json.int_or(parsed("{\"n\": 2.5}"), "n", -1), -1, "int_or falls back on a fraction"))
    let (_, fraction_err) = Row.decode(parsed("{\"id\": 3.7}"))
    out.push(test.equal_str(
            if fraction_err == nil { "decoded" } else { fraction_err.message() },
            "Row.id: expected a whole number",
            "Decode refuses a fraction for an int",
        ))
    let (_, huge_id_err) = Row.decode(parsed("{\"id\": 1e30}"))
    out.push(test.failed(huge_id_err, "Decode refuses an int past the range"))
    let (row, row_err) = Row.decode(parsed("{\"id\": 42}"))
    out.push(test.ok(row_err, "Decode takes a whole number"))

    return out
}

@derive(Decode)
struct Row {
    id: int
}

/// `doc` parses to exactly `want`, bit for bit.
fn number(doc: str, want: float) -> error {
    let (value, err) = json.parse(doc)
    if err != nil {
        return test.fail("\(doc): \(err.message())")
    }
    return test.equal_float(or_else(json.number_of(value), -1.0), want, 0.0, doc)
}

/// The ceiling `std/json` enforces, repeated here so the two tests below sit
/// either side of it.
fn max_nesting() -> int {
    return 128
}

/// `[[[…]]]`, nested `depth` deep.
fn nested(depth: int) -> str {
    var open = ""
    var close = ""
    for n in 0..depth {
        open = open + "["
        close = close + "]"
    }
    return open + close
}

fn main() {
    var failed = 0
    for e in checks() {
        if e != nil {
            io.print("FAILED \(e.message())")
            failed += 1
        }
    }
    io.print("json: \(checks().len() - failed) passed, \(failed) failed")
}
