// The prelude's own tests.
//
// Each file here is an ordinary program: it runs its checks and prints what
// failed. That is what lets the same file run on the bytecode VM *and* on
// WebAssembly and be compared — a library test that only ran on one backend
// would not be testing the thing most likely to be wrong.

use std/test

/// `text` parses to exactly `want`, bit for bit.
fn exact_float(text: str, want: float) -> error {
    let found = parse_float(text)
    if found == nil {
        return test.fail("parse_float(\"\(text)\"): expected \(want), found nil")
    }
    return test.equal_float(found, want, 0.0, "parse_float(\"\(text)\")")
}

fn checks() -> [error] {
    var out: [error] = []

    // ---- slices ----
    out.push(test.equal_ints(map([1, 2, 3], |n: int| n * 2), [2, 4, 6], "map"))
    out.push(test.equal_ints(filter([1, 2, 3, 4], |n: int| n % 2 == 0), [2, 4], "filter"))
    out.push(test.equal_int(fold([1, 2, 3], 0, |a: int, b: int| a + b), 6, "fold"))
    out.push(test.is_true(any([1, 2], |n: int| n == 2), "any"))
    out.push(test.is_false(any([1, 2], |n: int| n == 9), "any misses"))
    out.push(test.is_true(all([2, 4], |n: int| n % 2 == 0), "all"))
    let empty: [int] = []
    out.push(test.is_true(all(empty, |n: int| false), "all is vacuously true"))
    out.push(test.equal_int(count([1, 2, 3], |n: int| n > 1), 2, "count"))
    out.push(test.equal_ints(reversed([1, 2, 3]), [3, 2, 1], "reversed"))
    out.push(test.equal_ints(concat([1], [2, 3]), [1, 2, 3], "concat"))
    out.push(test.equal_ints(take([1, 2, 3], 2), [1, 2], "take"))
    out.push(test.equal_ints(take([1, 2, 3], -1), empty, "take of a negative amount"))
    out.push(test.equal_ints(drop([1, 2, 3], 2), [3], "drop"))
    out.push(test.equal_int(sum([1, 2, 3]), 6, "sum"))

    let found = find([1, 2, 3], |n: int| n > 1)
    out.push(test.equal_int(if found == nil { -1 } else { found }, 2, "find"))
    let missing = find([1], |n: int| n > 9)
    out.push(test.is_true(missing == nil, "find yields nil"))
    let head = first([7, 8])
    out.push(test.equal_int(if head == nil { -1 } else { head }, 7, "first"))
    let tail = last([7, 8])
    out.push(test.equal_int(if tail == nil { -1 } else { tail }, 8, "last"))
    out.push(test.is_true(first(empty) == nil, "first of an empty slice"))

    // ---- ordering ----
    out.push(test.equal_ints(sorted([3, 1, 2], |a: int, b: int| a < b), [1, 2, 3], "sorted"))
    out.push(test.equal_strs(
            sorted(["pear", "fig", "apple"], |a: str, b: str| a < b),
            ["apple", "fig", "pear"],
            "sorted by code point",
        ))
    out.push(test.equal_ints(sorted(empty, |a: int, b: int| a < b), empty, "sorting nothing"))
    // Stability: two items the comparison does not separate keep their order.
    let pairs = [(2, "first"), (1, "x"), (2, "second")]
    let by_number = sorted(pairs, |a: (int, str), b: (int, str)| a.0 < b.0)
    out.push(test.equal_str(by_number[1].1, "first", "the sort is stable"))
    out.push(test.equal_str(by_number[2].1, "second", "the sort is stable"))

    let smallest = min_by([3, 1, 2], |a: int, b: int| a < b)
    out.push(test.equal_int(if smallest == nil { -1 } else { smallest }, 1, "min_by"))
    let largest = max_by([3, 1, 2], |a: int, b: int| a < b)
    out.push(test.equal_int(if largest == nil { -1 } else { largest }, 3, "max_by"))
    out.push(test.is_true(min_by(empty, |a: int, b: int| a < b) == nil, "min_by of nothing"))

    out.push(test.equal_int(zip([1, 2, 3], [4, 5]).len(), 2, "zip stops at the shorter"))
    out.push(test.equal_int(zip([1, 2], [3, 4])[1].1, 4, "zip pairs up"))
    out.push(test.equal_ints(flatten([[1, 2], [3]]), [1, 2, 3], "flatten"))
    out.push(test.equal_int(position([4, 5, 6], |n: int| n == 5), 1, "position"))
    out.push(test.equal_int(position([4], |n: int| n == 9), -1, "position misses"))
    out.push(test.is_true(includes([1, 2], 2), "includes"))
    out.push(test.equal_ints(unique([1, 2, 1, 3, 2]), [1, 2, 3], "unique keeps the first"))
    out.push(test.equal_int(chunked([1, 2, 3, 4, 5], 2).len(), 3, "chunked"))
    out.push(test.equal_ints(chunked([1, 2, 3], 2)[1], [3], "the last chunk is what is left"))
    out.push(test.equal_int(chunked([1], 0).len(), 0, "chunks of nothing"))

    // ---- strings ----
    out.push(test.is_true("apple" < "banana", "strings order by code point"))
    out.push(test.is_true("Z" < "a", "upper case sorts before lower"))
    out.push(test.is_false("b" <= "a", "and the other way"))

    // ---- reading numbers ----
    let n = parse_int("42")
    out.push(test.equal_int(if n == nil { -1 } else { n }, 42, "parse_int"))
    let negative = parse_int("-7")
    out.push(test.equal_int(if negative == nil { 0 } else { negative }, -7, "a negative number"))
    out.push(test.is_true(parse_int("12a") == nil, "trailing rubbish is not a number"))
    out.push(test.is_true(parse_int("") == nil, "nothing is not a number"))
    out.push(test.is_true(parse_int("-") == nil, "a sign alone is not a number"))
    out.push(test.is_true(parse_int(" 1") == nil, "parsing does not trim"))
    let f = parse_float("2.5")
    out.push(test.equal_float(if f == nil { 0.0 } else { f }, 2.5, 0.0001, "parse_float"))
    let nf = parse_float("-0.25")
    out.push(test.equal_float(if nf == nil { 0.0 } else { nf }, -0.25, 0.0001, "a negative float"))
    let whole = parse_float("3")
    out.push(test.equal_float(if whole == nil { 0.0 } else { whole }, 3.0, 0.0001, "a whole float"))
    out.push(test.is_true(parse_float("2.") == nil, "a point with nothing after it"))

    // Untrusted digits: past the range is nil, where it used to be a trap.
    out.push(test.is_true(parse_int("99999999999999999999") == nil, "an int too large is nil"))
    out.push(test.is_true(parse_int("9223372036854775808") == nil, "one past the largest int"))
    out.push(test.equal_int(or_else(parse_int("9223372036854775807"), 0), 9223372036854775807, "the largest int"))
    out.push(test.equal_int(
            or_else(parse_int("-9223372036854775808"), 0),
            -9223372036854775807 - 1,
            "the smallest int",
        ))
    out.push(test.is_true(parse_int("-9223372036854775809") == nil, "one past the smallest int"))
    out.push(test.equal_int(or_else(parse_int("-0"), 1), 0, "minus zero is zero"))

    // A fraction that is not all digits is not a number: `1.-5` was 0.95.
    out.push(test.is_true(parse_float("1.-5") == nil, "a signed fraction"))
    out.push(test.is_true(parse_float("-1.-5") == nil, "a signed fraction after a sign"))
    out.push(test.is_true(parse_float("1.5x") == nil, "trailing rubbish"))
    out.push(test.is_true(parse_float("") == nil, "nothing is not a float"))
    out.push(test.is_true(parse_float("-") == nil, "a sign alone is not a float"))
    out.push(test.is_true(parse_float(".") == nil, "a point alone"))
    out.push(test.is_true(parse_float("+1") == nil, "no plus in front"))
    out.push(test.is_true(parse_float("1e") == nil, "an exponent with no digits"))
    out.push(test.is_true(parse_float("1e+") == nil, "an exponent with only a sign"))
    out.push(test.is_true(parse_float("e5") == nil, "an exponent with no number"))
    out.push(test.is_true(parse_float(" 1") == nil, "parse_float does not trim"))
    out.push(exact_float(".5", 0.5))
    out.push(exact_float("-.5", -0.5))
    out.push(exact_float("1.5e3", 1500.0))
    out.push(exact_float("1.5E+3", 1500.0))
    out.push(exact_float("25e-2", 0.25))
    // A fraction too long for an `int` overflowed it and trapped.
    out.push(exact_float("0.12345678901234567890", 0.12345678901234568))
    out.push(exact_float("123456789012345678901234567890", 123456789012345678901234567890.0))
    out.push(exact_float("9223372036854775808", 9223372036854775808.0))

    // Correctly rounded: the digits as floats gave 0.30000000000000004.
    out.push(exact_float("0.3", 0.3))
    out.push(exact_float("0.7", 0.7))
    out.push(exact_float("3.14159", 3.14159))
    out.push(exact_float("9.95", 9.95))
    out.push(exact_float("0.035", 0.035))
    out.push(exact_float("2.675", 2.675))
    out.push(exact_float("1e-7", 0.0000001))
    out.push(exact_float("0.30000000000000004", 0.1 + 0.2))
    out.push(exact_float("1e22", 1e22))
    out.push(exact_float("1e23", 1e23))
    out.push(exact_float("1.7976931348623157e308", 1.7976931348623157e308))
    out.push(exact_float("2.2250738585072014e-308", 2.2250738585072014e-308))
    out.push(exact_float("5e-324", 5e-324))
    // Halfway between zero and the smallest float goes to the even one, zero;
    // anything above it goes up.
    out.push(exact_float("2.4703282292062327e-324", 0.0))
    out.push(exact_float("2.4703282292062328e-324", 5e-324))
    out.push(exact_float("1e-400", 0.0))
    out.push(test.is_true(parse_float("1e309") == nil, "past the largest float is nil"))
    out.push(test.is_true(parse_float("1.7976931348623159e308") == nil, "just past the largest float"))
    // Ties to even, far past the digits a fast path could hold: 2⁵³ + 1 is
    // halfway between two floats, and a trailing digit decides.
    out.push(exact_float("9007199254740993", 9007199254740992.0))
    out.push(exact_float("9007199254740993.0000000000000000000001", 9007199254740994.0))
    out.push(exact_float("9007199254740995", 9007199254740996.0))
    let negative_zero = or_else(parse_float("-0.0"), 1.0)
    out.push(test.is_true(negative_zero == 0.0 && 1.0 / negative_zero < 0.0, "-0.0 keeps its sign"))
    out.push(test.is_true(hash_float(negative_zero) == hash_float(0.0), "-0.0 hashes as 0.0 does"))

    // ---- letters ----
    out.push(test.equal_str(lower("MiXeD"), "mixed", "lower"))
    out.push(test.equal_str(upper("MiXeD"), "MIXED", "upper"))
    out.push(test.equal_str(lower("héllo"), "héllo", "only ASCII case changes"))
    out.push(test.is_true(equal_ignoring_case("Content-Type", "content-type"), "header names"))
    out.push(test.equal_str(pad_start("7", 3, "0"), "007", "pad_start"))
    out.push(test.equal_str(pad_start("1234", 3, "0"), "1234", "pad_start leaves longer text"))

    // ---- numbers ----
    out.push(test.equal_int(abs(-3), 3, "abs"))
    out.push(test.equal_int(min(2, 5), 2, "min"))
    out.push(test.equal_int(max(2, 5), 5, "max"))
    out.push(test.equal_int(clamp(11, 0, 10), 10, "clamp"))
    out.push(test.equal_float(absf(-2.5), 2.5, 0.0001, "absf"))
    out.push(test.is_true(approx_eq(0.1 + 0.2, 0.3, 0.0001), "approx_eq"))
    out.push(test.is_true(divides(9, 3), "divides"))

    // ---- strings ----
    out.push(test.is_true(contains("hello", "ell"), "contains"))
    out.push(test.is_true(starts_with("hello", "he"), "starts_with"))
    out.push(test.is_true(ends_with("hello", "lo"), "ends_with"))
    out.push(test.is_false(starts_with("he", "hello"), "starts_with a longer prefix"))
    out.push(test.equal_strs(split("a,b,c", ","), ["a", "b", "c"], "split"))
    out.push(test.equal_str(join(["a", "b"], "-"), "a-b", "join"))
    out.push(test.equal_str(replace("banana", "na", "NA"), "baNANA", "replace"))
    out.push(test.equal_strs(words("  two  words  "), ["two", "words"], "words"))
    out.push(test.equal_int("héllo日本".len(), 7, "len counts characters"))
    out.push(test.equal_str("  x  ".trim(), "x", "trim"))
    out.push(test.equal_int("hello".index_of("ll"), 2, "index_of"))
    out.push(test.equal_int("hello".index_of("z"), -1, "index_of misses"))
    out.push(test.equal_str("hello".slice(1, 3), "el", "slice"))
    out.push(test.equal_str("hello".slice(3, 99), "lo", "slice clamps"))

    return out
}

fn main() {
    var failed = 0
    for e in checks() {
        if e != nil {
            io.print("FAILED \(e.message())")
            failed += 1
        }
    }
    io.print("prelude: \(checks().len() - failed) passed, \(failed) failed")
}
