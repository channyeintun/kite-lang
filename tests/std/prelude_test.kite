// The prelude's own tests.
//
// Each file here is an ordinary program: it runs its checks and prints what
// failed. That is what lets the same file run on the bytecode VM *and* on
// WebAssembly and be compared — a library test that only ran on one backend
// would not be testing the thing most likely to be wrong.

use std/test

/// `text` parses to exactly `want`, bit for bit.
fn exact_float(text: str, want: float) -> error {
    let found = parse_float(text)
    if found == nil {
        return test.fail("parse_float(\"\(text)\"): expected \(want), found nil")
    }
    return test.equal_float(found, want, 0.0, "parse_float(\"\(text)\")")
}

fn checks() -> [error] {
    var out: [error] = []

    // ---- slices ----
    out.push(test.equal_ints(map([1, 2, 3], |n: int| n * 2), [2, 4, 6], "map"))
    out.push(test.equal_ints(filter([1, 2, 3, 4], |n: int| n % 2 == 0), [2, 4], "filter"))
    out.push(test.equal_int(fold([1, 2, 3], 0, |a: int, b: int| a + b), 6, "fold"))
    out.push(test.is_true(any([1, 2], |n: int| n == 2), "any"))
    out.push(test.is_false(any([1, 2], |n: int| n == 9), "any misses"))
    out.push(test.is_true(all([2, 4], |n: int| n % 2 == 0), "all"))
    let empty: [int] = []
    out.push(test.is_true(all(empty, |n: int| false), "all is vacuously true"))
    out.push(test.equal_int(count([1, 2, 3], |n: int| n > 1), 2, "count"))
    out.push(test.equal_ints(reversed([1, 2, 3]), [3, 2, 1], "reversed"))
    out.push(test.equal_ints(concat([1], [2, 3]), [1, 2, 3], "concat"))
    out.push(test.equal_ints(take([1, 2, 3], 2), [1, 2], "take"))
    out.push(test.equal_ints(take([1, 2, 3], -1), empty, "take of a negative amount"))
    out.push(test.equal_ints(drop([1, 2, 3], 2), [3], "drop"))
    out.push(test.equal_int(sum([1, 2, 3]), 6, "sum"))

    let found = find([1, 2, 3], |n: int| n > 1)
    out.push(test.equal_int(if found == nil { -1 } else { found }, 2, "find"))
    let missing = find([1], |n: int| n > 9)
    out.push(test.is_true(missing == nil, "find yields nil"))
    let head = first([7, 8])
    out.push(test.equal_int(if head == nil { -1 } else { head }, 7, "first"))
    let tail = last([7, 8])
    out.push(test.equal_int(if tail == nil { -1 } else { tail }, 8, "last"))
    out.push(test.is_true(first(empty) == nil, "first of an empty slice"))

    // ---- ordering ----
    out.push(test.equal_ints(sorted([3, 1, 2], |a: int, b: int| a < b), [1, 2, 3], "sorted"))
    out.push(test.equal_strs(
            sorted(["pear", "fig", "apple"], |a: str, b: str| a < b),
            ["apple", "fig", "pear"],
            "sorted by code point",
        ))
    out.push(test.equal_ints(sorted(empty, |a: int, b: int| a < b), empty, "sorting nothing"))
    // Stability: two items the comparison does not separate keep their order.
    let pairs = [(2, "first"), (1, "x"), (2, "second")]
    let by_number = sorted(pairs, |a: (int, str), b: (int, str)| a.0 < b.0)
    out.push(test.equal_str(by_number[1].1, "first", "the sort is stable"))
    out.push(test.equal_str(by_number[2].1, "second", "the sort is stable"))

    let smallest = min_by([3, 1, 2], |a: int, b: int| a < b)
    out.push(test.equal_int(if smallest == nil { -1 } else { smallest }, 1, "min_by"))
    let largest = max_by([3, 1, 2], |a: int, b: int| a < b)
    out.push(test.equal_int(if largest == nil { -1 } else { largest }, 3, "max_by"))
    out.push(test.is_true(min_by(empty, |a: int, b: int| a < b) == nil, "min_by of nothing"))

    out.push(test.equal_int(zip([1, 2, 3], [4, 5]).len(), 2, "zip stops at the shorter"))
    out.push(test.equal_int(zip([1, 2], [3, 4])[1].1, 4, "zip pairs up"))
    out.push(test.equal_ints(flatten([[1, 2], [3]]), [1, 2, 3], "flatten"))
    out.push(test.equal_int(position([4, 5, 6], |n: int| n == 5), 1, "position"))
    out.push(test.equal_int(position([4], |n: int| n == 9), -1, "position misses"))
    out.push(test.is_true(includes([1, 2], 2), "includes"))
    out.push(test.equal_ints(unique([1, 2, 1, 3, 2]), [1, 2, 3], "unique keeps the first"))
    out.push(test.equal_int(chunked([1, 2, 3, 4, 5], 2).len(), 3, "chunked"))
    out.push(test.equal_ints(chunked([1, 2, 3], 2)[1], [3], "the last chunk is what is left"))
    out.push(test.equal_int(chunked([1], 0).len(), 0, "chunks of nothing"))

    // ---- strings ----
    out.push(test.is_true("apple" < "banana", "strings order by code point"))
    out.push(test.is_true("Z" < "a", "upper case sorts before lower"))
    out.push(test.is_false("b" <= "a", "and the other way"))

    // ---- reading numbers ----
    let n = parse_int("42")
    out.push(test.equal_int(if n == nil { -1 } else { n }, 42, "parse_int"))
    let negative = parse_int("-7")
    out.push(test.equal_int(if negative == nil { 0 } else { negative }, -7, "a negative number"))
    out.push(test.is_true(parse_int("12a") == nil, "trailing rubbish is not a number"))
    out.push(test.is_true(parse_int("") == nil, "nothing is not a number"))
    out.push(test.is_true(parse_int("-") == nil, "a sign alone is not a number"))
    out.push(test.is_true(parse_int(" 1") == nil, "parsing does not trim"))
    let f = parse_float("2.5")
    out.push(test.equal_float(if f == nil { 0.0 } else { f }, 2.5, 0.0001, "parse_float"))
    let nf = parse_float("-0.25")
    out.push(test.equal_float(if nf == nil { 0.0 } else { nf }, -0.25, 0.0001, "a negative float"))
    let whole = parse_float("3")
    out.push(test.equal_float(if whole == nil { 0.0 } else { whole }, 3.0, 0.0001, "a whole float"))
    out.push(test.is_true(parse_float("2.") == nil, "a point with nothing after it"))

    // Untrusted digits: past the range is nil, where it used to be a trap.
    out.push(test.is_true(parse_int("99999999999999999999") == nil, "an int too large is nil"))
    out.push(test.is_true(parse_int("9223372036854775808") == nil, "one past the largest int"))
    out.push(test.equal_int(or_else(parse_int("9223372036854775807"), 0), 9223372036854775807, "the largest int"))
    out.push(test.equal_int(
            or_else(parse_int("-9223372036854775808"), 0),
            -9223372036854775807 - 1,
            "the smallest int",
        ))
    out.push(test.is_true(parse_int("-9223372036854775809") == nil, "one past the smallest int"))
    out.push(test.equal_int(or_else(parse_int("-0"), 1), 0, "minus zero is zero"))

    // A fraction that is not all digits is not a number: `1.-5` was 0.95.
    out.push(test.is_true(parse_float("1.-5") == nil, "a signed fraction"))
    out.push(test.is_true(parse_float("-1.-5") == nil, "a signed fraction after a sign"))
    out.push(test.is_true(parse_float("1.5x") == nil, "trailing rubbish"))
    out.push(test.is_true(parse_float("") == nil, "nothing is not a float"))
    out.push(test.is_true(parse_float("-") == nil, "a sign alone is not a float"))
    out.push(test.is_true(parse_float(".") == nil, "a point alone"))
    out.push(test.is_true(parse_float("+1") == nil, "no plus in front"))
    out.push(test.is_true(parse_float("1e") == nil, "an exponent with no digits"))
    out.push(test.is_true(parse_float("1e+") == nil, "an exponent with only a sign"))
    out.push(test.is_true(parse_float("e5") == nil, "an exponent with no number"))
    out.push(test.is_true(parse_float(" 1") == nil, "parse_float does not trim"))
    out.push(exact_float(".5", 0.5))
    out.push(exact_float("-.5", -0.5))
    out.push(exact_float("1.5e3", 1500.0))
    out.push(exact_float("1.5E+3", 1500.0))
    out.push(exact_float("25e-2", 0.25))
    // A fraction too long for an `int` overflowed it and trapped.
    out.push(exact_float("0.12345678901234567890", 0.12345678901234568))
    out.push(exact_float("123456789012345678901234567890", 123456789012345678901234567890.0))
    out.push(exact_float("9223372036854775808", 9223372036854775808.0))

    // Correctly rounded: the digits as floats gave 0.30000000000000004.
    out.push(exact_float("0.3", 0.3))
    out.push(exact_float("0.7", 0.7))
    out.push(exact_float("3.14159", 3.14159))
    out.push(exact_float("9.95", 9.95))
    out.push(exact_float("0.035", 0.035))
    out.push(exact_float("2.675", 2.675))
    out.push(exact_float("1e-7", 0.0000001))
    out.push(exact_float("0.30000000000000004", 0.1 + 0.2))
    out.push(exact_float("1e22", 1e22))
    out.push(exact_float("1e23", 1e23))
    out.push(exact_float("1.7976931348623157e308", 1.7976931348623157e308))
    out.push(exact_float("2.2250738585072014e-308", 2.2250738585072014e-308))
    out.push(exact_float("5e-324", 5e-324))
    // Halfway between zero and the smallest float goes to the even one, zero;
    // anything above it goes up.
    out.push(exact_float("2.4703282292062327e-324", 0.0))
    out.push(exact_float("2.4703282292062328e-324", 5e-324))
    out.push(exact_float("1e-400", 0.0))
    out.push(test.is_true(parse_float("1e309") == nil, "past the largest float is nil"))
    out.push(test.is_true(parse_float("1.7976931348623159e308") == nil, "just past the largest float"))
    // Ties to even, far past the digits a fast path could hold: 2⁵³ + 1 is
    // halfway between two floats, and a trailing digit decides.
    out.push(exact_float("9007199254740993", 9007199254740992.0))
    out.push(exact_float("9007199254740993.0000000000000000000001", 9007199254740994.0))
    out.push(exact_float("9007199254740995", 9007199254740996.0))
    let negative_zero = or_else(parse_float("-0.0"), 1.0)
    out.push(test.is_true(negative_zero == 0.0 && 1.0 / negative_zero < 0.0, "-0.0 keeps its sign"))
    out.push(test.is_true(hash_float(negative_zero) == hash_float(0.0), "-0.0 hashes as 0.0 does"))

    // ---- letters ----
    out.push(test.equal_str(lower("MiXeD"), "mixed", "lower"))
    out.push(test.equal_str(upper("MiXeD"), "MIXED", "upper"))
    out.push(test.equal_str(lower("héllo"), "héllo", "only ASCII case changes"))
    out.push(test.is_true(equal_ignoring_case("Content-Type", "content-type"), "header names"))
    out.push(test.equal_str(pad_start("7", 3, "0"), "007", "pad_start"))
    out.push(test.equal_str(pad_start("1234", 3, "0"), "1234", "pad_start leaves longer text"))
    out.push(test.equal_str(pad_start("7", 4, "ab"), "aba7", "a long filler is cut at the width"))
    out.push(test.equal_str(pad_start("7", 6, "ab"), "ababa7", "and repeated to reach it"))
    out.push(test.equal_str(pad_start("7", 4, ""), "7", "an empty filler pads nothing"))

    // ---- debug_str ----
    out.push(test.equal_str(debug_str("say \"hi\"\n\t\\"), "\"say \\\"hi\\\"\\n\\t\\\\\"", "the escapes put back"))
    out.push(test.equal_str(debug_str("a\rb"), "\"a\\rb\"", "a carriage return is written"))
    out.push(test.equal_str(debug_str("a\u{0}b\u{7f}c"), "\"a\\u{0}b\\u{7f}c\"", "NUL and DEL"))
    out.push(test.equal_str(debug_str("\u{1b}\u{85}\u{2028}\u{2029}"), "\"\\u{1b}\\u{85}\\u{2028}\\u{2029}\"", "ESC, NEL, and the separators"))
    out.push(test.equal_str(debug_str("é中"), "\"é中\"", "printable text is left alone"))
    out.push(test.equal_str(debug_str("a\u{202e}b\u{200b}\u{feff}"), "\"a\\u{202e}b\\u{200b}\\u{feff}\"", "an override and the invisible ones are written"))
    out.push(test.equal_str(debug_str("a\u{200d}b"), "\"a\u{200d}b\"", "a joiner is ordinary text"))

    // ---- numbers ----
    out.push(test.equal_int(abs(-3), 3, "abs"))
    out.push(test.equal_int(min(2, 5), 2, "min"))
    out.push(test.equal_int(max(2, 5), 5, "max"))
    out.push(test.equal_int(clamp(11, 0, 10), 10, "clamp"))
    out.push(test.equal_float(absf(-2.5), 2.5, 0.0001, "absf"))
    out.push(test.is_true(approx_eq(0.1 + 0.2, 0.3, 0.0001), "approx_eq"))
    out.push(test.is_true(divides(9, 3), "divides"))
    // The edges: a zero's sign, a NaN on either side, an infinity, a zero
    // divisor. Each of these was wrong, or trapped.
    let inf = 1.0 / 0.0
    let nan = 0.0 / 0.0
    out.push(test.is_true(1.0 / absf(-0.0) > 0.0, "absf(-0.0) is +0.0"))
    out.push(test.is_true(!(minf(nan, 1.0) >= 0.0) && !(minf(1.0, nan) >= 0.0), "minf carries a NaN from either side"))
    out.push(test.is_true(!(maxf(nan, 1.0) >= 0.0) && !(maxf(1.0, nan) >= 0.0), "maxf carries a NaN from either side"))
    out.push(test.is_true(1.0 / minf(0.0, -0.0) < 0.0 && 1.0 / minf(-0.0, 0.0) < 0.0, "minf: -0.0 is the smaller zero"))
    out.push(test.is_true(1.0 / maxf(0.0, -0.0) > 0.0 && 1.0 / maxf(-0.0, 0.0) > 0.0, "maxf: 0.0 is the larger zero"))
    out.push(test.equal_float(minf(2.0, -3.0), -3.0, 0.0, "minf"))
    out.push(test.equal_float(maxf(2.0, -3.0), 2.0, 0.0, "maxf"))
    out.push(test.is_true(!(clampf(nan, 0.0, 1.0) >= 0.0), "clampf keeps a NaN"))
    out.push(test.equal_float(clampf(-inf, 0.0, 1.0), 0.0, 0.0, "clampf(-inf)"))
    out.push(test.is_true(approx_eq(inf, inf, 0.5) && approx_eq(-inf, -inf, 0.0), "approx_eq of equal infinities"))
    out.push(test.is_false(approx_eq(inf, -inf, 0.5), "approx_eq of opposite infinities"))
    out.push(test.is_false(approx_eq(nan, nan, inf), "a NaN is near nothing"))
    out.push(test.is_true(divides(0, 0), "zero is a multiple of zero"))
    out.push(test.is_false(divides(5, 0), "and nothing else is"))
    out.push(test.is_true(divides(-9223372036854775807 - 1, -1), "divides(min_int, -1)"))

    // ---- strings ----
    out.push(test.is_true(contains("hello", "ell"), "contains"))
    out.push(test.is_true(starts_with("hello", "he"), "starts_with"))
    out.push(test.is_true(ends_with("hello", "lo"), "ends_with"))
    out.push(test.is_false(starts_with("he", "hello"), "starts_with a longer prefix"))
    out.push(test.equal_strs(split("a,b,c", ","), ["a", "b", "c"], "split"))
    out.push(test.equal_str(join(["a", "b"], "-"), "a-b", "join"))
    // `split` walks the string and `join` works in pairs, so the edges are
    // what each must still get right: a separator at either end, two in a
    // row, one that overlaps itself, one longer than the text, and an odd
    // count of pieces.
    out.push(test.equal_strs(split(",a,,b,", ","), ["", "a", "", "b", ""], "split at the ends"))
    out.push(test.equal_strs(split("aaa", "aa"), ["", "a"], "split takes the leftmost"))
    out.push(test.equal_strs(split("é日é日", "日"), ["é", "é", ""], "split by a character"))
    out.push(test.equal_strs(split("ab", "abc"), ["ab"], "split by a longer separator"))
    out.push(test.equal_strs(split("", ","), [""], "split of nothing"))
    out.push(test.equal_str(join([], "-"), "", "join of nothing"))
    out.push(test.equal_str(join(["a"], "-"), "a", "join of one"))
    out.push(test.equal_str(join(["a", "b", "c", "d", "e"], ", "), "a, b, c, d, e", "join of five"))
    out.push(test.equal_str(join(["", "", ""], ""), "", "join of empties"))
    out.push(test.equal_str(upper("héllo, World"), "HéLLO, WORLD", "upper"))
    out.push(test.equal_str(debug_str("a\"b\\c\nd"), "\"a\\\"b\\\\c\\nd\"", "debug_str"))
    out.push(test.equal_str(replace("banana", "na", "NA"), "baNANA", "replace"))
    out.push(test.equal_strs(words("  two  words  "), ["two", "words"], "words"))
    out.push(test.equal_strs(words("a\tb\nc\r\nd"), ["a", "b", "c", "d"], "tabs and newlines separate words"))
    out.push(test.equal_strs(words("x\u{a0}y\u{3000}z"), ["x", "y", "z"], "so do the Unicode spaces trim removes"))
    out.push(test.equal_strs(words(" \t\n"), [], "only whitespace is no words"))
    out.push(test.equal_strs(words("\u{85}a\u{2028}b\u{2009}\u{2009}c "), ["a", "b", "c"], "NEL, the line separator and a thin space"))
    out.push(test.equal_int("héllo日本".len(), 7, "len counts characters"))
    out.push(test.equal_str("  x  ".trim(), "x", "trim"))
    out.push(test.equal_int("hello".index_of("ll"), 2, "index_of"))
    out.push(test.equal_int("hello".index_of("z"), -1, "index_of misses"))
    out.push(test.equal_str("hello".slice(1, 3), "el", "slice"))
    out.push(test.equal_str("hello".slice(3, 99), "lo", "slice clamps"))

    // ---- more strings ----
    out.push(test.equal_str(repeat("ab", 3), "ababab", "repeat"))
    out.push(test.equal_str(repeat("ab", 1), "ab", "repeat once"))
    out.push(test.equal_str(repeat("ab", 0), "", "repeat none"))
    out.push(test.equal_str(repeat("ab", -2), "", "repeat a negative count"))
    out.push(test.equal_int(repeat("x", 1000).len(), 1000, "repeat is as long as the count says"))
    out.push(test.equal_str(trim_start(" \t a b \n"), "a b \n", "trim_start"))
    out.push(test.equal_str(trim_end(" \t a b \n"), " \t a b", "trim_end"))
    out.push(test.equal_str(trim_start("   "), "", "trim_start of only spaces"))
    out.push(test.equal_str(trim_end("   "), "", "trim_end of only spaces"))
    out.push(test.equal_str(trim_end(""), "", "trim_end of nothing"))
    out.push(test.equal_str(pad_end("ab", 5, "."), "ab...", "pad_end"))
    out.push(test.equal_str(pad_end("7", 4, "ab"), "7aba", "pad_end cuts the filler"))
    out.push(test.equal_str(pad_end("abcd", 2, "."), "abcd", "pad_end leaves longer text"))
    out.push(test.equal_str(pad_end("a", 3, ""), "a", "pad_end with no filler"))
    out.push(test.equal_strs(lines("a\nb\r\nc\rd"), ["a", "b", "c", "d"], "lines: the three endings"))
    out.push(test.equal_strs(lines("a\n"), ["a"], "lines: a final ending starts no line"))
    out.push(test.equal_strs(lines("a\n\nb"), ["a", "", "b"], "lines: an empty line is kept"))
    out.push(test.equal_strs(lines("a\r\n\r\nb"), ["a", "", "b"], "lines: CRLF is one ending"))
    out.push(test.equal_strs(lines("\n"), [""], "lines: a lone ending is one empty line"))
    out.push(test.equal_int(lines("").len(), 0, "lines: nothing is no lines"))
    out.push(test.equal_strs(lines("\r\r"), ["", ""], "lines: two lone CRs are two lines"))
    out.push(test.equal_strs(lines("a\n\n"), ["a", ""], "lines: only the final ending is dropped"))
    out.push(test.equal_str(or_else(strip_prefix("--name", "--"), "?"), "name", "strip_prefix"))
    out.push(test.equal_str(or_else(strip_prefix("--", "--"), "?"), "", "strip_prefix of all of it"))
    out.push(test.is_true(strip_prefix("name", "--") == nil, "strip_prefix absent"))
    out.push(test.equal_str(or_else(strip_suffix("a.kite", ".kite"), "?"), "a", "strip_suffix"))
    out.push(test.is_true(strip_suffix("kite", "a.kite") == nil, "strip_suffix longer than the text"))
    out.push(test.is_true(strip_suffix("a.kit", ".kite") == nil, "strip_suffix absent"))
    let pair = split_once("k=a=b", "=")
    out.push(test.is_true(pair != nil, "split_once finds it"))
    if pair != nil {
        let (before, after) = pair
        out.push(test.equal_str(before, "k", "split_once before"))
        out.push(test.equal_str(after, "a=b", "split_once after, at the first"))
    }
    let edge = split_once("a::", "::")
    if edge != nil {
        let (before, after) = edge
        out.push(test.is_true(before == "a" && after == "", "split_once at the end"))
    } else {
        out.push(test.is_true(false, "split_once at the end finds it"))
    }
    out.push(test.is_true(split_once("abc", "=") == nil, "split_once absent"))
    out.push(test.is_true(split_once("abc", "") == nil, "split_once of nothing"))
    out.push(test.equal_int(index_of_from("abcabc", "b", 2), 4, "index_of_from"))
    out.push(test.equal_int(index_of_from("abcabc", "b", 1), 1, "index_of_from at the place"))
    out.push(test.equal_int(index_of_from("abcabc", "b", -5), 1, "index_of_from clamps below"))
    out.push(test.equal_int(index_of_from("abc", "b", 99), -1, "index_of_from clamps above"))
    out.push(test.equal_int(index_of_from("abc", "", 99), 3, "index_of_from: nothing is at the end"))
    out.push(test.equal_int(last_index_of("a/b/c", "/"), 3, "last_index_of"))
    out.push(test.equal_int(last_index_of("abab", "ab"), 2, "last_index_of a longer needle"))
    out.push(test.equal_int(last_index_of("abc", "x"), -1, "last_index_of absent"))
    out.push(test.equal_int(last_index_of("ab", "abc"), -1, "last_index_of a needle longer than the text"))
    out.push(test.equal_int(last_index_of("abc", ""), 3, "last_index_of nothing"))
    out.push(test.equal_int(last_index_of("aaa", "aa"), 1, "last_index_of an overlapping one"))
    out.push(test.equal_int(last_index_of("abaaba", "aba"), 3, "last_index_of the later of two that overlap"))
    out.push(test.equal_int(last_index_of("xaaaay", "aa"), 3, "last_index_of in a run"))
    out.push(test.equal_int(last_index_of(repeat("ab", 50) + "c", "ab"), 98, "last_index_of in a long text"))
    out.push(test.equal_int(pad_start("x", 100000, "0").len(), 100000, "a wide pad, in linear time"))
    out.push(test.equal_ints(codes("aé日"), [97, 233, 26085], "codes"))
    out.push(test.equal_str(from_codes([104, 233, 26085]), "hé日", "from_codes"))
    out.push(test.equal_str(from_codes(codes("round trip")), "round trip", "codes and from_codes"))
    out.push(test.equal_strs(chars("aé日"), ["a", "é", "日"], "chars"))
    out.push(test.is_true(parse_bool("true") == true && parse_bool("false") == false, "parse_bool"))
    out.push(test.is_true(parse_bool("True") == nil && parse_bool(" true") == nil && parse_bool("") == nil, "parse_bool is exact"))
    out.push(test.equal_int(or_else(parse_int_radix("ff", 16), -1), 255, "parse_int_radix hex"))
    out.push(test.equal_int(or_else(parse_int_radix("FF", 16), -1), 255, "in either case"))
    out.push(test.equal_int(or_else(parse_int_radix("-101", 2), 0), -5, "parse_int_radix binary"))
    out.push(test.equal_int(or_else(parse_int_radix("zz", 36), -1), 1295, "base 36"))
    out.push(test.equal_int(or_else(parse_int_radix("17", 10), -1), 17, "base 10 agrees with parse_int"))
    out.push(test.is_true(parse_int_radix("12", 2) == nil, "a digit past the base"))
    out.push(test.is_true(parse_int_radix("", 10) == nil && parse_int_radix("-", 10) == nil, "no digits"))
    out.push(test.is_true(parse_int_radix("1", 1) == nil && parse_int_radix("1", 37) == nil, "a base out of range"))
    out.push(test.is_true(parse_int_radix("0x1f", 16) == nil && parse_int_radix("1 ", 10) == nil, "nothing but digits"))
    out.push(test.equal_int(or_else(parse_int_radix("7fffffffffffffff", 16), -1), 9223372036854775807, "the largest int"))
    out.push(test.equal_int(or_else(parse_int_radix("-8000000000000000", 16), 0), -9223372036854775807 - 1, "the smallest int"))
    out.push(test.is_true(parse_int_radix("8000000000000000", 16) == nil, "one past the largest"))
    out.push(test.is_true(parse_int_radix("-8000000000000001", 16) == nil, "one past the smallest"))

    // ---- more slices ----
    out.push(test.equal_ints(range(2, 5), [2, 3, 4], "range"))
    out.push(test.equal_int(range(5, 5).len() + range(5, 2).len(), 0, "range can be empty"))
    out.push(test.equal_ints(map(range(0, 3), |n: int| n * n), [0, 1, 4], "range feeds map"))
    out.push(test.equal_ints(filled(7, 3), [7, 7, 7], "filled"))
    out.push(test.equal_int(filled("x", 0).len() + filled("x", -1).len(), 0, "filled none"))
    let (even, odd) = partition([1, 2, 3, 4, 5], |n: int| n % 2 == 0)
    out.push(test.equal_ints(even, [2, 4], "partition accepted"))
    out.push(test.equal_ints(odd, [1, 3, 5], "partition rest"))
    out.push(test.equal_ints(take_while([1, 2, 5, 1], |n: int| n < 3), [1, 2], "take_while"))
    out.push(test.equal_ints(drop_while([1, 2, 5, 1], |n: int| n < 3), [5, 1], "drop_while"))
    out.push(test.equal_int(take_while([5, 1], |n: int| n < 3).len(), 0, "take_while none"))
    out.push(test.equal_int(drop_while([1, 2], |n: int| n < 3).len(), 0, "drop_while all"))
    out.push(test.equal_int(windows([1, 2, 3, 4], 2).len(), 3, "windows"))
    out.push(test.equal_ints(windows([1, 2, 3, 4], 3)[1], [2, 3, 4], "a window"))
    out.push(test.equal_int(windows([1, 2, 3], 3).len(), 1, "a window the whole length"))
    out.push(test.equal_int(windows([1, 2], 3).len() + windows([1, 2], 0).len(), 0, "windows too big or empty"))
    out.push(test.equal_ints(flat_map([1, 2], |n: int| [n, n * 10]), [1, 10, 2, 20], "flat_map"))
    out.push(test.equal_int(index_of([5, 6, 7, 6], 6), 1, "index_of the first"))
    out.push(test.equal_int(index_of(["a"], "b"), -1, "index_of absent"))
    out.push(test.equal_int(product([2, 3, 4]), 24, "product"))
    out.push(test.equal_int(product([]), 1, "product of none"))
    out.push(test.is_true(min_of([3, -1, 2]) == -1 && max_of([3, -1, 2]) == 3, "min_of and max_of"))
    out.push(test.is_true(min_of([]) == nil && max_of([]) == nil, "min_of and max_of of none"))
    out.push(test.equal_str(join_ints([1, -2, 3], ","), "1,-2,3", "join_ints"))
    out.push(test.equal_str(join_ints([], ","), "", "join_ints of none"))
    out.push(test.equal_str(join_floats([1.5, 2.0], " "), "1.5 2.0", "join_floats"))

    // ---- maps ----
    let ages = { "ada": 36, "bob": 0 }
    out.push(test.equal_int(get_or(ages, "ada", -1), 36, "get_or present"))
    out.push(test.equal_int(get_or(ages, "eve", -1), -1, "get_or absent"))
    out.push(test.equal_int(get_or(ages, "bob", -1), 0, "get_or a zero is present"))
    out.push(test.is_true(has_key(ages, "bob") && !has_key(ages, "eve"), "has_key"))
    let both = merged({ "a": 1, "b": 2 }, { "b": 3, "c": 4 })
    out.push(test.equal_int(both.len(), 3, "merged size"))
    out.push(test.equal_int(get_or(both, "b", -1), 3, "merged: the right wins"))
    out.push(test.equal_str(join(both.keys(), ""), "abc", "merged keeps the order"))
    out.push(test.equal_int(merged({ "a": 1 }, { "b": 2 }).len() + ages.len(), 4, "merged leaves its arguments"))
    let listed = entries({ "a": 1, "b": 2 })
    out.push(test.is_true(listed.len() == 2 && listed[0].0 == "a" && listed[1].1 == 2, "entries"))

    return out
}

fn main() {
    var failed = 0
    for e in checks() {
        if e != nil {
            io.print("FAILED \(e.message())")
            failed += 1
        }
    }
    io.print("prelude: \(checks().len() - failed) passed, \(failed) failed")
}
