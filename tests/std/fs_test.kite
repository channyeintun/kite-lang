// std/fs — files, and what happens when they are not there.
//
// The test writes into the system temporary directory and removes what it
// wrote. It asserts about failures as much as successes: a filesystem module
// whose error path is untested is a filesystem module whose error path is
// wrong, and "no such file" is the most common thing it will ever have to say.

use std/test
use std/fs
use std/text

/// Asked of the host rather than hard-coded. `/tmp` is a POSIX convention and
/// not a fact — Windows has no such directory, and a test that assumes one
/// passes on two platforms and fails on the third, which is what this one did.
fn scratch() -> str {
    return "\(fs.temp_dir())/kite-fs-test-file.txt"
}

fn scratch_name() -> str {
    return "kite-fs-test-file.txt"
}

fn round_trip_checks() -> [error] {
    var out: [error] = []
    let path = scratch()
    let body = "hello from kite\nsecond line\n"

    let write_err = fs.write(path, body)
    out.push(test.ok(write_err, "a file is written"))
    if write_err != nil {
        return out
    }
    out.push(test.equal_bool(fs.exists(path), true, "and then exists"))
    out.push(test.equal_bool(fs.is_file(path), true, "as a file"))
    out.push(test.equal_bool(fs.is_dir(path), false, "and not a directory"))

    let (read_back, read_err) = fs.read(path)
    out.push(test.ok(read_err, "and reads back"))
    if read_err != nil {
        return out
    }
    out.push(test.equal_str(read_back, body, "byte for byte"))

    // Writing again replaces rather than appends.
    let again_err = fs.write(path, "short")
    out.push(test.ok(again_err, "a second write succeeds"))
    if again_err != nil {
        return out
    }
    let (second, second_err) = fs.read(path)
    out.push(test.ok(second_err, "and reads back"))
    if second_err != nil {
        return out
    }
    out.push(test.equal_str(second, "short", "replacing what was there"))

    let remove_err = fs.remove(path)
    out.push(test.ok(remove_err, "and is removed"))
    out.push(test.equal_bool(fs.exists(path), false, "and is gone"))
    return out
}

/// A file may begin with any character, including the ones the host uses to
/// mark its answers. With only a failure mark, a file starting with U+0001
/// read back as an error whose message was the rest of the file.
fn mark_checks() -> [error] {
    var out: [error] = []
    let path = scratch()
    for code in [1, 2] {
        let body = "\(text.from_code(code))rest of the file"
        let write_err = fs.write(path, body)
        out.push(test.ok(write_err, "a file starting with U+000\(code) is written"))
        if write_err != nil {
            return out
        }
        let (read_back, read_err) = fs.read(path)
        out.push(test.ok(read_err, "and reads back without an error"))
        if read_err != nil {
            return out
        }
        out.push(test.equal_str(read_back, body, "with its first character intact"))
    }
    _ = fs.remove(path)
    return out
}

fn listing_checks() -> [error] {
    var out: [error] = []
    let path = scratch()
    let write_err = fs.write(path, "x")
    out.push(test.ok(write_err, "a file to find"))
    if write_err != nil {
        return out
    }
    let (names, list_err) = fs.list(fs.temp_dir())
    out.push(test.ok(list_err, "a directory lists"))
    if list_err != nil {
        return out
    }
    var found = false
    for name in names {
        if name == scratch_name() {
            found = true
        }
    }
    out.push(test.is_true(found, "and the file is in it"))
    // Neither `.` nor `..` is ever a name in the listing.
    var dots = false
    for name in names {
        if name == "." || name == ".." {
            dots = true
        }
    }
    out.push(test.is_false(dots, "and `.` and `..` are not"))
    out.push(test.ok(fs.remove(path), "tidied up"))

    // A name with a line break in it came back as two names, one on each side
    // of the break, because the host separates names with one.
    let odd = "\(fs.temp_dir())/kite-fs-test-two\nlines.txt"
    let odd_err = fs.write(odd, "x")
    out.push(test.ok(odd_err, "a file whose name has a line break"))
    if odd_err != nil {
        return out
    }
    let (with_odd, odd_list_err) = fs.list(fs.temp_dir())
    out.push(test.ok(odd_list_err, "lists"))
    if odd_list_err != nil {
        return out
    }
    var whole = 0
    var halves = 0
    for name in with_odd {
        if name == "kite-fs-test-two\nlines.txt" {
            whole += 1
        }
        if name == "kite-fs-test-two" || name == "lines.txt" {
            halves += 1
        }
    }
    out.push(test.equal_int(whole, 1, "as one name"))
    out.push(test.equal_int(halves, 0, "and not as two"))
    out.push(test.ok(fs.remove(odd), "tidied up again"))
    return out
}

fn failure_checks() -> [error] {
    var out: [error] = []

    let (_, missing) = fs.read("\(fs.temp_dir())/kite-no-such-dir")
    out.push(test.failed(missing, "reading a missing file is an error"))

    let write_err = fs.write("\(fs.temp_dir())/kite-no-such-dir/file.txt", "x")
    out.push(test.failed(write_err, "writing into a missing directory is an error"))

    let (_, not_a_dir) = fs.list("\(fs.temp_dir())/kite-no-such-dir")
    out.push(test.failed(not_a_dir, "listing a missing directory is an error"))

    let remove_err = fs.remove("\(fs.temp_dir())/kite-no-such-dir")
    out.push(test.failed(remove_err, "removing what is not there is an error"))

    out.push(test.equal_bool(fs.exists("\(fs.temp_dir())/kite-no-such-thing"), false, "a missing path does not exist"))
    out.push(test.equal_bool(fs.is_file(fs.temp_dir()), false, "a directory is not a file"))
    out.push(test.equal_bool(fs.is_dir(fs.temp_dir()), true, "and is a directory"))
    return out
}

fn helper_checks() -> [error] {
    var out: [error] = []
    let path = "\(fs.temp_dir())/kite-fs-test-helpers.txt"
    let other = "\(fs.temp_dir())/kite-fs-test-helpers-copy.txt"

    // ---- lines ----
    out.push(test.ok(fs.write(path, "a\r\n\nb\nlast"), "a file with every kind of line"))
    let (mixed, lines_err) = fs.read_lines(path)
    out.push(test.ok(lines_err, "read_lines"))
    if lines_err != nil {
        return out
    }
    out.push(test.equal_strs(mixed, ["a", "", "b", "last"], "splits on \\n, drops \\r, keeps an empty line, takes a last line with no end"))
    out.push(test.ok(fs.write(path, "x\ny\n"), "a file ending in a newline"))
    let (two, two_err) = fs.read_lines(path)
    out.push(test.ok(two_err, "read_lines again"))
    if two_err != nil {
        return out
    }
    out.push(test.equal_strs(two, ["x", "y"], "has no empty last line"))
    // What ends a line is the prelude's `lines` rule, a lone `\r` included.
    for body in ["a\rb", "a\r\r\nb", "x\r", "\r", "a\n\rb\r\n"] {
        out.push(test.ok(fs.write(path, body), "a file with odd endings"))
        let (odd, odd_err) = fs.read_lines(path)
        out.push(test.ok(odd_err, "read_lines of it"))
        if odd_err == nil {
            out.push(test.equal_strs(odd, lines(body), "read_lines is lines of the text"))
        }
    }
    out.push(test.ok(fs.write(path, ""), "an empty file"))
    let (none, none_err) = fs.read_lines(path)
    out.push(test.ok(none_err, "read_lines of it"))
    if none_err != nil {
        return out
    }
    out.push(test.equal_strs(none, [], "has no lines"))
    out.push(test.ok(fs.write_lines(path, ["one", "", "three"]), "write_lines"))
    let (written, written_err) = fs.read(path)
    out.push(test.ok(written_err, "reads back"))
    if written_err != nil {
        return out
    }
    out.push(test.equal_str(written, "one\n\nthree\n", "each line ends with a newline"))
    let (_, missing_lines) = fs.read_lines("\(fs.temp_dir())/kite-no-such-dir/x")
    out.push(test.failed(missing_lines, "read_lines of a missing file is an error"))

    // ---- append, copy, read_or ----
    _ = fs.remove(path)
    out.push(test.ok(fs.append(path, "first\n"), "append creates a file"))
    out.push(test.ok(fs.append(path, "second\n"), "and adds to it"))
    out.push(test.equal_str(fs.read_or(path, "?"), "first\nsecond\n", "both are there"))
    out.push(test.failed(fs.append(fs.temp_dir(), "x"), "append to a directory is an error"))
    out.push(test.ok(fs.copy(path, other), "copy"))
    out.push(test.equal_str(fs.read_or(other, "?"), "first\nsecond\n", "is a copy"))
    out.push(test.failed(fs.copy("\(fs.temp_dir())/kite-no-such-file", other), "copy of a missing file is an error"))
    out.push(test.equal_str(fs.read_or(other, "?"), "first\nsecond\n", "which leaves the target alone"))
    out.push(test.equal_str(fs.read_or("\(fs.temp_dir())/kite-no-such-file", "fallback"), "fallback", "read_or falls back"))
    out.push(test.equal_str(fs.read_or(fs.temp_dir(), "fallback"), "fallback", "also for a directory"))
    _ = fs.remove(path)
    _ = fs.remove(other)

    // ---- paths ----
    out.push(test.equal_str(fs.join_path(["a", "b", "c.txt"]), "a/b/c.txt", "join_path"))
    out.push(test.equal_str(fs.join_path(["a/", "/b"]), "a/b", "does not double a slash"))
    out.push(test.equal_str(fs.join_path(["a//", "//b"]), "a/b", "or several"))
    out.push(test.equal_str(fs.join_path(["/", "etc"]), "/etc", "keeps the root"))
    out.push(test.equal_str(fs.join_path(["/a", "b"]), "/a/b", "and an absolute first part"))
    out.push(test.equal_str(fs.join_path(["", "a", "", "b"]), "a/b", "skips empty parts"))
    out.push(test.equal_str(fs.join_path([]), "", "of nothing is nothing"))
    out.push(test.equal_str(fs.join_path(["a"]), "a", "of one is itself"))
    out.push(test.equal_str(fs.base_name("a/b/c.txt"), "c.txt", "base_name"))
    out.push(test.equal_str(fs.base_name("c.txt"), "c.txt", "of a bare name"))
    out.push(test.equal_str(fs.base_name("a/b/"), "b", "ignores a trailing slash"))
    out.push(test.equal_str(fs.base_name("a/b//"), "b", "or several"))
    out.push(test.equal_str(fs.base_name("/"), "/", "of the root"))
    out.push(test.equal_str(fs.base_name("/a"), "a", "of a top-level name"))
    out.push(test.equal_str(fs.base_name(""), "", "of nothing"))
    out.push(test.equal_str(fs.dir_name("a/b/c.txt"), "a/b", "dir_name"))
    out.push(test.equal_str(fs.dir_name("c.txt"), ".", "of a bare name"))
    out.push(test.equal_str(fs.dir_name("/c.txt"), "/", "of a top-level name"))
    out.push(test.equal_str(fs.dir_name("/"), "/", "of the root"))
    out.push(test.equal_str(fs.dir_name("a/b/"), "a", "ignores a trailing slash"))
    out.push(test.equal_str(fs.dir_name("a//b"), "a", "and a doubled one"))
    out.push(test.equal_str(fs.dir_name(""), ".", "of nothing"))
    out.push(test.equal_str(fs.extension("notes.txt"), "txt", "extension"))
    out.push(test.equal_str(fs.extension("a/b.d/notes.tar.gz"), "gz", "is the last, of the last part"))
    out.push(test.equal_str(fs.extension("a.d/notes"), "", "a dot in a directory is not one"))
    out.push(test.equal_str(fs.extension(".bashrc"), "", "a dotfile has none"))
    out.push(test.equal_str(fs.extension("name."), "", "nor does a trailing dot"))
    out.push(test.equal_str(fs.extension("a/b/"), "", "nor a directory with no dot"))

    // ---- walk ----
    let (_, walk_missing) = fs.walk("\(fs.temp_dir())/kite-no-such-dir")
    out.push(test.failed(walk_missing, "walking a missing directory is an error"))
    let (_, walk_file) = fs.walk("\(fs.temp_dir())/kite-fs-test-walk-file.txt")
    out.push(test.failed(walk_file, "walking what is not a directory is an error"))
    // Run from the repository root, where `tests/std` is: a real tree to walk.
    if fs.is_dir("tests/std") {
        let (found, walk_err) = fs.walk("tests/std")
        out.push(test.ok(walk_err, "walk of a tree"))
        if walk_err != nil {
            return out
        }
        out.push(test.is_true(index_of(found, "tests/std/fs_test.kite") >= 0, "finds a file below"))
        out.push(test.is_true(found == sorted(found, |a: str, b: str| a < b), "sorted"))
        out.push(test.is_false(index_of(found, "tests/std") >= 0, "and lists no directory"))
    }
    return out
}

fn main() {
    var results: [error] = []
    results = concat(results, round_trip_checks())
    results = concat(results, mark_checks())
    results = concat(results, listing_checks())
    results = concat(results, failure_checks())
    results = concat(results, helper_checks())
    var failed = 0
    for e in results {
        if e != nil {
            io.print("FAILED \(e.message())")
            failed += 1
        }
    }
    io.print("fs: \(results.len() - failed) passed, \(failed) failed")
}
