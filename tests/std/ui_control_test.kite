// What a control states about itself, and what is derived from it.
//
// The tree is where a control's identity, meaning, edit state and focus live;
// the frames are where its position lives. These are the rules that keep the
// two from disagreeing.

use std/test
use std/ui

enum Msg {
    Add
    Toggle(int)
}

/// A header with a field and a button, and two rows — the shape of every
/// application in the examples directory, small enough to assert about.
fn tree(focused: Option<str>, third_off: bool) -> ui.Node<Msg> {
    var third: ui.Node<Msg> = ui.means(
        ui.text_of("third", ui.sized(ui.style(), 80.0, 20.0), "third"),
        "third",
        Msg.Toggle(3),
    )
    if third_off {
        third = ui.disabled(third)
    }
    let whole: ui.Node<Msg> = ui.box_of(
        "app",
        ui.column(),
        [
            ui.editable(
                ui.text_of("draft", ui.sized(ui.style(), 80.0, 20.0), "milk"),
                "draft",
                "milk",
            ),
            ui.means(
                ui.text_of("add", ui.sized(ui.style(), 80.0, 20.0), "Add"),
                "add",
                Msg.Add,
            ),
            third,
        ],
    )
    return ui.with_focus(whole, focused)
}

fn frames(node: ui.Node<Msg>) -> [ui.Frame] {
    return ui.layout(node, ui.Size{ width: 200.0, height: 200.0 })
}

fn said(node: ui.Node<Msg>, id: str) -> str {
    let found = ui.control_of(node, id)
    if found == nil {
        return "no such control"
    }
    let msg = found.msg
    if msg == nil {
        return "says nothing"
    }
    return match msg {
        Add => "Add",
        Toggle(at) => "Toggle(\(at))",
    }
}

fn checks() -> [error] {
    var out: [error] = []
    let t = tree("add", false)

    // ---- a control says what it was built saying ----
    out.push(test.equal_str(said(t, "add"), "Add", "a button carries its message"))
    out.push(test.equal_str(said(t, "third"), "Toggle(3)", "a payload survives the tree"))
    out.push(test.equal_str(said(t, "draft"), "says nothing", "an editable control is not an action"))
    out.push(test.equal_str(said(t, "absent"), "no such control", "an id nothing claims"))

    // ---- setters compose rather than reset ----
    let both: ui.Node<Msg> = ui.means(
        ui.editable(ui.text_of("f", ui.style(), "x"), "f", "x"),
        "f",
        Msg.Add,
    )
    let f = ui.control_of(both, "f")
    out.push(test.is_true(f != nil, "the control survives both setters"))
    if f != nil {
        out.push(test.is_true(f.edits != nil, "a meaning does not discard the edit state"))
        out.push(test.is_true(f.msg != nil, "and the meaning is there too"))
    }

    // ---- exactly one control is focused, whatever the tree said before ----
    let a = ui.control_of(t, "add")
    let d = ui.control_of(t, "draft")
    // Narrowing works on one local through one `if`, not through `&&`.
    if a != nil {
        out.push(test.equal_bool(a.focused, true, "with_focus focuses the named control"))
    }
    if d != nil {
        out.push(test.equal_bool(d.focused, false, "and unfocuses every other"))
    }
    let none = tree(nil, false)
    let a2 = ui.control_of(none, "add")
    if a2 != nil {
        out.push(test.equal_bool(a2.focused, false, "nil focuses nothing"))
    }
    // Focus moving is a fresh walk, not an edit: the old holder is cleared by
    // the same pass that sets the new one, so two can never both claim it.
    let moved = ui.with_focus(t, "draft")
    let a3 = ui.control_of(moved, "add")
    let d3 = ui.control_of(moved, "draft")
    if a3 != nil {
        out.push(test.equal_bool(a3.focused, false, "the previous holder lets go"))
    }
    if d3 != nil {
        out.push(test.equal_bool(d3.focused, true, "and the new one takes it"))
    }

    // ---- what a point activates ----
    let live = frames(t)
    let at_add = ui.msg_at(t, live, 40.0, 30.0)
    out.push(test.is_true(at_add != nil, "a click on a button activates it"))
    out.push(test.is_true(ui.msg_at(t, live, 40.0, 10.0) == nil, "a click on the field does not"))
    out.push(test.is_true(ui.msg_at(t, live, 190.0, 190.0) == nil, "nor does a click on nothing"))

    // ---- disabled: laid out and hit-tested, but unreachable and inert ----
    let off = tree("add", true)
    let off_frames = frames(off)
    out.push(test.equal_strs(
        ui.focus_order(live),
        ["draft", "add", "third"],
        "every enabled control is in focus order",
    ))
    out.push(test.equal_strs(
        ui.focus_order(off_frames),
        ["draft", "add"],
        "a disabled control leaves focus order",
    ))
    out.push(test.equal_int(
        off_frames.len(),
        live.len(),
        "and is still laid out — disabling changes no geometry",
    ))
    out.push(test.is_true(
        ui.control_at(off_frames, 40.0, 50.0) != nil,
        "the pointer still knows what it is over",
    ))
    out.push(test.is_true(
        ui.msg_at(off, off_frames, 40.0, 50.0) == nil,
        "but activating it says nothing",
    ))

    // ---- a tree with no controls ----
    let quiet: ui.Node<ui.Silent> = ui.box_of("plain", ui.column(), [])
    out.push(test.is_true(
        ui.control_of(quiet, "anything") == nil,
        "a Silent tree holds no controls to find",
    ))

    return out
}

fn main() {
    var failed = 0
    for e in checks() {
        if e != nil {
            io.print("FAILED \(e.message())")
            failed += 1
        }
    }
    io.print("ui controls: \(checks().len() - failed) passed, \(failed) failed")
}
