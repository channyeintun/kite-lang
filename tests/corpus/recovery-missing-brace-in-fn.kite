// A missing `}` is one error, reported at the `{` that lost it.
//
// The parser finds out at `fn b`, which cannot be inside a block, so the block
// must have ended before it. By then the `}` after `return 0` has closed the
// `if` — but it is indented to close the function, and the first `}` whose
// indentation disagrees with its `{` is where the missing one was. Everything
// after is read as the declarations it is: this was eight errors, every line
// of `b` and `main` read as a statement of `a`.

fn a(x: int) -> int {
    if x > 0 { //~ ERROR E0101
        return 1
    return 0
}

fn b() -> int {
    return 2
}

fn main() {
    io.print(a(1) + b())
}
