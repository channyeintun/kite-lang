// An annotation naming a type nothing declares is one error. The empty
// literal it was given has no type to take, but that is the same mistake,
// and saying "cannot infer the element type" too would report it twice.

fn main() {
    let xs: Vec<int> = [] //~ ERROR E0204
    let m: Table<str, int> = { } //~ ERROR E0204
    let n: Nope = nil //~ ERROR E0204
    io.print("\(xs.len()) \(m.len())")
}
