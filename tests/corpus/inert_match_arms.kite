// An arm of a `match` statement is in statement position, as the match is:
// its value is thrown away. So an arm that does nothing is E0117, as the
// same line on its own or under an `if` is, and a `match` or `if` written as
// an arm is a statement too, whose branches need not agree in type.
use std/errors

fn count() -> int {
    return 3
}

fn fails() -> error {
    return errors.new("no")
}

fn main() {
    var done = false
    let n = 0
    match n {
        0 => 1, //~ ERROR E0117
        1 => n + 1, //~ ERROR E0117
        2 => {
            done == true //~ ERROR E0117
        },
        3 => || count(), //~ ERROR E0117
        _ => io.print("other"),
    }
    // A match or an `if` as an arm discards its value as well.
    match n {
        0 => match n {
            0 => io.print("nested"),
            1 => 2, //~ ERROR E0117
            2 => fails(), //~ ERROR E0302
            _ => count(),
        },
        1 => if done {
            io.print("t")
        } else {
            count()
        },
        _ => count(),
    }
    // Something happening is left alone, and an arm's error is dropped once.
    // `()` says that nothing happens, as `{ }` does.
    match n {
        0 => count() + 1,
        3 => (),
        1 => {
            count()
        },
        2 => fails(), //~ ERROR E0302
        _ => { },
    }
    io.print(done)
}
