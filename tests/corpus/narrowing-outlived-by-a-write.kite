// A write replaces the value every earlier test was about. `x != nil` said
// nothing about what `x = nil` put there, and neither did a test above a loop
// that ends by writing `x`.

fn fails() -> error {
    return errors.new("boom")
}

fn after_a_write() {
    var x: Option<int> = 5
    if x != nil {
        x = nil
        io.print("\(x + 1)") //~ ERROR E0201
    }
}

fn across_a_back_edge() {
    var x: Option<int> = 5
    if x == nil {
        return
    }
    for i in 0..3 {
        io.print("\(x + 1)") //~ ERROR E0201
        x = nil
    }
}

// A write that cannot store a nil keeps the narrowing, in a loop as in
// straight-line code. The loop used to drop it for every local it wrote.
fn kept_across_a_back_edge() {
    var x: Option<int> = 5
    if x == nil {
        return
    }
    for i in 0..3 {
        io.print("\(x + 1)")
        x = i
    }
}

// `x = z` keeps `x` present only while `z` is, and the loop's `z = nil` ends
// that on the next pass.
fn lost_through_another() {
    var x: Option<int> = 5
    var z: Option<int> = 6
    if x == nil || z == nil {
        return
    }
    for i in 0..3 {
        io.print("\(x + 1)") //~ ERROR E0201
        x = z
        z = nil
    }
}

fn in_one_branch() {
    var x: Option<int> = 5
    if x == nil {
        return
    }
    if x == 7 {
        x = nil
    }
    io.print("\(x + 1)") //~ ERROR E0201
}

fn an_error_too() {
    var e = fails()
    if e != nil {
        e = nil
        io.print(e.message()) //~ ERROR E0301
    }
}

fn main() {
    after_a_write()
    across_a_back_edge()
    kept_across_a_back_edge()
    lost_through_another()
    in_one_branch()
    an_error_too()
}
