// `as` is an operator, so a constant may cast between `int` and `float`; a
// cast to anything else is refused as it is in a body, with the same code.

let HALF = 1 as float / 2.0
let TEXT = "7" as int //~ ERROR E0212
let WORD = 7 as str //~ ERROR E0212

fn main() {
    io.print("\(HALF)\(TEXT)\(WORD)")
}
