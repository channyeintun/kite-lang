// Testing an optional result against `nil` asks whether the failure is
// there, not what it is. Where it is nil there is nothing to look at; where
// it is present, the error the finished task gave is still unread and has to
// be checked. `if r == nil { return }` alone used to count as reading it.

use std/task

async fn save() -> error {
    return errors.new("disk full")
}

async fn load() -> (int, error) {
    return 1, nil
}

async fn only_nil_tested() {
    let r = await task.timeout(save(), 100) //~ ERROR E0302
    if r == nil {
        io.print("timed out")
        return
    }
    io.print("saved")
}

async fn present_and_unread() {
    let r = await task.timeout(save(), 100) //~ ERROR E0302
    if r != nil {
        io.print("finished")
    }
}

async fn kept_as_a_flag() {
    let r = await task.timeout(save(), 100) //~ ERROR E0302
    let late = r == nil
    io.print(late)
}

async fn matched_against_nil_and_dropped() {
    let r = await task.timeout(save(), 100) //~ ERROR E0302
    match r {
        nil => io.print("late"),
        _ => io.print("done"),
    }
}

// Once narrowed, `r` is the error itself, and testing it inspects it.
async fn the_error_tested_too() {
    let r = await task.timeout(save(), 100)
    if r == nil {
        io.print("timed out")
        return
    }
    if r != nil {
        io.print(r.message())
    }
}

async fn the_pair_taken_apart() {
    let r = await task.timeout(load(), 100)
    if r == nil {
        return
    }
    let (n, err) = r
    if err != nil {
        return
    }
    io.print(n)
}

async fn matched_and_tested() {
    let r = await task.timeout(save(), 100)
    match r {
        nil => io.print("late"),
        e => {
            if e != nil {
                io.print(e.message())
            }
        }
    }
}

// Where a condition proves the result nil there is no failure to look at,
// whether the test stands alone, is one side of `&&`, or is a guard.
async fn nil_on_one_side_of_and(late: bool) {
    let r = await task.timeout(save(), 100)
    if r == nil && late {
        return
    }
    if r != nil {
        if r != nil {
            io.print(r.message())
        }
    }
}

async fn nil_in_a_guard() {
    let r = await task.timeout(save(), 100)
    match 0 {
        _ if r == nil => io.print("late"),
        _ => {
            if r != nil {
                if r != nil {
                    io.print(r.message())
                }
            }
        },
    }
}

// `||` that held proves neither side: the result may be there, unread.
async fn nil_on_one_side_of_or(late: bool) {
    let r = await task.timeout(save(), 100)
    if r == nil || late {
        return //~ ERROR E0302
    }
    if r != nil {
        io.print(r.message())
    }
}

async fn main() {
    await only_nil_tested()
    await present_and_unread()
    await kept_as_a_flag()
    await matched_against_nil_and_dropped()
    await the_error_tested_too()
    await the_pair_taken_apart()
    await matched_and_tested()
    await nil_on_one_side_of_and(true)
    await nil_in_a_guard()
    await nil_on_one_side_of_or(true)
}
