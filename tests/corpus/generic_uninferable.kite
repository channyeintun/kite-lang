// Type arguments are worked out from the arguments passed. A parameter that
// appears in no parameter type has nothing to infer from, and Kite has no
// turbofish to supply it by hand.

fn make<T>() -> Option<T> {
  return nil
}

fn main() {
  let x = make() //~ ERROR E0209
  io.print(if x == nil { 0 } else { 1 })
}
