// An alias is the type it names (§3.4), in an `impl` header as anywhere. A
// header naming one was taken as a type of its own that nothing could reach:
// the block was dropped in silence, and a call to its method was "no such
// method". An alias of one instantiation of a generic type is that
// instantiation written out, and refused as it is (E0208); one of anything
// but a struct or an enum is not a type an `impl` is for.

trait Named {
    fn name(self) -> str
}

struct Pair<A, B> {
    a: A
    b: B
}

type IntStr = Pair<int, str>

impl Named for IntStr { //~ ERROR E0208
    fn name(self) -> str {
        return "int-str"
    }
}

type Id = int

impl Named for Id { //~ ERROR E0204
    fn name(self) -> str {
        return "id"
    }
}

struct Point {
    x: int
}

type Pt = Point

impl Named for Pt {
    fn name(self) -> str {
        return "pt \(self.x)"
    }
}

fn main() {
    io.print(Point{ x: 1 }.name())
    io.print(Pair{ a: 1, b: "x" }.name())
}
