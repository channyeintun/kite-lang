// A map compares its keys with `==`, so a key must be a type `==` is defined
// on: not a function, a trait object, or a host value.

trait Show {
    fn show(self) -> str
}

@host("js")
extern fn global(name: str) -> JsValue

fn by_host(m: {JsValue: int}) -> int { //~ ERROR E0201
    return m.len()
}

fn main() {
