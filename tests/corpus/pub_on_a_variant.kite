// A variant, and a field of its payload, is exactly as visible as its enum
// (§4.3), so `pub` on one is refused: once, at the `pub`, saying why. The
// variant is still declared, so the uses of it below are not errors too. It
// was "expected a variant, found `pub`", or "expected a type".

pub enum Shape {
    pub Dot //~ ERROR E0100
    Circle(pub radius: float) //~ ERROR E0100
    Square(pub float) //~ ERROR E0100
}

fn main() {
    let shapes = [Dot, Circle(radius: 1.0), Square(2.0)]
    io.print(shapes.len())
}
