use std/ui
use std/math

// Date and time pickers: the two components in Material that are mostly
// arithmetic.
//
// Everything else in this package is colour, shape and motion applied to text
// somebody else supplied. A date picker has to know that February 2028 has
// twenty-nine days and that the first of them is a Tuesday, and a clock face
// has to know where the seven goes. Those are facts rather than decisions, so
// they are separated out and tested against the calendar rather than against a
// screenshot: [`days_in_month`], [`weekday_of`], [`ordinal`] and [`month_cells`]
// are the picker, and the rest is a grid of buttons drawn around them.
//
// ---- what a picker does not decide ------------------------------------------
//
// Not the locale. The weekday initials, the month names and which day a week
// starts on are all fields of [`Calendar`], because they are different in
// different places and a design system that hard-coded Sunday would be a design
// system that could not be shipped in France. [`default_weekdays`] supplies the
// English ones so a caller who has no locale yet is not blocked on getting one.
//
// Not the year range, the disabled days, or what a date means. A picker takes
// the month it is showing and gives back the day that was pressed.

// ---- dates ----------------------------------------------------------------------

/// A day, with a `day` of 0 meaning "no date" — which is what an empty picker,
/// an unfinished range and a field nobody has typed in yet all are.
///
/// Not `std/time`'s. That module is about *instants*, which have a time zone
/// and a moment; this is a square on a calendar, which has neither. Converting
/// between them is the application's business, and it is the application that
/// knows which zone the user is in.
pub struct Date {
    pub year: int
    pub month: int
    pub day: int
}

pub fn date(year: int, month: int, day: int) -> Date {
    return Date{ year: year, month: month, day: day }
}

/// No date at all. A `day` of zero rather than an `Option<Date>`: a picker
/// showing March with nothing chosen still has a year and a month, and an
/// option would have thrown both away to say that one field was missing.
pub fn no_date() -> Date {
    return Date{ year: 0, month: 1, day: 0 }
}

pub fn has_date(d: Date) -> bool {
    return d.day > 0
}

pub fn same_day(a: Date, b: Date) -> bool {
    return a.year == b.year && a.month == b.month && a.day == b.day
}

/// The Gregorian leap rule, all three clauses of it. The century exception is
/// the one that gets left out, and 1900 and 2100 are the years that catch it.
pub fn is_leap_year(year: int) -> bool {
    if year % 4 != 0 {
        return false
    }
    if year % 100 != 0 {
        return true
    }
    return year % 400 == 0
}

pub fn days_in_month(year: int, month: int) -> int {
    if month == 2 {
        return if is_leap_year(year) { 29 } else { 28 }
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30
    }
    if month < 1 || month > 12 {
        return 0
    }
    return 31
}

/// Which day of the week a date falls on: 0 is Sunday, 6 is Saturday.
///
/// Sakamoto's method — a table of month offsets and the leap-year count since
/// year zero. It is exact for any Gregorian date rather than approximately
/// right near today, which matters for a picker: someone will scroll to 2100,
/// and 2100 is the century that is not a leap year.
pub fn weekday_of(year: int, month: int, day: int) -> int {
    let offsets = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    var y = year
    if month < 3 {
        y = y - 1
    }
    return (y + y / 4 - y / 100 + y / 400 + offsets[month - 1] + day) % 7
}

/// The number of days from 1970-01-01 to this date, negative before it.
///
/// The one number a range picker needs: "is this day between those two" is a
/// question about order, and a Date has three fields that have to be compared
/// in the right sequence with the right tie-breaks. One integer has none of
/// that. Howard Hinnant's `days_from_civil`, which is exact and has no loop in
/// it — a picker that counted forward from the epoch a month at a time would
/// spend four hundred iterations drawing one calendar.
pub fn ordinal(d: Date) -> int {
    var y = d.year
    if d.month <= 2 {
        y = y - 1
    }
    // Shifting the year start to March puts the leap day at the end of the
    // year, where it stops perturbing the month-length pattern.
    let era = if y >= 0 { y / 400 } else { (y - 399) / 400 }
    let year_of_era = y - era * 400
    let shifted = if d.month > 2 { d.month - 3 } else { d.month + 9 }
    let day_of_year = (153 * shifted + 2) / 5 + d.day - 1
    let day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year
    return era * 146097 + day_of_era - 719468
}

/// Whether `d` falls inside a range, ends included. An unfinished range — one
/// end chosen and the other not — contains nothing, which is what makes a
/// half-made range draw as a single day rather than as everything after it.
pub fn within(d: Date, from: Date, to: Date) -> bool {
    if !has_date(d) || !has_date(from) || !has_date(to) {
        return false
    }
    let at = ordinal(d)
    return at >= ordinal(from) && at <= ordinal(to)
}

/// The month before this one, keeping the day where the shorter month allows.
///
/// The clamp is the whole of it: the 31st of March, stepped back, is the 28th
/// of February and not the 3rd of March. Every calendar that gets this wrong
/// gets it wrong in the same place.
pub fn month_before(d: Date) -> Date {
    var year = d.year
    var month = d.month - 1
    if month < 1 {
        month = 12
        year = year - 1
    }
    return Date{ year: year, month: month, day: min(d.day, days_in_month(year, month)) }
}

pub fn month_after(d: Date) -> Date {
    var year = d.year
    var month = d.month + 1
    if month > 12 {
        month = 1
        year = year + 1
    }
    return Date{ year: year, month: month, day: min(d.day, days_in_month(year, month)) }
}

/// The forty-two cells of a month's grid, in reading order, with 0 for the
/// blanks before the first and after the last.
///
/// Six rows of seven, always — never five and never seven. A grid that grew a
/// row for a long month would move everything under it when the month changed,
/// and a picker that jumped a row on every press is the version of this
/// component everyone has used and nobody has liked.
///
/// `week_start` is which weekday the leftmost column is: 0 for Sunday, 1 for
/// Monday, and anything else a locale asks for.
pub fn month_cells(year: int, month: int, week_start: int) -> [int] {
    var out: [int] = []
    let length = days_in_month(year, month)
    if length == 0 {
        return out
    }
    // How many blanks come before the first. The `+ 7` keeps the remainder
    // positive: a Sunday-first grid for a month beginning on Saturday would
    // otherwise ask for minus one blank.
    let first = weekday_of(year, month, 1)
    let lead = (first - week_start + 7) % 7
    for i in 0..42 {
        let day = i - lead + 1
        if day < 1 || day > length {
            out.push(0)
        } else {
            out.push(day)
        }
    }
    return out
}

/// The English weekday initials, from Sunday. A caller with a locale passes its
/// own; a caller without one is not stopped from drawing a calendar.
pub fn default_weekdays() -> [str] {
    return ["S", "M", "T", "W", "T", "F", "S"]
}

pub fn default_months() -> [str] {
    return [
        "January",
        "February",
        "March",
        "April",
        "May",
        "June",
        "July",
        "August",
        "September",
        "October",
        "November",
        "December",
    ]
}

// ---- the calendar a picker is showing ------------------------------------------

/// Everything a calendar grid draws, in one value.
///
/// The alternative was nine parameters on every picker, six of which are the
/// same on every call in an application. A struct with a constructor and update
/// syntax is how a caller says "the default, except the week starts on Monday"
/// without restating the other eight.
pub struct Calendar {
    /// The month on screen. Its `day` is ignored — what a grid draws is a
    /// month, and which day is chosen is `selected`.
    pub shown: Date
    pub selected: Date
    /// Ringed rather than filled, so today is visible even when another day is
    /// chosen. [`no_date`] leaves it unmarked, which is what a calendar in a
    /// test or a screenshot wants.
    pub today: Date
    /// The ends of a chosen range, for [`date_range_picker`]. Both empty in an
    /// ordinary picker, and a band is drawn between them when they are not.
    pub from: Date
    pub to: Date
    pub week_start: int
    pub weekdays: [str]
    pub months: [str]
}

pub fn calendar(shown: Date, selected: Date, today: Date) -> Calendar {
    return Calendar{
        shown: shown,
        selected: selected,
        today: today,
        from: no_date(),
        to: no_date(),
        week_start: 0,
        weekdays: default_weekdays(),
        months: default_months(),
    }
}

/// What the header over a grid says: "August 2026".
pub fn month_label(cal: Calendar) -> str {
    let index = cal.shown.month - 1
    if index < 0 || index >= cal.months.len() {
        return "\(cal.shown.year)"
    }
    return "\(cal.months[index]) \(cal.shown.year)"
}

/// A date written out: "4 August 2026". What a day cell is called for anything
/// that cannot see it, and what a modal picker puts under its headline.
pub fn spelled_date(cal: Calendar, d: Date) -> str {
    if !has_date(d) {
        return ""
    }
    let index = d.month - 1
    if index < 0 || index >= cal.months.len() {
        return "\(d.day)/\(d.month)/\(d.year)"
    }
    return "\(d.day) \(cal.months[index]) \(d.year)"
}

// ---- the grid --------------------------------------------------------------------

fn CELL() -> float {
    return 48.0
}

/// The circle inside a cell. Smaller than the cell, so consecutive days do not
/// touch and the 48dp touch target is still there under the finger.
fn DAY_CIRCLE() -> float {
    return 40.0
}

/// The id a day cell carries.
///
/// Public because the caller needs it and cannot invent it: pointer events
/// arrive naming a control, and turning that name back into a day is what
/// [`docked_date_picker`]'s `day_state` argument is answering. A caller writes
/// `|day: int| material.state_of(model.pointer, material.day_id("when", day))`,
/// and this is the half of that expression the picker owns.
pub fn day_id(name: str, day: int) -> str {
    return "\(name)-d-\(day)"
}

/// One day: a number in a circle, in a 48dp square.
///
/// Four things it can be, and they layer rather than exclude. A day inside a
/// range wears a band; a day that is an end of one wears the band on one side
/// only; the chosen day is a filled circle; today is a ring. A day can be three
/// of them at once — the first day of a chosen range, which is also today — and
/// drawing them as separate layers is what lets it be.
///
/// The layers are a `Stack`, which is the axis `std/ui` grew for exactly this:
/// children that share a box rather than dividing it, painted in order. Without
/// it the band and the circle would have to be one node, and a band that is
/// half a cell wide with a circle centred over it is not one node.
fn day_cell<Msg>(
    s: Scheme,
    owner: str,
    slot: str,
    cal: Calendar,
    day: int,
    msg: Msg,
    state: State,
) -> ui.Node<Msg> {
    if day <= 0 {
        // A blank still occupies its square, or the days after it would slide
        // left into the space it did not take. It is named after its position
        // rather than its day, having none — and every other node here is named
        // after the day, so that the id a caller computes with [`day_id`] is
        // the id the cell actually carries.
        return ui.box_of("\(slot)-blank", ui.sized(ui.style(), CELL(), CELL()), [])
    }
    let name = day_id(owner, day)
    let here = Date{ year: cal.shown.year, month: cal.shown.month, day: day }
    let role = body_large()
    let chosen = same_day(here, cal.selected)
    || same_day(here, cal.from)
    || same_day(here, cal.to)
    let inside = within(here, cal.from, cal.to)
    let is_today = same_day(here, cal.today)

    // The band, in two halves. An interior day gets both; the start of a range
    // gets the trailing half only, so the band appears to begin under its
    // circle rather than at the edge of its cell.
    //
    // A day with no band draws *nothing* rather than drawing the surface
    // colour. Filling it with `surface` would be right only if the picker were
    // sitting on `surface`, and it never is — a docked picker is two container
    // tones up — so every cell would have shown as a lighter square.
    let band_colour = s.secondary_container
    var lead_band = ui.no_decor()
    var tail_band = ui.no_decor()
    if inside {
        if !same_day(here, cal.from) {
            lead_band = ui.filled(band_colour)
        }
        if !same_day(here, cal.to) {
            tail_band = ui.filled(band_colour)
        }
    }
    let band: ui.Node<Msg> = ui.box_of(
        "\(name)-band",
        ui.Style {
            ..ui.row(),
            align: ui.Align.Center,
            width: CELL(),
            height: CELL(),
        },
        [
            ui.decorated(
                ui.box_of("\(name)-band-a", ui.sized(ui.style(), CELL() / 2.0, DAY_CIRCLE()), []),
                lead_band,
            ),
            ui.decorated(
                ui.box_of("\(name)-band-b", ui.sized(ui.style(), CELL() / 2.0, DAY_CIRCLE()), []),
                tail_band,
            ),
        ],
    )

    let amount = chosen_amount(chosen, state)
    let fill = mix(if inside { band_colour } else { s.surface }, s.primary, amount)
    var ink = mix(s.on_surface, s.on_primary, amount)
    if inside && amount <= 0.0 {
        ink = s.on_secondary_container
    }
    if state.disabled {
        ink = disabled_ink(s, s.surface)
    }
    var circle = ui.rounded(layered(fill, ink, state), SHAPE_FULL())
    if amount <= 0.0 {
        circle = layer_decor(s.on_surface, state, SHAPE_FULL())
    }
    // Today is a ring rather than a fill, which is what lets it survive being
    // the chosen day as well: the fill says "chosen" underneath it.
    if is_today {
        circle = ui.bordered(circle, if amount > 0.0 { fill } else { s.primary }, 1.0)
    }
    let number: ui.Node<Msg> = ui.decorated(
        ui.text_of(
            "\(name)-n",
            ui.sized(ui.in_font(ui.style(), role.size, role.weight), DAY_CIRCLE(), DAY_CIRCLE()),
            "\(day)",
        ),
        ui.centered(ui.ink(ink)),
    )
    let mark: ui.Node<Msg> = ui.box_of(
        "\(name)-mark",
        ui.Style {
            ..ui.column(),
            align: ui.Align.Center,
            justify: ui.Justify.Center,
            width: CELL(),
            height: CELL(),
        },
        [ui.decorated(number, circle)],
    )
    let cell: ui.Node<Msg> = ui.box_of(
        name,
        ui.Style {
            ..ui.stack(),
            width: CELL(),
            height: CELL(),
        },
        [band, mark],
    )
    let whole = ui.means(
        ui.decorated(cell, ui.ink(s.on_surface)),
        name,
        msg,
        spelled_date(cal, here),
    )
    if state.disabled {
        return ui.disabled(whole)
    }
    return whole
}

/// The row of weekday initials over a grid. Not controls: pressing "W" does
/// nothing in any calendar anybody has used.
pub fn weekday_row<Msg>(name: str, s: Scheme, cal: Calendar) -> ui.Node<Msg> {
    let role = body_small()
    var cells: [ui.Node<Msg>] = []
    for i in 0..7 {
        let which = (i + cal.week_start) % 7
        let caption = if which < cal.weekdays.len() { cal.weekdays[which] } else { "" }
        cells.push(
            ui.decorated(
                ui.text_of(
                    "\(name)-w\(i)",
                    ui.sized(ui.in_font(ui.style(), role.size, role.weight), CELL(), CELL()),
                    caption,
                ),
                ui.centered(ui.ink(s.on_surface)),
            ),
        )
    }
    return ui.box_of("\(name)-weekdays", ui.Style{..ui.row() }, cells)
}

/// The month's days, six rows of seven.
///
/// `on_day` says what pressing a day means and `day_state` says what is
/// happening to it. Both are functions of the day number rather than slices of
/// forty-two, because a caller has one rule for every day and would otherwise
/// be writing the loop this function already contains.
///
/// A closure passed here needs its parameter annotated — `|day: int| …` — since
/// nothing about a literal says what it takes.
pub fn calendar_grid<Msg>(
    s: Scheme,
    name: str,
    cal: Calendar,
    on_day: fn(int) -> Msg,
    day_state: fn(int) -> State,
) -> ui.Node<Msg> {
    let cells = month_cells(cal.shown.year, cal.shown.month, cal.week_start)
    var rows: [ui.Node<Msg>] = []
    for week in 0..6 {
        var row: [ui.Node<Msg>] = []
        for column in 0..7 {
            let at = week * 7 + column
            let day = if at < cells.len() { cells[at] } else { 0 }
            let state = if day > 0 { day_state(day) } else { rest() }
            let msg = on_day(maxi(day, 1))
            row.push(day_cell(s, name, "\(name)-\(week)-\(column)", cal, day, msg, state))
        }
        rows.push(ui.box_of("\(name)-row-\(week)", ui.Style{..ui.row() }, row))
    }
    return ui.box_of("\(name)-grid", ui.Style{..ui.column(), align: ui.Align.Start }, rows)
}

/// `max` for ints, which the prelude spells the same way; named apart here so
/// a blank cell can be given a day number to build a message from without the
/// message being about day zero.
fn maxi(a: int, b: int) -> int {
    return max(a, b)
}

// ---- stepping between months -------------------------------------------------------

/// The two controls that change the month, in one value.
///
/// They belong together and neither belongs to the calendar: which message a
/// back-arrow sends is the application's, and a picker that invented one would
/// be a picker whose month could not be changed from anywhere else.
pub struct MonthNav<Msg> {
    pub back_id: str
    pub back_msg: Msg
    pub back_state: State
    pub forward_id: str
    pub forward_msg: Msg
    pub forward_state: State
}

pub fn month_nav<Msg>(
    back_id: str,
    back_msg: Msg,
    forward_id: str,
    forward_msg: Msg,
) -> MonthNav<Msg> {
    return MonthNav{
        back_id: back_id,
        back_msg: back_msg,
        back_state: rest(),
        forward_id: forward_id,
        forward_msg: forward_msg,
        forward_state: rest(),
    }
}

/// The row over a grid: which month this is, and the two ways out of it.
pub fn calendar_header<Msg>(
    s: Scheme,
    name: str,
    cal: Calendar,
    nav: MonthNav<Msg>,
    width: float,
) -> ui.Node<Msg> {
    let role = label_large()
    let label: ui.Node<Msg> = ui.decorated(
        ui.text_of(
            "\(name)-month",
            ui.grown(ui.in_font(ui.style(), role.size, role.weight), 1.0),
            month_label(cal),
        ),
        ui.vertically_centered(ui.ink(s.on_surface_variant)),
    )
    return ui.box_of(
        name,
        ui.spaced(
            ui.Style {
                ..ui.row(),
                align: ui.Align.Center,
                width: width,
                height: 56.0,
            },
            space(1),
        ),
        [
            label,
            icon_button(s, nav.back_id, nav.back_msg, "◂", nav.back_state),
            icon_button(s, nav.forward_id, nav.forward_msg, "▸", nav.forward_state),
        ],
    )
}

// ---- the pickers ---------------------------------------------------------------------

/// The width a calendar comes to: seven 48dp cells and 12dp either side.
pub fn PICKER_WIDTH() -> float {
    return CELL() * 7.0 + space(3) * 2.0
}

/// A docked date picker: the calendar under a text field, with nothing behind
/// it.
///
/// The one to use on a wide window, where the field the date is going into can
/// stay on screen beside it. It is a plain node rather than a portal for the
/// same reason every overlay in this package is: where it goes is the
/// application's decision, and `ui.portal` is one call away when it should
/// hang over the form rather than push it down.
pub fn docked_date_picker<Msg>(
    s: Scheme,
    name: str,
    cal: Calendar,
    nav: MonthNav<Msg>,
    on_day: fn(int) -> Msg,
    day_state: fn(int) -> State,
) -> ui.Node<Msg> {
    let width = PICKER_WIDTH()
    return ui.decorated(
        ui.box_of(
            name,
            ui.padded(
                ui.Style {..ui.column(), align: ui.Align.Start, width: width },
                space(3),
            ),
            [
                calendar_header(s, "\(name)-head", cal, nav, width - space(3) * 2.0),
                weekday_row("\(name)-days", s, cal),
                calendar_grid(s, name, cal, on_day, day_state),
            ],
        ),
        ui.rounded(surface_at(s, LEVEL_3()), SHAPE_LARGE()),
    )
}

/// A modal date picker: the calendar in a dialog, with the chosen date spelled
/// out over it.
///
/// Material's default, and the one a phone gets. The headline is the date
/// rather than the word "date" — someone who has just pressed the 4th needs to
/// see that they pressed the 4th, and the label above it is what says the
/// headline is a date at all.
pub fn modal_date_picker<Msg>(
    s: Scheme,
    name: str,
    cal: Calendar,
    nav: MonthNav<Msg>,
    on_day: fn(int) -> Msg,
    day_state: fn(int) -> State,
    actions: [ui.Node<Msg>],
) -> ui.Node<Msg> {
    let width = PICKER_WIDTH()
    let chosen = spelled_date(cal, cal.selected)
    var children: [ui.Node<Msg>] = [
        picker_headline(s, name, "Select date", if chosen.len() > 0 { chosen } else { "—" }, width),
        divider("\(name)-rule", s),
        calendar_header(s, "\(name)-head", cal, nav, width - space(3) * 2.0),
        weekday_row("\(name)-days", s, cal),
        calendar_grid(s, name, cal, on_day, day_state),
    ]
    if actions.len() > 0 {
        children.push(
            ui.box_of(
                "\(name)-actions",
                ui.spaced(
                    ui.padded(ui.Style{..ui.row(), justify: ui.Justify.End }, space(2)),
                    space(2),
                ),
                actions,
            ),
        )
    }
    return ui.decorated(
        ui.box_of(
            name,
            ui.padded(
                ui.Style {..ui.column(), align: ui.Align.Start, width: width },
                space(3),
            ),
            children,
        ),
        ui.rounded(surface_at(s, LEVEL_3()), SHAPE_EXTRA_LARGE()),
    )
}

/// The two lines over a modal picker: what is being chosen, and what has been.
fn picker_headline<Msg>(
    s: Scheme,
    name: str,
    caption: str,
    value: str,
    width: float,
) -> ui.Node<Msg> {
    let small = label_medium()
    let big = headline_large()
    return ui.box_of(
        "\(name)-headline",
        ui.spaced(
            ui.padded(
                ui.Style {..ui.column(), align: ui.Align.Start, width: width },
                space(3),
            ),
            space(2),
        ),
        [
            ui.decorated(
                ui.text_of(
                    "\(name)-what",
                    ui.in_font(ui.style(), small.size, small.weight),
                    caption,
                ),
                ui.ink(s.on_surface_variant),
            ),
            ui.decorated(
                ui.text_of(
                    "\(name)-value",
                    ui.in_font(ui.style(), big.size, big.weight),
                    value,
                ),
                ui.ink(s.on_surface),
            ),
        ],
    )
}

/// A date *input*: the same dialog with a field to type into instead of a grid.
///
/// Material offers it beside the calendar because typing 04/08/2026 is faster
/// than scrolling to it when the date is known and far away — a birthday, a
/// passport expiry. The switch between the two is a control the application
/// puts in `actions`, since which one is showing is state and this package
/// holds none.
pub fn date_input<Msg>(
    s: Scheme,
    name: str,
    id: str,
    value: str,
    hint: str,
    error: str,
    state: State,
    actions: [ui.Node<Msg>],
) -> ui.Node<Msg> {
    let width = PICKER_WIDTH()
    let inner = width - space(3) * 2.0
    let spec = Field{
        ..field("Date", value, inner),
        placeholder: hint,
        supporting: if error.len()> 0 { error } else { hint },
        error: error.len()> 0,
    }
    var children: [ui.Node<Msg>] = [
        picker_headline(s, name, "Select date", if value.len() > 0 { value } else { "—" }, width),
        divider("\(name)-rule", s),
        ui.box_of(
            "\(name)-field",
            ui.padded(ui.Style{..ui.column(), align: ui.Align.Start }, space(3)),
            [outlined_field_of(s, id, spec, state)],
        ),
    ]
    if actions.len() > 0 {
        children.push(
            ui.box_of(
                "\(name)-actions",
                ui.spaced(
                    ui.padded(ui.Style{..ui.row(), justify: ui.Justify.End }, space(2)),
                    space(2),
                ),
                actions,
            ),
        )
    }
    return ui.decorated(
        ui.box_of(
            name,
            ui.Style {..ui.column(), align: ui.Align.Start, width: width },
            children,
        ),
        ui.rounded(surface_at(s, LEVEL_3()), SHAPE_EXTRA_LARGE()),
    )
}

/// A date *range* picker: two dates, and everything between them.
///
/// Material makes this one full-screen, and it is the right call: a range is
/// chosen by pressing twice with a scroll in between, and a dialog small enough
/// to sit over a form is not big enough to do that in. So it takes the window's
/// measurements and a top bar, and the band between the ends is drawn by
/// [`day_cell`] out of `cal.from` and `cal.to`.
pub fn date_range_picker<Msg>(
    s: Scheme,
    name: str,
    cal: Calendar,
    nav: MonthNav<Msg>,
    on_day: fn(int) -> Msg,
    day_state: fn(int) -> State,
    leading: [ui.Node<Msg>],
    actions: [ui.Node<Msg>],
    size: ui.Size,
) -> ui.Node<Msg> {
    let from = spelled_date(cal, cal.from)
    let to = spelled_date(cal, cal.to)
    let shown = if from.len() == 0 {
        "Start date — End date"
    } else if to.len() == 0 {
        "\(from) — End date"
    } else {
        "\(from) — \(to)"
    }
    let head_role = title_large()
    let bar: ui.Node<Msg> = top_app_bar_with(s, "\(name)-bar", leading, actions, size.width)
    let headline: ui.Node<Msg> = ui.decorated(
        ui.text_of(
            "\(name)-range",
            ui.Style {
                ..ui.in_font(ui.style(), head_role.size, head_role.weight),
                width: size.width,
                height: 64.0,
                padding: ui.insets_xy(space(4), 0.0),
            },
            shown,
        ),
        ui.vertically_centered(ui.ink(s.on_surface_variant)),
    )
    return ui.decorated(
        ui.box_of(
            name,
            ui.Style {
                ..ui.column(),
                align: ui.Align.Stretch,
                width: size.width,
                height: size.height,
            },
            [
                bar,
                headline,
                divider("\(name)-rule", s),
                calendar_header(s, "\(name)-head", cal, nav, size.width - space(4) * 2.0),
                weekday_row("\(name)-days", s, cal),
                calendar_grid(s, name, cal, on_day, day_state),
            ],
        ),
        ui.filled(s.surface),
    )
}

/// A bar with controls at both ends and no title: what a full-screen picker
/// wears, where the headline underneath is the title.
fn top_app_bar_with<Msg>(
    s: Scheme,
    name: str,
    leading: [ui.Node<Msg>],
    actions: [ui.Node<Msg>],
    width: float,
) -> ui.Node<Msg> {
    var children: [ui.Node<Msg>] = []
    for one in leading {
        children.push(one)
    }
    children.push(ui.box_of("\(name)-gap", ui.grown(ui.style(), 1.0), []))
    for one in actions {
        children.push(one)
    }
    let style = ui.spaced(
        ui.padded(
            ui.Style {
                ..ui.row(),
                align: ui.Align.Center,
                width: width,
                height: 64.0,
            },
            space(4),
        ),
        space(2),
    )
    return ui.decorated(ui.box_of(name, style, children), ui.filled(s.surface))
}

// ---- time -----------------------------------------------------------------------
//
// ---- why the dial is painted rather than laid out --------------------------------
//
// The same reason the circular progress indicator is, and more so. A clock face
// puts twelve numbers on a circle, and a circle is a polar arrangement: the
// seven is at 210 degrees and 96dp out. Rows and columns cannot say that, and a
// layout that approximated it with nested boxes would be a table pretending to
// be a clock — which is what every attempt at this looks like.
//
// So the dial comes in two halves, like [`circular_progress`]: [`time_dial`]
// reserves the square, and [`paint_time_dial`] draws into it after the tree has
// painted. [`dial_value_at`] is the third piece and the one that makes it a
// control rather than a picture — a pointer position goes in and an hour comes
// out, computed from the same geometry the painter used.

pub fn TIME_DIAL_SIDE() -> float {
    return 256.0
}

/// How far in from the edge the numbers sit, to their centres.
fn DIAL_INSET() -> float {
    return 24.0
}

/// The circle drawn under the selected number.
fn DIAL_KNOB() -> float {
    return 48.0
}

/// The space a clock face occupies. It draws nothing — see the note above — so
/// it is a square of the right size and no more.
pub fn time_dial<Msg>(name: str) -> ui.Node<Msg> {
    return ui.box_of(
        name,
        ui.sized(ui.style(), TIME_DIAL_SIDE(), TIME_DIAL_SIDE()),
        [],
    )
}

/// The clock face, drawn into the square [`time_dial`] reserved.
///
/// `minutes` says which of the two faces this is: twelve hours, or sixty
/// minutes marked every five. `value` is the hour or the minute, and the hand
/// points at it — at exactly it, rather than at the nearest mark, so a minute
/// of 37 puts the hand between the 35 and the 40 the way a clock does.
pub fn paint_time_dial(frames: [ui.Frame], name: str, s: Scheme, value: int, minutes: bool) {
    let box = ui.frame_of(frames, name)
    if box == nil {
        return
    }
    let rect = box.rect
    let side = minf(rect.width, rect.height)
    if side <= 0.0 {
        return
    }
    let cx = rect.x + rect.width / 2.0
    let cy = rect.y + rect.height / 2.0
    let radius = side / 2.0
    let ring = radius - DIAL_INSET()
    draw.rrect(cx - radius, cy - radius, side, side, radius, s.surface_container_highest)

    // Where the hand points, as a fraction of the way round from twelve
    // o'clock. Minutes divide the circle sixty ways and hours twelve, and the
    // hand takes the exact fraction rather than the nearest mark.
    let steps = if minutes { 60 } else { 12 }
    let turn = ((value % steps) as float) / (steps as float)
    let angle = -math.pi() / 2.0 + math.tau() * turn
    let px = cx + ring * math.cos(angle)
    let py = cy + ring * math.sin(angle)

    // The hand, then the knob, then the numbers: each covers the seam the one
    // before it left.
    spoke(cx, cy, px, py, s.primary)
    draw.rrect(cx - 2.0, cy - 2.0, 4.0, 4.0, 2.0, s.primary)
    draw.rrect(
        px - DIAL_KNOB() / 2.0,
        py - DIAL_KNOB() / 2.0,
        DIAL_KNOB(),
        DIAL_KNOB(),
        DIAL_KNOB() / 2.0,
        s.primary,
    )

    let role = body_large()
    draw.font(role.size, role.weight)
    for i in 0..12 {
        let at = -math.pi() / 2.0 + math.tau() * ((i as float) / 12.0)
        let hour_mark = if i == 0 { 12 } else { i }
        let mark = if minutes { i * 5 } else { hour_mark }
        // The number under the knob is drawn in the on-colour, and every other
        // in the ordinary ink. Whether *this* mark is the selected one is a
        // question about the value rather than about the angle: 37 minutes puts
        // the hand between two marks and lights neither.
        let lit = if minutes { value % 60 == mark } else { value % 12 == mark % 12 }
        let colour = if lit { s.on_primary } else { s.on_surface }
        let body = "\(mark)"
        let measured = ui.text_size_in(body, role.size, role.weight)
        draw.text(
            cx + ring * math.cos(at) - measured.width / 2.0,
            cy + ring * math.sin(at) - measured.height / 2.0,
            body,
            colour,
        )
    }
    draw.font(ui.DEFAULT_SIZE(), REGULAR())
}

/// A line, as the run of overlapping dots a stroked line is once it has been
/// flattened — the same technique `progress.kite` draws an arc with, and for
/// the same reason: there is no line at this drawing boundary, only rectangles
/// that cannot be turned.
///
/// The step count is fixed rather than proportional to the length, so a hand
/// sweeping round the face makes the same number of draw calls at every angle.
/// A renderer that keeps a retained scene indexed by call cannot patch a frame
/// whose call count changed, and a clock hand that forced a full redraw on
/// every tick would be the most expensive thing on the screen.
fn spoke(x1: float, y1: float, x2: float, y2: float, colour: int) {
    let width = 2.0
    let steps = 64
    for i in 0..steps + 1 {
        let along = (i as float) / (steps as float)
        let x = math.lerp(x1, x2, along)
        let y = math.lerp(y1, y2, along)
        draw.rrect(x - width / 2.0, y - width / 2.0, width, width, width / 2.0, colour)
    }
}

/// Which number a point on the dial names.
///
/// The inverse of what [`paint_time_dial`] draws, and it has to be: a control
/// whose hit-testing and whose painting disagree is a control that lights up
/// the number beside the one you pressed. Both take twelve o'clock as the
/// origin and go clockwise.
///
/// Distance from the centre is ignored. Material's dial answers anywhere inside
/// it, because dragging a finger toward the middle should not stop the hand
/// following it.
pub fn dial_value_at(box: ui.Rect, x: float, y: float, minutes: bool) -> int {
    let cx = box.x + box.width / 2.0
    let cy = box.y + box.height / 2.0
    // `atan2` measures from due east; the dial measures from twelve o'clock, a
    // quarter turn earlier.
    var turn = math.atan2(y - cy, x - cx) + math.pi() / 2.0
    if turn < 0.0 {
        turn = turn + math.tau()
    }
    let fraction = turn / math.tau()
    if minutes {
        return math.round_to(fraction * 60.0) % 60
    }
    let hour = math.round_to(fraction * 12.0) % 12
    return if hour == 0 { 12 } else { hour }
}

/// One of the two numerals over a dial: the hour, or the minute.
///
/// A control, and a big one — 96 by 80 — because pressing it is how the dial is
/// switched between hours and minutes, and that is the least discoverable thing
/// about a time picker. Selected, it takes the primary container, which is the
/// only thing on the screen saying which of the two the dial is currently
/// showing.
pub fn time_numeral<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    value: str,
    label: str,
    on: bool,
    state: State,
) -> ui.Node<Msg> {
    let role = display_large()
    let amount = chosen_amount(on, state)
    let container = mix(s.surface_container_highest, s.primary_container, amount)
    let ink = mix(s.on_surface, s.on_primary_container, amount)
    let width = 96.0
    let height = 80.0
    let box: ui.Node<Msg> = ui.box_of(
        id,
        ui.Style {
            ..ui.column(),
            align: ui.Align.Center,
            justify: ui.Justify.Center,
            width: width,
            height: height,
        },
        [
            inked_text(
                "\(id)-value",
                ui.sized(ui.in_font(ui.style(), role.size, role.weight), width, height),
                value,
                ink,
            ),
        ],
    )
    let decor = ui.inked(
        ui.rounded(layered(container, ink, state), morphed(SHAPE_SMALL(), width, height, state.press)),
        ink,
    )
    let whole = ui.means(ui.decorated(box, decor), id, msg, label)
    if state.disabled {
        return ui.disabled(whole)
    }
    return whole
}

/// The AM/PM toggle: two halves of an outlined pill, stacked.
///
/// Vertical, which is Material's arrangement beside a dial and the reason it is
/// not a segmented button: the two are 52 by 40 one above the other, and a
/// segmented button is a row.
pub fn period_toggle<Msg>(
    s: Scheme,
    name: str,
    am_id: str,
    am_msg: Msg,
    pm_id: str,
    pm_msg: Msg,
    is_am: bool,
    am_state: State,
    pm_state: State,
) -> ui.Node<Msg> {
    let role = title_medium()
    let width = 52.0
    let height = 40.0
    let am_amount = chosen_amount(is_am, am_state)
    let pm_amount = chosen_amount(!is_am, pm_state)
    let am_fill = mix(s.surface, s.tertiary_container, am_amount)
    let pm_fill = mix(s.surface, s.tertiary_container, pm_amount)
    let am_ink = mix(s.on_surface_variant, s.on_tertiary_container, am_amount)
    let pm_ink = mix(s.on_surface_variant, s.on_tertiary_container, pm_amount)
    return ui.decorated(
        ui.box_of(
            name,
            ui.Style {..ui.column(), align: ui.Align.Stretch, width: width },
            [
                centred_body(
                    am_id,
                    am_msg,
                    !am_state.disabled,
                    "AM",
                    role.size,
                    role.weight,
                    width,
                    height,
                    ui.inked(ui.rounded(layered(am_fill, am_ink, am_state), SHAPE_SMALL()), am_ink),
                ),
                centred_body(
                    pm_id,
                    pm_msg,
                    !pm_state.disabled,
                    "PM",
                    role.size,
                    role.weight,
                    width,
                    height,
                    ui.inked(ui.rounded(layered(pm_fill, pm_ink, pm_state), SHAPE_SMALL()), pm_ink),
                ),
            ],
        ),
        ui.bordered(ui.shaped(ui.no_decor(), SHAPE_SMALL()), s.outline, 1.0),
    )
}

/// Two digits, which is how every clock in the world writes a minute.
pub fn two_digits(n: int) -> str {
    return pad_start("\(n)", 2, "0")
}

/// Everything a time picker is told, in one value — the same bargain
/// [`Calendar`] strikes.
pub struct Clock<Msg> {
    /// 1 to 12 on a twelve-hour dial, 0 to 23 on a twenty-four-hour one.
    pub hour: int
    pub minute: int
    /// Whether the dial is showing minutes. Pressing the other numeral is what
    /// changes it, and the application holds it because the application holds
    /// everything.
    pub picking_minutes: bool
    pub morning: bool
    pub hour_id: str
    pub hour_msg: Msg
    pub hour_state: State
    pub minute_id: str
    pub minute_msg: Msg
    pub minute_state: State
    pub am_id: str
    pub am_msg: Msg
    pub am_state: State
    pub pm_id: str
    pub pm_msg: Msg
    pub pm_state: State
}

pub fn clock<Msg>(
    hour: int,
    minute: int,
    hour_id: str,
    hour_msg: Msg,
    minute_id: str,
    minute_msg: Msg,
    am_id: str,
    am_msg: Msg,
    pm_id: str,
    pm_msg: Msg,
) -> Clock<Msg> {
    return Clock{
        hour: hour,
        minute: minute,
        picking_minutes: false,
        morning: true,
        hour_id: hour_id,
        hour_msg: hour_msg,
        hour_state: rest(),
        minute_id: minute_id,
        minute_msg: minute_msg,
        minute_state: rest(),
        am_id: am_id,
        am_msg: am_msg,
        am_state: rest(),
        pm_id: pm_id,
        pm_msg: pm_msg,
        pm_state: rest(),
    }
}

/// The numerals and the period toggle: `10 : 47  AM`.
fn time_head<Msg>(s: Scheme, name: str, spec: Clock<Msg>) -> ui.Node<Msg> {
    let colon_role = display_large()
    let colon: ui.Node<Msg> = ui.decorated(
        ui.text_of(
            "\(name)-colon",
            ui.sized(ui.in_font(ui.style(), colon_role.size, colon_role.weight), 24.0, 80.0),
            ":",
        ),
        ui.centered(ui.ink(s.on_surface)),
    )
    return ui.box_of(
        "\(name)-head",
        ui.spaced(ui.Style{..ui.row(), align: ui.Align.Center }, space(3)),
        [
            time_numeral(
                s,
                spec.hour_id,
                spec.hour_msg,
                two_digits(spec.hour),
                "Hour",
                !spec.picking_minutes,
                spec.hour_state,
            ),
            colon,
            time_numeral(
                s,
                spec.minute_id,
                spec.minute_msg,
                two_digits(spec.minute),
                "Minute",
                spec.picking_minutes,
                spec.minute_state,
            ),
            period_toggle(
                s,
                "\(name)-period",
                spec.am_id,
                spec.am_msg,
                spec.pm_id,
                spec.pm_msg,
                spec.morning,
                spec.am_state,
                spec.pm_state,
            ),
        ],
    )
}

/// A time picker: the numerals over a clock face.
///
/// The face itself is painted after the tree — `paint_time_dial(frames,
/// "\(name)-dial", scheme, …)` — and this reserves the square for it. Two calls
/// rather than one is the honest cost of a polar arrangement at this boundary,
/// and it is written out rather than hidden behind a component that would
/// silently draw an empty circle.
pub fn time_picker<Msg>(
    s: Scheme,
    name: str,
    spec: Clock<Msg>,
    actions: [ui.Node<Msg>],
) -> ui.Node<Msg> {
    let width = TIME_DIAL_SIDE() + space(6) * 2.0
    var children: [ui.Node<Msg>] = [
        ui.decorated(
            ui.text_of(
                "\(name)-what",
                ui.in_font(ui.style(), label_medium().size, label_medium().weight),
                "Select time",
            ),
            ui.ink(s.on_surface_variant),
        ),
        time_head(s, name, spec),
        ui.box_of(
            "\(name)-face",
            ui.Style {..ui.row(), justify: ui.Justify.Center },
            [time_dial("\(name)-dial")],
        ),
    ]
    if actions.len() > 0 {
        children.push(
            ui.box_of(
                "\(name)-actions",
                ui.spaced(ui.Style{..ui.row(), justify: ui.Justify.End }, space(2)),
                actions,
            ),
        )
    }
    return ui.decorated(
        ui.box_of(
            name,
            ui.spaced(
                ui.padded(
                    ui.Style {..ui.column(), align: ui.Align.Stretch, width: width },
                    space(6),
                ),
                space(4),
            ),
            children,
        ),
        ui.rounded(surface_at(s, LEVEL_3()), SHAPE_EXTRA_LARGE()),
    )
}

/// A time *input*: the numerals with no dial under them.
///
/// Material's compact time picker, and the one a short window gets — a dial is
/// 256dp of height that a landscape phone does not have. The numerals are the
/// same controls, so an application can offer both and switch between them
/// without rewiring anything.
pub fn time_input<Msg>(
    s: Scheme,
    name: str,
    spec: Clock<Msg>,
    actions: [ui.Node<Msg>],
) -> ui.Node<Msg> {
    var children: [ui.Node<Msg>] = [
        ui.decorated(
            ui.text_of(
                "\(name)-what",
                ui.in_font(ui.style(), label_medium().size, label_medium().weight),
                "Enter time",
            ),
            ui.ink(s.on_surface_variant),
        ),
        time_head(s, name, spec),
    ]
    if actions.len() > 0 {
        children.push(
            ui.box_of(
                "\(name)-actions",
                ui.spaced(ui.Style{..ui.row(), justify: ui.Justify.End }, space(2)),
                actions,
            ),
        )
    }
    return ui.decorated(
        ui.box_of(
            name,
            ui.spaced(
                ui.padded(
                    ui.Style {..ui.column(), align: ui.Align.Stretch },
                    space(6),
                ),
                space(4),
            ),
            children,
        ),
        ui.rounded(surface_at(s, LEVEL_3()), SHAPE_EXTRA_LARGE()),
    )
}
