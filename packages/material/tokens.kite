use std/math

// Material Design 3's foundations: colour, type, shape, state.
//
// These are the *tokens* — the numbers a Material design is made of, before
// any component uses them. Keeping them here rather than inside the components
// is the point of a design system: a component asks for `primary` and gets
// whatever the scheme in force says that is, and changing scheme changes every
// component at once without any of them being edited.
//
// Nothing in this file draws. Nothing in it knows what a button is.

// ---- colour ----------------------------------------------------------------
//
// Material 3's colour system is a set of **roles**, not a set of hues. A role
// says what a colour is *for*: `primary` is the accent an action wears,
// `on_primary` is what may legibly be drawn on top of it,
// `surface_container_high` is the layer a raised thing sits on. Swapping light
// for dark swaps the values and changes nothing about which role goes where,
// and that is the whole reason to name them.
//
// Colours are `0xRRGGBB`. There is no alpha at Kite's drawing boundary, which
// has one real consequence for Material and it is dealt with under `state` and
// `elevation` below rather than pretended away.

pub struct Scheme {
    pub primary: int
    pub on_primary: int
    pub primary_container: int
    pub on_primary_container: int
    pub secondary: int
    pub on_secondary: int
    pub secondary_container: int
    pub on_secondary_container: int
    pub tertiary: int
    pub on_tertiary: int
    pub tertiary_container: int
    pub on_tertiary_container: int
    pub error: int
    pub on_error: int
    pub error_container: int
    pub on_error_container: int
    pub surface: int
    pub on_surface: int
    pub on_surface_variant: int
    pub surface_variant: int
    /// The five container tones. In Material 3 these *replace* elevation
    /// overlays: a raised surface is not a shadow, it is a lighter tone.
    pub surface_container_lowest: int
    pub surface_container_low: int
    pub surface_container: int
    pub surface_container_high: int
    pub surface_container_highest: int
    /// The dimmest and brightest a surface gets. Material uses the pair for
    /// large areas that need to read as background without becoming a
    /// container — a scaffold behind cards, a sheet behind a list.
    pub surface_dim: int
    pub surface_bright: int
    /// The colour elevation tints a surface with. Under a renderer with real
    /// translucency this is what a raised surface is mixed toward; here the
    /// container tones already carry it, and it is kept because a caller
    /// drawing its own surface needs it.
    pub surface_tint: int
    pub inverse_surface: int
    pub inverse_on_surface: int
    /// The accent that reads correctly *on* `inverse_surface` — a snackbar's
    /// action, which sits on the opposite scheme to everything around it.
    pub inverse_primary: int
    pub outline: int
    pub outline_variant: int
    /// What a modal darkens the screen behind it with, and what a shadow would
    /// be drawn in. Both are pure black in every Material scheme, light and
    /// dark alike; they are roles rather than constants because a scheme is
    /// allowed to say otherwise.
    pub scrim: int
    pub shadow: int
    /// The *fixed* roles: an accent that stays the same in light and dark.
    ///
    /// Material added these for elements that must not change with the theme —
    /// a brand strip, a chart series, a colour used to identify a thing rather
    /// than to style it. They are the light scheme's container tones, in both
    /// schemes, which is why a dark app still shows them light.
    pub primary_fixed: int
    pub primary_fixed_dim: int
    pub on_primary_fixed: int
    pub on_primary_fixed_variant: int
    pub secondary_fixed: int
    pub secondary_fixed_dim: int
    pub on_secondary_fixed: int
    pub on_secondary_fixed_variant: int
    pub tertiary_fixed: int
    pub tertiary_fixed_dim: int
    pub on_tertiary_fixed: int
    pub on_tertiary_fixed_variant: int
    /// Whether this is a dark scheme. Not decoration: a state layer lightens
    /// on dark and darkens on light, so the blend needs to know.
    pub dark: bool
}

/// The MD3 **baseline** light scheme — the default, the one a Material app
/// gets before anyone picks a source colour.
///
/// Every value here is a *tone of a palette*, and `color.kite` is where those
/// come from: `scheme_from(0x6750a4, false)` reproduces this table, because
/// `#6750A4` is the seed Material generated it from. Keeping the numbers
/// written out anyway is worth the duplication — a scheme is thirty-odd
/// searches through a colour appearance model, and an application that only
/// ever wants the default should not have to run them to start up.
pub fn light() -> Scheme {
    return Scheme{
        primary: 0x6750a4,
        on_primary: 0xffffff,
        primary_container: 0xeaddff,
        on_primary_container: 0x21005d,
        secondary: 0x625b71,
        on_secondary: 0xffffff,
        secondary_container: 0xe8def8,
        on_secondary_container: 0x1d192b,
        tertiary: 0x7d5260,
        on_tertiary: 0xffffff,
        tertiary_container: 0xffd8e4,
        on_tertiary_container: 0x31111d,
        error: 0xba1a1a,
        on_error: 0xffffff,
        error_container: 0xffdad6,
        on_error_container: 0x410002,
        surface: 0xfef7ff,
        on_surface: 0x1d1b20,
        on_surface_variant: 0x49454f,
        surface_variant: 0xe7e0ec,
        surface_container_lowest: 0xffffff,
        surface_container_low: 0xf7f2fa,
        surface_container: 0xf3edf7,
        surface_container_high: 0xece6f0,
        surface_container_highest: 0xe6e0e9,
        surface_dim: 0xded8e1,
        surface_bright: 0xfef7ff,
        surface_tint: 0x6750a4,
        inverse_surface: 0x322f35,
        inverse_on_surface: 0xf5eff7,
        inverse_primary: 0xd0bcff,
        outline: 0x79747e,
        outline_variant: 0xcac4d0,
        scrim: 0x000000,
        shadow: 0x000000,
        primary_fixed: 0xeaddff,
        primary_fixed_dim: 0xd0bcff,
        on_primary_fixed: 0x21005d,
        on_primary_fixed_variant: 0x4f378b,
        secondary_fixed: 0xe8def8,
        secondary_fixed_dim: 0xccc2dc,
        on_secondary_fixed: 0x1d192b,
        on_secondary_fixed_variant: 0x4a4458,
        tertiary_fixed: 0xffd8e4,
        tertiary_fixed_dim: 0xefb8c8,
        on_tertiary_fixed: 0x31111d,
        on_tertiary_fixed_variant: 0x633b48,
        dark: false,
    }
}

/// The MD3 baseline dark scheme.
pub fn dark() -> Scheme {
    return Scheme{
        primary: 0xd0bcff,
        on_primary: 0x381e72,
        primary_container: 0x4f378b,
        on_primary_container: 0xeaddff,
        secondary: 0xccc2dc,
        on_secondary: 0x332d41,
        secondary_container: 0x4a4458,
        on_secondary_container: 0xe8def8,
        tertiary: 0xefb8c8,
        on_tertiary: 0x492532,
        tertiary_container: 0x633b48,
        on_tertiary_container: 0xffd8e4,
        error: 0xffb4ab,
        on_error: 0x690005,
        error_container: 0x93000a,
        on_error_container: 0xffdad6,
        surface: 0x141218,
        on_surface: 0xe6e0e9,
        on_surface_variant: 0xcac4d0,
        surface_variant: 0x49454f,
        surface_container_lowest: 0x0f0d13,
        surface_container_low: 0x1d1b20,
        surface_container: 0x211f26,
        surface_container_high: 0x2b2930,
        surface_container_highest: 0x36343b,
        surface_dim: 0x141218,
        surface_bright: 0x3b383e,
        surface_tint: 0xd0bcff,
        inverse_surface: 0xe6e0e9,
        inverse_on_surface: 0x322f35,
        inverse_primary: 0x6750a4,
        outline: 0x938f99,
        outline_variant: 0x49454f,
        scrim: 0x000000,
        shadow: 0x000000,
        // The fixed roles do not change between the schemes. That is what
        // "fixed" means, and it is why these repeat the light values exactly.
        primary_fixed: 0xeaddff,
        primary_fixed_dim: 0xd0bcff,
        on_primary_fixed: 0x21005d,
        on_primary_fixed_variant: 0x4f378b,
        secondary_fixed: 0xe8def8,
        secondary_fixed_dim: 0xccc2dc,
        on_secondary_fixed: 0x1d192b,
        on_secondary_fixed_variant: 0x4a4458,
        tertiary_fixed: 0xffd8e4,
        tertiary_fixed_dim: 0xefb8c8,
        on_tertiary_fixed: 0x31111d,
        on_tertiary_fixed_variant: 0x633b48,
        dark: true,
    }
}

pub fn scheme_of(is_dark: bool) -> Scheme {
    if is_dark {
        return dark()
    }
    return light()
}

// ---- blending --------------------------------------------------------------
//
// The one piece of arithmetic this file needs, and the reason it needs it.
//
// Material specifies hover, focus, pressed and disabled as **state layers**:
// the role colour at 8%, 10%, 12% opacity over the component. Kite's drawing
// boundary has no alpha, so a state layer cannot be drawn as a layer. It can be
// *computed*: mixing the two colours at that fraction produces exactly the
// pixel the alpha blend would have produced, because the thing underneath is a
// known flat colour. That is true here and would not be true over a photograph,
// which is the honest limit of this approach and is stated rather than hidden.

fn channel(colour: int, shift: int) -> int {
    return (colour >> shift) & 255
}

/// `a` and `b` mixed, with `t` in 0..1 being how much of `b`.
pub fn mix(a: int, b: int, t: float) -> int {
    let amount = math.clamp(t, 0.0, 1.0)
    let r = blend(channel(a, 16), channel(b, 16), amount)
    let g = blend(channel(a, 8), channel(b, 8), amount)
    let bl = blend(channel(a, 0), channel(b, 0), amount)
    return (r * 65536) + (g * 256) + bl
}

fn blend(from: int, to: int, t: float) -> int {
    let out = math.lerp(from as float, to as float, t)
    return math.round_to(math.clamp(out, 0.0, 255.0))
}

// Material's state-layer opacities, as tokens rather than as literals at each
// use. They are four numbers that appear in every component in the system, and
// a design that wants heavier feedback changes them here rather than in ninety
// places.

pub fn HOVER_OPACITY() -> float {
    return 0.08
}

pub fn FOCUS_OPACITY() -> float {
    return 0.10
}

pub fn PRESS_OPACITY() -> float {
    return 0.10
}

/// What something being dragged wears. Heavier than a press because a drag
/// lasts, and has to stay legible against whatever it is passing over.
pub fn DRAG_OPACITY() -> float {
    return 0.16
}

/// Disabled content is `on_surface` at 38%; a disabled container at 12%.
pub fn DISABLED_INK_OPACITY() -> float {
    return 0.38
}

pub fn DISABLED_CONTAINER_OPACITY() -> float {
    return 0.12
}

/// A state layer of `role` over `surface`, at Material's own opacities.
pub fn hovered(surface: int, role: int) -> int {
    return mix(surface, role, HOVER_OPACITY())
}

pub fn focused(surface: int, role: int) -> int {
    return mix(surface, role, FOCUS_OPACITY())
}

pub fn pressed(surface: int, role: int) -> int {
    return mix(surface, role, PRESS_OPACITY())
}

/// A state layer at a *fraction* of its opacity — a hover that is halfway in.
///
/// This is the whole difference between a Material control and a control that
/// merely uses Material's colours. The layer is not on or off; it arrives over
/// two hundred milliseconds, and every intermediate value is a real colour that
/// has to be computed rather than picked from a table.
pub fn layer(surface: int, role: int, opacity: float, amount: float) -> int {
    return mix(surface, role, opacity * clampf(amount, 0.0, 1.0))
}

/// What a scrim leaves of what is behind it: black at 32%, which is Material's
/// own figure for a modal backdrop.
pub fn scrimmed(behind: int, scheme: Scheme) -> int {
    return mix(behind, scheme.scrim, 0.32)
}

/// Disabled content is `on_surface` at 38%, and a disabled container is
/// `on_surface` at 12% — both over whatever is behind, which is why the
/// backdrop is an argument.
pub fn disabled_ink(scheme: Scheme, behind: int) -> int {
    return mix(behind, scheme.on_surface, DISABLED_INK_OPACITY())
}

pub fn disabled_container(scheme: Scheme, behind: int) -> int {
    return mix(behind, scheme.on_surface, DISABLED_CONTAINER_OPACITY())
}

// ---- elevation -------------------------------------------------------------
//
// Material 3 draws elevation two ways at once: a shadow, and a *tonal* shift
// where a higher surface takes a container colour further from the background.
//
// There is no shadow here, and there cannot be one: a shadow is a soft alpha
// gradient and the boundary has neither softness nor alpha. Approximating one
// with a grey rectangle behind the card is what a hundred canvas UIs do and it
// looks like exactly what it is.
//
// The tonal half is not an approximation. It is Material's own rule — in the
// dark scheme the tonal shift is the *whole* of elevation, shadows being
// nearly invisible on dark surfaces — so a Material 3 layout built only out of
// container tones is a correct Material 3 layout, and the omission costs a
// drop shadow on light backgrounds rather than the system.

pub fn LEVEL_0() -> int {
    return 0
}

pub fn LEVEL_1() -> int {
    return 1
}

pub fn LEVEL_2() -> int {
    return 2
}

pub fn LEVEL_3() -> int {
    return 3
}

pub fn LEVEL_4() -> int {
    return 4
}

pub fn LEVEL_5() -> int {
    return 5
}

/// The surface colour at a level of elevation.
pub fn surface_at(scheme: Scheme, level: int) -> int {
    if level <= 0 {
        return scheme.surface
    }
    if level == 1 {
        return scheme.surface_container_low
    }
    if level == 2 {
        return scheme.surface_container
    }
    if level == 3 {
        return scheme.surface_container_high
    }
    return scheme.surface_container_highest
}

// ---- shape -----------------------------------------------------------------
//
// Material's shape scale, in dp. `full` is not a number: it means a radius of
// half the shorter side, which the painter clamps to — so one value works for a
// 40dp button and a 56dp FAB alike.

pub fn SHAPE_NONE() -> float {
    return 0.0
}

pub fn SHAPE_EXTRA_SMALL() -> float {
    return 4.0
}

pub fn SHAPE_SMALL() -> float {
    return 8.0
}

pub fn SHAPE_MEDIUM() -> float {
    return 12.0
}

pub fn SHAPE_LARGE() -> float {
    return 16.0
}

pub fn SHAPE_EXTRA_LARGE() -> float {
    return 28.0
}

/// A radius past half the shorter side, which the painter clamps. Any number
/// this large is a pill; 9999 says so without inviting arithmetic.
pub fn SHAPE_FULL() -> float {
    return 9999.0
}

// ---- typography ------------------------------------------------------------
//
// Material's type scale is fifteen roles in five groups. A role is a size *and*
// a weight — `title_medium` is 16dp at 500, and the same size at 400 reads as
// body text sitting in a title's position, which is the mistake the scale
// exists to prevent.
//
// Line height is the host font's, not Material's: only the host knows the font,
// and a line height chosen here would be a number the text does not fit in.

pub struct TypeRole {
    pub size: float
    pub weight: int
}

fn role(size: float, weight: int) -> TypeRole {
    return TypeRole{ size: size, weight: weight }
}

pub fn REGULAR() -> int {
    return 400
}

pub fn MEDIUM() -> int {
    return 500
}

pub fn display_large() -> TypeRole {
    return role(57.0, REGULAR())
}

pub fn display_medium() -> TypeRole {
    return role(45.0, REGULAR())
}

pub fn display_small() -> TypeRole {
    return role(36.0, REGULAR())
}

pub fn headline_large() -> TypeRole {
    return role(32.0, REGULAR())
}

pub fn headline_medium() -> TypeRole {
    return role(28.0, REGULAR())
}

pub fn headline_small() -> TypeRole {
    return role(24.0, REGULAR())
}

pub fn title_large() -> TypeRole {
    return role(22.0, REGULAR())
}

pub fn title_medium() -> TypeRole {
    return role(16.0, MEDIUM())
}

pub fn title_small() -> TypeRole {
    return role(14.0, MEDIUM())
}

pub fn body_large() -> TypeRole {
    return role(16.0, REGULAR())
}

pub fn body_medium() -> TypeRole {
    return role(14.0, REGULAR())
}

pub fn body_small() -> TypeRole {
    return role(12.0, REGULAR())
}

pub fn label_large() -> TypeRole {
    return role(14.0, MEDIUM())
}

pub fn label_medium() -> TypeRole {
    return role(12.0, MEDIUM())
}

pub fn label_small() -> TypeRole {
    return role(11.0, MEDIUM())
}

// ---- spacing ---------------------------------------------------------------
//
// Material's grid is 4dp. Every gap and inset in this package is a multiple of
// it, which is most of what makes a Material layout recognisable at a glance.

pub fn GRID() -> float {
    return 4.0
}

pub fn space(units: int) -> float {
    return GRID() * (units as float)
}

// ---- window size classes ------------------------------------------------------
//
// Material's own breakpoints, and the reason they are here rather than in an
// application: they are part of the specification, they are the same three
// numbers for every Material app, and the layout decisions that hang off them —
// a navigation rail becomes a bottom bar, a two-pane view becomes one — are
// design-system decisions rather than product ones.
//
// The widths are of the *window*, in dp. A component inside a smaller box asks
// about that box instead; nothing here reads a global.

pub fn WINDOW_COMPACT() -> int {
    return 0
}

pub fn WINDOW_MEDIUM() -> int {
    return 1
}

pub fn WINDOW_EXPANDED() -> int {
    return 2
}

/// Compact below 600dp — a phone held upright. Medium to 840dp — a tablet, or a
/// window someone has made narrow. Expanded above that.
pub fn window_class(width: float) -> int {
    if width < 600.0 {
        return WINDOW_COMPACT()
    }
    if width < 840.0 {
        return WINDOW_MEDIUM()
    }
    return WINDOW_EXPANDED()
}

/// Whether a navigation rail fits. Below the medium breakpoint Material puts
/// navigation at the bottom instead, because a rail costs 80dp of a width that
/// does not have 80dp to spare.
pub fn has_rail(width: float) -> bool {
    return window_class(width) != WINDOW_COMPACT()
}

pub fn RAIL_WIDTH() -> float {
    return 80.0
}

/// A navigation bar: the compact answer to a rail, 80dp tall across the bottom.
pub fn NAV_BAR_HEIGHT() -> float {
    return 80.0
}
