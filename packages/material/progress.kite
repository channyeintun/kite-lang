use std/ui
use std/math

// Progress indicators: linear and circular, determinate and not.
//
// ---- why the circular one is painted rather than laid out --------------------
//
// A linear indicator is two rectangles, so it is a node like everything else. A
// circular one is an *arc*, and the drawing boundary has no arcs: `draw.rrect`
// draws a rounded rectangle, and a rounded rectangle at half its own side is a
// circle but never a piece of one.
//
// An arc can still be drawn — as a run of small circles along it, which is what
// a stroked path is once it has been flattened, and is how every renderer draws
// one underneath. That needs `draw` calls in a loop rather than a tree of boxes,
// so the circular indicator comes in two halves: a node that reserves the space,
// and a painter that fills it, called after `paint` the way the ripple overlay
// is.
//
//     let node = circular_progress("loading", 48.0)   // in `view`
//     …
//     material.paint(frames, model.ui)                 // the tree
//     paint_circular(frames, "loading", scheme, 0.4)   // the arc, on top
//
// Two calls rather than one is the honest cost of an arc at this boundary, and
// it is written out rather than hidden behind a component that would silently
// draw nothing.

// ---- linear ----------------------------------------------------------------------

fn LINEAR_HEIGHT() -> float {
    return 4.0
}

/// The gap Material 3 leaves between the active and inactive halves of a
/// linear indicator, and the width of the dot it leaves at the far end.
fn LINEAR_GAP() -> float {
    return 4.0
}

/// A linear progress indicator: a track with a filled portion, `progress` in
/// 0..1.
///
/// Material 3 separates the two halves with a gap and marks the end of the
/// track with a stop indicator, which is what tells a full bar from a bar that
/// has simply been drawn wide.
pub fn linear_progress<Msg>(name: str, s: Scheme, progress: float, width: float) -> ui.Node<Msg> {
    let fraction = clampf(progress, 0.0, 1.0)
    let stop = LINEAR_HEIGHT()
    let usable = maxf(0.0, width - LINEAR_GAP() - stop)
    let filled = usable * fraction
    let rest = usable - filled
    return ui.box_of(
        name,
        ui.Style {
            ..ui.row(),
            align: ui.Align.Center,
            width: width,
            height: LINEAR_HEIGHT(),
            gap: LINEAR_GAP() / 2.0,
        },
        [
            bar("\(name)-active", filled, LINEAR_HEIGHT(), s.primary),
            bar("\(name)-track", rest, LINEAR_HEIGHT(), s.surface_container_highest),
            bar("\(name)-stop", stop, LINEAR_HEIGHT(), s.primary),
        ],
    )
}

/// A linear indicator with no idea how long it will take.
///
/// `phase` runs from 0 to 1 and loops; the application steps it from the
/// milliseconds it is handed each frame, which is the only place time exists.
/// Material sweeps a bar along the track and back; this is that sweep, and it
/// is pure layout — a leading spacer, the bar, and whatever is left.
pub fn linear_indeterminate<Msg>(name: str, s: Scheme, phase: float, width: float) -> ui.Node<Msg> {
    let t = phase - math.floor(phase)
    // The bar is a third of the track and travels one and a third track-widths,
    // so it enters at one end while still leaving at the other.
    let bar_width = width / 3.0
    let travel = width + bar_width
    let head = math.lerp(-bar_width, width, ease(standard(), t))
    let lead = maxf(0.0, head)
    let shown = minf(bar_width, minf(width - lead, head + bar_width))
    let trail = maxf(0.0, width - lead - shown)
    return ui.decorated(
        ui.box_of(
            name,
            ui.Style {
                ..ui.row(),
                align: ui.Align.Center,
                width: width,
                height: LINEAR_HEIGHT(),
            },
            [
                spacer("\(name)-lead", lead),
                bar("\(name)-bar", maxf(0.0, shown), LINEAR_HEIGHT(), s.primary),
                spacer("\(name)-trail", trail),
            ],
        ),
        ui.rounded(s.surface_container_highest, SHAPE_FULL()),
    )
}

/// A phase from 0 to 1 that loops every `period` milliseconds.
///
/// What an indeterminate indicator needs and cannot have on its own: the
/// application accumulates the milliseconds it is handed, and this turns the
/// running total into the fraction the indicator wants.
pub fn phase_of(elapsed: float, period: float) -> float {
    if period <= 0.0 {
        return 0.0
    }
    let t = elapsed / period
    return t - math.floor(t)
}

// ---- circular -----------------------------------------------------------------------

pub fn CIRCULAR_SIDE() -> float {
    return 48.0
}

fn CIRCULAR_STROKE() -> float {
    return 4.0
}

/// The space a circular indicator occupies. It draws nothing — see the note at
/// the top of this file — so it is a box of the right size and no more.
pub fn circular_progress<Msg>(name: str, side: float) -> ui.Node<Msg> {
    return ui.box_of(name, ui.sized(ui.style(), side, side), [])
}

/// The arc of a determinate circular indicator, drawn into the box
/// [`circular_progress`] reserved.
///
/// Material starts the arc at twelve o'clock and runs it clockwise, and leaves
/// the rest of the ring in the track colour.
pub fn paint_circular(frames: [ui.Frame], name: str, s: Scheme, progress: float) {
    let box = ui.frame_of(frames, name)
    if box == nil {
        return
    }
    let fraction = clampf(progress, 0.0, 1.0)
    let start = -math.pi() / 2.0
    // The track first, then the arc over it, so the two meet with no seam.
    arc(box.rect, start, math.tau(), s.surface_container_highest)
    arc(box.rect, start, math.tau() * fraction, s.primary)
}

/// The same with no idea how long it will take: an arc that spins, and grows
/// and shrinks as it goes.
///
/// `phase` loops from 0 to 1 — [`phase_of`] makes one — and Material's own
/// indeterminate turns twice per cycle while the sweep breathes between a tenth
/// of the ring and three quarters of it.
pub fn paint_circular_indeterminate(frames: [ui.Frame], name: str, s: Scheme, phase: float) {
    let box = ui.frame_of(frames, name)
    if box == nil {
        return
    }
    let t = phase - math.floor(phase)
    let turn = math.tau() * 2.0 * t
    // A sine makes the sweep grow and shrink smoothly and return to where it
    // started, so the loop has no seam in it.
    let sweep = math.lerp(0.1, 0.75, (1.0 - math.cos(math.tau() * t)) / 2.0)
    arc(box.rect, -math.pi() / 2.0 + turn, math.tau() * sweep, s.primary)
}

// ---- loading indicator ----------------------------------------------------------------
//
// Material 3 Expressive's third indicator, and the one that is neither of the
// other two: a shape that turns and *changes shape* while it turns. It says
// "working" without claiming to know how much is left, which is what a spinner
// has always been for, and Material's answer is a sequence of seven soft
// polygons — a cookie, a clover, a burst — morphing into one another.
//
// ---- what a shape is at this boundary ---------------------------------------------
//
// There are no paths. `draw.rrect` draws an axis-aligned rounded rectangle and
// there is no transform to turn one with, so a seven-lobed clover cannot be
// drawn as a shape and cannot be rotated if it were.
//
// It can be *filled*. The shapes are all star-convex about their centre, so
// each is a radius as a function of angle, and a run of horizontal bars from
// the left edge of the shape to the right edge at each height fills it exactly.
// That is scanline rasterisation, which is what a GPU does underneath, done at
// forty-eight rows instead of at the pixel — coarse enough to see if you look
// for it on a large one, and honest about being a fill rather than a path.
//
// The morph is likewise continuous rather than a sequence of seven. A polygon's
// radius formula takes the side count as a number, and nothing stops that
// number being 5.4: what comes out is a smooth blend between a pentagon and a
// hexagon. Material's seven shapes are a designer's choice of seven points
// along that continuum, and the continuum is what this package can draw.

/// Material's contained loading indicator is 48dp; the shape inside it is 38.
pub fn LOADING_SIDE() -> float {
    return 48.0
}

fn LOADING_SHAPE() -> float {
    return 38.0
}

/// How many bars a filled shape is drawn out of.
///
/// Fixed rather than proportional to the size, for the reason the arc's step
/// count is fixed: the renderer keeps a retained scene indexed by draw call,
/// and a frame whose call count differs from the last cannot be patched. An
/// indicator is the one thing on a screen that redraws every frame, so it is
/// the last thing that should force a full repaint while it does.
fn LOADING_ROWS() -> int {
    return 48
}

/// The space a loading indicator occupies. It draws nothing — see the note
/// above — so it is a square of the right size and no more.
pub fn loading_indicator<Msg>(name: str, side: float) -> ui.Node<Msg> {
    return ui.box_of(name, ui.sized(ui.style(), side, side), [])
}

/// The distance from the centre to the edge of a rounded regular polygon, as a
/// fraction of the circle it fits in.
///
/// `sides` need not be a whole number, and that is the point of it: 5.4 is a
/// real shape part-way between a pentagon and a hexagon, which is how one
/// Material shape becomes the next without either of them being drawn twice.
/// `rounding` blends toward the circle — 0 is the polygon exactly, 1 is a
/// circle, and Material's shapes live near the middle.
///
/// Public because it is the part of a morphing blob with a right answer: at a
/// vertex it is 1, at the middle of a face it is the apothem, and it is the
/// same at every equivalent angle however far the shape has turned.
///
/// Angle zero is a *vertex*, not a face — the shape points east before it is
/// spun. Which of the two is at zero is arbitrary and has to be written down,
/// because the difference is half a face and a caller checking one against the
/// other would find every answer wrong by exactly that.
pub fn polygon_radius(sides: float, rounding: float, angle: float) -> float {
    if sides < 3.0 {
        return 1.0
    }
    let step = math.tau() / sides
    // Folded into one wedge and measured from that wedge's middle, so the
    // formula below is the same for every face.
    let within = angle - math.floor(angle / step) * step - step / 2.0
    let apothem = math.cos(math.pi() / sides)
    let sharp = apothem / math.cos(within)
    return math.lerp(sharp, 1.0, clampf(rounding, 0.0, 1.0))
}

/// How many sides the shape has at a given point in its cycle.
///
/// Four to seven and back, on a cosine so the loop closes on itself: a sequence
/// that ran four to seven and jumped back would show the jump once a cycle,
/// which is the one frame an indicator must not have.
pub fn loading_sides(phase: float) -> float {
    let t = phase - math.floor(phase)
    return math.lerp(4.0, 7.0, (1.0 - math.cos(math.tau() * t)) / 2.0)
}

/// The uncontained loading indicator: the shape alone, in the accent.
pub fn paint_loading(frames: [ui.Frame], name: str, s: Scheme, phase: float) {
    paint_loading_shape(frames, name, s.primary, phase)
}

/// The contained one: the same shape on a filled circle, for a loading
/// indicator that has to stay visible over content rather than over a surface.
pub fn paint_contained_loading(frames: [ui.Frame], name: str, s: Scheme, phase: float) {
    let box = ui.frame_of(frames, name)
    if box == nil {
        return
    }
    let rect = box.rect
    let side = minf(rect.width, rect.height)
    if side <= 0.0 {
        return
    }
    let cx = rect.x + rect.width / 2.0
    let cy = rect.y + rect.height / 2.0
    draw.rrect(cx - side / 2.0, cy - side / 2.0, side, side, side / 2.0, s.secondary_container)
    paint_loading_shape(frames, name, s.primary, phase)
}

fn paint_loading_shape(frames: [ui.Frame], name: str, colour: int, phase: float) {
    let box = ui.frame_of(frames, name)
    if box == nil {
        return
    }
    let rect = box.rect
    let side = minf(rect.width, rect.height)
    if side <= 0.0 {
        return
    }
    let t = phase - math.floor(phase)
    // The shape occupies the same fraction of its box as Material's 38 in 48,
    // so an indicator asked for at any size keeps its proportions.
    let radius = side / 2.0 * (LOADING_SHAPE() / LOADING_SIDE())
    let cx = rect.x + rect.width / 2.0
    let cy = rect.y + rect.height / 2.0
    // Two turns per cycle, which is the rate Material's own indeterminate
    // circular indicator spins at — the two are meant to look related.
    blob(cx, cy, radius, loading_sides(t), 0.4, math.tau() * 2.0 * t, colour)
}

/// A star-convex shape, filled as a stack of horizontal bars.
///
/// The boundary is sampled at a fixed number of angles and each sample widens
/// the row it lands in. The sampling is dense enough that no row is skipped —
/// consecutive samples are never a whole row apart in height, which is what
/// would leave a gap across the middle where the shape is steepest.
fn blob(cx: float, cy: float, radius: float, sides: float, rounding: float, spin: float, colour: int) {
    let rows = LOADING_ROWS()
    let height = radius * 2.0 / (rows as float)
    var left: [float] = []
    var right: [float] = []
    for i in 0..rows {
        // An empty row is one whose left edge is past its right: nothing is
        // drawn for it and the call is still made, which is what keeps the
        // count the same from frame to frame.
        left.push(radius * 2.0)
        right.push(-radius * 2.0)
    }
    let samples = 240
    for k in 0..samples {
        let angle = math.tau() * ((k as float) / (samples as float))
        let r = radius * polygon_radius(sides, rounding, angle - spin)
        let x = cx + r * math.cos(angle)
        let y = cy + r * math.sin(angle)
        var row = math.trunc_to((y - (cy - radius)) / height)
        row = clamp(row, 0, rows - 1)
        left[row] = minf(left[row], x - cx)
        right[row] = maxf(right[row], x - cx)
    }
    for i in 0..rows {
        let width = maxf(0.0, right[i] - left[i])
        draw.rrect(cx + left[i], cy - radius + (i as float) * height, width, height, 0.0, colour)
    }
}

/// One arc, as the run of overlapping circles a stroked arc is once it has been
/// flattened.
///
/// The number of steps comes from the geometry rather than from the sweep, so a
/// given indicator makes the same number of draw calls whatever it is showing.
/// That is not a micro-optimisation: the renderer keeps a retained scene graph
/// indexed by call, and a frame with a different number of calls than the last
/// cannot be patched — it redraws the window. An indicator whose call count
/// followed its progress would force one of those on almost every frame.
fn arc(rect: ui.Rect, from: float, sweep: float, colour: int) {
    let side = minf(rect.width, rect.height)
    if side <= 0.0 {
        return
    }
    let stroke = minf(CIRCULAR_STROKE(), side / 4.0)
    let radius = (side - stroke) / 2.0
    let cx = rect.x + rect.width / 2.0
    let cy = rect.y + rect.height / 2.0
    // Spaced at half the stroke, which is what makes consecutive dots overlap
    // into a line rather than a dotted one.
    let steps = maxf(8.0, math.tau() * radius / (stroke / 2.0))
    let count = math.round_to(steps)
    for i in 0..count + 1 {
        let along = (i as float) / (count as float)
        let angle = from + sweep * along
        let x = cx + radius * math.cos(angle)
        let y = cy + radius * math.sin(angle)
        draw.rrect(x - stroke / 2.0, y - stroke / 2.0, stroke, stroke, stroke / 2.0, colour)
    }
}
