use std/ui

// The carousel: a row of items where the items are not all the same size.
//
// That is the whole of what makes it a component rather than a scrolling row.
// Material's carousel gives the item at the leading edge the room to be looked
// at and lets the ones behind it shrink toward the trailing edge, so a screen
// says "here is one thing, and there are more" in a single row — which is the
// sentence a grid of equal thumbnails cannot say.
//
// ---- what is a layout decision and what is a scroll ------------------------------
//
// A real carousel scrolls, and as it scrolls each item passes through the sizes:
// what is large becomes medium, then small, then leaves. Kite's layout has no
// scrolling of its own — `ui.scroll_extent` and `ui.paint_scrolled` are the
// application's, and the offset lives in the application's model — so what this
// file provides is the *arrangement* at a given offset, and the application
// moves through the arrangements.
//
// [`item_widths`] is that arrangement, and it is public and separate from any
// node for a reason: it is the part of a carousel that has a right answer. The
// widths sum to the viewport, and a test can say so; whether the picture inside
// the first one is the right picture is not something this package can check.

/// Which of Material's four carousels this is.
pub enum Layout {
    /// One item at a time, with the next one peeking past the trailing edge to
    /// say that it is there. What a featured story or a single large photo
    /// wants.
    Hero
    /// Large, then medium, then small: the arrangement for browsing many items
    /// where the first is only a little more important than the rest.
    MultiBrowse
    /// Every item the same size, scrolling off both edges without resizing.
    /// The one to reach for when the items are a set rather than a ranking.
    Uncontained
    /// One item filling the window, scrolled the short way. Material's carousel
    /// for a photo viewer.
    FullScreen
}

/// The sizes a carousel's items are allowed to take.
///
/// Three of them, which is Material's own vocabulary: an item is large, medium
/// or small, and the arrangement decides which items are which. Keeping the
/// three as numbers rather than as an enum is what lets a caller widen a
/// carousel for a tablet without a new layout.
pub struct Carousel {
    pub layout: Layout
    /// The largest an item is allowed to be. For [`Layout.Uncontained`] it is
    /// every item's width rather than a ceiling, there being nothing to shrink
    /// toward.
    pub large: float
    pub medium: float
    /// Material's smallest item: wide enough to say something is there, narrow
    /// enough that nobody tries to read it. 56dp.
    pub small: float
    pub height: float
    pub gap: float
}

/// The 8dp Material leaves between carousel items — the same 8dp everything
/// else in the system leaves, which is why a carousel lines up with the buttons
/// under it.
fn CAROUSEL_GAP() -> float {
    return space(2)
}

fn SMALL_ITEM() -> float {
    return 56.0
}

fn MEDIUM_ITEM() -> float {
    return 112.0
}

/// A hero carousel of a given height. Its large item takes whatever the small
/// one leaves, so it is as wide as the window and needs no width of its own.
pub fn hero(height: float) -> Carousel {
    return Carousel{
        layout: Layout.Hero,
        large: 0.0,
        medium: MEDIUM_ITEM(),
        small: SMALL_ITEM(),
        height: height,
        gap: CAROUSEL_GAP(),
    }
}

pub fn multi_browse(height: float) -> Carousel {
    return Carousel{
        layout: Layout.MultiBrowse,
        large: 0.0,
        medium: MEDIUM_ITEM(),
        small: SMALL_ITEM(),
        height: height,
        gap: CAROUSEL_GAP(),
    }
}

/// An uncontained carousel, whose items are all `item` wide. The one layout
/// that takes a width rather than deriving one: nothing resizes, so nothing can
/// be derived.
pub fn uncontained(item: float, height: float) -> Carousel {
    return Carousel{
        layout: Layout.Uncontained,
        large: item,
        medium: item,
        small: item,
        height: height,
        gap: CAROUSEL_GAP(),
    }
}

/// A full-screen carousel. Its items are the size of the window, so the height
/// is the window's and the width comes from the viewport at arrangement time.
pub fn full_screen(height: float) -> Carousel {
    return Carousel{
        layout: Layout.FullScreen,
        large: 0.0,
        medium: 0.0,
        small: 0.0,
        height: height,
        // Nothing to space: there is one item across the window and the next is
        // a scroll away rather than a gap away.
        gap: 0.0,
    }
}

/// The width of every item in a carousel, in order.
///
/// Every item gets a width, including the ones past the trailing edge — a
/// carousel is a scrolling row and what is off-screen still has to be laid out
/// to be scrolled into. Past the arrangement's own items they are all small,
/// which is the size they will be when they arrive.
///
/// For [`Layout.Hero`] and [`Layout.MultiBrowse`] the visible items and the gaps
/// between them add up to exactly the viewport. That is the property worth
/// having: a carousel whose arrangement was a fraction over would show a sliver
/// of a fourth item that the design did not ask for, which is the single most
/// common way a carousel looks broken.
pub fn item_widths(spec: Carousel, viewport: float, count: int) -> [float] {
    var out: [float] = []
    if count <= 0 {
        return out
    }
    match spec.layout {
        Uncontained => {
            for i in 0..count {
                out.push(spec.large)
            }
        }
        FullScreen => {
            for i in 0..count {
                out.push(viewport)
            }
        }
        Hero => {
            // One large item and a small one peeking. With a single item there
            // is nothing to peek, so it takes the window.
            if count == 1 {
                out.push(viewport)
            } else {
                out.push(maxf(0.0, viewport - spec.gap - spec.small))
                for i in 1..count {
                    out.push(spec.small)
                }
            }
        }
        MultiBrowse => {
            if count == 1 {
                out.push(viewport)
            } else if count == 2 {
                out.push(maxf(0.0, viewport - spec.gap - spec.small))
                out.push(spec.small)
            } else {
                // Large, medium, small — and the large one is what is left,
                // which is what keeps the three of them exactly a window wide.
                let taken = spec.gap * 2.0 + spec.medium + spec.small
                out.push(maxf(0.0, viewport - taken))
                out.push(spec.medium)
                for i in 2..count {
                    out.push(spec.small)
                }
            }
        }
    }
    return out
}

/// How wide a carousel's whole row is, gaps included.
///
/// What an application hands `ui.scroll_extent` — or rather what it checks its
/// own answer against, since the row is a node and the layout has measured it
/// already. It is here because the arrangement is here, and a caller that wants
/// to know whether a carousel scrolls at all should not have to lay it out to
/// find out.
pub fn carousel_extent(spec: Carousel, viewport: float, count: int) -> float {
    let widths = item_widths(spec, viewport, count)
    var total = 0.0
    for i in 0..widths.len() {
        total = total + widths[i]
    }
    if widths.len() > 1 {
        total = total + spec.gap * ((widths.len() - 1) as float)
    }
    return total
}

/// One item, at whatever width the arrangement gave it.
///
/// The content is the caller's node — a picture, a card, whatever the carousel
/// is a carousel *of* — and this is the container around it: Material's
/// extra-large corners, a container tone under whatever does not fill it, and
/// the width the arrangement decided.
///
/// The content is not clipped to those corners. Nothing at this drawing
/// boundary clips to a rounded rectangle — `draw.clip` takes a rectangle and
/// means it — so an image inside one of these has square corners over the
/// container's round ones. That is visible and worth knowing about; the honest
/// answer is a picture with its own rounded corners, and the dishonest one
/// would have been to say nothing.
pub fn carousel_item<Msg>(
    name: str,
    s: Scheme,
    content: [ui.Node<Msg>],
    width: float,
    height: float,
) -> ui.Node<Msg> {
    return ui.decorated(
        ui.box_of(
            name,
            ui.Style {
                ..ui.column(),
                align: ui.Align.Stretch,
                justify: ui.Justify.End,
                width: width,
                height: height,
            },
            content,
        ),
        ui.inked(
            ui.rounded(s.surface_container_high, SHAPE_EXTRA_LARGE()),
            s.on_surface,
        ),
    )
}

/// An item that can be pressed, which is what a carousel of destinations wants.
pub fn clickable_carousel_item<Msg>(
    name: str,
    msg: Msg,
    s: Scheme,
    label: str,
    content: [ui.Node<Msg>],
    width: float,
    height: float,
    state: State,
) -> ui.Node<Msg> {
    let container = layered(s.surface_container_high, s.on_surface, state)
    let inner: ui.Node<Msg> = ui.decorated(
        ui.box_of(
            name,
            ui.Style {
                ..ui.column(),
                align: ui.Align.Stretch,
                justify: ui.Justify.End,
                width: width,
                height: height,
            },
            content,
        ),
        ui.inked(ui.rounded(container, SHAPE_EXTRA_LARGE()), s.on_surface),
    )
    let whole = ui.means(inner, name, msg, label)
    if state.disabled {
        return ui.disabled(whole)
    }
    return whole
}

/// A carousel item's caption: the label Material lays over the bottom of a
/// picture.
///
/// It is a separate component rather than a parameter because a small item
/// should not have one — 56dp is not enough to read a word in, and a caption
/// that shrank with its item would be a caption nobody can read rather than one
/// that is not there. A caller lays it out for the large item and leaves it off
/// the rest, which is Material's own rule stated where it can be followed.
pub fn carousel_caption<Msg>(name: str, s: Scheme, caption: str, width: float) -> ui.Node<Msg> {
    let role = title_medium()
    return ui.decorated(
        ui.text_of(
            name,
            ui.Style {
                ..ui.in_font(ui.style(), role.size, role.weight),
                width: width,
                padding: ui.insets(space(3)),
            },
            caption,
        ),
        ui.ink(s.on_surface),
    )
}

/// The row itself: the items laid out at the arrangement's widths.
///
/// It takes content rather than finished items because the widths are this
/// function's to decide — an item built by the caller would have had to be
/// built at a width the caller could only get by calling [`item_widths`] first,
/// which is the same work done twice with two chances to disagree.
pub fn carousel<Msg>(
    name: str,
    s: Scheme,
    spec: Carousel,
    items: [[ui.Node<Msg>]],
    viewport: float,
) -> ui.Node<Msg> {
    let widths = item_widths(spec, viewport, items.len())
    var children: [ui.Node<Msg>] = []
    for i in 0..items.len() {
        children.push(carousel_item("\(name)-\(i)", s, items[i], widths[i], spec.height))
    }
    // A full-screen carousel is scrolled the short way, so its items are laid
    // out down the window rather than across it. Everything else is a row.
    let upright = match spec.layout {
        FullScreen => true
        _ => false
    }
    if upright {
        return ui.box_of(
            name,
            ui.Style {..ui.column(), align: ui.Align.Center, gap: spec.gap },
            children,
        )
    }
    return ui.box_of(
        name,
        ui.Style {
            ..ui.row(),
            align: ui.Align.Center,
            gap: spec.gap,
            height: spec.height,
        },
        children,
    )
}
