use std/ui
use std/math

// Hover, focus, press, selection — and the ripple.
//
// This is the part of Material that a pure `view(model) -> Node` cannot do on
// its own. A state layer part-way in is a fact about a control that exists
// *between* frames, and Kite has no mutable globals to hide it in:
// there is nowhere for a component to keep it, and a component that kept it
// would be a component that could not be called twice.
//
// So it lives in the application's model, as a value, like everything else.
// One `Interaction` is threaded through `update`, handed the pointer events as
// they arrive and the milliseconds as they pass, and read by `view` when it
// builds the tree. It is the same shape as the rest of the architecture rather
// than an exception to it.
//
//     pub struct Model {
//         …
//         pub ui: Interaction
//     }
//
//     pub fn update(model: Model, event: int, x: float, y: float, key: str) -> Model {
//         if event == EVENT_MOVE() {
//             return Model{..model, ui: moved(model.ui, frames_of(model), x, y) }
//         }
//         if event == EVENT_DOWN() {
//             return Model{..model, ui: pressed_down(model.ui, frames_of(model), x, y) }
//         }
//         if event == EVENT_UP() {
//             return Model{..model, ui: lifted(model.ui) }
//         }
//         if event == EVENT_FRAME() {
//             return Model{..model, ui: advance(model.ui, x) }
//         }
//         …
//     }
//
// ---- why `advance` returns the value it was given ---------------------------
//
// The host's frame loop runs *while the model keeps changing*. Returning the
// same `Interaction` is how this package says "nothing is moving", and it is
// the only way to say it — there is no `requestAnimationFrame` to decline.
// Every function below is written so that a settled interaction is returned
// identically, and there is a test for it, because getting this wrong does not
// look like a bug: it looks like a laptop with a warm fan.

// ---- what a control is doing --------------------------------------------------

/// One control's reaction to the pointer and the keyboard.
///
/// Four channels, each a `Track` — so a control that is half-hovered when the
/// pointer leaves retreats from where it got to, along the curve, rather than
/// snapping or restarting.
pub struct Reaction {
    pub id: str
    pub hover: Track
    pub focus: Track
    pub press: Track
    pub select: Track
    pub ripple: Ripple
}

/// The press ripple: Material's oldest and most recognisable piece of motion.
///
/// A circle from the point of contact, growing past the edge of the control
/// and fading out. Everything about it is specified — Material Web's own
/// numbers are used below — and all of it is drawable here, because
/// `draw.alpha` gives real translucency and a `draw.rrect` at half its own
/// side is a circle.
pub struct Ripple {
    /// Where the pointer went down, relative to the control's top-left rather
    /// than to the window. A list that scrolls under a held finger moves the
    /// control; the ripple should move with it.
    pub x: float
    pub y: float
    /// The colour, taken from the control's own ink at the moment of the
    /// press. Material's rule is that a ripple is the component's *on* colour
    /// — `on_primary` inside a filled button, `primary` inside a text one —
    /// and a control's ink is already exactly that.
    pub ink: int
    pub grow: Track
    pub fade: Track
    /// How long the press has lasted. Material holds a ripple at full strength
    /// for a minimum time, so that a tap too quick to see still shows one.
    pub held: float
    /// Whether the pointer is still down.
    pub down: bool
    pub live: bool
}

/// Everything the pointer and the keyboard have to say, for a whole window.
pub struct Interaction {
    /// The control under the pointer, or "" for none.
    pub hovered: str
    /// The control the pointer went down on and has not come up from. Material
    /// keeps a control pressed while a finger is held on it and dragged off,
    /// which is what lets someone slide away to cancel.
    pub armed: str
    pub focused: str
    pub reactions: [Reaction]
}

pub fn no_interaction() -> Interaction {
    return Interaction{ hovered: "", armed: "", focused: "", reactions: [] }
}

// ---- the durations these channels use -----------------------------------------
//
// **Hover is not a transition. It is pointer tracking**, and that distinction is
// the whole of what these numbers are for.
//
// The duration scale — `short2`, `short4`, the rest — is for things that
// *travel*: a sheet coming up, an indicator moving between tabs, a dialog
// arriving. A hover state layer travels nowhere. It says "the pointer is here",
// and the only correct time for it to say so is *now*. Give it two hundred
// milliseconds to leave and it goes on claiming the pointer is somewhere it is
// not: drag the cursor down a list of 72dp rows at an ordinary speed — call it
// a row every 140ms — and a row is still half lit when the next two have come
// and gone. What that looks like is a comet tail following the cursor, which is
// exactly what it is.
//
// This file had it slower still, and backwards: 100ms in and 200ms *out*, so
// the trail outlasted the arrival. The reasoning was that Material specifies
// state-layer transitions asymmetrically. It does — for *press*, where a
// release that vanished abruptly reads as a cancellation rather than an
// activation. Hover is not press, and copying the shape of one onto the other
// is how a plausible-sounding rule produces an obviously wrong result.
//
// Material's own implementations are far quicker than the token scale suggests.
// Compose's state layer crosses hover on a **fifteen millisecond linear tween
// in both directions** — one frame at sixty hertz — and Material Web transitions
// its state layer in fifteen milliseconds linear too. Focus is the one that
// gets a real transition, because focus is a *state* rather than a position: it
// outlives the input that set it, so it is allowed to arrive and leave visibly.

/// One frame at sixty hertz. Not a duration so much as "next time you draw".
pub fn HOVER_IN() -> float {
    return 15.0
}

pub fn HOVER_OUT() -> float {
    return 15.0
}

/// Focus persists after the key that set it, so unlike hover it is worth
/// watching arrive — and worth watching leave more slowly than it came.
pub fn FOCUS_IN() -> float {
    return 45.0
}

pub fn FOCUS_OUT() -> float {
    return SHORT_3()
}

/// A press has to feel like it registered *before* the application reacts, so
/// it arrives in a frame. Letting go is the asymmetric one: the layer follows
/// the ripple out rather than snapping off under the finger.
pub fn PRESS_IN() -> float {
    return 15.0
}

pub fn PRESS_OUT() -> float {
    return SHORT_3()
}

/// The curve a state layer crosses on.
///
/// Linear, and Material's implementations agree. At fifteen milliseconds an
/// easing curve is a distinction without a difference — there is one frame to
/// apply it to — and a layer's job is to *be there*, not to make an entrance.
/// The easing tokens are spent on the things that move.
fn layer_curve() -> Easing {
    return linear()
}

/// A selection change moves something — a tab's indicator, a switch's knob, a
/// navigation pill — so it is emphasized rather than standard, and long enough
/// to be seen to travel.
pub fn SELECT_CHANGE() -> float {
    return MEDIUM_1()
}

/// How long a ripple takes to reach the far corner.
pub fn RIPPLE_GROW() -> float {
    return 450.0
}

/// A ripple is never shown for less than this, however brief the tap.
pub fn RIPPLE_MINIMUM() -> float {
    return 225.0
}

pub fn RIPPLE_FADE() -> float {
    return 150.0
}

/// The circle starts at a fifth of the control's longest side rather than at a
/// point, which is what makes a tap read as a splash rather than as a dot that
/// grows.
fn RIPPLE_INITIAL_SCALE() -> float {
    return 0.2
}

/// The circle finishes a little past the far corner, so the last frames of the
/// growth are off the edge and the fade happens on a full container rather
/// than on a circle still visibly short of one.
fn RIPPLE_OVERSHOOT() -> float {
    return 10.0
}

// ---- events -------------------------------------------------------------------
//
// Each takes the frames from the last layout, because what is under a point is
// a question only the layout can answer, and answering it here rather than in
// every application is most of what this file is for.

/// The pointer moved to `(x, y)`.
pub fn moved(inter: Interaction, frames: [ui.Frame], x: float, y: float) -> Interaction {
    let over = control_under(frames, x, y)
    if over == inter.hovered {
        return inter
    }
    return synced(Interaction{..inter, hovered: over })
}

/// The pointer left the window entirely, which is not the same as moving to
/// nothing: a browser sends no `pointermove` for the pixel outside the edge, so
/// a control hovered at the moment the pointer left would stay lit forever.
pub fn left(inter: Interaction) -> Interaction {
    if inter.hovered == "" {
        return inter
    }
    return synced(Interaction{..inter, hovered: "" })
}

/// The pointer went down at `(x, y)`. This is what starts a ripple, and it
/// takes focus as well — clicking a control is a way of focusing it.
pub fn pressed_down(inter: Interaction, frames: [ui.Frame], x: float, y: float) -> Interaction {
    let over = control_under(frames, x, y)
    if over == "" {
        // A press on nothing still moves focus off whatever had it, which is
        // what clicking the background does everywhere else.
        if inter.focused == "" && inter.armed == "" {
            return inter
        }
        return synced(Interaction{..inter, armed: "", focused: "" })
    }
    let started = synced(Interaction{..inter, hovered: over, armed: over, focused: over })
    return with_ripple(started, frames, over, x, y)
}

/// The pointer came up. Whether that was a click is the host's business — it
/// sends `EVENT_CLICK` separately — so all this does is release the press.
pub fn lifted(inter: Interaction) -> Interaction {
    if inter.armed == "" {
        return inter
    }
    var out: [Reaction] = []
    for reaction in inter.reactions {
        if reaction.id == inter.armed {
            out.push(Reaction{..reaction, ripple: Ripple{..reaction.ripple, down: false } })
        } else {
            out.push(reaction)
        }
    }
    return synced(Interaction{..inter, armed: "", reactions: out })
}

/// Focus moved to a control, by Tab or otherwise.
pub fn focus_to(inter: Interaction, id: str) -> Interaction {
    if inter.focused == id {
        return inter
    }
    return synced(Interaction{..inter, focused: id })
}

/// A control became selected, or stopped being.
///
/// Selection is the application's fact, not the pointer's — which tab is open
/// is a thing the model knows and this package cannot. So it is told, at the
/// moment the model changes, and what it does with the telling is animate the
/// indicator that moves as a result.
///
/// It is one call in the same branch of `update` that flips the model's own
/// boolean. Inferring it instead would mean this package reading a model it
/// knows nothing about.
pub fn choose(inter: Interaction, id: str, on: bool) -> Interaction {
    let target = if on { 1.0 } else { 0.0 }
    let existing = reaction_of(inter, id)
    if existing != nil {
        if absf(existing.select.to - target) < 0.000001 {
            return inter
        }
    }
    let ready = ensure(inter, id)
    var out: [Reaction] = []
    for reaction in ready.reactions {
        if reaction.id == id {
            out.push(
                Reaction {
                    ..reaction,
                    select: retargeted(reaction.select, emphasized(), target, SELECT_CHANGE()),
                },
            )
        } else {
            out.push(reaction)
        }
    }
    return Interaction{..ready, reactions: out }
}

/// Every control in `ids` set to whether it is `chosen`, in one call.
///
/// What a tab row or a radio group wants: selecting one deselects the rest, and
/// both halves have to animate or the old indicator sits there while the new
/// one arrives.
pub fn choose_one(inter: Interaction, ids: [str], chosen: str) -> Interaction {
    var out = inter
    for id in ids {
        out = choose(out, id, id == chosen)
    }
    return out
}

// ---- time ----------------------------------------------------------------------

/// Every animation stepped forward by `ms`.
///
/// Returns the interaction it was given when nothing is moving, which is what
/// stops the host's frame loop. See the note at the top of this file: this is
/// load-bearing, not an optimisation.
pub fn advance(inter: Interaction, ms: float) -> Interaction {
    if quiet(inter) {
        return inter
    }
    var out: [Reaction] = []
    for reaction in inter.reactions {
        let next = stepped_reaction(reaction, ms)
        // A control that has finished retreating to nothing is dropped. Without
        // this the list grows for the lifetime of the program — every control
        // ever hovered, kept forever, walked once a frame.
        if !spent(next) {
            out.push(next)
        }
    }
    return Interaction{..inter, reactions: out }
}

fn quiet(inter: Interaction) -> bool {
    for reaction in inter.reactions {
        if !resting(reaction) {
            return false
        }
        if spent(reaction) {
            return false
        }
    }
    return true
}

fn resting(reaction: Reaction) -> bool {
    if !settled(reaction.hover) || !settled(reaction.focus) {
        return false
    }
    if !settled(reaction.press) || !settled(reaction.select) {
        return false
    }
    return !reaction.ripple.live
}

/// Whether a reaction has nothing left to say and can be forgotten.
fn spent(reaction: Reaction) -> bool {
    if !resting(reaction) {
        return false
    }
    if at(reaction.hover, layer_curve()) > 0.0 || at(reaction.focus, layer_curve()) > 0.0 {
        return false
    }
    if at(reaction.press, layer_curve()) > 0.0 || at(reaction.select, emphasized()) > 0.0 {
        return false
    }
    return !reaction.ripple.live
}

fn stepped_reaction(reaction: Reaction, ms: float) -> Reaction {
    return Reaction{
        ..reaction,
        hover: stepped(reaction.hover, ms),
        focus: stepped(reaction.focus, ms),
        press: stepped(reaction.press, ms),
        select: stepped(reaction.select, ms),
        ripple: stepped_ripple(reaction.ripple, ms),
    }
}

fn stepped_ripple(ripple: Ripple, ms: float) -> Ripple {
    if !ripple.live {
        return ripple
    }
    let held = ripple.held + ms
    // The fade waits for the release *and* for the minimum press to have
    // elapsed. A tap of four milliseconds — which is every tap on a
    // touchscreen — would otherwise start fading before the circle had grown
    // wide enough to be seen at all.
    var fade = ripple.fade
    if !ripple.down && held >= RIPPLE_MINIMUM() {
        fade = retargeted(fade, standard(), 1.0, RIPPLE_FADE())
    }
    let grown = stepped(ripple.grow, ms)
    let faded = stepped(fade, ms)
    let gone = settled(faded) && faded.to >= 1.0
    return Ripple{..ripple, held: held, grow: grown, fade: faded, live: !gone }
}

// ---- reading it back ------------------------------------------------------------

/// What a control's state is, for handing to a component.
///
/// A control this has never heard of is at rest, which is the answer that makes
/// a component work before it has ever been touched.
pub fn state_of(inter: Interaction, id: str) -> State {
    let reaction = reaction_of(inter, id)
    if reaction == nil {
        return rest()
    }
    let hover = at(reaction.hover, layer_curve())
    let focus = at(reaction.focus, layer_curve())
    let press = at(reaction.press, layer_curve())
    let select = at(reaction.select, emphasized())
    return State{
        // The booleans are what the layer *is*, the floats are how far it has
        // come. A component that only wants to know whether it is hovered still
        // can, and one that wants to draw the crossfade has the number.
        hovered: hover> 0.0,
        focused: focus> 0.0,
        pressed: press> 0.0,
        selected: select >= 0.5,
        disabled: false,
        hover: hover,
        focus: focus,
        press: press,
        select: select,
    }
}

/// The same, for a control the application knows to be disabled.
///
/// Disabled is the application's fact rather than the pointer's — a control is
/// not disabled because nobody has touched it — so it is passed in rather than
/// tracked. A disabled control also shows no state layer at all, which is why
/// this is not simply `State{..state_of(…), disabled: true}`.
pub fn state_off(inter: Interaction, id: str) -> State {
    return State{..rest(), disabled: true }
}

/// The same, with the application's own selected flag folded in.
///
/// Selection can reach a component two ways. An application that routes it
/// through [`choose`] gets it animated; one that does not gets it exactly, and
/// instantly. This tells the two apart by asking whether anything is *aimed* at
/// the value the application is claiming: if the track agrees, the track is
/// authoritative and mid-flight values are honoured; if it disagrees, nothing
/// is animating this and the boolean is the whole truth.
///
/// Reading "is the track at zero?" instead — which is the obvious test — gets
/// the first frame of every animation wrong, because a selection that has just
/// been turned on is at zero and heading for one.
pub fn state_marked(inter: Interaction, id: str, selected: bool) -> State {
    let base = state_of(inter, id)
    let want = if selected { 1.0 } else { 0.0 }
    let reaction = reaction_of(inter, id)
    if reaction != nil {
        if absf(reaction.select.to - want) < 0.000001 {
            return State{..base, selected: selected }
        }
    }
    return State{..base, selected: selected, select: want }
}

pub fn reaction_of(inter: Interaction, id: str) -> Option<Reaction> {
    for reaction in inter.reactions {
        if reaction.id == id {
            return reaction
        }
    }
    return nil
}

/// Whether anything at all is moving. An application that wants to do its own
/// work only on still frames can ask.
pub fn animating(inter: Interaction) -> bool {
    return !quiet(inter)
}

// ---- keeping the reactions in step with the ids -----------------------------------
//
// One function, called after every change to `hovered`, `armed` or `focused`.
// Retargeting inside each event handler instead would mean four places that
// have to agree about what a hover is, and the failure when they do not is a
// control that lights up and never goes out.

fn synced(inter: Interaction) -> Interaction {
    var ready = inter
    ready = ensure(ready, inter.hovered)
    ready = ensure(ready, inter.armed)
    ready = ensure(ready, inter.focused)

    var out: [Reaction] = []
    for reaction in ready.reactions {
        let wants_hover = if reaction.id == ready.hovered { 1.0 } else { 0.0 }
        let wants_focus = if reaction.id == ready.focused { 1.0 } else { 0.0 }
        let wants_press = if reaction.id == ready.armed { 1.0 } else { 0.0 }
        out.push(
            Reaction {
                ..reaction,
                hover: retargeted(
                    reaction.hover,
                    layer_curve(),
                    wants_hover,
                    if wants_hover > 0.0 { HOVER_IN() } else { HOVER_OUT() },
                ),
                focus: retargeted(
                    reaction.focus,
                    layer_curve(),
                    wants_focus,
                    if wants_focus > 0.0 { FOCUS_IN() } else { FOCUS_OUT() },
                ),
                press: retargeted(
                    reaction.press,
                    layer_curve(),
                    wants_press,
                    if wants_press > 0.0 { PRESS_IN() } else { PRESS_OUT() },
                ),
            },
        )
    }
    return Interaction{..ready, reactions: out }
}

/// A reaction for `id`, added at rest if there was none. The empty id is not a
/// control and never gets one.
fn ensure(inter: Interaction, id: str) -> Interaction {
    if id == "" {
        return inter
    }
    if reaction_of(inter, id) != nil {
        return inter
    }
    var out = inter.reactions
    out.push(
        Reaction {
            id: id,
            hover: still(0.0),
            focus: still(0.0),
            press: still(0.0),
            select: still(0.0),
            ripple: no_ripple(),
        },
    )
    return Interaction{..inter, reactions: out }
}

fn no_ripple() -> Ripple {
    return Ripple{
        x: 0.0,
        y: 0.0,
        ink: 0x000000,
        grow: still(0.0),
        fade: still(0.0),
        held: 0.0,
        down: false,
        live: false,
    }
}

fn with_ripple(
    inter: Interaction,
    frames: [ui.Frame],
    id: str,
    x: float,
    y: float,
) -> Interaction {
    let box = control_frame(frames, id)
    if box == nil {
        return inter
    }
    var out: [Reaction] = []
    for reaction in inter.reactions {
        if reaction.id == id {
            out.push(
                Reaction {
                    ..reaction,
                    ripple: Ripple{
                        x: x - box.rect.x,
                        y: y - box.rect.y,
                        ink: box.decor.ink,
                        grow: Track{
                            from: 0.0,
                            to: 1.0,
                            elapsed: 0.0,
                            duration: RIPPLE_GROW(),
                        },
                        fade: still(0.0),
                        held: 0.0,
                        down: true,
                        live: true,
                    },
                },
            )
        } else {
            out.push(reaction)
        }
    }
    return Interaction{..inter, reactions: out }
}

fn control_under(frames: [ui.Frame], x: float, y: float) -> str {
    let found = ui.control_at(frames, x, y)
    if found == nil {
        return ""
    }
    return found
}

/// The frame of the control itself, rather than of whatever inside it happened
/// to be hit. Its rectangle is what a ripple is clipped to and what its colour
/// is taken from.
fn control_frame(frames: [ui.Frame], id: str) -> Option<ui.Frame> {
    for frame in frames {
        if frame.is_control {
            let owner = frame.control
            if owner != nil {
                if owner == id {
                    return frame
                }
            }
        }
    }
    return nil
}

// ---- painting ---------------------------------------------------------------------
//
// Ripples are drawn *after* the tree, because they go on top of the container
// and there is no z-order in a layout that is only rows and columns. That is
// the one thing this package does that `std/ui.paint` cannot: an overlay pass
// over the same frames, which is what a design system needs and a layout
// engine should not have to provide.

/// A laid-out tree, with its ripples.
///
/// Drop-in for `ui.paint`. A window with no ripple in flight draws exactly what
/// `ui.paint` draws and pays one walk of the frame list for asking.
pub fn paint(frames: [ui.Frame], inter: Interaction) {
    ui.paint(frames)
    paint_ripples(frames, inter, 0.0, 0.0)
}

/// The same inside a scrolled viewport, matching `ui.paint_scrolled`.
pub fn paint_scrolled(
    frames: [ui.Frame],
    inter: Interaction,
    viewport: ui.Rect,
    offset: float,
) {
    ui.paint_scrolled(frames, viewport, offset)
    draw.clip(viewport.x, viewport.y, viewport.width, viewport.height)
    paint_ripples(frames, inter, viewport.x, viewport.y - offset)
    draw.unclip()
}

fn paint_ripples(frames: [ui.Frame], inter: Interaction, dx: float, dy: float) {
    for reaction in inter.reactions {
        if reaction.ripple.live {
            let box = control_frame(frames, reaction.id)
            if box != nil {
                paint_one_ripple(box, reaction.ripple, dx, dy)
            }
        }
    }
}

fn paint_one_ripple(box: ui.Frame, ripple: Ripple, dx: float, dy: float) {
    let rect = box.rect
    let w = rect.width
    let h = rect.height
    if w <= 0.0 || h <= 0.0 {
        return
    }
    // The press layer, in the container's own shape.
    //
    // This drew an expanding *circle* from the point of contact, which is what
    // a Material ripple is, and it had to be clipped to the container or a pill
    // button's ripple filled the square corners outside the pill. The drawing
    // boundary clips to rectangles only, so the shape was approximated by
    // taking it in horizontal bands — and eight bands across a 36dp corner is a
    // 4.5dp stair, which at two device pixels a dp is a visible staircase down
    // both ends of every row that was touched. It also cost fifty-one draw
    // calls a frame, every one of them a DOM node to reconcile, for the whole
    // life of the press.
    //
    // A shaped overlay has neither problem: one rounded rectangle, in exactly
    // the container's own shape, at the state layer's opacity. What is lost is
    // the circle travelling out from the finger. Getting that back honestly
    // needs `draw.clip` to take a radius — a rounded clip is a real capability
    // that `std/ui` wants anyway, since a scrolled rounded card clips square
    // today — rather than another approximation of one.
    let grow = at(ripple.grow, standard())
    let fade = at(ripple.fade, standard())
    let opacity = PRESS_OPACITY() * grow * (1.0 - fade)
    if opacity <= 0.0 {
        return
    }
    let shape = shape_radius(box, w, h)
    draw.alpha(opacity)
    draw.rrect(rect.x + dx, rect.y + dy, w, h, shape, ripple.ink)
    draw.alpha(1.0)
}

/// The corner radius the container was actually drawn with — `SHAPE_FULL` and
/// anything else past half the shorter side is a pill, and clamping here is
/// what the painter does to the fill too.
fn shape_radius(box: ui.Frame, w: float, h: float) -> float {
    return minf(box.decor.radius, minf(w, h) / 2.0)
}
