use std/ui
use std/math

// Text fields.
//
// Material's text field is the component with the most going on: a container, a
// label that starts inside the field and rises out of the way when there is
// something to make room for, an activity indicator, supporting text under it,
// and an error state that recolours all four at once.
//
// The label's rise is the part worth getting right, and the part that is
// usually faked. It is not two pictures — a placeholder and a caption — swapped
// at the moment focus arrives. It is one run of text moving up and shrinking,
// and the movement is what tells someone that the grey word they were looking
// at has become the name of the box rather than disappearing.

/// Everything a text field can be told. The common cases have their own
/// functions below; this is for the ones that need a label *and* supporting
/// text *and* an error, which is most real forms.
pub struct Field {
    /// The name of the field, which starts inside it and rises out.
    pub label: str
    pub value: str
    /// What is shown in an empty focused field, under the risen label.
    pub placeholder: str
    /// A line under the field: a hint, a format, or the reason it is wrong.
    pub supporting: str
    pub error: bool
    /// Glyphs before and after the value. Strings for the reason every glyph in
    /// this package is one.
    pub leading: str
    pub trailing: str
    pub width: float
}

pub fn field(label: str, value: str, width: float) -> Field {
    return Field{
        label: label,
        value: value,
        placeholder: "",
        supporting: "",
        error: false,
        leading: "",
        trailing: "",
        width: width,
    }
}

pub fn FIELD_HEIGHT() -> float {
    return 56.0
}

/// An outlined text field.
///
/// Material draws the label floating *on* the outline when the field has
/// content, with the outline interrupted behind it. There is no way to break a
/// border at this boundary — a gap in an outline is a fifth rectangle and a
/// colour match — so the label rises inside the field instead, which is the
/// filled variant's placement and is honest about what it is. Everything else
/// about the outlined field is exact.
pub fn outlined_field<Msg>(
    s: Scheme,
    id: str,
    value: str,
    placeholder: str,
    width: float,
    state: State,
) -> ui.Node<Msg> {
    return outlined_field_of(s, id, Field{..field(placeholder, value, width) }, state)
}

pub fn outlined_field_of<Msg>(s: Scheme, id: str, spec: Field, state: State) -> ui.Node<Msg> {
    let accent = field_accent(s, spec, state)
    let edge = mix(s.outline, accent, maxf(state.focus, if spec.error { 1.0 } else { 0.0 }))
    let thickness = math.lerp(1.0, 2.0, maxf(state.focus, if spec.error { 1.0 } else { 0.0 }))
    let container = ui.bordered(
        ui.shaped(ui.no_decor(), SHAPE_EXTRA_SMALL()),
        if state.disabled { disabled_container(s, s.surface) } else { edge },
        thickness,
    )
    return field_body(s, id, spec, state, container, false)
}

/// A filled text field: a container and an activity indicator instead of an
/// outline. Material's default of the two.
pub fn filled_field<Msg>(
    s: Scheme,
    id: str,
    value: str,
    placeholder: str,
    width: float,
    state: State,
) -> ui.Node<Msg> {
    return filled_field_of(s, id, Field{..field(placeholder, value, width) }, state)
}

pub fn filled_field_of<Msg>(s: Scheme, id: str, spec: Field, state: State) -> ui.Node<Msg> {
    let base = if state.disabled {
        disabled_container(s, s.surface)
    } else {
        layered(s.surface_container_highest, s.on_surface, state)
    }
    return field_body(s, id, spec, state, ui.rounded(base, SHAPE_EXTRA_SMALL()), true)
}

/// A search field: the same, at full radius, which is what Material's search
/// bar is. No label rises in one — a search bar's placeholder simply goes away.
pub fn search_field<Msg>(
    s: Scheme,
    id: str,
    value: str,
    placeholder: str,
    width: float,
    state: State,
) -> ui.Node<Msg> {
    let container = layered(s.surface_container_high, s.on_surface, state)
    var decor = ui.rounded(container, SHAPE_FULL())
    if state.focus > 0.0 {
        decor = ui.bordered(decor, s.primary, math.lerp(0.0, 2.0, state.focus))
    }
    let role = body_large()
    let shown = search_text(value, placeholder, state)
    let ink = if value.len() == 0 { s.on_surface_variant } else { s.on_surface }
    let boxed = ui.sized(ui.in_font(ui.style(), role.size, role.weight), width, FIELD_HEIGHT())
    // No caret width to buy back: the caret is the browser's now, and it is
    // drawn inside the element rather than in the run.
    let style = ui.Style{..boxed, padding: ui.insets_xy(space(4), 0.0) }
    let node: ui.Node<Msg> = ui.text_of(id, style, shown)
    let whole = ui.editable(
        ui.decorated(node, ui.vertically_centered(ui.inked(decor, ink))),
        id,
        value,
        placeholder,
    )
    if state.disabled {
        return ui.disabled(whole)
    }
    return whole
}

// ---- search ------------------------------------------------------------------------
//
// Material's search is two components rather than one, and the pair is the
// point: a **search bar** is the resting state — a pill somewhere on the screen
// with a hint in it — and a **search view** is what replaces it while somebody
// is typing, covering what was behind with the suggestions. One of them is a
// control and the other is a surface, and an application shows exactly one at a
// time.
//
// [`search_field`] above is the bar with nothing either side of it. This is the
// real one, which has a menu button at the leading edge and an avatar at the
// trailing edge, because that is what a search bar is on every screen that has
// one.

pub fn SEARCH_HEIGHT() -> float {
    return 56.0
}

/// A search bar: the pill, with room either side of the query.
///
/// The editable node is the text *inside* the row rather than the row itself,
/// which is what lets the leading and trailing controls be real controls. A
/// renderer that makes an element for the field makes it exactly the size of
/// the text, so the menu button beside it stays pressable — declaring the whole
/// row editable would have put an input over both of them.
pub fn search_bar<Msg>(
    s: Scheme,
    id: str,
    value: str,
    placeholder: str,
    leading: [ui.Node<Msg>],
    trailing: [ui.Node<Msg>],
    width: float,
    state: State,
) -> ui.Node<Msg> {
    let role = body_large()
    let container = layered(s.surface_container_high, s.on_surface, state)
    var decor = ui.rounded(container, SHAPE_FULL())
    if state.focus > 0.0 {
        decor = ui.bordered(decor, s.primary, math.lerp(0.0, 2.0, state.focus))
    }
    let ink = if value.len() == 0 { s.on_surface_variant } else { s.on_surface }
    let shown = if value.len() == 0 { placeholder } else { value }
    var children: [ui.Node<Msg>] = []
    for one in leading {
        children.push(one)
    }
    children.push(
        ui.editable(
            ui.decorated(
                ui.text_of(
                    id,
                    ui.grown(ui.in_font(ui.style(), role.size, role.weight), 1.0),
                    shown,
                ),
                ui.vertically_centered(ui.ink(ink)),
            ),
            id,
            value,
            placeholder,
        ),
    )
    for one in trailing {
        children.push(one)
    }
    let style = ui.spaced(
        ui.padded(
            ui.Style {
                ..ui.row(),
                align: ui.Align.Center,
                width: width,
                height: SEARCH_HEIGHT(),
            },
            space(2),
        ),
        space(2),
    )
    let whole: ui.Node<Msg> = ui.decorated(
        ui.box_of("\(id)-bar", style, children),
        ui.inked(decor, ink),
    )
    if state.disabled {
        return ui.disabled(whole)
    }
    return whole
}

/// A search view: the surface that replaces a bar while somebody is searching.
///
/// Full-screen, square-cornered and on a container tone, which is Material's
/// arrangement for a compact window: the view *is* the screen while it is open,
/// so a corner radius would show the screen it replaced through the gap.
///
/// The header is a node — usually a [`search_bar`] with a back arrow leading —
/// for the reason every container in this package takes its controls rather
/// than building them: what the back arrow means is the application's.
pub fn search_view<Msg>(
    name: str,
    s: Scheme,
    header: ui.Node<Msg>,
    results: [ui.Node<Msg>],
    size: ui.Size,
) -> ui.Node<Msg> {
    var children: [ui.Node<Msg>] = [header, divider("\(name)-rule", s)]
    for one in results {
        children.push(one)
    }
    return ui.decorated(
        ui.box_of(
            name,
            ui.Style {
                ..ui.column(),
                align: ui.Align.Stretch,
                width: size.width,
                height: size.height,
            },
            children,
        ),
        ui.filled(surface_at(s, LEVEL_3())),
    )
}

/// The same on a window with room to spare: a rounded card of suggestions that
/// hangs under the bar rather than replacing the screen.
///
/// It is a portal, and has to be — a docked view opens *over* the form under it
/// and pushes nothing down, which is the whole difference between this and a
/// list that appeared in the layout.
pub fn docked_search_view<Msg>(
    name: str,
    s: Scheme,
    results: [ui.Node<Msg>],
    width: float,
) -> ui.Node<Msg> {
    return ui.portal(
        ui.decorated(
            ui.box_of(
                name,
                ui.Style {
                    ..ui.column(),
                    align: ui.Align.Stretch,
                    width: width,
                    padding: ui.insets_xy(0.0, space(2)),
                },
                results,
            ),
            ui.rounded(surface_at(s, LEVEL_3()), SHAPE_EXTRA_LARGE()),
        ),
    )
}

/// What a search field shows when nobody can draw it a real caret.
///
/// No `|` anywhere. This field's control node *is* its text node, so
/// `ui.paint` declares it as an input — and under a DOM renderer that is a
/// real `<input>` whose caret, selection and IME are the browser's. A glyph
/// standing in for the caret would be drawn *as well as* the real one, and
/// would push the placeholder aside doing it.
///
/// A renderer that cannot make an element falls back to drawing this text and
/// gets no caret. That is the honest state of a canvas, and the reason the
/// page keeps a hidden input over it for the keyboard and the IME.
fn search_text(value: str, placeholder: str, state: State) -> str {
    if value.len() == 0 {
        return placeholder
    }
    return value
}

/// The colour a field's outline, label and indicator take when they are
/// active. An erroring field is error-coloured whether or not it has focus,
/// which is the point of an error.
fn field_accent(s: Scheme, spec: Field, state: State) -> int {
    if spec.error {
        return s.error
    }
    if state.disabled {
        return disabled_ink(s, s.surface)
    }
    return s.primary
}

/// How far the label has risen out of the field, from 0 to 1.
///
/// It rises when there is anything to make room for — focus, a value, or a
/// placeholder waiting to be shown — and the `focus` channel is already
/// animated, so a field that is clicked into shows the label travelling rather
/// than teleporting. A field that merely *has* a value has its label up
/// already, with nothing to animate, which is correct: it did not just move.
fn risen(spec: Field, state: State) -> float {
    if spec.value.len() > 0 {
        return 1.0
    }
    return state.focus
}

fn field_body<Msg>(
    s: Scheme,
    id: str,
    spec: Field,
    state: State,
    container: ui.Decor,
    indicated: bool,
) -> ui.Node<Msg> {
    let label_role = body_large()
    let small_role = body_small()
    let float_amount = risen(spec, state)
    let accent = field_accent(s, spec, state)

    // The label's size and colour cross together as it rises: 16dp
    // on-surface-variant inside the field, 12dp accent above the value.
    let label_size = math.lerp(label_role.size, small_role.size, float_amount)
    let label_ink = if state.disabled {
        disabled_ink(s, s.surface)
    } else {
        mix(s.on_surface_variant, accent, float_amount * maxf(state.focus, if spec.error { 1.0 } else { 0.0 }))
    }
    let value_ink = if state.disabled { disabled_ink(s, s.surface) } else { s.on_surface }

    // A single line sits in the middle of a 56dp field; a risen label and its
    // value sit 8dp from the top. The leading spacer is what carries the label
    // between the two, and it is the whole of the animation.
    let line = ui.line_height()
    let centred_top = maxf(0.0, (FIELD_HEIGHT() - line) / 2.0)
    let lead = math.lerp(centred_top, 8.0, float_amount)

    let shown_value = if state.focused { "\(spec.value)|" } else { spec.value }
    let placeholder = if state.focused && spec.value.len() == 0 { spec.placeholder } else { "" }
    let value_line = if spec.value.len() > 0 { shown_value } else { placeholder }

    var stack: [ui.Node<Msg>] = [
        spacer("\(id)-lead", 0.0),
        ui.decorated(
            ui.text_of("\(id)-label", ui.in_font(ui.style(), label_size, label_role.weight), spec.label),
            ui.ink(label_ink),
        ),
    ]
    // The value's box has *height* rather than content driving it: at rest it
    // is zero tall, so it does not push the label off centre, and it grows into
    // place as the label rises.
    stack.push(
        ui.decorated(
            ui.text_of(
                "\(id)-value",
                ui.Style {
                    ..ui.in_font(ui.style(), label_role.size, label_role.weight),
                    height: line * float_amount,
                },
                value_line,
            ),
            ui.ink(value_ink),
        ),
    )
    let column: ui.Node<Msg> = ui.box_of(
        "\(id)-content",
        ui.Style {
            ..ui.column(),
            align: ui.Align.Stretch,
            width: spec.width,
            height: FIELD_HEIGHT(),
            padding: ui.Insets{ top: lead, right: space(4), bottom: 0.0, left: space(4) },
        },
        stack,
    )

    var rows = [ui.decorated(column, container)]
    if indicated {
        // The activity indicator: a hairline under a filled field that thickens
        // and takes the accent as focus arrives.
        rows.push(
            ui.decorated(
                ui.box_of(
                    "\(id)-indicator",
                    ui.sized(ui.style(), spec.width, math.lerp(1.0, 2.0, maxf(state.focus, if spec.error { 1.0 } else { 0.0 }))),
                    [],
                ),
                ui.filled(mix(s.on_surface_variant, accent, maxf(state.focus, if spec.error { 1.0 } else { 0.0 }))),
            ),
        )
    }
    if spec.supporting.len() > 0 {
        rows.push(
            ui.decorated(
                ui.text_of(
                    "\(id)-supporting",
                    ui.Style {
                        ..ui.in_font(ui.style(), small_role.size, small_role.weight),
                        width: spec.width,
                        padding: ui.Insets{ top: 4.0, right: space(4), bottom: 0.0, left: space(4) },
                    },
                    spec.supporting,
                ),
                ui.ink(if spec.error { s.error } else { s.on_surface_variant }),
            ),
        )
    }
    let whole: ui.Node<Msg> = ui.box_of(
        id,
        ui.Style {..ui.column(), align: ui.Align.Stretch, width: spec.width },
        rows,
    )
    let field = ui.editable(
        ui.decorated(whole, ui.ink(s.on_surface)),
        id,
        spec.value,
        spec.label,
    )
    if state.disabled {
        return ui.disabled(field)
    }
    return field
}

/// A text area: the same field, several lines tall.
///
/// The value wraps because the box has a width, which is `std/ui`'s own rule
/// for when text wraps — so this is a filled field with its height given rather
/// than a component with anything new in it.
pub fn text_area<Msg>(
    s: Scheme,
    id: str,
    value: str,
    label: str,
    placeholder: str,
    width: float,
    height: float,
    state: State,
) -> ui.Node<Msg> {
    let role = body_large()
    let container = if state.disabled {
        disabled_container(s, s.surface)
    } else {
        layered(s.surface_container_highest, s.on_surface, state)
    }
    var decor = ui.rounded(container, SHAPE_EXTRA_SMALL())
    if state.focus > 0.0 {
        decor = ui.bordered(decor, s.primary, math.lerp(0.0, 2.0, state.focus))
    }
    // No caret to draw, and none to pay for. The element the DOM renderer makes
    // has the browser's own, and the renderers that cannot make one draw the
    // text — which is what a `|` was standing in for, badly: it occupied the
    // column it was pointing at, so the text moved sideways when the field took
    // focus.
    var shown = value
    var ink = s.on_surface
    if value.len() == 0 {
        shown = placeholder
        ink = s.on_surface_variant
    }
    let style = ui.Style{
        ..ui.in_font(ui.style(), role.size, role.weight),
        width: width,
        height: height,
        padding: ui.insets_xy(space(4), space(3)),
    }
    let shell: ui.Node<Msg> = ui.decorated(
        ui.text_of(id, style, shown),
        ui.inked(decor, ink),
    )
    // The one widget in the set that says Enter belongs to it. Under the DOM
    // renderer this is what makes the element a `<textarea>` rather than an
    // `<input>`, and a text area that came out single-line was the state of
    // this component until the call could carry the difference.
    let whole = ui.editable_lines(shell, id, value, label)
    if state.disabled {
        return ui.disabled(whole)
    }
    return whole
}

// ---- select ---------------------------------------------------------------------
//
// The third widget §5 of docs/04 says a canvas-only design would force everyone
// to reimplement, after the input and the text area. It is here rather than in
// `std/ui` for the reason every other component is: what a dropdown *looks*
// like is a design system's decision. What `std/ui` had to provide first was
// the ability to put a menu over the page at all, which is `ui.portal`.

/// A dropdown: a trigger showing the current choice, and a menu when open.
///
/// `items` are ordinary [`menu_item`]s, which means each one carries its own
/// message and the application matches on it exhaustively — the same wiring
/// every other control here uses. The select does not own the choosing; it owns
/// where the choices appear.
///
/// The menu is a portal, and that is the whole reason this component can exist:
/// it opens *over* whatever is under it and pushes nothing down, so a form does
/// not reflow when a dropdown opens and a select near the bottom of a scrolling
/// list is not cut off by it.
pub fn select<Msg>(
    s: Scheme,
    id: str,
    label: str,
    chosen: str,
    items: [ui.Node<Msg>],
    open: bool,
    msg: Msg,
    width: float,
    state: State,
) -> ui.Node<Msg> {
    let role = body_large()
    let container = if state.disabled {
        disabled_container(s, s.surface)
    } else {
        layered(s.surface_container_highest, s.on_surface, state)
    }
    var decor = ui.rounded(container, SHAPE_EXTRA_SMALL())
    if state.focus > 0.0 || open {
        decor = ui.bordered(decor, s.primary, math.lerp(1.0, 2.0, maxf(state.focus, if open { 1.0 } else { 0.0 })))
    }
    let ink = if state.disabled {
        disabled_ink(s, s.surface)
    } else if chosen.len() == 0 {
        s.on_surface_variant
    } else {
        s.on_surface
    }
    // The caret turns over when the menu is open, which is the one thing on a
    // select that says whether pressing it will open or close.
    let caret: ui.Node<Msg> = ui.decorated(
        ui.text_of(
            "\(id)-caret",
            ui.in_font(ui.style(), role.size, role.weight),
            if open { "▴" } else { "▾" },
        ),
        ui.ink(ink),
    )
    let shown: ui.Node<Msg> = ui.decorated(
        ui.text_of(
            "\(id)-value",
            ui.grown(ui.in_font(ui.style(), role.size, role.weight), 1.0),
            if chosen.len() == 0 { label } else { chosen },
        ),
        ui.ink(ink),
    )
    let trigger: ui.Node<Msg> = ui.means(
        ui.decorated(
            ui.box_of(
                id,
                ui.spaced(
                    ui.padded(
                        ui.Style {
                            ..ui.row(),
                            align: ui.Align.Center,
                            width: width,
                            height: FIELD_HEIGHT(),
                        },
                        space(4),
                    ),
                    space(2),
                ),
                [shown, caret],
            ),
            ui.inked(decor, ink),
        ),
        id,
        msg,
        label,
    )
    let live = if state.disabled { ui.disabled(trigger) } else { trigger }
    if !open {
        return live
    }
    // A column of the trigger and the menu. The menu is out of flow, so the
    // column is exactly as tall as the trigger and the menu hangs below it.
    return ui.box_of(
        "\(id)-select",
        ui.Style {..ui.column(), align: ui.Align.Stretch, width: width },
        [live, ui.portal(menu("\(id)-menu", s, items, width))],
    )
}
