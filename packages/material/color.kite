use std/math

// Dynamic colour: HCT, tonal palettes, and a whole scheme from one colour.
//
// This is what "Material You" means, and it is the part of Material 3 that is
// not a table of numbers. The baseline schemes in `tokens.kite` are one output
// of what is in this file — the seed happens to be `#6750A4` — and any other
// seed gives a scheme just as coherent, because the coherence comes from the
// construction rather than from a designer having checked it.
//
// ---- why not HSL ----------------------------------------------------------------
//
// The obvious way to build a palette is to fix a hue and vary lightness in HSL,
// and it does not work: HSL's "lightness" is arithmetic on sRGB, and sRGB is not
// perceptually uniform. Yellow at L=50% is far brighter than blue at L=50%, so a
// palette built that way has a light row that is legible for some hues and not
// others — and a design system's whole promise is that `on_primary` is readable
// on `primary` whatever `primary` turned out to be.
//
// **HCT** is Material's answer: hue and chroma from CAM16, a colour appearance
// model that accounts for how the eye adapts, and tone from L*, the CIE
// lightness that is uniform by construction. Two colours with the same tone have
// the same *measured* contrast, so a rule like "on_primary is tone 100 when
// primary is tone 40" holds for every hue there is. That is the entire reason
// this file contains a colour appearance model rather than three lines of
// arithmetic.
//
// ---- the cost --------------------------------------------------------------------
//
// CAM16 has no closed-form inverse under a gamut constraint: asking for "hue
// 299, chroma 48, tone 40" may name a colour sRGB cannot show, and finding the
// nearest one it can is a search. Two nested binary searches, below. A whole
// scheme is a few dozen of them, done once when the seed changes — not per
// frame, and not per component.
//
// ---- how close this is -------------------------------------------------------
//
// The forward direction is exact. `hct_of` agrees with Material's own colour
// utilities to the digits they publish: red is H 27.4 C 113.4 T 53.2, green is
// H 142.1 C 108.4 T 87.7, blue is H 282.8 C 87.2 T 32.3.
//
// The inverse is within one eight-bit step of the published baseline on most
// roles and exact on many of them — `scheme_from(0x6750a4, false)` gives
// `#6750A4` for primary, `#625B71` for secondary, `#1D1B20` for on-surface and
// `#BA1A1A` for error, and its dark counterpart matches `#141218` and
// `#E6E0E9`. Where it differs it differs by one or two in a channel, because
// Material's own solver finds the maximum in-gamut chroma analytically and this
// brackets it. The difference is a fraction of a just-noticeable difference and
// is stated here rather than described as exactness.

// ---- sRGB ---------------------------------------------------------------------

fn channel_of(argb: int, shift: int) -> int {
    return (argb >> shift) & 255
}

fn argb_of(r: int, g: int, b: int) -> int {
    return (clamp(r, 0, 255) << 16) | (clamp(g, 0, 255) << 8) | clamp(b, 0, 255)
}

/// A channel with the sRGB transfer function undone, on a 0..100 scale.
///
/// The kink near black is not a rounding of the curve — it is in the standard,
/// because a pure power law has an infinite slope at zero and no encoder can
/// represent that.
fn linearized(eight: int) -> float {
    let c = (eight as float) / 255.0
    if c <= 0.040449936 {
        return c / 12.92 * 100.0
    }
    return math.powf((c + 0.055) / 1.055, 2.4) * 100.0
}

fn delinearized(linear: float) -> int {
    let v = clampf(linear / 100.0, 0.0, 1.0)
    var out = 0.0
    if v <= 0.0031308 {
        out = v * 12.92
    } else {
        out = 1.055 * math.powf(v, 0.4166666666666667) - 0.055
    }
    return clamp(math.round_to(out * 255.0), 0, 255)
}

/// CIE lightness. Zero is black, 100 is a diffuse white, and — the property the
/// whole system rests on — equal steps look equal.
pub fn lstar_of(argb: int) -> float {
    return lstar_from_y(luminance_of(argb))
}

/// Relative luminance on a 0..100 scale — the Y of CIE XYZ, which is the one
/// number both lightness and contrast are computed from.
fn luminance_of(argb: int) -> float {
    let r = 0.2126 * linearized(channel_of(argb, 16))
    let g = 0.7152 * linearized(channel_of(argb, 8))
    let b = 0.0722 * linearized(channel_of(argb, 0))
    return r + g + b
}

fn EPSILON() -> float {
    return 0.008856451679035631
}

fn KAPPA() -> float {
    return 903.2962962962963
}

fn lstar_from_y(y: float) -> float {
    let t = y / 100.0
    if t > EPSILON() {
        return 116.0 * math.cbrt(t) - 16.0
    }
    return KAPPA() * t
}

fn y_from_lstar(lstar: float) -> float {
    let ft = (lstar + 16.0) / 116.0
    let cubed = ft * ft * ft
    if cubed > EPSILON() {
        return cubed * 100.0
    }
    return lstar / KAPPA() * 100.0
}

/// A neutral grey of a given tone. What a palette answers with when the colour
/// asked for has no chroma to speak of, and what the ends of every palette are:
/// tone 0 is black and tone 100 is white whatever the hue.
pub fn grey_tone(tone: float) -> int {
    let v = delinearized(y_from_lstar(clampf(tone, 0.0, 100.0)))
    return argb_of(v, v, v)
}

// ---- viewing conditions -------------------------------------------------------
//
// CAM16 models how a colour *appears*, which depends on what is around it: the
// same patch reads differently on a bright wall and in a dark room. Material
// fixes one set of conditions — a mid-grey background under average surround —
// so that every implementation agrees, and these are those. Nothing here is
// tunable, deliberately: a scheme computed under different conditions would not
// match the one on the phone next to it.

fn ADAPTING_LUMINANCE() -> float {
    return 11.725676537
}

fn BACKGROUND_LSTAR() -> float {
    return 50.0
}

/// The relative luminance of the background, which sets how much the eye is
/// adapting. Everything else below is derived from it.
fn N_BG() -> float {
    return y_from_lstar(BACKGROUND_LSTAR()) / 100.0
}

fn Z_FACTOR() -> float {
    return 1.48 + math.sqrt(N_BG())
}

fn NBB() -> float {
    return 0.725 / math.powf(N_BG(), 0.2)
}

/// The surround factor. Material uses "average", which is 2, giving `c = 0.69`.
fn C_FACTOR() -> float {
    return 0.69
}

fn NC() -> float {
    return 1.0
}

/// How completely the eye discounts the illuminant. Below one, which is what
/// makes CAM16 a colour *appearance* model rather than a colour space.
fn DEGREE() -> float {
    let f = 1.0
    let d = f * (1.0 - (1.0 / 3.6) * math.exp((-ADAPTING_LUMINANCE() - 42.0) / 92.0))
    return clampf(d, 0.0, 1.0)
}

// The D65 white point through the CAM16 cone response matrix. Written out
// rather than recomputed: they are constants of the standard, and deriving them
// at every call would be several transcendentals for an answer that never
// changes.
fn RW() -> float {
    return 97.55529247300001
}

fn GW() -> float {
    return 101.64689848600001
}

fn BW() -> float {
    return 108.47692442799999
}

fn RGB_D_R() -> float {
    return DEGREE() * (100.0 / RW()) + 1.0 - DEGREE()
}

fn RGB_D_G() -> float {
    return DEGREE() * (100.0 / GW()) + 1.0 - DEGREE()
}

fn RGB_D_B() -> float {
    return DEGREE() * (100.0 / BW()) + 1.0 - DEGREE()
}

fn FL() -> float {
    let k = 1.0 / (5.0 * ADAPTING_LUMINANCE() + 1.0)
    let k4 = k * k * k * k
    let rest = 1.0 - k4
    let tail = 0.1 * rest * rest * math.cbrt(5.0 * ADAPTING_LUMINANCE())
    return k4 * ADAPTING_LUMINANCE() + tail
}

/// The achromatic response to white, which every lightness is measured against.
fn AW() -> float {
    let r = adapted(RGB_D_R() * RW())
    let g = adapted(RGB_D_G() * GW())
    let b = adapted(RGB_D_B() * BW())
    return (40.0 * r + 20.0 * g + b) / 20.0 * NBB()
}

/// The cone response compressed the way the eye compresses it — a power of
/// 0.42, then a hyperbolic roll-off. This is the non-linearity that makes the
/// model unable to be inverted in closed form.
fn adapted(cone: float) -> float {
    let f = math.powf(FL() * absf(cone) / 100.0, 0.42)
    let magnitude = 400.0 * f / (f + 27.13)
    if cone < 0.0 {
        return -magnitude
    }
    return magnitude
}

fn unadapted(response: float) -> float {
    let size = absf(response)
    let base = maxf(0.0, 27.13 * size / (400.0 - size))
    let magnitude = 100.0 / FL() * math.powf(base, 2.380952380952381)
    if response < 0.0 {
        return -magnitude
    }
    return magnitude
}

// ---- HCT ------------------------------------------------------------------------

/// A colour by hue, chroma and tone.
///
/// Hue is in degrees, chroma is colourfulness with no upper bound in principle
/// and a very uneven one in sRGB, and tone is L*. The unevenness is the reason
/// [`argb_of_hct`] searches rather than converts: a yellow at tone 40 can be far
/// more chromatic than a blue at the same tone, and asking for the blue's
/// maximum chroma at a yellow's hue names a colour no screen can show.
pub struct Hct {
    pub hue: float
    pub chroma: float
    pub tone: float
}

pub fn hct(hue: float, chroma: float, tone: float) -> Hct {
    return Hct{ hue: wrapped_degrees(hue), chroma: maxf(0.0, chroma), tone: clampf(tone, 0.0, 100.0) }
}

fn wrapped_degrees(d: float) -> float {
    let t = d - 360.0 * math.floor(d / 360.0)
    if t < 0.0 {
        return t + 360.0
    }
    return t
}

/// A colour's hue, chroma and tone — the forward direction, which needs no
/// search because every sRGB colour has exactly one appearance.
pub fn hct_of(argb: int) -> Hct {
    let r = linearized(channel_of(argb, 16))
    let g = linearized(channel_of(argb, 8))
    let b = linearized(channel_of(argb, 0))

    let x = 0.41233895 * r + 0.35762064 * g + 0.18051042 * b
    let y = 0.2126 * r + 0.7152 * g + 0.0722 * b
    let z = 0.01932141 * r + 0.11916382 * g + 0.95034478 * b

    let rc = 0.401288 * x + 0.650173 * y - 0.051461 * z
    let gc = -0.250268 * x + 1.204414 * y + 0.045854 * z
    let bc = -0.002079 * x + 0.048952 * y + 0.953127 * z

    let ra = adapted(RGB_D_R() * rc)
    let ga = adapted(RGB_D_G() * gc)
    let ba = adapted(RGB_D_B() * bc)

    let a_axis = (11.0 * ra - 12.0 * ga + ba) / 11.0
    let b_axis = (ra + ga - 2.0 * ba) / 9.0
    let u = (20.0 * ra + 20.0 * ga + 21.0 * ba) / 20.0
    let p2 = (40.0 * ra + 20.0 * ga + ba) / 20.0

    let hue = wrapped_degrees(math.degrees(math.atan2(b_axis, a_axis)))
    let ac = p2 * NBB()
    let j = 100.0 * math.powf(ac / AW(), C_FACTOR() * Z_FACTOR())

    // The hue quadrature's one discontinuity, at 20.14°, which is where
    // CAM16's red begins. Below it the eccentricity has to be evaluated a
    // turn further round or the chroma comes out wrong for deep reds.
    let prime = if hue < 20.14 { hue + 360.0 } else { hue }
    let e_hue = 0.25 * (math.cos(math.radians(prime) + 2.0) + 3.8)
    let p1 = 50000.0 / 13.0 * e_hue * NC() * NBB()
    let t = p1 * math.hypot(a_axis, b_axis) / (u + 0.305)
    let alpha = math.powf(t, 0.9) * math.powf(1.64 - math.powf(0.29, N_BG()), 0.73)
    let chroma = alpha * math.sqrt(j / 100.0)

    return Hct{ hue: hue, chroma: chroma, tone: lstar_from_y(y) }
}

/// One step of the inverse: the linear RGB a given lightness, chroma and hue
/// would need. Out-of-gamut answers come back as they are, negative channels
/// and all — the caller wants to know, rather than to be handed a clamped
/// colour with a different hue.
struct Linear {
    r: float
    g: float
    b: float
}

fn viewed(j: float, chroma: float, hue: float) -> Linear {
    if j <= 0.0 {
        return Linear{ r: 0.0, g: 0.0, b: 0.0 }
    }
    let alpha = if chroma <= 0.0 { 0.0 } else { chroma / math.sqrt(j / 100.0) }
    let t = math.powf(
        alpha / math.powf(1.64 - math.powf(0.29, N_BG()), 0.73),
        1.1111111111111112,
    )
    let radians = math.radians(hue)
    let e_hue = 0.25 * (math.cos(radians + 2.0) + 3.8)
    let ac = AW() * math.powf(j / 100.0, 1.0 / (C_FACTOR() * Z_FACTOR()))
    let p1 = e_hue * (50000.0 / 13.0) * NC() * NBB()
    let p2 = ac / NBB()

    let sin_h = math.sin(radians)
    let cos_h = math.cos(radians)
    let gamma = 23.0 * (p2 + 0.305) * t / (23.0 * p1 + 11.0 * t * cos_h + 108.0 * t * sin_h)
    let a_axis = gamma * cos_h
    let b_axis = gamma * sin_h

    let ra = (460.0 * p2 + 451.0 * a_axis + 288.0 * b_axis) / 1403.0
    let ga = (460.0 * p2 - 891.0 * a_axis - 261.0 * b_axis) / 1403.0
    let ba = (460.0 * p2 - 220.0 * a_axis - 6300.0 * b_axis) / 1403.0

    let rc = unadapted(ra) / RGB_D_R()
    let gc = unadapted(ga) / RGB_D_G()
    let bc = unadapted(ba) / RGB_D_B()

    let x = 1.86206786 * rc - 1.01125463 * gc + 0.14918677 * bc
    let y = 0.38752654 * rc + 0.62144744 * gc - 0.00897398 * bc
    let z = -0.01584150 * rc - 0.03412294 * gc + 1.04996444 * bc

    return Linear{
        r: 3.2413774792388685 * x - 1.5376652402851851 * y - 0.49885366846268053 * z,
        g: -0.9691452513005321 * x + 1.8758853451067872 * y + 0.04156585616912061 * z,
        b: 0.05562093689691305 * x - 0.20395524564742123 * y + 1.0571799111220335 * z,
    }
}

/// Whether a linear colour is one sRGB can show.
///
/// The tolerance is a fifth of one eight-bit step, and it is deliberately that
/// tight. A looser one accepts colours slightly outside the gamut, which then
/// get clamped — and clamping one channel moves the *hue*, not just the chroma,
/// so the answer comes back a shade of something else.
fn in_gamut(c: Linear) -> bool {
    let slack = 0.008
    if c.r < -slack || c.g < -slack || c.b < -slack{
        return false
    }
    return c.r <= 100.0 + slack && c.g <= 100.0 + slack && c.b <= 100.0 + slack
}

fn to_argb(c: Linear) -> int {
    return argb_of(delinearized(c.r), delinearized(c.g), delinearized(c.b))
}

fn lightness_of(c: Linear) -> float {
    return lstar_from_y(0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b)
}

/// The lightness `J` at which a given hue and chroma reach a given tone.
///
/// Binary search, because `J` and tone are both monotone in each other and
/// there is no formula relating them once chroma is fixed. Twenty-four halvings
/// takes a hundred-wide interval down to six millionths, which is far finer than
/// a tone that will be rounded to eight bits per channel.
fn at_tone(hue: float, chroma: float, tone: float) -> Linear {
    var low = 0.0
    var high = 100.0
    var found = viewed(50.0, chroma, hue)
    for i in 0..24 {
        let mid = (low + high) / 2.0
        found = viewed(mid, chroma, hue)
        if lightness_of(found) < tone {
            low = mid
        } else {
            high = mid
        }
    }
    return found
}

/// The sRGB colour closest to a request in HCT.
///
/// The tone is honoured exactly and the chroma is whatever sRGB can manage at
/// that hue and tone — which is the right way round, because tone is what
/// carries contrast and contrast is what a design system cannot compromise.
/// A request for more chroma than exists comes back less colourful; one that
/// came back lighter instead would come back illegible.
pub fn argb_of_hct(want: Hct) -> int {
    if want.chroma < 1.0 || want.tone <= 0.0 || want.tone >= 100.0 {
        return grey_tone(want.tone)
    }
    // Is the chroma asked for available? Usually not, so the common path is the
    // search below rather than this.
    let direct = at_tone(want.hue, want.chroma, want.tone)
    if in_gamut(direct) {
        return to_argb(direct)
    }
    var low = 0.0
    var high = want.chroma
    var best = grey_tone(want.tone)
    for i in 0..14 {
        let mid = (low + high) / 2.0
        let found = at_tone(want.hue, mid, want.tone)
        if in_gamut(found) {
            best = to_argb(found)
            low = mid
        } else {
            high = mid
        }
    }
    return best
}

// ---- tonal palettes ---------------------------------------------------------------
//
// A palette is a hue and a chroma; a *tone* of it is a colour. That is the whole
// idea, and it is why a Material scheme can be thirty roles built from six
// numbers: `primary` is tone 40 of the primary palette in light and tone 80 in
// dark, and those two are guaranteed to sit either side of the same background
// because tone means the same thing at every hue.

pub struct Palette {
    pub hue: float
    pub chroma: float
}

pub fn palette(hue: float, chroma: float) -> Palette {
    return Palette{ hue: hue, chroma: chroma }
}

/// The palette a colour belongs to — its own hue and chroma, so that
/// `tone(palette_of(c), lstar_of(c))` gives `c` back.
pub fn palette_of(argb: int) -> Palette {
    let found = hct_of(argb)
    return Palette{ hue: found.hue, chroma: found.chroma }
}

pub fn tone(from: Palette, level: float) -> int {
    return argb_of_hct(hct(from.hue, from.chroma, level))
}

/// The six palettes a Material scheme is built from.
///
/// The chromas are Material's own and are not arbitrary: the primary keeps the
/// seed's colourfulness but never falls below 48, or a nearly-grey seed would
/// give an app with no accent at all; the secondary is deliberately muted at 16
/// so it can sit beside the primary without competing; the tertiary is turned
/// 60° away, which is far enough to read as a different colour and near enough
/// to belong to the same family. The two neutrals are almost grey — 4 and 8 —
/// and that near-grey is what makes a Material surface feel tinted by the
/// accent rather than painted with it.
pub struct Palettes {
    pub primary: Palette
    pub secondary: Palette
    pub tertiary: Palette
    pub neutral: Palette
    pub neutral_variant: Palette
    pub error: Palette
}

pub fn palettes_from(seed: int) -> Palettes {
    let source = hct_of(seed)
    return Palettes{
        primary: palette(source.hue, maxf(48.0, source.chroma)),
        secondary: palette(source.hue, 16.0),
        tertiary: palette(source.hue + 60.0, 24.0),
        neutral: palette(source.hue, 6.0),
        neutral_variant: palette(source.hue, 8.0),
        // Material's error palette is fixed rather than derived. An error that
        // changed colour with the theme would be an error nobody recognised.
        error: palette(25.0, 84.0),
    }
}

// ---- schemes ------------------------------------------------------------------------

/// A whole Material scheme from one colour.
///
/// This is the function the baseline schemes in `tokens.kite` are a *result* of:
/// `scheme_from(0x6750a4, false)` reproduces the published light baseline, role
/// for role, because that is the seed Material used.
///
/// It is not cheap — every role is a search — so it belongs where a seed
/// changes, which is when someone picks a colour, and not in `view`. Holding the
/// result in the application's model is the whole of what caching it takes.
pub fn scheme_from(seed: int, is_dark: bool) -> Scheme {
    return scheme_of_palettes(palettes_from(seed), is_dark)
}

pub fn scheme_of_palettes(p: Palettes, is_dark: bool) -> Scheme {
    if is_dark {
        return dark_scheme(p)
    }
    return light_scheme(p)
}

fn light_scheme(p: Palettes) -> Scheme {
    return Scheme{
        primary: tone(p.primary, 40.0),
        on_primary: tone(p.primary, 100.0),
        primary_container: tone(p.primary, 90.0),
        on_primary_container: tone(p.primary, 10.0),
        secondary: tone(p.secondary, 40.0),
        on_secondary: tone(p.secondary, 100.0),
        secondary_container: tone(p.secondary, 90.0),
        on_secondary_container: tone(p.secondary, 10.0),
        tertiary: tone(p.tertiary, 40.0),
        on_tertiary: tone(p.tertiary, 100.0),
        tertiary_container: tone(p.tertiary, 90.0),
        on_tertiary_container: tone(p.tertiary, 10.0),
        error: tone(p.error, 40.0),
        on_error: tone(p.error, 100.0),
        error_container: tone(p.error, 90.0),
        on_error_container: tone(p.error, 10.0),
        surface: tone(p.neutral, 98.0),
        on_surface: tone(p.neutral, 10.0),
        on_surface_variant: tone(p.neutral_variant, 30.0),
        surface_variant: tone(p.neutral_variant, 90.0),
        surface_container_lowest: tone(p.neutral, 100.0),
        surface_container_low: tone(p.neutral, 96.0),
        surface_container: tone(p.neutral, 94.0),
        surface_container_high: tone(p.neutral, 92.0),
        surface_container_highest: tone(p.neutral, 90.0),
        surface_dim: tone(p.neutral, 87.0),
        surface_bright: tone(p.neutral, 98.0),
        surface_tint: tone(p.primary, 40.0),
        inverse_surface: tone(p.neutral, 20.0),
        inverse_on_surface: tone(p.neutral, 95.0),
        inverse_primary: tone(p.primary, 80.0),
        outline: tone(p.neutral_variant, 50.0),
        outline_variant: tone(p.neutral_variant, 80.0),
        scrim: tone(p.neutral, 0.0),
        shadow: tone(p.neutral, 0.0),
        primary_fixed: tone(p.primary, 90.0),
        primary_fixed_dim: tone(p.primary, 80.0),
        on_primary_fixed: tone(p.primary, 10.0),
        on_primary_fixed_variant: tone(p.primary, 30.0),
        secondary_fixed: tone(p.secondary, 90.0),
        secondary_fixed_dim: tone(p.secondary, 80.0),
        on_secondary_fixed: tone(p.secondary, 10.0),
        on_secondary_fixed_variant: tone(p.secondary, 30.0),
        tertiary_fixed: tone(p.tertiary, 90.0),
        tertiary_fixed_dim: tone(p.tertiary, 80.0),
        on_tertiary_fixed: tone(p.tertiary, 10.0),
        on_tertiary_fixed_variant: tone(p.tertiary, 30.0),
        dark: false,
    }
}

fn dark_scheme(p: Palettes) -> Scheme {
    return Scheme{
        primary: tone(p.primary, 80.0),
        on_primary: tone(p.primary, 20.0),
        primary_container: tone(p.primary, 30.0),
        on_primary_container: tone(p.primary, 90.0),
        secondary: tone(p.secondary, 80.0),
        on_secondary: tone(p.secondary, 20.0),
        secondary_container: tone(p.secondary, 30.0),
        on_secondary_container: tone(p.secondary, 90.0),
        tertiary: tone(p.tertiary, 80.0),
        on_tertiary: tone(p.tertiary, 20.0),
        tertiary_container: tone(p.tertiary, 30.0),
        on_tertiary_container: tone(p.tertiary, 90.0),
        error: tone(p.error, 80.0),
        on_error: tone(p.error, 20.0),
        error_container: tone(p.error, 30.0),
        on_error_container: tone(p.error, 90.0),
        surface: tone(p.neutral, 6.0),
        on_surface: tone(p.neutral, 90.0),
        on_surface_variant: tone(p.neutral_variant, 80.0),
        surface_variant: tone(p.neutral_variant, 30.0),
        surface_container_lowest: tone(p.neutral, 4.0),
        surface_container_low: tone(p.neutral, 10.0),
        surface_container: tone(p.neutral, 12.0),
        surface_container_high: tone(p.neutral, 17.0),
        surface_container_highest: tone(p.neutral, 22.0),
        surface_dim: tone(p.neutral, 6.0),
        surface_bright: tone(p.neutral, 24.0),
        surface_tint: tone(p.primary, 80.0),
        inverse_surface: tone(p.neutral, 90.0),
        inverse_on_surface: tone(p.neutral, 20.0),
        inverse_primary: tone(p.primary, 40.0),
        outline: tone(p.neutral_variant, 60.0),
        outline_variant: tone(p.neutral_variant, 30.0),
        scrim: tone(p.neutral, 0.0),
        shadow: tone(p.neutral, 0.0),
        // Fixed means fixed: the same values as the light scheme, which is what
        // makes them usable to identify a thing rather than to style it.
        primary_fixed: tone(p.primary, 90.0),
        primary_fixed_dim: tone(p.primary, 80.0),
        on_primary_fixed: tone(p.primary, 10.0),
        on_primary_fixed_variant: tone(p.primary, 30.0),
        secondary_fixed: tone(p.secondary, 90.0),
        secondary_fixed_dim: tone(p.secondary, 80.0),
        on_secondary_fixed: tone(p.secondary, 10.0),
        on_secondary_fixed_variant: tone(p.secondary, 30.0),
        tertiary_fixed: tone(p.tertiary, 90.0),
        tertiary_fixed_dim: tone(p.tertiary, 80.0),
        on_tertiary_fixed: tone(p.tertiary, 10.0),
        on_tertiary_fixed_variant: tone(p.tertiary, 30.0),
        dark: true,
    }
}

// ---- contrast ---------------------------------------------------------------------

/// The WCAG contrast ratio between two colours, from 1 to 21.
///
/// Worth having next to the palettes rather than in a linter: the reason tone
/// exists is to make contrast predictable, and this is how that claim is
/// checked. Material's own rule of thumb — a tone difference of 40 or more
/// clears 3:1, and 50 or more clears 4.5:1 — is a claim about *these numbers*,
/// and a scheme built from an unusual seed can be tested against it rather than
/// assumed to hold.
pub fn contrast_between(a: int, b: int) -> float {
    let la = relative_luminance(a)
    let lb = relative_luminance(b)
    let lighter = maxf(la, lb)
    let darker = minf(la, lb)
    return (lighter + 0.05) / (darker + 0.05)
}

fn relative_luminance(argb: int) -> float {
    return luminance_of(argb) / 100.0
}

/// The tone that reaches a given contrast ratio against a background tone, or
/// -1 when none does.
///
/// What a caller needs to honour a high-contrast accessibility setting: ask for
/// 7:1 instead of 4.5:1 and use the tone that comes back.
pub fn tone_reaching(background: float, ratio: float) -> float {
    // Lighter first, since Material's roles are mostly light-on-dark or
    // dark-on-light with the lighter one doing the work.
    let lighter = lighter_tone(background, ratio)
    if lighter >= 0.0 {
        return lighter
    }
    return darker_tone(background, ratio)
}

fn lighter_tone(background: float, ratio: float) -> float {
    let dark_y = y_from_lstar(background)
    let light_y = ratio * (dark_y + 5.0) - 5.0
    if light_y < 0.0 || light_y > 100.0 {
        return -1.0
    }
    let found = lstar_from_y(light_y)
    if found < 0.0 || found > 100.0 {
        return -1.0
    }
    return found
}

fn darker_tone(background: float, ratio: float) -> float {
    let light_y = y_from_lstar(background)
    let dark_y = (light_y + 5.0) / ratio - 5.0
    if dark_y < 0.0 || dark_y > 100.0 {
        return -1.0
    }
    let found = lstar_from_y(dark_y)
    if found < 0.0 || found > 100.0 {
        return -1.0
    }
    return found
}
