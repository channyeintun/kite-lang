use std/ui
use std/math

// Material Design 3's components, as functions returning decorated nodes.
//
// A component here is a **function that returns a node**. There is no component
// object, no internal state, and nowhere to hide one — Kite has no mutable
// globals, so a component that remembered something would have to be handed it,
// and the application's model is what it would be handed.
//
// Every one takes the `Scheme` rather than reading a global, and every
// interactive one takes an `id` from the caller rather than inventing one. Both
// are deliberate: a package that invented ids would collide with an
// application's, and a package that read a global theme could not be used twice
// on one screen with two schemes.
//
// This file has the pressables — buttons in all five emphases and five sizes,
// icon buttons, floating action buttons, chips and badges. The rest of the
// system is beside it: `selection.kite`, `fields.kite`, `surfaces.kite`,
// `navigation.kite`, `progress.kite`, with `tokens.kite` under all of them and
// `motion.kite` and `interaction.kite` supplying the movement.
//
// ---- what is here and what is not -------------------------------------------
//
// Material specifies its components in terms of shape, colour role, type role,
// state layer, elevation and motion. Five of those six survive Kite's drawing
// boundary intact and are implemented exactly. Elevation's *shadow* does not
// and cannot: a shadow is a soft alpha gradient, and while `draw.alpha` gives
// translucency there is no blur, so a shadow would be a hard-edged grey
// rectangle. Material 3's own answer for dark themes is tonal — a raised
// surface is a lighter container colour, not a shadow — and that is what these
// do at every level, continuously, so a card that rises under the pointer
// *changes tone as it rises* rather than stepping.
//
// Icons are the other absence. Material Symbols is a font, and a font is not
// something a package can carry; where a component wants an icon it takes the
// glyph as a `str`, so a caller can pass a Unicode symbol today and a real icon
// font later without any of this changing.

// ---- state -------------------------------------------------------------------
//
// Material's state layers — hover, focus, press — are an on-colour drawn over
// the container at 8% or 10%. There are two ways to draw one and this package
// uses both, for a reason worth stating because getting it wrong is invisible
// until it is animated.
//
// Over a container whose colour is *known* — a filled button is `primary`, and
// nothing shows through it — the layer is `mix`ed in, which produces exactly
// the pixel the alpha blend would have. That is `layered`.
//
// Over a control with no container of its own — a text button, a list row —
// there is nothing known to mix with, and `layer_decor` draws the layer
// translucent instead. Mixing there means guessing a backdrop, and a guess that
// is one container tone out does not merely shift the colour: it puts the whole
// transition on the wrong side of what is behind, so the control darkens on its
// way in and leaves a dark patch on its way out.
//
// `tokens.kite` has the arithmetic; this decides which of them applies, and
// `interaction.kite` decides how far each has come.

pub struct State {
    pub hovered: bool
    pub focused: bool
    pub pressed: bool
    pub selected: bool
    pub disabled: bool
    /// How far each layer has come in, from 0 to 1.
    ///
    /// The booleans say *what* is happening and these say *how far* — which is
    /// the difference between a control that changes colour and a Material
    /// control. They come from `interaction.kite`, which is the only thing that
    /// can hold a value between frames, and a `State` built by hand leaves them
    /// pinned to its booleans so a component reading either agrees.
    pub hover: float
    pub focus: float
    pub press: float
    pub select: float
}

pub fn rest() -> State {
    return State{
        hovered: false,
        focused: false,
        pressed: false,
        selected: false,
        disabled: false,
        hover: 0.0,
        focus: 0.0,
        press: 0.0,
        select: 0.0,
    }
}

/// The common case: a control that is or is not the focused one.
pub fn when_focused(is_focused: bool) -> State {
    return State{
        ..rest(),
        focused: is_focused,
        focus: if is_focused { 1.0 } else { 0.0 },
    }
}

pub fn when_selected(is_selected: bool, is_focused: bool) -> State {
    return State{
        ..when_focused(is_focused),
        selected: is_selected,
        select: if is_selected { 1.0 } else { 0.0 },
    }
}

pub fn when_disabled() -> State {
    return State{..rest(), disabled: true }
}

/// How strong the state layer is, from 0 to Material's heaviest opacity.
///
/// Material draws one layer at a time — the strongest interaction currently
/// happening — and this used to be three `if`s in that order. It is a maximum
/// now, and the change is the point rather than a tidying: with the layers
/// animated, a control being pressed while its hover retreats has *two* layers
/// part-way, and picking the branch that wins throws away the one that is
/// fading. Taking the strongest crossfades between them instead, which is what
/// the branch was approximating all along and what makes a press on an
/// already-hovered button look like one movement rather than two.
pub fn layer_strength(state: State) -> float {
    if state.disabled {
        return 0.0
    }
    return maxf(
        maxf(state.press * PRESS_OPACITY(), state.focus * FOCUS_OPACITY()),
        state.hover * HOVER_OPACITY(),
    )
}

/// A container colour with whatever state layer applies laid over it.
pub fn layered(container: int, on_container: int, state: State) -> int {
    let strength = layer_strength(state)
    if strength <= 0.0 {
        return container
    }
    return mix(container, on_container, strength)
}

/// The state layer alone, for a control that has no container of its own — a
/// text button, a standard icon button, a list row.
///
/// **Translucent**, not pre-blended, and that is the whole point of it. A layer
/// mixed against an assumed backdrop is only right when the assumption is: a
/// list row's layer computed against `surface` is drawn on a *card*, which is
/// two container tones lighter, so the blend starts two tones too dark. On the
/// way in the row darkens before it lightens, and on the way out a dark patch
/// appears and then vanishes — which is what a state layer looks like when it
/// is guessing what it sits on.
///
/// `Decor.alpha` removes the guess. The layer is the role colour at the state's
/// own opacity over whatever is behind it, which is Material's own definition
/// and needs to know nothing at all.
///
/// It works because alpha is *per frame*: a box's own frame carries no text, so
/// fading it fades its fill and nothing else — the label inside is a separate
/// frame at full opacity. That is also why [`centred_body`] puts the container
/// on a box rather than on the caption; a layer sharing a node with its label
/// would take the label down to eight per cent with it.
pub fn layer_decor(role: int, state: State, radius: float) -> ui.Decor {
    let strength = layer_strength(state)
    if strength <= 0.0 {
        return ui.shaped(ui.no_decor(), radius)
    }
    return ui.faded(ui.rounded(role, radius), strength)
}

/// How far a component's selection has come, given both the application's own
/// boolean and whatever the interaction happens to be animating.
///
/// A component is told two things about being selected — the model's fact, and
/// the state layer's progress — and they can disagree in exactly one way that
/// matters: a `State` built by hand, or built for a different control, carries
/// no animation for this one. When the two agree the animated value leads and
/// intermediate frames are honoured; when they do not, the boolean is the whole
/// truth and the component snaps rather than showing the wrong thing.
pub fn chosen_amount(on: bool, state: State) -> float {
    if state.selected == on {
        return state.select
    }
    return if on { 1.0 } else { 0.0 }
}

/// The surface colour between two elevation levels, `amount` of the way up.
///
/// Elevation here is tonal, and tone is a colour, so a component rising under
/// the pointer can rise *continuously* — which a stack of six named levels
/// cannot express and a shadow would have done for free.
pub fn raised(s: Scheme, from: int, to: int, amount: float) -> int {
    return mix(surface_at(s, from), surface_at(s, to), clampf(amount, 0.0, 1.0))
}

/// A shape token resolved against the box it applies to.
///
/// `SHAPE_FULL` is a sentinel — a number past half the shorter side, which the
/// painter clamps — and a sentinel cannot be interpolated. Resolving it first
/// is what lets a corner be animated at all.
pub fn resolved_shape(radius: float, w: float, h: float) -> float {
    return minf(radius, minf(w, h) / 2.0)
}

/// A corner squared off under the finger.
///
/// Material 3 Expressive morphs a pressed button from its resting shape toward
/// a squarer one and back. It is the clearest single piece of evidence that a
/// press registered — clearer than the state layer, because it changes the
/// component's *outline* rather than its fill, and an outline changing is
/// visible against any background.
pub fn morphed(radius: float, w: float, h: float, press: float) -> float {
    let resting = resolved_shape(radius, w, h)
    return math.lerp(resting, minf(resting, SHAPE_SMALL()), clampf(press, 0.0, 1.0))
}

// ---- sizes ---------------------------------------------------------------------
//
// Material 3 Expressive gave the common buttons a size scale, and it is not
// five arbitrary heights: each size pairs a height with the type role that fits
// in it and the padding that keeps the label off the edge. Passing the three
// around together is what stops a 96dp button from being captioned at 14dp.

pub struct Sizing {
    pub height: float
    pub padding: float
    pub label: TypeRole
    /// The resting corner radius, before any press morph.
    pub shape: float
    /// The size a leading glyph is drawn at.
    pub icon: float
}

pub fn button_xsmall() -> Sizing {
    return Sizing{
        height: 32.0,
        padding: 12.0,
        label: label_large(),
        shape: SHAPE_FULL(),
        icon: 20.0,
    }
}

/// The default, and what Material called simply "button" before the scale
/// existed: 40dp tall, label-large, 24dp either side.
pub fn button_small() -> Sizing {
    return Sizing{
        height: 40.0,
        padding: 24.0,
        label: label_large(),
        shape: SHAPE_FULL(),
        icon: 20.0,
    }
}

pub fn button_medium() -> Sizing {
    return Sizing{
        height: 56.0,
        padding: 24.0,
        label: title_medium(),
        shape: SHAPE_FULL(),
        icon: 24.0,
    }
}

pub fn button_large() -> Sizing {
    return Sizing{
        height: 96.0,
        padding: 48.0,
        label: headline_small(),
        shape: SHAPE_FULL(),
        icon: 32.0,
    }
}

pub fn button_xlarge() -> Sizing {
    return Sizing{
        height: 136.0,
        padding: 64.0,
        label: headline_large(),
        shape: SHAPE_FULL(),
        icon: 40.0,
    }
}

// ---- shared shapes --------------------------------------------------------------

/// A control that is one centred line inside a fixed box.
///
/// No padding: `ui.centered` centres on both axes, so a control that is a
/// single line in a box of a known size needs no arithmetic to place it. The
/// first version computed the top inset from the host's line height, which is
/// the same answer on one font and the wrong one on every other.
///
/// The container and the caption are two nodes rather than one, and they have
/// to be. A state layer is translucent — see [`layer_decor`] — and `Decor.alpha`
/// fades a frame's *text* along with its fill, so a layer sharing a node with
/// the label would fade the label to eight per cent along with itself. Split,
/// the box carries the container and the caption carries only its ink, which is
/// also what lets a ripple find the control's colour: `decor.ink` is on the
/// frame the ripple is clipped to.
fn centred_body<Msg>(
    id: str,
    msg: Msg,
    enabled: bool,
    caption: str,
    size: float,
    weight: int,
    w: float,
    h: float,
    decor: ui.Decor,
) -> ui.Node<Msg> {
    let label: ui.Node<Msg> = ui.decorated(
        ui.text_of(
            "\(id)-label",
            ui.sized(ui.in_font(ui.style(), size, weight), w, h),
            caption,
        ),
        ui.centered(ui.ink(decor.ink)),
    )
    let box: ui.Node<Msg> = ui.box_of(id, ui.sized(ui.style(), w, h), [label])
    let whole = ui.means(ui.decorated(box, decor), id, msg, caption)
    if enabled {
        return whole
    }
    return ui.disabled(whole)
}

/// A mark and its label, side by side, as one control.
fn labelled_control<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    mark: ui.Node<Msg>,
    caption: str,
    state: State,
) -> ui.Node<Msg> {
    let role = body_large()
    var children = [mark]
    if caption.len() > 0 {
        children.push(
            ui.decorated(
                ui.text_of(
                    "\(id)-caption",
                    ui.in_font(ui.style(), role.size, role.weight),
                    caption,
                ),
                ui.ink(if state.disabled { disabled_ink(s, s.surface) } else { s.on_surface }),
            ),
        )
    }
    let box: ui.Node<Msg> = ui.box_of(
        id,
        ui.spaced(
            ui.padded(ui.Style{..ui.row(), align: ui.Align.Center }, space(2)),
            space(3),
        ),
        children,
    )
    // The control carries the ink even though it draws no text of its own: a
    // ripple takes its colour from the control's ink, and a checkbox whose
    // control node had none would ripple in black on a dark theme.
    let whole = ui.means(ui.decorated(box, ui.ink(s.on_surface)), id, msg, caption)
    if state.disabled {
        return ui.disabled(whole)
    }
    return whole
}

/// A glyph and a label in one control, at a width the caller has already
/// worked out.
///
/// The width is a parameter rather than a measurement because the two places
/// that want this — a split button's leading half and [`icon_label_button`] —
/// have each already measured it, and a second measurement is a second chance
/// to disagree with the container that was drawn at the first one.
fn glyph_and_label<Msg>(
    id: str,
    msg: Msg,
    caption: str,
    glyph: str,
    sizing: Sizing,
    width: float,
    ink: int,
    decor: ui.Decor,
    state: State,
) -> ui.Node<Msg> {
    let role = sizing.label
    let inner = ui.Style{
        ..ui.row(),
        align: ui.Align.Center,
        justify: ui.Justify.Center,
        width: width,
        height: sizing.height,
        gap: space(2),
    }
    let box: ui.Node<Msg> = ui.box_of(
        id,
        inner,
        [
            inked_text("\(id)-glyph", ui.in_font(ui.style(), sizing.icon, REGULAR()), glyph, ink),
            inked_text(
                "\(id)-label",
                ui.in_font(ui.style(), role.size, role.weight),
                caption,
                ink,
            ),
        ],
    )
    let whole = ui.means(ui.decorated(box, decor), id, msg, caption)
    if state.disabled {
        return ui.disabled(whole)
    }
    return whole
}

fn bar<Msg>(name: str, width: float, height: float, colour: int) -> ui.Node<Msg> {
    return ui.decorated(
        ui.box_of(name, ui.sized(ui.style(), width, height), []),
        ui.rounded(colour, SHAPE_FULL()),
    )
}

fn spacer<Msg>(name: str, width: float) -> ui.Node<Msg> {
    return ui.box_of(name, ui.sized(ui.style(), width, 1.0), [])
}

fn clamp_to(v: float, low: float, high: float) -> float {
    return clampf(v, low, high)
}

fn insets_all(v: float) -> ui.Insets {
    return ui.insets(v)
}

/// A style with a fixed height and its width left to the content.
///
/// The components that span their parent — an app bar, a list row, a snackbar —
/// used to say `ui.sized(style, 0.0, height)`, and a *fixed* width of zero is
/// not the same claim as no fixed width at all. It measures as zero, so such a
/// component was only ever the right size when its parent happened to stretch
/// it; dropped into a `Start`-aligned column it laid out one pixel wide with
/// its content spilling out of it. Leaving the width nil measures the content
/// and still stretches when a parent says to.
fn tall(base: ui.Style, height: float) -> ui.Style {
    return ui.Style{..base, height: height }
}

/// A run of text in a known colour — what a glyph or a label inside a composed
/// control needs.
///
/// The painter draws each frame's own text in that frame's own ink, so a text
/// node left undecorated inside a decorated box is drawn in black however the
/// box was inked. That is how the extended FAB's caption came out black on
/// purple.
fn inked_text<Msg>(name: str, style: ui.Style, body: str, colour: int) -> ui.Node<Msg> {
    return ui.decorated(ui.text_of(name, style, body), ui.ink(colour))
}

// ---- buttons -----------------------------------------------------------------
//
// The five common buttons, which differ only in container and outline. Material
// distinguishes them by emphasis, and emphasis is entirely a matter of which
// colour role the container takes.
//
// All five morph squarer under the finger and all five animate their state
// layer. The elevated one also *rises*, tonally, which is the one place the
// missing shadow is visible and the one place Material's own dark-theme rule
// says a tone is the right answer anyway.

fn BUTTON_HEIGHT() -> float {
    return 40.0
}

fn BUTTON_PADDING() -> float {
    return 24.0
}

fn button_width(caption: str, sizing: Sizing) -> float {
    let measured = ui.text_size_in(caption, sizing.label.size, sizing.label.weight).width
    return measured + sizing.padding * 2.0
}

fn button_body<Msg>(
    id: str,
    msg: Msg,
    enabled: bool,
    caption: str,
    sizing: Sizing,
    decor: ui.Decor,
) -> ui.Node<Msg> {
    return centred_body(
        id,
        msg,
        enabled,
        caption,
        sizing.label.size,
        sizing.label.weight,
        button_width(caption, sizing),
        sizing.height,
        decor,
    )
}

/// The container decoration a button of this size wears, with its corner
/// morphed by however far the press has come.
fn button_decor(
    caption: str,
    sizing: Sizing,
    container: int,
    ink: int,
    state: State,
) -> ui.Decor {
    let w = button_width(caption, sizing)
    let radius = morphed(sizing.shape, w, sizing.height, state.press)
    return ui.inked(ui.rounded(container, radius), ink)
}

/// The highest-emphasis button: a filled primary container.
pub fn filled_button<Msg>(s: Scheme, id: str, msg: Msg, caption: str, state: State) -> ui.Node<Msg> {
    return filled_button_of(s, id, msg, caption, button_small(), state)
}

pub fn filled_button_of<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    caption: str,
    sizing: Sizing,
    state: State,
) -> ui.Node<Msg> {
    if state.disabled {
        return button_body(
            id,
            msg,
            !state.disabled,
            caption,
            sizing,
            button_decor(
                caption,
                sizing,
                disabled_container(s, s.surface),
                disabled_ink(s, s.surface),
                state,
            ),
        )
    }
    let container = layered(s.primary, s.on_primary, state)
    return button_body(id, msg, !state.disabled, caption, sizing, button_decor(caption, sizing, container, s.on_primary, state))
}

/// A secondary action beside a primary one: the secondary container, filled.
pub fn tonal_button<Msg>(s: Scheme, id: str, msg: Msg, caption: str, state: State) -> ui.Node<Msg> {
    return tonal_button_of(s, id, msg, caption, button_small(), state)
}

pub fn tonal_button_of<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    caption: str,
    sizing: Sizing,
    state: State,
) -> ui.Node<Msg> {
    if state.disabled {
        return button_body(
            id,
            msg,
            !state.disabled,
            caption,
            sizing,
            button_decor(
                caption,
                sizing,
                disabled_container(s, s.surface),
                disabled_ink(s, s.surface),
                state,
            ),
        )
    }
    let container = layered(s.secondary_container, s.on_secondary_container, state)
    return button_body(
        id,
        msg,
        !state.disabled,
        caption,
        sizing,
        button_decor(caption, sizing, container, s.on_secondary_container, state),
    )
}

/// Medium emphasis: an outline and no fill until it is interacted with.
///
/// The outline thickens and takes the accent on focus, which is Material's
/// focus indicator for an outlined component — and it is animated, so the
/// thickening is a movement rather than a jump.
pub fn outlined_button<Msg>(s: Scheme, id: str, msg: Msg, caption: str, state: State) -> ui.Node<Msg> {
    return outlined_button_of(s, id, msg, caption, button_small(), state)
}

pub fn outlined_button_of<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    caption: str,
    sizing: Sizing,
    state: State,
) -> ui.Node<Msg> {
    let w = button_width(caption, sizing)
    let radius = morphed(sizing.shape, w, sizing.height, state.press)
    if state.disabled {
        let flat = ui.shaped(ui.no_decor(), radius)
        return button_body(
            id,
            msg,
            !state.disabled,
            caption,
            sizing,
            ui.bordered(
                ui.inked(flat, disabled_ink(s, s.surface)),
                disabled_container(s, s.surface),
                1.0,
            ),
        )
    }
    let edge = mix(s.outline, s.primary, state.focus)
    let width = math.lerp(1.0, 2.0, state.focus)
    let base = layer_decor(s.primary, state, radius)
    return button_body(id, msg, !state.disabled, caption, sizing, ui.bordered(ui.inked(base, s.primary), edge, width))
}

/// The lowest emphasis: a label and nothing else until it is interacted with.
pub fn text_button<Msg>(s: Scheme, id: str, msg: Msg, caption: str, state: State) -> ui.Node<Msg> {
    return text_button_of(s, id, msg, caption, button_small(), state)
}

pub fn text_button_of<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    caption: str,
    sizing: Sizing,
    state: State,
) -> ui.Node<Msg> {
    let w = button_width(caption, sizing)
    let radius = morphed(sizing.shape, w, sizing.height, state.press)
    let ink = if state.disabled { disabled_ink(s, s.surface) } else { s.primary }
    return button_body(
        id,
        msg,
        !state.disabled,
        caption,
        sizing,
        ui.inked(layer_decor(s.primary, state, radius), ink),
    )
}

/// Filled, but on a raised surface rather than on the accent.
///
/// The one button whose elevation changes with the pointer: level 1 at rest,
/// level 2 hovered, back to level 1 while held. Under a renderer with shadows
/// that is a shadow growing; here it is the container tone shifting, which is
/// Material's own rule for a dark theme and the honest half of the two.
pub fn elevated_button<Msg>(s: Scheme, id: str, msg: Msg, caption: str, state: State) -> ui.Node<Msg> {
    return elevated_button_of(s, id, msg, caption, button_small(), state)
}

pub fn elevated_button_of<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    caption: str,
    sizing: Sizing,
    state: State,
) -> ui.Node<Msg> {
    if state.disabled {
        return button_body(
            id,
            msg,
            !state.disabled,
            caption,
            sizing,
            button_decor(
                caption,
                sizing,
                disabled_container(s, s.surface),
                disabled_ink(s, s.surface),
                state,
            ),
        )
    }
    let lift = maxf(state.hover, state.focus) * (1.0 - state.press)
    let container = layered(raised(s, LEVEL_1(), LEVEL_2(), lift), s.primary, state)
    return button_body(id, msg, !state.disabled, caption, sizing, button_decor(caption, sizing, container, s.primary, state))
}

/// A button with a glyph before its label.
///
/// Material's leading icon, which is how a destructive or a confirming action
/// is told apart at a glance. The glyph is a `str` for the reason every glyph
/// in this package is: an icon font is not something a package can carry.
pub fn icon_label_button<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    glyph: str,
    caption: str,
    sizing: Sizing,
    state: State,
) -> ui.Node<Msg> {
    let container = layered(s.primary, s.on_primary, state)
    let ink = if state.disabled { disabled_ink(s, s.surface) } else { s.on_primary }
    let fill = if state.disabled { disabled_container(s, s.surface) } else { container }
    let measured = ui.text_size_in(caption, sizing.label.size, sizing.label.weight).width
    let w = measured + sizing.icon + space(2) + sizing.padding * 2.0
    let radius = morphed(sizing.shape, w, sizing.height, state.press)
    return glyph_and_label(
        id,
        msg,
        caption,
        glyph,
        sizing,
        w,
        ink,
        ui.inked(ui.rounded(fill, radius), ink),
        state,
    )
}

// ---- button groups ---------------------------------------------------------------
//
// Material 3 Expressive's answer to a row of related actions. There are two,
// and the difference is not spacing: a *standard* group is several buttons that
// happen to sit together, each still its own control with its own emphasis; a
// *connected* group is one control with several positions, which is what a
// choice between three things looks like when only one of them can be true.
//
// The behaviour that makes both of them Expressive rather than a row is the
// squeeze. Pressing a button in a group widens it and narrows its neighbours,
// keeping the group's total width fixed — so the row does not reflow around the
// finger, and the button under it is unmistakably the one that grew.

/// How much wider a button gets while it is held, as a fraction of its own
/// resting width.
fn GROUP_SQUEEZE() -> float {
    return 0.15
}

/// The 2dp Material leaves between the members of a connected group — enough
/// for the containers to read as separate, not enough for them to read as
/// separate controls.
fn CONNECTED_GAP() -> float {
    return 2.0
}

/// A standard button group: buttons in a row, 8dp apart.
///
/// It takes nodes rather than captions because the members of a standard group
/// are *ordinary buttons* and may each be a different one — a filled button
/// beside two outlined ones is the common case, and a group that built its own
/// members could not express it.
pub fn button_group<Msg>(name: str, children: [ui.Node<Msg>]) -> ui.Node<Msg> {
    return button_group_of(name, children, space(2))
}

pub fn button_group_of<Msg>(name: str, children: [ui.Node<Msg>], gap: float) -> ui.Node<Msg> {
    return ui.box_of(
        name,
        ui.spaced(ui.Style{..ui.row(), align: ui.Align.Center }, gap),
        children,
    )
}

/// The widths of a connected group's members, after the squeeze.
///
/// Separate from the drawing, and public, because it is the part with an answer
/// that can be checked: the group's total width is the same whatever is being
/// pressed, and that is a property rather than an appearance. What a button
/// gains, its neighbours give up in proportion to how wide they are and how far
/// they are from being pressed themselves.
pub fn squeezed_widths(resting: [float], presses: [float]) -> [float] {
    let count = resting.len()
    var gained = 0.0
    var shares = 0.0
    for i in 0..count {
        let press = clampf(if i < presses.len() { presses[i] } else { 0.0 }, 0.0, 1.0)
        gained = gained + resting[i] * GROUP_SQUEEZE() * press
        shares = shares + resting[i] * (1.0 - press)
    }
    var out: [float] = []
    for i in 0..count {
        let press = clampf(if i < presses.len() { presses[i] } else { 0.0 }, 0.0, 1.0)
        let gain = resting[i] * GROUP_SQUEEZE() * press
        // With every member fully pressed there is nobody to take the width
        // from, so nobody gives any up. That is a state a pointer cannot reach
        // and a `State` built by hand can, which is why it is a branch rather
        // than an assumption.
        var give = 0.0
        if shares > 0.0 {
            give = gained * (resting[i] * (1.0 - press)) / shares
        }
        out.push(maxf(0.0, resting[i] + gain - give))
    }
    return out
}

/// A corner that *rounds* under the finger rather than squaring off.
///
/// The opposite of [`morphed`], and deliberately: a connected group's members
/// rest as small-cornered rectangles so the row reads as one control, and
/// Material rounds the pressed one out of the row to say which it is. Squaring
/// it further would say nothing, there being nothing left to square.
fn rounded_under_press(resting: float, w: float, h: float, press: float) -> float {
    return math.lerp(
        resolved_shape(resting, w, h),
        resolved_shape(SHAPE_FULL(), w, h),
        clampf(press, 0.0, 1.0),
    )
}

/// A connected button group: one control with two to five positions.
///
/// Material draws the group's outer corners full and its inner ones small, so
/// the row reads as a single pill cut into pieces. `Decor` has one radius for
/// all four corners, so each member here is small-cornered and the group's ends
/// are square rather than round — the same limit `segmented_button` documents,
/// and the reason the two exist side by side. This one is the *toggle*: it
/// squeezes, it has no shared outline, and its members carry the selected
/// container rather than a tick.
pub fn connected_button_group<Msg>(
    s: Scheme,
    name: str,
    items: [Segment2<Msg>],
    states: [State],
) -> ui.Node<Msg> {
    return connected_button_group_of(s, name, items, button_small(), states)
}

pub fn connected_button_group_of<Msg>(
    s: Scheme,
    name: str,
    items: [Segment2<Msg>],
    sizing: Sizing,
    states: [State],
) -> ui.Node<Msg> {
    let role = sizing.label
    var resting: [float] = []
    var presses: [float] = []
    for i in 0..items.len() {
        let state = if i < states.len() { states[i] } else { rest() }
        resting.push(
            ui.text_size_in(items[i].caption, role.size, role.weight).width + sizing.padding * 2.0,
        )
        presses.push(state.press)
    }
    let widths = squeezed_widths(resting, presses)
    var children: [ui.Node<Msg>] = []
    for i in 0..items.len() {
        let item = items[i]
        let state = if i < states.len() { states[i] } else { rest() }
        let amount = chosen_amount(item.selected, state)
        let width = widths[i]
        let container = mix(s.surface_container, s.secondary_container, amount)
        let ink = mix(s.on_surface_variant, s.on_secondary_container, amount)
        let radius = rounded_under_press(SHAPE_SMALL(), width, sizing.height, state.press)
        let fill = if state.disabled {
            disabled_container(s, s.surface)
        } else {
            layered(container, ink, state)
        }
        let label_ink = if state.disabled { disabled_ink(s, s.surface) } else { ink }
        children.push(
            centred_body(
                item.id,
                item.msg,
                !state.disabled,
                item.caption,
                role.size,
                role.weight,
                width,
                sizing.height,
                ui.inked(ui.rounded(fill, radius), label_ink),
            ),
        )
    }
    return ui.box_of(
        name,
        ui.spaced(ui.Style{..ui.row(), align: ui.Align.Center }, CONNECTED_GAP()),
        children,
    )
}

// ---- split button ----------------------------------------------------------------

/// A split button: one action, and a menu of the others beside it.
///
/// Two controls in one container, and they are genuinely two — the label runs
/// the default action and the chevron opens the menu, which is the whole reason
/// the component exists. So it takes two ids, two messages and two states, and
/// nothing about it guesses which half the pointer is over.
pub struct Split<Msg> {
    pub id: str
    pub msg: Msg
    pub caption: str
    /// A glyph before the label, or "" for none.
    pub glyph: str
    pub menu_id: str
    pub menu_msg: Msg
    /// Whether the menu is open, which is what turns the chevron over.
    pub open: bool
}

/// Not `split`: the prelude already has one, and it cuts up strings.
pub fn split_action<Msg>(
    id: str,
    msg: Msg,
    caption: str,
    menu_id: str,
    menu_msg: Msg,
) -> Split<Msg> {
    return Split{
        id: id,
        msg: msg,
        caption: caption,
        glyph: "",
        menu_id: menu_id,
        menu_msg: menu_msg,
        open: false,
    }
}

/// The trailing half is a square of the button's own height, which is what
/// keeps the chevron centred in it at every size on the scale.
pub fn split_button<Msg>(
    s: Scheme,
    name: str,
    spec: Split<Msg>,
    lead_state: State,
    menu_state: State,
) -> ui.Node<Msg> {
    return split_button_of(s, name, spec, button_small(), lead_state, menu_state)
}

pub fn split_button_of<Msg>(
    s: Scheme,
    name: str,
    spec: Split<Msg>,
    sizing: Sizing,
    lead_state: State,
    menu_state: State,
) -> ui.Node<Msg> {
    let role = sizing.label
    let measured = ui.text_size_in(spec.caption, role.size, role.weight).width
    var lead_width = measured + sizing.padding * 2.0
    if spec.glyph.len() > 0 {
        lead_width = lead_width + sizing.icon + space(2)
    }
    let trail_width = sizing.height
    // The two halves squeeze against each other exactly as a group's members
    // do, which is what makes a split button read as one thing being pressed in
    // two places rather than as two buttons that happen to touch.
    let widths = squeezed_widths([lead_width, trail_width], [lead_state.press, menu_state.press])

    let lead_fill = if lead_state.disabled {
        disabled_container(s, s.surface)
    } else {
        layered(s.primary, s.on_primary, lead_state)
    }
    let lead_ink = if lead_state.disabled { disabled_ink(s, s.surface) } else { s.on_primary }
    let lead_radius = rounded_under_press(SHAPE_LARGE(), widths[0], sizing.height, lead_state.press)

    let lead_decor = ui.inked(ui.rounded(lead_fill, lead_radius), lead_ink)
    let lead: ui.Node<Msg> = if spec.glyph.len() > 0 {
        glyph_and_label(spec.id, spec.msg, spec.caption, spec.glyph, sizing, widths[0], lead_ink, lead_decor, lead_state)
    } else {
        centred_body(
            spec.id,
            spec.msg,
            !lead_state.disabled,
            spec.caption,
            role.size,
            role.weight,
            widths[0],
            sizing.height,
            lead_decor,
        )
    }

    let menu_fill = if menu_state.disabled {
        disabled_container(s, s.surface)
    } else {
        layered(s.primary, s.on_primary, menu_state)
    }
    let menu_ink = if menu_state.disabled { disabled_ink(s, s.surface) } else { s.on_primary }
    // The chevron turns over when the menu is open, which is the only thing on
    // a split button that says whether pressing it will open or close.
    let chevron = if spec.open { "▴" } else { "▾" }
    let menu_radius = rounded_under_press(
        SHAPE_LARGE(),
        widths[1],
        sizing.height,
        maxf(menu_state.press, if spec.open { 1.0 } else { 0.0 }),
    )
    let trail: ui.Node<Msg> = centred_body(
        spec.menu_id,
        spec.menu_msg,
        !menu_state.disabled,
        chevron,
        sizing.icon,
        REGULAR(),
        widths[1],
        sizing.height,
        ui.inked(ui.rounded(menu_fill, menu_radius), menu_ink),
    )
    return ui.box_of(
        name,
        ui.spaced(ui.Style{..ui.row(), align: ui.Align.Center }, CONNECTED_GAP()),
        [lead, trail],
    )
}

// ---- icon buttons -------------------------------------------------------------
//
// Four emphases, the same four the common buttons have, and each of them also a
// *toggle*: an icon button that is either on or off, which is what a star, a
// mute and a bookmark are. Material draws the two differently enough that a
// toggle is not simply an icon button with a flag — the standard toggle changes
// its glyph's colour, and the filled one swaps its container entirely.

// Material 3 Expressive gave these a size scale too, and it is the same five
// names the common buttons use — so an icon button beside a medium button is
// the same height as it without either of them saying a number.

fn icon_side(sizing: Sizing) -> float {
    return sizing.height
}

/// A square of `side` with a glyph in the middle. Icon buttons have no label,
/// so the type role and the horizontal padding a `Sizing` also carries are
/// unused here, and the height is the whole of the size.
fn icon_sizing(side: float, glyph: float) -> Sizing {
    return Sizing{
        height: side,
        padding: 0.0,
        label: label_large(),
        shape: SHAPE_FULL(),
        icon: glyph,
    }
}

pub fn icon_button_xsmall() -> Sizing {
    return icon_sizing(32.0, 20.0)
}

/// The default: a 40dp target around a 24dp glyph.
pub fn icon_button_small() -> Sizing {
    return icon_sizing(40.0, 24.0)
}

pub fn icon_button_medium() -> Sizing {
    return icon_sizing(56.0, 24.0)
}

pub fn icon_button_large() -> Sizing {
    return icon_sizing(96.0, 32.0)
}

pub fn icon_button_xlarge() -> Sizing {
    return icon_sizing(136.0, 40.0)
}

fn icon_button_body<Msg>(
    id: str,
    msg: Msg,
    enabled: bool,
    glyph: str,
    sizing: Sizing,
    decor: ui.Decor,
) -> ui.Node<Msg> {
    let side = icon_side(sizing)
    return centred_body(id, msg, enabled, glyph, sizing.icon, REGULAR(), side, side, decor)
}

fn icon_radius(sizing: Sizing, state: State) -> float {
    let side = icon_side(sizing)
    return morphed(sizing.shape, side, side, state.press)
}

/// A 40dp target around a glyph, with no container of its own.
pub fn icon_button<Msg>(s: Scheme, id: str, msg: Msg, glyph: str, state: State) -> ui.Node<Msg> {
    return icon_button_of(s, id, msg, glyph, icon_button_small(), state)
}

pub fn icon_button_of<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    glyph: str,
    sizing: Sizing,
    state: State,
) -> ui.Node<Msg> {
    let ink = if state.disabled {
        disabled_ink(s, s.surface)
    } else {
        s.on_surface_variant
    }
    let decor = layer_decor(s.on_surface_variant, state, icon_radius(sizing, state))
    return icon_button_body(id, msg, !state.disabled, glyph, sizing, ui.inked(decor, ink))
}

/// The same, on or off. Selected takes the accent; unselected does not.
pub fn icon_toggle<Msg>(s: Scheme, id: str, msg: Msg, glyph: str, on: bool, state: State) -> ui.Node<Msg> {
    return icon_toggle_of(s, id, msg, glyph, on, icon_button_small(), state)
}

pub fn icon_toggle_of<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    glyph: str,
    on: bool,
    sizing: Sizing,
    state: State,
) -> ui.Node<Msg> {
    let role = mix(s.on_surface_variant, s.primary, chosen_amount(on, state))
    let decor = layer_decor(role, state, icon_radius(sizing, state))
    return icon_button_body(id, msg, !state.disabled, glyph, sizing, ui.inked(decor, role))
}

/// The highest-emphasis icon button: a filled primary container.
pub fn filled_icon_button<Msg>(s: Scheme, id: str, msg: Msg, glyph: str, state: State) -> ui.Node<Msg> {
    return filled_icon_button_of(s, id, msg, glyph, icon_button_small(), state)
}

pub fn filled_icon_button_of<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    glyph: str,
    sizing: Sizing,
    state: State,
) -> ui.Node<Msg> {
    if state.disabled {
        return icon_button_body(
            id,
            msg,
            !state.disabled,
            glyph,
            sizing,
            ui.inked(
                ui.rounded(disabled_container(s, s.surface), icon_radius(sizing, state)),
                disabled_ink(s, s.surface),
            ),
        )
    }
    let container = layered(s.primary, s.on_primary, state)
    return icon_button_body(
        id,
        msg,
        !state.disabled,
        glyph,
        sizing,
        ui.inked(ui.rounded(container, icon_radius(sizing, state)), s.on_primary),
    )
}

/// A filled icon *toggle*: the container itself crosses from the unselected
/// surface to the accent, which is the strongest way Material says "on".
pub fn filled_icon_toggle<Msg>(s: Scheme, id: str, msg: Msg, glyph: str, on: bool, state: State) -> ui.Node<Msg> {
    return filled_icon_toggle_of(s, id, msg, glyph, on, icon_button_small(), state)
}

pub fn filled_icon_toggle_of<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    glyph: str,
    on: bool,
    sizing: Sizing,
    state: State,
) -> ui.Node<Msg> {
    let amount = chosen_amount(on, state)
    let resting = mix(s.surface_container_highest, s.primary, amount)
    let ink = mix(s.primary, s.on_primary, amount)
    let container = layered(resting, ink, state)
    return icon_button_body(
        id,
        msg,
        !state.disabled,
        glyph,
        sizing,
        ui.inked(ui.rounded(container, icon_radius(sizing, state)), ink),
    )
}

pub fn tonal_icon_button<Msg>(s: Scheme, id: str, msg: Msg, glyph: str, state: State) -> ui.Node<Msg> {
    return tonal_icon_button_of(s, id, msg, glyph, icon_button_small(), state)
}

pub fn tonal_icon_button_of<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    glyph: str,
    sizing: Sizing,
    state: State,
) -> ui.Node<Msg> {
    let container = layered(s.secondary_container, s.on_secondary_container, state)
    return icon_button_body(
        id,
        msg,
        !state.disabled,
        glyph,
        sizing,
        ui.inked(ui.rounded(container, icon_radius(sizing, state)), s.on_secondary_container),
    )
}

/// A tonal icon toggle: the secondary container when off, the *primary* one
/// when on. The container is there in both states, so what says "on" is which
/// container it is — the same distinction the tonal button makes against the
/// filled one, a step down in emphasis.
pub fn tonal_icon_toggle<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    glyph: str,
    on: bool,
    state: State,
) -> ui.Node<Msg> {
    return tonal_icon_toggle_of(s, id, msg, glyph, on, icon_button_small(), state)
}

pub fn tonal_icon_toggle_of<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    glyph: str,
    on: bool,
    sizing: Sizing,
    state: State,
) -> ui.Node<Msg> {
    let amount = chosen_amount(on, state)
    let resting = mix(s.surface_container_highest, s.secondary_container, amount)
    let ink = mix(s.on_surface_variant, s.on_secondary_container, amount)
    let container = layered(resting, ink, state)
    return icon_button_body(
        id,
        msg,
        !state.disabled,
        glyph,
        sizing,
        ui.inked(ui.rounded(container, icon_radius(sizing, state)), ink),
    )
}

pub fn outlined_icon_button<Msg>(s: Scheme, id: str, msg: Msg, glyph: str, state: State) -> ui.Node<Msg> {
    return outlined_icon_button_of(s, id, msg, glyph, icon_button_small(), state)
}

pub fn outlined_icon_button_of<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    glyph: str,
    sizing: Sizing,
    state: State,
) -> ui.Node<Msg> {
    let radius = icon_radius(sizing, state)
    let edge = mix(s.outline, s.primary, state.focus)
    let base = layer_decor(s.on_surface_variant, state, radius)
    return icon_button_body(
        id,
        msg,
        !state.disabled,
        glyph,
        sizing,
        ui.bordered(
            ui.inked(base, s.on_surface_variant),
            edge,
            math.lerp(1.0, 2.0, state.focus),
        ),
    )
}

/// An outlined icon *toggle*: the outline stays and the container arrives.
///
/// Selected, Material fills it with `inverse_surface` — the one place a control
/// goes to the opposite scheme to say it is on. It reads at a glance in a row
/// of unselected ones, which is what a toggle in a toolbar has to do.
pub fn outlined_icon_toggle<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    glyph: str,
    on: bool,
    state: State,
) -> ui.Node<Msg> {
    return outlined_icon_toggle_of(s, id, msg, glyph, on, icon_button_small(), state)
}

pub fn outlined_icon_toggle_of<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    glyph: str,
    on: bool,
    sizing: Sizing,
    state: State,
) -> ui.Node<Msg> {
    let amount = chosen_amount(on, state)
    let radius = icon_radius(sizing, state)
    let ink = mix(s.on_surface_variant, s.inverse_on_surface, amount)
    // The outline fades out as the fill arrives: an outline around a filled
    // inverse container is a hairline nobody asked for.
    let edge = mix(mix(s.outline, s.primary, state.focus), s.inverse_surface, amount)
    var base = layer_decor(ink, state, radius)
    if amount > 0.0 {
        base = ui.rounded(layered(mix(s.surface, s.inverse_surface, amount), ink, state), radius)
    }
    return icon_button_body(
        id,
        msg,
        !state.disabled,
        glyph,
        sizing,
        ui.bordered(ui.inked(base, ink), edge, math.lerp(1.0, 2.0, state.focus)),
    )
}

// ---- floating action buttons ----------------------------------------------------
//
// Three sizes and an extended form. A FAB rests at elevation 3 and rises to 4
// under the pointer, which here is a tone rather than a shadow — see the note
// at the top of this file.

pub fn FAB_SMALL() -> float {
    return 40.0
}

pub fn FAB_REGULAR() -> float {
    return 56.0
}

pub fn FAB_LARGE() -> float {
    return 96.0
}

fn fab_shape(side: float) -> float {
    if side <= FAB_SMALL() {
        return SHAPE_MEDIUM()
    }
    if side >= FAB_LARGE() {
        return SHAPE_EXTRA_LARGE()
    }
    return SHAPE_LARGE()
}

fn fab_glyph(side: float) -> float {
    if side <= FAB_SMALL() {
        return 24.0
    }
    if side >= FAB_LARGE() {
        return 36.0
    }
    return 24.0
}

/// 56dp on the primary container — Material's default FAB.
pub fn fab<Msg>(s: Scheme, id: str, msg: Msg, glyph: str, state: State) -> ui.Node<Msg> {
    return fab_of(s, id, msg, glyph, FAB_REGULAR(), state)
}

pub fn small_fab<Msg>(s: Scheme, id: str, msg: Msg, glyph: str, state: State) -> ui.Node<Msg> {
    return fab_of(s, id, msg, glyph, FAB_SMALL(), state)
}

pub fn large_fab<Msg>(s: Scheme, id: str, msg: Msg, glyph: str, state: State) -> ui.Node<Msg> {
    return fab_of(s, id, msg, glyph, FAB_LARGE(), state)
}

pub fn fab_of<Msg>(s: Scheme, id: str, msg: Msg, glyph: str, side: float, state: State) -> ui.Node<Msg> {
    let lift = maxf(state.hover, state.focus) * (1.0 - state.press)
    let base = mix(s.primary_container, surface_tinted(s, s.primary_container), lift)
    let container = layered(base, s.on_primary_container, state)
    let radius = morphed(fab_shape(side), side, side, state.press)
    let decor = ui.inked(ui.rounded(container, radius), s.on_primary_container)
    return centred_body(id, msg, !state.disabled, glyph, fab_glyph(side), REGULAR(), side, side, decor)
}

/// A FAB in the secondary or tertiary role, for a screen whose primary action
/// is not the accent one.
pub fn secondary_fab<Msg>(s: Scheme, id: str, msg: Msg, glyph: str, state: State) -> ui.Node<Msg> {
    let container = layered(s.secondary_container, s.on_secondary_container, state)
    let side = FAB_REGULAR()
    let radius = morphed(fab_shape(side), side, side, state.press)
    return centred_body(
        id,
        msg,
        !state.disabled,
        glyph,
        fab_glyph(side),
        REGULAR(),
        side,
        side,
        ui.inked(ui.rounded(container, radius), s.on_secondary_container),
    )
}

pub fn tertiary_fab<Msg>(s: Scheme, id: str, msg: Msg, glyph: str, state: State) -> ui.Node<Msg> {
    let container = layered(s.tertiary_container, s.on_tertiary_container, state)
    let side = FAB_REGULAR()
    let radius = morphed(fab_shape(side), side, side, state.press)
    return centred_body(
        id,
        msg,
        !state.disabled,
        glyph,
        fab_glyph(side),
        REGULAR(),
        side,
        side,
        ui.inked(ui.rounded(container, radius), s.on_tertiary_container),
    )
}

/// The same with a label beside the glyph, for the one action a screen is for.
pub fn extended_fab<Msg>(s: Scheme, id: str, msg: Msg, glyph: str, caption: str, state: State) -> ui.Node<Msg> {
    let role = label_large()
    let lift = maxf(state.hover, state.focus) * (1.0 - state.press)
    let base = mix(s.primary_container, surface_tinted(s, s.primary_container), lift)
    let container = layered(base, s.on_primary_container, state)
    let height = FAB_REGULAR()
    let measured = ui.text_size_in(caption, role.size, role.weight).width
    let width = measured + 24.0 + space(2) + space(4) * 2.0
    let radius = morphed(SHAPE_LARGE(), width, height, state.press)
    let decor = ui.inked(ui.rounded(container, radius), s.on_primary_container)
    let inner = ui.Style{
        ..ui.row(),
        align: ui.Align.Center,
        justify: ui.Justify.Center,
        width: width,
        height: height,
        padding: ui.insets_xy(space(4), 0.0),
        gap: space(2),
    }
    let box: ui.Node<Msg> = ui.box_of(
        id,
        inner,
        [
            inked_text(
                "\(id)-glyph",
                ui.in_font(ui.style(), 24.0, REGULAR()),
                glyph,
                s.on_primary_container,
            ),
            inked_text(
                "\(id)-label",
                ui.in_font(ui.style(), role.size, role.weight),
                caption,
                s.on_primary_container,
            ),
        ],
    )
    let whole = ui.means(ui.decorated(box, decor), id, msg, caption)
    if state.disabled {
        return ui.disabled(whole)
    }
    return whole
}

/// A container tinted the way elevation tints one. Material raises a surface by
/// mixing the tint role into it; the fraction is the one Material's own
/// elevation overlay uses at level 4.
fn surface_tinted(s: Scheme, container: int) -> int {
    return mix(container, s.surface_tint, 0.12)
}

// ---- floating action button menus --------------------------------------------------
//
// A FAB that opens into the two to six actions behind it, which is Material 3
// Expressive's replacement for the speed dial.
//
// The items arrive one after another rather than together, and that is the
// component: a column that appeared all at once would be a menu drawn in FAB
// colours. [`stagger`] is the sequence, and it is a function rather than a
// schedule so the caller keeps the single `amount` a `Track` gives it — one
// number animated once, read six different ways.

/// How far the item at `index` has come when the menu as a whole is `amount`
/// open.
///
/// Each item takes sixty per cent of the menu's own time, and the starts are
/// spread across the remaining forty. The one nearest the trigger leads, which
/// is the direction the eye is already travelling: it left the FAB.
pub fn stagger(amount: float, index: int, count: int) -> float {
    let overall = clampf(amount, 0.0, 1.0)
    if count <= 1 {
        return overall
    }
    let span = 0.6
    let lead = (1.0 - span) / ((count - 1) as float)
    let start = lead * (index as float)
    return clampf((overall - start) / span, 0.0, 1.0)
}

/// One action in a FAB menu: a pill with its label before its glyph.
///
/// The label comes first because the menu hangs off a FAB in the trailing
/// corner, so the glyphs line up under the trigger and the labels run away from
/// it — which is Material's own arrangement and the reason the item is not just
/// an extended FAB lying on its side.
///
/// `amount` reveals it by *width*, the way a drawer and a sheet are revealed
/// here: nothing in this layout can scale a subtree, and a width that grows
/// from nothing is the reveal the boundary can draw honestly.
pub fn fab_menu_item<Msg>(
    s: Scheme,
    id: str,
    msg: Msg,
    glyph: str,
    caption: str,
    amount: float,
    state: State,
) -> ui.Node<Msg> {
    let role = label_large()
    let shown = clampf(amount, 0.0, 1.0)
    let height = 56.0
    let measured = ui.text_size_in(caption, role.size, role.weight).width
    let full = measured + 24.0 + space(2) + space(4) * 2.0
    let width = full * shown
    let container = layered(s.primary_container, s.on_primary_container, state)
    let ink = s.on_primary_container
    let inner = ui.Style{
        ..ui.row(),
        align: ui.Align.Center,
        justify: ui.Justify.Center,
        width: width,
        height: height,
        padding: ui.insets_xy(space(4), 0.0),
        gap: space(2),
    }
    let box: ui.Node<Msg> = ui.box_of(
        id,
        inner,
        [
            inked_text(
                "\(id)-label",
                ui.in_font(ui.style(), role.size, role.weight),
                caption,
                ink,
            ),
            inked_text("\(id)-glyph", ui.in_font(ui.style(), 24.0, REGULAR()), glyph, ink),
        ],
    )
    let decor = ui.inked(
        ui.rounded(container, morphed(SHAPE_FULL(), width, height, state.press)),
        ink,
    )
    let whole = ui.means(ui.decorated(box, decor), id, msg, caption)
    if state.disabled {
        return ui.disabled(whole)
    }
    return whole
}

/// The FAB a menu hangs from: a plus that becomes a close.
///
/// The two glyphs are swapped rather than turned. Material rotates the one into
/// the other, and a rotation is a transform the drawing boundary does not have;
/// swapping at the halfway point is what is left of it, and it happens under
/// the container's own colour change so the moment is covered.
pub fn fab_menu_toggle<Msg>(s: Scheme, id: str, msg: Msg, open: bool, state: State) -> ui.Node<Msg> {
    let amount = chosen_amount(open, state)
    let container = layered(
        mix(s.primary_container, s.secondary_container, amount),
        s.on_primary_container,
        state,
    )
    let side = FAB_REGULAR()
    let radius = morphed(fab_shape(side), side, side, state.press)
    let glyph = if amount >= 0.5 { "✕" } else { "＋" }
    return centred_body(
        id,
        msg,
        !state.disabled,
        glyph,
        fab_glyph(side),
        REGULAR(),
        side,
        side,
        ui.inked(ui.rounded(container, radius), s.on_primary_container),
    )
}

/// The menu itself: the items in a column above their trigger, all of them
/// aligned to the trailing edge the FAB sits on.
///
/// The trigger is a node the caller built — usually [`fab_menu_toggle`] — for
/// the reason a standard button group takes nodes: which FAB opens the menu is
/// the application's decision, and a menu that built its own could not be
/// opened by the one already on the screen.
///
/// There is no `amount` here and there should not be: the items carry their own
/// share of it through [`stagger`], and a menu that also took one would have two
/// places to disagree about whether it was open.
pub fn fab_menu<Msg>(
    name: str,
    items: [ui.Node<Msg>],
    trigger: ui.Node<Msg>,
) -> ui.Node<Msg> {
    var children: [ui.Node<Msg>] = []
    for one in items {
        children.push(one)
    }
    children.push(trigger)
    return ui.box_of(
        name,
        ui.spaced(
            ui.Style {..ui.column(), align: ui.Align.End, justify: ui.Justify.End },
            space(2),
        ),
        children,
    )
}

// ---- chips -------------------------------------------------------------------
//
// All four kinds. They share a shape and a height and differ in what they mean:
// an *assist* chip is an action, a *filter* chip is a choice that stays made, an
// *input* chip is a thing the user put there and can take away, and a
// *suggestion* chip is something the application is proposing.

fn CHIP_HEIGHT() -> float {
    return 32.0
}

fn chip_body<Msg>(
    id: str,
    msg: Msg,
    caption: str,
    leading: str,
    trailing: str,
    decor: ui.Decor,
    state: State,
) -> ui.Node<Msg> {
    let role = label_large()
    var shown = caption
    if leading.len() > 0 {
        shown = "\(leading) \(caption)"
    }
    if trailing.len() > 0 {
        shown = "\(shown) \(trailing)"
    }
    let width = ui.text_size_in(shown, role.size, role.weight).width + space(4) * 2.0
    let radius = morphed(SHAPE_SMALL(), width, CHIP_HEIGHT(), state.press)
    return centred_body(
        id,
        msg,
        !state.disabled,
        shown,
        role.size,
        role.weight,
        width,
        CHIP_HEIGHT(),
        ui.shaped(decor, radius),
    )
}

/// A filter chip: outlined until it is selected, then a filled secondary
/// container with a tick.
///
/// The crossing between the two is animated on the `select` channel, so the
/// outline fades as the fill arrives rather than the two swapping in one frame.
pub fn filter_chip<Msg>(s: Scheme, id: str, msg: Msg, caption: str, on: bool, state: State) -> ui.Node<Msg> {
    let amount = chosen_amount(on, state)
    let container = mix(s.surface, s.secondary_container, amount)
    let ink = mix(s.on_surface_variant, s.on_secondary_container, amount)
    let edge_alpha = 1.0 - amount
    var decor = ui.inked(ui.rounded(layered(container, ink, state), SHAPE_SMALL()), ink)
    if edge_alpha > 0.0 {
        decor = ui.bordered(
            decor,
            mix(container, mix(s.outline, s.primary, state.focus), edge_alpha),
            math.lerp(1.0, 2.0, state.focus),
        )
    }
    let tick = if on { "✓" } else { "" }
    return chip_body(id, msg, caption, tick, "", decor, state)
}

/// An assist chip: always outlined, for an action rather than a choice.
pub fn assist_chip<Msg>(s: Scheme, id: str, msg: Msg, caption: str, state: State) -> ui.Node<Msg> {
    let base = layer_decor(s.on_surface_variant, state, SHAPE_SMALL())
    let decor = ui.bordered(
        ui.inked(base, s.on_surface),
        mix(s.outline, s.primary, state.focus),
        math.lerp(1.0, 2.0, state.focus),
    )
    return chip_body(id, msg, caption, "", "", decor, state)
}

/// A suggestion chip: the same as an assist chip but labelled in the variant
/// ink, because it is the application talking rather than the user.
pub fn suggestion_chip<Msg>(s: Scheme, id: str, msg: Msg, caption: str, state: State) -> ui.Node<Msg> {
    let base = layer_decor(s.on_surface_variant, state, SHAPE_SMALL())
    let decor = ui.bordered(
        ui.inked(base, s.on_surface_variant),
        mix(s.outline, s.primary, state.focus),
        math.lerp(1.0, 2.0, state.focus),
    )
    return chip_body(id, msg, caption, "", "", decor, state)
}

/// An input chip: something the user entered, with a way to remove it.
///
/// The trailing glyph is part of the label rather than a control of its own,
/// which is the honest limit of a layout with no absolute positioning: a
/// nested hit target inside a chip would need the two rectangles to be
/// separately addressable, and here the whole chip is one control.
pub fn input_chip<Msg>(s: Scheme, id: str, msg: Msg, caption: str, state: State) -> ui.Node<Msg> {
    let base = layer_decor(s.on_surface_variant, state, SHAPE_SMALL())
    let decor = ui.bordered(
        ui.inked(base, s.on_surface_variant),
        mix(s.outline_variant, s.primary, state.focus),
        math.lerp(1.0, 2.0, state.focus),
    )
    return chip_body(id, msg, caption, "", "✕", decor, state)
}

// ---- badges -------------------------------------------------------------------

/// A badge: a small count on a container, in the error role, which is what
/// Material uses to mark something needing attention.
pub fn badge<Msg>(name: str, s: Scheme, count: str) -> ui.Node<Msg> {
    let role = label_small()
    let width = ui.text_size_in(count, role.size, role.weight).width + space(2) * 2.0
    let node: ui.Node<Msg> = ui.text_of(
        name,
        ui.sized(ui.in_font(ui.style(), role.size, role.weight), width, 16.0),
        count,
    )
    return ui.decorated(node, ui.centered(ui.inked(ui.rounded(s.error, SHAPE_FULL()), s.on_error)))
}

/// A badge with no number in it — a 6dp dot, which is Material's small badge
/// and is what marks "something changed" where a count would be noise.
pub fn small_badge<Msg>(name: str, s: Scheme) -> ui.Node<Msg> {
    return ui.decorated(
        ui.box_of(name, ui.sized(ui.style(), 6.0, 6.0), []),
        ui.rounded(s.error, SHAPE_FULL()),
    )
}

// ---- editing -------------------------------------------------------------------

/// A keystroke applied to a field's value.
///
/// It lives here rather than in the core because what a key does to a text
/// field is the field's behaviour, and the field is this package's component.
/// A design system that wanted different editing — a formatter that groups
/// digits, an input mask — would write its own and the core would not care.
pub fn typed(value: str, key: str) -> str {
    if key == "Backspace" {
        if value.len() == 0 {
            return value
        }
        return value.slice(0, value.len() - 1)
    }
    // Anything the host names rather than spells is a key this does not
    // handle: `ArrowLeft` is not four characters of input.
    if key.len() != 1 {
        return value
    }
    return value + key
}
