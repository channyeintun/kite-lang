// A task list, with a keyboard.
//
// This is the application the roadmap's Phase 7 asks for: something a person
// could use, driven entirely by the same `init`/`view`/`update` shape every
// Kite application has, and navigable without a pointer.
//
// The model never crosses the host boundary as data. It is a Wasm reference
// the page holds and hands back, opaque to JavaScript — which is what lets it
// be any Kite type at all, and why `update` returns a new model rather than
// changing one.

use std/ui
use material

struct Task {
    title: str
    done: bool
}

/// What this application can be told.
///
/// `Toggle` carries the index, built by the loop that knew it when it made the
/// row. The old version minted `"task3"` there and then pattern-matched
/// ninety-nine possible names in `update` to recover a number it had already
/// had — which is what a message with a payload is for.
enum Msg {
    Add
    Toggle(int)
}

struct Model {
    tasks: [Task]
    draft: str
    focused: str
    message: str
}

// The events the page sends. One door, so a new kind is a new constant.
fn EVENT_CLICK() -> int {
    return 0
}

fn EVENT_KEY() -> int {
    return 1
}

pub fn init() -> Model {
    return Model{
        tasks: [
            Task { title: "read the specification", done: true },
            Task { title: "write something in Kite", done: false },
        ],
        draft: "",
        focused: "draft",
        message: "tab moves, enter adds, space toggles",
    }
}

fn scheme() -> material.Scheme {
    return material.dark()
}

fn view_node(model: Model) -> ui.Node<Msg> {
    let s = scheme()
    var rows: [ui.Node<Msg>] = []
    for i in 0..model.tasks.len() {
        let task = model.tasks[i]
        rows.push(
            material.checkbox(
                s,
                "task\(i)",
                Msg.Toggle(i),
                task.title,
                task.done,
                material.when_focused(model.focused == "task\(i)"),
            ),
        )
    }

    let header: ui.Node<Msg> = ui.box_of(
        "header",
        ui.spaced(ui.padded(ui.Style{..ui.row(), align: ui.Align.Center }, 12.0), 8.0),
        [
            material.outlined_field(
                s,
                "draft",
                model.draft,
                "What needs doing?",
                260.0,
                material.when_focused(model.focused == "draft"),
            ),
            material.filled_button(
                s,
                "add",
                Msg.Add,
                "Add",
                material.when_focused(model.focused == "add"),
            ),
        ],
    )

    let list: ui.Node<Msg> = ui.box_of(
        "list",
        ui.spaced(ui.padded(ui.Style{..ui.column(), align: ui.Align.Stretch }, 12.0), 4.0),
        rows,
    )

    let done = count(model.tasks, |t: Task| t.done)
    let status: ui.Node<Msg> = ui.box_of(
        "status",
        ui.spaced(ui.padded(ui.column(), 12.0), 4.0),
        [
            ui.decorated(
                ui.text_of("status-count", ui.style(), "\(done) of \(model.tasks.len()) done"),
                ui.ink(s.on_surface),
            ),
            ui.decorated(ui.text_of("status-hint", ui.style(), model.message), ui.ink(s.on_surface_variant)),
        ],
    )

    return ui.decorated(
        ui.box_of(
            "app",
            ui.Style {..ui.column(), align: ui.Align.Stretch },
            [header, list, status],
        ),
        ui.filled(s.surface),
    )
}

fn viewport() -> ui.Size {
    return ui.Size{ width: 640.0, height: 360.0 }
}

fn frames_of(model: Model) -> [ui.Frame] {
    return ui.layout(view_node(model), viewport())
}

pub fn view(model: Model) {
    ui.paint(frames_of(model))
}

pub fn update(model: Model, event: int, x: float, y: float, key: str) -> Model {
    if event == EVENT_CLICK() {
        return clicked(model, x, y)
    }
    if event == EVENT_KEY() {
        return pressed(model, key)
    }
    return model
}

fn clicked(model: Model, x: float, y: float) -> Model {
    let tree = view_node(model)
    let frames = ui.layout(tree, viewport())
    let hit = ui.control_at(frames, x, y)
    if hit == nil {
        return model
    }
    // A click both moves focus and activates, and the two are separate facts:
    // every control takes focus, and only a control with a meaning acts.
    let focused = Model{..model, focused: hit }
    let said = ui.msg_at(tree, frames, x, y)
    if said == nil {
        return Model{..focused, message: "typing goes to the field" }
    }
    return act(focused, said)
}

/// Everything a control in this application can say.
///
/// Exhaustive, so a control added with a new variant will not compile until it
/// is handled here. What it replaces was an `if hit == "add"` and a
/// `task_id` helper that matched ninety-nine possible names to recover an
/// index the view already had.
fn act(model: Model, msg: Msg) -> Model {
    return match msg {
        Add => added(model),
        Toggle(at) => toggled(model, at),
    }
}

fn pressed(model: Model, key: str) -> Model {
    if key == "Tab" {
        return Model{..model, focused: ui.next_focus(ui.focus_order(frames_of(model)), model.focused) }
    }
    if key == "ArrowDown" {
        return Model{..model, focused: ui.next_focus(ui.focus_order(frames_of(model)), model.focused) }
    }
    if key == "ArrowUp" {
        return Model{..model, focused: ui.previous_focus(ui.focus_order(frames_of(model)), model.focused) }
    }
    // Enter and Space activate the focused control — and what that control
    // means is asked of the tree, not worked out from its name. Space is the
    // exception an editable control makes: a field types its space.
    let focused = ui.control_of(view_node(model), model.focused)
    // Narrowing works through an `if`, not through `&&` in an expression.
    var editing = false
    if focused != nil {
        editing = focused.edits != nil
    }
    if key == "Enter" || (key == " " && !editing) {
        let said = activation(focused)
        if said != nil {
            return act(model, said)
        }
        // A field with no meaning of its own still submits on Enter, which is
        // what every form does.
        if key == "Enter" && editing {
            return added(model)
        }
        return model
    }
    if editing {
        return Model{..model, draft: material.typed(model.draft, key) }
    }
    return model
}

/// What a control says when activated, given the control itself.
///
/// Disabled is checked here rather than at each call site, because "it looks
/// pressable and does nothing" is precisely the bug an enabled flag exists to
/// prevent.
fn activation(found: Option<ui.Control<Msg>>) -> Option<Msg> {
    if found == nil {
        return nil
    }
    if !found.enabled {
        return nil
    }
    return found.msg
}

fn added(model: Model) -> Model {
    let title = model.draft.trim()
    if title.len() == 0 {
        return Model{..model, message: "nothing to add" }
    }
    return Model{
        ..model,
        tasks: concat(model.tasks, [Task{ title: title, done: false }]),
        draft: "",
        message: "added \(title)",
    }
}

fn toggled(model: Model, at: int) -> Model {
    var out: [Task] = []
    for i in 0..model.tasks.len() {
        let task = model.tasks[i]
        if i == at {
            out.push(Task{..task, done: !task.done })
        } else {
            out.push(task)
        }
    }
    return Model{..model, tasks: out, message: "toggled" }
}

// A `main` so the example runs on the bytecode target too, where there is no
// page to click on: it drives the same `update` the page does, which is what
// keeps this testable without a browser.
fn main() {
    var model = init()
    model = update(model, EVENT_KEY(), 0.0, 0.0, "b")
    model = update(model, EVENT_KEY(), 0.0, 0.0, "u")
    model = update(model, EVENT_KEY(), 0.0, 0.0, "y")
    model = update(model, EVENT_KEY(), 0.0, 0.0, " ")
    model = update(model, EVENT_KEY(), 0.0, 0.0, "milk")
    model = update(model, EVENT_KEY(), 0.0, 0.0, "Enter")
    io.print("draft is now \"\(model.draft)\", \(model.tasks.len()) tasks")
    io.print(model.message)

    model = update(model, EVENT_KEY(), 0.0, 0.0, "Tab")
    io.print("focus: \(model.focused)")
    model = update(model, EVENT_KEY(), 0.0, 0.0, "Tab")
    io.print("focus: \(model.focused)")
    model = update(model, EVENT_KEY(), 0.0, 0.0, " ")
    io.print("first task done: \(model.tasks[0].done)")

    view(model)
}
