// A music library: Material Design 3, as an application rather than a swatch.
//
//     kitec build examples/player.kite --emit wasm --out dist
//     open dist/index.html
//
// Where `boids.kite` exists to be fast, this exists to be an *interface* — a
// navigation rail, a top app bar, filter chips, a two-line list, a now-playing
// bar with transport controls and a progress track, and a theme that changes
// under the whole thing.
//
// Three things are worth watching for.
//
// **Nothing here knows what Material is.** Every component comes from the
// `material` package, which is an ordinary Kite package with a `kite.toml`.
// `std/ui` — the layout engine underneath — has no button in it, no theme, and
// no opinion about shape: a design system is the application's to choose, and
// an iOS or Fluent package would be a different answer against the same core.
//
// **It is driveable by keyboard alone.** Tab and Shift+Tab move focus, the
// arrows move through the queue, space plays and pauses, and typing goes to
// whichever field has focus. None of that is a special case: focus order is
// *derived from the tree* — the controls in the order they were laid out — so
// a control that exists can be tabbed to, and one that was filtered away
// cannot.
//
// **The track names are not all in Latin script.** Arabic and Hebrew run right
// to left, and are reordered by UAX #9 and joined into contextual forms before
// anything is painted. This file never mentions `std/text`: the reordering
// happens inside the *layout*, which is why the DOM and canvas renderers agree
// about it — switch between them and nothing moves.
//
// Burmese is here for a different reason, and it is the hardest line in the
// list. It reads left to right, so UAX #9 has nothing to do — and it still has
// no useful relationship between the number of characters and the number of
// things on the screen. `ဆယ်လ်` carries two asat marks that kill the vowel of
// the consonant before them; `မွန်` hangs a medial under its consonant; and in
// `အပြန်` the medial ra is written *after* its consonant and drawn wrapped
// around the front of it. A layout that measured by counting characters would
// get every Latin line right and this one wrong, which is exactly why it is
// here.

use std/math
use std/ui
use material

// ---- the sound ------------------------------------------------------------------
//
// The tracks are real music, and there is not an audio file among them.
//
// Every melody here is a **public-domain composition** — old enough that the
// work itself is free — written out as notes and handed to the host one at a
// time. No recording is involved, so there is no recording copyright either:
// what plays is synthesised on the spot, from the notes below, by whatever
// oscillator the host has.
//
// That is the only honest way to put music in a demonstration. Shipping a
// commercial track would need a licence nobody has, and transcribing one is the
// same infringement with extra steps.
//
// The boundary carries numbers and nothing else — a frequency, when to start,
// how long to hold, how loud — because `str`, `int` and `float` are what cross
// it, and a buffer of samples is not among them. That turns out to be the right
// division anyway: WebAudio schedules on the audio thread, sample accurate, so
// a frame that arrives late cannot make the music stutter.

@host("audio")
extern fn note(frequency: float, delay: float, seconds: float, gain: float)

@host("audio")
extern fn silence()

@host("audio")
extern fn awake() -> bool

// ---- recorded audio ----------------------------------------------------------
//
// A track is either a melody this file writes out, or a recording it names.
// The two are not the same mechanism and are not pretended to be: an
// oscillator is fed notes, and a file is played by the host, which decodes it.
// Kite never sees a sample — a buffer of them is not something `str`, `int` and
// `float` can carry, and decoding audio to hand it back would be the wrong
// place to do the work anyway.
//
// The difference that matters to the rest of this file is *whose clock it is*.
// A synthesised track counts frames; a recorded one is timed by the element
// playing it, and `at()` is how the program reads that clock instead of
// guessing at it. Counting frames alongside a file would drift within seconds.

@host("audio")
extern fn load(url: str)

@host("audio")
extern fn start()

@host("audio")
extern fn pause()

@host("audio")
extern fn seek(seconds: float)

@host("audio")
extern fn at() -> float

@host("audio")
extern fn length() -> float

/// How far ahead notes are scheduled, in seconds. Scheduling ahead is what
/// makes the playback independent of the frame rate.
fn HORIZON() -> float {
    return 4.0
}

/// One step is an eighth note at 120 beats a minute, and every duration below
/// is counted in them: 1 is an eighth, 2 a quarter, 4 a half.
fn STEP() -> float {
    return 0.25
}

/// How many times a melody repeats before the track is over. These are the
/// opening phrases rather than whole works, so once through is a few seconds.
fn REPEATS() -> int {
    return 6
}

/// A note: a MIDI number, and how many steps it lasts. `-1` is a rest.
struct Beat {
    midi: int
    steps: int
}

fn beat(midi: int, steps: int) -> Beat {
    return Beat{ midi: midi, steps: steps }
}

/// Equal temperament from A2 at 110Hz, which is MIDI 45. Each semitone is the
/// twelfth root of two, and this is that, iterated — no `pow` needed for a
/// whole-number count.
fn pitch(midi: int) -> float {
    var hz = 110.0
    for _up in 0..midi - 45 {
        hz = hz * 1.0594630943592953
    }
    return hz
}

/// The opening of each piece, as written.
///
/// Every one of these is public domain: Beethoven died in 1827, Pachelbel in
/// 1706, Petzold in 1733, and a traditional melody has no author to outlive.
fn melody(track: int) -> [Beat] {
    // Index 0 is the recording, which has no notes of its own.
    if track == 0 {
        return []
    }
    if track == 1 {
        // Beethoven, Bagatelle in A minor — "Für Elise", 1810.
        return [
            beat(76, 1), beat(75, 1), beat(76, 1), beat(75, 1),
            beat(76, 1), beat(71, 1), beat(74, 1), beat(72, 1),
            beat(69, 2), beat(-1, 1), beat(60, 1), beat(64, 1), beat(69, 1),
            beat(71, 2), beat(-1, 1), beat(64, 1), beat(68, 1), beat(71, 1),
            beat(72, 2), beat(-1, 1), beat(64, 1),
        ]
    }
    if track == 2 {
        // Beethoven, Symphony No. 9 — the "Ode to Joy" theme, 1824.
        return [
            beat(64, 2), beat(64, 2), beat(65, 2), beat(67, 2),
            beat(67, 2), beat(65, 2), beat(64, 2), beat(62, 2),
            beat(60, 2), beat(60, 2), beat(62, 2), beat(64, 2),
            beat(64, 3), beat(62, 1), beat(62, 4),
        ]
    }
    if track == 3 {
        // Christian Petzold, Minuet in G — long credited to Bach, whose
        // notebook it sits in.
        return [
            beat(74, 2), beat(67, 1), beat(69, 1), beat(71, 1), beat(72, 1),
            beat(74, 2), beat(67, 2), beat(67, 2),
            beat(76, 2), beat(72, 1), beat(74, 1), beat(76, 1), beat(77, 1),
            beat(79, 2), beat(67, 2), beat(67, 2),
        ]
    }
    if track == 4 {
        // "Greensleeves", English traditional, printed in 1580.
        return [
            beat(69, 1), beat(72, 2), beat(74, 1), beat(76, 2), beat(77, 1),
            beat(76, 2), beat(74, 1), beat(71, 2), beat(67, 1),
            beat(69, 2), beat(71, 1), beat(72, 2), beat(69, 1),
            beat(69, 2), beat(68, 1), beat(69, 2), beat(71, 1),
            beat(68, 2), beat(64, 3),
        ]
    }
    if track == 5 {
        // さくらさくら, Japanese traditional, Edo period. The in-sen scale it
        // uses — A B C E F — is why it sounds as it does.
        return [
            beat(69, 2), beat(69, 2), beat(71, 4),
            beat(69, 2), beat(69, 2), beat(71, 4),
            beat(69, 2), beat(71, 2), beat(72, 2), beat(71, 2),
            beat(69, 2), beat(71, 2), beat(69, 2), beat(65, 2),
            beat(64, 4),
        ]
    }
    if track == 6 {
        // Pachelbel, Canon in D — the ground bass, which is the part everyone
        // actually knows.
        return [
            beat(62, 4), beat(57, 4), beat(59, 4), beat(54, 4),
            beat(55, 4), beat(50, 4), beat(55, 4), beat(57, 4),
        ]
    }
    // "Ah! vous dirai-je, maman", French traditional — the tune Mozart wrote
    // variations on, and the one everyone learns first.
    return [
        beat(60, 2), beat(60, 2), beat(67, 2), beat(67, 2),
        beat(69, 2), beat(69, 2), beat(67, 4),
        beat(65, 2), beat(65, 2), beat(64, 2), beat(64, 2),
        beat(62, 2), beat(62, 2), beat(60, 4),
    ]
}

/// The melody with one entry per step: the note on the step it starts, and a
/// `-1` for each step it is still sounding through. Indexing by step is what
/// lets the scheduler ask "what begins at this moment" without searching.
fn line(track: int) -> [Beat] {
    var out: [Beat] = []
    for b in melody(track) {
        out.push(b)
        for _hold in 1..b.steps {
            out.push(beat(-1, 0))
        }
    }
    return out
}

/// How long a track runs, in seconds — its melody, repeated. Computed rather
/// than written down, so the progress bar reaches the end exactly when the
/// music does.
fn composed_duration(track: int) -> int {
    var steps = 0
    for b in melody(track) {
        steps = steps + b.steps
    }
    return math.round_to((steps * REPEATS()) as float * STEP())
}

/// Send every note that begins inside the window `from`..`to`, measured in
/// seconds from the start of the track.
fn schedule(model: Model, from: float, to: float) {
    let notes = line(model.playing)
    if notes.len() == 0 {
        return
    }
    let first = math.trunc_to(from / STEP())
    let last = math.trunc_to(to / STEP())
    for step in first..last + 1 {
        let at = (step as float) * STEP()
        if at >= from {
            if at < to {
                let b = notes[step % notes.len()]
                if b.midi >= 0 {
                    // A note is held a little short of its written length, so
                    // two of the same pitch in a row are heard as two.
                    let held = (b.steps as float) * STEP() * 0.9
                    let gain = if step % 4 == 0 { 0.20 } else { 0.13 }
                    note(pitch(b.midi), at - from, held, gain)
                }
            }
        }
    }
}

// ---- the model ---------------------------------------------------------------

/// A track has no length of its own. How long it runs is `duration()`, worked
/// out from the notes, so the progress bar reaches the end exactly when the
/// music does rather than at a number somebody typed.
struct Track {
    title: str
    artist: str
    genre: str
    /// A recording to play, or empty for a track this file composes.
    source: str
    /// How long the recording runs. The host knows once its metadata has
    /// loaded and answers zero until then, so this is what the list shows in
    /// the meantime — a duration that appeared a second late would look like a
    /// bug rather than like loading.
    seconds: int
}

/// What this application can be told.
///
/// Every control in the tree carries one of these, built by the code that knew
/// which control it was making. `ChooseGenre` and `PlayTrack` carry payloads
/// for the same reason: the loop that built the row had the name and the index
/// in hand, so nothing later has to recover them from a string.
///
/// The seek bar is deliberately absent. What dragging it says is a *number*,
/// which is not known when the node is built — see `slider_of` in the material
/// package for why that is a different proposal.
pub enum Msg {
    /// The rail's Library destination. There is one page, so arriving at it
    /// changes nothing — but a navigation control that says *nothing* would be
    /// a control the exhaustive match cannot account for, and "already here"
    /// is a real answer rather than a missing one.
    ShowLibrary
    PlayPause
    Next
    Prev
    Shuffle
    ToggleTheme
    ChooseGenre(str)
    PlayTrack(int)
}

pub struct Model {
    tracks: [Track]
    /// What the host says the window is. A layout is a function of its size, so
    /// this is model state like everything else — there is nowhere else to put
    /// it, Kite having no mutable globals.
    width: float
    height: float
    /// Which track the now-playing bar is showing, as an index into `tracks`
    /// rather than a reference: the filtered list is rebuilt on every keystroke
    /// and a reference would be to the old one.
    playing: int
    /// How far into it, in seconds. Advanced by the frame event, which is the
    /// only clock a program on this runtime has that measures real time.
    elapsed: float
    running: bool
    genre: str
    search: str
    focused: str
    dark: bool
    /// How far into the track notes have been sent, in seconds. Everything up
    /// to here is already with the host and will play whether or not another
    /// frame ever arrives.
    sent: float
    /// How far the library is scrolled, in pixels. Kite's layout grows a box
    /// into spare space and never shrinks one below its content, so a list
    /// longer than its window overflows rather than compressing — which is the
    /// simpler rule, and the reason a list this long needs somewhere to put the
    /// part that does not fit.
    offset: float
    /// Hover, press, focus and the ripple, for every control on the screen.
    ///
    /// It is in the model because there is nowhere else it could be: a state
    /// layer arriving over two hundred milliseconds is a fact that outlives a
    /// frame, and Kite has no mutable globals for a component to keep one in.
    /// So the design system hands it back as a value, `update` threads it
    /// through, and `view` reads it — the same shape as `elapsed` and `offset`
    /// above rather than an exception to them.
    ui_state: material.Interaction
}

fn WIDTH() -> float {
    return 1100.0
}

fn HEIGHT() -> float {
    return 700.0
}

fn composed(title: str, artist: str, genre: str) -> Track {
    return Track{ title: title, artist: artist, genre: genre, source: "", seconds: 0 }
}

fn library() -> [Track] {
    return [
        Track {
            title: "ဆယ်လ်မွန်ငါးတို့အပြန်",
            artist: "ခင်မောင်တိုး",
            genre: "Burmese",
            source: "khin-maung-toe.m4a",
            seconds: 271,
        },
        composed("Für Elise", "Ludwig van Beethoven", "Classical"),
        composed("Ode to Joy", "Ludwig van Beethoven", "Classical"),
        composed("Minuet in G", "Christian Petzold", "Baroque"),
        composed("Greensleeves", "Traditional", "Folk"),
        composed("さくらさくら", "日本古謡", "Folk"),
        composed("Canon in D", "Johann Pachelbel", "Baroque"),
        composed("Ah! vous dirai-je, maman", "Traditional", "Folk"),
    ]
}

/// Whether a track is played from a file rather than composed.
fn recorded(model: Model, track: int) -> bool {
    return model.tracks[track].source.len() > 0
}

/// How long a track runs, in seconds.
///
/// A composed one adds up its own notes, so the progress bar reaches the end
/// exactly when the music does. A recording is however long the file is, which
/// only the host knows — and only once its metadata has loaded, so the written
/// figure stands in until then.
fn duration(model: Model, track: int) -> int {
    if recorded(model, track) {
        return model.tracks[track].seconds
    }
    return composed_duration(track)
}

pub fn init() -> Model {
    return Model{
        tracks: library(),
        width: WIDTH(),
        height: HEIGHT(),
        playing: 0,
        elapsed: 0.0,
        running: false,
        genre: "All",
        search: "",
        focused: "search",
        dark: true,
        sent: 0.0,
        offset: 0.0,
        ui_state: material.no_interaction(),
    }
}

fn scheme(model: Model) -> material.Scheme {
    return material.scheme_of(model.dark)
}

fn viewport(model: Model) -> ui.Size {
    return ui.Size{ width: model.width, height: model.height }
}

// ---- what the filters leave -----------------------------------------------------

fn genres() -> [str] {
    return ["All", "Burmese", "Classical", "Baroque", "Folk"]
}

fn shown(model: Model) -> [int] {
    var out: [int] = []
    for i in 0..model.tracks.len() {
        let track = model.tracks[i]
        var keep = true
        if model.genre != "All" {
            if track.genre != model.genre {
                keep = false
            }
        }
        if model.search.len() > 0 {
            if !contains(lower(track.title), lower(model.search)) {
                if !contains(lower(track.artist), lower(model.search)) {
                    keep = false
                }
            }
        }
        if keep {
            out.push(i)
        }
    }
    return out
}

fn lower(s: str) -> str {
    var out = ""
    for i in 0..s.len() {
        let c = s.code_at(i)
        if c >= 65 && c <= 90 {
            out = out + char_of(c + 32)
        } else {
            out = out + s.slice(i, i + 1)
        }
    }
    return out
}

fn char_of(code: int) -> str {
    let letters = "abcdefghijklmnopqrstuvwxyz"
    let at = code - 97
    if at < 0 || at >= 26 {
        return ""
    }
    return letters.slice(at, at + 1)
}

fn contains(haystack: str, needle: str) -> bool {
    return haystack.index_of(needle) >= 0
}

/// `m:ss`, which needs a leading zero on the seconds and nothing else.
fn clock(total: int) -> str {
    let minutes = total / 60
    let seconds = total % 60
    if seconds < 10 {
        return "\(minutes):0\(seconds)"
    }
    return "\(minutes):\(seconds)"
}

// ---- the tree --------------------------------------------------------------------

fn view_node(model: Model) -> ui.Node<Msg> {
    let s = scheme(model)
    // Below Material's medium breakpoint a navigation rail costs 80dp of a
    // width that has none to spare, so navigation moves to the bottom. That is
    // Material's own rule, which is why the breakpoints live in the package and
    // not here — and it is a different tree, not a smaller copy of one.
    if !material.has_rail(model.width) {
        return ui.decorated(
            ui.box_of(
                "app",
                ui.Style {..ui.column(), align: ui.Align.Stretch },
                [main_column(model, s), nav_bar(model, s)],
            ),
            ui.filled(s.surface),
        )
    }
    return ui.decorated(
        ui.box_of(
            "app",
            ui.Style {..ui.row(), align: ui.Align.Stretch },
            [rail(model, s), main_column(model, s)],
        ),
        ui.filled(s.surface),
    )
}

/// The destinations, built once and placed by whichever navigation the window
/// is wide enough for. One list, two arrangements — so a destination added here
/// appears in both, and the focus order picks it up either way.
///
/// There was a third, `Queue`, and it went nowhere: `acted` had no branch for
/// it, so it was permanently unselected and clicking it returned the model
/// unchanged. It was scenery — a navigation bar wants three destinations to
/// look like one, and it was there to make up the number. That was harmless
/// while nothing in the rail reacted to anything; it stopped being harmless
/// once these grew hover, focus and a ripple, because a control that answers
/// every affordance except the one it exists for is worse than no control.
fn destinations(model: Model) -> [ui.Node<Msg>] {
    let s = scheme(model)
    return [
        material.rail_item(s, "nav-library", Msg.ShowLibrary, "♫", "Library", true, choice(model, "nav-library", true)),
        material.rail_item(
            s,
            "nav-theme",
            Msg.ToggleTheme,
            theme_glyph(model),
            "Theme",
            false,
            choice(model, "nav-theme", false),
        ),
    ]
}

/// The compact answer to a rail: the same destinations laid across the bottom,
/// sharing the width between them.
fn nav_bar(model: Model, s: material.Scheme) -> ui.Node<Msg> {
    var slots: [ui.Node<Msg>] = []
    var at = 0
    for one in destinations(model) {
        slots.push(
            ui.box_of(
                "nav-slot\(at)",
                ui.grown(ui.Style{..ui.column(), align: ui.Align.Center }, 1.0),
                [one],
            ),
        )
        at = at + 1
    }
    let style = ui.padded(
        ui.sized(
            ui.Style {..ui.row(), align: ui.Align.Center },
            0.0,
            material.NAV_BAR_HEIGHT(),
        ),
        material.space(2),
    )
    return ui.decorated(
        ui.box_of("navbar", style, slots),
        ui.filled(material.surface_at(s, material.LEVEL_2())),
    )
}

fn rail(model: Model, s: material.Scheme) -> ui.Node<Msg> {
    let items = destinations(model)
    let style = ui.spaced(
        ui.padded(
            ui.sized(ui.Style{..ui.column(), align: ui.Align.Center }, material.RAIL_WIDTH(), 0.0),
            material.space(3),
        ),
        material.space(3),
    )
    return ui.decorated(
        ui.box_of("rail", style, items),
        ui.filled(material.surface_at(s, material.LEVEL_1())),
    )
}

fn theme_glyph(model: Model) -> str {
    if model.dark {
        return "☀"
    }
    return "☾"
}

/// What a control is doing: hovered, focused, pressed — and how far into each.
///
/// It used to be `when_focused(model.focused == id)`, which is a boolean and
/// draws a control in one of two states. Everything the pointer knows lives in
/// `ui_state` now, so this is a lookup rather than a comparison, and what comes
/// back carries the fractions the state layers are actually at.
/// Focus moved, in both the places that have to know.
///
/// The model keeps `focused` because that is what routes a keystroke; the
/// interaction keeps its own because that is what animates the focus ring. Two
/// records of one fact is two things to keep in step, so nothing else in this
/// file assigns either of them.
fn focused_on(model: Model, id: str) -> Model {
    return Model{..model, focused: id, ui_state: material.focus_to(model.ui_state, id) }
}

fn focus(model: Model, id: str) -> material.State {
    return material.state_of(model.ui_state, id)
}

/// The same for a control that is also selected — a filter chip, a rail
/// destination, a row in the queue.
fn choice(model: Model, id: str, on: bool) -> material.State {
    return material.state_marked(model.ui_state, id, on)
}

/// How wide the column beside the navigation is.
fn content_width(model: Model) -> float {
    if material.has_rail(model.width) {
        return model.width - material.RAIL_WIDTH()
    }
    return model.width
}

/// The search field takes what the app bar has left after the title and the
/// action beside it, between a width too narrow to type in and one wider than
/// a search box has any use for.
fn search_width(model: Model) -> float {
    let title = ui.text_size_in("Library", 22.0, material.REGULAR()).width
    let spare = content_width(model) - title - 40.0 - material.space(4) * 2.0 - material.space(2) * 2.0
    if spare < 120.0 {
        return 120.0
    }
    if spare > 320.0 {
        return 320.0
    }
    return spare
}

fn main_column(model: Model, s: material.Scheme) -> ui.Node<Msg> {
    let style = ui.Style{..ui.column(), align: ui.Align.Stretch, grow: 1.0 }
    // A compact window cannot hold a title, a search field and an action on one
    // row, so the field takes the row under the bar. Which is what Material
    // does with a search bar on a phone, and it is a layout decision rather
    // than a smaller version of the same layout.
    if material.window_class(model.width) == material.WINDOW_COMPACT() {
        return ui.box_of(
            "main",
            style,
            [
                material.top_app_bar(
                    "bar",
                    s,
                    "Library",
                    [material.icon_button(s, "shuffle", Msg.Shuffle, "⇄", focus(model, "shuffle"))],
                ),
                ui.box_of(
                    "search-row",
                    ui.padded(ui.Style{..ui.row(), align: ui.Align.Stretch }, material.space(4)),
                    [
                        material.search_field(
                            s,
                            "search",
                            model.search,
                            "Search tracks",
                            content_width(model) - material.space(8),
                            focus(model, "search"),
                        ),
                    ],
                ),
                chips(model, s),
                list_viewport(model, s),
                now_playing(model, s),
            ],
        )
    }
    return ui.box_of(
        "main",
        style,
        [
            material.top_app_bar(
                "bar",
                s,
                "Library",
                [
                    material.search_field(
                        s,
                        "search",
                        model.search,
                        "Search tracks",
                        search_width(model),
                        focus(model, "search"),
                    ),
                    material.icon_button(s, "shuffle", Msg.Shuffle, "⇄", focus(model, "shuffle")),
                ],
            ),
            chips(model, s),
            list_viewport(model, s),
            now_playing(model, s),
        ],
    )
}

/// A row of filter chips, one per genre. Exactly Material's use for them: a
/// set of choices that narrows what is below.
fn chips(model: Model, s: material.Scheme) -> ui.Node<Msg> {
    // Packed into as many rows as it takes, measured.
    //
    // Material scrolls a chip row sideways when it does not fit. This layout
    // has no horizontal scrolling and no wrapping of its own, so the packing
    // happens here — which an application *can* do, because it can measure. A
    // row that simply overflowed would push its last chips off the window,
    // which is what five genres did at 360dp.
    let room = content_width(model) - material.space(8)
    var rows: [ui.Node<Msg>] = []
    var line: [ui.Node<Msg>] = []
    var used = 0.0
    var at = 0
    for name in genres() {
        let width = chip_width(name)
        if line.len() > 0 && used + material.space(2) + width > room {
            rows.push(chip_row(at, line))
            at = at + 1
            line = []
            used = 0.0
        }
        if line.len() > 0 {
            used = used + material.space(2)
        }
        used = used + width
        line.push(
            material.filter_chip(
                s,
                "genre-\(name)",
                Msg.ChooseGenre(name),
                name,
                model.genre == name,
                choice(model, "genre-\(name)", model.genre == name),
            ),
        )
    }
    if line.len() > 0 {
        rows.push(chip_row(at, line))
    }
    let style = ui.spaced(
        ui.padded(ui.Style{..ui.column(), align: ui.Align.Start }, material.space(4)),
        material.space(2),
    )
    return ui.box_of("chips", style, rows)
}

/// A chip's width, measured as the *selected* form — the tick is the widest it
/// gets, so choosing a genre never reflows the rows underneath it.
fn chip_width(name: str) -> float {
    return ui.text_size_in("✓ \(name)", 14.0, material.MEDIUM()).width + material.space(4) * 2.0
}

fn chip_row(at: int, line: [ui.Node<Msg>]) -> ui.Node<Msg> {
    return ui.box_of(
        "chip-row\(at)",
        ui.spaced(ui.Style{..ui.row(), align: ui.Align.Center }, material.space(2)),
        line,
    )
}

/// Where the list goes: an empty card that the rows are painted *into*.
///
/// Two trees rather than one. The chrome is laid out against the window, and
/// the rows are laid out separately against the width this box turns out to
/// have — which is the only way to scroll one part of a screen while the rest
/// stays put, since a layout has no notion of a thing being partly off its own
/// parent.
fn list_viewport(model: Model, s: material.Scheme) -> ui.Node<Msg> {
    let card: ui.Node<Msg> = ui.decorated(
        ui.box_of("list", ui.Style{..ui.column(), align: ui.Align.Stretch, grow: 1.0 }, []),
        ui.rounded(material.surface_at(s, material.LEVEL_1()), material.SHAPE_LARGE()),
    )
    let holder = ui.padded(
        ui.Style {..ui.column(), align: ui.Align.Stretch, grow: 1.0 },
        material.space(4),
    )
    return ui.box_of("list-holder", holder, [card])
}

/// The rows themselves, laid out on their own against a given width.
fn list(model: Model, s: material.Scheme) -> ui.Node<Msg> {
    let found = shown(model)
    let room = row_room(model)
    var rows: [ui.Node<Msg>] = []
    if found.len() == 0 {
        rows.push(
            ui.decorated(
                ui.text_of(
                    "empty",
                    ui.padded(ui.in_font(ui.style(), 16.0, material.REGULAR()), material.space(4)),
                    "Nothing matches",
                ),
                ui.ink(s.on_surface_variant),
            ),
        )
    }
    for i in found {
        let track = model.tracks[i]
        let is_playing = i == model.playing
        var glyph = "▷"
        if is_playing {
            if model.running {
                glyph = "❚❚"
            }
        }
        let leading: [ui.Node<Msg>] = [
            ui.decorated(
                ui.text_of(
                    "track-\(i)-glyph",
                    ui.sized(ui.in_font(ui.style(), 14.0, material.REGULAR()), 32.0, 32.0),
                    glyph,
                ),
                ui.centered(ui.ink(mark_ink(s, is_playing))),
            ),
        ]
        rows.push(
            material.list_item_two(
                s,
                "track-\(i)",
                Msg.PlayTrack(i),
                fit(track.title, room, 16.0, material.REGULAR()),
                fit(
                    "\(track.artist) · \(track.genre) · \(clock(duration(model, i)))",
                    room,
                    14.0,
                    material.REGULAR(),
                ),
                leading,
                choice(model, "track-\(i)", is_playing),
            ),
        )
    }
    let inner = ui.spaced(
        ui.padded(ui.Style{..ui.column(), align: ui.Align.Stretch, grow: 1.0 }, material.space(2)),
        material.space(1),
    )
    let card: ui.Node<Msg> = ui.decorated(
        ui.box_of("list", inner, rows),
        ui.rounded(material.surface_at(s, material.LEVEL_1()), material.SHAPE_LARGE()),
    )
    let holder = ui.padded(
        ui.Style {..ui.column(), align: ui.Align.Stretch, grow: 1.0 },
        material.space(4),
    )
    return ui.box_of("list-holder", holder, [card])
}

/// The first line a run of text wraps to at `limit`, with an ellipsis when
/// there was more.
///
/// Kite's layout grows a box into spare space and never shrinks one below its
/// content, so a line too long for its column does not compress — it runs out
/// of the card and off the window. Fitting the text is the caller's job, and
/// this does it with the same wrapper the layout measures with, in the same
/// font the line will be drawn in.
fn fit(body: str, limit: float, size: float, weight: int) -> str {
    let lines = ui.wrap_in(body, limit, size, weight)
    if lines.len() < 2 {
        return body
    }
    return "\(lines[0])…"
}

/// What a row has left for text: the card, less its padding, the leading glyph
/// and the gaps either side of it.
fn row_room(model: Model) -> float {
    let room = content_width(model) - material.space(8) - material.space(6) - 32.0 - material.space(6)
    if room < 80.0 {
        return 80.0
    }
    return room
}

fn mark_ink(s: material.Scheme, is_playing: bool) -> int {
    if is_playing {
        return s.on_secondary_container
    }
    return s.on_surface_variant
}

/// The now-playing bar: what Material calls a bottom app bar, carrying the
/// transport and a progress track.
fn now_playing(model: Model, s: material.Scheme) -> ui.Node<Msg> {
    let track = model.tracks[model.playing]
    let width = content_width(model) - material.space(8)
    let fraction = model.elapsed / (duration(model, model.playing) as float)
    // What is left for the title and the line under it once the transport has
    // taken its 144dp. `grow` hands a box the spare space and never takes any
    // back, so a title longer than this would push the buttons off the window
    // rather than being cut.
    let told = room_for_titles(width)

    let titles: ui.Node<Msg> = ui.box_of(
        "np-text",
        ui.spaced(ui.grown(ui.Style{..ui.column(), align: ui.Align.Stretch }, 1.0), 2.0),
        [
            ui.decorated(
                ui.text_of(
                    "np-title",
                    ui.in_font(ui.style(), 16.0, material.MEDIUM()),
                    fit(track.title, told, 16.0, material.MEDIUM()),
                ),
                ui.ink(s.on_surface),
            ),
            ui.decorated(
                ui.text_of(
                    "np-artist",
                    ui.in_font(ui.style(), 14.0, material.REGULAR()),
                    fit(
                        "\(track.artist) · \(clock(math.trunc_to(model.elapsed))) of \(clock(duration(model, model.playing)))",
                        told,
                        14.0,
                        material.REGULAR(),
                    ),
                ),
                ui.ink(s.on_surface_variant),
            ),
        ],
    )

    let transport: ui.Node<Msg> = ui.box_of(
        "np-transport",
        ui.spaced(ui.Style{..ui.row(), align: ui.Align.Center }, material.space(1)),
        [
            material.icon_button(s, "prev", Msg.Prev, "◁◁", focus(model, "prev")),
            material.fab(s, "play", Msg.PlayPause, play_glyph(model), focus(model, "play")),
            material.icon_button(s, "next", Msg.Next, "▷▷", focus(model, "next")),
        ],
    )

    let row: ui.Node<Msg> = ui.box_of(
        "np-row",
        ui.spaced(ui.Style{..ui.row(), align: ui.Align.Center }, material.space(4)),
        [titles, transport],
    )

    let inner = ui.spaced(
        ui.padded(ui.Style{..ui.column(), align: ui.Align.Stretch }, material.space(4)),
        material.space(3),
    )
    let bar: ui.Node<Msg> = ui.decorated(
        ui.box_of(
            "np",
            inner,
            [
                row,
                material.slider(
                    s,
                    "seek",
                    fraction,
                    width - material.space(8),
                    focus(model, "seek"),
                ),
            ],
        ),
        ui.rounded(material.surface_at(s, material.LEVEL_2()), material.SHAPE_LARGE()),
    )
    let holder = ui.padded(ui.Style{..ui.column(), align: ui.Align.Stretch }, material.space(4))
    return ui.box_of("np-holder", holder, [bar])
}

/// The width the now-playing text may take: the bar, less the transport and
/// the gap before it.
fn room_for_titles(width: float) -> float {
    let told = width - 144.0 - material.space(4)
    if told < 80.0 {
        return 80.0
    }
    return told
}

fn play_glyph(model: Model) -> str {
    if model.running {
        return "❚❚"
    }
    return "▶"
}

fn frames_of(model: Model) -> [ui.Frame] {
    return ui.layout(view_node(model), viewport(model))
}

/// Every frame the pointer at `(x, y)` can land on, in window coordinates.
///
/// The library rows are laid out in a tree of their own and drawn scrolled, so
/// their rectangles are in the viewport's space rather than the window's.
/// Shifting them into the window's is what lets one hit-test answer for the
/// whole screen — `material.moved` and its siblings take a flat list and know
/// nothing about viewports, which is the right division: a design system should
/// not have to be told how an application scrolls.
///
/// The rows are only offered when the point is inside the card. They are not
/// merely filtered by whether each row is visible, because the tree's *root* is
/// as tall as all of its content — six hundred pixels of it, in a card three
/// hundred and sixty tall — so it contains points far below the card and would
/// answer for the now-playing bar underneath. That is precisely the bug this
/// shape avoids, and it is why `clicked` has always tested the card first.
fn hit_frames(model: Model, x: float, y: float) -> [ui.Frame] {
    let frames = frames_of(model)
    let box = list_rect(frames)
    if !ui.rect_contains(box, x, y) {
        return frames
    }
    let rows = row_frames(model, box)
    let offset = ui.clamp_scroll(model.offset, rows, row_viewport(box))
    var out = frames
    for row in rows {
        // Shifted, not clipped. The offset the painter applies is the exact
        // inverse of this, so a ripple started on a row lands where the finger
        // did — `pressed_down` records its origin against the shifted rectangle
        // and `paint_scrolled` puts it back against the unshifted one.
        out.push(
            ui.Frame {
                ..row,
                rect: ui.Rect{
                    x: row.rect.x + box.x,
                    y: row.rect.y + box.y - offset,
                    width: row.rect.width,
                    height: row.rect.height,
                },
            },
        )
    }
    return out
}

/// The card the rows are painted into, as a rectangle in window coordinates.
fn list_rect(frames: [ui.Frame]) -> ui.Rect {
    for frame in frames {
        if frame.name == "list" {
            return frame.rect
        }
    }
    return ui.Rect{ x: 0.0, y: 0.0, width: 0.0, height: 0.0 }
}

/// The rows, as a tree. Separate from the chrome because they are laid out
/// against the card rather than the window, and separate from [`row_frames`]
/// because a meaning is read from the tree while a position is read from the
/// frames.
fn row_tree(model: Model, box: ui.Rect) -> ui.Node<Msg> {
    return list(model, scheme(model))
}

/// The rows, laid out against the card they will be drawn into.
fn row_frames(model: Model, box: ui.Rect) -> [ui.Frame] {
    return ui.layout(row_tree(model, box), ui.Size{ width: box.width, height: box.height })
}

fn row_viewport(box: ui.Rect) -> ui.Size {
    return ui.Size{ width: box.width, height: box.height }
}

pub fn view(model: Model) {
    let s = scheme(model)
    let frames = frames_of(model)
    // `material.paint` is `ui.paint` with one extra pass: the ripples, which go
    // over the containers they belong to and cannot be children of them —
    // a layout of rows and columns has no z-order to put them in.
    material.paint(frames, model.ui_state)

    let box = list_rect(frames)
    let rows = row_frames(model, box)
    let offset = ui.clamp_scroll(model.offset, rows, row_viewport(box))
    // The card behind the rows is already painted, so the rows are told what
    // they are sitting on: a transparent thing among them — an unticked
    // checkbox, an outlined chip — needs the colour of *that*, not the window.
    // A ripple started on a row is clipped to the same viewport the row is.
    material.paint_scrolled(rows, model.ui_state, box, offset)
}

// ---- events -----------------------------------------------------------------------

fn EVENT_CLICK() -> int {
    return 0
}

fn EVENT_KEY() -> int {
    return 1
}

fn EVENT_RESIZE() -> int {
    return 6
}

fn EVENT_FRAME() -> int {
    return 7
}

fn EVENT_WHEEL() -> int {
    return 2
}

/// The three the pointer sends. A program that ignores them is a program whose
/// controls cannot hover or press — which is what this one was before, and the
/// reason nothing in it lit up until it was clicked.
fn EVENT_MOVE() -> int {
    return 3
}

fn EVENT_DOWN() -> int {
    return 4
}

fn EVENT_UP() -> int {
    return 5
}

/// A real `<input>` reported its value. Under `DomRenderer` a field *is* an
/// element, so what comes back is the whole value rather than a keystroke —
/// a paste, an IME commit and an autofill are all edits and none is a key.
fn EVENT_EDIT() -> int {
    return 8
}

pub fn update(model: Model, event: int, x: float, y: float, key: str) -> Model {
    if event == EVENT_CLICK() {
        return clicked(model, x, y)
    }
    if event == EVENT_KEY() {
        return pressed(model, key)
    }
    // The event carries no id because it needs none: one control holds focus,
    // and this file is what decided which.
    if event == EVENT_EDIT() {
        if model.focused == "search" {
            return Model{..model, search: key }
        }
        return model
    }
    if event == EVENT_MOVE() {
        return Model{..model, ui_state: material.moved(model.ui_state, hit_frames(model, x, y), x, y) }
    }
    if event == EVENT_DOWN() {
        return Model{
            ..model,
            ui_state: material.pressed_down(model.ui_state, hit_frames(model, x, y), x, y),
        }
    }
    if event == EVENT_UP() {
        return Model{..model, ui_state: material.lifted(model.ui_state) }
    }
    if event == EVENT_RESIZE() {
        // A floor, not a design size. It used to be 900x560 — wider than the
        // slot this is embedded in on the front page — so the layout was built
        // for a window it did not have and simply overflowed. The floor now
        // only stops the arithmetic going negative; everything above it adapts.
        let w = if x > 320.0 { x } else { 320.0 }
        let h = if y > 320.0 { y } else { 320.0 }
        return Model{..model, width: w, height: h }
    }
    if event == EVENT_FRAME() {
        return ticked(model, x)
    }
    if event == EVENT_WHEEL() {
        return scrolled(model, y)
    }
    return model
}

/// The frame event carries how long the last frame took, in milliseconds.
///
/// Returning the *same* model is how a program says there is nothing moving:
/// the host stops asking for frames until something else happens. So a paused
/// player costs nothing, which a loop that ran regardless would not.
fn ticked(model: Model, elapsed: float) -> Model {
    // The state layers first: a button's hover is arriving whether or not the
    // music is playing. The guard is what keeps the *same* model coming back
    // when neither is moving — `Model{..model, …}` is a new value even when
    // every field in it is unchanged, and a new value is the host's signal to
    // schedule another frame.
    var base = model
    if material.animating(model.ui_state) {
        base = Model{..model, ui_state: material.advance(model.ui_state, elapsed) }
    }
    if !base.running {
        return base
    }
    let model = base
    // A recording is timed by the host that is playing it. Counting frames
    // alongside it would drift within seconds, and the two clocks disagreeing
    // is how a progress bar ends up in a different place from the sound.
    if recorded(model, model.playing) {
        let position = at()
        if position >= (duration(model, model.playing) as float) - 0.25 {
            return started(advanced(Model{..model, elapsed: 0.0 }, 1))
        }
        return Model{..model, elapsed: position }
    }
    let next = model.elapsed + elapsed / 1000.0
    if next >= (duration(model, model.playing) as float) {
        return started(advanced(Model{..model, elapsed: 0.0 }, 1))
    }
    // Top the schedule up when it runs low, rather than every frame: notes
    // already sent are the host's, and sending them twice would play them
    // twice.
    if model.sent - next < HORIZON() / 2.0 {
        let to = next + HORIZON()
        schedule(model, model.sent, to)
        return Model{..model, elapsed: next, sent: to }
    }
    return Model{..model, elapsed: next }
}

/// Begin, or begin again: silence whatever is still ringing and fill the
/// schedule from where the track now is.
fn started(model: Model) -> Model {
    // Whichever way the *other* kind of track was making a sound, stop it: the
    // two mechanisms know nothing about each other, so switching between them
    // has to silence both.
    silence()
    pause()
    if recorded(model, model.playing) {
        load(model.tracks[model.playing].source)
        seek(model.elapsed)
        if model.running {
            start()
        }
        return Model{..model, sent: model.elapsed }
    }
    if !model.running {
        return Model{..model, sent: model.elapsed }
    }
    let to = model.elapsed + HORIZON()
    schedule(model, model.elapsed, to)
    return Model{..model, sent: to }
}

fn scrolled(model: Model, by: float) -> Model {
    let frames = frames_of(model)
    let box = list_rect(frames)
    let rows = row_frames(model, box)
    let next = ui.clamp_scroll(model.offset + by, rows, row_viewport(box))
    return Model{..model, offset: next }
}

fn clicked(model: Model, x: float, y: float) -> Model {
    let frames = frames_of(model)
    let box = list_rect(frames)

    // The rows are drawn scrolled, so a click inside the card is tested
    // against the scrolled tree rather than the chrome one. Outside it, the
    // chrome answers.
    if ui.rect_contains(box, x, y) {
        let rows = row_frames(model, box)
        let offset = ui.clamp_scroll(model.offset, rows, row_viewport(box))
        let found = ui.hit_scrolled(rows, box, offset, x, y)
        if found == nil {
            return model
        }
        let id = found.control
        if id == nil {
            return model
        }
        let said = meaning_of(row_tree(model, box), id)
        if said == nil {
            return model
        }
        return acted(focused_on(model, id), said)
    }

    let hit = ui.control_at(frames, x, y)
    if hit == nil {
        return model
    }
    let focused = focused_on(model, hit)
    // The seek bar is the one control whose answer depends on *where* in it the
    // click landed, so it needs the rectangle it was laid out into rather than
    // only its id.
    if hit == "seek" {
        let box = ui.frame_of(frames, "seek")
        if box != nil {
            return sought(focused, material.slider_value_at(box.rect, x))
        }
        return focused
    }
    let said = meaning_of(view_node(model), hit)
    if said == nil {
        return focused
    }
    return acted(focused, said)
}

/// What a control in a tree says, if it says anything and is able to.
///
/// Two trees answer here — the chrome and the scrolled rows — which is why
/// this takes the tree rather than reaching for one: the rows are laid out
/// separately, so a row's meaning is not in the chrome tree at all.
fn meaning_of(tree: ui.Node<Msg>, id: str) -> Option<Msg> {
    let found = ui.control_of(tree, id)
    if found == nil {
        return nil
    }
    if !found.enabled {
        return nil
    }
    return found.msg
}

/// Move the playhead to a fraction of the track.
///
/// The notes already sent are the host's and cannot be recalled, so `started`
/// silences them and fills the schedule again from where the track now is.
/// Without that, seeking would leave the previous four seconds still sounding
/// over the new position.
fn sought(model: Model, fraction: float) -> Model {
    let track = model.tracks[model.playing]
    return started(Model{..model, elapsed: fraction * (duration(model, model.playing) as float) })
}

/// Seek by a number of seconds, held inside the track.
fn nudged(model: Model, by: float) -> Model {
    let track = model.tracks[model.playing]
    var at = model.elapsed + by
    if at < 0.0 {
        at = 0.0
    }
    let last = duration(model, model.playing) as float
    if at > last {
        at = last
    }
    return started(Model{..model, elapsed: at })
}

/// What a control does, by its id.
///
/// The ids are this file's own — it minted `track-3` when it built the row —
/// so reading one back is a comparison against its own vocabulary. Nothing in
/// `std/ui` or in the `material` package parses them, which is the difference
/// from the naming convention this replaced: a control used to be found by
/// splitting a node's name on a colon, and a plain text node that happened to
/// contain one answered as a control.
/// Everything a control in this application can say.
///
/// Exhaustive. What it replaces was a chain of string comparisons ending in a
/// `track_id` helper that walked every index the model had to recover a number
/// the view already knew — and a control whose branch was never written laid
/// out perfectly and did nothing.
fn acted(model: Model, msg: Msg) -> Model {
    return match msg {
        ShowLibrary => model,
        PlayPause => started(Model{..model, running: !model.running }),
        Next => started(advanced(model, 1)),
        Shuffle => started(advanced(model, 1)),
        Prev => started(advanced(model, -1)),
        ToggleTheme => Model{..model, dark: !model.dark },
        // The chips have to be *told* the choice changed. Selection is the
        // model's fact — this file knows which genre is on and the design
        // system cannot — so the animation is asked for at the moment the
        // fact changes, one line from the line that changes it.
        ChooseGenre(name) => Model{
            ..model,
            genre: name,
            ui_state: material.choose_one(model.ui_state, genre_ids(), "genre-\(name)"),
        },
        PlayTrack(track) => played(model, track),
    }
}

/// Clicking the track already playing is the transport, not a new selection —
/// which is what every player does and what a listener expects when they click
/// the row a second time.
fn played(model: Model, track: int) -> Model {
    if track == model.playing {
        return started(Model{..model, running: !model.running })
    }
    return started(
        Model {
            ..model,
            playing: track,
            elapsed: 0.0,
            running: true,
            ui_state: material.choose_one(model.ui_state, track_ids(model), "track-\(track)"),
        },
    )
}

fn genre_ids() -> [str] {
    var out: [str] = []
    for name in genres() {
        out.push("genre-\(name)")
    }
    return out
}

fn track_ids(model: Model) -> [str] {
    var out: [str] = []
    for i in 0..model.tracks.len() {
        out.push("track-\(i)")
    }
    return out
}

fn track_id(model: Model, id: str) -> Option<int> {
    for i in 0..model.tracks.len() {
        if id == "track-\(i)" {
            return i
        }
    }
    return nil
}

/// Focus order across both trees: the chrome, with the rows spliced in where
/// the card sits. Both come from `ui.focus_order`, which reads whatever was
/// laid out — so a row the filter removed is not in it, and Tab cannot reach a
/// track that is not on the screen.
fn focus_ring(model: Model) -> [str] {
    let frames = frames_of(model)
    let box = list_rect(frames)
    let rows = ui.focus_order(row_frames(model, box))
    var out: [str] = []
    for id in ui.focus_order(frames) {
        out.push(id)
        if id == "shuffle" {
            for row in rows {
                out.push(row)
            }
        }
    }
    return out
}

fn pressed(model: Model, key: str) -> Model {
    let order = focus_ring(model)
    if key == "Tab" {
        return focused_on(model, ui.next_focus(order, model.focused))
    }
    if key == "ArrowDown" {
        return started(advanced(model, 1))
    }
    if key == "ArrowUp" {
        return started(advanced(model, -1))
    }
    // Left and right scrub rather than moving through the queue, which is what
    // every player does and leaves up and down for the list.
    if key == "ArrowRight" {
        return nudged(model, 5.0)
    }
    if key == "ArrowLeft" {
        return nudged(model, -5.0)
    }
    if key == " " || key == "Enter" {
        // The focused control may be in either tree, and a field types its
        // own space rather than activating.
        let box = list_rect(frames_of(model))
        var said = meaning_of(view_node(model), model.focused)
        if said == nil {
            said = meaning_of(row_tree(model, box), model.focused)
        }
        if said != nil {
            return acted(model, said)
        }
    }
    if model.focused == "search" {
        return Model{..model, search: material.typed(model.search, key) }
    }
    return model
}

/// Move through the *filtered* list, not the whole one — the visible order is
/// the one a listener is looking at, and moving through the hidden one would
/// jump past tracks that are not on the screen.
fn advanced(model: Model, by: int) -> Model {
    let found = shown(model)
    if found.len() == 0 {
        return model
    }
    var at = -1
    for i in 0..found.len() {
        if found[i] == model.playing {
            at = i
        }
    }
    if at < 0 {
        return Model{..model, playing: found[0], elapsed: 0.0 }
    }
    let next = ((at + by) % found.len() + found.len()) % found.len()
    return Model{..model, playing: found[next], elapsed: 0.0 }
}

// ---- running it anywhere else ------------------------------------------------------
//
// A `main` so the example runs on the bytecode and native targets too, where
// there is no page to click on. It drives the same `update` the page drives,
// which is what keeps this testable without a browser — and it keeps `view`
// *reachable*, since unreachable functions are dropped before code generation
// and a `main` that never drew would prune the export the page looks for.

fn main() {
    var model = init()
    io.print("playing \(model.tracks[model.playing].title), running \(model.running)")

    // The composition, which is the part worth comparing across backends: it
    // is arithmetic, it is deterministic, and three backends that disagreed
    // about it would be three backends playing different tunes. The *sound* is
    // not checked here and cannot be — a bytecode or native run has no host to
    // send a note to, the boundary being declared rather than assumed.
    var tune = ""
    for b in melody(1) {
        tune = tune + "\(b.midi)/\(b.steps) "
    }
    io.print("Für Elise opens: \(tune)")
    io.print("its first pitch: \(pitch(melody(1)[0].midi))")
    io.print("Für Elise runs \(clock(composed_duration(1)))")
    io.print("the recorded track is \(clock(duration(model, 0))), from a file")

    // Frames with nothing playing must leave the model *identical*, which is
    // how the host is told to stop asking for them.
    for _tick in 0..10 {
        model = update(model, EVENT_FRAME(), 1000.0 / 60.0, 0.0, "")
    }
    io.print("paused after ten frames: \(clock(math.trunc_to(model.elapsed)))")

    // Focus order comes from the tree, so tabbing is a property of what was
    // laid out rather than of a list written beside it.
    model = update(model, EVENT_KEY(), 0.0, 0.0, "Tab")
    io.print("tab moved focus to \(model.focused)")

    model = advanced(model, 1)
    io.print("next: \(model.tracks[model.playing].title)")

    let filtered = Model{..model, genre: "Folk" }
    io.print("folk leaves \(shown(filtered).len()) of \(model.tracks.len())")

    // Every size class lays out, and the narrow ones do not simply overflow:
    // the tree they produce is a different tree. This is the check that the
    // demo fits the slot it is embedded in on the front page.
    for w in [360.0, 664.0, 1100.0] {
        let sized = Model{..model, width: w, height: 460.0 }
        let laid = frames_of(sized)
        var widest = 0.0
        for f in laid {
            let right = f.rect.x + f.rect.width
            if right > widest {
                widest = right
            }
        }
        let rail = if material.has_rail(w) { "rail" } else { "bottom bar" }
        io.print("at \(w): \(rail), \(laid.len()) frames, widest \(widest)")
    }

    // Seeking, without a browser: a click at a known fraction of the seek bar
    // moves the playhead there, and the arrows scrub. The audio is not checked
    // — a bytecode or native run has no host to send a note to — but the
    // arithmetic that decides *where* is, and it is the part that can be wrong.
    let wide = Model{..model, width: 1100.0, height: 700.0 }
    let bar = ui.frame_of(frames_of(wide), "seek")
    if bar != nil {
        let middle = bar.rect.x + bar.rect.width / 2.0
        let at = material.slider_value_at(bar.rect, middle)
        io.print("clicking the middle of the seek bar: \(math.round_to(at * 100.0))%")
        io.print("far left: \(material.slider_value_at(bar.rect, bar.rect.x))")
        let right = bar.rect.x + bar.rect.width
        io.print("far right: \(material.slider_value_at(bar.rect, right))")
    }

    // Hover, press and the ripple, driven exactly the way the page drives them.
    //
    // Nothing here used to light up until it was clicked: `update` handled
    // click, key, resize, frame and wheel, and the three pointer events that
    // carry hover and press fell through to the default branch. They are
    // handled now, and this is what that bought — checked without a browser,
    // because the state layer is arithmetic on a model like everything else.
    let play = ui.frame_of(frames_of(wide), "play")
    if play != nil {
        let px = play.rect.x + play.rect.width / 2.0
        let py = play.rect.y + play.rect.height / 2.0
        var live = update(wide, EVENT_MOVE(), px, py, "")
        io.print("hover on arrival: \(percent(hover_of(live)))")
        // One frame, not a transition: a hover layer is saying where the
        // pointer *is*, and the only correct time to say so is now. Anything
        // slower leaves a trail of half-lit controls behind a moving cursor.
        live = update(live, EVENT_FRAME(), 16.0, 0.0, "")
        io.print("hover one frame later: \(percent(hover_of(live)))")

        // A settled interaction must come back *identical*, or the host keeps
        // asking for frames forever and the fan comes on. Focus is the slowest
        // of the layers at 45ms — the Tab above set one — so this gives
        // everything a few frames to arrive before asking.
        for _settle in 0..8 {
            live = update(live, EVENT_FRAME(), 16.0, 0.0, "")
        }
        let again = update(live, EVENT_FRAME(), 16.0, 0.0, "")
        io.print("still after settling: \(!material.animating(again.ui_state))")

        // Pressing starts a ripple, whose colour is the control's own ink.
        live = update(live, EVENT_DOWN(), px, py, "")
        let reaction = material.reaction_of(live.ui_state, "play")
        if reaction != nil {
            io.print("ripple on press: \(reaction.ripple.live), ink \(reaction.ripple.ink)")
        }
        live = update(live, EVENT_UP(), 0.0, 0.0, "")
        live = update(live, EVENT_FRAME(), 4.0, 0.0, "")
        let brief = material.reaction_of(live.ui_state, "play")
        if brief != nil {
            io.print("ripple survives a 4ms tap: \(brief.ripple.live)")
        }
        // And the pointer leaving takes the layer back down, in a frame —
        // which is what stops a list from wearing a comet tail.
        live = update(live, EVENT_MOVE(), -1.0, -1.0, "")
        live = update(live, EVENT_FRAME(), 16.0, 0.0, "")
        io.print("hover one frame after the pointer left: \(percent(hover_of(live)))")
    }

    let frames = frames_of(model)
    io.print("frames \(frames.len()), controls \(ui.focus_order(frames).len())")

    view(model)
}

fn hover_of(model: Model) -> float {
    return material.state_of(model.ui_state, "play").hover
}

fn percent(v: float) -> str {
    return "\(math.round_to(v * 100.0))%"
}
