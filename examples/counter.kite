// An application.
//
// There is no mutable global state in Kite, so there is nowhere for an
// application to keep a model except in a value that is passed around. The
// host holds that value between events and hands it back — it is a reference
// the module owns and JavaScript cannot look inside — and `update` returns a
// new one rather than changing the old.
//
// That gives the shape every state-management library eventually converges on,
// without a library: `init`, `update`, `view`, and no way to draw from an
// update or to mutate from a view.
//
//     kitec build examples/counter.kite --emit wasm --out dist

use std/ui

/// What this application can be told. Every control in the tree carries one of
/// these, so `update` is handed a value it defined rather than a string it has
/// to recognise — and `match` on it is exhaustive, which means adding a
/// variant makes the compiler name every place that must change.
pub enum Msg {
    Increment
    Decrement
    Reset
}

pub struct Model {
    pub count: int
    pub last: str
}

pub fn init() -> Model {
    return Model{ count: 0, last: "nothing yet" }
}

/// A tile carries its own look now. Decoration rides on the node rather than
/// arriving later in a list matched by name, so the caption and the colour it
/// is drawn in are written in one place — and a tile the tree does not contain
/// cannot be painted by mistake.
fn tile(name: str, caption: str, width: float, background: int, ink: int) -> ui.Node<Msg> {
    let node: ui.Node<Msg> = ui.text_of(
        name,
        ui.padded(ui.sized(ui.style(), width, 32.0), 8.0),
        caption,
    )
    return ui.decorated(node, ui.centered(ui.inked(ui.rounded(background, 6.0), ink)))
}

/// The same tile, made a control that means something. The message is built
/// here, by the code that knows which tile this is — not recovered later from
/// the name.
fn button(name: str, msg: Msg, caption: str, width: float, background: int, ink: int) -> ui.Node<Msg> {
    return ui.means(tile(name, caption, width, background, ink), name, msg)
}

fn ui_of(model: Model) -> ui.Node<Msg> {
    let controls = ui.box_of(
        "controls",
        ui.spaced(ui.Style{..ui.row(), align: ui.Align.Center }, 8.0),
        [
            button("minus", Msg.Decrement, "  -  ", 48.0, 0x2a2f3a, 0xc9d1dc),
            tile("count", "\(model.count)", 96.0, accent_of(model), 0xffffff),
            button("plus", Msg.Increment, "  +  ", 48.0, 0x2a2f3a, 0xc9d1dc),
            button("reset", Msg.Reset, " reset ", 72.0, 0x3a2a2a, 0xdcc9c9),
        ],
    )

    return ui.decorated(
        ui.box_of(
            "app",
            ui.spaced(ui.padded(ui.Style{..ui.column(), align: ui.Align.Start }, 16.0), 12.0),
            [
                ui.decorated(ui.text_of("title", ui.style(), "Counter"), ui.ink(0xf5f7fa)),
                controls,
                ui.decorated(
                    ui.text_of("status", ui.style(), "last action: \(model.last)"),
                    ui.ink(0x8b93a1),
                ),
                ui.decorated(
                    ui.text_of(
                        "hint",
                        ui.style(),
                        "click, or press + - r; the model lives inside the module",
                    ),
                    ui.ink(0x5c6472),
                ),
            ],
        ),
        ui.filled(0x14161a),
    )
}

fn accent_of(model: Model) -> int {
    if model.count > 0 {
        return 0x3b82f6
    }
    return 0x2a2f3a
}

fn viewport() -> ui.Size {
    return ui.Size{ width: 640.0, height: 240.0 }
}

fn frames_of(model: Model) -> [ui.Frame] {
    return ui.layout(ui_of(model), viewport())
}

pub fn view(model: Model) {
    ui.paint(frames_of(model))
}

/// The only way the model changes.
///
/// Every event comes through one door: a click fills `x` and `y`, a key press
/// fills `key`. One signature rather than one per kind means a new kind of
/// event is a new constant rather than a new export, and a program that
/// ignores a kind never matches on it.
pub fn update(model: Model, event: int, x: float, y: float, key: str) -> Model {
    if event == 0 {
        // What was pressed is asked of the tree, which is where the meaning was
        // written. A guard clause narrows for the rest of the block, so `said`
        // reads as a `Msg` below without being unwrapped.
        let tree = ui_of(model)
        let said = ui.msg_at(tree, ui.layout(tree, viewport()), x, y)
        if said == nil {
            return model
        }
        return act(model, said)
    }
    if event == 1 {
        return press(model, key)
    }
    return model
}

/// The keyboard reaches the same actions the buttons do, which is what stops
/// the two drifting apart.
fn press(model: Model, key: str) -> Model {
    if key == "+" || key == "=" || key == "ArrowUp" {
        return act(model, Msg.Increment)
    }
    if key == "-" || key == "ArrowDown" {
        return act(model, Msg.Decrement)
    }
    if key == "r" || key == "R" {
        return act(model, Msg.Reset)
    }
    return model
}

/// Every way the model can change, in one exhaustive `match`.
///
/// There is no fall-through arm, and that is the point: a fourth variant makes
/// this stop compiling until it is handled. The string version had a
/// catch-all, so a control whose branch was never written laid out perfectly,
/// focused correctly, and did nothing when pressed.
fn act(model: Model, msg: Msg) -> Model {
    return match msg {
        Increment => Model{ count: model.count + 1, last: "increment" },
        Decrement => Model{ count: model.count - 1, last: "decrement" },
        Reset => Model{ count: 0, last: "reset" },
    }
}

// `main` lets the same program run under `kitec run`, which draws once to text
// and is how the differential suite sees it.
fn main() {
    var model = init()
    view(model)
    model = update(model, 0, 300.0, 60.0, "")
    view(model)
    model = update(model, 1, 0.0, 0.0, "+")
    model = update(model, 1, 0.0, 0.0, "+")
    view(model)
}
