// An application.
//
// There is no mutable global state in Kite, so there is nowhere for an
// application to keep a model except in a value that is passed around. The
// host holds that value between events and hands it back — it is a reference
// the module owns and JavaScript cannot look inside — and `update` returns a
// new one rather than changing the old.
//
// That gives the shape every state-management library eventually converges on,
// without a library: `init`, `update`, `view`, and no way to draw from an
// update or to mutate from a view.
//
//     kitec build examples/counter.kite --emit wasm --out dist

use std/ui

pub struct Model {
  pub count: int
  pub last: str
}

pub fn init() -> Model {
  return Model{count: 0, last: "nothing yet"}
}

fn tile(name: str, caption: str, width: float) -> Node {
  return text_of(name, padded(sized(style(), width, 32.0), 8.0), caption)
}

fn ui_of(model: Model) -> Node {
  let controls = box_of(
    "controls",
    spaced(Style{..row(), align: Align.Center}, 8.0),
    [
      tile("minus", "  -  ", 48.0),
      tile("count", "\(model.count)", 96.0),
      tile("plus", "  +  ", 48.0),
      tile("reset", " reset ", 72.0),
    ],
  )

  return box_of(
    "app",
    spaced(padded(Style{..column(), align: Align.Start}, 16.0), 12.0),
    [
      text_of("title", style(), "Counter"),
      controls,
      text_of("status", style(), "last action: \(model.last)"),
      text_of("hint", style(), "click a button; the model lives inside the module"),
    ],
  )
}

fn palette(model: Model) -> [Paint] {
  let accent = if model.count > 0 { 0x3b82f6 } else { 0x2a2f3a }
  return [
    fill("app", 0x14161a),
    label("title", "Counter", 0xf5f7fa),
    filled_label("minus", "  -  ", 0x2a2f3a, 0xc9d1dc),
    filled_label("count", "\(model.count)", accent, 0xffffff),
    filled_label("plus", "  +  ", 0x2a2f3a, 0xc9d1dc),
    filled_label("reset", " reset ", 0x3a2a2a, 0xdcc9c9),
    label("status", "last action: \(model.last)", 0x8b93a1),
    label("hint", "click a button; the model lives inside the module", 0x5c6472),
  ]
}

fn frames_of(model: Model) -> [Frame] {
  return layout(ui_of(model), Size{width: 640.0, height: 240.0})
}

pub fn view(model: Model) {
  paint(frames_of(model), palette(model))
}

/// The only way the model changes. `event` is 0 for a click; more arrive as
/// the host learns to send them.
pub fn update(model: Model, event: int, x: float, y: float) -> Model {
  if event != 0 {
    return model
  }
  // A guard clause narrows for the rest of the block, so `target` reads as a
  // `Frame` below without being unwrapped.
  let target = hit(frames_of(model), x, y)
  if target == nil {
    return model
  }
  return act(model, target.name)
}

fn act(model: Model, name: str) -> Model {
  if name == "plus" {
    return Model{count: model.count + 1, last: "increment"}
  }
  if name == "minus" {
    return Model{count: model.count - 1, last: "decrement"}
  }
  if name == "reset" {
    return Model{count: 0, last: "reset"}
  }
  return Model{..model, last: "clicked \(name)"}
}

// `main` lets the same program run under `kitec run`, which draws once to text
// and is how the differential suite sees it.
fn main() {
  var model = init()
  view(model)
  model = update(model, 0, 300.0, 60.0)
  view(model)
}
