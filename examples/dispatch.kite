// Trait objects.
//
// A `dyn Trait` holds a value whose concrete type is not known until run time.
// Which method body runs is decided from the value itself — the one place in
// Kite where control flow is not visible in the source, and the reason traits
// are the language's only form of polymorphism today.
//
// Everything about the call is still checked statically: the trait fixes the
// signature, and a type may only enter a `dyn Trait` if it has an `impl` block
// for that trait. Implementing the right methods by accident is not enough.

pub trait Drawable {
  // Every method takes `self`. A trait with a method that does not cannot
  // become an object, because there would be nothing to dispatch on.
  fn area(self) -> float
  fn name(self) -> str

  // A default body. A type may take it or replace it; dispatch finds whichever
  // one that type ended up with.
  fn describe(self) -> str {
    return "a \(self.name())"
  }
}

pub struct Circle {
  pub radius: float
}

pub struct Rect {
  pub width: float
  pub height: float
}

impl Drawable for Circle {
  fn area(self) -> float {
    return 3.14159 * self.radius * self.radius
  }

  fn name(self) -> str {
    return "circle"
  }
}

impl Drawable for Rect {
  fn area(self) -> float {
    return self.width * self.height
  }

  fn name(self) -> str {
    return "rect"
  }

  // Replacing the default. Which body runs is decided from the value, so a
  // `Rect` inside a `dyn Drawable` gets this one and a `Circle` gets the
  // default — with no tag in the source saying so.
  fn describe(self) -> str {
    return "a \(self.width) by \(self.height) \(self.name())"
  }
}

// The parameter names behaviour, not a type. Any `Drawable` fits.
fn report(shape: dyn Drawable) {
  io.print("\(shape.describe()) covering \(shape.area()) units")
}

fn total_area(shapes: [dyn Drawable]) -> float {
  var sum = 0.0
  for s in shapes {
    sum = sum + s.area()
  }
  return sum
}

fn main() {
  // A concrete value is accepted wherever the trait object is wanted; nothing
  // about the value changes, only what the compiler will let you do with it.
  report(Circle{radius: 1.0})
  report(Rect{width: 3.0, height: 2.0})
  report(Rect{width: 4.0, height: 4.0})

  let shapes: [dyn Drawable] = [
    Circle{radius: 2.0},
    Rect{width: 1.0, height: 5.0},
  ]
  io.print("\(shapes.len()) shapes, \(total_area(shapes)) units in total")
}
