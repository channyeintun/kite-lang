// Rendering.
//
// The same program draws to a DOM tree, to a canvas, or to text, and cannot
// tell which: it calls `draw.rect` and `draw.text` and nothing else. That is
// the whole host boundary for graphics, and it is two calls wide because
// everything a layout produces is a rectangle or a run of text.
//
// Build it and open `dist/index.html`:
//
//     kitec build examples/render.kite --emit wasm --out dist

use std/ui

fn app() -> ui.Node {
    let header = ui.decorated(ui.box_of(
            "header",
            ui.spaced(ui.padded(ui.Style{..ui.row(), align: ui.Align.Center, justify: ui.Justify.SpaceBetween }, 12.0), 8.0),
            [
                ui.decorated(ui.text_of("title", ui.style(), "Kite"), ui.ink(0xf5f7fa)),
                ui.decorated(
                    ui.text_of("subtitle", ui.style(), "one layout, two renderers"),
                    ui.ink(0x8b93a1),
                ),
            ],
        ), ui.filled(0x1f232b))

    let sidebar = ui.decorated(ui.box_of(
            "sidebar",
            ui.spaced(ui.padded(ui.Style{..ui.column(), width: 160.0 }, 12.0), 8.0),
            [
                ui.decorated(ui.text_of("nav-home", ui.style(), "Home"), ui.ink(0xc9d1dc)),
                ui.decorated(ui.text_of("nav-files", ui.style(), "Files"), ui.ink(0xc9d1dc)),
                ui.decorated(ui.text_of("nav-settings", ui.style(), "Settings"), ui.ink(0xc9d1dc)),
            ],
        ), ui.filled(0x1a1e25))

    let actions = ui.box_of(
        "actions",
        ui.spaced(ui.Style{..ui.row(), justify: ui.Justify.End }, 8.0),
        [
            ui.decorated(
                ui.text_of("cancel", ui.padded(ui.style(), 6.0), "Cancel"),
                ui.inked(ui.filled(0x2a2f3a), 0xc9d1dc),
            ),
            ui.decorated(
                ui.text_of("confirm", ui.padded(ui.style(), 6.0), "Confirm"),
                ui.inked(ui.filled(0x3b82f6), 0xffffff),
            ),
        ],
    )

    let content = ui.box_of(
        "content",
        ui.spaced(ui.grown(ui.padded(ui.Style{..ui.column(), align: ui.Align.Stretch }, 16.0), 1.0), 12.0),
        [
            ui.decorated(ui.text_of("heading", ui.style(), "Welcome back"), ui.ink(0xf5f7fa)),
            ui.decorated(
                ui.text_of("intro", ui.style(), "Everything here was placed by std/ui.kite."),
                ui.ink(0x8b93a1),
            ),
            ui.decorated(
                ui.text_of(
                    "note",
                    ui.grown(ui.padded(ui.Style{..ui.style(), width: 420.0 }, 10.0), 1.0),
                    "A text node wraps when it has been given a width, and not otherwise — which width to wrap to is only knowable once a parent has decided, and measurement runs first.",
                ),
                ui.inked(ui.filled(0x1a1e25), 0x8b93a1),
            ),
            actions,
        ],
    )

    let body = ui.box_of("main", ui.Style{..ui.row(), align: ui.Align.Stretch, grow: 1.0 }, [sidebar, content])
    return ui.decorated(
        ui.box_of("app", ui.Style{..ui.column(), align: ui.Align.Stretch }, [header, body]),
        ui.filled(0x14161a),
    )
}

fn main() {
    let frames = ui.layout(app(), ui.Size{ width: 640.0, height: 360.0 })
    ui.paint(frames, 0x14161a)
}
