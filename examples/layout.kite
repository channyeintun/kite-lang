// Layout.
//
// A UI described as a tree, laid out into absolute rectangles. The layout
// engine lives in `std/ui.kite` and is written in Kite — it computes where
// things go and draws nothing, so the same result can feed a DOM renderer or a
// canvas renderer without either being able to disagree with the other.

use std/ui

fn app() -> Node {
  let header = box_of(
    "header",
    spaced(padded(Style{..row(), align: Align.Center, justify: Justify.SpaceBetween}, 12.0), 8.0),
    [
      text_of("title", style(), "Kite"),
      text_of("subtitle", style(), "layout demo"),
    ],
  )

  let sidebar = box_of(
    "sidebar",
    spaced(padded(Style{..column(), width: 160.0}, 8.0), 6.0),
    [
      text_of("nav-home", style(), "Home"),
      text_of("nav-files", style(), "Files"),
      text_of("nav-settings", style(), "Settings"),
    ],
  )

  let content = box_of(
    "content",
    grown(padded(Style{..column(), align: Align.Stretch}, 16.0), 1.0),
    [
      text_of("heading", style(), "Welcome back"),
      text_of("body", grown(style(), 1.0), "Everything below was placed by std/ui.kite."),
      box_of(
        "actions",
        spaced(Style{..row(), justify: Justify.End}, 8.0),
        [
          text_of("cancel", style(), "Cancel"),
          text_of("confirm", style(), "Confirm"),
        ],
      ),
    ],
  )

  let body = box_of("body", Style{..row(), align: Align.Stretch, grow: 1.0}, [sidebar, content])

  return box_of("app", Style{..column(), align: Align.Stretch}, [header, body])
}

fn indent(depth: int) -> str {
  var pad = ""
  for i in 0..depth {
    pad = pad + "  "
  }
  return pad
}

fn show(frame: Frame) {
  let r = frame.rect
  io.print("\(indent(frame.depth))\(frame.name)  x=\(r.x) y=\(r.y) w=\(r.width) h=\(r.height)")
}

fn main() {
  let frames = layout(app(), Size{width: 640.0, height: 360.0})

  io.print("laid out \(frames.len()) boxes into 640x360")
  for frame in frames {
    show(frame)
  }

  // Hit testing walks the same frames, last match first, because the last
  // frame painted is the one on top.
  let target = hit(frames, 600.0, 330.0)
  if target != nil {
    io.print("point (600, 330) is inside \(target.name)")
  }

  let outside = hit(frames, 900.0, 900.0)
  io.print("point (900, 900) hits something: \(is_some(outside))")
}
