// Five thousand rows, filtered and sorted on every keystroke.
//
//     kitec build examples/page/main.kite --emit wasm --out examples/page
//     python3 -m http.server -d examples/page 8000

use std/dom
use std/html
use std/time

struct Row {
    id: int
    name: str
    region: str
    amount: int
    status: str
    /// Everything searchable, folded once here rather than on every keystroke.
    haystack: str
}

struct View {
    var query: str
    var key: str
    var descending: bool
}

fn word(table: [str], n: int) -> str {
    return table[n % table.len()]
}

/// Deterministic data, so the page is the same on every machine.
fn rows() -> [Row] {
    let firsts = ["Ada", "Grace", "Alan", "Barbara", "Edsger", "Katherine",
        "Donald", "Margaret", "Tony", "Radia", "John", "Frances"]
    let lasts = ["Lovelace", "Hopper", "Turing", "Liskov", "Dijkstra", "Johnson",
        "Knuth", "Hamilton", "Hoare", "Perlman", "McCarthy", "Allen"]
    let regions = ["Yangon", "Reykjavík", "São Paulo", "Kraków", "Nairobi",
        "Osaka", "Toronto", "Lisboa", "Chennai", "Auckland"]
    let states = ["active", "pending", "closed"]

    var out: [Row] = []
    var seed = 20260805
    for i in 0..5000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        let a = seed / 65536
        let name = "\(word(firsts, a)) \(word(lasts, a / 7 + i))"
        let region = word(regions, a / 3 + i * 2)
        let status = word(states, a / 11 + i)
        out.push(Row{
                id: 1000 + i,
                name: name,
                region: region,
                amount: 40 + (a % 9960),
                status: status,
                haystack: lower("\(name) \(region) \(status)"),
            })
    }
    return out
}

fn matches(r: Row, needle: str) -> bool {
    return needle.len() == 0 || contains(r.haystack, needle)
}

fn ordered(items: [Row], key: str, descending: bool) -> [Row] {
    let up = if key == "amount" {
        sorted(items, |a: Row, b: Row| a.amount < b.amount)
    } else if key == "region" {
        sorted(items, |a: Row, b: Row| a.region < b.region)
    } else if key == "name" {
        sorted(items, |a: Row, b: Row| a.name < b.name)
    } else {
        sorted(items, |a: Row, b: Row| a.id < b.id)
    }
    return if descending { reversed(up) } else { up }
}

fn money(amount: int) -> str {
    return "$\(amount / 100).\(pad_start("\(amount % 100)", 2, "0"))"
}

fn row_of(r: Row) -> html.Node {
    return html.keyed("\(r.id)", html.el("tr", [], [
                html.txt("td", [html.class("num")], "\(r.id)"),
                html.txt("td", [], r.name),
                html.txt("td", [], r.region),
                html.txt("td", [html.class("num")], money(r.amount)),
                html.txt("td", [html.class("tag \(r.status)")], r.status),
            ]))
}

fn refresh(all: [Row], var view: html.Mounted, v: View, note: dom.Element) {
    let started = time.now()
    let needle = lower(v.query)
    let found = filter(all, |r: Row| matches(r, needle))
    let shown = take(ordered(found, v.key, v.descending), 100)
    let err = html.update(view, map(shown, row_of))
    if err != nil {
        io.error("could not draw: \(err.message())")
        return
    }
    let took = time.now() - started
    let nerr = dom.set_text(note, "\(all.len()) rows · \(found.len()) matched · \(shown.len()) shown · \(took) ms")
    if nerr != nil {
        io.error("could not write the count: \(nerr.message())")
    }
}

fn set_key(var v: View, key: str) {
    if v.key == key {
        v.descending = !v.descending
    } else {
        v.key = key
        v.descending = false
    }
}

fn set_query(var v: View, q: str) {
    v.query = q
}

fn main() {
    let search = dom.find("#search")
    let body = dom.find("#rows")
    let note = dom.find("#note")
    if search == nil {
        io.error("no #search")
        return
    }
    if body == nil {
        io.error("no #rows")
        return
    }
    if note == nil {
        io.error("no #note")
        return
    }

    let all = rows()
    let state = View{ query: "", key: "id", descending: false }
    let (mounted, merr) = html.mount(body, [])
    if merr != nil {
        io.error("could not mount: \(merr.message())")
        return
    }
    refresh(all, mounted, state, note)

    let (typed, terr) = dom.on(search, "input", |e: dom.Event| {
            set_query(state, dom.event_value(e))
            refresh(all, mounted, state, note)
        })
    if terr != nil {
        io.error("could not listen: \(terr.message())")
        return
    }

    for th in dom.find_all("th[data-key]") {
        let key = dom.attribute(th, "data-key")
        if key == nil {
            continue
        }
        let column = key
        let (sub, err) = dom.on(th, "click", |e: dom.Event| {
                set_key(state, column)
                refresh(all, mounted, state, note)
            })
        if err != nil {
            io.error("could not listen: \(err.message())")
            return
        }
    }
}
