enum Shape {
    Circle(radius: int)
    Rect(width: int, height: int)
    Point
}

fn describe(s: Shape) -> str {
    return match s {
        Circle(r) => "circle",
        Rect(w, h) if w == h => "square",
        Rect(w, h) => "rect",
        Point => "a point",
    }
}

fn area(s: Shape) -> int {
    return match s {
        Circle(r) => 3 * r * r,
        Rect(w, h) => w * h,
        Point => 0,
    }
}

fn main() {
    let c = Circle(radius: 2)
    io.print(describe(c))
    io.print(area(c))

    io.print(describe(Rect(width: 3, height: 3)))
    io.print(describe(Rect(width: 3, height: 4)))
    io.print(area(Rect(width: 3, height: 4)))
    io.print(describe(Point))

    let n = 7
    io.print(match n {
        0 => "zero",
        1 | 2 | 3 => "small",
        4..=9 => "medium",
        _ => "large",
    })
}
