// A two-pane reader: the UI layer doing what a UI layer is for.
//
//     kitec build examples/reader.kite --emit wasm --out dist
//     open dist/index.html
//
// Where `boids.kite` exists to be fast, this exists to be an *application* —
// a list beside a detail pane, a filter that narrows as you type, controls
// that take focus in order, and a theme that changes under the whole thing.
// Every one of those is ordinary Kite over `std/ui`, and there is no widget
// object anywhere in it.
//
// Three things are worth watching for.
//
// **It is driveable by keyboard alone.** Tab and Shift+Tab move focus, the
// arrows move the selection, space marks a message read, and typing goes to
// whichever field has focus. Nothing here is a special case for the keyboard:
// a control is focused or it is not, and the same `update` handles both.
//
// **Nothing remembers anything.** There is no widget holding its own text and
// no handler closing over mutable state — Kite has no mutable globals, so a
// widget that remembered something would have to be *handed* it, and the model
// is what it would be handed. `view` draws a model; `update` returns a new
// one; that is the whole architecture.
//
// **The messages are not all in Latin script.** Arabic and Hebrew run right to
// left, and they are reordered by UAX #9 and their Arabic letters joined into
// contextual forms before anything is painted. Note that this file does not
// import `std/text` and never mentions it: the reordering happens inside the
// *layout*, not in a renderer and not at a call site, which is why the DOM and
// canvas paths agree about it — switch between them and nothing moves.

use std/ui

// The size a window has before the host has said otherwise. A `resize` arrives
// before the first frame is drawn, so these are a floor rather than a guess.
fn WIDTH() -> float {
    return 960.0
}

fn HEIGHT() -> float {
    return 600.0
}

// ---- Material's type scale ----------------------------------------------
//
// Five of the fifteen roles, which are the five this uses. A role is a size
// *and* a weight — `title_medium` is 16dp at 500, and at 400 it would read as
// body text in a title's position, which is the mistake the scale exists to
// prevent.

fn TITLE_LARGE() -> float {
    return 22.0
}

fn TITLE_MEDIUM() -> float {
    return 16.0
}

fn BODY_LARGE() -> float {
    return 16.0
}

fn BODY_MEDIUM() -> float {
    return 14.0
}

fn LABEL_MEDIUM() -> float {
    return 12.0
}

fn REGULAR() -> int {
    return 400
}

fn MEDIUM() -> int {
    return 500
}

struct Message {
    from: str
    subject: str
    body: str
    read: bool
}

pub struct Model {
    messages: [Message]
    /// What the host says the window is. A layout is a function of its size,
    /// so this is model state like everything else — there is nowhere else to
    /// put it, Kite having no mutable globals.
    width: float
    height: float
    /// Which message the detail pane is showing. An index rather than a
    /// reference, because the list it indexes is rebuilt on every filter and a
    /// reference would be to the old one.
    selected: int
    filter: str
    focused: str
    dark: bool
}

// ---- the messages -----------------------------------------------------------
//
// Deliberately not all in one script. A reader that only ever showed English
// would be demonstrating a layout engine and quietly not demonstrating the
// text engine underneath it.

fn inbox() -> [Message] {
    return [
        Message {
            from: "Ada Lovelace",
            subject: "the analytical engine",
            body: "The engine can arrange and combine its numerical quantities exactly as if they were letters or any other general symbols.",
            read: true,
        },
        Message {
            from: "أحمد",
            subject: "مرحبا بالعالم",
            body: "هذا نص عربي، تتصل حروفه ويُقرأ من اليمين إلى اليسار.",
            read: false,
        },
        Message {
            from: "שרה",
            subject: "שלום",
            body: "טקסט בעברית, מימין לשמאל, מעורבב עם Kite באנגלית.",
            read: false,
        },
        Message {
            from: "山田",
            subject: "日本語のテスト",
            body: "日本語の文章です。単語の区切りがないので、行はほとんどどの文字のあいだでも折り返せます。",
            read: true,
        },
        Message {
            from: "आर्या",
            subject: "नमस्ते",
            body: "देवनागरी में लिखा पाठ, जिसे पंक्ति-विभाजक शब्दों के बीच तोड़ता है।",
            read: true,
        },
    ]
}

pub fn init() -> Model {
    return Model{
        messages: inbox(),
        width: WIDTH(),
        height: HEIGHT(),
        selected: 0,
        filter: "",
        focused: ui.field("filter"),
        dark: true,
    }
}

// ---- what the filter leaves --------------------------------------------------

fn matching(model: Model) -> [int] {
    var out: [int] = []
    for i in 0..model.messages.len() {
        let m = model.messages[i]
        if model.filter == "" {
            out.push(i)
        } else {
            let needle = lower(model.filter)
            if contains(lower(m.from), needle) || contains(lower(m.subject), needle) {
                out.push(i)
            }
        }
    }
    return out
}

/// Where the selected message sits in the filtered list, or -1 when the filter
/// has hidden it. Selection survives a filter that hides it — narrow, widen,
/// and the same message is still chosen — which is the behaviour a person
/// expects and the one that needs saying out loud.
fn position_of(model: Model, shown: [int]) -> int {
    for i in 0..shown.len() {
        if shown[i] == model.selected {
            return i
        }
    }
    return -1
}

// ---- the tree ------------------------------------------------------------------

// ---- Material Design 3 ---------------------------------------------------------
//
// The colour system, by its role names rather than by its hues — which is the
// part of Material 3 that is actually a system. A role says what a colour is
// *for*: `primary` is the accent an action wears, `on_primary` is what may be
// drawn on top of it, `surface_container_high` is the layer a raised thing
// sits on. Swapping light for dark swaps the values and changes nothing about
// which role goes where, and that is the whole point of naming them.
//
// These are the MD3 **baseline** values — the default scheme, the one a
// Material app gets before anyone picks a source colour.
//
// **What the drawing boundary cannot express, and this does not pretend to.**
// Material's shape scale is rounded corners, and its type scale is five sizes
// of text; a Kite program draws through `draw.rect` and `draw.text`, so every
// corner here is square and every word is one size. What is left is the colour
// system, the spacing, and the component structure — which is most of what
// makes a Material layout recognisable, and all of what makes it *systematic*.
struct Scheme {
    primary: int
    on_primary: int
    primary_container: int
    on_primary_container: int
    secondary_container: int
    on_secondary_container: int
    surface: int
    on_surface: int
    on_surface_variant: int
    surface_container_low: int
    surface_container: int
    surface_container_high: int
    outline_variant: int
}

fn material_light() -> Scheme {
    return Scheme{
        primary: 0x6750a4,
        on_primary: 0xffffff,
        primary_container: 0xeaddff,
        on_primary_container: 0x21005d,
        secondary_container: 0xe8def8,
        on_secondary_container: 0x1d192b,
        surface: 0xfef7ff,
        on_surface: 0x1d1b20,
        on_surface_variant: 0x49454f,
        surface_container_low: 0xf7f2fa,
        surface_container: 0xf3edf7,
        surface_container_high: 0xece6f0,
        outline_variant: 0xcac4d0,
    }
}

fn material_dark() -> Scheme {
    return Scheme{
        primary: 0xd0bcff,
        on_primary: 0x381e72,
        primary_container: 0x4f378b,
        on_primary_container: 0xeaddff,
        secondary_container: 0x4a4458,
        on_secondary_container: 0xe8def8,
        surface: 0x141218,
        on_surface: 0xe6e0e9,
        on_surface_variant: 0xcac4d0,
        surface_container_low: 0x1d1b20,
        surface_container: 0x211f26,
        surface_container_high: 0x2b2930,
        outline_variant: 0x49454f,
    }
}

/// The size the layout is measured against, which is whatever the host last
/// said — never the constant, once the host has spoken.
fn viewport(model: Model) -> ui.Size {
    return ui.Size{ width: model.width, height: model.height }
}

fn scheme_of(model: Model) -> Scheme {
    if model.dark {
        return material_dark()
    }
    return material_light()
}

/// The widget layer paints its own controls from a `ui.Theme`, so the roles are
/// mapped onto it once, here. Six names against thirteen is a lossy map, and
/// it is the right way round: `std/ui` supplies the mechanism and knows nothing
/// about Material, while a design system is the application's to choose.
fn theme_of(model: Model) -> ui.Theme {
    let s = scheme_of(model)
    return ui.Theme{
        background: s.surface,
        surface: s.surface_container_low,
        ink: s.on_surface,
        muted: s.on_surface_variant,
        accent: s.primary,
        focus: s.primary,
    }
}

fn controls(model: Model) -> [str] {
    var names: [str] = [ui.field("filter"), ui.button("theme")]
    for i in matching(model) {
        names.push(ui.checkbox("read\(i)"))
    }
    return names
}

/// The first line `body` wraps to at `limit`, which is how a column of text is
/// kept inside its column.
///
/// Kite's layout grows a box into spare space and never shrinks one below its
/// content: a `grow` says "take what is left", not "give back what you do not
/// need". That is the simpler rule and the one that makes a layout predictable
/// — and it means a long subject would otherwise run straight out of the list
/// and over the pane beside it, which is exactly what the first version of
/// this did. Fitting the text is the caller's job, so the caller does it, with
/// the same wrapper the layout uses.
fn fit(body: str, limit: float) -> str {
    let lines = ui.wrap(body, limit)
    if lines.len() == 0 {
        return body
    }
    if lines.len() == 1 {
        return lines[0]
    }
    return "\(lines[0])…"
}

fn view_node(model: Model) -> ui.Node {
    let shown = matching(model)

    // A top app bar. Material's small bar is 64dp tall with 16dp of padding,
    // and its title sits at title-large beside whatever actions there are.
    let header = ui.box_of(
        "header",
        ui.spaced(
            ui.padded(
                ui.sized(ui.Style{..ui.row(), align: ui.Align.Center }, 0.0, 64.0),
                16.0,
            ),
            12.0,
        ),
        [
            ui.text_of("app-title", ui.in_font(ui.style(), TITLE_LARGE(), REGULAR()), "Inbox"),
            ui.text_of(
                "app-count",
                ui.grown(ui.in_font(ui.style(), BODY_MEDIUM(), REGULAR()), 1.0),
                "\(shown.len()) of \(model.messages.len())",
            ),
            ui.field_node_labelled(
                "filter",
                model.filter,
                240.0,
                model.focused == ui.field("filter"),
                "Search mail",
            ),
            ui.button_node("theme", if model.dark { "Light" } else { "Dark" }),
        ],
    )

    // Two lines per message, which is Material's 72dp list item: the sender on
    // top and the subject under it. The first version put one line in 40dp and
    // it read as a table of strings rather than as a list of messages.
    let column = list_width(model)
    var rows: [ui.Node] = []
    for i in shown {
        let m = model.messages[i]
        rows.push(
            ui.box_of(
                "row\(i)",
                ui.spaced(
                    ui.padded(
                        ui.sized(ui.Style{..ui.row(), align: ui.Align.Center }, 0.0, 72.0),
                        12.0,
                    ),
                    12.0,
                ),
                [
                    ui.checkbox_node("read\(i)", "", m.read),
                    ui.box_of(
                        "row\(i)-lines",
                        ui.spaced(ui.grown(ui.Style{..ui.column(), align: ui.Align.Stretch }, 1.0), 2.0),
                        [
                            ui.text_of(
                                "row\(i)-from",
                                ui.in_font(ui.style(), BODY_LARGE(), row_weight(model, i)),
                                fit(m.from, column - 110.0),
                            ),
                            ui.text_of(
                                "row\(i)-subject",
                                ui.in_font(ui.style(), BODY_MEDIUM(), REGULAR()),
                                fit(m.subject, column - 110.0),
                            ),
                        ],
                    ),
                ],
            ),
        )
    }
    let list = ui.box_of(
        "list",
        ui.spaced(
            ui.padded(
                ui.sized(ui.Style{..ui.column(), align: ui.Align.Stretch }, column, 0.0),
                8.0,
            ),
            4.0,
        ),
        rows,
    )

    // The detail pane wraps its body to its own width — the layout decides the
    // width, and the wrapper is told it rather than guessing.
    var detail: [ui.Node] = []
    let at = position_of(model, shown)
    let reading = detail_width(model) - 48.0
    if at < 0 {
        detail.push(
            ui.text_of(
                "detail-none",
                ui.in_font(ui.style(), BODY_LARGE(), REGULAR()),
                "Nothing matches",
            ),
        )
    } else {
        let m = model.messages[model.selected]
        detail.push(
            ui.text_of(
                "detail-subject",
                ui.in_font(ui.style(), TITLE_LARGE(), REGULAR()),
                fit(m.subject, reading),
            ),
        )
        detail.push(
            ui.text_of("detail-from", ui.in_font(ui.style(), BODY_MEDIUM(), MEDIUM()), m.from),
        )
        detail.push(ui.box_of("detail-rule", ui.sized(ui.style(), 0.0, 1.0), []))
        var line = 0
        for run in ui.wrap(m.body, reading) {
            detail.push(
                ui.text_of(
                    "detail-body\(line)",
                    ui.in_font(ui.style(), BODY_LARGE(), REGULAR()),
                    run,
                ),
            )
            line = line + 1
        }
    }
    let pane = ui.box_of(
        "detail",
        ui.spaced(
            ui.padded(ui.grown(ui.Style{..ui.column(), align: ui.Align.Stretch }, 1.0), 24.0),
            8.0,
        ),
        detail,
    )

    let body = ui.box_of(
        "body",
        ui.spaced(
            ui.padded(ui.grown(ui.Style{..ui.row(), align: ui.Align.Stretch }, 1.0), 16.0),
            16.0,
        ),
        [list, pane],
    )

    let hint = ui.text_of(
        "hint",
        ui.padded(ui.in_font(ui.style(), LABEL_MEDIUM(), REGULAR()), 16.0),
        "Tab moves · arrows select · space marks read · type to filter",
    )

    return ui.box_of(
        "app",
        ui.Style {..ui.column(), align: ui.Align.Stretch },
        [header, body, hint],
    )
}

/// Material emphasises an unread message with weight rather than with a second
/// colour — a colour would be a second meaning for a reader to learn. Weight
/// changes how wide the line measures, so it is decided here, where the tree
/// is built, and not in the paint list.
fn row_weight(model: Model, i: int) -> int {
    if model.messages[i].read {
        return REGULAR()
    }
    return MEDIUM()
}

/// The list column: a third of the window, held between the width one message
/// needs to be legible and the width past which a line of subjects is a stripe.
fn list_width(model: Model) -> float {
    let third = model.width / 3.0
    if third < 280.0 {
        return 280.0
    }
    if third > 400.0 {
        return 400.0
    }
    return third
}

fn detail_width(model: Model) -> float {
    return model.width - list_width(model) - 48.0
}

pub fn view(model: Model) {
    let s = scheme_of(model)
    let theme = theme_of(model)
    let frames = ui.layout(view_node(model), viewport(model))

    // Material's shape scale, in the sizes this uses. A radius is a property of
    // the surface rather than of the box in the tree, so it rides on the paint
    // — the same node is a pill in one design system and a square in another,
    // and the layout should not have to know which.
    var paints: [ui.Paint] = [
        ui.fill("app", s.surface),
        ui.fill("header", s.surface),
        ui.ink("app-title", s.on_surface),
        ui.ink("app-count", s.on_surface_variant),
        // A large card for each pane. 12dp is Material's `medium` shape, which
        // is what a container of this size takes.
        ui.rounded("list", s.surface_container_low, 12.0),
        ui.rounded("detail", s.surface_container_low, 12.0),
        ui.ink("detail-none", s.on_surface_variant),
        ui.ink("detail-subject", s.on_surface),
        ui.ink("detail-from", s.on_surface_variant),
        ui.fill("detail-rule", s.outline_variant),
        ui.ink("hint", s.on_surface_variant),
    ]
    for line in 0..40 {
        paints.push(ui.ink("detail-body\(line)", s.on_surface))
    }

    let shown = matching(model)
    for i in shown {
        // Material marks a selected list item with a full-radius container —
        // the shape a navigation drawer uses — rather than a tint on the label,
        // which is what keeps it legible in either scheme.
        var from = s.on_surface_variant
        var subject = s.on_surface_variant
        var tick = s.on_surface_variant
        // What the row's checkbox is sitting on, which an unticked box has to
        // fill with: there is no alpha at this boundary.
        var behind = s.surface_container_low
        if i == model.selected {
            paints.push(ui.rounded("row\(i)", s.secondary_container, 28.0))
            behind = s.secondary_container
            from = s.on_secondary_container
            subject = s.on_secondary_container
            tick = s.on_secondary_container
        }
        // An unread message is the one thing in the list that is emphasised,
        // and weight is how Material emphasises it — a second colour would be
        // a second meaning for a reader to learn.
        if !model.messages[i].read {
            if i != model.selected {
                from = s.on_surface
                subject = s.on_surface
            }
        }
        paints.push(ui.ink("row\(i)-from", from))
        paints.push(ui.ink("row\(i)-subject", subject))
        for paint in ui.checkbox_paints(
            "read\(i)",
            model.messages[i].read,
            s.primary,
            s.on_primary,
            tick,
            behind,
        ) {
            paints.push(paint)
        }
    }

    // The controls last, so a focus ring lands on top of the row beneath it.
    for paint in control_paints(model, s, theme) {
        paints.push(paint)
    }
    ui.paint(frames, paints)
}

/// A placeholder is not a value, and Material draws it in the muted role so
/// that the difference is visible before anything is typed.
fn field_ink(model: Model, s: Scheme) -> int {
    if model.filter.len() == 0 && model.focused != ui.field("filter") {
        return s.on_surface_variant
    }
    return s.on_surface
}

/// The two real controls, painted as Material draws them.
///
/// Not `ui.control_paints_rounded`: that fills *every* control with one colour,
/// and a checkbox in Material has no container of its own — the box is the
/// control. Filling one would put a lozenge behind every row. The widget layer
/// offers the general version and this takes the specific one, which is the
/// right way round: a design system is the application's to choose.
fn control_paints(model: Model, s: Scheme, theme: ui.Theme) -> [ui.Paint] {
    let filter_focused = model.focused == ui.field("filter")
    var edge = s.outline_variant
    var width = 1.0
    if filter_focused {
        edge = s.primary
        width = 2.0
    }
    var out: [ui.Paint] = [
        // An outlined text field: Material's `extra-large` shape at this
        // height, which is the search field every Material app opens with.
        ui.outlined(ui.field("filter"), s.surface_container_high, edge, width, 28.0),
        ui.ink("\(ui.field("filter")):value", field_ink(model, s)),
        // A filled tonal button: the secondary action beside a text field.
        ui.rounded(ui.button("theme"), s.secondary_container, 20.0),
        ui.ink_centered("\(ui.button("theme")):caption", s.on_secondary_container),
    ]
    if model.focused == ui.button("theme") {
        out.push(ui.outlined(ui.button("theme"), s.secondary_container, s.primary, 2.0, 20.0))
    }
    return out
}

// ---- events ---------------------------------------------------------------------

fn EVENT_CLICK() -> int {
    return 0
}

fn EVENT_KEY() -> int {
    return 1
}

fn EVENT_RESIZE() -> int {
    return 6
}

pub fn update(model: Model, event: int, x: float, y: float, key: str) -> Model {
    if event == EVENT_CLICK() {
        return clicked(model, x, y)
    }
    if event == EVENT_KEY() {
        return pressed(model, key)
    }
    if event == EVENT_RESIZE() {
        // A window too small to lay this out at all is refused rather than
        // laid out into a heap: the floor is the size the design was drawn for.
        let w = if x > 640.0 { x } else { 640.0 }
        let h = if y > 400.0 { y } else { 400.0 }
        return Model{..model, width: w, height: h }
    }
    return model
}

fn clicked(model: Model, x: float, y: float) -> Model {
    let frames = ui.layout(view_node(model), viewport(model))

    // A control first: a checkbox or the theme button answers for itself.
    let hit = ui.control_at(frames, x, y)
    if hit != nil {
        let focused = Model{..model, focused: hit }
        if hit == ui.button("theme") {
            return Model{..focused, dark: !model.dark }
        }
        let box = ui.control_id(hit, "checkbox")
        if box != nil {
            return toggled(selected_by_control(focused, box), box)
        }
        return focused
    }

    // Otherwise, whatever frame is under the pointer — which is how clicking
    // a message *anywhere* selects it. `hit` reads the frames backwards, so
    // the answer is the innermost box drawn there, and walking the name back
    // to its row is a string comparison rather than a second table.
    let frame = ui.hit(frames, x, y)
    if frame == nil {
        return model
    }
    return selected_by_frame(model, frame.name)
}

/// The row a frame belongs to, from its name.
///
/// The names use a hyphen — `row2-subject` — and not a colon, because a colon
/// is `std/ui`'s own convention: `button:save:caption` is *part of* the
/// control `button:save`, and `control_at` reads a name that way. Naming a
/// plain text node `row2:subject` therefore made it answer as a control, so a
/// click on a message moved the focus and selected nothing. The layer's
/// convention is fine; borrowing its punctuation was not.
fn selected_by_frame(model: Model, name: str) -> Model {
    for i in 0..model.messages.len() {
        if name == "row\(i)" || starts_with(name, "row\(i)-") {
            return Model{..model, selected: i }
        }
    }
    return model
}

/// Clicking a row's checkbox also selects that row. The control's name carries
/// the index — `checkbox:read3` — so the name is enough to know which, with no
/// parallel table to keep in step.
fn selected_by_control(model: Model, box: str) -> Model {
    for i in 0..model.messages.len() {
        if box == "read\(i)" {
            return Model{..model, selected: i }
        }
    }
    return model
}

fn toggled(model: Model, box: str) -> Model {
    var out: [Message] = []
    for i in 0..model.messages.len() {
        let m = model.messages[i]
        if box == "read\(i)" {
            out.push(Message{..m, read: !m.read })
        } else {
            out.push(m)
        }
    }
    return Model{..model, messages: out }
}

fn pressed(model: Model, key: str) -> Model {
    if key == "Tab" {
        return Model{..model, focused: ui.next_focus(controls(model), model.focused) }
    }
    if key == "ArrowDown" {
        return moved(model, 1)
    }
    if key == "ArrowUp" {
        return moved(model, -1)
    }
    if key == " " {
        let box = ui.control_id(model.focused, "checkbox")
        if box != nil {
            return toggled(model, box)
        }
        return toggled(model, "read\(model.selected)")
    }
    if model.focused == ui.field("filter") {
        return Model{..model, filter: ui.typed(model.filter, key) }
    }
    return model
}

/// Move the selection through the *filtered* list, not the whole one — the
/// arrows should walk what is on screen. A selection the filter has hidden
/// starts again from the top rather than jumping somewhere invisible.
fn moved(model: Model, by: int) -> Model {
    let shown = matching(model)
    if shown.len() == 0 {
        return model
    }
    let at = position_of(model, shown)
    if at < 0 {
        return Model{..model, selected: shown[0] }
    }
    var next = at + by
    if next < 0 {
        next = shown.len() - 1
    }
    if next >= shown.len() {
        next = 0
    }
    return Model{..model, selected: shown[next] }
}

// ---- headless ------------------------------------------------------------------
//
// The same program, driven by the same `update` the page drives, so the
// differential suite runs it on every backend and `view` stays reachable.

fn main() {
    var model = init()
    io.print("\(matching(model).len()) messages")

    model = update(model, EVENT_KEY(), 0.0, 0.0, "a")
    model = update(model, EVENT_KEY(), 0.0, 0.0, "d")
    io.print("filtered to \(matching(model).len()) by \"\(model.filter)\"")

    model = update(model, EVENT_KEY(), 0.0, 0.0, "Backspace")
    model = update(model, EVENT_KEY(), 0.0, 0.0, "Backspace")
    model = update(model, EVENT_KEY(), 0.0, 0.0, "ArrowDown")
    io.print("selected \(model.selected): \(model.messages[model.selected].from)")

    model = update(model, EVENT_KEY(), 0.0, 0.0, " ")
    io.print("read: \(model.messages[model.selected].read)")

    view(model)
}
